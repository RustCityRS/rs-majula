*.ejs linguist-detectable=false
*.js linguist-detectable=false
*.mjs linguist-detectable=false
*.sh linguist-detectable=false
*.ps1 linguist-detectable=false
*.py linguist-detectable=false
*.html linguist-detectable=false
*.css linguist-detectable=false

# Auto-detect text files, normalize to LF in repo, native line endings on checkout
* text=auto

# Force LF everywhere for source/content files (consistent across OS)
*.pack text eol=lf
*.rs2 text eol=lf
*.constant text eol=lf
*.varp text eol=lf
*.varn text eol=lf
*.vars text eol=lf
*.npc text eol=lf
*.obj text eol=lf
*.loc text eol=lf
*.hunt text eol=lf
*.inv text eol=lf
*.if text eol=lf
*.cs2 text eol=lf
*.sym text eol=lf
*.hashes text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.sh text eol=lf
# sqlx checksums the exact bytes: a CRLF checkout would build a binary that
# rejects the production database's migrations
*.sql text eol=lf
*.bat text eol=crlf

# Binary files
*.dat binary
*.idx binary
*.dat2 binary
*.bin binary
*.7z binary
*.zip binary
*.jar binary
*.class binary
*.dll binary
*.so binary
*.dylib binary
*.synth binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.tga binary
*.fm binary
*.pyxel binary
*.midi binary
*.mid binary
*.ogg binary
*.ob2 binary
*.huffman binary
*.sample binary
*.skel binary
*.vorbis binary
*.cso binary

content/647/** eol=lf
content/647/**/*.synth text diff eol=lf
content/647/**/*.fm text diff eol=lf
content/647/**/*.fms text diff eol=lf
content/647/**/*.huffman text diff eol=lf
content/647/**/*.sample text diff eol=lf
content/647/**/*.vorbis text diff eol=lf
content/647/shaders/**/*.arb -text diff
content/647/shaders/**/*.glsl -text diff
*.js5 binary
