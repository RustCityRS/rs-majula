// 2574
[clientscript,rcguild_activity_bar_fill]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = scale(%rcguild_activity, 1000, 100);
if ($int2 < 1) {
    $int2 = 1;
}
if ($int2 > 100) {
    $int2 = 100;
}
$int0 = enum(int, int, enum_197, $int2);
$int1 = enum(int, int, enum_198, $int2);
if (%rcguild_team = 1) {
    if_setposition(rcguild_overlay:yellow_activity_bar_fill, 481, $int0, ^setpos_abs_left, ^setpos_abs_top);
    if_setsize(rcguild_overlay:yellow_activity_bar_fill, 16, $int1, ^setsize_abs, ^setsize_abs);
} else if (%rcguild_team = 2) {
    if_setposition(rcguild_overlay:green_activity_bar_fill, 481, $int0, ^setpos_abs_left, ^setpos_abs_top);
    if_setsize(rcguild_overlay:green_activity_bar_fill, 16, $int1, ^setsize_abs, ^setsize_abs);
}
if ($int2 < 25) {
    if (%rcguild_team = 1) {
        if_setcolour(rcguild_overlay:yellow_activity_bar_fill, 0xff9900);
    } else if (%rcguild_team = 2) {
        if_setcolour(rcguild_overlay:green_activity_bar_fill, 0xff9900);
    }
} else if (%rcguild_team = 1) {
    if_setcolour(rcguild_overlay:yellow_activity_bar_fill, 0x666600);
} else if (%rcguild_team = 2) {
    if_setcolour(rcguild_overlay:green_activity_bar_fill, 0x284605);
}
