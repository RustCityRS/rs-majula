// 1234
[clientscript,camera_control](int $int0)
if (keyheld_shift = true) {
    return;
}
if (%camera_control_mode ! 1) {
    switch_int ($int0) {
        case 1 :
            cam_inc_x;
        case 2 :
            cam_dec_x;
        case 3 :
            cam_inc_y;
        case 4 :
            cam_dec_y;
    }
}
