// 1762
[clientscript,brew_time](component $component0)
if (%brew_varc_time > 6) {
    if_settext($component0, "Time Left : <tostring(calc(%brew_varc_time - 5))> mins");
} else if (%brew_varc_time = 6) {
    if_settext($component0, "Time Left : 1 min");
} else {
    if_settext($component0, "Time Left : 0 mins");
}
