// 1755
[clientscript,brew_colourwater](component $component0, component $component1)
if (%brew_varc_colourwater > 2) {
    if (inv_getobj(worn, 0) = brew_red_pirate_hat) {
        if_setmodel($component0, model_15700);
    } else {
        if_setmodel($component0, model_15674);
    }
    if_setcolour($component1, 0x33ff00);
} else {
    if (inv_getobj(worn, 0) = brew_red_pirate_hat) {
        if_setmodel($component0, model_15699);
    } else {
        if_setmodel($component0, model_15673);
    }
    if_setcolour($component1, 0x910000);
}
if_settext($component1, tostring(%brew_varc_colourwater));
