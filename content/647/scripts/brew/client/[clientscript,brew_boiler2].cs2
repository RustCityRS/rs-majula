// 1747
[clientscript,brew_boiler2](component $component0, component $component1)
if (%brew_varc_boiler2 > 2) {
    if_setmodel($component0, model_15680);
    if_setcolour($component1, 0x33ff00);
} else {
    if_setmodel($component0, model_15679);
    if_setcolour($component1, 0x910000);
}
if_settext($component1, tostring(%brew_varc_boiler2));
