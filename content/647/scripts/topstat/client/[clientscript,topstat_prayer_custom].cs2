// 2299
[clientscript,topstat_prayer_custom](component $component0)
if (%prayer_custom_view_client = true) {
    if (%prayer_mode = 1) {
        if_setop($component0, 2, "Finish quick curse selection");
        if_settext(prayer:custom_instructions, "Select your quick curses:");
    } else {
        if_setop($component0, 2, "Finish quick prayer selection");
        if_settext(prayer:custom_instructions, "Select your quick prayers:");
    }
} else if (%prayer_mode = 1) {
    if_setop($component0, 2, "Select quick curses");
} else {
    if_setop($component0, 2, "Select quick prayers");
}
~topstat_prayer_button_update;
