// 805
[proc,topstat_set_text_colour_skill](stat $stat0)(int)
def_int $int1 = ~topstat_calculate_percent($stat0);
def_int $rgb2 = 0x555555;
if ($int1 > 75) {
    $rgb2 = ^green;
} else if ($int1 > 50) {
    $rgb2 = ^yellow;
} else if ($int1 > 25) {
    $rgb2 = 0xff981f;
} else {
    $rgb2 = ^red;
}
return($rgb2);
