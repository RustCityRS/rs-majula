// 1410
[clientscript,topstat_run_glow_timer](component $component0)
def_int $int1 = 255;
def_int $int2 = 0;
if (%topstat_run_button_glow < 256) {
    $int1 = calc(255 - %topstat_run_button_glow);
} else if (%topstat_run_button_glow < 510) {
    $int1 = calc(%topstat_run_button_glow % 255);
} else {
    $int1 = 255;
}
if (%option_run_status_varc = 4) {
    $int2 = 8;
} else if (%option_run_status_varc = 3) {
    $int2 = 4;
} else {
    $int1 = 255;
}
if_settrans($component0, $int1);
%topstat_run_button_glow = calc(%topstat_run_button_glow + $int2);
if (%topstat_run_button_glow > 510) {
    %topstat_run_button_glow = 0;
}
