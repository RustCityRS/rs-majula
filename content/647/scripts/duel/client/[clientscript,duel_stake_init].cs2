// 99
[clientscript,duel_stake_init]
def_int $int0 = 5;
def_int $int1 = 5;
def_int $int2 = 0;
while ($int0 < 125) {
    while ($int1 < 120) {
        cc_create(interface_631:your_stake, ^iftype_graphic, $int2);
        cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
        cc_setposition($int1, $int0, ^setpos_abs_left, ^setpos_abs_top);
        if (inv_getobj(dueloffer, $int2) ! null) {
            cc_setobject(inv_getobj(dueloffer, $int2), inv_getnum(dueloffer, $int2));
            cc_setopbase("<col=ff981f><oc_name(inv_getobj(dueloffer, $int2))>");
            cc_setop(1, "Remove 1");
            cc_setop(2, "Remove 5");
            cc_setop(3, "Remove 10");
            cc_setop(4, "Remove All");
            cc_setop(5, "Remove X");
            cc_setop(10, "Examine");
            cc_setgraphicshadow(0x302020);
            cc_setoutline(1);
        }
        cc_create(interface_631:opponent_stake, ^iftype_graphic, $int2);
        cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
        cc_setposition($int1, $int0, ^setpos_abs_left, ^setpos_abs_top);
        if (invother_getobj(dueloffer, $int2) ! null) {
            cc_setobject(invother_getobj(dueloffer, $int2), invother_getnum(dueloffer, $int2));
            cc_setopbase("<col=ff981f><oc_name(invother_getobj(dueloffer, $int2))>");
            cc_setop(1, "Examine");
            cc_setgraphicshadow(0x302020);
            cc_setoutline(1);
        }
        $int1 = calc($int1 + 40);
        $int2 = calc($int2 + 1);
    }
    $int0 = calc($int0 + 42);
    $int1 = 5;
}
