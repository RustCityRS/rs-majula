// 2377
[proc,makeover_gender](int $int0, component $component1, component $component2)
if ($int0 = 0) {
    if_setcolour($component1, ^white);
    if_settextshadow($component1, true);
    if_setcolour($component2, ^black);
    if_settextshadow($component2, false);
} else {
    if_setcolour($component2, ^white);
    if_settextshadow($component2, true);
    if_setcolour($component1, ^black);
    if_settextshadow($component1, false);
}
