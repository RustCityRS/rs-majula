// 1281
[clientscript,draughts_inv_dragcomplete_swap](inv $inv0, int $int1, int $int2, component $component3)
if ($int2 = -1) {
    ~draughts_inv_draw_slot($inv0, $int1, $component3, $int1);
    return;
}
~draughts_inv_draw_slot($inv0, $int1, $component3, $int2);
~draughts_inv_draw_slot($inv0, $int2, $component3, $int1);
