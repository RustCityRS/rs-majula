// 1910
[clientscript,sc_processing_show_weapons]
if_sethide(sc_processing:weapons_button_highlight, false);
if_sethide(sc_processing:weapons_layer, false);
if_sethide(sc_processing:armour_button_highlight, true);
if_sethide(sc_processing:armour_layer, true);
if_sethide(sc_processing:supplies_button_highlight, true);
if_sethide(sc_processing:supplies_layer, true);
if_sethide(sc_processing:potions_button_highlight, true);
if_sethide(sc_processing:potions_layer, true);
if_sethide(sc_processing:highlight_rect, true);
%sc_client_selected_item = 0;
