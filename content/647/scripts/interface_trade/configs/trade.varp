[tradepartner]
type=player_uid
protect=no

[tradestatus]
type=int
protect=no

// 2011: "Trade modified" over an offer, the player's own (varp 1042) and the
// other's (1043), which clientscript 141 shows over trademain's offers (com39,
// com40) when either is 1 (void-634 offer_modified, other_offer_modified; the
// 2011 wiki, Trading: a removed item marks the trade modified). The cache
// transmits both. Each player marks the other's, as 289's trade varps are
// written, so neither is protected.
[offer_modified]
transmit=yes
protect=no

[other_offer_modified]
transmit=yes
protect=no
