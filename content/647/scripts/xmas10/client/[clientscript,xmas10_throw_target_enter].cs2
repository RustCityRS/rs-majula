// 4086
[clientscript,xmas10_throw_target_enter]
if (if_find(xmas10_snowball:throw_end1) = true) {
    cc_setgraphic("set_but_end_2,2");
}
if (if_find(xmas10_snowball:throw_end2) = true) {
    cc_setgraphic("set_but_end_2,5");
}
if (if_find(xmas10_snowball:throw_mid) = true) {
    cc_setgraphic("set_but_fill_2,2");
}
