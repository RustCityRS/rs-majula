// 2086
[clientscript,snp_update_game_east_grave_icon_colour]
if (%snp_east_control_is_client <= 5) {
    if_setcolour(snp_game_overlay:east_icon_colour, 0x3366ff);
} else if (%snp_east_control_is_client >= 25) {
    if_setcolour(snp_game_overlay:east_icon_colour, 0xe12323);
} else {
    if_setcolour(snp_game_overlay:east_icon_colour, 0x666666);
}
