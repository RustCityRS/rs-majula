// 4005
[clientscript,task_side_advice_hover](int $int0)
if ($int0 = 0) {
    if_setgraphic(task_side:advice_close_l, "task_pin_but,2");
    if_setgraphic(task_side:advice_close_r, "task_pin_but,2");
    if_setgraphic(task_side:advice_close_m, "task_pin_but,3");
    if_setgraphic(task_side:advice_close_arrow, "task_arrow,1");
} else {
    if_setgraphic(task_side:advice_close_l, "task_pin_but,0");
    if_setgraphic(task_side:advice_close_r, "task_pin_but,0");
    if_setgraphic(task_side:advice_close_m, "task_pin_but,1");
    if_setgraphic(task_side:advice_close_arrow, "task_arrow,0");
    ~deltooltip_action(task_side:summary_tooltip);
}
