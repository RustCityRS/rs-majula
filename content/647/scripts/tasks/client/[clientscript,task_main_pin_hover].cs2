// 4024
[clientscript,task_main_pin_hover](int $int0)
if ($int0 = 0) {
    if_setgraphic(task_main:com_90, "task_pin_but,2");
    if_setgraphic(task_main:pin_button_r, "task_pin_but,2");
    if_setgraphic(task_main:pin_button_m, "task_pin_but,3");
} else {
    ~deltooltip_action(task_main:summary_tooltip);
    if_setgraphic(task_main:com_90, "task_pin_but,0");
    if_setgraphic(task_main:pin_button_r, "task_pin_but,0");
    if_setgraphic(task_main:pin_button_m, "task_pin_but,1");
}
