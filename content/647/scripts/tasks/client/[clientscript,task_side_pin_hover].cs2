// 4006
[clientscript,task_side_pin_hover](int $int0)
if ($int0 = 0) {
    if_setgraphic(task_side:com_118, "task_pin_but,2");
    if_setgraphic(task_side:com_119, "task_pin_but,2");
    if_setgraphic(task_side:pin_button_m, "task_pin_but,3");
} else {
    if_setgraphic(task_side:com_118, "task_pin_but,0");
    if_setgraphic(task_side:com_119, "task_pin_but,0");
    if_setgraphic(task_side:pin_button_m, "task_pin_but,1");
    ~deltooltip_action(task_side:summary_tooltip);
}
