// 4009
[clientscript,task_hintarrow_hover](int $int0, int $int1, component $component2)
if ($int1 = 1) {
    if ($int0 = 0) {
        if_setgraphic($component2, "km_help_button,3");
    } else {
        if_setgraphic($component2, "km_help_button,2");
        ~deltooltip_action(task_side:summary_tooltip);
    }
} else if ($int0 = 0) {
    if_setgraphic($component2, "km_help_button,1");
} else {
    if_setgraphic($component2, "km_help_button,0");
    ~deltooltip_action(task_side:summary_tooltip);
}
