// 2011's Task System, its server side. Not in 289: cache 786's task tab (task_side, 1056; opened
// at login), task list (task_main, 917) and popup (interface_1055), with void-634's TaskSystem.kt
// as the reference for what the server does. The client draws the tab itself from these vars,
// whose names are void-634's for cache 786's ids:
// - task_slot_1..6, varbits 8587-8592: the task index (enum_3483) in each of the tab's six slots,
//   4091 when empty (clientscript script3971);
// - task_area, varbit 8575: the set shown (enum_3487: 0 D&Ds/Activities, 1 Lumbridge/Draynor, ...);
// - task_pinned 8576 / task_pin_slot 8577, task_progress_overall 8601;
// - varcs task_progress_total 1423 / task_progress_current 1424 and task_popup 1425.
// Whether a task is done is task_done (generated from the client's task_get_progress) and whether
// its requirements are met is task_requirements_fulfilled (a copy of the client's own proc).

// Fills the tab's six slots from the current set: its tasks in list order (enum_3482 gives the
// set's first index, struct param_1269 the next; 4091, 450 and 4094 end it), skipping those done
// or not yet open to the player, the pinned task in its pinned slot (void-634's refreshSlots).
[proc,task_refresh]
def_int $index = enum(int, int, enum_3482, %varplayerbit_8575);
def_int $slot = 1;
def_int $total = 0;
def_int $done = 0;
def_int $pinned = %varplayerbit_8576;
def_int $pin_slot = %varplayerbit_8577;
if ($pin_slot > 0 & $pinned ! 4091 & ~task_done($pinned) = true) {
    // A pinned task that is done is unpinned.
    $pin_slot = 0;
    %varplayerbit_8577 = 0;
    %varplayerbit_8576 = 4091;
}
def_struct $task = null;
while ($index ! 4091 & $index ! 450 & $index ! 4094) {
    $task = enum(int, struct, enum_3483, $index);
    $total = add($total, 1);
    if (~task_done($index) = true) {
        $done = add($done, 1);
    } else if ($index ! $pinned & ~task_requirements_fulfilled($index) = true) {
        if ($slot = $pin_slot) {
            ~task_set_slot($slot, $pinned);
            $slot = add($slot, 1);
        }
        if ($slot <= 6) {
            ~task_set_slot($slot, $index);
            $slot = add($slot, 1);
        }
    }
    $index = struct_param($task, param_1269);
}
if ($slot = $pin_slot) {
    ~task_set_slot($slot, $pinned);
    $slot = add($slot, 1);
}
while ($slot <= 6) {
    ~task_set_slot($slot, 4091);
    $slot = add($slot, 1);
}
%varclient_1423 = $total;
%varclient_1424 = $done;

[proc,task_set_slot](int $slot, int $index)
switch_int ($slot) {
    case 1 : %varplayerbit_8587 = $index;
    case 2 : %varplayerbit_8588 = $index;
    case 3 : %varplayerbit_8589 = $index;
    case 4 : %varplayerbit_8590 = $index;
    case 5 : %varplayerbit_8591 = $index;
    case 6 : %varplayerbit_8592 = $index;
}

// The set the tab shows, from where the player stands: Lumbridge/Draynor (1) inside void-634's
// lumbridge and draynor areas, D&Ds/Activities (0) elsewhere (void-634's entered/exited). Draynor
// is void-634's rectangle (3072-3135, 3136-3391); Lumbridge is void-634's 36-point polygon, taken
// here as its bounding box (3136-3270, 3136-3349), an approximation. Set at login; void-634 also
// switches as the player walks in and out, not yet ported. Painted areas ([area,...] triggers,
// maps/a*.jm2) would give both, but which of cache 786's empty area entries 2011 used is unknown.
[proc,task_area_here]
def_int $x = coordx(coord);
def_int $z = coordz(coord);
if ($x >= 3072 & $x <= 3270 & $z >= 3136 & $z <= 3391) {
    if ($x <= 3135 | $z <= 3349) {
        %varplayerbit_8575 = 1;
        return;
    }
}
%varplayerbit_8575 = 0;

// Completes task <index>: the caller has already set its var (the one task_done reads). The
// messages are 2011's ("You have completed the Task 'Rest Up'!", "You have now completed 58 Tasks
// in total.", the 2011-04-22 Prince Ali Rescue recording's chat, YouTube I7lbQxahe_w); the popup
// is the client's (interface_1055 wakes on varc task_popup). The first Task done prints no total:
// 4KO2h2xPtdM (2011-04-30) @610 has "You have completed the Task 'How To Train and Level'!" alone,
// then @680 "You have completed the Task 'On the Run'!" / "You have now completed 2 Tasks in total."
[proc,task_complete](int $index)
def_struct $task = enum(int, struct, enum_3483, $index);
mes("You have completed the Task '<struct_param($task, param_1266)>'!");
%varplayerbit_8601 = add(%varplayerbit_8601, 1);
if (%varplayerbit_8601 > 1) {
    mes("You have now completed <tostring(%varplayerbit_8601)> Tasks in total.");
}
%varclient_1425 = $index;
~task_refresh;

// Task 425 "How To Train and Level" (struct 1758: "Reach level 2 in Mining.", its var varbit 9018 in
// the client's task_get_progress): done at Mining 2, its popup once the level's boxes are closed
// (4KO2h2xPtdM @576.7, after "Congratulations: You have reached level 2 Mining.", Roddeck's line
// and the drop hint). From levelup.rs2.
[queue,task_how_to_train_and_level]
if (%varplayerbit_9018 = 1 | stat_base(mining) < 2) {
    return;
}
%varplayerbit_9018 = 1;
~task_complete(425);

// Task 363 "On the Run" (struct 1518, "Run somewhere.", its var varbit 8522 in the client's
// task_get_progress): done on a walk taken with run on (void-634's LumbridgeBeginnerTasks: moved
// while running). Not in Unstable Foundations: 4KO2h2xPtdM (2011-04-30) runs in the cellar with the
// orb lit (@186-198) and has the Task only after the tutorial (@680); Qh_-AMJpVd0 (2011-05-10) has
// it in Explorer Jack's house right after the quest (@432.5). The walktrigger is one slot, shared
// with stuns and freezes: armed only when free, again at each login.
[proc,task_on_the_run_arm]
if (%varplayerbit_8522 = 1 | %learning_the_ropes < 1000) {
    return;
}
if (getwalktrigger = null) {
    walktrigger(task_on_the_run);
}

[walktrigger,task_on_the_run]
if (%varplayerbit_8522 = 1 | %learning_the_ropes < 1000) {
    return;
}
if (%option_run = ^player_run_on) {
    %varplayerbit_8522 = 1;
    ~task_complete(363);
    return;
}
walktrigger(task_on_the_run);
