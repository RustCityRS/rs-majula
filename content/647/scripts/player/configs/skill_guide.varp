[skill_guide_skill]
type=stat
scope=temp
protect=no

// 289 pages its server-built guide; 2011's client pages its own
// (skill_guide.rs2).
// [skill_guide_pages]
// type=int
// scope=temp
// protect=no

// 2011's guide and level-up details are drawn by the client from these
// (skill_guide.rs2), which a click in the stats tab sets as 289's guide vars
// are set. A stat flashes after its level-up until it is clicked, and only
// while the player stays logged in: the 21 May 2008 update (2011 wiki,
// Update:Level-up Messages, revision 2010-10-18) has the flashing icon open
// the level-up message "as long as you stay logged in". void-634 saves it
// across logins (scope=perm); 2011 does not, so it is temp.
[skill_guide]
protect=no

[level_up_details]
protect=no

[skill_stat_flash]
protect=no
