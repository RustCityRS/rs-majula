    } else if ($int2 < 0) {
        cc_setmodelangle(cc_getmodelxof, cc_getmodelyof, cc_getmodelangle_x, calc((cc_getmodelangle_y + 10) % 2048), cc_getmodelangle_z, cc_getmodelzoom);
    } else {
