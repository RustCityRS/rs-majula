// Kebab — random outcome on eat. Ported/adapted from rs-majula consumption/
// effects/scripts/kebab.rs2. Probabilities (out of 32) match rev-225; the flat
// heal amounts are x10 for the 647 life-points model. Against the 2011 wiki
// (Kebab, 2011-05-21): "good" heals 100-200 (here ~198 at 99 Constitution) and
// "common" 10% of max (here ~10%), but "amazing" heals "up to 300" (here
// ~308); the wiki's messages differ from these rev-225 ones, and it says a
// dodgy kebab no longer damages life points (it lowers stats). Hitpoints heals
// route to %life_points via ~heal_lifepoints; self-damage via ~damage_self.
// It plays the eat sound itself, as the other foods do: human_eat (seq 829)
// carries no sound in the cache.
[label,consume_effect_kebab]
mes("You eat the kebab.");
anim(human_eat, 0);
sound_synth(eat, 1, 0);
inv_delslot(inv, last_slot);
def_int $max = calc(stat(hitpoints) * 10);
def_int $random = random(32);
if ($random < 1) {
    // 1/32 — amazing kebab: small combat boost + big heal
    mes("Wow, that was an amazing kebab! You feel really invigorated.");
    stat_boost(attack, 2, 0);
    stat_boost(strength, 2, 0);
    stat_boost(defence, 2, 0);
    ~heal_lifepoints(calc(70 + scale(24, 100, $max)));
} else if ($random < 9) {
    // 8/32 — good kebab
    mes("That was a good kebab. You feel a lot better.");
    ~heal_lifepoints(calc(60 + scale(14, 100, $max)));
} else if ($random < 29) {
    // 20/32 — heals some (only when below max)
    if (%life_points < $max) {
        mes("It heals some health.");
        ~heal_lifepoints(calc(30 + scale(7, 100, $max)));
    }
} else if ($random < 30) {
    // 1/32 — very dodgy: drain combat stats + take some damage
    mes("That tasted very dodgy. You feel very ill.");
    stat_drain(attack, 3, 0);
    stat_drain(strength, 3, 0);
    stat_drain(defence, 3, 0);
    if (%life_points > 20) {
        ~damage_self(min(calc(%life_points - 20), 40));
    }
} else if ($random < 31 & %life_points > 40) {
    // 1/32 — a bit dodgy: small damage (skipped if too low to be safe)
    mes("That tasted a bit dodgy. You feel a bit ill.");
    ~damage_self(30);
} else {
    // 1/32 — nothing
    mes("The kebab didn't seem to do a lot.");
}
