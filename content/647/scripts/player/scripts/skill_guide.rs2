// 289 builds its skill guide on the server: a dbtable of each skill's unlock
// rows, sent line by line into its skill_guide interface. 2011's guide
// (skill_guide_v2, 499) is drawn by the client from the cache's own data; the
// server only names the skill and section in %skill_guide (varp 965: the
// stat's 2011 menu index, plus 1024 per section). And each 2011 stat has its
// own guide, where 289 showed attack's for hitpoints, strength and defence.
//
// A stat whose icon flashes after a level-up (%skill_stat_flash, set by
// levelup.rs2) opens 2011's level-up details (lvl_scroll, 741) instead, once:
// %level_up_details is the stat's menu index times 8, and the flash clears.
// 289's rows, ops and inv are not used: the client has its own.
[if_button,stats:attack_button] @skill_guide(attack, 0);
[if_button,stats:hitpoints_button] @skill_guide(hitpoints, 0);
[if_button,stats:strength_button] @skill_guide(strength, 0);
[if_button,stats:defence_button] @skill_guide(defence, 0);
[if_button,stats:mining_button] @skill_guide(mining, 0);
[if_button,stats:agility_button] @skill_guide(agility, 0);
[if_button,stats:smithing_button] @skill_guide(smithing, 0);
[if_button,stats:herblore_button] @skill_guide(herblore, 0);
[if_button,stats:fishing_button] @skill_guide(fishing, 0);
[if_button,stats:ranged_button] @skill_guide(ranged, 0);
[if_button,stats:thieving_button] @skill_guide(thieving, 0);
[if_button,stats:cooking_button] @skill_guide(cooking, 0);
[if_button,stats:prayer_button] @skill_guide(prayer, 0);
[if_button,stats:crafting_button] @skill_guide(crafting, 0);
[if_button,stats:firemaking_button] @skill_guide(firemaking, 0);
[if_button,stats:magic_button] @skill_guide(magic, 0);
[if_button,stats:fletching_button] @skill_guide(fletching, 0);
[if_button,stats:woodcutting_button] @skill_guide(woodcutting, 0);
[if_button,stats:runecraft_button] @skill_guide(runecraft, 0);

[label,skill_guide](stat $lookup, int $page)
db_find(levelup:stat, $lookup);
def_dbrow $row = db_findnext;
if ($row = null) {
    if_close;
    mes("TODO.");
    return;
}
def_int $menu = db_getfield($row, levelup:icon, 0);
if_close;
def_int $bit = db_getfield($row, levelup:flash_bit, 0);
if (testbit(%skill_stat_flash, $bit) = ^true) {
    %level_up_details = multiply($menu, 8);
    %skill_stat_flash = clearbit(%skill_stat_flash, $bit);
    if_openmain(lvl_scroll);
    return;
}
%skill_guide_skill = $lookup;
%skill_guide_v2 = add($menu, multiply($page, 1024));
if_openmain(skill_guide_v2);

// 2011's guide lists its sections down the left (components 10-24; cache 786
// gives component 25 the same "Open subsection" op, which nothing here
// handles); each shows the skill's section of that index.
[if_button,skill_guide_v2:subsection_button_1] @change_skill_guide(0);
[if_button,skill_guide_v2:subsection_button_2] @change_skill_guide(1);
[if_button,skill_guide_v2:subsection_button_3] @change_skill_guide(2);
[if_button,skill_guide_v2:subsection_button_4] @change_skill_guide(3);
[if_button,skill_guide_v2:subsection_button_5] @change_skill_guide(4);
[if_button,skill_guide_v2:subsection_button_6] @change_skill_guide(5);
[if_button,skill_guide_v2:subsection_button_7] @change_skill_guide(6);
[if_button,skill_guide_v2:subsection_button_8] @change_skill_guide(7);
[if_button,skill_guide_v2:subsection_button_9] @change_skill_guide(8);
[if_button,skill_guide_v2:subsection_button_10] @change_skill_guide(9);
[if_button,skill_guide_v2:subsection_button_11] @change_skill_guide(10);
[if_button,skill_guide_v2:subsection_button_12] @change_skill_guide(11);
[if_button,skill_guide_v2:subsection_button_13] @change_skill_guide(12);
[if_button,skill_guide_v2:subsection_button_14] @change_skill_guide(13);
[if_button,skill_guide_v2:subsection_button_15] @change_skill_guide(14);

[label,change_skill_guide](int $page)
db_find(levelup:stat, %skill_guide_skill);
def_dbrow $row = db_findnext;
if ($row = null) {
    return;
}
%skill_guide_v2 = add(db_getfield($row, levelup:icon, 0), multiply($page, 1024));

// 289's guide pages (its skill_guide interface's section buttons) and the
// procs that fill its rows have no 2011 counterpart: 2011's client pages and
// draws its own guide (skill_guide_v2, 499), as above.
