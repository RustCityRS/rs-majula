// 4231
[clientscript,acs_build_button_on](component $component0)
if (if_find($component0) = true) {
    cc_setonclick("aif_component_fade_set($component0, 0)");
    cc_setonhold("aif_component_fade_set($component0, 0)");
    cc_setonrelease("aif_component_fade_set($component0, 1)");
    cc_settrans(255);
}
