// 4321
[proc,clansettings_clanmate_has_left]
~clansettings_clanmate_details_clear_varcs;
~clansettings_clanmate_details_refresh;
if_sethide(clansettings:clanmate_details_loading_blackout_layer, false);
if_settext(clansettings:loading_clanmate_data_txt, "Please select a clanmate to view.");
~script4501(clansettings:com_261, "");
~script4501(clansettings:com_247, "");
