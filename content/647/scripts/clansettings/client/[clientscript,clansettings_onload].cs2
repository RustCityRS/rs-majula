// 4289
[clientscript,clansettings_onload]
if (activeclansettings_find_affined = true) {
    ~clansettings_initial_setup;
} else {
    if_setonclansettingstransmit(clansettings:com_124, "clansettings_initial_setup");
}
if (%clansettings_clanmate_filter_rank_plus_1 = -1) {
    %clansettings_clanmate_filter_rank_plus_1 = 0;
}
