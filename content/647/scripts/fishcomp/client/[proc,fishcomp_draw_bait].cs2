// 263
[proc,fishcomp_draw_bait]
def_string $string0 = "None";
switch_int (%fishcomp_client_bait) {
    case 1 :
        $string0 = "Worm";
    case 2 :
        $string0 = "Maggot";
    case 4 :
        $string0 = "Locust";
    case 3 :
        $string0 = "Cricket";
    case 5 :
        $string0 = "Cray";
    case 6 :
        $string0 = "Shrimp";
    case 7 :
        $string0 = "Green moth";
    case 8 :
        $string0 = "Grey moth";
}
if_settext(fishcomp_side:selected_bait_txt, $string0);
