[clientscript,fishcomp_rewards_shop_refresh]
if_setobject(fishcomp_rewards_shop:fish_1_icon, %fishcomp_rewards_shop_species_1, %fishcomp_rewards_shop_quantity_1);
if_setopbase(fishcomp_rewards_shop:fish_1_icon, oc_name(%fishcomp_rewards_shop_species_1));
if_setobject(fishcomp_rewards_shop:fish_2_icon, %fishcomp_rewards_shop_species_2, %fishcomp_rewards_shop_quantity_2);
if_setopbase(fishcomp_rewards_shop:fish_2_icon, oc_name(%fishcomp_rewards_shop_species_2));
if_settext(fishcomp_rewards_shop:tokens_txt, tostring(%varplayerbit_7295));
switch_obj (%fishcomp_rewards_shop_species_1) {
    case cert_raw_shark :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "Shark");
    case cert_raw_swordfish :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "Swordfish");
    case cert_raw_lobster :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "Lobster");
    case cert_raw_tuna :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "Tuna");
    case cert_raw_salmon :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "Salmon");
    case cert_raw_pike :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "Pike");
    case cert_raw_trout :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "Trout");
    case cert_raw_herring :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "Herring");
    case cert_raw_sardine :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "Sardine");
    case cert_raw_shrimp :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "Shrimp");
    case default :
        if_settext(fishcomp_rewards_shop:species_name_1_txt, "");
}
switch_obj (%fishcomp_rewards_shop_species_2) {
    case cert_raw_shark :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "Shark");
    case cert_raw_swordfish :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "Swordfish");
    case cert_raw_lobster :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "Lobster");
    case cert_raw_tuna :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "Tuna");
    case cert_raw_salmon :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "Salmon");
    case cert_raw_pike :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "Pike");
    case cert_raw_trout :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "Trout");
    case cert_raw_herring :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "Herring");
    case cert_raw_sardine :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "Sardine");
    case cert_raw_shrimp :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "Shrimp");
    case default :
        if_settext(fishcomp_rewards_shop:species_name_2_txt, "");
}
switch_int (%varplayerbit_7306) {
    case 0 :
        if_settext(fishcomp_rewards_shop:tackle_box_cost_txt, "Cost: <tostring(110)> tokens");
        if_settext(fishcomp_rewards_shop:tackle_box_req_txt, "(Requires <tostring(20)> medals)");
        if_setobject(fishcomp_rewards_shop:box_icon, fishcomp_tackle_box_01, -1);
    case 1 :
        if_settext(fishcomp_rewards_shop:tackle_box_cost_txt, "Cost: <tostring(230)> tokens");
        if_settext(fishcomp_rewards_shop:tackle_box_req_txt, "(Requires <tostring(50)> medals)");
        if_setobject(fishcomp_rewards_shop:box_icon, fishcomp_tackle_box_02, -1);
    case 2 :
        if_settext(fishcomp_rewards_shop:tackle_box_cost_txt, "Cost: <tostring(470)> tokens");
        if_settext(fishcomp_rewards_shop:tackle_box_req_txt, "(Requires <tostring(110)> medals)");
        if_setobject(fishcomp_rewards_shop:box_icon, fishcomp_tackle_box_03, -1);
    case 3 :
        if_settext(fishcomp_rewards_shop:tackle_box_cost_txt, "Cost: <tostring(900)> tokens");
        if_settext(fishcomp_rewards_shop:tackle_box_req_txt, "(Requires <tostring(230)> medals)");
        if_setobject(fishcomp_rewards_shop:box_icon, fishcomp_tackle_box_04, -1);
    case 4 :
        if_settext(fishcomp_rewards_shop:tackle_box_cost_txt, "Cost: <tostring(1860)> tokens");
        if_settext(fishcomp_rewards_shop:tackle_box_req_txt, "(Requires <tostring(500)> medals)");
        if_setobject(fishcomp_rewards_shop:box_icon, fishcomp_tackle_box_04, -1);
    case 5 :
        if_settext(fishcomp_rewards_shop:tackle_box_cost_txt, "You already own the best tackle box available.");
        if_settext(fishcomp_rewards_shop:tackle_box_req_txt, "(Unavailable)");
        if_setobject(fishcomp_rewards_shop:box_icon, null, -1);
}
if_setmodelangle(fishcomp_rewards_shop:box_icon, 0, 0, 250, 1666, 0, 1440);
return;
