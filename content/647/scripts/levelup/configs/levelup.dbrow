// 289's levelup.dbrow at 2011. 2011's box is one interface, 740, for every stat;
// its first line is title_text (void-634's LevelUp.kt), its second "You have now
// reached level N!". flash_bit is the stat's bit of %skill_stat_flash (varp 1179,
// clientscript 970); icon its index in 2011's skill menu (varbit 4757's icons,
// varp 965's guides, varp 1230's details).

[levelup_attack]
table=levelup
data=stat,attack
data=interface,dialogue_level_up
data=title,dialogue_level_up:line1
data=body,dialogue_level_up:line2
data=message,"Congratulations, you just advanced an attack level."
data=level_prefix,You have now reached level
data=levelup_jingle,advance attack
data=unlocks_jingle,advance attack2
data=unlocks_levels,levelup_unlocks_attack
data=title_text,"Congratulations! You've just advanced an Attack level!"
data=flash_bit,0
data=icon,1

[levelup_strength]
table=levelup
data=stat,strength
data=interface,dialogue_level_up
data=title,dialogue_level_up:line1
data=body,dialogue_level_up:line2
data=message,"Congratulations, you just advanced a strength level."
data=level_prefix,You have now reached level
data=levelup_jingle,advance strength
data=unlocks_jingle,advance strength2
data=unlocks_levels,levelup_unlocks_strength
data=title_text,"Congratulations! You've just advanced a Strength level!"
data=flash_bit,1
data=icon,2

