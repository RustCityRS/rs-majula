// 1883
[proc,skillmulti2010_menubutton](int $int0, int $int1, int $int2, obj $obj3, string $string0, component $component4)(int)
cc_deleteall($component4);
if ($obj3 = null) {
    if_sethide($component4, true);
    return($int0);
}
~skillmulti2010_menubutton_off($int0, $int1, $obj3, $string0, $component4);
if_sethide($component4, false);
if_setonmouseover($component4, "skillmulti2010_menubutton_on(calc($int0 - $int2), calc($int1 + $int2 + $int2), $obj3, $string0, $component4)");
if_setonmouseleave($component4, "skillmulti2010_menubutton_off($int0, $int1, $obj3, $string0, $component4)");
return(calc($int0 + $int1 + $int2));
