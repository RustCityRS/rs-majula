// 1228
[clientscript,tzhaar_fightcave_slide](component $component0, component $component1, component $component2, int $int3)
def_int $int4 = if_getheight($component0);
def_int $int5 = calc(clientclock - $int3);
def_int $int6 = 0;
if ($int5 <= 30) {
    if ($int5 = 5) {
        sound_synth(ft_fairyrings, 1, 0);
    }
    $int6 = calc(scale($int5, 30, $int4) - $int4);
    if_setposition($component1, 0, $int6, ^setpos_abs_centre, ^setpos_abs_centre);
    if_setposition($component2, 0, $int6, ^setpos_abs_centre, ^setpos_abs_centre);
    return;
}
if ($int5 < 170) {
    return;
}
if ($int5 < 200) {
    if ($int5 = 170) {
        sound_synth(ft_fairyrings, 1, 0);
    }
    $int6 = calc(0 - scale(calc($int5 - 170), 30, $int4));
    if_setposition($component1, 0, $int6, ^setpos_abs_centre, ^setpos_abs_centre);
    if_setposition($component2, 0, $int6, ^setpos_abs_centre, ^setpos_abs_centre);
    return;
}
if_setontimer($component0, null);
if_clearops($component1);
if_sethide($component1, true);
if_sethide($component2, true);
if_sethide($component0, true);
