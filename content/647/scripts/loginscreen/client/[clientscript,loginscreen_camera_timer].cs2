// 1249
[clientscript,loginscreen_camera_timer](component $component0, component $component1, component $component2)
if (clientclock < %loginscreen_camera_delaytime) {
    return;
}
def_int $int3 = calc(%varclient_176 % 10);
def_coord $coord4 = null;
def_int $rgb5 = ^black;
if ($int3 = 0) {
    if_sethide($component2, false);
    if_setontimer($component2, null);
    if_settrans($component2, 0);
    $coord4, $rgb5 = ~script1239(0);
    cam_moveto($coord4, 1000, 100, 100);
    cam_lookat($coord4, 0, 100, 100);
    %loginscreen_camera_delaytime = calc(clientclock + 30);
    %varclient_176 = calc(%varclient_176 + 2);
} else if ($int3 = 2) {
    if (if_gethide($component1) = false) {
        if_setontimer($component1, "script1252($component1, 3)");
    }
    if_setontimer($component2, "script1252($component2, 1)");
    $coord4, $rgb5 = ~script1239(1);
    ~script1251(0, $component0, $component1, $component2, $rgb5);
    if_setontimer($component0, null);
}
