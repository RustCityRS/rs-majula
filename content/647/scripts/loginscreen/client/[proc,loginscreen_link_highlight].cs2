// 2927
[proc,loginscreen_link_highlight](component $component0, component $component1, string $string0, fontmetrics $fontmetrics2, boolean $boolean3)
if ($component0 ! null) {
    if ($boolean3 = true) {
        if_settext($component1, "<u=fafafa><$string0></u>");
        if_setcolour($component1, 0xfafafa);
        if_setsize($component0, stringwidth($string0, $fontmetrics2), if_getheight($component0), ^setsize_abs, ^setsize_abs);
