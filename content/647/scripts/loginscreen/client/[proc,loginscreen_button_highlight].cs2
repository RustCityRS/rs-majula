// 2925
[proc,loginscreen_button_highlight](component $component0, graphic $graphic1, component $component2, graphic $graphic3, component $component4, graphic $graphic5)
if ($component0 ! null) {
    if_setgraphic($component0, $graphic1);
}
if ($component2 ! null) {
    if_setgraphic($component2, $graphic3);
}
if ($component4 ! null) {
    if_setgraphic($component4, $graphic5);
}
