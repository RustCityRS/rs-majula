// 2710
[proc,loginscreen_initialisecamera](component $component0, component $component1, component $component2, component $component3, component $component4, component $component5)
if_settrans($component2, 0);
if_setontimer($component2, null);
if_sethide($component2, false);
if_setontimer($component0, null);
if_setoncamfinished($component0, null);
if_sethide($component0, true);
detail_removeroofs_option_override(1);
unknown_command_6035(true);
if_setontimer($component1, null);
if_setcolour($component1, ^black);
if_settrans($component1, 0);
if_sethide($component1, false);
if (%loginscreen_previousprofiling = 1) {
    %loginscreen_camera_disabled = true;
} else if (%loginscreen_previousprofiling ! 2) {
    if (profile_cpu > 400) {
        %loginscreen_previousprofiling = 1;
        %loginscreen_camera_disabled = true;
        if (getwindowmode > 1) {
            setwindowmode(^windowmode_small);
        }
        if (getdefaultwindowmode > 1) {
            setdefaultwindowmode(1);
        }
    } else {
        %loginscreen_previousprofiling = 2;
    }
}
if_setonclick($component3, "loginscreen_disable_camera($component0, $component1, $component2, $component3, $component4, $component5)");
if_setonmouserepeat($component3, "script2961($component4, $component5, true)");
if_setonmouseleave($component3, "script2961($component4, $component5, false)");
%loginscreen_camera_disabled = true;
if (%loginscreen_camera_disabled = true) {
    if_setgraphic($component4, "animatedcam,0");
    return;
}
def_coord $coord6 = null;
def_int $rgb7 = ^black;
$coord6, $rgb7 = ~script1239(0);
cam_moveto($coord6, 1000, 100, 100);
cam_lookat($coord6, 0, 100, 100);
if_setgraphic($component4, "animatedcam,3");
%loginscreen_camera_delaytime = calc(clientclock + 30 + 30);
if_setontimer($component2, "objectives_delegation_position($component0, $component2, $component1)");
