// 1065
[clientscript,quickchat_menu_scroll](component $component0, int $int1)
if (if_getscrollx($component0) > $int1) {
    if_setscrollsize($component0, calc(if_getscrollwidth($component0) - 10), 0);
    if_setscrollpos($component0, calc(if_getscrollx($component0) - 10), 0);
    if (if_getscrollx($component0) < $int1) {
        if_setscrollsize($component0, calc($int1 + if_getwidth($component0)), 0);
        if_setscrollpos($component0, $int1, 0);
        if_setontimer($component0, null);
        return;
    }
} else if (if_getscrollx($component0) < $int1) {
    if_setscrollsize($component0, calc(if_getscrollwidth($component0) + 10), 0);
    if_setscrollpos($component0, calc(if_getscrollx($component0) + 10), 0);
    if (if_getscrollx($component0) > $int1) {
        if_setscrollsize($component0, calc($int1 + if_getwidth($component0)), 0);
        if_setscrollpos($component0, $int1, 0);
        if_setontimer($component0, null);
        return;
    }
} else {
    if_setontimer($component0, null);
    return;
}
