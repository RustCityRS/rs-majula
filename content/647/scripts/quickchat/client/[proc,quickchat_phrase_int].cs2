// 1074
[proc,quickchat_phrase_int](component $component0, chatphrase $chatphrase1, int $int2)
switch_int (%quickchat_phrase_count) {
    case 0 :
        %quickchat_phrase_int0 = $int2;
    case 1 :
        %quickchat_phrase_int1 = $int2;
    case 2 :
        %quickchat_phrase_int2 = $int2;
    case 3 :
        %quickchat_phrase_int3 = $int2;
    case 4 :
        %quickchat_phrase_int4 = $int2;
    case 5 :
        %quickchat_phrase_int5 = $int2;
    case 6 :
        %quickchat_phrase_int6 = $int2;
    case 7 :
        %quickchat_phrase_int7 = $int2;
    case 8 :
        %quickchat_phrase_int8 = $int2;
    case 9 :
        %quickchat_phrase_int9 = $int2;
}
%quickchat_phrase_count = calc(%quickchat_phrase_count + 1);
~quickchat_phrase_setup($component0, $chatphrase1);
