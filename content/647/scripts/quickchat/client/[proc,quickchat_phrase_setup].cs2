// 1072
[proc,quickchat_phrase_setup](component $component0, chatphrase $chatphrase1)
def_int $int2 = chatphrase_getdynamiccommandcount($chatphrase1);
def_int $int3 = 0;
if ($int2 > 0) {
    while (%quickchat_phrase_count < $int2 & %quickchat_phrase_count < 10) {
        $int3 = chatphrase_getdynamiccommand($chatphrase1, %quickchat_phrase_count);
        if ($int3 = 0) {
            ~quickchat_phrase_listdialog($chatphrase1);
            return;
        }
        if ($int3 = 1) {
            ~quickchat_phrase_objdialog($chatphrase1, false);
            return;
        }
        if ($int3 = 10) {
            ~quickchat_phrase_objdialog($chatphrase1, true);
            return;
        }
        if ($int3 = 2) {
            ~quickchat_phrase_countdialog($chatphrase1);
            return;
        }
        %quickchat_phrase_count = calc(%quickchat_phrase_count + 1);
    }
}
~quickchat_phrase_send($chatphrase1);
