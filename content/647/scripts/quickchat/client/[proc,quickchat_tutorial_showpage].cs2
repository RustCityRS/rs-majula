// 1032
[proc,quickchat_tutorial_showpage](enum $enum0, int $int1, int $int2)
if_setscrollpos(quickchat_tutorial:text, 0, 0);
cc_deleteall(quickchat_tutorial:scrollbar);
if_sethide(quickchat_tutorial:pagecontrols, false);
if_sethide(quickchat_tutorial:buttoncontrol, false);
if_setonclick(quickchat_tutorial:button, "script1028");
if_settext(quickchat_tutorial:button, "Shortcut keys");
cc_deleteall(quickchat_tutorial:main);
cc_deleteall(quickchat_tutorial:text);
~quickchat_tutorial_displaydata(enum(int, string, $enum0, $int1));
if_settext(quickchat_tutorial:pagecount, "Page <tostring(calc($int1 + 1))> of <tostring($int2)>");
def_int $int3 = calc($int1 + 1);
def_int $int4 = calc($int1 - 1);
if ($int1 ! calc($int2 - 1)) {
    if_setonclick(quickchat_tutorial:button_next, "quickchat_tutorial_showpage($enum0, $int3, $int2)");
    if_settrans(quickchat_tutorial:button_next, 0);
} else {
    if_setonclick(quickchat_tutorial:button_next, null);
    if_settrans(quickchat_tutorial:button_next, 200);
}
if ($int1 ! 0) {
    if_setonclick(quickchat_tutorial:button_back, "quickchat_tutorial_showpage($enum0, $int4, $int2)");
    if_settrans(quickchat_tutorial:button_back, 0);
} else {
    if_setonclick(quickchat_tutorial:button_back, null);
    if_settrans(quickchat_tutorial:button_back, 200);
}
