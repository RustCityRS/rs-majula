    return;
}
switch_int (%varplayerbit_8668) {
    case 1 :
        ~warguild_select_token_type(warguild_token_choice:attack_layer);
    case 4 :
        ~warguild_select_token_type(warguild_token_choice:combat_layer);
    case 5 :
