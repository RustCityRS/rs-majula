// 4051
[proc,warguild_overlay_arrow](component $component0, int $int1)
if_sethide($component0, false);
if_settrans($component0, 0);
if ($int1 = 1) {
    if_setgraphic($component0, "red_green_arrows,0");
    if_setposition($component0, 0, 22, ^setpos_abs_right, ^setpos_abs_top);
} else {
    if_setgraphic($component0, "red_green_arrows,1");
    if_setposition($component0, 0, calc(1 - if_getheight($component0)), ^setpos_abs_right, ^setpos_abs_top);
}
if_setontimer($component0, "warguild_slide_arrow($component0, $int1)");
