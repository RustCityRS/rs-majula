// 1961
[clientscript,bowls_main_text]
def_int $int0 = inv_total(inv, cheese);
def_int $int1 = inv_total(inv, gnome_spice);
def_int $int2 = inv_total(inv, king_worm);
def_int $int3 = inv_total(inv, onion);
def_int $int4 = inv_total(inv, dwellberries);
def_int $int5 = inv_total(inv, equa_leaves);
def_int $int6 = inv_total(inv, toads_legs);
def_int $int7 = inv_total(inv, chocolate_bar);
def_int $int8 = inv_total(inv, potato);
if ($int2 >= 4 & $int3 >= 2 & $int1 >= 1) {
    if_setcolour(interface_435:com_45, ^green);
} else {
    if_setcolour(interface_435:com_45, ^red);
}
if ($int3 >= 2 & $int1 >= 1 & $int8 >= 2) {
    if_setcolour(interface_435:com_46, ^green);
} else {
    if_setcolour(interface_435:com_46, ^red);
}
if ($int6 >= 4 & $int1 >= 1 & $int0 >= 2 & $int5 >= 2 & $int4 >= 1) {
    if_setcolour(interface_435:com_47, ^green);
} else {
    if_setcolour(interface_435:com_47, ^red);
}
if ($int7 >= 4 & $int5 >= 1) {
    if_setcolour(interface_435:com_48, ^green);
} else {
    if_setcolour(interface_435:com_48, ^red);
}
if (inv_total(inv, toads_legs) > 3) {
