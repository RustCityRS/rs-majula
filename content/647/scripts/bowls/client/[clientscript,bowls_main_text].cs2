} else {
    if_setobject(interface_435:com_25, aluft_gnome_spice_dummy, 90);
}
if (inv_total(inv, dwellberries) > 0) {
    if_setobject(interface_435:com_26, dwellberries, 140);
} else {
    if_setobject(interface_435:com_26, aluft_dwellberries_dummy, 140);
}
if (inv_total(inv, king_worm) > 3) {
    if_setobject(interface_435:com_4, king_worm, 100);
} else {
    if_setobject(interface_435:com_4, aluft_king_worm_dummy, 100);
}
if (inv_total(inv, gnome_spice) > 0) {
    if_setobject(interface_435:com_6, gnome_spice, 90);
} else {
    if_setobject(interface_435:com_6, aluft_gnome_spice_dummy, 90);
}
if (inv_total(inv, onion) > 1) {
    if_setobject(interface_435:com_5, onion, 140);
} else {
    if_setobject(interface_435:com_5, aluft_onion_dummy, 140);
}
if (inv_total(inv, potato) > 1) {
    if_setobject(interface_435:com_14, potato, 100);
} else {
    if_setobject(interface_435:com_14, aluft_potato_dummy, 100);
}
if (inv_total(inv, gnome_spice) > 0) {
    if_setobject(interface_435:com_15, gnome_spice, 90);
} else {
    if_setobject(interface_435:com_15, aluft_gnome_spice_dummy, 90);
