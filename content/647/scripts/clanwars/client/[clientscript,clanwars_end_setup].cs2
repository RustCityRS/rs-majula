// 1816
[clientscript,clanwars_end_setup](component $component0, component $component1, component $component2, component $component3, component $component4, component $component5)
switch_int (%clanwars_endtype) {
    case 4 :
        ~clanwars_end_victory($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "Your clan knocked the enemy right out of the arena.");
    case 5 :
        ~clanwars_end_victory($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "Your clan reached the target kill-count.");
    case 6 :
        ~clanwars_end_victory($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "Your clan had the highest kill-count when the time expired.");
    case 7 :
        ~clanwars_end_victory($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "Your clan had the most survivors when the time expired.");
    case 8 :
        ~clanwars_end_defeat($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "Your clan was knocked right out of the arena.");
    case 9 :
        ~clanwars_end_defeat($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "Your enemy reached the target kill-count.");
    case 10 :
        ~clanwars_end_defeat($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "Your enemy had the highest kill-count when the time expired.");
    case 11 :
        ~clanwars_end_defeat($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "Your enemy had the most survivors when the time expired.");
    case 1 :
        ~clanwars_end_draw($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "The match was aborted due to a lack of fighters.");
    case 2 :
        ~clanwars_end_draw($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "Your kill-counts were equal.");
    case 3 :
        ~clanwars_end_draw($component0, $component1, $component2, $component3, $component4, $component5);
        if_settext($component2, "You had equal numbers of survivors.");
    case default :
        if_sethide($component0, true);
        if_sethide($component1, true);
        if_sethide($component2, true);
        if_sethide($component3, true);
        if_sethide($component4, true);
        if_sethide($component5, true);
}
