// 1774
[proc,clanwars_resynch_melee]
if (%clanwars_rulevarc_nomelee = false) {
    if_setgraphic(clanwars_setup:melee_indicator, "options_radio_buttons,2");
    if_settrans(clanwars_setup:melee, 0);
} else {
    if_setgraphic(clanwars_setup:melee_indicator, "options_radio_buttons,1");
    if_settrans(clanwars_setup:melee, 225);
}
~clanwars_updateside;
