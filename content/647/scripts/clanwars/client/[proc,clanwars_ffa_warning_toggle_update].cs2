// 1795
[proc,clanwars_ffa_warning_toggle_update](component $component0, component $component1)
def_graphic $graphic2 = "options_radio_buttons,0";
def_graphic $graphic3 = "options_radio_buttons,2";
if (%clanwars_ffatype = 1) {
    if (%cws_warning_31 = 1) {
        if_setgraphic($component1, $graphic3);
        if_setonop($component0, "graphic_swapper($component1, $graphic2)");
    } else {
        if_setgraphic($component1, $graphic2);
        if_setonop($component0, "graphic_swapper($component1, $graphic3)");
    }
} else if (%cws_warning_22 = 1) {
    if_setgraphic($component1, $graphic3);
    if_setonop($component0, "graphic_swapper($component1, $graphic2)");
} else {
    if_setgraphic($component1, $graphic2);
    if_setonop($component0, "graphic_swapper($component1, $graphic3)");
}
