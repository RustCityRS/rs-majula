// 1780
[proc,clanwars_resynch_potions]
if (%clanwars_rulevarc_nopotions = false) {
    if_setgraphic(clanwars_setup:potions_indicator, "options_radio_buttons,2");
    if_settrans(clanwars_setup:potions, 0);
} else {
    if_setgraphic(clanwars_setup:potions_indicator, "options_radio_buttons,1");
    if_settrans(clanwars_setup:potions, 225);
}
~clanwars_updateside;
