// 1807
[clientscript,clanwars_caller_init](component $component0, component $component1, component $component2)
if (~bool_to_int(%clanwars_caller_init) = 0) {
    %clanwars_caller = "";
    %clanwars_caller_lastusedstring = "";
    %clanwars_caller_init = true;
}
~clanwars_caller_namechange($component0, $component1, $component2);
if_setonvarcstrtransmit($component0, "clanwars_caller_namechange($component0, $component1, $component2){clanwars_caller}");
if_setonchattransmit($component0, "script1810($component0, $component1, $component2)");
