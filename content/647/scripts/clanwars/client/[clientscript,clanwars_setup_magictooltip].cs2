// 1804
[clientscript,clanwars_setup_magictooltip](component $component0, int $int1, component $component2)
if (map_members = true) {
    ~script1163($component0, $int1, $component2, "You may choose:<br>- Allow all spells<br>- Standard spellbook only<br>- Bind/Snare/Entangle only<br>- No Magic", 25, 250);
} else {
    ~script1163($component0, $int1, $component2, "You may choose:<br>- Standard spellbook<br>- Bind only<br>- No Magic", 25, 250);
}
