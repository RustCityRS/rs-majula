// 240
[proc,snapshot_selected_highlight]
def_int $int0 = 0;
while ($int0 < if_getnextsubid(snapshot_main_v2:selected_name_layer)) {
    if (cc_find(snapshot_main_v2:selected_name_layer, $int0) = true) {
        cc_settrans(255);
    }
    $int0 = calc($int0 + 1);
}
if (cc_find(snapshot_main_v2:selected_name_layer, %snapshot_last_selected_highlight) = true) {
    cc_settrans(110);
}
