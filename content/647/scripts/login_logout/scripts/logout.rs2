[logout,_]()(boolean)
// 289's logout hooks (login_logout/logout.rs2), as their systems are ported.
~set_antifire_logout; // TODO: should be timer
~macro_event_logout;
return(true);

// 289's logout button (logout:try_logout) is two in 2011's logout tab (logout,
// 182; cache 786: com5 and com10, each op1): void-634's lobby and login
// (logout.ifaces.toml), "Exit to Lobby" and "Exit to Login". Both take 289's
// checks and log out; where each lands is the logout engine's (p_logout),
// which this does not change.
// [if_button,logout:try_logout]
[if_button,logout:button1] @try_logout;
[if_button,logout:button2] @try_logout;

[label,try_logout]
if_close;
if (p_finduid(uid) = true) {
    if (~in_duel_arena(coord) = true) {
        mes("You can't log out during a duel."); //https://youtu.be/xLE8au7T50Q?t=227
        return;
    }

    if (~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
        mes("You can't log out on a gnomeball pitch."); // osrs
        return;
    }

    p_logout;
}
