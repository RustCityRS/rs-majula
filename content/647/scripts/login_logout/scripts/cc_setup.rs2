[proc,cc_open_interface]()
%character_part = 1;

def_int $hair_count = enum_getoutputcount(enum_3304);
def_int $hair_index = random($hair_count);
def_int $hair = -1;
def_int $hair_struct = enum(105, 74, enum_3304, $hair_index);
if ($hair_struct ! -1) {
    $hair = struct_param($hair_struct, param_788);
    if ($hair ! -1) { setidkit($hair, 0); }
}
%character_creation_hair_style = $hair_index;

def_int $colour_count = enum_getoutputcount(enum_2345);
def_int $colour_index = random($colour_count);
def_int $hair_colour = enum(105, 105, enum_2345, $colour_index);
if ($hair_colour ! -1) {
    setidkcolour(0, $hair_colour);
    %playerdesign3_haircol = $hair_colour;
}

if ($hair ! -1) { %playerdesign3_head = $hair; }
%playerdesign3_jaw = 14;

if_opentop(playerdesign4);
allowdesign(^true);
// 2011 plays Destiny while the character is designed (Qh_-AMJpVd0, 2011-05-10, 40-159 s, matched by
// chroma; the 2011 wiki's Destiny page @ 2011-05-07: "character creation"), not the region's track.
~uf_play_song(music_Destiny);
~cc_enable_events();
~cc_transmit_invs();

[proc,cc_send_makeover_varcs]()
%playerdesign3_head = 0
%playerdesign3_jaw = 14
%playerdesign3_torso = 18
%playerdesign3_arms = 26
%playerdesign3_hands = 34
%playerdesign3_legs = 38
%playerdesign3_feet = 42
%playerdesign3_haircol = 0
%playerdesign3_torsocol = 0
%playerdesign3_legscol = 0
%playerdesign3_feetcol = 0

[proc,cc_transmit_invs]()
inv_transmit(ranging_guild_bowshop_skillcape, playerdesign4:skincolours)
inv_transmit(poh_costume_room_treasure_trail_2a_inv, playerdesign4:skincolours)
inv_transmit(poh_costume_room_treasure_trail_2a_inv_check, playerdesign4:skincolours)
inv_transmit(playerkit_default, playerdesign4:skincolours)
inv_transmit(playerkit_mage, playerdesign4:skincolours)
inv_transmit(playerkit_chef, playerdesign4:skincolours)
inv_transmit(playerkit_crafter, playerdesign4:skincolours)
