name=<col=00ffff>Portal</col>
model1=model_38323
unknown119=1
cursor1=1,cursor_enter
// 289's way out of the essence mine is a loc, blankrunestone_exit_portal
// (2492). In 2011 that loc is "Compacted snow" with no op, left where the
// four portals stood (cache 786), and the portals are these four npcs:
// "Portal", op1 Enter, each name in its own near-cyan. The cache has no npc
// spawns there, so their standing on the snow's four tiles (maps/spawns
// n45_75) is inferred; void-634 still has 2492 as the portal loc.
// They stand in place, as 289's portal loc did: wanderrange=0, where the
// npc default (5, as the server loads npc types since c7b4f69) walks them.
desc=A portal from this mystical place.
category=blankrunestone_exit_portal
wanderrange=0

