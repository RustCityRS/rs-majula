// 2129
[clientscript,macro_beekeeper_dragcomplete](component $component0, component $component1, component $component2)
switch_component ($component1) {
    case beehive:start_1, beehive:start_2, beehive:start_3, beehive:start_4, beehive:dest_1, beehive:dest_2, beehive:dest_3, beehive:dest_4 :
        if_setposition($component0, if_getx($component1), if_gety($component1), ^setpos_abs_left, ^setpos_abs_top);
        sound_synth(synth_5507, 1, 0);
    case default :
        if_setposition($component0, if_getx($component2), if_gety($component2), ^setpos_abs_left, ^setpos_abs_top);
}
