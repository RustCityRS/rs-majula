// Dev cheats for rs-test's general_procs.rs: 289's general procs that 647
// ports in general/scripts, said as their callers say them.

// 289's In Search of the Myreque complete scroll (quest_routequest).
[debugproc,quest_complete2]
if (p_finduid(uid) = true) {
    ~send_quest_complete2(^questlist_death, steel_sword, 200, 2, "'In Search of the Myreque' completed.", "Attack & Defence XP|Strength & Hitpoint XP|Crafting XP|Quick Route to Mort'ton");
}

// 289's Grand Tree scroll (quest_grandtree's opheld1 on grandtree_scroll).
[debugproc,scroll_hazelmere]
if (p_finduid(uid) = true) {
    @scroll_hazelmere;
}

// A two-page book, as 289's book callers open theirs (ardougne_book's).
[debugproc,book_test]
if (p_finduid(uid) = true) {
    %book_page = 0;
    %open_book = bronze_dagger;
    @book_flip_page(0, 0, 1, test_book_pages);
}

[proc,test_book_pages]
switch_int (%book_page) {
    case 0 : ~book("Test Book", "First page.");
    case 1 : ~book_obj("Test Book", book:page_left_model_2, bronze_dagger, 500, "Second page.|With a dagger.");
}

