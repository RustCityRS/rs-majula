#testscript

// 2011's world map key (interface_worldmap): "Re-sort key" steps 0
// Traditional, 1 Alphabetical, 2 Categorised and back to 0, as clientscript
// 692 (worldmap_keysort_button) rebuilds it; anything else starts over.
[label,test_worldmap_keysort_next_cycles]
assert_eq(~worldmap_keysort_next(0), 1)
assert_eq(~worldmap_keysort_next(1), 2)
assert_eq(~worldmap_keysort_next(2), 0)
assert_eq(~worldmap_keysort_next(3), 0)
