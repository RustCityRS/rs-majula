#testscript

[label,test_globalscript_plural_picks_noun]
assert_str_eq(~text_plural(1, "apple", "apples"), "apple")
assert_str_eq(~text_plural(2, "apple", "apples"), "apples")
assert_str_eq(~text_plural(0, "apple", "apples"), "apples")
assert_str_eq("<tostring(2)> <~text_plural(2, "apple", "apples")>", "2 apples")

[label,test_globalscript_bonus_xp_keeps_event_guard]
setup_player("test_player")
%doublexp_setupflag = 0
%doublexp_timetotal = 0
assert_eq(~doublexp_multiplier, 1000)
%doublexp_setupflag = 1
assert_eq(~doublexp_multiplier, 2700)
%doublexp_timetotal = 30
assert_eq(~doublexp_multiplier, 2550)
%doublexp_timetotal = 599
assert_eq(~doublexp_multiplier, 1125)
%doublexp_timetotal = 600
assert_eq(~doublexp_multiplier, 1100)
assert_eq(~script338(23), 1100)

[label,test_globalscript_bank_keeps_server_tab_numbers]
setup_player("test_player")
%bank_tab_1 = 2
%bank_tab_2 = 3
%bank_tab_3 = 0
%bank_tab_4 = 0
%bank_tab_5 = 0
%bank_tab_6 = 0
%bank_tab_7 = 0
%bank_tab_8 = 4
assert_eq(~bank_tab_size(0), 0)
assert_eq(~bank_tab_size(1), 2)
assert_eq(~bank_tab_size(2), 3)
assert_eq(~bank_tab_size(8), 4)
assert_eq(~bank_tab_size(9), 0)
assert_eq(~bank_slot_tab(0), 1)
assert_eq(~bank_slot_tab(2), 2)
assert_eq(~bank_slot_tab(5), 8)
assert_eq(~bank_slot_tab(9), 0)
assert_eq(~bank_slot_tab(0x7FFFFFFF), 0)
assert_eq(~bank_tab_start(0), 0)
assert_eq(~bank_tab_start(2), 2)
assert_eq(~bank_tab_start(8), 5)
assert_eq(~bank_tab_start(9), 9)
assert_eq(~bank_tab_start(10), 9)

[label,test_globalscript_music_keeps_bitfield_coordinates]
setup_player("test_player")
%musicmulti_1 = 5
%musicmulti_2 = 2
assert_eq(~music_unlockbit(1, 0), 1)
assert_eq(~music_unlockbit(1, 1), 0)
assert_eq(~music_unlockbit(1, 2), 1)
assert_eq(~music_unlockbit(2, 1), 1)
assert_eq(~music_unlockbit(2, 0), 0)
assert_eq(~music_unlockbit(28, 0), 1)
assert_eq(~music_unlockbit(0, 0), 1)
assert_eq(~music_getvar(32), 0)
assert_eq(~music_getvar(33), 1)
