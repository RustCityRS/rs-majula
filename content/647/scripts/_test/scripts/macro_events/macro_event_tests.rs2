#testscript

// The random events of 289's that 2011 kept (macro events/; 2011 wiki,
// Random events, 2011-05-13, which lists 2011's others): a roll brings the
// Maze, the Mime or nothing, a quarter of the time an event (289's odds for
// its teleport events, which 2011's all are, per that page).
[label,test_a_roll_brings_the_maze_the_mime_or_nothing]
setup_player("test_player")
p_telejump(0_50_50_21_18)
test_tick(1)
def_int $i = 0;
def_int $event;
def_int $events = 0;
while ($i < 400) {
    $event = ~macro_event_set_random;
    if ($event = ^macro_mime | $event = ^macro_maze) {
        $events = add($events, 1);
    } else if ($event ! ^no_macro_event) {
        test_fail("a roll brought <tostring($event)>")
    }
    $i = add($i, 1);
}
assert_gt($events, 50)
assert_lt($events, 150)

// The Mime's gift offers his emote (slot 26), a costume point (27) and, with
// them, 6-14 choices on a members world (4-11 on a free one): at most one per
// category (enum 2238), so at most 11 rewards beside the two.
[label,test_the_mime_s_gift_offers_the_emote_the_costume_point_and_rewards]
setup_player("test_player")
%random_event_gift_event = ^macro_mime
~random_event_gift_fill
assert_gt(inv_getnum(macro_certer, 26), 0)
assert_gt(inv_getnum(macro_certer, 27), 0)
def_int $slot = 0;
def_int $rewards = 0;
while ($slot < 26) {
    if (inv_getnum(macro_certer, $slot) > 0) {
        $rewards = add($rewards, 1);
    }
    $slot = add($slot, 1);
}
assert_gte($rewards, 2)
assert_lte($rewards, 11)

// A third of the total level in coins, when coins are offered.
[label,test_the_gift_s_coins_are_a_third_of_the_total_level]
setup_player("test_player")
%random_event_gift_event = ^macro_maze
def_int $tries = 0;
while ($tries < 50) {
    ~random_event_gift_fill
    if (inv_total(macro_certer, coins) > 0) {
        assert_eq(inv_total(macro_certer, coins), max(divide(~total_level, 3), 1))
        return;
    }
    $tries = add($tries, 1);
}
test_fail("50 gifts offered no coins")

// A reward sits in its category's slot, which the client labels (cache-786
// enum 2238): coins in Cash (0), coal in Coal (2).
[label,test_the_gift_s_rewards_sit_in_their_category_s_slot]
setup_player("test_player")
%random_event_gift_event = ^macro_maze
def_int $tries = 0;
def_int $slot;
while ($tries < 40) {
    ~random_event_gift_fill
    $slot = 0;
    while ($slot < 28) {
        if (inv_getnum(macro_certer, $slot) > 0) {
            if (inv_getobj(macro_certer, $slot) = coins & $slot ! 0) {
                test_fail("coins in slot <tostring($slot)>")
            }
            if (inv_getobj(macro_certer, $slot) = coal & $slot ! 2) {
                test_fail("coal in slot <tostring($slot)>")
            }
            if ($slot >= 10 & $slot ! 24) {
                test_fail("a reward in slot <tostring($slot)>")
            }
        }
        $slot = add($slot, 1);
    }
    $tries = add($tries, 1);
}
assert_eq($tries, 40)
