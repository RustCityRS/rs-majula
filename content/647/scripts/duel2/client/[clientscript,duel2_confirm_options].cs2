// 4179
[clientscript,duel2_confirm_options](component $component0, component $component1, component $component2, component $component3)
def_int $int4 = ~script4180(0, $component0, "Boosted stats will be reset.", 0);
if (%duelwornoptions > 0) {
    $int4 = ~script4180($int4, $component0, "Some worn items will be taken off.", 0);
}
if (%varplayerbit_4166 = 1) {
    $int4 = ~script4180($int4, $component0, "Existing prayers will be stopped.", 0);
}
if ($int4 > if_getheight($component0)) {
    if_setscrollsize($component0, 0, $int4);
    ~scrollbar_vertical($component1, $component0, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
    if_sethide($component1, false);
    if_setposition($component0, 0, 0, ^setpos_abs_left, ^setpos_abs_centre);
} else {
    if_setscrollsize($component0, 0, 0);
    cc_deleteall($component1);
    if_sethide($component1, true);
    if_setposition($component0, 0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
}
def_int $int5 = 0;
if (map_members = true & (inv_total(inv, black_salamander) > 0 | inv_total(worn, black_salamander) > 0 | inv_total(inv, red_salamander) > 0 | inv_total(worn, red_salamander) > 0 | inv_total(inv, orange_salamander) > 0 | inv_total(worn, orange_salamander) > 0 | inv_total(inv, green_salamander) > 0 | inv_total(worn, green_salamander) > 0)) {
    $int5 = 1;
}
