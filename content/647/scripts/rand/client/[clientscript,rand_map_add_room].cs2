// 3278
[clientscript,rand_map_add_room](int $int0, int $int1, graphic $graphic2, int $int3)
def_int $int4 = 0;
def_int $int5 = 0;
switch_int ($int3) {
    case 1 :
        $int4 = calc(if_getwidth(rand_dungeon_map:room_layer) / 4);
        $int5 = calc(if_getheight(rand_dungeon_map:room_layer) / 4);
    case 2 :
        $int4 = calc(if_getwidth(rand_dungeon_map:room_layer) / 4);
    case default :
}
cc_create(rand_dungeon_map:room_layer, ^iftype_graphic, %rand_map_room_count);
%rand_map_room_count = calc(%rand_map_room_count + 1);
cc_setsize(32, 32, ^setsize_abs, ^setsize_abs);
cc_setgraphic($graphic2);
cc_setposition(calc($int0 * 32 + $int4), calc($int1 * 32 + $int5), ^setpos_abs_left, ^setpos_abs_bottom);
cc_sethide(false);
