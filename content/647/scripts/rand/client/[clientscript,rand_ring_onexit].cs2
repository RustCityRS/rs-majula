// 3493
[clientscript,rand_ring_onexit](component $component0)
switch_component ($component0) {
    case rand_ring_interface:com_136 :
        if_sethide(rand_ring_interface:com_137, true);
    case rand_ring_interface:com_43 :
        if_sethide(rand_ring_interface:com_44, true);
    case rand_ring_interface:com_85 :
        if_sethide(rand_ring_interface:com_86, true);
    case rand_ring_interface:cancel_button :
        if_setgraphic(rand_ring_interface:cancel_button_left, "login_lobby_button,8");
        if_setgraphic(rand_ring_interface:cancel_button_middle, "login_lobby_button,9");
        if_setgraphic(rand_ring_interface:cancel_button_right, "login_lobby_button,8");
    case rand_ring_interface:confirm_button :
        if_setgraphic(rand_ring_interface:confirm_button_left, "login_lobby_button,8");
        if_setgraphic(rand_ring_interface:confirm_button_middle, "login_lobby_button,9");
        if_setgraphic(rand_ring_interface:confirm_button_right, "login_lobby_button,8");
}
