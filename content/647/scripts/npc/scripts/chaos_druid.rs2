// Labels, so 2011's chaos druids share them: 2547 and 7105 (cache 786: "Chaos
// druid", level 13, as 289's) are 289's chaos druid (npc_clones_2011.npc:
// void-634's clones).
[ai_applayer2,chaos_druid] @chaos_druid_ai_applayer2;
[ai_opplayer2,chaos_druid] @chaos_druid_ai_opplayer2;
[ai_applayer2,chaos_druid_2547] @chaos_druid_ai_applayer2;
[ai_opplayer2,chaos_druid_2547] @chaos_druid_ai_opplayer2;
[ai_applayer2,chaos_druid_7105] @chaos_druid_ai_applayer2;
[ai_opplayer2,chaos_druid_7105] @chaos_druid_ai_opplayer2;

[label,chaos_druid_ai_applayer2]
if (%npc_action_delay > map_clock) {
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}
~chaos_druid_spell;
if(random(4) ! 0) npc_setmode(opplayer2);

[label,chaos_druid_ai_opplayer2]
if (%npc_action_delay > map_clock) {
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}
// ~1/4 based off 100 attacks in osrs
if(random(3) = 0) {
    ~chaos_druid_spell;
} else {
    ~npc_default_attack;
}

[proc,chaos_druid_spell]
def_dbrow $spell_data = ~get_spell_data(^bind);
def_dbrow $effect_spell = ~get_spell_data(^confuse);
def_int $duration = ~npc_spell_cast($spell_data, 4);

if (~npc_player_hit_roll(^magic_style) = true & ~check_protect_prayer(^magic_style) = false) {
    ~npc_spell_success($spell_data, null, $duration);
    if(~npc_debuff_allowed($effect_spell) = true) ~npc_stat_change_effect($effect_spell);
    queue(chaosdruid_freeze_player, 0, 0);
} else {
    ~npc_spell_fail($spell_data, $duration);
}
~npc_set_attack_vars;

[queue,chaosdruid_freeze_player]
%frozen = calc(map_clock + 3);
walktrigger(chaos_druid_frozen);

[walktrigger,chaos_druid_frozen]
if (map_clock < %frozen) {
    p_walk(coord);
    walktrigger(chaos_druid_frozen);
}
