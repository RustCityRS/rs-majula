// 2011 milks dairy cows, which are locs: "Dairy cows were introduced because
// players could attack and kill a cow whilst another player was milking it"
// (2011 wiki, Dairy cow). A cow turns a bucket away like anything else.
[opnpcu,cow] @cow_use;
[opnpcu,cow2] @cow_use;

// 2011's other cows (cache 786 names each "Cow", level 2, as 289's): 1767, 3309,
// 12362, 12363 and 12365 are 289's cow (npc_clones_2011.npc: void-634's clones
// of cow_default), so 289's cow's use.
[opnpcu,cow_1767] @cow_use;
[opnpcu,fairy_cow] @cow_use;
[opnpcu,cow_12362] @cow_use;
[opnpcu,cow_12363] @cow_use;
[opnpcu,cow_12365] @cow_use;

[label,cow_use]
switch_obj(last_useitem) {
    // case bucket : @milk_cow;
    case default : mes("The cow doesn't want that."); // osrs
}
// 289's cow_beef (955) is another npc at 2011.
// [opnpcu,cow_beef]
// switch_obj(last_useitem) {
//     case bucket : @milk_cow;
//     case default : mes("The cow doesn't want that."); // osrs
// }

[label,milk_cow]
inv_del(inv, bucket_empty, 1);
inv_add(inv, bucket_milk, 1);
mes("You milk the cow."); // osrs and rsc

// 2011's dairy cows (void-634 MilkCow): milked with an empty bucket; without
// one, Gillie Groats, who keeps Lumbridge's, laughs.
[oploc1,fat_cow] @milk_dairy_cow;
[oploc2,fairy_fat_cow] @milk_dairy_cow;

[label,milk_dairy_cow]
if (inv_total(inv, bucket_empty) < 1) {
    ~chatnpc_specific("Gillie Groats", gillie_the_milkmaid, "<p,laugh>Tee hee! You've never milked a cow before, have you?");
    ~chatplayer("<p,quiz>Erm...no. How could you tell?");
    ~chatnpc_specific("Gillie Groats", gillie_the_milkmaid, "<p,laugh>Because you're spilling milk all over the floor. What a waste! You need something to hold the milk.");
    ~chatplayer("<p,neutral>Ah, yes, I really should have guessed that one, shouldn't I?");
    ~chatnpc_specific("Gillie Groats", gillie_the_milkmaid, "<p,laugh>You're from the city, aren't you? Try it again with an empty bucket.");
    ~chatplayer("<p,neutral>Right, I'll do that.");
    mes("You'll need an empty bucket to collect the milk.");
    return;
}
p_arrivedelay;
anim(milkit, 0);
sound_synth(milk_cow, 1, 0);
p_delay(4);
@milk_cow;
