// 2490
[proc,mob_locator_resource_setup]
if (%mob_locator_charges < 0) {
    %mob_locator_charges = 0;
}
if (%mob_locator_type < 0) {
    %mob_locator_type = 1;
}
if_settext(mob_locator:charges, "Charges left: <tostring(%mob_locator_charges)>");
if_setobject_nonum(mob_locator:ore1, copper_ore, 1);
if_setobject_nonum(mob_locator:ore2, tin_ore, 1);
if_setobject_nonum(mob_locator:ore3, iron_ore, 1);
if_setobject_nonum(mob_locator:ore4, silver_ore, 1);
if_setobject_nonum(mob_locator:ore5, clay, 1);
if_setobject_nonum(mob_locator:ore6, gold_ore, 1);
if_setobject_nonum(mob_locator:ore7, mithril_ore, 1);
if_setobject_nonum(mob_locator:ore8, adamantite_ore, 1);
if_setobject_nonum(mob_locator:ore9, runite_ore, 1);
if_settext(mob_locator:oretext1, oc_name(copper_ore));
if_settext(mob_locator:oretext2, oc_name(tin_ore));
if_settext(mob_locator:oretext3, oc_name(iron_ore));
if_settext(mob_locator:oretext4, oc_name(silver_ore));
if_settext(mob_locator:oretext5, oc_name(clay));
if_settext(mob_locator:oretext6, oc_name(gold_ore));
if_settext(mob_locator:oretext7, oc_name(mithril_ore));
if_settext(mob_locator:oretext8, oc_name(adamantite_ore));
if_settext(mob_locator:oretext9, oc_name(runite_ore));
if_setcolour(mob_locator:oretext1, 0xe1981f);
if_setcolour(mob_locator:oretext2, 0xe1981f);
if_setcolour(mob_locator:oretext3, 0xe1981f);
if_setcolour(mob_locator:oretext4, 0x996600);
if_setcolour(mob_locator:oretext5, 0x996600);
if_setcolour(mob_locator:oretext6, 0x996600);
if_setcolour(mob_locator:oretext7, 0x996600);
if_setcolour(mob_locator:oretext8, 0x996600);
if_setcolour(mob_locator:oretext9, 0x996600);
if (%mob_locator_type >= 2) {
    if_setcolour(mob_locator:oretext4, 0xe1981f);
    if_setcolour(mob_locator:oretext5, 0xe1981f);
}
if (%mob_locator_type >= 3) {
    if_setcolour(mob_locator:oretext6, 0xe1981f);
    if_setcolour(mob_locator:oretext7, 0xe1981f);
}
if (%mob_locator_type >= 4) {
    if_setcolour(mob_locator:oretext8, 0xe1981f);
    if_setcolour(mob_locator:oretext9, 0xe1981f);
}
if_setobject_nonum(mob_locator:wood1, oak_logs, 1);
if_setobject_nonum(mob_locator:wood2, willow_logs, 1);
if_setobject_nonum(mob_locator:wood3, maple_logs, 1);
if_setobject_nonum(mob_locator:wood4, eucalyptus_logs, 1);
if_setobject_nonum(mob_locator:wood5, yew_logs, 1);
if_setobject_nonum(mob_locator:wood6, magic_logs, 1);
if_settext(mob_locator:woodtext1, oc_name(oak_logs));
if_settext(mob_locator:woodtext2, oc_name(willow_logs));
if_settext(mob_locator:woodtext3, oc_name(maple_logs));
if_settext(mob_locator:woodtext4, "Special logs");
if_settext(mob_locator:woodtext5, oc_name(yew_logs));
if_settext(mob_locator:woodtext6, oc_name(magic_logs));
if_setcolour(mob_locator:woodtext1, 0xe1981f);
if_setcolour(mob_locator:woodtext2, 0xe1981f);
if_setcolour(mob_locator:woodtext3, 0x996600);
if_setcolour(mob_locator:woodtext4, 0x996600);
if_setcolour(mob_locator:woodtext5, 0x996600);
if_setcolour(mob_locator:woodtext6, 0x996600);
if (%mob_locator_type >= 2) {
    if_setcolour(mob_locator:woodtext3, 0xe1981f);
    if_setcolour(mob_locator:woodtext4, 0xe1981f);
}
if (%mob_locator_type >= 3) {
    if_setcolour(mob_locator:woodtext5, 0xe1981f);
}
if (%mob_locator_type >= 4) {
    if_setcolour(mob_locator:woodtext6, 0xe1981f);
}
if_setobject_nonum(mob_locator:fish1, raw_shrimp, 1);
if_setobject_nonum(mob_locator:fish2, raw_lobster, 1);
if_settext(mob_locator:fishtext1, "Fish 1");
if_settext(mob_locator:fishtext2, "Fish 2");
if_setcolour(mob_locator:fishtext1, 0xe1981f);
if (%mob_locator_type >= 3) {
    if_setcolour(mob_locator:fishtext2, 0xe1981f);
} else {
    if_setcolour(mob_locator:fishtext2, 0x996600);
}
if_setobject_nonum(mob_locator:herb1, toads_legs, 1);
if_setobject_nonum(mob_locator:herb2, white_berries, 1);
if_settext(mob_locator:herbtext1, "Herblore<br>secondaries 1");
if_settext(mob_locator:herbtext2, "Herblore<br>secondaries 2");
if_setcolour(mob_locator:herbtext1, 0xe1981f);
if_setcolour(mob_locator:herbtext2, 0xe1981f);
if (%mob_locator_type >= 3) {
    if_setcolour(mob_locator:herbtext2, 0xe1981f);
} else {
    if_setcolour(mob_locator:herbtext2, 0x996600);
}
