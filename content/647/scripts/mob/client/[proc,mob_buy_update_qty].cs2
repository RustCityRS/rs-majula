// 2565
[proc,mob_buy_update_qty]
def_int $int0 = 0;
%mob_client_squad_qty_selected = %varplayerbit_6380;
if_settext(mob_squad_buy:quantity_field, tostring(%varplayerbit_6380));
$int0 = calc(%mob_client_invest - 100 * %mob_client_squad_qty_selected);
if_settext(mob_squad_buy:remainder_field, ~tostring_spacer($int0, ","));
