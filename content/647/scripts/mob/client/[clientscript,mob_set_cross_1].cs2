// 2548
[clientscript,mob_set_cross_1]
if (%mob_side_unit_cross_1 = 1) {
    if_setgraphic(mob_side_units:unit1_cross, "mob_cross_icon,0");
} else if (%mob_side_unit_cross_1 = 2) {
    if_setgraphic(mob_side_units:unit1_cross, "mob_cross_icon,2");
} else if (%mob_side_unit_cross_1 = 3) {
    if_setgraphic(mob_side_units:unit1_cross, "mob_cross_icon,3");
} else if (%mob_side_unit_cross_1 = 4) {
    if_setgraphic(mob_side_units:unit1_cross, "mob_cross_icon,1");
}
