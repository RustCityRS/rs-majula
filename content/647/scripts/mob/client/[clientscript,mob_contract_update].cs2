// 2566
[clientscript,mob_contract_update]
if_settext(mob_squad_contract:unit_stats, %varclient_1701);
if_settext(mob_squad_contract:unit_desc, %varclient_1702);
if (%mob_squad_contract_model = 0) {
    if_setmodel(mob_squad_contract:squad_model, model_47798);
} else if (%mob_squad_contract_model = 1) {
    if_setmodel(mob_squad_contract:squad_model, model_47794);
} else if (%mob_squad_contract_model = 2) {
    if_setmodel(mob_squad_contract:squad_model, model_47792);
} else if (%mob_squad_contract_model = 3) {
    if_setmodel(mob_squad_contract:squad_model, model_47786);
} else if (%mob_squad_contract_model = 4) {
    if_setmodel(mob_squad_contract:squad_model, model_47787);
} else if (%mob_squad_contract_model = 5) {
    if_setmodel(mob_squad_contract:squad_model, model_47796);
}
