// 2533
[proc,mob_set_head_3]
if (%mob_side_unit_head_3 = 1) {
    if_setgraphic(mob_side_units:unit3, "mob_unit_heads,4");
} else if (%mob_side_unit_head_3 = 2) {
    if_setgraphic(mob_side_units:unit3, "mob_unit_heads,1");
} else if (%mob_side_unit_head_3 = 3) {
    if_setgraphic(mob_side_units:unit3, "mob_unit_heads,2");
}
