// 2551
[clientscript,mob_set_cross_4]
if (%mob_side_unit_cross_4 = 1) {
    if_setgraphic(mob_side_units:unit4_cross, "mob_cross_icon,0");
} else if (%mob_side_unit_cross_4 = 2) {
    if_setgraphic(mob_side_units:unit4_cross, "mob_cross_icon,2");
} else if (%mob_side_unit_cross_4 = 3) {
    if_setgraphic(mob_side_units:unit4_cross, "mob_cross_icon,3");
} else if (%mob_side_unit_cross_4 = 4) {
    if_setgraphic(mob_side_units:unit4_cross, "mob_cross_icon,1");
}
