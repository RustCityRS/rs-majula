// 2561
[clientscript,mob_rank_click]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
if (%mob_client_squad_weight_selected = 0) {
    if_setgraphic(mob_squad_buy:button_light, "radio_buttons,1");
    if_setgraphic(mob_squad_buy:button_heavy, "radio_buttons,0");
} else {
    if_setgraphic(mob_squad_buy:button_light, "radio_buttons,0");
    if_setgraphic(mob_squad_buy:button_heavy, "radio_buttons,1");
}
if (%mob_client_squad_weight_selected = 0) {
    if (%mob_client_squad_race_selected = 1) {
        if_settext(mob_squad_buy:race_field, "Dwarf");
        $int0 = 175;
        $int1 = 5300;
        $int2 = 60;
    } else if (%mob_client_squad_race_selected = 2) {
        if_settext(mob_squad_buy:race_field, "Goblin");
        $int0 = 175;
        $int1 = 4800;
        $int2 = 110;
    } else if (%mob_client_squad_race_selected = 3) {
        if_settext(mob_squad_buy:race_field, "Elf");
        $int0 = 225;
        $int1 = 4800;
        $int2 = 60;
    }
} else if (%mob_client_squad_weight_selected = 1) {
    if (%mob_client_squad_race_selected = 1) {
        if_settext(mob_squad_buy:race_field, "Dwarf");
        $int0 = 350;
        $int1 = 10100;
        $int2 = 60;
    } else if (%mob_client_squad_race_selected = 2) {
        if_settext(mob_squad_buy:race_field, "Goblin");
        $int0 = 350;
        $int1 = 9600;
        $int2 = 110;
    } else if (%mob_client_squad_race_selected = 3) {
        if_settext(mob_squad_buy:race_field, "Elf");
        $int0 = 400;
        $int1 = 9600;
        $int2 = 60;
    }
}
$int3 = 100;
if_settext(mob_squad_buy:cost_field, ~tostring_spacer($int3, ","));
if_settext(mob_squad_buy:combat_field, tostring($int0));
if_settext(mob_squad_buy:hitpoints_field, tostring($int1));
if_settext(mob_squad_buy:discipline_field, tostring($int2));
if_settext(mob_squad_buy:desc_field, enum(int, string, enum_2386, %mob_client_squad_race_selected));
if (%mob_client_squad_race_selected = 1 & %mob_client_squad_weight_selected = 0) {
    if_setmodel(mob_squad_buy:squad_model, model_47798);
} else if (%mob_client_squad_race_selected = 2 & %mob_client_squad_weight_selected = 0) {
    if_setmodel(mob_squad_buy:squad_model, model_47794);
} else if (%mob_client_squad_race_selected = 3 & %mob_client_squad_weight_selected = 0) {
    if_setmodel(mob_squad_buy:squad_model, model_47792);
} else if (%mob_client_squad_race_selected = 1 & %mob_client_squad_weight_selected = 1) {
    if_setmodel(mob_squad_buy:squad_model, model_47786);
} else if (%mob_client_squad_race_selected = 2 & %mob_client_squad_weight_selected = 1) {
    if_setmodel(mob_squad_buy:squad_model, model_47787);
} else if (%mob_client_squad_race_selected = 3 & %mob_client_squad_weight_selected = 1) {
    if_setmodel(mob_squad_buy:squad_model, model_47796);
}
%mob_client_invest = %varplayerbit_6351;
%mob_client_squad_qty_selected = %varplayerbit_6380;
