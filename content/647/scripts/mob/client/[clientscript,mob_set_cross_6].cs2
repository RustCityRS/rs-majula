// 2553
[clientscript,mob_set_cross_6]
if (%mob_side_unit_cross_6 = 1) {
    if_setgraphic(mob_side_units:unit6_cross, "mob_cross_icon,0");
} else if (%mob_side_unit_cross_6 = 2) {
    if_setgraphic(mob_side_units:unit6_cross, "mob_cross_icon,2");
} else if (%mob_side_unit_cross_6 = 3) {
    if_setgraphic(mob_side_units:unit6_cross, "mob_cross_icon,3");
} else if (%mob_side_unit_cross_6 = 4) {
    if_setgraphic(mob_side_units:unit6_cross, "mob_cross_icon,1");
}
