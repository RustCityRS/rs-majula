// 2529
[proc,mob_set_head_1]
if (%mob_side_unit_head_1 = 1) {
    if_setgraphic(mob_side_units:unit1, "mob_unit_heads,4");
} else if (%mob_side_unit_head_1 = 2) {
    if_setgraphic(mob_side_units:unit1, "mob_unit_heads,1");
} else if (%mob_side_unit_head_1 = 3) {
    if_setgraphic(mob_side_units:unit1, "mob_unit_heads,2");
}
