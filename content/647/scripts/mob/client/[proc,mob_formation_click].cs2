// 2500
[proc,mob_formation_click](component $component0)
def_int $int1 = 1;
while ($int1 <= 9 | enum(int, component, enum_2400, $int1) ! mob_formation:content_layer) {
    if (enum(int, component, enum_2400, $int1) ! $component0) {
        if_setgraphic(enum(int, component, enum_2400, $int1), "radio_buttons,0");
    } else {
        if_setgraphic($component0, "radio_buttons,1");
        %mob_client_formation = $int1;
    }
    $int1 = calc($int1 + 1);
}
if (%mob_client_formation > 0 & %mob_client_formation <= 9) {
    if_setmodel(mob_formation:formations, enum(int, model, enum_2399, %mob_client_formation));
}
