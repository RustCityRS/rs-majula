// 2011's prayer book (prayer, 271) draws its prayers as com8's children by
// slot, in the cache's order (enum 2279: 2011's own prayers among 289's),
// and has the client toggle them as bits of varp 1395 (prayer.varbit).
// Activate is op1; each slot goes to its 289 button.
[if_button1,prayer:prayer_buttons]
switch_int (last_slot) {
    case 0 : @prayer_button_thickskin;
    case 1 : @prayer_button_strengthburst;
    case 2 : @prayer_button_clarity;
    case 5 : @prayer_button_rockskin;
    case 6 : @prayer_button_superhumanstrength;
    case 7 : @prayer_button_improvedreflexes;
    case 8 : @prayer_button_rapidrestore;
    case 9 : @prayer_button_rapidheal;
    case 10 : @prayer_button_protectitems;
    case 13 : @prayer_button_steelskin;
    case 14 : @prayer_button_ultimatestrength;
    case 15 : @prayer_button_incrediblereflexes;
    case 17 : @prayer_button_protectfrommagic;
    case 18 : @prayer_button_protectfrommissiles;
    case 19 : @prayer_button_protectfrommelee;
}

[proc,prayer_checks](dbrow $data)(boolean)
if (stat(prayer) < 1) {
    // osrs
    if (stat_base(prayer) >= db_getfield($data, prayers:level, 0)) {
        // mes("You need to recharge your prayer at an altar."); // p in prayer isnt capitalized until late 2005?
        // void-634 capitalises it (QuickPrayers.kt, as its altar's); no 2011
        // source found for the capital.
        mes("You need to recharge your Prayer at an altar.");
    }
    // sound_synth(prayer_off, 1, 0);
    // 2011's client plays prayer_off itself on a click it refuses (clientscript 2295).
    return(false);
}
if (db_getfield($data, prayers:members, 0) = ^true & map_members = ^false) {
    // in osrs it includes the prayer name in the message
    mes(^mes_members_prayer);
    return(false);
}
if (~duel_arena_prayer_check = false) {
    return(false);
}
return(true);

[proc,prayer_activate](dbrow $data)
~prayer_deactivate_conflicting($data);
sound_synth(db_getfield($data, prayers:sound, 0), 0, 0);
// activate headicon
def_int $headicon = enum(int, int, prayer_headicons, db_getfield($data, prayers:prayer, 0));
if ($headicon > 0) {
    ~headicon_add($headicon);
}
//https://www.youtube.com/watch?v=cVisNIAVvfk&t=169s 
//https://twitter.com/JagexAsh/status/1646903747837059072
if (gettimer(prayer_drain) < 1) {
    // https://youtu.be/UAWSeOYLVHU First ones 10 tick, remaining timer loops are 5 tick
    // https://youtu.be/cQZhL4VP84A?t=179 normal timer instead of softtimer
    settimer(prayer_drain, 5);
}
%prayer_drain_effect = add(max(%prayer_drain_effect, 0), enum(int, int, prayer_drain_effects, db_getfield($data, prayers:prayer, 0)));

~player_combat_stat; // THIS IS VERY IMPORTANT

[proc,prayer_deactivate](int $prayer)
sound_synth(cancel_prayer, 1, 0);
%prayer_drain_effect = sub(%prayer_drain_effect, enum(int, int, prayer_drain_effects, $prayer));
if (~prayers_are_active = false) {
    cleartimer(prayer_drain);
}
def_int $headicon = enum(int, int, prayer_headicons, $prayer);
if ($headicon > 0) {
    ~headicon_del($headicon);
}

~player_combat_stat; // THIS IS VERY IMPORTANT

[proc,prayer_deactivate_conflicting](dbrow $data)
def_int $i = 0;
while ($i <= db_getfieldcount($data, prayers:prayer_deactivate)) {
    def_int $prayer = db_getfield($data, prayers:prayer_deactivate, $i);
    ~prayer_deactivate_specific($prayer);
    $i = add($i, 1);
}

[proc,prayer_deactivate_specific](int $prayer)
def_int $drain = enum(int, int, prayer_drain_effects, $prayer);
switch_int($prayer) {
    case ^prayer_thickskin :
        if (%varplayerbit_5942 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %varplayerbit_5942 = ^false;
    case ^prayer_strengthburst :
        if (%varplayerbit_5943 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %varplayerbit_5943 = ^false;
    case ^prayer_clarity :
        if (%prayer2 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %prayer2 = ^false;
    case ^prayer_rockskin :
        if (%prayer3 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %prayer3 = ^false;
    case ^prayer_superhumanstrength :
        if (%prayer4 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %prayer4 = ^false;
    case ^prayer_improvedreflexes :
        if (%prayer5 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %prayer5 = ^false;
    case ^prayer_rapidrestore :
        if (%prayer6 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %prayer6 = ^false;
    case ^prayer_rapidheal :
        if (%prayer7 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %prayer7 = ^false;
    case ^prayer_protectitems :
        if (%prayer8 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %prayer8 = ^false;
    case ^prayer_steelskin :
        if (%varplayerbit_5951 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %varplayerbit_5951 = ^false;
    case ^prayer_ultimatestrength :
        if (%varplayerbit_5952 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %varplayerbit_5952 = ^false;
    case ^prayer_incrediblereflexes :
        if (%varplayerbit_5953 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %varplayerbit_5953 = ^false;
    case ^prayer_protectfrommagic :
        if (%varplayerbit_5954 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %varplayerbit_5954 = ^false;
    case ^prayer_protectfrommissiles :
        if (%prayer13 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %prayer13 = ^false;
    case ^prayer_protectfrommelee :
        if (%prayer14 = ^true) %prayer_drain_effect = sub(%prayer_drain_effect, $drain);
        %prayer14 = ^false;
}
def_int $headicon = enum(int, int, prayer_headicons, $prayer);
if ($headicon > 0) {
    ~headicon_del($headicon);
}
if (~prayers_are_active = false) {
    cleartimer(prayer_drain);
}

[proc,prayers_are_active]()(boolean)
if (%varplayerbit_5942 = ^true) return (true);
if (%varplayerbit_5943 = ^true) return (true);
if (%prayer2 = ^true) return (true);
if (%prayer3 = ^true) return (true);
if (%prayer4 = ^true) return (true);
if (%prayer5 = ^true) return (true);
if (%prayer6 = ^true) return (true);
if (%prayer7 = ^true) return (true);
if (%prayer8 = ^true) return (true);
if (%varplayerbit_5951 = ^true) return (true);
if (%varplayerbit_5952 = ^true) return (true);
if (%varplayerbit_5953 = ^true) return (true);
if (%varplayerbit_5954 = ^true) return (true);
if (%prayer13 = ^true) return (true);
if (%prayer14 = ^true) return (true);
return (false);

[proc,prayer_deactivate_all]
%varplayerbit_5942 = ^false;
%varplayerbit_5943 = ^false;
%prayer2 = ^false;
%prayer3 = ^false;
%prayer4 = ^false;
%prayer5 = ^false;
%prayer6 = ^false;
%prayer7 = ^false;
%prayer8 = ^false;
%varplayerbit_5951 = ^false;
%varplayerbit_5952 = ^false;
%varplayerbit_5953 = ^false;
%varplayerbit_5954 = ^false;
%prayer13 = ^false;
%prayer14 = ^false;
~headicon_del(^headicon_prayer_protectfrommelee);
~headicon_del(^headicon_prayer_protectfromrange);
~headicon_del(^headicon_prayer_protectfrommagic);
%prayer_drain_effect = 0;
%prayer_drain_counter = 0;
cleartimer(prayer_drain);

[proc,get_prayer_data](int $prayer)(dbrow)
db_find(prayers:prayer, $prayer);
def_dbrow $data = db_findnext;
return ($data);

[timer,prayer_drain]
%prayer_drain_counter = calc(%prayer_drain_effect * 5 + max(%prayer_drain_counter, 0));
// 60 + equipment bonus * 2
if (~prayers_are_active = false) {
    cleartimer(prayer_drain);
    return;
}
// not sure if drain resistance drops below 60.
if (%prayer_drain_counter >= max(%prayer_drain_resistance, 60)) {
    def_int $reduce_points = divide(%prayer_drain_counter, %prayer_drain_resistance);
    %prayer_drain_counter = sub(%prayer_drain_counter, multiply(%prayer_drain_resistance, $reduce_points));
    stat_sub(prayer, $reduce_points, 0);
    if (stat(prayer) = 0) {
        sound_synth(prayer_drain, 1, 0);
        // mes("You have run out of prayer points, you must recharge at an altar.");
        // Jagex changed this message on 17 March 2009 (patch notes: wiki
        // Update:Patch Notes (17 March 2009), which does not quote it);
        // void-634 (before this build) and a September 2011 video (after it) both say:
        mes("You have run out of Prayer points; you can recharge at an altar.");
        ~prayer_deactivate_all;
        return;
    }
}
