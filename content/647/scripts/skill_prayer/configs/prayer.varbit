// 289's prayer0-14 (prayer.varp) as 2011 keeps them: cache varbits
// 5942-5956, bits 0-14 of varp 1395 in 289's order, which 2011's prayer
// book reads for each prayer's struct (clientscript 2296, enum 2279).

[prayer0]
basevar=activated_prayers
startbit=0
endbit=0

