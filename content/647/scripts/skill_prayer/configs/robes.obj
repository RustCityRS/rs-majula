// 289's prayer robes (skill_prayer/configs/robes.obj): their weights and
// prayer bonuses, which 647 lacked. Their slots and examines were in
// player/configs/wearpos.obj (void-634's slots); they live here now, with
// 289's wearpos2 as 289's other bodies have it.
[druid_s_robe]
desc=Keeps a druid's knees nice and warm.
wearpos=legs
weight=2lb
param=prayerbonus,4

[druidrobetop]
desc=I feel closer to the gods when I am wearing this.
wearpos=torso
wearpos2=arms
weight=2lb
param=prayerbonus,4

[monk_s_robe]
desc=Keeps a monk's knees nice and warm.
wearpos=legs
weight=2lb
param=prayerbonus,5
param=saradominitem,^true

[monkrobetop]
desc=I feel closer to the gods when I am wearing this.
wearpos=torso
wearpos2=arms
weight=2lb
param=prayerbonus,6
param=saradominitem,^true

[shade_robe]
desc=I feel closer to the gods when I am wearing this.
wearpos=torso
wearpos2=arms
weight=2lb
param=prayerbonus,5

[blackrobebottom]
desc=If a shade had knees, this would keep them nice and warm.
wearpos=legs
weight=2lb
param=prayerbonus,4
