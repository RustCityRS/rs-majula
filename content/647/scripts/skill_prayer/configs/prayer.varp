// 2011's active prayers, a bit each (void-634 activated_prayers). Unprotected,
// as 289's prayer0-14 were.
[activated_prayers]
transmit=yes
protect=no

[prayer_drain_counter]
protect=no

[prayer_drain_effect]
protect=no

[prayer_drain_resistance]
protect=no
