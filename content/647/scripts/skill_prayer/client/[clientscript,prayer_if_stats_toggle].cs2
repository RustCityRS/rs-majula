// 1701
[clientscript,prayer_if_stats_toggle]
if (%prayer_stats_if_visible = 1) {
    sound_synth(mah4_hide_stats, 1, 0);
    %prayer_stats_if_visible = 0;
} else {
    sound_synth(mah4_show_stats, 1, 0);
    %prayer_stats_if_visible = 1;
}
if_setontimer(prayer:stats_layer, "prayer_if_stats_update(0)");
~script1700;
