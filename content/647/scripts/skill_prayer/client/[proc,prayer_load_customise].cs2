// 1388
[proc,prayer_load_customise](component $component0)
cc_deleteall($component0);
cc_deleteall(prayer:scrollbar_layer);
def_int $int1 = 5;
def_int $int2 = 15;
def_int $int3 = 15;
def_int $int4 = 0;
def_int $int5 = 6;
def_int $int6 = 28;
def_int $int7 = 30;
if (%prayer_mode = 1) {
    $int7 = 20;
}
while ($int4 < $int7) {
    cc_create($component0, ^iftype_graphic, $int4);
    cc_setsize($int2, $int3, ^setsize_abs, ^setsize_abs);
    cc_settiling(true);
    cc_setposition($int5, $int6, ^setpos_abs_left, ^setpos_abs_top);
    if (~prayer_topstat_getvar($int4) = 0) {
        cc_setop(1, "Select<col=ff9040>");
        cc_setgraphic("miscgraphics,10");
    } else {
        cc_setop(1, "Deselect<col=ff9040>");
        cc_setgraphic("miscgraphics,11");
    }
    cc_setonop("prayer_custom_op(event_com, event_comsubid)");
    cc_setonvartransmit("prayer_custom_varupdate(event_com, event_comsubid){varplayer_1397, varplayer_1587}");
    $int4 = calc($int4 + 1);
    if (calc($int4 % $int1) = 0) {
        $int5 = 6;
        $int6 = calc($int6 + 35);
    } else {
        $int5 = calc($int5 + 37);
    }
}
