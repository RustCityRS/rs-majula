// 2002
[proc,battlestaff_number]()(int)
def_int $int0 = 0;
if (%atvar_elite_reward = 1) {
    if (%atvar_staffs_sold > 79) {
        $int0 = 0;
    } else {
        $int0 = calc(80 - %atvar_staffs_sold);
    }
} else if (%atvar_hard_reward = 1) {
    if (%atvar_staffs_sold > 63) {
        $int0 = 0;
    } else {
        $int0 = calc(64 - %atvar_staffs_sold);
    }
} else if (%atvar_med_reward = 1) {
    if (%atvar_staffs_sold > 31) {
        $int0 = 0;
    } else {
        $int0 = calc(32 - %atvar_staffs_sold);
    }
} else if (%atvar_easy_reward = 1) {
    if (%atvar_staffs_sold > 15) {
        $int0 = 0;
    } else {
        $int0 = calc(16 - %atvar_staffs_sold);
    }
} else if (%atvar_easy_reward = 0) {
    if (%atvar_staffs_sold > 7) {
        $int0 = 0;
    } else {
        $int0 = calc(8 - %atvar_staffs_sold);
    }
}
return($int0);
