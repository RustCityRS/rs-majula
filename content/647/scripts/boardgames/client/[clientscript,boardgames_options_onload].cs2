// 1405
[clientscript,boardgames_options_onload]
if (%boardgames_game = 1) {
    if_settext(boardgames_options:options_title, "Draughts: Options");
    ~script1406(boardgames_options:com_3);
} else if (%boardgames_game = 2) {
    if_settext(boardgames_options:options_title, "Runelink: Options");
    ~script1406(boardgames_options:com_4);
} else if (%boardgames_game = 3) {
    if_settext(boardgames_options:options_title, "Runesquares: Options");
    ~script1406(boardgames_options:com_8);
} else if (%boardgames_game = 4) {
    if_settext(boardgames_options:options_title, "Runeversi: Options");
    ~script1406(boardgames_options:com_6);
}
~boardgames_options_ranked;
~boardgames_options_time;
~boardgames_options_pick_piece;
