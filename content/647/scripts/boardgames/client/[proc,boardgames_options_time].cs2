// 1408
[proc,boardgames_options_time]
if_setgraphic("boardgames_options:15seconds1", "miscgraphics,10");
if_setgraphic("boardgames_options:30seconds1", "miscgraphics,10");
if_setgraphic("boardgames_options:1minute1", "miscgraphics,10");
if_setgraphic("boardgames_options:2minutes1", "miscgraphics,10");
if (%boardgames_timepermove = 0) {
    if_setgraphic("boardgames_options:15seconds1", "miscgraphics,11");
} else if (%boardgames_timepermove = 1) {
    if_setgraphic("boardgames_options:30seconds1", "miscgraphics,11");
} else if (%boardgames_timepermove = 2) {
    if_setgraphic("boardgames_options:1minute1", "miscgraphics,11");
} else if (%boardgames_timepermove = 3) {
    if_setgraphic("boardgames_options:2minutes1", "miscgraphics,11");
}
