// 2011's bank tabs, which 289's bank has none of (void-634 Bank.kt,
// BankTabs.kt, BankTabCollapse.kt, BankDeposit.kt). The bank keeps each tab's
// items together at its front, tab 1's first, and the rest after them;
// varbits 4885-4892 count each tab's items, and %open_bank_tab is the tab on
// view (1 for all of it, 2-9 for tabs 1-8). The client draws the tabs from
// these (clientscripts 1459 and 1467), so they must stay true as items come
// and go.
//
// The tab buttons, from the right: com62 is all of the bank, com60 tab 1 ..
// com46 tab 8. View Tab (op1) and View all are the client's own (clientscripts
// 1491-1500 set varbit 4893); the server keeps the same.
[if_button1,bank_v2_main:com62] %open_bank_tab = 1;
[if_button1,bank_v2_main:com60] ~bank_tab_view(1);
[if_button1,bank_v2_main:com58] ~bank_tab_view(2);
[if_button1,bank_v2_main:com56] ~bank_tab_view(3);
[if_button1,bank_v2_main:com54] ~bank_tab_view(4);
[if_button1,bank_v2_main:com52] ~bank_tab_view(5);
[if_button1,bank_v2_main:com50] ~bank_tab_view(6);
[if_button1,bank_v2_main:com48] ~bank_tab_view(7);
[if_button1,bank_v2_main:com46] ~bank_tab_view(8);
// Collapse (op2) puts a tab's items back with the rest.
[if_button2,bank_v2_main:com60] ~bank_tab_collapse(1);
[if_button2,bank_v2_main:com58] ~bank_tab_collapse(2);
[if_button2,bank_v2_main:com56] ~bank_tab_collapse(3);
[if_button2,bank_v2_main:com54] ~bank_tab_collapse(4);
[if_button2,bank_v2_main:com52] ~bank_tab_collapse(5);
[if_button2,bank_v2_main:com50] ~bank_tab_collapse(6);
[if_button2,bank_v2_main:com48] ~bank_tab_collapse(7);
[if_button2,bank_v2_main:com46] ~bank_tab_collapse(8);

[proc,bank_tab_view](int $tab)
// An empty tab has nothing to show (clientscript 1500 checks the same).
if (~bank_tab_size($tab) > 0) {
    %open_bank_tab = calc($tab + 1);
}

// The tab a button stands for: 0 for all of the bank, 1-8, or -1.
[proc,bank_tab_of_com](component $com)(int)
if ($com = bank_v2_main:com62) return(0);
if ($com = bank_v2_main:com60) return(1);
if ($com = bank_v2_main:com58) return(2);
if ($com = bank_v2_main:com56) return(3);
if ($com = bank_v2_main:com54) return(4);
if ($com = bank_v2_main:com52) return(5);
if ($com = bank_v2_main:com50) return(6);
if ($com = bank_v2_main:com48) return(7);
if ($com = bank_v2_main:com46) return(8);
return(-1);

[proc,bank_tab_size](int $tab)(int)
switch_int ($tab) {
    case 1 : return(%bank_tab_1);
    case 2 : return(%bank_tab_2);
    case 3 : return(%bank_tab_3);
    case 4 : return(%bank_tab_4);
    case 5 : return(%bank_tab_5);
    case 6 : return(%bank_tab_6);
    case 7 : return(%bank_tab_7);
    case 8 : return(%bank_tab_8);
}
return(0);

[proc,bank_tab_setsize](int $tab, int $size)
switch_int ($tab) {
    case 1 : %bank_tab_1 = $size;
    case 2 : %bank_tab_2 = $size;
    case 3 : %bank_tab_3 = $size;
    case 4 : %bank_tab_4 = $size;
    case 5 : %bank_tab_5 = $size;
    case 6 : %bank_tab_6 = $size;
    case 7 : %bank_tab_7 = $size;
    case 8 : %bank_tab_8 = $size;
}

// The tab a bank slot is in: 1-8, or 0 for the rest (void-634 Bank.getTab).
[proc,bank_slot_tab](int $slot)(int)
def_int $total = 0;
def_int $tab = 1;
while ($tab <= 8) {
    $total = calc($total + ~bank_tab_size($tab));
    if ($slot < $total) {
        return($tab);
    }
    $tab = calc($tab + 1);
}
return(0);

// The slot a tab's items start at: after every tab before it (void-634
// Bank.tabIndex). Tab 9 is where the rest start.
[proc,bank_tab_start](int $tab)(int)
def_int $start = 0;
def_int $i = 1;
while ($i < $tab & $i <= 8) {
    $start = calc($start + ~bank_tab_size($i));
    $i = calc($i + 1);
}
return($start);

// One item fewer in a tab. A tab left empty goes, the tabs after it move
// down one, and a view past the last tab falls back to the one before it
// (void-634 Bank.decreaseTab).
[proc,bank_tab_decrease](int $tab)
if ($tab < 1) {
    return;
}
def_int $size = calc(~bank_tab_size($tab) - 1);
~bank_tab_setsize($tab, $size);
if ($size > 0) {
    return;
}
def_int $last = -1;
def_int $next = 0;
def_int $i = $tab;
while ($i <= 8) {
    $next = 0;
    if ($i < 8) {
        $next = ~bank_tab_size(calc($i + 1));
    }
    if ($next = 0 & $last = -1) {
        $last = $i;
    }
    ~bank_tab_setsize($i, $next);
    $i = calc($i + 1);
}
if (%open_bank_tab > $last) {
    %open_bank_tab = $last;
}

// Moves the item at $from to $to, the items between shuffling over one, as
// 289's insert does (label insert_bank).
[proc,bank_shift](int $from, int $to)
def_int $src = $from;
while ($src ! $to) {
    if ($src > $to) {
        inv_movetoslot(bank, bank, sub($src, 1), $src);
        $src = sub($src, 1);
    } else {
        inv_movetoslot(bank, bank, add($src, 1), $src);
        $src = add($src, 1);
    }
}

// An item moved between tabs, by insert or onto a tab's button (void-634
// BankTabs.shiftTab): the tab it went to holds one more, the one it left one
// fewer.
[proc,bank_tab_moved](int $from_tab, int $to_tab)
if ($from_tab = $to_tab) {
    return;
}
if ($to_tab > 0) {
    ~bank_tab_setsize($to_tab, calc(~bank_tab_size($to_tab) + 1));
}
~bank_tab_decrease($from_tab);

// An item dragged onto a tab's button goes to the end of that tab, or of the
// rest for all of the bank's. The first empty tab's button is the new tab;
// a button past it counts as it.
[proc,bank_drag_to_tab](int $slot, int $to_tab)
if (inv_getobj(bank, $slot) = null) {
    return;
}
def_int $tab = $to_tab;
while ($tab > 1 & ~bank_tab_size(calc($tab - 1)) = 0) {
    $tab = calc($tab - 1);
}
def_int $to = 0;
if ($tab = 0) {
    $to = ~bank_used_slots;
} else {
    $to = ~bank_tab_start(calc($tab + 1));
}
// The item leaves its own slot first: moved forward, the end is one sooner.
if ($slot < $to) {
    $to = calc($to - 1);
}
def_int $from_tab = ~bank_slot_tab($slot);
~bank_shift($slot, $to);
~bank_tab_moved($from_tab, $tab);

// Collapse: a tab's items go to the end of the bank, after the rest, in their
// order, and the tab goes (void-634 BankTabCollapse). Three reversals turn
// the tab and what follows it about.
[proc,bank_tab_collapse](int $tab)
def_int $count = ~bank_tab_size($tab);
if ($count = 0) {
    return;
}
def_int $start = ~bank_tab_start($tab);
def_int $last = calc(~bank_used_slots - 1);
~bank_reverse($start, calc($start + $count - 1));
~bank_reverse(calc($start + $count), $last);
~bank_reverse($start, $last);
def_int $i = 0;
while ($i < $count) {
    ~bank_tab_decrease($tab);
    $i = calc($i + 1);
}

[proc,bank_reverse](int $from, int $to)
def_int $a = $from;
def_int $b = $to;
while ($a < $b) {
    inv_movetoslot(bank, bank, $a, $b);
    $a = calc($a + 1);
    $b = calc($b - 1);
}

// How many slots the bank fills; the bank keeps no gaps.
[proc,bank_used_slots]()(int)
return(calc(inv_size(bank) - inv_freespace(bank)));

// 2011's bank closes up behind an item taken out whole (wiki Bank,
// 2011-05-21: Withdraw-All but one keeps a place-holder "so that the
// positioning of the item is not disrupted"; void-634 BankWithdraw,
// shiftToFreeIndex); 289's left the gap until the bank was closed or next
// opened (reorganize_bank), and the tabs are counted by slot.
[proc,bank_close_gap](int $slot)
def_int $i = $slot;
while (calc($i + 1) < inv_size(bank)) {
    if (inv_getobj(bank, calc($i + 1)) = null) {
        return;
    }
    inv_movetoslot(bank, bank, calc($i + 1), $i);
    $i = calc($i + 1);
}

// A new item deposited while a tab is on view goes to the end of that tab
// (void-634 BankDeposit).
[proc,bank_deposit_to_tab](obj $obj)
if (%open_bank_tab < 2) {
    return;
}
def_int $tab = calc(%open_bank_tab - 1);
def_int $slot = inv_size(bank);
def_int $i = 0;
while ($i < inv_size(bank)) {
    if (inv_getobj(bank, $i) = $obj) {
        $slot = $i;
        $i = inv_size(bank);
    }
    $i = calc($i + 1);
}
if ($slot >= inv_size(bank)) {
    return;
}
~bank_shift($slot, ~bank_tab_start(calc($tab + 1)));
~bank_tab_setsize($tab, calc(~bank_tab_size($tab) + 1));
