// 2011: the last amount entered for Withdraw-X or Deposit-X, which 2011's
// client offers back as Withdraw-<n> (clientscript 1453 reads varp 1249;
// void-634 last_bank_amount, kept across logins).
[last_bank_amount]
scope=perm
transmit=yes

// 2011's bank tabs: how many items each of tabs 1-8 holds (varbits
// 4885-4892, void-634 bank_tab_1..8, kept across logins) and the tab on view
// (varbit 4893). The bank's items keep their tab order across logins, so the
// counts must too.
[varp_1246]
scope=perm

[varp_1247]
scope=perm

[varp_1248]
scope=perm
