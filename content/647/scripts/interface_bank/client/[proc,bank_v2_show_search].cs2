// 1479
[proc,bank_v2_show_search](string $string0)(int)
$string0 = escape($string0);
~deltooltip_action(bank_v2_main:com_97);
%tooltip_time = 0;
~bank_v2_tab_hide_separator;
if_sethide(bank_v2_main:message_nomatches, true);
if (string_length($string0) = 0) {
    if_settext(bank_v2_main:title, "Bank of RuneScape (no search entered)");
    if_sethide(bank_v2_main:message_nosearch, false);
    ~bank_v2_hide_all;
    return(0);
} else {
    if_settext(bank_v2_main:title, "Bank of RuneScape (search: '<$string0>')");
    if_sethide(bank_v2_main:message_nosearch, true);
}
def_int $int0 = inv_size(bank);
def_int $int1 = 0;
def_int $int2 = 0;
if_setscrollpos(bank_v2_main:bank_v2_inv, 0, 0);
while ($int1 < $int0) {
    if (string_indexof_string(lowercase(oc_name(inv_getobj(bank, $int1))), lowercase($string0), 0) ! -1) {
        if (cc_find(bank_v2_main:bank_v2_inv, $int1) = true) {
            cc_setposition(calc(44 * ($int2 % 10) + 8), calc($int2 / 10 * 44 + 5), ^setpos_abs_left, ^setpos_abs_top);
            cc_sethide(false);
            $int2 = calc($int2 + 1);
        }
    } else if (cc_find(bank_v2_main:bank_v2_inv, $int1) = true) {
        cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
        cc_sethide(true);
    }
    $int1 = calc($int1 + 1);
}
if ($int2 = 0) {
    if_sethide(bank_v2_main:message_nomatches, false);
}
~bank_v2_build_scrollbar($int2);
return($int2);
