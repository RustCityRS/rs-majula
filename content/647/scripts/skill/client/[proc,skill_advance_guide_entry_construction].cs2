            case 4 :
                return(38, hammer, "Maximum rooms: 21", "You can now have a maximum of <col=000080>21 rooms</col> in your house.");
            case 5 :
                return(44, hammer, "Maximum rooms: 22", "You can now have a maximum of <col=000080>22 rooms</col> in your house.");
            case 6 :
                return(45, poh_saw, "Maximum dimensions: 6x6", "Your house can now have maximum dimensions of <col=000080>6 rooms wide by 6 rooms long</col>.");
            case 7 :
                return(50, hammer, "Maximum rooms: 23", "You can now have a maximum of <col=000080>23 rooms</col> in your house.");
            case 8 :
                return(56, hammer, "Maximum rooms: 24", "You can now have a maximum of <col=000080>24 rooms</col> in your house.");
            case 9 :
                return(60, poh_saw, "Maximum dimensions: 7x7", "Your house can now have maximum dimensions of <col=000080>7 rooms wide by 7 rooms long</col>.");
            case 10 :
                return(62, hammer, "Maximum rooms: 25", "You can now have a maximum of <col=000080>25 rooms</col> in your house.");
            case 11 :
                return(68, hammer, "Maximum rooms: 26", "You can now have a maximum of <col=000080>26 rooms</col> in your house.");
            case 12 :
                return(74, hammer, "Maximum rooms: 27", "You can now have a maximum of <col=000080>27 rooms</col> in your house.");
            case 13 :
                return(80, hammer, "Maximum rooms: 28", "You can now have a maximum of <col=000080>28 rooms</col> in your house.");
            case 14 :
                return(86, hammer, "Maximum rooms: 29", "You can now have a maximum of <col=000080>29 rooms</col> in your house.");
            case 15 :
                return(92, hammer, "Maximum rooms: 30", "You can now have a maximum of <col=000080>30 rooms</col> in your house.");
            case 16 :
