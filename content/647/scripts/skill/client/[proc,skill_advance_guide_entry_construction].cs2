            case 18 :
                return(99, skillcape_construction, "Skill mastery", "<col=000080>Congratulations! You are now a master of <col=800000>Construction<col=000080>. Why not visit the <col=800000>Estate Agent<col=000080>? He has something special that is only available to true masters of the <col=800000>Construction<col=000080> skill!");
        }
}
