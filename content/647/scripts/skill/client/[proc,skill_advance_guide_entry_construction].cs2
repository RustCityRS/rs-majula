            case 0 :
                return(-1, rand_mission_contract, "Dungeoneering skill tasks<br>As your Construction level increases, you will be able to attempt higher-level construction tasks within Daemonheim. You will also be more likely to succeed when attempting construction tasks within Daemonheim.", "");
            case 1 :
                return(5, elena_picture, "Start room photo booth", "You can now make <col=000080>a photo booth<col=000080> in the start room of Daemonheim.");
            case 2 :
                return(25, rand_farming_patch, "Start room farming patch<br>5 seeping elm branches and 5 bathus bars", "You can now make <col=000080>farming patches<col=000080> in the start room of Daemonheim.");
            case 3 :
                return(50, rand_range, "Start room range<br>5 utuku branches and 5 kratonite bars", "You can now make <col=000080>ranges<col=000080> in the start room of Daemonheim.");
            case 4 :
                return(75, rand_prayer_altar, "Start room prayer altar<br>5 bovistrangler logs and 5 zephyrium bars", "You can now make <col=000080>prayer altars<col=000080> in the start room of Daemonheim.");
        }
    case 15 :
        switch_int ($int1) {
            case 0 :
                return(1, hammer, "Maximum rooms: 20", "You can now have a maximum of <col=000080>20 rooms</col> in your house.");
            case 1 :
                return(1, poh_saw, "Maximum dimensions: 3x3", "Your house can now have maximum dimensions of <col=000080>3 rooms wide by 3 rooms long</col>.");
            case 2 :
