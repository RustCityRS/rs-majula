// 1015
[proc,skill_advance_guide_subsection_title_mining](int $int0)(string, int)
switch_int ($int0) {
    case 0 :
        return("Ores", 0);
    case 1 :
        return("Equipment", 0);
    case 2 :
        return("Other", 0);
    case 3 :
        return("Shooting Stars", 1);
    case 4 :
        return("Activities", 1);
    case 5 :
        return("Dungeoneering", 0);
    case 6 :
        return("Milestones", 0);
    case default :
        return("", -1);
}
