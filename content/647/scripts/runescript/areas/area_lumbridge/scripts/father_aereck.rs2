// Father Aereck, in Lumbridge church (289's
// area_lumbridge/scripts/father_aereck.rs2), on the reworked Restless Ghost.
// The flow and lines are void-634's (FatherAereck.kt); 289's lines, where
// they are the same, are noted. void-634's gravestone shop and ring blessing
// after the quest are not 289's: they wait for the gravestone port.

[opnpc1,father_aereck]
switch_int (%prieststart) {
    case ^priest_not_started : @father_aereck_default;
    case ^priest_started : @father_aereck_started;
    case ^priest_spoken_urhney : @father_aereck_ghost;
    case ^priest_spoken_ghost : @father_aereck_mining_spot;
    case ^priest_obtained_skull : @father_aereck_found_skull;
    case default : @father_aereck_completed;
}

[label,father_aereck_default]
// 289, void-634
~chatnpc("<p,happy>Welcome to the church of holy Saradomin.");
switch_int (~p_choice3("Who's Saradomin?", 1, "Nice place you've got here.", 2, "I'm looking for a quest.", 3)) {
    case 1 : @father_aereck_whos_saradomin;
    case 2 : @father_aereck_nice_place;
    case 3 :
        ~chatplayer("<p,happy>I'm looking for a quest.");
        // void-634; 289's lines are the same but where noted
        ~chatnpc("<p,happy>That's lucky, I need someone to do a quest for me.");
        // 2011-06-24 recording (YouTube iZmUDYaw2Cc, 45-69s): 2011's quest-start window
        // (quest_intro.rs2, cache struct_522) where void-634 asks in a chat choice, and 2011's
        // lines after it.
        if (~quest_intro(struct_522) = true) {
            %prieststart = ^priest_started;
            ~send_quest_progress(^questlist_priest, %prieststart, ^priest_complete);
            ~chatplayer("<p,happy>Okay, let me help then.");
            ~chatnpc("<p,happy>Thank you. The problem is there's a ghost in the graveyard crypt just south of this church. I would like you to get rid of it.");
            ~chatnpc("<p,happy>You'll need the help of my friend, Father Urhney, who is a bit of a ghost expert.");
            ~chatnpc("<p,happy>He's currently living in a little shack in the south of Lumbridge Swamps, near the coast.");
            ~chatnpc("<p,happy>My name is Father Aereck, by the way. Pleased to meet you.");
            ~chatplayer("<p,happy>Likewise.");
            ~chatnpc("<p,neutral>Take care travelling through the swamps. To get there just follow the path south, through the graveyard.");
            ~chatplayer("<p,happy>I will, thanks.");
            return;
        }
        // After No: void-634's lines. No 2011 recording of it is found.
        ~chatplayer("<p,neutral>Actually, I don't have time right now.");
        ~chatnpc("<p,sad>Oh well. If you do have some spare time on your hands, come back and talk to me.");
}

// 289, void-634
[label,father_aereck_whos_saradomin]
~chatplayer("<p,quiz>Who's Saradomin?");
~chatnpc("<p,shock>Surely you have heard of the god, Saradomin?");
~chatnpc("<p,neutral>He who creates the forces of goodness and purity in this world? I cannot believe your ignorance!");
~chatnpc("<p,neutral>This is the god with more followers than any other! ...At least in this part of the world.");
~chatnpc("<p,neutral>He who created this world along with his brothers Guthix and Zamorak?");
switch_int (~p_choice2("Oh, THAT Saradomin...", 1, "Oh, sorry. I'm not from this world.", 2)) {
    case 1 :
        ~chatplayer("<p,neutral>Oh, THAT Saradomin...");
        ~chatnpc("<p,confused>There... is only one Saradomin...");
        // void-634
        ~chatplayer("<p,neutral>Yeah... I, uh, thought you said something else.");
    case 2 :
        ~chatplayer("<p,neutral>Oh, sorry. I'm not from this world.");
        ~chatnpc("<p,shock>...");
        // 289's from here
        ~chatnpc("<p,neutral>That's... strange.");
        ~chatnpc("<p,neutral>I thought things not from this world were all slime and tenticles.");
        switch_int (~p_choice2("You don't understand. This is a computer game!", 1, "I am - do you like my disguise?", 2)) {
            case 1 :
                ~chatplayer("<p,neutral>You don't understand. This is a computer game!");
                ~chatnpc("<p,confused>I... beg your pardon?");
                ~chatplayer("<p,neutral>Never mind.");
            case 2 :
                ~chatplayer("<p,happy>I am - do you like my disguise?");
                ~chatnpc("<p,shock>Aargh! Begone foul creature from another dimension!");
                ~chatplayer("<p,happy>Ok, ok, I was only joking...");
        }
}

// 289
[label,father_aereck_nice_place]
~chatplayer("<p,happy>Nice place you've got here.");
~chatnpc("<p,happy>It is, isn't it? It was built over 230 years ago.");

// void-634 (started, ghost, miningSpot, foundSkull, completed)
[label,father_aereck_started]
~chatnpc("<p,neutral>Have you got rid of the ghost yet?");
~chatplayer("<p,sad>I can't find Father Urhney at the moment.");
~chatnpc("<p,happy>Well, you can get to the swamp he lives in by going south through the cemetery.");
~chatnpc("<p,happy>You'll have to go right into the far western depths of the swamp, near the coastline. That is where his house is.");

[label,father_aereck_ghost]
~chatnpc("<p,neutral>Have you got rid of the ghost yet?");
~chatplayer("<p,neutral>I had a talk with Father Urhney. He has given me this funny amulet to talk to the ghost with.");
~chatnpc("<p,confused>I always wondered what that amulet was... Well, I hope it's useful. Tell me when you get rid of the ghost!");

[label,father_aereck_mining_spot]
~chatnpc("<p,neutral>Have you got rid of the ghost yet?");
~chatplayer("<p,neutral>I've found out that the ghost's corpse has lost its skull. If I can find the skull, the ghost should leave.");
~chatnpc("<p,neutral>That WOULD explain it.");
~chatnpc("<p,neutral>Hmmmmm. Well, I haven't seen any skulls.");
~chatplayer("<p,confused>Yes, I think a warlock has stolen it.");
~chatnpc("<p,angry>I hate warlocks.");
~chatnpc("<p,happy>Ah well, good luck!");

// void-634 picks these by whether the player carries the amulet; the lines
// are about the skull, so the skull picks them here.
[label,father_aereck_found_skull]
~chatnpc("<p,neutral>Have you got rid of the ghost yet?");
if (inv_total(inv, muddy_skull) > 0) {
    ~chatplayer("<p,happy>I've finally found the ghost's skull!");
    ~chatnpc("<p,happy>Great! Put it in the ghost's coffin and see what happens!");
} else {
    ~chatplayer("<p,sad>Well, I found the ghost's skull but then lost it.");
    ~chatnpc("<p,neutral>Don't worry, I'm sure you'll find it again.");
}

[label,father_aereck_completed]
~chatnpc("<p,happy>Thank you for getting rid of that awful ghost for me! May Saradomin always smile upon you!");
switch_int (~p_choice3("I'm looking for a new quest.", 1, "Who's Saradomin?", 2, "Nice place you've got here.", 3)) {
    case 1 :
        ~chatplayer("<p,happy>I'm looking for a new quest.");
        ~chatnpc("<p,happy>Sorry, I only had the one quest.");
    case 2 : @father_aereck_whos_saradomin;
    case 3 : @father_aereck_nice_place;
}
