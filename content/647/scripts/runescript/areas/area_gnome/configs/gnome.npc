// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[terrorbird2]
desc=These gnomes know how to get around!
wanderrange=12
maxrange=14
respawnrate=60
hitpoints=360
attack=25
strength=25
defence=25
param=stabdefence,16
param=slashdefence,16
param=crushdefence,18
param=magicdefence,15
param=rangedefence,10
param=damagetype,^stab_style
param=attack_anim,terrorbird_mounted_attack
param=defend_anim,terrorbird_mounted_block
param=death_anim,terrorbird_mounted_death
param=attack_sound,terrorbird_attack
param=defend_sound,terrorbird_hit
param=death_sound,terrorbird_death
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_2067

