[opheldu,tooth_half_of_a_key]
if (last_useitem = loop_half_of_a_key) {
    @join_keys;
} else {
    ~displaymessage(^dm_default);
}

[opheldu,loop_half_of_a_key]
if (last_useitem = tooth_half_of_a_key) {
    @join_keys;
} else {
    ~displaymessage(^dm_default);
}

[label,join_keys]
inv_del(inv, tooth_half_of_a_key, 1);
inv_del(inv, loop_half_of_a_key, 1);
inv_add(inv, crystal_key, 1);
mes("You join the two halves of the key together.");
