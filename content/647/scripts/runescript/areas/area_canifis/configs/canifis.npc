// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
// [sic] canafis
[canafis_man1]
desc=One of RuneScape's many citizens.
attack=10
defence=10
strength=10
hitpoints=600
respawnrate=50
wanderrange=5
maxrange=20
category=canafis_citizen
param=stabdefence,-21
param=slashdefence,-21
param=crushdefence,-21
param=magicdefence,-21
param=rangedefence,-21
param=attack_sound,half_werewolf_attack
param=defend_sound,half_werewolf_hit
param=death_sound,half_werewolf_death
param=next_npc_type,canafis_werewolf_man1
param=death_drop,wolf_bones

