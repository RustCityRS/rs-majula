// 289's Gerrant (areas/area_port_sarim/scripts/gerrant.rs2), word for word, on 2011's Gerrant:
// npc 12261 is the one cache 786's Port Sarim spawns (n47_50), with 289's shop. void-634's
// Gerrant says the same. No 2011 recording of him was found.
// Waiting: Hero's Quest at 647 (289's quests/quest_hero); with it, 289's third option ("I want to
// find out how to catch a lava eel.", the Blamish slime) returns.
[opnpc1,gerrant_12261]
if(map_members = ^true & inv_total(inv, trail_clue_hard_riddle004) > 0) {
    ~chatnpc("<p,neutral>You've done it!");
    ~progress_clue_hard(trail_clue_hard_riddle004, "Gerrant has given you another clue scroll!");
    return;
}
~chatnpc("<p,happy>Welcome! You can buy fishing equipment at my store.|We'll also buy anything you catch off you.");
def_int $option = ~p_choice2("Let's see what you've got then.", 1, "Sorry, I'm not interested.", 2);
switch_int($option) {
    case 1 :
        ~chatplayer("<p,neutral>Let's see what you've got then.");
        ~openshop_activenpc;
    case 2 :
        ~chatplayer("<p,neutral>Sorry, I'm not interested.");
}
