// 289's Edgeville dungeon door (areas/area_edgeville/scripts/edgeville_dungeon.rs2), word for
// word: the brass key door (loc 1804, l48_53 43,58) on the house that leads down, opened with
// the brass key (289's edgevilledungeonkey, obj 983 at both revs) into its opened stage
// (289's next_loc_stage, loc 1535). 289's two odd-looking walls are not in cache 786's maps,
// so their Open is not ported. No 2011 source shows the door's lines.

[oploc1,brasskeydoor]
mes("The door is locked.");

[oplocu,brasskeydoor]
switch_obj(last_useitem) {
    case brass_key : @open_edgeville_dungeon_door;
    case default : ~displaymessage(^dm_default);
}


[label,open_edgeville_dungeon_door]
if (inv_total(inv, brass_key) > 0) {
    mes("You unlock the door.");
    sound_synth(locked, 1, 0);
    def_coord $loc_coord = loc_coord;
    def_int $angle = loc_angle;
    def_locshape $shape = loc_shape;
    def_loc $replacement = loc_param(next_loc_stage);
    def_int $x;
    def_int $z;
    $x, $z = ~door_open($angle, loc_shape);

    // walk through door, but if entering, walk next to door and then through
    def_boolean $entering = ~check_axis(coord,  $loc_coord, $angle);
    def_coord $dest = $loc_coord;
    if ($entering = true) {
        if (coord ! $loc_coord) {
            p_delay(0);
            p_teleport($loc_coord);
            sound_synth(door_open, 1, 0);
            p_delay(1);
        } else {
            p_delay(0);
            sound_synth(door_open, 1, 0);
        }
        $dest = movecoord($loc_coord, $x, 0, $z);
    } else {
        p_delay(0);
        sound_synth(door_open, 1, 0);
    }

    p_teleport($dest);

    // Temp note: dur updated
    loc_add($loc_coord, inviswall, $angle, $shape, 3);
    loc_add(movecoord($loc_coord, $x, 0, $z), $replacement, modulo(add($angle, 1), 4), $shape, 3);
} else {
    mes("The door is locked.");
}

