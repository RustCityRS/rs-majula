// Aubury. The Rune Mysteries hand-over is the 2011-05-22 recording's (YouTube VIE8MXrw-7M,
// 229-247s; target/refs/runemys), box for box: his greeting, the menu "Yes, please." /
// "No, thank you." / "I've been sent here with a package for you.", the package for the notes
// at once (289 makes you talk to him again), and a teleport back to the Wizards' Tower.
// Unverified, as no 2011 recording of them is found: the shop and "No, thank you." replies,
// the lost-package and revisit lines (289's) and the menu after the quest (289's options).
[opnpc1,aubury]
if (%runemysteries = ^runemysteries_given_package) {
    // 289's in-between stage, which 2011 never sets; a save left at it gets the notes.
    @aubury_notes;
} else if (%runemysteries = ^runemysteries_received_notes) {
    ~chatnpc("<p,neutral>I suggest you take those research notes of mine back to the head wizard at the Wizards' Tower.");
    if (~obj_gettotal(research_notes) = 0) {
        ~chatplayer("<p,neutral>I can't... I lost them...");
        ~chatnpc("<p,neutral>Well, luckily I have duplicates. It's a good thing they are written in code, I would not want the wrong kind of person to get access to the information contained within.");
        inv_add(inv, research_notes, 1);
    } else {
        ~chatplayer("<p,neutral>Ok then, I will do that.");
        ~chatnpc("<p,neutral>Unless you were talking to me because you wished to buy some runes?");
        @multi2("Yes, please.", aubury_shop, "No, thank you.", aubury_no);
    }
    return;
} else {
    ~chatnpc("<p,happy>Do you want to buy some runes?");
    if (%runemysteries = ^runemysteries_complete) {
        @multi3("Yes, please.", aubury_shop, "No, thank you.", aubury_no, "Can you teleport me to the Rune Essence?", aubury_ess);
    } else if (%runemysteries = ^runemysteries_received_package & inv_total(inv, research_package) > 0) {
        @multi3("Yes, please.", aubury_shop, "No, thank you.", aubury_no, "I've been sent here with a package for you.", aubury_package);
    } else {
        @multi2("Yes, please.", aubury_shop, "No, thank you.", aubury_no);
    }
}

// 2011's Aubury (npc 5913, cache 786) trades on op4 and teleports on op5,
// where 289's traded on op3 and teleported on op4.
[opnpc4,aubury] ~openshop_activenpc;
[opnpc5,aubury]
@teleport_to_essence_mine(^essence_mine_to_aubury);

[opnpcu,aubury]
if(last_useitem = research_package & %runemysteries = ^runemysteries_received_package) @aubury_package;
~displaymessage(^dm_default);

[label,aubury_shop] ~openshop_activenpc;

[label,aubury_no]
~chatplayer("<p,happy>No, thank you.");
~chatnpc("<p,happy>Well, if you find someone who does want runes, please send them my way.");

[label,aubury_ess]
~chatplayer("<p,quiz>Can you teleport me to the Rune Essence?");
@teleport_to_essence_mine(^essence_mine_to_aubury);

[label,aubury_package]
~chatplayer("<p,neutral>I've been sent here with a package for you. It's from Sedridor, the head wizard at the Wizards' Tower.");
~chatnpc("<p,shock>Really? Surely he can't have...? Please, let me have it.");
if(inv_total(inv, research_package) = 0) {
    ~chatplayer("<p,confused>Uh... yeah... about that... I kind of don't have it with me...");
    ~chatnpc("<p,confused>What kind of person tells me they have a delivery for me, but not with them? Honestly.");
    ~chatnpc("<p,neutral>Come back when you do.");
    return;
}
~mesbox("You hand Aubury the research package.");
inv_del(inv, research_package, 1);
%runemysteries = ^runemysteries_given_package;
@aubury_notes;

[label,aubury_notes]
~chatnpc("<p,neutral>My gratitude, adventurer, for bringing me this research package.");
~chatnpc("<p,neutral>Combined with the information I have already collated regarding rune essence, I think we have finally unlocked the power to...");
~chatnpc("<p,neutral>No, I'm getting ahead of myself. Take this summary of my research back to Sedridor in the basement of the Wizards' Tower. He will know whether or not to let you in on our little secret.");
%runemysteries = ^runemysteries_received_notes;
inv_add(inv, research_notes, 1);
~mesbox("Aubury gives you his research notes.");
~chatnpc("<p,neutral>Now, I'm sure I can spare a couple of runes for such a worthy cause as these notes. Do you want me to teleport you back?");
def_int $choice = ~p_choice2_header("Yes, please.", 1, "No, thank you.", 2, "Teleport back to the Wizards' Tower?");
if ($choice = 2) {
    // Unverified: the recording takes the teleport.
    ~chatplayer("<p,neutral>No, thank you.");
    return;
}
~chatplayer("<p,neutral>Yes, please.");
// The essence mine's cast, words and all (the recording, 243-247s), to the bridge north of
// the tower, where the recording lands (refs/runemys/sg/tp_full.png).
~essence_teleport_cast(true);
p_telejump(^aubury_wizard_tower_bridge);
