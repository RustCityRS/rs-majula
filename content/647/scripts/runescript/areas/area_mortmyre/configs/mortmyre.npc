// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[vampire_juve_hound]
param=attack_anim,dog_attack
param=defend_anim,dog_block
param=death_anim,dog_death
param=attack_sound,null
param=defend_sound,null
param=death_sound,null

// unused
[vampire_count]
hitpoints=1000
param=damagetype,^slash_style
param=attack_sound,vampire_attack
param=defend_sound,vampire_hit
param=death_sound,vampire_death
