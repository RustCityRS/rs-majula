[if_button,options:com_14]
if (p_finduid(uid) = true) {
    if_close;
    if_openmain(graphics_options);
} else {
    @please_finish;
}

[if_button,options:com_16]
if (p_finduid(uid) = true) {
    if_close;
    if_openmain(sound_options);
} else {
    @please_finish;
}

[label, please_finish]
mes("Please finish what you're doing first!");

// ── 289's options buttons (interface_options/scripts/game_options.rs2) ─────
// 289's options tab sets each option with a pair of buttons. 2011's (options,
// 261; cache 786) has a toggle each for the mouse buttons (com6, "Toggle
// Number of Mouse Buttons") and chat effects (com4, "Toggle Chat Effects"),
// whose look the client redraws from the varp (clientscripts 1099, 1101), and
// moves split private chat into Chat Setup (pmsetup, 982; com5 "Open Chat
// Setup"). As 289's, each closes what is open first ("volume setting if_closes
// here (interupts the cooking weakqueue)", https://youtu.be/neAoU0yiGFY?t=98).
//
// 289's brightness (com_0-7), music (com_25-29) and sound (com_36-40)
// buttons have no 2011 counterpart: 2011's graphics and audio settings
// (graphics_options 742, sound_options 743, opened above) are the client's
// own. Their only ops are Close, and Mono and Stereo on 743; no clientscript
// reads varps 166, 168 or 169, and the client acts on varp clientcode 5 and
// 6 only (Class323.method2062).
// [if_button,options:all]
// [if_button,options:title]
// [if_button,options:com_2]
// [if_button,options:com_3]
// [if_button,options:optchat]
// [if_button,options:optpm]
// [if_button,options:optmouse]
// [if_button,options:optaid]
// [if_button,options:com_25]
// [if_button,options:com_26]
// [if_button,options:com_27]
// [if_button,options:com_28]
// [if_button,options:com_29]
// [if_button,options:com_36]
// [if_button,options:com_37]
// [if_button,options:com_38]
// [if_button,options:com_39]
// [if_button,options:com_40]

// 289's mouse buttons, com_8 (%option_mouse 0) and com_9 (1): 2011's toggle.
// [if_button,options:houseoptions]
// [if_button,options:com_9]
[if_button,options:optmouse]
if_close;
if (%option_mouse = 0) {
    %option_mouse = 1;
} else {
    %option_mouse = 0;
}

// 289's chat effects, com_10 (%option_chat 0) and com_11 (1): 2011's toggle.
// [if_button,options:optchat_gfx]
// [if_button,options:optmouse_gfx]
[if_button,options:optchat]
if_close;
if (%option_chat = 0) {
    %option_chat = 1;
} else {
    %option_chat = 0;
}

// 289's split private chat, com_47 (%option_pm 1) and com_48 (0), is 2011's
// Chat Setup, which takes the options tab's place as void-634's chat_setup
// does (ChatSetup.kt) and gives it back on Close (com5).
// [if_button,options:com_47]
// [if_button,options:com_48]
[if_button,options:optpm]
if_close;
if (getwindowmode = 1) {
    if_opensub(pmsetup, toplevel:side12);
} else {
    if_opensub(pmsetup, toplevel_fullscreen:side12);
}

[if_button,pmsetup:close]
if (getwindowmode = 1) {
    if_opensub(options, toplevel:side12);
} else {
    if_opensub(options, toplevel_fullscreen:side12);
}

// No split (com41) is 0, as 289's off. Each private colour (com49-66) splits
// private chat in that colour, 1-18: the values clientscript 83 gives those
// buttons and clientscript 3417 writes to varp 287 on the client; 289 had
// one colour, at 1.
[if_button,pmsetup:nosplit] %option_pm = 0;
[if_button,pmsetup:colour1] %option_pm = 1;
[if_button,pmsetup:colour2] %option_pm = 2;
[if_button,pmsetup:colour3] %option_pm = 3;
[if_button,pmsetup:colour4] %option_pm = 4;
[if_button,pmsetup:colour5] %option_pm = 5;
[if_button,pmsetup:colour6] %option_pm = 6;
[if_button,pmsetup:colour7] %option_pm = 7;
[if_button,pmsetup:colour8] %option_pm = 8;
[if_button,pmsetup:colour9] %option_pm = 9;
[if_button,pmsetup:colour10] %option_pm = 10;
[if_button,pmsetup:colour11] %option_pm = 11;
[if_button,pmsetup:colour12] %option_pm = 12;
[if_button,pmsetup:colour13] %option_pm = 13;
[if_button,pmsetup:colour14] %option_pm = 14;
[if_button,pmsetup:colour15] %option_pm = 15;
[if_button,pmsetup:colour16] %option_pm = 16;
[if_button,pmsetup:colour17] %option_pm = 17;
[if_button,pmsetup:colour18] %option_pm = 18;

