// Dialogue system procs — ported from 2004scape, adapted for rev 647 interfaces.
// Interface IDs from void ref: dialogue.ifaces.toml
//
// chat1-4 (64-67): player chat, head=2, title=3, lines=4+, continue=5/6/7/8
// npc_chat1-4 (241-244): npc chat, head=2, title=3, lines=4+, continue=5/6/7/8
// message1-5 (210-214): message box, lines=1+, continue=2/3/4/5/6
// multi2-5 (228,230,232,234): choice, title=1, lines=2+
//   multi2: title=1, line1=2, line2=3, thin_swords=6, wide_swords=9
//   multi3: title=1, line1=2, line2=3, line3=4, thin_swords=7, wide_swords=10
//   multi4: title=1, line1=2, line2=3, line3=4, line4=5, thin_swords=8, wide_swords=9
//   multi5: title=1, line1=2, line2=3, line3=4, line4=5, line5=6, thin_swords=9, wide_swords=10

// Wrapping: 2011's chat lines (chat1-4, npc_chat1-4) are 350 wide in q8_full
// (font 497) and its message lines (message1-5) 441 wide in q8_full, where
// 2004's were 380 and 470 in p12_full; wrapped at 2004's widths in the wrong
// font, long lines ran past the box.

// ── Player Chat ─────────────────────────────────────────────────────────────

[proc,chatplayer](string $string)
split_init($string, 350, 4, q8_full)
def_int $page = 0
def_int $pagetotal = split_pagecount
while ($page < $pagetotal) {
    ~chatplayer_page($page)
    p_pausebutton
    if_close
    $page = calc($page + 1)
}

[proc,chatplayer_page](int $page)
def_int $lines = split_linecount($page)
if ($lines = 0) {
    return
}
// Rev 647: chat1-4 = interfaces 64-67
// Components: head=2, title=3, line1=4, line2=5, etc.
def_int $iface = calc(63 + $lines)
def_int $hash = calc($iface * 65536)
if_setplayerhead(calc($hash + 2))
if_setanim(calc($hash + 2), split_getanim($page))
if_settext(calc($hash + 3), displayname)
if_settext(calc($hash + 4), split_get($page, 0))
if ($lines > 1) {
    if_settext(calc($hash + 5), split_get($page, 1))
}
if ($lines > 2) {
    if_settext(calc($hash + 6), split_get($page, 2))
}
if ($lines > 3) {
    if_settext(calc($hash + 7), split_get($page, 3))
}
if_openchat($iface)

// ── NPC Chat ────────────────────────────────────────────────────────────────

[proc,chatnpc_page](string $npc_name, npc $npc, int $page)
def_int $lines = split_linecount($page)
if ($lines = 0) {
    return
}
// Rev 647: npc_chat1-4 = interfaces 241-244
// Components: head=2, title=3, line1=4, line2=5, etc.
def_int $iface = calc(240 + $lines)
def_int $hash = calc($iface * 65536)
if_setnpchead(calc($hash + 2), $npc)
if_setanim(calc($hash + 2), split_getanim($page))
if_settext(calc($hash + 3), $npc_name)
if_settext(calc($hash + 4), split_get($page, 0))
if ($lines > 1) {
    if_settext(calc($hash + 5), split_get($page, 1))
}
if ($lines > 2) {
    if_settext(calc($hash + 6), split_get($page, 2))
}
if ($lines > 3) {
    if_settext(calc($hash + 7), split_get($page, 3))
}
if_openchat($iface)

// 289's chatnpc_specific: a line spoken as the npc named, who need not be the
// active npc (a door's guard, a quest npc out of sight), so it faces no one.
// 289's chatnpc turns the active npc to the player.
[proc,chatnpc_specific](string $npc_name, npc $npc, string $string)
split_init($string, 350, 4, q8_full)
def_int $page = 0
def_int $pagetotal = split_pagecount
while ($page < $pagetotal) {
    ~chatnpc_page($npc_name, $npc, $page)
    p_pausebutton
    if_close
    $page = calc($page + 1)
}

// ── Message Box ─────────────────────────────────────────────────────────────

[proc,mesbox_page](int $page)
def_int $lines = split_linecount($page)
if ($lines = 0) {
    return
}
// Rev 647: message1-5 = interfaces 210-214
// Components: line1=1, line2=2, etc.
def_int $iface = calc(209 + $lines)
def_int $hash = calc($iface * 65536)
if_settext(calc($hash + 1), split_get($page, 0))
if ($lines > 1) {
    if_settext(calc($hash + 2), split_get($page, 1))
}
if ($lines > 2) {
    if_settext(calc($hash + 3), split_get($page, 2))
}
if ($lines > 3) {
    if_settext(calc($hash + 4), split_get($page, 3))
}
if ($lines > 4) {
    if_settext(calc($hash + 5), split_get($page, 4))
}
if_openchat($iface)

[proc,mesbox](string $string)
split_init($string, 441, 5, q8_full)
def_int $page = 0
def_int $pagetotal = split_pagecount
while ($page < $pagetotal) {
    ~mesbox_page($page)
    p_pausebutton
    if_close
    $page = calc($page + 1)
}

// 289's .mesbox: mesbox shown to the script's second player (.player), as
// mesbox_page is. 2011's boxes and line width, as mesbox.
[proc,.mesbox_page](int $page)
def_int $lines = split_linecount($page);
if ($lines = 0) {
    // sanity check
    return;
} else if ($lines = 1) {
    .if_settext(message1:com1, split_get($page, 0));
    .if_openchat(message1);
} else if ($lines = 2) {
    .if_settext(message2:com1, split_get($page, 0));
    .if_settext(message2:com2, split_get($page, 1));
    .if_openchat(message2);
} else if ($lines = 3) {
    .if_settext(message3:com1, split_get($page, 0));
    .if_settext(message3:com2, split_get($page, 1));
    .if_settext(message3:com3, split_get($page, 2));
    .if_openchat(message3);
} else if ($lines = 4) {
    .if_settext(message4:com1, split_get($page, 0));
    .if_settext(message4:com2, split_get($page, 1));
    .if_settext(message4:com3, split_get($page, 2));
    .if_settext(message4:com4, split_get($page, 3));
    .if_openchat(message4);
} else if ($lines = 5) {
    .if_settext(message5:com1, split_get($page, 0));
    .if_settext(message5:com2, split_get($page, 1));
    .if_settext(message5:com3, split_get($page, 2));
    .if_settext(message5:com4, split_get($page, 3));
    .if_settext(message5:com5, split_get($page, 4));
    .if_openchat(message5);
}

[proc,.mesbox](string $string)
split_init($string, 441, 5, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~.mesbox_page($page);
    .p_pausebutton;
    .if_close;
    $page = calc($page + 1);
}

// ── Obj Message Box ─────────────────────────────────────────────────────────
// Item-icon message box: obj model + message + "Click here to continue".
// 519 children: com0=model, com1=text (380x69 wrap), com2=continue.
//
// Opens uniformly through `if_openchat` like every other dialogue — the engine
// routes it to the correct chatbox slot via `dialogue_slot_enum` (objbox is a
// `dialogue_box_small`, chat_box index 12; the default is index 13). No raw
// hashes, no slot in the script: adding a new dialogue is a one-line enum
// entry, and modal close/walk-away is handled by the normal chat-modal path.
// 289's signature and paging: its text in pages of 4 lines, 380 wide in
// q8_full. 2011's box (objbox, 519) is one text component that wide in that
// font, so a page's lines join with <br>. 289's $x and $y placed the obj in
// 289's box; 2011's places it itself.
[proc,objbox_page](obj $obj, int $scale, int $x, int $y, int $page)
if (split_linecount($page) = 0) {
    // sanity check
    return;
}
if_setobject(objbox:com0, $obj, $scale);
if_settext(objbox:com1, ~split_page_text($page));
if_openchat(objbox);

[proc,objbox](obj $obj, string $string, int $scale, int $x, int $y)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~objbox_page($obj, $scale, $x, $y, $page);
    p_pausebutton;
    $page = calc($page + 1);
}
if_close;

// A page of the last split_init as one string, its lines joined with <br>.
[proc,split_page_text](int $page)(string)
def_int $lines = split_linecount($page);
def_string $text = "";
def_int $i = 0;
while ($i < $lines) {
    if ($i > 0) {
        // "<br>" in a string compiles as a call of a command br (runec reads
        // a bare <identifier> in a string as code), so the break is built
        // from its characters.
        $text = append_char(append(append_char($text, '<'), "br"), '>');
    }
    $text = append($text, split_get($page, $i));
    $i = calc($i + 1);
}
return($text);

// ── Double Obj Message Box ──────────────────────────────────────────────────
// Two obj models beside the message: 131 com0=model (x9 y9), com1=text, com2=
// model (x33 y33), com3=continue. 289's signatures and paging: its text in
// pages of 4 lines, 350 wide in q8_full, on 289's four line components.
// 2011's box (cache 786, 131) has one text component, 380 wide and 69 high in
// q8_full (font 497), so a page is 4 lines that wide, joined with <br>, as
// objbox. 289's x and y placed each obj in 289's box; 2011's places them
// itself.
[proc,doubleobjbox_page](obj $obj_1, int $scale1, int $x1, int $y1, obj $obj_2, int $scale2, int $x2, int $y2, int $page)
def_int $lines = split_linecount($page);
if ($lines = 0 | $lines > 4) {
    // sanity check
    return;
}
if_settext(doubleobjbox:com1, ~split_page_text($page));
if_setobject(doubleobjbox:com0, $obj_1, $scale1);
if_setobject(doubleobjbox:com2, $obj_2, $scale2);
if_openchat(doubleobjbox);

[proc,doubleobjbox](obj $obj_1, obj $obj_2, string $string, int $scale)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~doubleobjbox_page($obj_1, $scale, 0, 0, $obj_2, $scale, 0, 0, $page);
    p_pausebutton;
    $page = calc($page + 1);
}
if_close;

[proc,doubleobjbox2](obj $obj_1, int $scale1, int $x1, int $y1, obj $obj_2, int $scale2, int $x2, int $y2, string $string)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~doubleobjbox_page($obj_1, $scale1, $x1, $y1, $obj_2, $scale2, $x2, $y2, $page);
    p_pausebutton;
    $page = calc($page + 1);
}
if_close;

// ── Choice Dialogs ─────────────────────────────────────────────────────────
// Adapted from 2004scape chat.rs2 for rev 647 interface component IDs.
// Each proc opens the multi-choice interface, sets text, enables buttons,
// suspends with p_pausebutton, then returns the selected option via last_com.

// --- 2 options: interface 228 (multi2) ---
// Components: title=com1, line1=com2, line2=com3, thin_swords=com6, wide_swords=com9
[proc,p_choice2](string $string1, int $ret1, string $string2, int $ret2)(int)
if_settext(multi2:com_1, "Select an Option")
if_settext(multi2:com_2, $string1)
if_settext(multi2:com_3, $string2)
if_sethide(multi2:com_6, false)
if_sethide(multi2:com_9, true)
if_openchat(multi2)
if_addresumebutton(multi2:com_2)
if_addresumebutton(multi2:com_3)
p_pausebutton
switch_component (last_com) {
    case multi2:com_2 : return($ret1);
    case default : return($ret2);
}

// p_choice2 with the caller's header in place of "Select an Option" (289's signature).
[proc,p_choice2_header](string $string1, int $ret1, string $string2, int $ret2, string $headertext)(int)
if_settext(multi2:com_1, $headertext)
if_settext(multi2:com_2, $string1)
if_settext(multi2:com_3, $string2)
if_sethide(multi2:com_6, true)
if_sethide(multi2:com_9, false)
if_openchat(multi2)
if_addresumebutton(multi2:com_2)
if_addresumebutton(multi2:com_3)
p_pausebutton
switch_component (last_com) {
    case multi2:com_2 : return($ret1);
    case default : return($ret2);
}

// --- 3 options: interface 230 (multi3) ---
// Components: title=com1, line1=com2, line2=com3, line3=com4, thin_swords=com7, wide_swords=com10
[proc,p_choice3](string $string1, int $ret1, string $string2, int $ret2, string $string3, int $ret3)(int)
if_settext(multi3:com_1, "Select an Option")
if_settext(multi3:com_2, $string1)
if_settext(multi3:com_3, $string2)
if_settext(multi3:com_4, $string3)
if_sethide(multi3:com_7, false)
if_sethide(multi3:com_10, true)
if_openchat(multi3)
if_addresumebutton(multi3:com_2)
if_addresumebutton(multi3:com_3)
if_addresumebutton(multi3:com_4)
p_pausebutton
switch_component (last_com) {
    case multi3:com_2 : return($ret1);
    case multi3:com_3 : return($ret2);
    case default : return($ret3);
}

// p_choice3 with the caller's header in place of "Select an Option" (289's
// signature; 289 uses it for the dough interface).
[proc,p_choice3_header](string $string1, int $ret1, string $string2, int $ret2, string $string3, int $ret3, string $headertext)(int)
if_settext(multi3:com_1, $headertext)
if_settext(multi3:com_2, $string1)
if_settext(multi3:com_3, $string2)
if_settext(multi3:com_4, $string3)
if_sethide(multi3:com_7, true)
if_sethide(multi3:com_10, false)
if_openchat(multi3)
if_addresumebutton(multi3:com_2)
if_addresumebutton(multi3:com_3)
if_addresumebutton(multi3:com_4)
p_pausebutton
switch_component (last_com) {
    case multi3:com_2 : return($ret1);
    case multi3:com_3 : return($ret2);
    case default : return($ret3);
}

