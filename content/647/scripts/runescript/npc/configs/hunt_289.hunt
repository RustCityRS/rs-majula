// 289's generic hunt modes, which it takes from its cache-derived
// _unpack/225/all.hunt. 2011's cache carries hunt ids with empty bodies, so
// these are the server's alone (appended after 2011's 397).

[cowardly]
type=player
check_vis=lineofsight
check_nottoostrong=outside_wilderness
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
check_notbusy=off
find_keephunting=off
find_newmode=opplayer2

// guessing that notbusy means notbusy=on

[aggressive_melee]
type=player
check_vis=lineofsight
check_nottoostrong=off
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
check_notbusy=off
find_keephunting=off
find_newmode=opplayer2

// 289's, for its Count Draynor (quest_vampire): aggressive_melee without
// the line-of-sight check.
[aggressive_melee_extra]
type=player
check_vis=off
check_nottoostrong=off
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
check_notbusy=off
find_keephunting=off
find_newmode=opplayer2

[aggressive_ranged]
type=player
check_vis=lineofsight
check_nottoostrong=off
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
check_notbusy=off
find_keephunting=off
find_newmode=applayer2

[ranged]
type=player
check_vis=lineofsight
check_nottoostrong=outside_wilderness
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
check_notbusy=off
find_keephunting=off
find_newmode=applayer2

// guessing that constant means keephunting=on
// and the difference between aggressive may include nottoostrong
