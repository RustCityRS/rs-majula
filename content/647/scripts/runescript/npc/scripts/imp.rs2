// Labels, so 2011's God Wars imp shares them: 6211 (cache 786: "Imp", level 7)
// fights as 289's imp (npc_clones_2011.npc: void-634's imp_god_wars). The 2011
// wiki's Imp (21 May 2011) is one article for levels 2 and 7; it says imps
// "have the ability to teleport" and names no imp that cannot.
// Not yet for 289's imp (708): runec keys ai_timer by the subject's untyped
// name, 647's obj.pack names obj 9952 (a dummy obj) imp too, and runec loads
// obj.pack after npc.pack, so [ai_timer,imp] binds to the obj. That wants
// runec to key ai_timer by npc, as it keys ai_queue. 6211's is unaffected.
[ai_timer,imp] @imp_ai_timer;
[ai_queue2,imp] @imp_ai_queue2;
[ai_timer,godwars_ancient_imp] @imp_ai_timer;
[ai_queue2,godwars_ancient_imp] @imp_ai_queue2;

[label,imp_ai_timer]
// in testing, imps seemed to teleport every 200 ticks on average.
// ash confirms a 125t timer on average, so probably a 50% chance
if (random(2) = 0 & add(%npc_lastcombat, 8) < map_clock) { // ash says a few seconds, but i assume its 8 ticks?
    ~npc_imp_teleport;
}
npc_setmode(null);
npc_settimer(~random_range(50, 200)); // https://x.com/JagexAsh/status/1823338342525624357: ash says 70t on spawn, 50-200 ticks randomly after

[label,imp_ai_queue2]
if (random(10) = 0 & sub(npc_stat(hitpoints), last_int) > 0) {
    ~npc_imp_teleport;
}
~npc_default_damage(last_int);

[proc,npc_imp_teleport]
spotanim_map(smokepuff, npc_coord, 124, 0);
if (finduid(%npc_aggressive_player) = true & npc_getmode = opplayer2) {
    sound_synth(smokepuff, 1, 0);
}
npc_tele(map_findsquare(npc_coord, 0, 20, ^map_findsquare_none));
spotanim_map(smokepuff, npc_coord, 124, 0);
npc_setmode(null);
