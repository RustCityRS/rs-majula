[ai_queue3,dwarf_normal] @dwarf_drop_table;
[ai_queue3,dwarf_mountain] @dwarf_drop_table;
[ai_queue3,dwarf_mountain2] @dwarf_drop_table;

// 2011's Black Guards 3276-3279 by the Dwarven Mine (cache 786: "Black Guard",
// level 25) fight as 289's dwarf_mountain (npc_clones_2011.npc: void-634's
// combat_def dwarf_hammer). The 2011 wiki's Black Guard (18 May 2011) lists most
// of this table (bronze pickaxe, med helm and battleaxe, iron battleaxe, bronze
// bolts, 2 chaos and 2 nature runes, coins, hammer, bronze and iron bars, copper
// ore, coal, gems); its bronze and black warhammers are not in 289's, which
// stays as it is.
[ai_queue3,black_guard_3276] @dwarf_drop_table;
[ai_queue3,black_guard_3277] @dwarf_drop_table;
[ai_queue3,black_guard_3278] @dwarf_drop_table;
[ai_queue3,black_guard_3279] @dwarf_drop_table;

[label,dwarf_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $random = random(128);

if ($random < 13) {
    obj_add(npc_coord, bronze_pickaxe, 1, ^lootdrop_duration);
} else if ($random < 17) {
    obj_add(npc_coord, bronze_med_helm, 1, ^lootdrop_duration);
} else if ($random < 19) {
    obj_add(npc_coord, bronze_battleaxe, 1, ^lootdrop_duration);
} else if ($random < 20) {
    obj_add(npc_coord, iron_battleaxe, 1, ^lootdrop_duration);
} else if ($random < 27) {
    if (map_members = ^true) {
        obj_add(npc_coord, bronze_bolts, ~random_range(2, 12), ^lootdrop_duration);
    }
} else if ($random < 31) {
    obj_add(npc_coord, chaos_rune, 2, ^lootdrop_duration);
} else if ($random < 35) {
    obj_add(npc_coord, nature_rune, 2, ^lootdrop_duration);
} else if ($random < 55) {
    obj_add(npc_coord, coins, 4, ^lootdrop_duration);
} else if ($random < 70) {
    obj_add(npc_coord, coins, 10, ^lootdrop_duration);
} else if ($random < 72) {
    obj_add(npc_coord, coins, 30, ^lootdrop_duration);
} else if ($random < 82) {
    obj_add(npc_coord, hammer, 1, ^lootdrop_duration);
} else if ($random < 89) {
    obj_add(npc_coord, bronze_bar, 1, ^lootdrop_duration);
} else if ($random < 93) {
    obj_add(npc_coord, iron_ore, 1, ^lootdrop_duration);
} else if ($random < 96) {
    obj_add(npc_coord, tin_ore, 1, ^lootdrop_duration);
} else if ($random < 99) {
    obj_add(npc_coord, copper_ore, 1, ^lootdrop_duration);
} else if ($random < 102) {
    obj_add(npc_coord, iron_bar, 1, ^lootdrop_duration);
} else if ($random < 104) {
    obj_add(npc_coord, coal, 1, ^lootdrop_duration);
} else if ($random < 105) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
}
