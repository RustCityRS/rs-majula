// 289's general_use/scripts/water_sources.rs2, with 2011's names (289's
// bowl_water, bucket_water, jug_water, bucket_empty, jug_empty, bowl_empty,
// vial_empty, goldbowl_empty, goldbowlbless_empty, pot_flour, water_skin0-3
// are 647's bowl_of_water, bucket_of_water, jug_of_water, bucket, jug, bowl,
// vial, gold_bowl, blessed_gold_bowl, pot_of_flour, waterskin__0-3).
// The water sources are configs/water_sources.loc and the 2011 ones in
// general/configs/examine.loc (category watersource or well).

[opheldu,bowl_of_water]
switch_obj (last_useitem)
{
    case pot_of_flour : @dough_interface(last_item);
    case clay : @make_softclay(bowl_of_water);
    case bucket, jug : @water_fill(last_useslot, last_slot);
    case potato, cooked_meat, cooked_chicken : @make_incomplete_stew(last_useslot);
    case waterskin__3, waterskin__2, waterskin__1, waterskin__0 : @water_fill(last_useslot, last_slot);
    case default : ~displaymessage(^dm_default);
}

[opheldu,bucket_of_water]
switch_obj (last_useitem)
{
    // 289's newbie_pot_flour makes Tutorial Island's dough (@tut_make_dough);
    // 2011 has no Tutorial Island (Unstable Foundations replaced it on 17
    // September 2009, wiki Unstable Foundations).
    // case newbie_pot_flour : @tut_make_dough;
    case pot_of_flour : @dough_interface(last_item);
    case clay : @make_softclay(bucket_of_water);
    case jug, bowl : @water_fill(last_useslot, last_slot);
    case waterskin__3, waterskin__2, waterskin__1, waterskin__0 : @water_fill(last_useslot, last_slot);
    case default : ~displaymessage(^dm_default);
}

[opheldu,jug_of_water]
switch_obj (last_useitem)
{
    case grapes : @make_wine;
    case pot_of_flour : @dough_interface(last_item);
    case clay : @make_softclay(jug_of_water);
    case bucket, bowl : @water_fill(last_useslot, last_slot);
    case waterskin__3, waterskin__2, waterskin__1, waterskin__0 : @water_fill(last_useslot, last_slot);
    case default : ~displaymessage(^dm_default);
}

[opheldu,bucket]
switch_obj (last_useitem)
{
    case jug_of_water, bowl_of_water : @water_fill(last_useslot, last_slot);
    case default : ~displaymessage(^dm_default);
}

[opheldu,jug]
switch_obj (last_useitem)
{
    case bucket_of_water, bowl_of_water : @water_fill(last_useslot, last_slot);
    case default : ~displaymessage(^dm_default);
}

[opheldu,bowl]
switch_obj (last_useitem)
{
    case onion, tomato, ugthanki_meat : @make_bowl_mixture(last_useslot);
    case bucket_of_water, jug_of_water : @water_fill(last_useslot, last_slot);
    case default : ~displaymessage(^dm_default);
}

[label,water_fill](int $use_slot, int $last_slot)
def_obj $used_on = inv_getobj(inv, $last_slot);
def_obj $used_with = inv_getobj(inv, $use_slot);

inv_setslot(inv, $last_slot, oc_param($used_on, next_obj_stage), 1); //new water source
inv_setslot(inv, $use_slot, oc_param($used_with, next_obj_stage), 1); //new empty source

[oplocu,_watersource]
switch_obj (last_useitem) {
    // 289 also fills Legends' Quest's gold bowls (goldbowl_empty,
    // goldbowlbless_empty); 647's gold_bowl and blessed_gold_bowl have no
    // next_obj_stage yet: they wait for the Legends' Quest port.
    // case bucket, jug, vial, bowl, gold_bowl, blessed_gold_bowl : @fill_container_water(last_useitem);
    case bucket, jug, vial, bowl : @fill_container_water(last_useitem);
    case default : ~displaymessage(^dm_default);
}

[oplocu,_well]
switch_obj (last_useitem) {
    case bucket : @fill_bucket_well;
    case default : ~displaymessage(^dm_default);
}

[label,fill_container_water](obj $container)
def_string $source_name = lowercase(loc_name);
def_string $container_name = lowercase(oc_name($container));
inv_del(inv, $container, 1);
inv_add(inv, oc_param($container, next_obj_stage), 1);
anim(human_pickuptable, 0);
// 289 plays `tap_fill` here; 647's synth pack has no such name, and no
// source gives 2011's id, so it is left out.
mes("You fill the <$container_name> from the <$source_name>.");
// strongqueued in osrs but that was likely changed in Sept 2005 
p_delay(0);

[label,fill_bucket_well]
inv_del(inv, bucket, 1);
inv_add(inv, bucket_of_water, 1);
anim(human_pickuptable, 0);
// 289 plays `well_fill` here; 647's synth pack has no such name, and no
// source gives 2011's id, so it is left out.
mes("You fill the bucket from the well.");
// strongqueued in osrs but that was likely changed in Sept 2005 
p_delay(0);
