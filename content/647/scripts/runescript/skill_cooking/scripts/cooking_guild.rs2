[oploc1,chefdoor]
// def_boolean $is_inside = ~check_axis(coord, loc_coord, loc_angle);
// 289's door stood on the guild's side of its wall (0_49_53_7_52, its wall
// on the south edge); 2011's stands on the street's (0_49_53_7_51, its wall
// on the north edge), so a player on the door's own tile is outside.
def_boolean $on_door_tile = ~check_axis(coord, loc_coord, loc_angle);
def_boolean $is_inside = true;
if ($on_door_tile = true) {
    $is_inside = false;
}
if ($is_inside = false) {
    if (stat(cooking) < 32) {
        mes("You need a cooking level of 32 to enter the Chef's Guild.");
        def_string $fail_message = "<p,neutral>Sorry. Only the finest chefs are allowed in here. Get your cooking level up to 32"; 
        if (inv_total(worn, chef_s_hat) < 1) {
            $fail_message = append($fail_message, " and come back wearing a chef's hat");
        }
        $fail_message = append($fail_message, ".");
        ~chatnpc_specific("Head chef", head_chef, $fail_message);
        return;
    }
    if (inv_total(worn, chef_s_hat) < 1) {
        ~chatnpc_specific("Head chef", head_chef, "<p,neutral>You can't come in here unless you're wearing a chef's hat, or something like that.");
        return;
    }
}
// ~open_and_close_door(loc_param(next_loc_stage), $is_inside, false);
// 289's walk through the door goes by the door's tile, as 289's is_inside did.
~open_and_close_door(loc_param(next_loc_stage), $on_door_tile, false);

[opnpc1,head_chef]
~chatnpc("<p,happy>Hello, welcome to the Chefs' Guild.  Only|accomplished chefs and cooks are allowed in|here.  Feel free to use any of our facilities.");
// https://web.archive.org/web/20250127235107im_/http://runers2.fc2web.com/2005y04m02d_232014406.jpg
