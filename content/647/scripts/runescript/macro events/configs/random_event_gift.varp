// The random event whose gift the player holds: its emote and costume point
// choices are that event's ("The random emote or costume unlocked will
// coincide with the random event", 2011 wiki, Random event gift).
[random_event_gift_event]
scope=perm

// Costume points saved for the Mime's costume, which Iffie at Thessalia's Fine
// Clothes exchanges (2011 wiki, Random event gift).
[macro_mime_costume_points]
scope=perm
