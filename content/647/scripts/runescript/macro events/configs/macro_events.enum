// 2011's random events "teleport players away" (2011 wiki, Random events: the
// Random Event Update of 25 February 2009). Of 289's, only the Mysterious Old
// Man's Maze (8) and Mime (7) remain; the swarm, genie, drunken dwarf, strange
// plant, the old man's gift and his strange box are discontinued (2011 wiki,
// Random events: "Discontinued Random Events"; Mysterious Old Man:
// "Discontinued events").
[general_macro_events]
inputtype=int
outputtype=npc
// val=1,swarm
// val=2,genie
// val=3,drunken_dwarf
// val=4,mysterious_old_man
// val=5,macro_triffidseed
// val=6,mysterious_old_man
val=7,mysterious_old_man
val=8,mysterious_old_man

