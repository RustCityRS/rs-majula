if_setcolour(messagescroll:com_12, ^yellow_rgb);
~messagescroll_open;

[label,scroll_elena_hangover_cure_recipe]
// Get a bucket of milk.
// Then grind some chocolate with a pestle and mortar.
// Add the ground chocolate to the milk.
// Finally add some snape grass.
if_settext(messagescroll:com_1, ^string_empty);
if_settext(messagescroll:com_2, ^string_empty);
if_settext(messagescroll:com_3, ^string_empty);
if_settext(messagescroll:com_4, ^string_empty);
if_settext(messagescroll:com_5, "Got a bncket of nnilk");
if_settext(messagescroll:com_6, "Tlen qrind sorne lcoculate");
if_settext(messagescroll:com_7, "vnith a pestal and rnortar");
if_settext(messagescroll:com_8, "ald the grourd dlocolate to tho milt");
if_settext(messagescroll:com_9, "fnales add 5cme snape gras5");
if_settext(messagescroll:com_10, ^string_empty);
if_settext(messagescroll:com_11, ^string_empty);
if_settext(messagescroll:com_12, ^string_empty);
if_setcolour(messagescroll:com_1, ^yellow_rgb);
if_setcolour(messagescroll:com_2, ^yellow_rgb);
if_setcolour(messagescroll:com_3, ^yellow_rgb);
if_setcolour(messagescroll:com_4, ^yellow_rgb);
if_setcolour(messagescroll:com_5, ^black_rgb);
if_setcolour(messagescroll:com_6, ^black_rgb);
if_setcolour(messagescroll:com_7, ^black_rgb);
if_setcolour(messagescroll:com_8, ^black_rgb);
if_setcolour(messagescroll:com_9, ^black_rgb);
if_setcolour(messagescroll:com_10, ^yellow_rgb);
if_setcolour(messagescroll:com_11, ^yellow_rgb);
if_setcolour(messagescroll:com_12, ^yellow_rgb);
~messagescroll_open;

