// 289's scroll (general/scripts/scroll.rs2) on 2011's messagescroll (220;
// cache 786: fifteen text lines com1-15, 375 wide in p12_full, yellow, and a
// Close button com16), which void-634 opens for the same reads (its
// message_scroll, as Alfred Grimhand's barcrawl card). 289's scroll has twelve
// lines, com_2-13: they are 2011's com1-12, and 2011's last three are blanked
// when it opens, as void-634's messageScroll sets every line.

[proc,messagescroll_open]
if_settext(messagescroll:com_13, ^string_empty);
if_settext(messagescroll:com_14, ^string_empty);
if_settext(messagescroll:com_15, ^string_empty);
if_openmain(messagescroll);

[label,scroll_pirate_message]
if_settext(messagescroll:com_1, ^string_empty);
if_settext(messagescroll:com_2, ^string_empty);
