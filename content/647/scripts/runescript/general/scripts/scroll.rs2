if_settext(messagescroll:com_1, ^string_empty);
if_settext(messagescroll:com_2, ^string_empty);
if_settext(messagescroll:com_3, ^string_empty);
if_settext(messagescroll:com_4, "...and rest like your mother who is silent in the");
if_settext(messagescroll:com_5, "peace of her tomb far to the North of Ah Za");
if_settext(messagescroll:com_6, "Rhoon. Near the sea, and under the hills deep in");
if_settext(messagescroll:com_7, "the underground to watch all of nature from the");
if_settext(messagescroll:com_8, "darkness of her final resting place.");
if_settext(messagescroll:com_9, ^string_empty);
