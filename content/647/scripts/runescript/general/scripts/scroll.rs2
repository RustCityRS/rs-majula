[label,scroll_invasion_plans]
// https://web.archive.org/web/20060911005925im_/http://www.runeweb.net/fireball/Grand%20Tree%20Images/GrandTree12.PNG
if_settext(messagescroll:com_1, "@red@Invasion");
if_settext(messagescroll:com_2, ^string_empty);
if_settext(messagescroll:com_3, "Troops board three fleets of battleships at Karamja.");
if_settext(messagescroll:com_4, "@gre@Fleet one");
if_settext(messagescroll:com_5, "Attacks Misthalin from the south.");
if_settext(messagescroll:com_6, "@gre@Fleet two");
if_settext(messagescroll:com_7, "Groups at crandor and attacks Asgarnia from the west.");
if_settext(messagescroll:com_8, "@gre@Fleet three");
if_settext(messagescroll:com_9, "Sails north to attack Kandarin from south, reinforced");
if_settext(messagescroll:com_10, "by gnome foot soldiers leaving gnome stronghold.");
if_settext(messagescroll:com_11, ^string_empty);
if_settext(messagescroll:com_12, "@red@Take no prisoners!");
if_setcolour(messagescroll:com_1, ^yellow_rgb);
if_setcolour(messagescroll:com_2, ^yellow_rgb);
if_setcolour(messagescroll:com_3, ^yellow_rgb);
if_setcolour(messagescroll:com_4, ^yellow_rgb);
if_setcolour(messagescroll:com_5, ^yellow_rgb);
if_setcolour(messagescroll:com_6, ^yellow_rgb);
if_setcolour(messagescroll:com_7, ^yellow_rgb);
if_setcolour(messagescroll:com_8, ^yellow_rgb);
if_setcolour(messagescroll:com_9, ^yellow_rgb);
if_setcolour(messagescroll:com_10, ^yellow_rgb);
if_setcolour(messagescroll:com_11, ^yellow_rgb);
if_setcolour(messagescroll:com_12, ^yellow_rgb);
~messagescroll_open;

[label,upass_well_inscription]
// https://web.archive.org/web/20060908030821im_/http://www.runeweb.net/fireball/Underground%20Pass%20Images/Underground12.PNG
if_settext(messagescroll:com_1, ^string_empty);
if_settext(messagescroll:com_2, "While I sense the beating of a");
if_settext(messagescroll:com_3, "good heart I will not open.");
if_settext(messagescroll:com_4, "Feed me three crests of the blessed");
if_settext(messagescroll:com_5, "and the creature's remains,");
if_settext(messagescroll:com_6, "throw them to me as an offering...");
if_settext(messagescroll:com_7, "a gift of hatred, a token.");
if_settext(messagescroll:com_8, "Then finally rejoice as all goodness");
if_settext(messagescroll:com_9, "dies in my flames.....");
if_settext(messagescroll:com_10, ^string_empty);
if_settext(messagescroll:com_11, ^string_empty);
if_settext(messagescroll:com_12, ^string_empty);
if_setcolour(messagescroll:com_1, ^yellow_rgb);
if_setcolour(messagescroll:com_2, ^yellow_rgb);
if_setcolour(messagescroll:com_3, ^yellow_rgb);
if_setcolour(messagescroll:com_4, ^yellow_rgb);
if_setcolour(messagescroll:com_5, ^yellow_rgb);
if_setcolour(messagescroll:com_6, ^yellow_rgb);
if_setcolour(messagescroll:com_7, ^yellow_rgb);
if_setcolour(messagescroll:com_8, ^yellow_rgb);
if_setcolour(messagescroll:com_9, ^yellow_rgb);
if_setcolour(messagescroll:com_10, ^yellow_rgb);
if_setcolour(messagescroll:com_11, ^yellow_rgb);
if_setcolour(messagescroll:com_12, ^yellow_rgb);
~messagescroll_open;

[label,scroll_zombiequeen_tattered]
if_settext(messagescroll:com_1, ^string_empty);
if_settext(messagescroll:com_2, "Bervirius, son of King Danthalas, was killed in battle. His");
if_settext(messagescroll:com_3, "devout Mother Rashiliyia was so heartbroken that she swore");
if_settext(messagescroll:com_4, "fealty to Zamorak if he would return her son to her. Bervirius");
if_settext(messagescroll:com_5, "returned as an undead creature and terrorized the King and");
if_settext(messagescroll:com_6, "Queen. Many guards died fighting the Undead Bervirius.");
if_settext(messagescroll:com_7, "Eventually the undead Bervirius was set on fire and soon only");
if_settext(messagescroll:com_8, "the bones remained.His remains were taken far to the South,");
if_settext(messagescroll:com_9, "and then towards the setting sun to a tomb that is surrounded");
if_settext(messagescroll:com_10, "by and level with the sea. The only remedy for containing the");
if_settext(messagescroll:com_11, "spirits of witches and undead.");
if_settext(messagescroll:com_12, ^string_empty);
if_setcolour(messagescroll:com_1, ^yellow_rgb);
if_setcolour(messagescroll:com_2, ^yellow_rgb);
if_setcolour(messagescroll:com_3, ^yellow_rgb);
if_setcolour(messagescroll:com_4, ^yellow_rgb);
if_setcolour(messagescroll:com_5, ^yellow_rgb);
if_setcolour(messagescroll:com_6, ^yellow_rgb);
if_setcolour(messagescroll:com_7, ^yellow_rgb);
if_setcolour(messagescroll:com_8, ^yellow_rgb);
if_setcolour(messagescroll:com_9, ^yellow_rgb);
if_setcolour(messagescroll:com_10, ^yellow_rgb);
if_setcolour(messagescroll:com_11, ^yellow_rgb);
if_setcolour(messagescroll:com_12, ^yellow_rgb);
~messagescroll_open;

// if 222 in osrs, can't find any equivalence in this version
// (2011's cache has a 222, messagescroll_handwriting; no source shows 2011
