[label,scroll_zombiequeen_crumpled]
if_settext(messagescroll:com_1, ^string_empty);
if_settext(messagescroll:com_2, ^string_empty);
if_settext(messagescroll:com_3, "Rashiliyia's rage went unchecked. She killed");
if_settext(messagescroll:com_4, "without mercy for revenge of her son's life. Like");
if_settext(messagescroll:com_5, "a spectre through the night she entered houses");
if_settext(messagescroll:com_6, "and one by one quietly strangled life from the");
if_settext(messagescroll:com_7, "occupants. It is said that only a handful survived,");
if_settext(messagescroll:com_8, "protected by necklace wards to keep the Witch");
if_settext(messagescroll:com_9, "Queen at bay.");
if_settext(messagescroll:com_10, ^string_empty);
if_settext(messagescroll:com_11, ^string_empty);
if_settext(messagescroll:com_12, ^string_empty);
if_setcolour(messagescroll:com_1, ^yellow_rgb);
if_setcolour(messagescroll:com_2, ^yellow_rgb);
if_setcolour(messagescroll:com_3, ^black_rgb);
if_setcolour(messagescroll:com_4, ^black_rgb);
if_setcolour(messagescroll:com_5, ^black_rgb);
if_setcolour(messagescroll:com_6, ^black_rgb);
if_setcolour(messagescroll:com_7, ^black_rgb);
if_setcolour(messagescroll:com_8, ^black_rgb);
if_setcolour(messagescroll:com_9, ^black_rgb);
if_setcolour(messagescroll:com_10, ^yellow_rgb);
if_setcolour(messagescroll:com_11, ^yellow_rgb);
if_setcolour(messagescroll:com_12, ^yellow_rgb);
~messagescroll_open;

