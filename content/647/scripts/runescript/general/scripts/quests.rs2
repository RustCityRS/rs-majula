[proc,update_questlist]
// 289 coloured each quest here; 2011's client redraws the list from the
// quests' vars at once (below).
~update_questpoints;

if (%drunkmonkquest >= ^drunkmonk_spoken_to_omad) {
    settimer(blanket_ladder, 1);
}
runclientscript("ql4_refresh()");
