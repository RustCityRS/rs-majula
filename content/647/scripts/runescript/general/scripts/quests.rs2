// 289's general/scripts/quests.rs2 on 2011's quest interfaces. 289 lists each
// quest as a component of its quest tab and colours it; 2011's quest tab
// (questlist_v4, interface 190) is one list the client fills and colours
// itself from each quest's var (clientscript 2193). So a quest is its 2011
// quest id (`^questlist_<quest>`, questlist.constant), and showing progress
// asks the client to redraw the list (clientscript 2169). 2011 completes every
// quest on one scroll (questscroll_ver3, interface 277; the cache's 380,
// questscroll_ver3_big, is a twin of it), the custom scrolls of 289's
// Observatory, Gertrude's Cat and Tai Bwo Wannai Trio being gone.

[proc,send_quest_progress](int $quest, int $progress, int $complete_progress)
~send_quest_progress_colour($quest, $progress, $complete_progress);

[proc,send_quest_progress_colour](int $quest, int $progress, int $complete_progress)
// 2011's client colours the quest from its own var; it redraws the list.
runclientscript("ql4_refresh()");

[proc,send_quest_complete](int $quest, namedobj $obj, int $objscale, int $questpoints, string $questmessage)
// Random quest complete jingle.
def_int $random = random(128);
if ($random < 32) {       // The least common music that plays when completing a quest.
    ~music_jingle("quest complete 3");
} else if ($random < 64) {// A less common music that plays when completing a quest.
    ~music_jingle("quest complete 2");
} else {                 // The most common music that plays when completing a quest.
    ~music_jingle("quest complete 1");
}
~update_questpoints;
// Send Quest Scroll: the quest's own points first among the rewards, the rest
// below it, and the total (277's "Quest Points:", com7), as every 2011 scroll
// found shows (Doric's, Cook's, Imp Catcher's, ...; void-634's Cook.kt too).
if_settext(questscroll_ver3:quest_title_ver3, $questmessage);
if_setobject(questscroll_ver3:quest_model_ver3, $obj, $objscale);
if_settext(questscroll_ver3:quest_points_ver3, tostring(%qp));
if ($questpoints = 1) {
    if_settext(questscroll_ver3:quest_reward1_ver3, "1 Quest Point");
} else {
    if_settext(questscroll_ver3:quest_reward1_ver3, "<tostring($questpoints)> Quest Points");
}
if_settext(questscroll_ver3:quest_reward2_ver3, "");
if_settext(questscroll_ver3:quest_reward3_ver3, "");
if_settext(questscroll_ver3:quest_reward4_ver3, "");
if_settext(questscroll_ver3:quest_reward5_ver3, "");
if_settext(questscroll_ver3:quest_reward6_ver3, "");
if_settext(questscroll_ver3:quest_reward7_ver3, "");
if_settext(questscroll_ver3:quest_reward8_ver3, "");
if_openmain(questscroll_ver3);
// Update Quest Tab color
~send_quest_progress_colour($quest, 1, 1);
mes("Congratulations! Quest complete!");

// 289's send_quest_complete2: the quest complete scroll with the rewards
// given as text, a line each between |s, where 289 shows them on its own
// scroll (questscroll_death, 4 lines 200 wide in q8_full). 2011's one scroll
// (277) lists rewards below the quest's points (com10) on com11-17 in p12_full
// (cache 786, font 495), wrapped narrower than their 213 px (below). For Troll Romance both of 289's procs
// say "You've helped a lonely troll find love": that waits for the Troll
// Romance port.
[proc,send_quest_complete2](int $quest, namedobj $obj, int $objscale, int $questpoints, string $questmessage, string $rewardtext)
~send_quest_complete($quest, $obj, $objscale, $questpoints, $questmessage);
// 2011's scrolls wrap their reward lines narrower than the 213-px components: between 155 and
// 173 px (The Restless Ghost's "125 Prayer XP and five" / "ancient bones", Rune Mysteries'
// "Access to the Runecrafting" / "skill and rune essence mine", Cook's Assistant's unwrapped
// "Access to the cook's range"; target/port-tools/wrap_samples_scroll.txt). 170 is within; the
// exact width is not known.
split_init($rewardtext, 170, 7, p12_full);
if_settext(questscroll_ver3:quest_reward2_ver3, split_get(0, 0));
if_settext(questscroll_ver3:quest_reward3_ver3, split_get(0, 1));
if_settext(questscroll_ver3:quest_reward4_ver3, split_get(0, 2));
if_settext(questscroll_ver3:quest_reward5_ver3, split_get(0, 3));
if_settext(questscroll_ver3:quest_reward6_ver3, split_get(0, 4));
if_settext(questscroll_ver3:quest_reward7_ver3, split_get(0, 5));
if_settext(questscroll_ver3:quest_reward8_ver3, split_get(0, 6));

[proc,update_questpoints]
def_int $questpointrecount = ~count_questpoints;
//Only update if the count has changed
if ($questpointrecount ! %qp) {
    %qp = $questpointrecount;
}

[proc,count_questpoints]()(int)
