// Find and list all NPCs of a given type near the player
[debugproc,npc_find1](npc $npc)
def_int $count = 0;
npc_findall(coord, $npc, 15, 0)
while (npc_findnext = true) {
    mes("Found <npc_name> at <tostring(coordx(npc_coord))>,<tostring(coordz(npc_coord))> level <tostring(coordy(npc_coord))>")
    $count = calc($count + 1);
}
mes("Total: <tostring($count)> <nc_name($npc)> found within 15 tiles")

// Find all NPCs of any type near the player
[debugproc,npc_findall]()
def_int $count = 0;
npc_findallany(coord, 10, 0)
while (npc_findnext = true) {
    mes("<npc_name> (id=<tostring(npc_type)>) at <tostring(coordx(npc_coord))>,<tostring(coordz(npc_coord))>")
    $count = calc($count + 1);
}
mes("Total: <tostring($count)> NPCs within 10 tiles")

// Hunt for the nearest player from an NPC's perspective
[debugproc,huntall_primary]()
def_int $count = 0;
huntall(coord, 10, 0)
while (huntnext = true) {
    mes("Hunt found player: <displayname> at distance <tostring(distance(coord, .coord))>")
    $count = calc($count + 1);
}
mes("Total: <tostring($count)> players found via huntall")

// Spawn an NPC at the player's location
[debugproc,npc_spawn](npc $npc)
npc_add(coord, $npc, 100)
mes("Spawned <nc_name($npc)> at your location (100 tick duration)")

// Info about the targeted NPC (click an NPC first, then run this)
[debugproc,npc]()
npc_findallany(coord, 5, 0)
if (npc_findnext = true) {
    mes("NPC: <npc_name> (type=<tostring(npc_type)>)")
    mes("  coord: <tostring(coordx(npc_coord))>,<tostring(coordz(npc_coord))>,<tostring(coordy(npc_coord))>")
    mes("  hp: <tostring(npc_stat(hitpoints))>/<tostring(npc_basestat(hitpoints))>")
    mes("  range from you: <tostring(npc_range(coord))>")
}

// Delete the nearest NPC (within 5 tiles) to test the respawn path. World-spawn
// (Respawn-lifecycle) NPCs deactivate and reappear at their spawn point after the
// npc's respawn timer (respawn_rate ticks, default 100 ticks ~= 60s). Script-spawned
// (Despawn-lifecycle) NPCs are removed permanently. Stand next to an NPC, run ::killnpc,
// watch it vanish, then return after its respawn timer.
// NOTE: named `killnpc` (not `npc_del`) to avoid colliding with the [command,npc_del] engine command.
[debugproc,killnpc]()
npc_findallany(coord, 5, 0)
if (npc_findnext = true) {
    mes("Deleting <npc_name> (type=<tostring(npc_type)>) at <tostring(coordx(npc_coord))>,<tostring(coordz(npc_coord))> - watch for respawn")
    npc_del
} else {
    mes("No NPC within 5 tiles to delete")
}

// info: Play a spotanim (graphic) on the nearest NPC to verify 647 npc spotanim
// rendering (npc-info mask 0x20). Run ::spotnpc <id> next to an NPC; watch the
// graphic appear and confirm the client does NOT disconnect (a wrong byte count
// would gnp). Height 92 (~chest), delay 0. See npc-info-format.md.
// Takes a raw spotanim id (int) so it doesn't depend on spotanim name
// resolution — any valid id (0..~2683) exercises the npc-info wire format.
[debugproc,spotnpc](int $id)
npc_findallany(coord, 5, 0)
if (npc_findnext = true) {
    mes("Spotanim <tostring($id)> on <npc_name>")
    spotanim_npc($id, 92, 0)
} else {
    mes("No NPC within 5 tiles")
}

// info: Play a seq on the nearest npc of a type, to see which of its
// animations is which. Run ::animnpc <npc> <id> beside it. Takes a raw seq id
// (int), as ::spotnpc takes a spotanim's.
[debugproc,animnpc](npc $npc, int $id)
if (npc_find(coord, $npc, 8, 0) = true) {
    mes("Seq <tostring($id)> on <npc_name>");
    // Held still and facing the player, so the seq plays as it would in a
    // fight, where it can be watched.
    npc_setmode(none);
    npc_facesquare(coord);
    npc_anim($id, 0);
} else {
    mes("No <nc_name($npc)> within 8 tiles");
}

// info: Play a seq on a loc, to see which of a loc's animations is which.
// Run ::animloc <coord> <loc> <seq>, the coord as level_mx_mz_lx_lz.
[debugproc,animloc](coord $coord, loc $loc, int $id)
if (loc_find($coord, $loc) = true) {
    mes("Seq <tostring($id)> on <lc_name($loc)>");
    loc_anim($id);
} else {
    mes("No <lc_name($loc)> at that coord");
}

// info: Put the camera at a tile and height, looking at another, at once
// (speed 100 snaps: the 647 client's CAM_MOVETO/CAM_LOOKAT). For matching a
// cutscene's camera. Run ::camset <coord> <height> <coord> <height>; ::camreset
// gives the camera back.
[debugproc,camset](coord $from, int $height, coord $at, int $at_height)
cam_moveto($from, $height, 100, 100);
cam_lookat($at, $at_height, 100, 100);

[debugproc,camreset]()
cam_reset;

// info: Play a seq on yourself, turned to a tile. Run ::animself <seq> <coord>.
[debugproc,animself](int $id, coord $face)
mes("Seq <tostring($id)> on you");
facesquare($face);
anim($id, 0);

// info: Change a loc for a while, to see another loc's model in its place.
// Run ::locchange <coord> <loc> <new loc> <ticks>.
[debugproc,locchange](coord $coord, loc $loc, loc $to, int $ticks)
if (loc_find($coord, $loc) = true) {
    mes("<lc_name($loc)> becomes <lc_name($to)> for <tostring($ticks)> ticks");
    loc_change($to, $ticks);
} else {
    mes("No <lc_name($loc)> at that coord");
}

// info: The coffin in Draynor Manor's basement opening as the cutscene
// opens it: the player's seq and the lid sliding off (seq 3112) start on
// the same tick, the player turned to the coffin. Run ::coffinpush <seq>.
[debugproc,coffinpush](int $id)
facesquare(0_48_152_9_58);
anim($id, 0);
if (loc_find(0_48_152_8_57, coffin) = true) {
    loc_anim(seq_3112);
}
mes("Seq <tostring($id)> with the lid");
