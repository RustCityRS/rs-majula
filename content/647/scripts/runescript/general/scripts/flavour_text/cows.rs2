// 289's three cows' timers, one trigger here for every npc of category cow:
// 289's cow, cow2 and cow_beef, and 2011's re-issues of them
// (npc/configs/npc_289_base.npc, npc_clones_2011.npc).
// [ai_timer,cow]
// [ai_timer,cow2]
// [ai_timer,cow_beef]
[ai_timer,_cow]
@cow_moo;

[label,cow_moo]
npc_settimer(calc(15 + random(20)));
if (random(4) = 0) {
    npc_say("Moo");
}
