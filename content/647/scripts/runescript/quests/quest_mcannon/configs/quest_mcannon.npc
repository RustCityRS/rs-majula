// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[mcannonguard]
desc=A Dwarf guard.
wanderrange=5
maxrange=12
hitpoints=160
attack=8
strength=6
defence=9
param=attackbonus,5
param=strengthbonus,7
param=stabdefence,3
param=slashdefence,4
param=crushdefence,4
param=magicdefence,2
param=rangedefence,3
param=damagetype,^stab_style
param=attack_anim,dwarf_attack
param=defend_anim,dwarf_block
param=death_anim,dwarf_death
param=attack_sound,gnome_hit
param=defend_sound,brassclash2
param=death_sound,gnome_death
