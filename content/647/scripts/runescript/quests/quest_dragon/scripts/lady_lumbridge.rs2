// The Lady Lumbridge at Port Sarim: 289's quests/quest_dragon/scripts/lady_lumbridge.rs2 with
// 2011's ship. In 2011 the hold is level 0 of the same map square, under the deck (cache 786's
// l47_50; its ladders are rows 161 and 162 of loc_tele_2011, from void-634), not 289's copy of
// the ship at 47_150, and the hole is placed in the map: loc_25036 at 0_47_50_39_7 shows
// shiphole while varbit dragon_hull_repaired (1837, bit 10 of varp 177) is 0 and the patched
// hull_25037 once it is 1.
// 2011's repair, from the 2011-05-04 recording (YouTube mYqjoMQCOHI, 37-48s;
// runescape/target/refs/dragon/hold_strip): one "Use Plank -> Hole", then "Repair Hole" clicks
// each nail a plank, with three lines of their own (42.0s, 44.0s, 45.3s); after the last the
// player is still in the hold and climbs the ladder (46.5s). The 2011 wiki (Dragon Slayer, May
// 2011): "Using each plank consumes 30 nails." Not known for 2011: the player's animation (they
// crouch about 1.5s before each line) and the lines for a missing plank, nails or hammer, which
// stay 289's.

[oploc1,dragonshipgangplank_on]
if (%dragonquest < ^quest_dragon_bought_ship | %dragonquest >= ^dragon_complete) {
    if (npc_find(coord, klarense, 5, 0) = true) {
        ~chatnpc("<p,neutral>Hey, stay off my ship! That's private property!");
    }
    return;
}
mes("You board the ship.");
switch_int (loc_angle) {
    case ^loc_west,^loc_east :
        p_teleport(movecoord(coord, -1, 0, 0));
        p_delay(0); // https://youtu.be/kCMB4I_aJJM?t=106 vid looks like the delay is quicker than osrs
        p_telejump(movecoord(coord, -2, 1, 0));
    case ^loc_north,^loc_south :
        p_teleport(movecoord(coord, 0, 0, 1));
        p_delay(0);
        p_telejump(movecoord(coord, 0, 1, 2));
}

[oploc1,dragonshipgangplank_off]
mes("You disembark the ship.");
switch_int (loc_angle) {
    case ^loc_west,^loc_east :
        p_teleport(movecoord(coord, 1, 0, 0));
        p_delay(0);
        p_telejump(movecoord(coord, 2, -1, 0));
    case ^loc_north,^loc_south :
        p_teleport(movecoord(coord, 0, 0, -1));
        p_delay(0);
        p_telejump(movecoord(coord, 0, -1, -2));
}

// 289: "left click didnt auto add planks"; 2011's Repair nails one (the recording, 39.5-45.3s).
[oploc1,shiphole] @add_plank_to_ship_hole;

[oplocu,shiphole]
switch_obj (last_useitem) {
    case plank : @add_plank_to_ship_hole;
    case default : ~mesbox("That won't help get the ship seaworthy.");
}

[label,add_plank_to_ship_hole]
if (%dragonquest < ^quest_dragon_bought_ship) {
    ~mesbox("You need to buy the ship first.");
    return;
}
if (inv_total(inv, plank) < 1) {
    ~mesbox("You'll need to use wooden planks on this hole to patch it up.");
    return;
}
// 2011: 30 nails a plank (the 2011 wiki); 289 took 4. The line is 289's with 2011's count.
if (inv_total(inv, steel_nails) < 30) {
    ~mesbox("You need 30 steel nails to attach the plank with.");
    return;
}
if (inv_total(inv, hammer) < 1) {
    ~mesbox("You need a hammer to force the nails in with.");
    return;
}
inv_del(inv, plank, 1);
inv_del(inv, steel_nails, 30);
%dragon_ship_planks = min(calc(%dragon_ship_planks + 1), 3);
if (%dragon_ship_planks = 1) {
    ~mesbox("You nail a plank over the hole, but you still need more planks to close the hole completely.");
    return;
}
if (%dragon_ship_planks = 2) {
    ~mesbox("You nail a plank over the hole, but you still need one more plank to close the hole completely.");
    return;
}
if (%dragonquest = ^quest_dragon_bought_ship) {
    %dragonquest = ^quest_dragon_repaired_ship;
}
%dragon_hull_repaired = 1;
// 2011 leaves the player in the hold (289 put them on the deck).
~mesbox("You nail a final plank over the hole. You have successfully patched the hole in the ship.");
