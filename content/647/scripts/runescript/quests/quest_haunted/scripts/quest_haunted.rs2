// 289's Ernest the Chicken (quests/quest_haunted/scripts/quest_haunted.rs2) in
// 2011's Draynor Manor. Its locs are 2011's, matched by where cache 786's maps
// place 289's (quest_haunted.loc, barriers.loc). 2011's changes, from the
// cache and the 2011 wiki (Ernest the Chicken, 2011-05):
// - the secret room opens from a candle sconce, not 289's bookcases;
// - the basement puzzle is per player: the levers and doors are multilocs on
//   %ernestlever and %ernest_doors, and climbing out no longer resets the
//   levers ("Players cannot reset the levers");
// - "All levers start in the down position": a lever's bit is 0 when down,
//   where 289's was 0 when up.

// The front doors (289's haunteddoorl and haunteddoorr) open from outside
// only: 2011 also has players leave another way (2011 wiki, Vampire Slayer:
// "To exit Draynor Manor you will not be able to use the main entrance").
[oploc1,large_door_47421] @open_manor_entrance(^left);
[oploc1,large_door_47424] @open_manor_entrance(^right);

[label,open_manor_entrance](int $side)
if(coordz(coord) > coordz(loc_coord)) {
    mes("The doors won't open.");
    return;
}
~open_and_close_double_door2(~check_axis(coord, loc_coord, loc_angle), $side, door_open);
p_delay(0);
mes("The doors slam shut behind you.");

[oploc1,compost_heap]
~mesbox("I'm not looking through that with my hands!");

[oplocu,compost_heap]
if(last_useitem ! spade) {
    ~displaymessage(^dm_default);
    return;
}
anim(human_dig, 0);
mes("You dig through the compost heap.");
p_delay(2);
if(inv_total(inv, grimy_key) = 0 & %haunted < ^haunted_complete) {
    mes("You find a small key.");
    inv_add(inv, grimy_key, 1);
    return;
}
mes("You find nothing of interest.");

[oploc1,closet_door]
mes("The door is locked.");
sound_synth(locked, 1, 0);

[oplocu,closet_door]
if(last_useitem ! grimy_key) {
    ~displaymessage(^dm_default);
    return;
}
@ernest_open_key_door;

[label,ernest_open_key_door]
mes("You unlock the door.");
mes("You go through the door.");
sound_synth(locked, 1, 0);
~open_and_close_door2(loc_1532, ~check_axis(coord, loc_coord, loc_angle), door_open);

[oploc1,fountain]
anim(human_pickpocket, 0);
// 289's sound_synth(fish_swim) (synth 378) has no known 2011 counterpart:
// synth ids moved between 289 and 2011, and no source names this one.
p_delay(0);
if(inv_total(inv, pressure_gauge) > 0 | %haunted = ^haunted_complete) {
    ~chatplayer("<p,neutral>It's full of dead fish!");
    return;
}
~chatplayer("<p,quiz>There seems to be a pressure gauge in here...");
if(%haunted_manor_fountain_poisoned = 1) {
    ~chatplayer("<p,neutral>... and a lot of dead fish.");
    mes("You get the pressure gauge from the fountain.");
    inv_add(inv, pressure_gauge, 1);
} else {
    mes("Something in the water bites you.");
    say("Ow!");
    // 289's 1 hitpoint is 10 of 2011's life points.
    ~damage_self(10);
    p_delay(0);
    ~chatplayer("<p,confused>... and a lot of piranhas!|I can't get the gauge out.");
}

[opheldu,poison]
if(last_useitem = fish_food) @poison_fish_food;

[opheldu,fish_food]
if(last_useitem = poison) @poison_fish_food;

[label,poison_fish_food]
inv_del(inv, fish_food, 1);
inv_del(inv, poison, 1);
inv_add(inv, poisoned_fish_food, 1);
mes("You poison the fish food.");

[oplocu,fountain]
if(last_useitem ! poisoned_fish_food) {
    ~displaymessage(^dm_default);
    return;
}
anim(human_pickpocket, 0);
inv_del(inv, poisoned_fish_food, 1);
mes("You pour the poisoned fish food into the fountain.");
p_delay(1);
mes("The piranhas start eating the food...");
p_delay(2);
mes("... then die and float to the surface.");
%haunted_manor_fountain_poisoned = 1;

// 2011's secret room: the candle sconce on the west room's wall (47404 at
// 3097,3360; 2011 wiki: "searching the candles hanging on the wall in the
// westernmost room") opens the wall where 289's bookcases stood (wall_47529
// and wall_47531 at 3097,3358-3359). How the wall opens is not documented,
// so the player goes through as 289's bookcase sent them (its end_coord).
[oploc1,candle_sconce]
if(coordx(coord) < coordx(loc_coord)) {
    return;
}
mes("You've found a secret door!");
@manor_secret_door(0_48_52_24_31);

// The lever inside lets the player out (2011 wiki: "you must pull the lever to
// exit the room"); 160 is 289's.
[oploc1,hauntedleverup]
p_delay(0);
facesquare(movecoord(coord, 1, 0, 0));
mes("The lever opens the secret door!");
anim(human_leverdown, 0);
sound_synth(lever, 1, 0);
// Temp note: dur updated
loc_change(hauntedleverdown, 4);
p_teleport(movecoord(coord, 0, 0, 1));
p_delay(1);
@manor_secret_door(movecoord(coord, 2, 0, 0));

// 289's manor_bookcase_door swung its bookcases open; 2011's are walls.
[label,manor_secret_door](coord $dest)
p_delay(0);
sound_synth(coffin_open, 1, 0);
p_teleport($dest);

// The basement's levers. 289's reset on the ladder up is gone: 2011's levers
// cannot be reset. The base locs have no name, so the letter comes from the
// lever's index.
[oploc1,_haunted_lever]
p_delay(0);
def_int $index = loc_param(lever_index);
def_string $dir = "up";
if(testbit(%ernestlever, $index) = ^true) {
    $dir = "down";
}
%ernestlever = togglebit(%ernestlever, $index);
~ernest_doors_update;
anim(human_leverdown, 0); // OSRS uses seq's not in 225, going to assume here
sound_synth(lever, 1, 0);
mes("You pull lever <substring("ABCDEF", calc($index - 1), $index)> <$dir>.");
mes("You hear a clunk.");

[oploc2,_haunted_lever]
def_string $dir = "down";
if(testbit(%ernestlever, loc_param(lever_index)) = ^true) {
    $dir = "up";
}
mes("The lever is <$dir>.");

// 2011 shows Open only on a door the levers unlock (%ernest_doors); the
// conditions are 289's, on 2011's bits (289's lever 0 is 2011's bit 1).
[proc,ernest_door_unlocked](int $door)(boolean)
def_int $l = %ernestlever;
switch_int ($door) {
    case 0 : // 1to2
        if (testbit($l, 1) = ^false & testbit($l, 2) = ^false & testbit($l, 4) = ^true & testbit($l, 5) = ^true & testbit($l, 6) = ^true) return(true);
    case 1 : // 2to3
        if (testbit($l, 2) = ^false & testbit($l, 4) = ^true & testbit($l, 6) = ^true) return(true);
    case 2 : // 4to5
        if (testbit($l, 1) = ^true & testbit($l, 2) = ^true & testbit($l, 4) = ^true) return(true);
    case 3 : // 5to6
        if (testbit($l, 4) = ^true) return(true);
    case 4 : // 8to9
        if (testbit($l, 5) = ^false & testbit($l, 6) = ^true) return(true);
    case 5 : // 2to5
        if (testbit($l, 1) = ^false & testbit($l, 2) = ^false & testbit($l, 3) = ^true & testbit($l, 4) = ^true & testbit($l, 5) = ^false & testbit($l, 6) = ^true) return(true);
    case 6 : // 3to6
        if (testbit($l, 2) = ^false & testbit($l, 4) = ^true & testbit($l, 6) = ^false) return(true);
    case 7 : // 4to7
        if (testbit($l, 1) = ^true & testbit($l, 2) = ^true & testbit($l, 3) = ^false & testbit($l, 4) = ^false & testbit($l, 5) = ^false & testbit($l, 6) = ^false) return(true);
    case 8 : // 5to8
        if (testbit($l, 3) = ^false & testbit($l, 4) = ^true) return(true);
        if (testbit($l, 1) = ^false & testbit($l, 2) = ^false & testbit($l, 3) = ^true & testbit($l, 4) = ^true & testbit($l, 5) = ^false & testbit($l, 6) = ^true) return(true);
}
return(false);

[proc,ernest_doors_update]
def_int $doors = 0;
def_int $door = 0;
while ($door < 9) {
    if (~ernest_door_unlocked($door) = true) {
        $doors = setbit($doors, $door);
    }
    $door = calc($door + 1);
}
%ernest_doors = $doors;

// An unlocked door lets the player through to the room beyond. 2011's doors
// are centrepieces, and how 2011 moves a player across one is not documented:
// the player goes from their side of the door to the other, as 289's opened
// door let them pass.
[oploc1,_haunted_door]
if(~ernest_door_unlocked(loc_param(haunted_door_bit)) = false) {
    mes("This door is locked.");
    sound_synth(locked, 1, 0);
    return;
}
def_coord $beyond = movecoord(loc_coord, calc(coordx(loc_coord) - coordx(coord)), 0, calc(coordz(loc_coord) - coordz(coord)));
sound_synth(door_open, 1, 0);
p_teleport($beyond);

// 2011's chicken in the lab is npc 3290, a multi-npc on %haunted that shows
// 289's chicken (288) until the quest is done and nothing after, so each player
// stops seeing it once done. 289 turned it into Ernest for everyone; so does
// this, until a 2011 source shows the other.
[proc,change_ernest]
if(npc_find(coord, npc_3290, 8, 0) = true) {
    npc_changetype_keepall(ernest, 100);
}

[queue,haunted_quest_complete]
session_log(^log_adventure, "Quest complete: Ernest the Chicken");
~send_quest_complete(^questlist_haunted, feather, 250, ^haunted_questpoints, "You have completed the<br>Ernest The Chicken Quest!");
inv_add(inv, coins, 300);
