// Black Knights' Fortress (289's quest_blackknight.rs2) as May 2011 had it, after its rework
// (2011 wiki, Black Knights' Fortress (quest), 2011-04-27). Lines from the 2011-05-04 recording
// (YouTube TZC9nJHK7bI; runescape/target/refs/bkf/transcript_0504.md). 289's doors, secret walls
// and entrance guard are kept, on 2011's locs and npcs (bkfortressdoor1 is 2011's sturdy_door,
// fortressguard its fortress_guard).
// 2011's changes:
// - the dining-room guard's lines and menu (137.9s, 250.4s);
// - the witch's lines at the grill (215.1-223.6s);
// - the cabbage on the hole: no messages but a cutscene, the minimap blacked out, in the witch's
//   room (272-311s). 2011 plays it in an instance ("Loading - please wait.", 279.5s) with its own
//   camera; that waits on 647 instances, so here it is its lines with the minimap blacked out.
// Unknown, so 289's: the entrance guard's lines, the magic cabbage's messages, the grill before
// and after the listening stage.

// Locations:
// 3016 3513 0 - Black Knight's Fortress
// 2962 3338 2 - Sir Amik Varze
// 3031 3508 1 - Hole
// 3025 3508 0 - Grate

// https://youtu.be/cbJE-AjhON4?t=269
[oploc1,inaclefayeunopenabledoorr]
mes("You can't open this door.");

[oploc1,inaclefayeunopenabledoorl]
mes("You can't open this door.");

[oploc1,sturdy_door]
def_boolean $is_outside = ~check_axis(coord, loc_coord, loc_angle);
if ($is_outside = true & ((inv_getobj(worn, ^wearpos_hat) ! bronze_med_helm) | (inv_getobj(worn, ^wearpos_torso) ! iron_chainbody))) {
    if (npc_find(0_47_54_8_56, fortress_guard, 5, 1) = true) {
        @blackknight_entrance_fortressguard;
    }
} else {
    ~open_and_close_door(loc_param(next_loc_stage), $is_outside, false);
}

[oploc1,bkfortressdoor3]
def_boolean $is_outside = ~check_axis(coord, loc_coord, loc_angle);
if ($is_outside = false) {
    // black knights guarding the ladder down to the grill will aggress the player
    // - https://youtu.be/6RNx7Sbut8A?t=250
    ~black_knights_aggro(coord, coord);
}
~open_and_close_door(loc_param(next_loc_stage), $is_outside, false);

// 289's, unverified: no 2011 recording shows the entrance guard (its players wore the uniform).
[label,blackknight_entrance_fortressguard]
~chatnpc("<p,angry>Hey, you can't come in here!|This is a high security military installation.");
def_int $option = ~p_choice3("Yes, but I work here!", 1, "Oh sorry.", 2, "So who does it belong to?", 3);
if ($option = 1) {
    ~chatplayer("<p,angry>Yes, but I work here!");
    ~chatnpc("<p,angry>Well this the guards entrance. I might be new here but I can tell you're not a guard.|You're not even wearing proper guards uniform!");
    def_int $beg_or_more_info = ~p_choice2("Pleaassee let me in!", 1, "So what is this uniform?", 2);

    if ($beg_or_more_info = 1) {
        ~chatplayer("<p,sad>Pleaassee let me in!");
        ~chatnpc("<p,angry>Go away, you're getting annoying.");
    } else if ($beg_or_more_info = 2) {
        ~chatplayer("<p,neutral>So what is this uniform?");
        ~chatnpc("<p,confused>Well you can see me wearing it.|It's iron chain mail and a medium bronze helmet.");
    }
} else if ($option = 2) {
   ~chatplayer("<p,neutral>Oh sorry.");
   ~chatnpc("<p,angry>Don't let it happen again.");
} else if ($option = 3) {
    ~chatplayer("<p,neutral>So who does it belong to?");
    ~chatnpc("<p,angry>This fortress belongs to the order of Black Knights known as the Kinshra.");
}

[oploc1,bkfortressdoor2]
def_boolean $is_inside = ~check_axis(coord, loc_coord, loc_angle);
if ($is_inside = false) {
    if (npc_find(coord, fortress_guard, 10, 1) = true) {
        @blackknight_banquet_hall_fortressguard;
    }
} else {
    ~open_and_close_door(loc_param(next_loc_stage), $is_inside, false);
}

// 2011's lines and menu (2011-05-04, 137.9s and 250.4s).
[label,blackknight_banquet_hall_fortressguard]
~chatnpc("<p,neutral>I wouldn't go in there if I were you. Those Black Knights are in an important meeting. They said they'd kill anyone who went in there!");
def_int $option = ~p_choice2("Okay, I won't.", 1, "I don't care; I'm going in anyway.", 2);
if ($option = 1) {
    ~chatplayer("<p,neutral>Okay, I won't.");
} else {
   ~chatplayer("<p,neutral>I don't care; I'm going in anyway.");
   ~open_and_close_door(loc_param(next_loc_stage), false, false);
   // search for one black knight to yell
   // - https://youtu.be/vNPISjaWfvQ?t=123
   // - https://youtu.be/6RNx7Sbut8A?t=306
   // - in osrs it gets flinched, but in https://youtu.be/6RNx7Sbut8A?t=306 it insta retals and i doubt its a hunt
   ~black_knights_aggro(0_47_54_17_59, 0_47_54_17_59);
}

// Secret wall push
[oploc1,bksecretdoor]
mes("You push against the wall. You find a secret passage.");
~open_and_close_door2(loc_param(next_loc_stage), ~check_axis_locactive(coord), coffin_open);

// Using Cabbage on hole
[oplocu,hole]
switch_obj (last_useitem)
{
    case cabbage : @black_knights_fortress_correct_cabbage;
    case magic_cabbage : @black_knights_fortress_incorrect_cabbage;
    case default : ~displaymessage(^dm_default);
}

// "Use Cabbage -> Hole" (2011-05-04, 272s): no messages, the minimap blacked out, then the witch's
// room (288.5-311.4s).
[label,black_knights_fortress_correct_cabbage]
if (%spy = 2) {
    inv_del(inv, cabbage, 1);
    // The stage first, so the cutscene cannot be cut short before it is set.
    ~update_blackknight_progress;
    minimap_toggle(2);
    ~chatnpc_specific("Witch", fortwitch, "<p,angry>Where has Greldo got to with that magic cabbage!");
    ~chatnpc_specific("Black Knight captain", black_knight_captain, "<p,quiz>What's that noise?");
    ~chatnpc_specific("Witch", fortwitch, "<p,happy>Hopefully Greldo with the cabbage... yes, look here it co.... NOOOOOoooo!");
    ~chatnpc_specific("Witch", fortwitch, "<p,sad>My potion!");
    ~chatnpc_specific("Black Knight captain", black_knight_captain, "<p,shock>Oh boy, this doesn't look good!");
    ~chatnpc_specific("Black Cat", black_cat, "<p,neutral>Meow!");
    minimap_toggle(0);
    ~chatplayer("<p,happy>Looks like my work here is done. Seems like that's successfully sabotaged their little secret weapon plan.");
} else {
    ~chatplayer("<p,confused>Why would I want to do that?");
}

// 289's, unverified.
[label,black_knights_fortress_incorrect_cabbage]
if (%spy = 2) {
    mes("This is the wrong sort of cabbage!");
    p_delay(2);
    mes("You are meant to be hindering the witch.");
    p_delay(2);
    mes("Not helping her.");
    p_delay(2);
} else {
    ~chatplayer("<p,confused>Why would I want to do that?");
}

// Listening at grate: 2011's lines (2011-05-04, 215.1-223.6s).
[oploc1,grill]
if (%spy = 1) {
    ~chatnpc_specific("Black Knight captain", black_knight_captain, "<p,quiz>So... how's the secret weapon coming along?");
    ~chatnpc_specific("Witch", fortwitch, "<p,happy>The invincibility potion is almost ready...");
    ~chatnpc_specific("Witch", fortwitch, "<p,happy>It's taken me FIVE YEARS, but it's almost ready.");
    ~chatnpc_specific("Witch", fortwitch, "<p,neutral>Greldo, the goblin here, is just going to fetch the last ingredient for me.");
    ~chatnpc_specific("Witch", fortwitch, "<p,neutral>It's a special cabbage grown by my cousin Helda, who lives in Draynor Manor.");
    ~chatnpc_specific("Witch", fortwitch, "<p,neutral>The soil there is slightly magical and it gives the cabbages slight magical properties...");
    ~chatnpc_specific("Witch", fortwitch, "<p,shock>...not to mention the trees!");
    ~chatnpc_specific("Witch", fortwitch, "<p,neutral>Now, remember, Greldo, only a Draynor Manor cabbage will do! Don't get lazy and bring any old cabbage, THAT would ENTIRELY wreck the potion!");
    ~chatnpc_specific("Greldo", greldo, "<p,goblinchat>Yeth, mithtreth.");
    ~update_blackknight_progress;
} else {
    mes("I can't hear much right now.");
}

// 2011 has no quest-progress message here (clientscript 2193 reads %spy itself).
[proc,update_blackknight_progress]
%spy = calc(%spy + 1);

// "Sir Amik hands you 2,500 coins." in a box, then "Congratulations! Quest complete!" and the
// scroll (2011-05-04, 340.9s).
[queue,black_knights_fortress_quest_complete]
%spy = ^blackknight_complete;
inv_add(inv, coins, 2500);
~mesbox("Sir Amik hands you 2,500 coins.");
session_log(^log_adventure, "Quest complete: Black Knight's Fortress");
~send_quest_complete(^questlist_fortress, coins, 260, ^blackknight_questpoints, "You have completed the Black Knights' Fortress Quest!");

[proc,black_knights_aggro](coord $first_search_coord, coord $all_search_coord)
if (npc_find($first_search_coord, aggressive_black_knight, 5, 0) = true) {
    npc_say("Die intruder!!!");
}
// def does this findall thing https://youtu.be/6RNx7Sbut8A?t=423
// isnt the case in osrs!
npc_findall($all_search_coord, aggressive_black_knight, 5, 0);
while (npc_findnext = true) {
    if (npc_getmode ! opplayer2) {
        npc_setmode(opplayer2);
    }
}
