// 289's Hector's chest in the Blue Moon Inn (quests/quest_hunt/scripts/pirate_message.rs2; cache 786
// calls loc 2079 plain "chest", at 3219,3396 upstairs) with 2011's opening, from the 2011-04-26
// recording (YouTube GTgKzVezVDo, 437-440s): "You unlock the chest." in the same tick as the
// message line, and the message taken about four ticks later (289 waits eight).
[oploc1,chest]
mes("The chest is locked.");
sound_synth(locked, 1, 0);

[oplocu,chest]
if (last_useitem ! chest_key) {
    ~displaymessage(^dm_default);
    return;
}

p_delay(1);
// Temp note: dur updated ? Rounded up from 9 to 10 lol
loc_change(piratechestopen, 10);
sound_synth(chest_open, 1, 0);

mes("You unlock the chest.");
mes("All that's in the chest is a message...");
p_delay(3);

mes("You take the message from the chest.");
inv_del(inv, chest_key, 1);
inv_add(inv, pirate_message, 1);

[opheld1,pirate_message]
if (%hunt = ^hunt_received_key) {
    %hunt = ^hunt_read_note;
}
@scroll_pirate_message;
