// Cook's Assistant's journal after the rework, as void-634 has it
// (CooksAssistant): the rework's ingredients, each struck through once given;
// the quest's 2011 name.
[label,questlist_cook]
def_string $text;

if (%cookquest = 0) {
    $text = "@dbl@I can start this quest by speaking to the @dre@Cook @dbl@in the|@dre@kitchen @dbl@of @dre@Lumbridge Castle.";
} else if (%cookquest = 1) {
    $text = "@dbl@It's the @dre@Duke of Lumbridge's @dbl@birthday and I have to help|@dbl@his @dre@Cook @dbl@make him a @dre@birthday cake. @dbl@To do this I need to|@dbl@bring the cook the following ingredients:||";
    if (%cookquest_milk = ^true) {
        $text = append($text, "@str@I have given the cook a bucket of top-quality milk.|");
    } else if (inv_total(inv, top_quality_milk) > 0) {
        $text = append($text, "@dbl@I have found a @dre@bucket of top-quality milk @dbl@to give to the cook.|");
    } else {
        $text = append($text, "@dbl@I need to find a @dre@bucket of top-quality milk.|");
    }
    if (%cookquest_flour = ^true) {
        $text = append($text, "@str@I have given the cook a pot of extra fine flour.|");
    } else if (inv_total(inv, extra_fine_flour) > 0) {
        $text = append($text, "@dbl@I have found a @dre@pot of extra fine flour @dbl@to give to the cook.|");
    } else {
        $text = append($text, "@dbl@I need to find a @dre@pot of extra fine flour.|");
    }
    if (%cookquest_egg = ^true) {
        $text = append($text, "@str@I have given the cook a super large egg.|");
    } else if (inv_total(inv, super_large_egg) > 0) {
        $text = append($text, "@dbl@I have found a @dre@super large egg @dbl@to give to the cook.|");
    } else {
        $text = append($text, "@dbl@I need to find a @dre@super large egg.|");
    }
    if (%cookquest_milk = ^true & %cookquest_flour = ^true & %cookquest_egg = ^true) {
        $text = append($text, "|@str@According to the cook, I can find the ingredients in the|@str@vicinity of Lumbridge. he has noted certain possible|@str@locations of the ingredients on my world map.||@dbl@I just need to talk to the @dre@cook @dbl@now to claim my reward!");
    } else {
        $text = append($text, "|@dbl@According to the @dre@cook, @dbl@I can find the ingredients in the|@dbl@vicinity of @dre@Lumbridge. @dbl@he has noted certain possible|@dbl@locations of the ingredients on my world map.");
    }
} else {
    $text = "@str@It was the Duke of Lumbridge's birthday, but his cook had|@str@forgotten to buy the ingredients he needed to bake a|@str@birthday cake. I brought the cook an egg, a pot of flour|@str@and a bucket of milk and the cook made a delicious-looking|@str@cake with them||@str@As a reward he now lets me use his high quality range|@str@which lets me burn things less whenever I wish to cook there||@red@QUEST COMPLETE!";
}

~quest_journal("Cook's Assistant", $text);

