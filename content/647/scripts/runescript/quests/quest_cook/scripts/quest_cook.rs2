[queue,cooks_quest_complete]
%cookquest = ^cook_complete;
stat_advance(cooking, 3000);
// 2011: 500 coins and 20 noted sardines (the rework of 15 December 2009).
inv_add(inv, coins, 500);
inv_add(inv, cert_sardine, 20);
session_log(^log_adventure, "Quest complete: Cook's Assistant");
// ~send_quest_complete(^questlist_cook, cake, 250, ^cook_questpoints, "You have completed the Cooks' Quest!");
// 2011-05-20 recording (404s): the scroll reads "You have completed Cook's Assistant!".
~send_quest_complete(^questlist_cook, cake, 250, ^cook_questpoints, "You have completed Cook's Assistant!");
if_settext(questscroll_ver3:com_11, "300 Cooking XP");
if_settext(questscroll_ver3:com_12, "500 coins");
if_settext(questscroll_ver3:com_13, "20 sardines");
if_settext(questscroll_ver3:com_14, "Access to the cook's range");

[oplocu,cooking_range]
if (%cookquest < ^cook_complete) {
    if(npc_find(coord, cook, 5, 0) = true) {
        ~chatnpc("<p,angry>Hey! Who said you could use that?");
    }
    return;
} else {
    @attempt_cook_item(last_useitem);
}
