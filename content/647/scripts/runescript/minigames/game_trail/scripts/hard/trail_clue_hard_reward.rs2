[proc,trail_clue_hard_reward]
def_int $rolls = calc(4 + random(3));
def_int $roll = 0;
def_int $rare = 0;

while ($roll < $rolls) {
    // Rare drop chance was 1/21 in 2006. @https://twitter.com/JagexTide/status/1131933683714330624
    // the chances have been scaled down over time to accomodate for more uniques being in the list, there are 25 uniques in May 2004
    // 67 by 2006, (67/31) * 21 ~= 45
    if(random(45) = 0) {
        $rare = calc($rare + 1);
        gosub(trail_clue_hard_rare);
    } else {
        gosub(trail_clue_hard_normal);
    }
    $roll = calc($roll + 1);
}
if ($rare > 0) {
    session_log(^log_adventure, "Completed a Hard Clue Scroll and received <tostring($rare)> Rare Reward(s)!");
} else {
    session_log(^log_adventure, "Completed a Hard Clue Scroll.");
}
~trail_complete;

[proc,trail_clue_hard_normal]
def_int $random = random(21);

switch_int ($random) {
    case 0 : inv_add(trail_rewardinv, coins, calc(1000 + random(4001)));
    case 1 : inv_add(trail_rewardinv, cert_lobster, calc(12 + random(4)));
    case 2 : inv_add(trail_rewardinv, cert_shark, calc(12 + random(4)));
    case 3 : inv_add(trail_rewardinv, nature_rune, calc(30 + random(21)));
    case 4 : inv_add(trail_rewardinv, law_rune, calc(30 + random(21)));
    case 5 : inv_add(trail_rewardinv, blood_rune, calc(20 + random(11)));
    case 6 : inv_add(trail_rewardinv, rune_full_helm, 1);
    case 7 : inv_add(trail_rewardinv, rune_platebody, 1);
    case 8 : inv_add(trail_rewardinv, rune_platelegs, 1);
    case 9 : inv_add(trail_rewardinv, rune_plateskirt, 1);
    case 10 : inv_add(trail_rewardinv, rune_kiteshield, 1);
    case 11 : inv_add(trail_rewardinv, rune_longsword, 1);
    case 12 : inv_add(trail_rewardinv, rune_dagger, 1);
    case 13 : inv_add(trail_rewardinv, rune_battleaxe, 1);
    case 14 : inv_add(trail_rewardinv, rune_hatchet, 1);
    case 15 : inv_add(trail_rewardinv, rune_pickaxe, 1);
    case 16 : inv_add(trail_rewardinv, black_d_hide_body, 1);
    case 17 : inv_add(trail_rewardinv, black_d_hide_chaps, 1);
    case 18 : inv_add(trail_rewardinv, magic_shortbow, 1);
    case 19 : inv_add(trail_rewardinv, magic_longbow, 1);
    case 20 : inv_add(trail_rewardinv, ~trail_reward_godpage);
}

[proc,trail_clue_hard_rare]
def_int $random = random(31);

switch_int ($random) {
    case 0 : inv_add(trail_rewardinv, robin_hood_hat, 1);
    case 1 : inv_add(trail_rewardinv, rune_full_helm__t, 1);
    case 2 : inv_add(trail_rewardinv, rune_platebody__t, 1);
    case 3 : inv_add(trail_rewardinv, rune_platelegs__t, 1);
    case 4 : inv_add(trail_rewardinv, rune_kiteshield__t, 1);
    case 5 : inv_add(trail_rewardinv, rune_full_helm__g, 1);
    case 6 : inv_add(trail_rewardinv, rune_platebody__g, 1);
    case 7 : inv_add(trail_rewardinv, rune_platelegs__g, 1);
    case 8 : inv_add(trail_rewardinv, rune_kiteshield__g, 1);
    case 9 : inv_add(trail_rewardinv, pirate_s_hat, 1);
    case 10 : inv_add(trail_rewardinv, tan_cavalier, 1);
    case 11 : inv_add(trail_rewardinv, dark_cavalier, 1);
    case 12 : inv_add(trail_rewardinv, black_cavalier, 1);
    case 13 : inv_add(trail_rewardinv, zamorak_full_helm, 1);
    case 14 : inv_add(trail_rewardinv, zamorak_platebody, 1);
    case 15 : inv_add(trail_rewardinv, zamorak_platelegs, 1);
    case 16 : inv_add(trail_rewardinv, zamorak_kiteshield, 1);
    case 17 : inv_add(trail_rewardinv, guthix_full_helm, 1);
    case 18 : inv_add(trail_rewardinv, guthix_platebody, 1);
    case 19 : inv_add(trail_rewardinv, guthix_platelegs, 1);
    case 20 : inv_add(trail_rewardinv, guthix_kiteshield, 1);
    case 21 : inv_add(trail_rewardinv, saradomin_full_helm, 1);
    case 22 : inv_add(trail_rewardinv, saradomin_platebody, 1);
    case 23 : inv_add(trail_rewardinv, saradomin_platelegs, 1);
    case 24 : inv_add(trail_rewardinv, saradomin_kiteshield, 1);
    case 25 : ~trail_clue_hard_ultrarare;
    case 26 : inv_add(trail_rewardinv, guthix_plateskirt, 1);
    case 27 : inv_add(trail_rewardinv, saradomin_plateskirt, 1);
    case 28 : inv_add(trail_rewardinv, zamorak_plateskirt, 1);
    case 29 : inv_add(trail_rewardinv, rune_plateskirt__t, 1);
    case 30 : inv_add(trail_rewardinv, rune_plateskirt__g, 1);
}

[proc,trail_clue_hard_ultrarare]()
def_int $rand = random(2);
if($rand = 0) { // junk table
    $rand = random(4);

    switch_int ($rand) {
        case 0 : inv_add(trail_rewardinv, cert_4dose2energy, 15);
        case 1 : inv_add(trail_rewardinv, cert_4dose2restore, 15);
        case 2 : inv_add(trail_rewardinv, cert_4dose1antidragon, 15);
        case 3 : 
            inv_add(trail_rewardinv, cert_4dose2attack, 5);
            inv_add(trail_rewardinv, cert_4dose2strength, 5);
            inv_add(trail_rewardinv, cert_4dose2defense, 5);
    }
} else if($rand = 1) { // gilded table
    $rand = random(5);

    switch_int ($rand) {
        case 0 : inv_add(trail_rewardinv, gilded_platebody, 1);
        case 1 : inv_add(trail_rewardinv, gilded_platelegs, 1);
        case 2 : inv_add(trail_rewardinv, gilded_full_helm, 1);
        case 3 : inv_add(trail_rewardinv, gilded_plateskirt, 1);
        case 4 : inv_add(trail_rewardinv, gilded_kiteshield, 1);
    }
}
