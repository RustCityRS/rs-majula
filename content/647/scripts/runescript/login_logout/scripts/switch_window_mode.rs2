// Entered from the engine, not from a trigger. `WindowStatus` (rev-647
// WINDOW_STATUS, opcode 69) runs `[proc,switch_window_mode]` by name when the
// display mode changes -- rs-engine/src/handlers/window_status.rs. There is no
// switch_window_mode trigger type in `ServerTriggerType`, so the header that
// used to head this file could never fire: the compiler gave it a lookup of
// -1, which is never inserted into `ScriptProvider::lookups`.
[proc,switch_window_mode]()
def_int $old_mode;
if (getwindowmode = 1) {
    $old_mode = 2;
    if_opentop(toplevel)
} else {
    $old_mode = 1;
    if_opentop(toplevel_fullscreen)
}
~movealltabs($old_mode)
~moveorbs($old_mode)

[proc,moveorbs](int $old_mode)
if ($old_mode = 1) {
    if_movesub(toplevel:topstat_hitpoints, toplevel_fullscreen:topstat_hitpoints)
    if_movesub(toplevel:topstat_prayer, toplevel_fullscreen:topstat_prayer)
    if_movesub(toplevel:topstat_run, toplevel_fullscreen:topstat_run)
    if_movesub(toplevel:topstat_lore, toplevel_fullscreen:topstat_lore)
    if_movesub(toplevel:filterbuttons, toplevel_fullscreen:filterbuttons)
    if_movesub(toplevel:chattop, toplevel_fullscreen:chattop)
    if_movesub(toplevel:mainmodal, toplevel_fullscreen:mainmodal)
    if_movesub(toplevel:mainoverlay_clipped, toplevel_fullscreen:mainoverlay)
    if_movesub(toplevel:sidemodal, toplevel_fullscreen:sidemodal)
    if_movesub(toplevel:mainoverlay, toplevel_fullscreen:mainmodal_fullscreen)
} else {
    if_movesub(toplevel_fullscreen:topstat_hitpoints, toplevel:topstat_hitpoints)
    if_movesub(toplevel_fullscreen:topstat_prayer, toplevel:topstat_prayer)
    if_movesub(toplevel_fullscreen:topstat_run, toplevel:topstat_run)
    if_movesub(toplevel_fullscreen:topstat_lore, toplevel:topstat_lore)
    if_movesub(toplevel_fullscreen:filterbuttons, toplevel:filterbuttons)
    if_movesub(toplevel_fullscreen:chattop, toplevel:chattop)
    if_movesub(toplevel_fullscreen:mainmodal, toplevel:mainmodal)
    if_movesub(toplevel_fullscreen:mainoverlay, toplevel:mainoverlay_clipped)
    if_movesub(toplevel_fullscreen:sidemodal, toplevel:sidemodal)
    if_movesub(toplevel_fullscreen:mainmodal_fullscreen, toplevel:mainoverlay)
}

[proc,movealltabs](int $old_mode)
if ($old_mode = 1) {
    if_movesub(toplevel:side0, toplevel_fullscreen:side0)
    if_movesub(toplevel:side1, toplevel_fullscreen:side1)
    if_movesub(toplevel:side2, toplevel_fullscreen:side2)
    if_movesub(toplevel:side3, toplevel_fullscreen:side3)
    if_movesub(toplevel:side4, toplevel_fullscreen:side4)
    if_movesub(toplevel:side5, toplevel_fullscreen:side5)
    if_movesub(toplevel:side6, toplevel_fullscreen:side6)
    if_movesub(toplevel:side7, toplevel_fullscreen:side7)
    if_movesub(toplevel:side9, toplevel_fullscreen:side9)
    if_movesub(toplevel:side10, toplevel_fullscreen:side10)
    if_movesub(toplevel:side11, toplevel_fullscreen:side11)
    if_movesub(toplevel:side12, toplevel_fullscreen:side12)
    if_movesub(toplevel:side13, toplevel_fullscreen:side13)
    if_movesub(toplevel:side14, toplevel_fullscreen:side14)
    if_movesub(toplevel:side15, toplevel_fullscreen:side15)
} else {
    if_movesub(toplevel_fullscreen:side0, toplevel:side0)
    if_movesub(toplevel_fullscreen:side1, toplevel:side1)
    if_movesub(toplevel_fullscreen:side2, toplevel:side2)
    if_movesub(toplevel_fullscreen:side3, toplevel:side3)
    if_movesub(toplevel_fullscreen:side4, toplevel:side4)
    if_movesub(toplevel_fullscreen:side5, toplevel:side5)
    if_movesub(toplevel_fullscreen:side6, toplevel:side6)
    if_movesub(toplevel_fullscreen:side7, toplevel:side7)
    if_movesub(toplevel_fullscreen:side9, toplevel:side9)
    if_movesub(toplevel_fullscreen:side10, toplevel:side10)
    if_movesub(toplevel_fullscreen:side11, toplevel:side11)
    if_movesub(toplevel_fullscreen:side12, toplevel:side12)
    if_movesub(toplevel_fullscreen:side13, toplevel:side13)
    if_movesub(toplevel_fullscreen:side14, toplevel:side14)
    if_movesub(toplevel_fullscreen:side15, toplevel:side15)
}
