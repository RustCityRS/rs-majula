[proc,cc_open_interface]()
%character_part = 1;

def_int $hair_count = enum_getoutputcount(enum_3304);
def_int $hair_index = random($hair_count);
def_int $hair = -1;
def_int $hair_struct = enum(105, 74, enum_3304, $hair_index);
if ($hair_struct ! -1) {
    $hair = struct_param($hair_struct, param_788);
    if ($hair ! -1) { setidkit($hair, 0); }
}
%character_creation_hair_style = $hair_index;

def_int $colour_count = enum_getoutputcount(enum_2345);
def_int $colour_index = random($colour_count);
def_int $hair_colour = enum(105, 105, enum_2345, $colour_index);
if ($hair_colour ! -1) {
    setidkcolour(0, $hair_colour);
    sendvarc(1015, $hair_colour);
}

if ($hair ! -1) { sendvarc(1008, $hair); }
sendvarc(1009, 14);

if_opentop(playerdesign4);
allowdesign(^true);
~cc_enable_events();
~cc_transmit_invs();

[proc,cc_send_makeover_varcs]()
sendvarc(1008, 0)
sendvarc(1009, 14)
sendvarc(1010, 18)
sendvarc(1011, 26)
sendvarc(1012, 34)
sendvarc(1013, 38)
sendvarc(1014, 42)
sendvarc(1015, 0)
sendvarc(1016, 0)
sendvarc(1017, 0)
sendvarc(1018, 0)

[proc,cc_transmit_invs]()
inv_transmit(inv_463, playerdesign4:com45)
inv_transmit(inv_486, playerdesign4:com45)
inv_transmit(inv_499, playerdesign4:com45)
inv_transmit(inv_585, playerdesign4:com45)
inv_transmit(inv_586, playerdesign4:com45)
