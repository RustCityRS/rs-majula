// Food heal data. Heal values are 2011 life points, sourced from our local wiki.
// Adapted from Jordan's rev-225 consume_normal.dbrow; the heal routes to the
// granular %life_points pool via ~heal_lifepoints (647 life-points model), not
// the static Hitpoints skill level. Rows grouped by heal amount.
// SCOPE: single-bite staples (fish/meat/bread). Multi-bite + specials deferred.

[heal_10]
table=consume_table
data=consumable,anchovies
data=consumable,potato
data=consumable,cabbage
data=stat_heal,hitpoints,10,0

[heal_30]
table=consume_table
data=consumable,shrimp
data=consumable,cooked_chicken
data=consumable,cooked_meat
data=stat_heal,hitpoints,30,0

[heal_40]
table=consume_table
data=consumable,sardine
data=stat_heal,hitpoints,40,0

[heal_50]
table=consume_table
data=consumable,bread
data=consumable,herring
data=stat_heal,hitpoints,50,0

[heal_60]
table=consume_table
data=consumable,mackerel
data=stat_heal,hitpoints,60,0

[heal_70]
table=consume_table
data=consumable,trout
data=consumable,cod
data=stat_heal,hitpoints,70,0

