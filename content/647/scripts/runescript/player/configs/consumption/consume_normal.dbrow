// ── MULTI-BITE FOODS (pies / cakes / pizzas) ──────────────────────────
// Each bite-stage is its own consumable row (you eat the half-pie / 2-3 cake
// too). The stage-chain — which obj the food turns into on each bite — is the
// next_obj_stage obj param (set in all.obj), NOT a column here; consume_effect_
// stat2 reads it. Per-bite heal in 2011 life points, cross-checked vs the local
// 2011 wiki (the pies' and pizzas' differ from rev-225's; the cakes' do not).

[multibite_heal_40]
table=consume_table
data=consumable,cake
data=consumable,partial_cake
data=consumable,cake_slice
data=stat_heal,hitpoints,40,0

[multibite_heal_50]
table=consume_table
data=consumable,redberry_pie
data=consumable,half_a_redberry_pie
data=consumable,chocolate_cake
data=consumable,partial_chocolate_cake
data=consumable,chocolate_slice
data=stat_heal,hitpoints,50,0

[multibite_heal_60]
table=consume_table
data=consumable,meat_pie
data=consumable,half_a_meat_pie
data=stat_heal,hitpoints,60,0

[multibite_heal_70]
table=consume_table
data=consumable,apple_pie
data=consumable,half_an_apple_pie
data=consumable,plain_pizza
data=consumable,half_plain_pizza
data=stat_heal,hitpoints,70,0

[multibite_heal_80]
table=consume_table
data=consumable,meat_pizza
data=consumable,half_meat_pizza
data=stat_heal,hitpoints,80,0

[multibite_heal_90]
table=consume_table
data=consumable,anchovie_pizza
data=consumable,half_anchovie_pizza
data=stat_heal,hitpoints,90,0

[multibite_heal_110]
table=consume_table
data=consumable,pineapple_pizza
data=consumable,half_pineapple_pizza
data=stat_heal,hitpoints,110,0

// ── SPECIALS: stews (heal + leave an empty bowl) ──────────────────────
// Heal in 2011 life points (local wiki). The empty-bowl transform is the
// next_obj_stage obj param (stew/curry -> bowl, set in all.obj); consume_effect_
// stat2 reads it. Kebab is NOT here — it heals inline (consume_effect_kebab).

[stew_heal]
table=consume_table
data=consumable,stew
data=stat_heal,hitpoints,110,0

[curry_heal]
table=consume_table
data=consumable,curry
data=stat_heal,hitpoints,190,0
