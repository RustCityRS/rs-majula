[opheld2,_] ~equip(last_slot);

// 289's [inv_button1,wornitems:wear]: its worn tab is one inventory grid. 2011's
// is eleven slot components (387), so the client sends no slot; Remove is each
// component's op1, answered by ~handle_worn_button below.
// [inv_button1,wornitems:wear]
// if_close;
// if (p_finduid(uid) = true) {
//     p_clearpendingaction;
//     ~unequip(last_slot);
// }

// Worn equipment is 11 single-cell slot components (not a grid), so the client
// sends no slot index (last_slot = -1). Like void's EquipSlot.by(component), we
// identify the slot by WHICH component fired and pass its wearpos constant.
// Same handler shape as ~handle_inv_button, but the slot comes from the
// component. Remove (op1) and Examine (op10) are fixed worn actions handled
// directly; p_opheld is the inventory bridge for item-configurable ops.
[proc,handle_worn_button](int $op, int $slot)
if (p_finduid(uid) = false) { return; }
if ($op = 1) {
    if_close;
    ~unequip($slot);
} else if ($op = 10) {
    ~worn_examine($slot);
}

[proc,worn_examine](int $slot)
def_obj $obj = inv_getobj(worn, $slot);
if ($obj ! null) {
    mes(oc_desc($obj));
}

[if_button1,wornitems:hat] ~handle_worn_button(1, ^hat_slot);
[if_button10,wornitems:hat] ~handle_worn_button(10, ^hat_slot);
[if_button1,wornitems:back] ~handle_worn_button(1, ^cape_slot);
[if_button10,wornitems:back] ~handle_worn_button(10, ^cape_slot);
[if_button1,wornitems:front] ~handle_worn_button(1, ^amulet_slot);
[if_button10,wornitems:front] ~handle_worn_button(10, ^amulet_slot);
[if_button1,wornitems:rhand] ~handle_worn_button(1, ^weapon_slot);
[if_button10,wornitems:rhand] ~handle_worn_button(10, ^weapon_slot);
[if_button1,wornitems:torso] ~handle_worn_button(1, ^chest_slot);
[if_button10,wornitems:torso] ~handle_worn_button(10, ^chest_slot);
[if_button1,wornitems:lhand] ~handle_worn_button(1, ^shield_slot);
[if_button10,wornitems:lhand] ~handle_worn_button(10, ^shield_slot);
[if_button1,wornitems:legs] ~handle_worn_button(1, ^legs_slot);
[if_button10,wornitems:legs] ~handle_worn_button(10, ^legs_slot);
[if_button1,wornitems:hands] ~handle_worn_button(1, ^hands_slot);
[if_button10,wornitems:hands] ~handle_worn_button(10, ^hands_slot);
[if_button1,wornitems:feet] ~handle_worn_button(1, ^feet_slot);
[if_button10,wornitems:feet] ~handle_worn_button(10, ^feet_slot);
[if_button1,wornitems:ring] ~handle_worn_button(1, ^ring_slot);
[if_button10,wornitems:ring] ~handle_worn_button(10, ^ring_slot);
[if_button1,wornitems:quiver] ~handle_worn_button(1, ^ammo_slot);
[if_button10,wornitems:quiver] ~handle_worn_button(10, ^ammo_slot);

[proc,equip](int $slot)
if (p_finduid(uid) = true) {
    def_obj $obj = inv_getobj(inv, $slot)
    if ($obj = null) {
        return;
    }
    // 289's Duel Arena rules wait for the Duel Arena port
    // (game_duelarena/scripts/duel_arena_settings.rs2).
    // if (~duel_arena_equip_check($obj) = false) {
    //     return;
    // }
    // if (~duel_arena_flower_power_equip_check($obj) = false) {
    //     return;
    // }
    // 289's mining camp guards wait for the Tourist Trap port
    // (~desertcamp_guard_search, quest_desertrescue).
    // // might be rework behaviour, hard to confirm
    // if(inzone(0_51_147_0_0, 0_51_147_19_63, coord) = true) {
    //     if(npc_find(coord, desertminingmercenary2, 4, 2) = true | npc_find(coord, desertminingmercenary1, 4, 2) = true) {
    //         ~npc_retaliate(0);
    //         ~desertcamp_guard_search;
    //     }
    // }
    if ((oc_wearpos($obj) = ^wearpos_rhand | oc_wearpos($obj) = ^wearpos_lhand) & ~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
        mes("You feel it would be cheating to hold anything other than a gnomeball on the");
        mes("gnomeball pitch");
        return;
    }
    // 289's team colours wait for the Castle Wars port.
    // if (~wearpos_conflicts($obj, castlewars_cloak_saradomin) = true & (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true)) {
    //     mes("You can't remove your team's colours.");
    //     return;
    // }
    def_obj $previous = inv_getobj(worn, ^wearpos_rhand)
    if (~try_equip($slot) = false) {
        mes("You don't have enough free space to do that.")
        return
    }
    // 289's island hook (player/scripts/equip.rs2): the sword and shield
    // move its combat lesson on.
    // todo: this needs a better home...
    if (~in_tutorial_island(coord) = true & %varplayer_419 = ^newbie_combat_instructor_unequipping_items) {
        def_obj $shield = inv_getobj(worn, ^wearpos_lhand);

        if ($previous = bronze_sword & $shield = wooden_shield) {
            %varplayer_419 = ^newbie_combat_instructor_open_combat_interface;
            ~set_tutorial_progress;
        }
    }

    if($obj = elemental_shield) {
        inv_delslot(worn, ^wearpos_lhand);
        buildappearance(worn);
        spotanim_pl(elemental_shield_equip, 92, 0);
        sound_synth(shield_appear, 1, 0);
        p_delay(0);
        inv_setslot(worn, ^wearpos_lhand, elemental_shield, 1);
    } else if($obj = ibanstaff) {
        // https://youtu.be/n_ip_vEDbCA?si=0uESoOC98Fvl7HqS&t=2333
        mes("You equip the staff of Iban.");
    }
    // 289's greegree transformation waits for the Monkey Madness port.
    // else if(oc_category($obj) = mm_greegree) {
    //     spotanim_pl(windwave_impact, 124, 0);
    //     anim(null, 0);
    //     sound_synth(oc_param($obj, transform_sound), 0, 0);
    // }

    ~update_all($previous)
}

[proc,unequip](int $slot)
if (p_finduid(uid) = true) {
    def_obj $obj = inv_getobj(worn, $slot)
    if ($obj = null) {
        return
    }
    // 289's Duel Arena rule waits for the Duel Arena port.
    // if (~duel_arena_flower_power_unequip_check($slot) = false) {
    //     return;
    // }
    if ($obj = ball_gnomeball_game & ~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
        mes("You feel it would be cheating to put the ball in your pack whilst on the pitch.");
        return;
    }
    // 289's team colours wait for the Castle Wars port.
    // if (($obj = castlewars_cloak_zamorak | $obj = castlewars_cloak_saradomin) & (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true)) {
    //     mes("You can't remove your team's colours.");
    //     return;
    // }
    def_int $count = inv_getnum(worn, $slot)
    def_int $overflow = inv_itemspace2(inv, $obj, $count, inv_size(inv))
    if ($overflow >= $count) {
        mes("You don't have enough free space to do that.")
        return
    }
    inv_moveitem(worn, inv, $obj, sub($count, $overflow))
    ~unequip_effect($obj, ^true)
}

// 289's player/scripts/equip.rs2, line for line (a bank deposit of worn items
// runs it). The greegree, sled, sigil and Castle Wars standard effects wait
// for Monkey Madness, Troll Romance and Castle Wars, which 647 has not ported:
// mm_greegree, %wearing_sled, the teleport_mm_sigil timer and
// ~castlewars_flag_drop do not exist in 647 yet.
[proc,unequip_effect](obj $obj, int $update_all)
if($obj = elemental_shield & inv_getobj(worn, ^wearpos_lhand) = null) {
    sound_synth(shield_appear, 1, 0);
}
if (oc_param($obj, specwep) = ^true) {
    %sa_attack = ^false;
}
// if(oc_category($obj) = mm_greegree) {
//     p_transmogrify(null);
//     cleartimer(mm_greegree_timer);
//     p_animprotect(^false);
//     spotanim_pl(windwave_impact, 124, 0);
//     sound_synth(oc_param($obj, revert_sound), 0, 0);
//     if_settab(magic, ^tab_magic);
// }
// if($obj = trollromance_toboggon_waxed) {
//     %wearing_sled = ^false;
// }
// if($obj = mm_sigil) {
//     cleartimer(teleport_mm_sigil);
// }
if($update_all = ^true) ~update_all($obj);
// if ($obj = castlewars_saradomin_banner | $obj = castlewars_zamorak_banner) {
//     ~castlewars_flag_drop(inv, $obj);
// }

[proc,try_unequip](int $slot)
if (p_finduid(uid) = true) {
    def_obj $obj = inv_getobj(worn, $slot)
    if ($obj = null) {
        return
    }
    def_int $count = inv_getnum(worn, $slot)
    def_int $overflow = inv_itemspace2(inv, $obj, $count, inv_size(inv))
    if ($overflow >= $count) {
        return
    }
    if (oc_param($obj, specwep) = ^true) {
        %sa_attack = ^false;
    }
    inv_moveitem(worn, inv, $obj, sub($count, $overflow))
    ~update_all($obj)
}

[proc,.try_unequip](int $slot)
if (.p_finduid(.uid) = true) {
    def_obj $obj = .inv_getobj(worn, $slot);
    if ($obj = null) {
        return;
    }
    def_int $count = .inv_getnum(worn, $slot);
    def_int $overflow = .inv_itemspace2(inv, $obj, $count, .inv_size(inv));
    if ($overflow >= $count) {
        return;
    }
    if (oc_param($obj, specwep) = ^true) {
        .%sa_attack = ^false;
    }
    .inv_moveitem(worn, inv, $obj, sub($count, $overflow));
    ~.update_all($obj);
}

[proc,try_equip](int $inv_slot)(boolean)
def_obj $equip_obj = inv_getobj(inv, $inv_slot)
if ($equip_obj = null) {
    return(false)
}
def_int $worn_slot = oc_wearpos($equip_obj)
if ($worn_slot = null) {
    return(false)
}

// if the item is stackable and we have the item already in our worn inv, add to the stack!
if (oc_stackable($equip_obj) = true & inv_total(worn, $equip_obj) > 0) {
    def_int $equip_obj_num = inv_getnum(inv, $inv_slot)
    def_int $overflow = inv_itemspace2(worn, $equip_obj, $equip_obj_num, inv_size(worn))
    if ($overflow >= $equip_obj_num) {
        return(false)
    }
    inv_moveitem(inv, worn, $equip_obj, sub($equip_obj_num, $overflow))
    return(true)
}

if (~unequip_conflicts_space($equip_obj) = false) {
    return(false)
}

def_obj $previous_equip = inv_getobj(worn, $worn_slot)
inv_movetoslot(inv, worn, $inv_slot, $worn_slot)
if (inv_getobj(inv, $inv_slot) ! null) {
    // presumably, they added this as an easy way for stackable objs to stack in the inv (instead of directly swapping)
    // seems like in late 2006 they removed this line of code and it produced this bug: https://youtu.be/EYXp7GMFWEw, https://youtu.be/DwzDt3yw6k4
    inv_movefromslot(inv, inv, $inv_slot)
}
~unequip_conflicts($equip_obj)
if($previous_equip ! null) ~unequip_effect($previous_equip, ^false)

return(true)

[proc,unequip_conflicts_space](obj $equip_obj)(boolean)
def_int $conflicts = 0
def_int $i = 0
while ($i < inv_size(worn)) {
    def_obj $worn_obj = inv_getobj(worn, $i)
    def_int $worn_num = inv_getnum(worn, $i)
    if ($worn_obj ! null) {
        if (~wearpos_conflicts($equip_obj, $worn_obj) = true) {
            if (oc_stackable($worn_obj) = true) {
                if (inv_total(inv, $worn_obj) < 1) {
                    $conflicts = add($conflicts, 1)
                } else if (inv_itemspace(inv, $worn_obj, $worn_num, inv_size(inv)) = false) {
                    return(false)
                }
            } else {
                $conflicts = add($conflicts, 1)
            }
        }
    }
    $i = add($i, 1)
}
if ($conflicts > add(inv_freespace(inv), 1)) {
    return(false)
}
return(true)

[proc,unequip_conflicts](obj $equip_obj)
def_int $i = 0
while ($i < inv_size(worn)) {
    def_obj $worn_obj = inv_getobj(worn, $i)
    def_int $worn_num = inv_getnum(worn, $i)
    if ($worn_obj ! null & $worn_obj ! $equip_obj) {
        if (~wearpos_conflicts($equip_obj, $worn_obj) = true) {
            inv_moveitem(worn, inv, $worn_obj, $worn_num)
            // run unequip effects on the conflicted obj
            ~unequip_effect($worn_obj, ^false)
        }
    }
    $i = add($i, 1)
}

[proc,wearpos_conflicts](obj $equip_obj, obj $worn_obj)(boolean)
def_int $wearpos1 = oc_wearpos($equip_obj)
def_int $wearpos2 = oc_wearpos2($equip_obj)
def_int $wearpos3 = oc_wearpos3($equip_obj)
def_int $worn_wearpos1 = oc_wearpos($worn_obj)
def_int $worn_wearpos2 = oc_wearpos2($worn_obj)
def_int $worn_wearpos3 = oc_wearpos3($worn_obj)

if (($wearpos1 ! null & ($wearpos1 = $worn_wearpos1 | $wearpos1 = $worn_wearpos2 | $wearpos1 = $worn_wearpos3)) | ($wearpos2 ! null & ($wearpos2 = $worn_wearpos1 | $wearpos2 = $worn_wearpos2 | $wearpos2 = $worn_wearpos3)) | ($wearpos3 ! null & ($wearpos3 = $worn_wearpos1 | $wearpos3 = $worn_wearpos2 | $wearpos3 = $worn_wearpos3))) {
    return(true)
}
return(false)

// 289's update_all (player/scripts/appearance.rs2). ~update_weight is empty in
// 289 too. 289 sends the attack tab only past Tutorial Island's unequipping
// lesson. 2011's players take Unstable Foundations instead (it replaced the
// island on 17 September 2009, wiki Unstable Foundations), and their island
// varp stays 0; the island, kept as 289's (tutorial/), shows every tab.
[proc,update_all](obj $previous_weapon)
// secret sauce
if (staffmodlevel >= 3 & inv_getobj(worn, ^wearpos_rhand) = poisoned_dagger_p) {
    stat_add(hitpoints, calc(255 - stat(hitpoints)), 0);
    stat_add(attack, calc(255 - stat(attack)), 0);
    stat_add(strength, calc(255 - stat(strength)), 0);
    stat_add(defence, calc(255 - stat(defence)), 0);
    stat_add(ranged, calc(255 - stat(ranged)), 0);
    stat_add(magic, calc(255 - stat(magic)), 0);
    stat_add(prayer, calc(255 - stat(prayer)), 0);
}
if (p_finduid(uid) = true) {
    p_animprotect(^false);
}
// ~update_weight_equipment; // waits for the Ikov port (boots of lightness)
~update_bas
~update_bonuses
~update_weight
~update_weapon_category($previous_weapon)
~player_combat_stat
// 289's greegree transformation and Troll Romance sled walk wait for the
// Monkey Madness and Troll Romance ports.
// ~mm_greegree_transmogrify(inv_getobj(worn, ^wearpos_rhand)); // greegree transmogrify
// // Force the sled 'crab walk' glitch. Must be a better way to do this than checking for the sled in the right hand slot, but this works for now.
// // https://www.youtube.com/watch?v=i9m-APfxg5Y&t=29s
// if (inv_getobj(worn, ^wearpos_rhand) = trollromance_toboggon_waxed) {
//     %wearing_sled = ^true;
// }
// if (%wearing_sled = ^true) {
//     readyanim(trollromance_toboggan_ready);
//     turnanim(trollromance_toboggan_walking);
//     walkanim(trollromance_toboggan_walking);
//     walkanim_b(trollromance_toboggan_walking);
//     walkanim_l(trollromance_toboggan_walking);
//     walkanim_r(trollromance_toboggan_walking);
//     runanim(trollromance_toboggan_walking);
//     buildappearance(worn);
//     p_animprotect(^true);
// }

[proc,.update_all](obj $previous_weapon)
// secret sauce
if (.staffmodlevel >= 3 & .inv_getobj(worn, ^wearpos_rhand) = poisoned_dagger_p) {
    .stat_add(hitpoints, calc(255 - .stat(hitpoints)), 0);
    .stat_add(attack, calc(255 - .stat(attack)), 0);
    .stat_add(strength, calc(255 - .stat(strength)), 0);
    .stat_add(defence, calc(255 - .stat(defence)), 0);
    .stat_add(ranged, calc(255 - .stat(ranged)), 0);
    .stat_add(magic, calc(255 - .stat(magic)), 0);
    .stat_add(prayer, calc(255 - .stat(prayer)), 0);
}
if (.p_finduid(.uid) = true) {
    .p_animprotect(^false);
}
.cam_reset;
~.update_bas; // update appearance
~.update_bonuses; // update bonuses if
~.update_weight; // update weight
~.update_weapon_category($previous_weapon); // the attack tab weapon category
~.player_combat_stat; // update combat varps

[queue,update_all]
~update_all(null);

// 289's update_bonuses (player/scripts/equip.rs2): the prayer drain's
// resistance. 2011's worn tab (387) shows no bonuses: 289's lines below go
// to its Equipment Stats screen (~equip_screen_bonuses).
[proc,update_bonuses]
def_int $stabattack;
def_int $slashattack;
def_int $crushattack;
def_int $magicattack;
def_int $rangeattack;
def_int $stabdefence;
def_int $slashdefence;
def_int $crushdefence;
def_int $magicdefence;
def_int $rangedefence;
def_int $strengthbonus;
def_int $prayerbonus;
def_int $rangebonus;

$stabattack,
$slashattack,
$crushattack,
$magicattack,
$rangeattack,
$stabdefence,
$slashdefence,
$crushdefence,
$magicdefence,
$rangedefence,
$strengthbonus,
$prayerbonus,
$rangebonus = ~equip_get_bonuses;

%prayer_drain_resistance = add(60, multiply($prayerbonus, 2));

// ~update_bonus_text(wornitems:stabattack, "Stab", $stabattack);
// ~update_bonus_text(wornitems:slashattack, "Slash", $slashattack);
// ~update_bonus_text(wornitems:crushattack, "Crush", $crushattack);
// ~update_bonus_text(wornitems:magicattack, "Magic", $magicattack);
// ~update_bonus_text(wornitems:rangeattack, "Range", $rangeattack);
// ~update_bonus_text(wornitems:stabdefence, "Stab", $stabdefence);
// ~update_bonus_text(wornitems:slashdefence, "Slash", $slashdefence);
// ~update_bonus_text(wornitems:crushdefence, "Crush", $crushdefence);
// ~update_bonus_text(wornitems:magicdefence, "Magic", $magicdefence);
// ~update_bonus_text(wornitems:rangedefence, "Range", $rangedefence);
// ~update_bonus_text(wornitems:strengthbonus, "Strength", $strengthbonus);
// ~update_bonus_text(wornitems:prayerbonus, "Prayer", $prayerbonus);

// 2011's Equipment Stats screen (equip_screen2, 667) with the backpack beside
// it (inventory_wear2, 670), from the worn tab's "Show Equipment Stats"
// (387:39) or the bank's (762:117, interface_bank). void-634
// EquipmentBonuses, BankOpen, worn_equipment.ifaces.toml.
// The worn tab is not a modal, so its button runs unprotected; it takes
// protected access as the tab's own Remove does (~handle_worn_button).
[if_button,wornitems:equipscreen_container]
if (p_finduid(uid) = false) { return; }
~equip_screen_open(false);

[proc,equip_screen_open](boolean $from_bank)
if_close;
// "Show bank" (667:48) shows only on a screen opened from the bank (varbit
// 4894; clientscript 787, the screen's onload). The bank stays hidden while
// the screen is up (varbit 8348; clientscripts 2318 and 2319).
if ($from_bank = true) {
    %equipment_bank_button = 1;
} else {
    %equipment_bank_button = 0;
}
%bank_show_equipscreen = 1;
inv_transmit(worn, equip_screen2:worn_items_layer);
inv_transmit(inv, inventory_wear2:layer_1);
if_openmain_side(equip_screen2, inventory_wear2);
// What is worn: Remove (op1), Examine (op10); the backpack: Equip (op1),
// Examine (op10). 2011's Stats (op9 on both: clientscripts 2373, 2739) is not
// ported.
if_setevents(equip_screen2:worn_items_layer, 0, 15, calc(^if_op1 + ^if_op10), 0, 0, ^false, ^false);
if_setevents(inventory_wear2:layer_1, 0, 27, calc(^if_op1 + ^if_op10), 0, 0, ^false, ^false);
~equip_screen_bonuses;
// The screen's root starts hidden: clientscript 2319 shows it (and hides the
// bank) by varbit 8348. From the bank, the bank's own var hook (762:121) runs
// it; from the worn tab nothing does, so it is run here, as void-634 runs it
// once the screen is open. The open goes out at the end of the tick, after
// this script's packets, so it waits for the next.
p_delay(0);
runclientscript("bank_v2_showequipscreen()");

// The screen stays open through a change made on it, unlike the worn tab's
// Remove (~handle_worn_button), which closes what is open as 289's did.
[if_button1,equip_screen2:worn_items_layer]
~unequip(last_slot);
~equip_screen_bonuses;
[if_button10,equip_screen2:worn_items_layer] ~worn_examine(last_slot);

// Equip is the item's own wear op (op2, [opheld2]), so an item's own trigger
// still answers; an item that is not worn has none to run.
[if_button1,inventory_wear2:layer_1]
def_obj $obj = inv_getobj(inv, last_slot);
if ($obj = null) {
    return;
}
if (oc_wearpos($obj) = null) {
    return;
}
p_opheld(2, inv, last_slot);
~equip_screen_bonuses;
[if_button10,inventory_wear2:layer_1] ~inv_examine(last_slot);

[if_button,equip_screen2:bank_button]
if (%equipment_bank_button = 1) {
    @openbank;
}

// 289's bonus lines (~update_bonus_text, wornitems) at 2011's components,
// under the cache's own labels (2011's "Ranged" for 289's "Range"). 2011's
// Ranged Strength is 289's rangebonus, which 289 counted and never showed.
// 2011's Summoning defence, absorbs and Magic Damage have no 289 values: they
// read 0, in void-634's form for each (grade C).
[proc,equip_screen_bonuses]
def_int $stabattack;
def_int $slashattack;
def_int $crushattack;
def_int $magicattack;
def_int $rangeattack;
def_int $stabdefence;
def_int $slashdefence;
def_int $crushdefence;
def_int $magicdefence;
def_int $rangedefence;
def_int $strengthbonus;
def_int $prayerbonus;
def_int $rangebonus;

$stabattack,
$slashattack,
$crushattack,
$magicattack,
$rangeattack,
$stabdefence,
$slashdefence,
$crushdefence,
$magicdefence,
$rangedefence,
$strengthbonus,
$prayerbonus,
$rangebonus = ~equip_get_bonuses;

~update_bonus_text(equip_screen2:stabatt, "Stab", $stabattack);
~update_bonus_text(equip_screen2:slashatt, "Slash", $slashattack);
~update_bonus_text(equip_screen2:crushatt, "Crush", $crushattack);
~update_bonus_text(equip_screen2:magicatt, "Magic", $magicattack);
~update_bonus_text(equip_screen2:rangeatt, "Ranged", $rangeattack);
~update_bonus_text(equip_screen2:stabdef, "Stab", $stabdefence);
~update_bonus_text(equip_screen2:slashdef, "Slash", $slashdefence);
~update_bonus_text(equip_screen2:crushdef, "Crush", $crushdefence);
~update_bonus_text(equip_screen2:magicdef, "Magic", $magicdefence);
~update_bonus_text(equip_screen2:rangedef, "Ranged", $rangedefence);
~update_bonus_text(equip_screen2:summoningdef, "Summoning", 0);
// 2011's soak percents, worn head, body, legs and shield (damage.rs2).
if_settext(equip_screen2:com_41, "Absorb Melee: +<tostring(~worn_absorb(^hitmark_melee))>%");
if_settext(equip_screen2:com_42, "Absorb Magic: +<tostring(~worn_absorb(^hitmark_magic))>%");
if_settext(equip_screen2:com_43, "Absorb Ranged: +<tostring(~worn_absorb(^hitmark_ranged))>%");
~update_bonus_text(equip_screen2:wearstrength, "Strength", $strengthbonus);
~update_bonus_text(equip_screen2:com_45, "Ranged Strength", $rangebonus);
~update_bonus_text(equip_screen2:wearprayer, "Prayer", $prayerbonus);
if_settext(equip_screen2:com_47, "Magic Damage: +0%");

[proc,update_bonus_text](component $com, string $name, int $bonus)
def_string $sign = "+";
if ($bonus < 0) {
    $sign = "";
}
if_settext($com, "<$name>: <$sign><tostring($bonus)>");

// 289's .update_bonuses: the prayer drain's resistance; its bonus lines are
// the worn tab's, which 2011's does not have (see ~update_bonuses).
[proc,.update_bonuses]
def_int $stabattack;
def_int $slashattack;
def_int $crushattack;
def_int $magicattack;
def_int $rangeattack;
def_int $stabdefence;
def_int $slashdefence;
def_int $crushdefence;
def_int $magicdefence;
def_int $rangedefence;
def_int $strengthbonus;
def_int $prayerbonus;
def_int $rangebonus;

$stabattack,
$slashattack,
$crushattack,
$magicattack,
$rangeattack,
$stabdefence,
$slashdefence,
$crushdefence,
$magicdefence,
$rangedefence,
$strengthbonus,
$prayerbonus,
$rangebonus = ~.equip_get_bonuses;

.%prayer_drain_resistance = add(60, multiply($prayerbonus, 2));

