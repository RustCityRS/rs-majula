// 289's jewellery structs (skill_crafting/configs/jewellery/jewellery.struct),
// server-only at 647; their objs as 2011 names them, and 289's name as
// name_text (jewellery.param).
[gold_ring]
param=product,gold_ring
param=levelrequired,5
param=productexp,150

[sapphire_ring]
param=product,sapphire_ring
param=gem,sapphire
param=levelrequired,20
param=productexp,400

