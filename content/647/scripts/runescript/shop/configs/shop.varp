// 289's shop vars. `shop` is 2011's varp 118: the client draws the open
// shop's stock from the inventory it names (clientscript 2716), so setting it
// is what shows the shop. The others are the server's.
[shop_buy]
type=int
scope=temp

[shop_sell]
type=int
scope=temp

[shop_haggle]
type=int
scope=temp

// 2011's: the shop's currency (varp 532, the obj whose icon the client puts
// beside each price, clientscript 2723) and its free sample stock (varp 1496,
// an inventory the client lists above the main stock, clientscript 2717;
// -1 for none). 289's shops all take coins and give no samples.
