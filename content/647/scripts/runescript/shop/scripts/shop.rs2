// 289's shop/scripts/shop.rs2 on 2011's shop (shop_template, 620) and its
// backpack panel (shop_template_side, 621).
//
// 2011's client draws the shop itself: clientscript 2716 lays out the
// inventory varp 118 (289's %shop) names, six components a slot, with each
// item's ops (Info, Buy 1/5/10/50/500, Examine) and its price beside it. The
// server says which shop, what it is based on (varcs 946-985, a slot's base
// stock, which the price reads) and in what currency, and unlocks the ops.
// The backpack panel is a plain inventory grid the server asks for
// (clientscript 150) with void-634's ops (shop.ifaces.toml): Value, Sell
// 1/5/10/50, Examine.
[opnpc3,_shop_keeper] ~openshop_activenpc;

[proc,openshop](inv $shop, int $shop_buy, int $shop_sell, int $shop_haggle, string $title)
%shop = $shop;
%shop_buy = $shop_buy;
%shop_sell = $shop_sell;
%shop_haggle = $shop_haggle;
if_settext(shop_template:shop_title, $title);
inv_transmit(inv, shop_template_side:inventory_layer);
inv_transmit($shop, shop_template:com_25);
if_openmain_side(shop_template, shop_template_side);
~openshop_2011;

[proc,openshop_activenpc]
%shop = npc_param(owned_shop);
%shop_buy = npc_param(shop_buy_multiplier);
%shop_sell = npc_param(shop_sell_multiplier);
%shop_haggle = npc_param(shop_delta);
if_settext(shop_template:shop_title, npc_param(shop_title));
inv_transmit(inv, shop_template_side:inventory_layer);
inv_transmit(%shop, shop_template:com_25);
if_openmain_side(shop_template, shop_template_side);
~openshop_2011;

// What 2011's shop needs once it is open. Events follow the opens: a sub
// opened over one already open drops the old one's events in the client.
[proc,openshop_2011]
%shop_currency = coins;
%shop_sample = null;
// Each slot's base stock, which the client prices by (clientscript 2721).
%varclient_946 = ~shop_stockbase(0);
%varclient_947 = ~shop_stockbase(1);
%varclient_948 = ~shop_stockbase(2);
%varclient_949 = ~shop_stockbase(3);
%varclient_950 = ~shop_stockbase(4);
%varclient_951 = ~shop_stockbase(5);
%varclient_952 = ~shop_stockbase(6);
%varclient_953 = ~shop_stockbase(7);
%varclient_954 = ~shop_stockbase(8);
%varclient_955 = ~shop_stockbase(9);
%varclient_956 = ~shop_stockbase(10);
%varclient_957 = ~shop_stockbase(11);
%varclient_958 = ~shop_stockbase(12);
%varclient_959 = ~shop_stockbase(13);
%varclient_960 = ~shop_stockbase(14);
%varclient_961 = ~shop_stockbase(15);
%varclient_962 = ~shop_stockbase(16);
%varclient_963 = ~shop_stockbase(17);
%varclient_964 = ~shop_stockbase(18);
%varclient_965 = ~shop_stockbase(19);
%varclient_966 = ~shop_stockbase(20);
%varclient_967 = ~shop_stockbase(21);
%varclient_968 = ~shop_stockbase(22);
%varclient_969 = ~shop_stockbase(23);
%varclient_970 = ~shop_stockbase(24);
%varclient_971 = ~shop_stockbase(25);
%varclient_972 = ~shop_stockbase(26);
%varclient_973 = ~shop_stockbase(27);
%varclient_974 = ~shop_stockbase(28);
%varclient_975 = ~shop_stockbase(29);
%varclient_976 = ~shop_stockbase(30);
%varclient_977 = ~shop_stockbase(31);
%varclient_978 = ~shop_stockbase(32);
%varclient_979 = ~shop_stockbase(33);
%varclient_980 = ~shop_stockbase(34);
%varclient_981 = ~shop_stockbase(35);
%varclient_982 = ~shop_stockbase(36);
%varclient_983 = ~shop_stockbase(37);
%varclient_984 = ~shop_stockbase(38);
%varclient_985 = ~shop_stockbase(39);
if_setevents(shop_template:com_25, 0, calc(inv_size(%shop) * ^shop_slot_components - 1), ~inv_ops(^if_op1, ^if_op2, ^if_op3, ^if_op4, ^if_op5, ^if_op6, ^no_op, ^no_op, ^no_op, ^if_op10), 0, 0, ^false, ^false);
runclientscript("interface_inv_init_big(shop_template_side:inventory_layer, inv, 4, 7, 0, -1, \"Value\", \"Sell 1\", \"Sell 5\", \"Sell 10\", \"Sell 50\", \"Examine\", \"\", \"\", \"\")");
if_setevents(shop_template_side:inventory_layer, 0, 27, ~inv_ops(^if_op1, ^if_op2, ^if_op3, ^if_op4, ^if_op5, ^if_op6, ^no_op, ^no_op, ^no_op, ^no_op), 0, 0, ^false, ^false);

[proc,shop_stockbase](int $slot)(int)
if ($slot < inv_size(%shop)) {
    def_obj $obj = inv_getobj(%shop, $slot);
    if ($obj ! null) {
        return(max(0, inv_stockbase(%shop, $obj)));
    }
}
return(0);

[if_close,shop_template]
inv_stoptransmit(shop_template_side:inventory_layer);
inv_stoptransmit(shop_template:com_25);

[proc,can_sell_obj](obj $item)(boolean)
def_boolean $item_is_tradable = oc_tradeable(oc_uncert($item));
if ($item = coins) {
    mes("You can't sell this item to a shop.");
    return (false);
} else if ($item_is_tradable = false | (map_members = ^false & oc_members($item) = true)) {
    mes("You can't sell this item.");
    return (false);
} else if ((%shop = generalshop3 & $item = silk) | inv_allstock(%shop) = false & inv_stockbase(%shop, oc_uncert($item)) = -1) { // can't sell silk to al-kharid general store
    mes("You can't sell this item to this shop.");
    return (false);
}
return (true);

// sell value
[if_button1,shop_template_side:inventory_layer]
def_obj $item = oc_uncert(inv_getobj(inv, last_slot));
def_string $item_name = oc_name($item);
def_int $item_value = ~adjusted_item_cost_selling($item, inv_total(%shop, $item));
if(~can_sell_obj($item) = false) {
    return;
}
mes("<$item_name>: shop will buy for <tostring($item_value)>gp.");

// Buy value: 289's left-click on the stock, 2011's Info (clientscript 2723;
// void-634 opens its item information panel there, obj_info, which is not
// ported).
[if_button1,shop_template:com_25]
def_obj $item = inv_getobj(%shop, ~shop_slot(last_slot));
def_string $item_name = oc_name($item);
def_int $item_value = ~adjusted_item_cost_buying($item, inv_total(%shop, $item));
mes("<$item_name>: currently costs <tostring($item_value)>gp.");

// Buy an item from the shop
[label,buy_item](obj $obj, int $amount)
def_int $i = 0;
def_int $current_gp = inv_total(inv, coins);
def_int $shop_stock = calc(inv_total(%shop, $obj));
def_int $space_overflow = inv_itemspace2(inv, $obj, $amount, inv_size(inv));
def_int $total_cost = 0;
// Since pricing and stock will change constantly we will have to iterate here to calc
while($i < $amount) {
    def_int $added_amt = ~adjusted_item_cost_buying($obj, calc($shop_stock - $i));
    def_int $current_stock = calc($shop_stock - $i);
    if(calc($total_cost + $added_amt) > $current_gp) {
        if ($i > 0) {
            wealth_event(^wealth_shop_buy, oc_debugname($obj), $i, $total_cost);
        }
        mes("You don't have enough coins.");
        return;
    }
    if($current_stock <= 0) {
        if ($i > 0) {
            wealth_event(^wealth_shop_buy, oc_debugname($obj), $i, $total_cost);
        }
        mes("The shop has run out of stock.");
        return;
    }
    // do calc($total_cost + $added_amt) ! $current_gp for the case where the exact gp required for the purchase
    // is used. Not sure if this should be the case in 2004
    if($space_overflow >= calc($amount - $i) & calc($total_cost + $added_amt) ! $current_gp) {
        if ($i > 0) {
            wealth_event(^wealth_shop_buy, oc_debugname($obj), $i, $total_cost);
        }
        mes("You don't have enough inventory space.");
        return;
    }
    $total_cost = calc($total_cost + $added_amt);
    inv_del(inv, coins, $added_amt);
    inv_moveitem_uncert(%shop, inv, $obj, 1);
    $i = calc($i + 1);
}
wealth_event(^wealth_shop_buy, oc_debugname($obj), $i, $total_cost);

// Sell an item to the shop
[label,sell_item](obj $obj, int $amount)
def_int $shop_total = inv_total(%shop, oc_uncert($obj));
def_int $total_value = 0;
def_int $sell_amount = ~calculate_items_amount_sold($obj, $amount);
if(~can_sell_obj($obj) = false) {
    return;
}
// Check if you will have space in your inventory to hold the coins after selling
if(inv_itemspace(inv, coins, $sell_amount, inv_size(inv)) = false & oc_stackable($obj) = true & inv_total(inv, $obj) > $sell_amount) {
    mes("You don't have enough inventory space.");
    return;
}
// Check if the shop will have enough space to hold the obj
if(inv_itemspace(%shop, oc_uncert($obj), $sell_amount, inv_size(%shop)) = false) {
    mes("The shop has run out of space.");
    return;
}
// Iteration to calc the total value of the sale
def_int $i = 0;
while($i < $sell_amount) {
    def_int $added_amt = ~adjusted_item_cost_selling(oc_uncert($obj), calc($shop_total + $i));
    $total_value = calc($total_value + $added_amt);
    $i = calc($i + 1);
}
// now perform the transaction
inv_moveitem_uncert(inv, %shop, $obj, $sell_amount);
wealth_event(^wealth_shop_sell, oc_debugname($obj), $sell_amount, $total_value);
if($total_value > 0) {
    inv_add(inv, coins, $total_value);
}

[proc,price_mod](inv $inv, int $diff, obj $obj)(int)
def_int $base = inv_stockbase($inv, $obj);
if($base = -1) {
    return ($diff);
}
return (calc($diff - $base));

// Purchase cost at a specifc stack count
// 2011's (clientscript 2720, the price the shop shows under each item): the
// item's value while the shop holds at least its base stock, rising to 130%
// of it as the stock runs out; an item the shop has no base for sells at its
// value. 289 charged by the shopkeeper's sell multiplier and haggle instead.
// 2720's other prices (tokkul's, enum 733's fixed ones, skillcapes') are for
// items no 289 shop stocks.
[proc,adjusted_item_cost_buying](obj $obj, int $diff)(int)
$obj = oc_uncert($obj);
def_int $base = max(0, inv_stockbase(%shop, $obj));
def_int $percent = 100;
if ($base > 0) {
    if ($diff <= 0) {
        $percent = 130;
    } else if ($diff < $base) {
        $percent = calc(130 - 30 * $diff / $base);
    }
}
$percent = max(100, min(130, $percent));
return (max(1, scale($percent, 100, oc_cost($obj))));

// Sell value at a specific stack count
[proc,adjusted_item_cost_selling](obj $obj, int $diff)(int)
def_int $cost = oc_cost($obj);
return (~calc_shop_value($cost, %shop_haggle, %shop_buy, ~price_mod(%shop, $diff, $obj)));

// Calculate the amount of items a player has to sell relative to a desired amount
[proc,calculate_items_amount_sold](obj $item, int $sell_amount)(int)
def_int $player_amount = inv_total(inv, $item);
if ($sell_amount > $player_amount) {
    return ($player_amount);
}
return ($sell_amount);

// Sell buttons (void-634 adds Sell 50)
[if_button2,shop_template_side:inventory_layer] @shop_request(inv, last_slot, 1);
[if_button3,shop_template_side:inventory_layer] @shop_request(inv, last_slot, 5);
[if_button4,shop_template_side:inventory_layer] @shop_request(inv, last_slot, 10);
[if_button5,shop_template_side:inventory_layer] @shop_request(inv, last_slot, 50);
[if_button6,shop_template_side:inventory_layer] ~inv_examine(last_slot);

// Buy buttons (2011 adds Buy 50 and Buy 500, clientscript 2723)
[if_button2,shop_template:com_25] @shop_request(%shop, ~shop_slot(last_slot), 1);
[if_button3,shop_template:com_25] @shop_request(%shop, ~shop_slot(last_slot), 5);
[if_button4,shop_template:com_25] @shop_request(%shop, ~shop_slot(last_slot), 10);
[if_button5,shop_template:com_25] @shop_request(%shop, ~shop_slot(last_slot), 50);
[if_button6,shop_template:com_25] @shop_request(%shop, ~shop_slot(last_slot), 500);
[if_button10,shop_template:com_25]
def_obj $obj = inv_getobj(%shop, ~shop_slot(last_slot));
if ($obj ! null) {
    mes(oc_desc($obj));
}

// 2011's stock is six components a slot (clientscript 2723), and the client
// names the one clicked.
[proc,shop_slot](int $component)(int)
return (divide($component, ^shop_slot_components));

// verify a request to buy or sell from a shop, and then perform the transaction if all passed
[label,shop_request](inv $shop_inv, int $slot, int $amount)
// Check if the slot was empty.
def_obj $item = inv_getobj($shop_inv, $slot);
if($shop_inv = %shop) {
    @buy_item($item, $amount);
} else {
    @sell_item($item, $amount);
}

// Calculate the gp value for the shop operation
[proc,calc_shop_value](int $base_cost, int $shophaggle, int $shopbuy, int $int3)(int)
def_int $int4 = 0;
def_int $int5 = min(1000, max(-5000, calc($int3 * $shophaggle)));
$int5 = max(100, calc($shopbuy - $int5));
$int4 = scale($int5, 1000, $base_cost);
if ($int4 < 0) {
    $int4 = 2000000000;
    error("Cost overflowed with base_cost=<tostring($base_cost)>, for %shopbuy=<tostring($shopbuy)> and %shophaggle=<tostring($shophaggle)>. Corrected to 2 billion.");
}
return($int4);

// 289's shop ops are inv_buttons on its two invs; 2011's client sends an
// inventory component's ops as IF_BUTTON1-10, so they are the if_button1-4
// triggers above.
// [inv_button1,shop_template_side:inventory_layer]
// [inv_button2,shop_template_side:inventory_layer]
// [inv_button3,shop_template_side:inventory_layer]
// [inv_button4,shop_template_side:inventory_layer]
// [inv_button1,shop_template:com_25]
// [inv_button2,shop_template:com_25]
// [inv_button3,shop_template:com_25]
// [inv_button4,shop_template:com_25]
