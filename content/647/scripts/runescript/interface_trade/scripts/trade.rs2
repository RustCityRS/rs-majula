    }
}

[label,removefromtrade](int $slot, int $amount)
if ($amount <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $amount = last_int;
}

def_obj $obj = inv_getobj(tradeoffer, $slot);
def_int $total = inv_total(tradeoffer, $obj);
if ($amount < $total) $total = $amount;
inv_moveitem(tradeoffer, inv, $obj, $total);

%tradestatus = ^tradestatus_reset;
// if_settext(trademain:status, "");
if_settext(trademain:com_37, "");
if (.finduid(%tradepartner) = true) {
    session_log(^log_moderator, "Removed offer <oc_debugname($obj)> x<tostring($total)> to <.name>");
    .%tradestatus = ^tradestatus_reset;
    // .if_settext(trademain:status, "");
    .if_settext(trademain:com_37, "");
    ~trade_changed;
    // 2011: a removal marks the offer modified on both screens and
    // flashes the slot it left on the other's (clientscript 143; the 2011
    // wiki: "a big red flashing exclamation point will appear where the
    // item used to be").
    %offer_modified = 1;
    .%other_offer_modified = 1;
    .runclientscript("interface_flash_slot(trademain:com_33, 4, 7, $slot)");
}

