[opplayer4,_]
if (~in_duel_arena(coord) = true) {
    mes("You can't trade in a duel arena."); // https://youtu.be/nUwvlFkcsqA?t=19
    return;
}
if (.busy = true) {
    // 289: mes("<.displayname> is busy at the moment.");
    // 2011's: the 2011 wiki's Trading (2011-05-05): "if one of the traders has
    // a certain interface up, such as bank, equipment stats or trading
    // interface with another player, The other player is busy at the moment
    // message will show up in the chat". The quote has no full stop.
    mes("The other player is busy at the moment");
    return;
}

// this message always sends, even if this player is responding to a trade request
mes("Sending trade offer...");

// https://youtu.be/BOtsghQGQEk?t=417
// https://youtu.be/8G92ZQxRamY?t=145
// https://youtu.be/vS_kBeGudFY?t=10
// 2006: "Trading in the Wilderness is dangerous - you might get killed!"

// https://youtu.be/uSO-ilQk5XY?list=PLn23LiLYLb1bQ7Hwp77KoNBjKvpZQTfJT&t=810
// This nov 2004 vid shows no wildy warning... I think it was added in mid to late 2006? Ive seen some early 2006 vids of trading with no warning

%tradepartner = .uid;

if (.%tradepartner = uid & %tradestatus = ^tradestatus_received) {
    if (.p_finduid(.uid) = true) {
        .p_stopaction;
    }
    // if_settext(trademain:status, "");
    // if_settext(trademain:otherplayer, "Trading With: <.displayname>");
    // inv_transmit(tradeoffer, trademain:inv);
    // invother_transmit(.uid, tradeoffer, trademain:otherinv);
    // inv_transmit(inv, tradeside:inv);
    if_settext(trademain:com_37, "");
    if_settext(trademain:com_15, "Trading With: <.displayname>");
    inv_transmit(tradeoffer, trademain:com_31);
    invother_transmit(.uid, tradeoffer, trademain:com_34);
    inv_transmit(inv, tradeside:com_0);

    // .if_settext(trademain:status, "");
    // .if_settext(trademain:otherplayer, "Trading With: <displayname>");
    // .inv_transmit(tradeoffer, trademain:inv);
    // .invother_transmit(uid, tradeoffer, trademain:otherinv);
    // .inv_transmit(inv, tradeside:inv);
    .if_settext(trademain:com_37, "");
    .if_settext(trademain:com_15, "Trading With: <displayname>");
    .inv_transmit(tradeoffer, trademain:com_31);
    .invother_transmit(uid, tradeoffer, trademain:com_34);
    .inv_transmit(inv, tradeside:com_0);

    if_openmain_side(trademain, tradeside);
    .if_openmain_side(trademain, tradeside);
    ~trademain_2011(.displayname);
    ~.trademain_2011(displayname);
    ~trade_wealth;

    %tradestatus = ^tradestatus_reset;
    .%tradestatus = ^tradestatus_reset;
} else {
    .%tradestatus = ^tradestatus_received;
    // 2011's client takes this as a request from the name (game message type
    // 100, which its chat box offers to accept); rs-protocol sends it so.
    .mes("<displayname>:tradereq:");
}

// What 2011's trade screen needs once it is open (events follow the opens,
// as for the shop): the grids, their ops (own offer: Remove, Remove-5, -10,
// -All, -X; backpack: Offer, Offer-5, -10, -All, -X; both Examine, op10; the
// other offer: Examine, op9; void-634 trade.ifaces.toml, whose Value and
// Lend wait for Grand Exchange prices and item lending), the trader's name
// (varcstr 203, shown on both screens), their free backpack slots (void-634
// "has <n> free inventory slots."), and no offer modified yet.
[proc,trademain_2011](string $name)
runclientscript("interface_inv_init_big(trademain:com_31, tradeoffer, 4, 7, 0, -1, \"Remove\", \"Remove-5\", \"Remove-10\", \"Remove-All\", \"Remove-X\", \"\", \"\", \"\", \"\")");
if_setevents(trademain:com_31, 0, 27, ~inv_ops(^if_op1, ^if_op2, ^if_op3, ^if_op4, ^if_op5, ^no_op, ^no_op, ^no_op, ^no_op, ^if_op10), 0, 0, ^false, ^false);
runclientscript("interface_invother_init_big(trademain:com_34, tradeoffer, 4, 7, 0, -1, \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"Examine\<col=ff9040>\")");
if_setevents(trademain:com_34, 0, 27, ~inv_ops(^no_op, ^no_op, ^no_op, ^no_op, ^no_op, ^no_op, ^no_op, ^no_op, ^if_op9, ^no_op), 0, 0, ^false, ^false);
runclientscript("interface_inv_init_big(tradeside:com_0, inv, 4, 7, 0, -1, \"Offer\", \"Offer-5\", \"Offer-10\", \"Offer-All\", \"Offer-X\", \"\", \"\", \"\", \"\")");
if_setevents(tradeside:com_0, 0, 27, ~inv_ops(^if_op1, ^if_op2, ^if_op3, ^if_op4, ^if_op5, ^no_op, ^no_op, ^no_op, ^no_op, ^if_op10), 0, 0, ^false, ^false);
sendvarc_str(203, $name);
%offer_modified = 0;
%other_offer_modified = 0;
.if_settext(trademain:com_21, "has <tostring(inv_freespace(inv))> free inventory slots.");

[proc,.trademain_2011](string $name)
.runclientscript("interface_inv_init_big(trademain:com_31, tradeoffer, 4, 7, 0, -1, \"Remove\", \"Remove-5\", \"Remove-10\", \"Remove-All\", \"Remove-X\", \"\", \"\", \"\", \"\")");
.if_setevents(trademain:com_31, 0, 27, ~inv_ops(^if_op1, ^if_op2, ^if_op3, ^if_op4, ^if_op5, ^no_op, ^no_op, ^no_op, ^no_op, ^if_op10), 0, 0, ^false, ^false);
.runclientscript("interface_invother_init_big(trademain:com_34, tradeoffer, 4, 7, 0, -1, \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"Examine\<col=ff9040>\")");
.if_setevents(trademain:com_34, 0, 27, ~inv_ops(^no_op, ^no_op, ^no_op, ^no_op, ^no_op, ^no_op, ^no_op, ^no_op, ^if_op9, ^no_op), 0, 0, ^false, ^false);
.runclientscript("interface_inv_init_big(tradeside:com_0, inv, 4, 7, 0, -1, \"Offer\", \"Offer-5\", \"Offer-10\", \"Offer-All\", \"Offer-X\", \"\", \"\", \"\", \"\")");
.if_setevents(tradeside:com_0, 0, 27, ~inv_ops(^if_op1, ^if_op2, ^if_op3, ^if_op4, ^if_op5, ^no_op, ^no_op, ^no_op, ^no_op, ^if_op10), 0, 0, ^false, ^false);
.sendvarc_str(203, $name);
.%offer_modified = 0;
.%other_offer_modified = 0;
if_settext(trademain:com_21, "has <tostring(.inv_freespace(inv))> free inventory slots.");

// 2011: what each offer is worth, under "Wealth transfer:" (varc 729 the
// player's own, 697 the other's; clientscript 4105). The 2011 wiki prices it
// by the Grand Exchange, which this server has not: an obj's cost stands in,
// as at void-634. Past what an int holds it is the most one does, which the
// client shows as too much to show.
[proc,trade_wealth]
def_int $mine = ~trade_offer_worth;
def_int $theirs = ~.trade_offer_worth;
sendvarc(729, $mine);
sendvarc(697, $theirs);
.sendvarc(729, $theirs);
.sendvarc(697, $mine);

[proc,trade_offer_worth]()(int)
def_int $worth = 0;
def_int $slot = 0;
while ($slot < inv_size(tradeoffer)) {
    def_obj $obj = inv_getobj(tradeoffer, $slot);
    if ($obj ! null) {
        def_int $cost = oc_cost($obj);
        def_int $number = inv_getnum(tradeoffer, $slot);
        if ($cost > 0 & $number > calc((^max_32bit_int - $worth) / $cost)) {
            return(^max_32bit_int);
        }
        $worth = calc($worth + $cost * $number);
    }
    $slot = add($slot, 1);
}
return($worth);

[proc,.trade_offer_worth]()(int)
def_int $worth = 0;
def_int $slot = 0;
while ($slot < .inv_size(tradeoffer)) {
    def_obj $obj = .inv_getobj(tradeoffer, $slot);
    if ($obj ! null) {
        def_int $cost = oc_cost($obj);
        def_int $number = .inv_getnum(tradeoffer, $slot);
        if ($cost > 0 & $number > calc((^max_32bit_int - $worth) / $cost)) {
            return(^max_32bit_int);
        }
        $worth = calc($worth + $cost * $number);
    }
    $slot = add($slot, 1);
}
return($worth);

