// 289's trade on 2011's trade screens: trademain (335, both offers),
// tradeside (336, the backpack beside them) and tradeconfirm (334). 289's
// tradeoffer is inv 90 at 2011 too. 2011's client draws the offers and the
// backpack itself, as grids the server makes once a screen is open
// (clientscripts 150 and 695, as for the shop) with the ops the server
// enables (IF_SETEVENTS); the other player's offer is the same inv sent with
// the client's "other" flag. 289's components follow, commented, where
// 2011's replace them.
[proc,moveallinv](inv $src, inv $dest)
def_int $size = inv_size($src);
def_int $i = 0;
while ($i < $size) {
    def_obj $obj = inv_getobj($src, $i);
    if ($obj ! null) {
        inv_moveitem($src, $dest, $obj, inv_total($src, $obj));
    }
    $i = add($i, 1);
}

[proc,.moveallinv](inv $src, inv $dest)
def_int $size = .inv_size($src);
def_int $i = 0;
while ($i < $size) {
    def_obj $obj = .inv_getobj($src, $i);
    if ($obj ! null) {
        .inv_moveitem($src, $dest, $obj, .inv_total($src, $obj));
    }
    $i = add($i, 1);
}


