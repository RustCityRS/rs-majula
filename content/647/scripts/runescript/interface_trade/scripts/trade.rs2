[if_button5,trademain:com_31] @removefromtrade(last_slot, null);
// 2011: Examine on either offer.
[if_button10,trademain:com_31]
def_obj $obj = inv_getobj(tradeoffer, last_slot);
if ($obj ! null) {
    mes(oc_desc($obj));
}
[if_button9,trademain:com_34]
if (.finduid(%tradepartner) = true) {
    def_obj $obj = .inv_getobj(tradeoffer, last_slot);
    if ($obj ! null) {
