// 1578
[clientscript,letter_lj_settitle](component $component0, component $component1)
def_string $string0 = %varclient_1730;
def_int $int2 = if_getwidth($component0);
if (parawidth($string0, ^max_32bit_int, quill_oblique_large) > $int2) {
    while (parawidth("<$string0>...", ^max_32bit_int, quill_oblique_large) > $int2) {
        $string0 = substring($string0, 0, calc(string_length($string0) - 1));
    }
    $string0 = "<$string0>...";
    if_setonmouserepeat($component0, "addtooltip(event_com, $component1, %varclient_1730, 25, 5000)");
    if_setonmouseleave($component0, "deltooltip($component1)");
} else {
    if_setonmouserepeat($component0, null);
    if_setonmouseleave($component0, null);
}
if_settext($component0, $string0);
