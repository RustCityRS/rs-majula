[flowers]
desc=A posy of blue and purple flowers.
wearpos=righthand
weight=1oz
category=flowers
param=stabattack,-100
param=slashattack,-100
param=crushattack,-50
param=strengthbonus,-10
param=crushattack_anim,human_blunt_spike
// param=crush_sound,flower_attack -- void-634 lists no flower_attack and 647's synth.pack has no such name

