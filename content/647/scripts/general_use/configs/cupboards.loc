// The 2011 wiki keeps Morgan's garlic in drawers, not 289's cupboard (Garlic,
// 2011-05-01: "in the drawer in Morgan's house"; Vampire Slayer, 2011-05-09:
// "open the drawers and search the drawers"). Cache 786's map puts
// drawers_46250 (op1 Open) a tile north of 289's garliccupboardshut, at
// 1_48_51_24_5. Of 786's locs only drawers_12961 shares its four recolours;
// it is placed nowhere in the map and has 289's open garlic cupboard's ops
// (op1 Search, op2 Close). No source pairs the two: taking 12961 as 46250's
// open half is this port's reading. 289's ids 2612 and 2613 are nameless
// ground decoration in 786.
[drawers_46250]
category=cupboard_closed
param=cupboard_other,drawers_12961

[drawers_12961]
category=cupboard_opened
param=cupboard_other,drawers_46250

// 2011's cupboards on 289's cupboard spots (cache 786 map), named for 289's
// comments on those spots in cupboards.rs2: the Ranging Guild's cupboardhigh
// spot holds cupboard_37037 (op1 Open), whose next id, open_cupboard_37038, is
// an Open Cupboard with 289's ops (op2 Search, op3 Shut); the Exam Centre's
// cupboard spot holds cupboard_17302 (op1 Open), whose next id, cupboard_17303,
// has op1 Close and op2 Search. No source pairs them: each is taken to open
// into its next id, as searchables_2011.loc pairs 2011's drawers and chests.
// cupboard_37034, on the Fight Arena's and two other 289 cupboard spots, is
// left closed: its next id (37035) is another closed cupboard and the one
// before (37033) is nameless.
[cupboard_37037]
category=cupboard_closed
param=cupboard_other,open_cupboard_37038

[open_cupboard_37038]
category=cupboard_opened
param=cupboard_other,cupboard_37037

[cupboard_17302]
category=cupboard_closed
param=cupboard_other,cupboard_17303

[cupboard_17303]
category=cupboard_opened
param=cupboard_other,cupboard_17302
