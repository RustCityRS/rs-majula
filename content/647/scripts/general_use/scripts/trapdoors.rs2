// https://youtu.be/0lPiEWFcXTM?t=99
[oploc1,trapdoor_1568]
mes("The trapdoor opens...");
sound_synth(door_open, 1, 0);
// Temp note: dur does not need updated ? @indio
loc_change(trapdoor_open, 500);

// https://youtu.be/0lPiEWFcXTM?t=196
[oploc1,trapdoor_open]
mes("You climb down through the trapdoor...");
p_telejump(movecoord(coord(), 0, 0, 6400));

[oploc2,trapdoor_open]
mes("You close the trapdoor.");
sound_synth(door_close, 1, 0 );
// Temp note: dur does not need updated ? @indio
loc_change(trapdoor_1568, 500);

// 2011 placed its own trapdoors on 289's spots (void-634 trapdoors.objs.toml
// and its *.teles.toml give each one's climb). Edgeville's opens and closes as
// 289's did, between trapdoor_26933 and trapdoor_26934, and lands one tile
// short of 289's (y+6399). Lumbridge castle's, trapdoor_36687, is always open
// and lands two tiles west of 289's. Castle Wars' (trapdoor_36691) is always
// open too; void-634 gives it no climb, so it keeps 289's.
[oploc1,trapdoor_26933]
mes("The trapdoor opens...");
sound_synth(door_open, 1, 0);
loc_change(trapdoor_26934, 500);

[oploc1,trapdoor_26934]
mes("You climb down through the trapdoor...");
p_telejump(movecoord(coord(), 0, 0, 6399));

[oploc2,trapdoor_26934]
mes("You close the trapdoor.");
sound_synth(door_close, 1, 0);
loc_change(trapdoor_26933, 500);

[oploc1,trapdoor_36687]
mes("You climb down through the trapdoor...");
p_telejump(movecoord(coord(), -2, 0, 6400));

[oploc1,trapdoor_36691]
mes("You climb down through the trapdoor...");
p_telejump(movecoord(coord(), 0, 0, 6400));
