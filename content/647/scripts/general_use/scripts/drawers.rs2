[oploc1,_drawer]
// 2011: East Ardougne's upstairs drawers stand a tile from 289's (cache 786
// map: drawers 34482 at 1_40_51_15_62 and 1_40_51_50_60; 289's
// 1_40_51_14_62 and 1_40_51_51_60), so its riddles name 2011's.
if(map_members = ^true) {
    if(loc_coord = 1_40_51_15_62) {
        // two different clue scrolls share this location
        // - https://oldschool.runescape.wiki/w/Clue_scroll_(easy)_-_Search_the_drawers_found_upstairs_in_East_Ardougne%27s_houses
        // - https://oldschool.runescape.wiki/w/Clue_scroll_(medium)_-_In_a_town_where_the_guards_are_armed_with_maces
        if(inv_total(inv, trail_clue_easy_vague003) = 1) {
            @riddle_loc_easy_exp008;
        } else {
            @riddle_loc_medium_exp002;
        }
    } else if(loc_coord = 1_40_51_50_60) {
        @riddle_loc_medium_exp003;
    } else if(loc_coord = 0_42_54_21_22) {
        @riddle_loc_medium_exp004;
    } else if(loc_coord = 1_43_49_57_29) {
        @riddle_loc_medium_exp007;
    } else if(loc_coord = 0_45_55_41_57) {
        @riddle_loc_medium_exp008;
    }
}
p_arrivedelay;
anim(human_openchest,0);
loc_prefetchall(loc_coord, loc_param(drawer_other), loc_shape);
p_delay(0);
// todo - Sound
// Temp note: dur does not need updated
loc_change(loc_param(drawer_other), 300);

[oplocu,_drawer]
if(loc_coord = 1_40_51_15_62) {
    @riddle_loc_medium_exp002;
} else if(loc_coord = 1_40_51_50_60) {
    @riddle_loc_medium_exp003;
} else if(loc_coord = 0_42_54_21_22) {
    @riddle_loc_medium_exp004;
} else if(loc_coord = 1_43_49_57_29) {
    @riddle_loc_medium_exp007;
}  else if(loc_coord = 0_45_55_41_57) {
    @riddle_loc_medium_exp008;
}
~displaymessage(^dm_default);

// Most of 2011's open drawers (general_use/configs/searchables_2011.loc)
// search with op1 and shut with op2 where 289's used op2 and op3 (the rest
// keep 289's ops); they reach 289's bodies, which are labels for it.
[oploc1,_empty_drawer_2011] @empty_drawer_search;
[oploc2,_empty_drawer_2011] @empty_drawer_shut;

[oploc2,_empty_drawer] @empty_drawer_search;

[label,empty_drawer_search]
// Treasure Trail
if(map_members = ^true) {
    def_obj $clue = ~trail_getclue_inv;
    if($clue ! null & oc_param($clue, trail_loc) = ^true & oc_param($clue, trail_coord) = loc_coord) {
        @trail_clue_loc_interact($clue);
    }
}
if (random(^findsomethingnice_chance) = 0 & ~in_tutorial_island(coord) = false) { // complete guess
    mes("You search the drawers..."); // guess
    p_delay(2);
    ~findsomethingnice;
    return;
}
mes("The drawers are empty.");

[oploc3,_empty_drawer] @empty_drawer_shut;

[label,empty_drawer_shut]
p_arrivedelay;
anim(human_closechest,0);
loc_prefetchall(loc_coord, loc_param(drawer_other), loc_shape);
p_delay(0);
// todo - Sound
// Temp note: dur does not need updated
loc_change(loc_param(drawer_other), 300);
