// 1374
[proc,worldmap_showoverview](int $int0)
if ($int0 = 1) {
    if_sethide(worldmap:overviewframe, false);
    if_setop(worldmap:overviewtoggle, 1, "Hide overview");
} else {
    if_sethide(worldmap:overviewframe, true);
    if_setop(worldmap:overviewtoggle, 1, "Show overview");
}
if_setonop(worldmap:overviewtoggle, "worldmap_toggleoverview");
