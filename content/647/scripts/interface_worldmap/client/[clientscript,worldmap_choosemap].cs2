// 294
[clientscript,worldmap_choosemap](wma $wma0, component $component1, component $component2, component $component3, component $component4, component $component5)
sound_synth(interface_select1, 1, 0);
$wma0 = ~script2785($wma0);
if ($wma0 = worldmap_getcurrentmap) {
    ~worldmap_showmenu(false, $component1, $component2, $component3, $component4, $component5);
    return;
}
%worldmap_findtext = "";
~script308($component4);
~worldmap_overlay_clear($component5);
~deltooltip_action(worldmap:tooltip);
worldmap_setmap($wma0);
%worldmap_zoom = worldmap_getconfigzoom($wma0);
~worldmap_setzoom;
~worldmap_vartransmit_effects;
~worldmap_showmenu(false, $component1, $component2, $component3, $component4, $component5);
