// 334
[clientscript,worldmap_button](component $component0)
def_graphic $graphic1 = "toplevel_worldmap_button,1";
if (%varplayerbit_6090 = 1) {
    if_setgraphic($component0, "toplevel_worldmap_button,2");
    $graphic1 = "toplevel_worldmap_button,3";
    if_setonmouseover($component0, "graphic_swapper(event_com, $graphic1)");
    $graphic1 = "toplevel_worldmap_button,2";
    if_setonmouseleave($component0, "graphic_swapper(event_com, $graphic1)");
    if_clearops($component0);
    if_setop($component0, 1, "Daemonheim Map");
} else {
    if_setgraphic($component0, "toplevel_worldmap_button,0");
    if_setonmouseover($component0, "graphic_swapper(event_com, $graphic1)");
    $graphic1 = "toplevel_worldmap_button,0";
    if_setonmouseleave($component0, "graphic_swapper(event_com, $graphic1)");
    if_clearops($component0);
    if_setop($component0, 1, "World Map");
    if (%playerdesign2_col ! null & %playerdesign2_col ! 0_0_0_0_0) {
        if_setop($component0, 2, "Clear your marker");
    }
}
