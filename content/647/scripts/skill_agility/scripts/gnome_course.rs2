[oploc1,gnome_log_balance1]
~gnome_trainer_say("Okay get over that log, quick quick!");
p_arrivedelay;
mes("You walk carefully across the slippery log...");
sound_synth(log_balance, 4, 0);
~agility_force_move(75, human_walk_logbalance, movecoord(coord, 0, 0, -7));
mes("...You make it safely to the other side.");
~update_gnome_varp(1);

[oploc1,obstical_net2]
if(coordz(coord) <= coordz(loc_coord)) {
    mes("You can not do that from here.");
    return;
}
mes("You climb the netting...");
~gnome_trainer_say("Move it, move it, move it!");
p_arrivedelay;
~agility_climb_up(75, movecoord(coord, 0, 1, -2));
~update_gnome_varp(2);

[oploc1,climbing_branch_low]
mes("You climb the tree..");
~gnome_trainer_say("That's it - straight up");
p_arrivedelay;
~agility_climb_up(50, movecoord(loc_coord, 0, 1, -2));
mes("...To the platform above.");
~update_gnome_varp(3);

[oploc1,balancing_rope]
p_arrivedelay;
mes("You carefully cross the tightrope.");
~gnome_trainer_say("Come on scaredy cat, get across that rope!");
sound_synth(tightrope, 5, 0);
~agility_force_move(75, human_walk_logbalance, movecoord(coord, 6, 0, 0));
~update_gnome_varp(4);

[oploc1,climbing_tree] @climbdown_gnome_tree_branch;
[oploc1,climbing_tree2] @climbdown_gnome_tree_branch;

[label,climbdown_gnome_tree_branch]
mes("You climb down the tree...");
p_arrivedelay;
~agility_climb_up(50, 0_38_53_55_28);
mes("You land on the ground.");
~update_gnome_varp(5);

[oploc1,obstical_net3]
if(coordz(coord) >= coordz(loc_coord)) {
    mes("You can not do that from here.");
    return;
}
mes("You climb the netting...");
~gnome_trainer_say("My Granny can move faster than you.");
p_arrivedelay;
~agility_climb_up(75, movecoord(coord, 0, 0, 2));
~update_gnome_varp(6);

[oploc1,lfm_lava_pipes_floor_01]
if(coordz(coord) > coordz(loc_coord)) {
    mes("You can't enter the pipe from this side.");
    return;
}
// Enter tube
~forcewalk2(movecoord(loc_coord, 0, 0, -1));
if(%gnome_obstacle_pipe_used >= map_clock) {
    mes("The pipe is being used"); 
    return;
}
%gnome_obstacle_pipe_used = calc(map_clock + 12);
@enter_gnome_obstacle_pipe;

[oploc1,hla_pipe_right]
if(coordz(coord) > coordz(loc_coord)) {
    mes("You can't enter the pipe from this side.");
    return;
}
// Enter tube
~forcewalk2(movecoord(loc_coord, 0, 0, -1));
if(%gnome_obstacle_pipe_used2 >= map_clock) {
    mes("The pipe is being used"); 
    return;
}
%gnome_obstacle_pipe_used2 = calc(map_clock + 12);
@enter_gnome_obstacle_pipe;

// 289's two pipes (its loc_154 and its gnome_obstacle_pipe, 4058) are not on
// 2011's map; 2011's are 43543 (gnome_obstacle_pipe above, 2487,3431) and 43544
// west of it (2483,3431), void-634's gnome_obstacle_pipe_east and _west. 289
// gives each pipe a timer; this one takes loc_154's.
[oploc1,hla_pipe_left]
if(coordz(coord) > coordz(loc_coord)) {
    mes("You can't enter the pipe from this side.");
    return;
}
// Enter tube
~forcewalk2(movecoord(loc_coord, 0, 0, -1));
if(%gnome_obstacle_pipe_used >= map_clock) {
    mes("The pipe is being used"); 
    return;
}
%gnome_obstacle_pipe_used = calc(map_clock + 12);
@enter_gnome_obstacle_pipe;

[label,enter_gnome_obstacle_pipe]
~agility_exactmove(human_doublepipesqueeze, 30, 3, movecoord(loc_coord, 0, 0, -1), movecoord(loc_coord, 0, 0, 2), 30, 126, ^exact_north, true);
// 289's squeeze_in: 2011's id is not known (no byte match, and the animation carries none)
p_delay(2);
p_teleport(movecoord(coord, 0, 0, 1));
p_delay(0);
~change_merged_loc(movecoord(coord, 0, 0, 1));
~agility_exactmove(human_doublepipesqueeze, 30, 3, coord, movecoord(coord, 0, 0, 3), 30, 126, ^exact_north, true);
// 289's squeeze_in: 2011's id is not known (no byte match, and the animation carries none)
// 289 pays with stat_advance, here and below; 2011's xp counter
// counts what ~givexp pays (player/scripts/xp.rs2).
~givexp(agility, 75);
~update_gnome_varp(7);

[proc,gnome_trainer_say](string $line)
if(npc_find(coord, gnometrainer, 5, 0) = true) {
    npc_say($line);
}

[proc,update_gnome_varp](int $completed)
if(calc(%gnome_course_progress + 1) >= $completed) {
    %gnome_course_progress = $completed;
}
if(%gnome_course_progress = 7) {
    ~givexp(agility, 390);
    %gnome_course_progress = 0;
}
