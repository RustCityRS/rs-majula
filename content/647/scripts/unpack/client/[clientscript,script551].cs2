// 551
[clientscript,script551]
if (%lotg_connectors_2 = 15) {
    sound_synth(lotg_fairyring_adjust_max, 1, 0);
    return;
}
%lotg_connectors_2 = calc(%lotg_connectors_2 + 1);
def_int $int0 = calc((15 - %lotg_connectors_2) * 6);
if_setposition(lotg_fairy_ring_power_interface:meter_2, 0, $int0, ^setpos_abs_left, ^setpos_abs_top);
if_settext(lotg_fairy_ring_power_interface:counter2, tostring(%lotg_connectors_2));
sound_synth(lotg_fairyring_adjust, 1, 0);
