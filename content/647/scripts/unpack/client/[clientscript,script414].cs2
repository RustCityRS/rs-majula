// 414
[clientscript,script414](component $component0)
if_setcolour(conq_scroll_overlay:arrow_top, ^black);
if_setcolour(conq_scroll_overlay:arrow_bottom, ^black);
if_setcolour(conq_scroll_overlay:arrow_left, ^black);
if_setcolour(conq_scroll_overlay:arrow_right, ^black);
if_setcolour(conq_scroll_overlay:arrow_top_right, ^black);
if_setcolour(conq_scroll_overlay:arrow_bottom_right, ^black);
if_setcolour(conq_scroll_overlay:arrow_top_left, ^black);
if_setcolour(conq_scroll_overlay:arrow_bottom_left, ^black);
switch_component ($component0) {
    case conq_scroll_overlay:top :
        if_sethide(conq_scroll_overlay:arrow_top, false);
    case conq_scroll_overlay:bottom :
        if_sethide(conq_scroll_overlay:arrow_bottom, false);
    case conq_scroll_overlay:left :
        if_sethide(conq_scroll_overlay:arrow_left, false);
    case conq_scroll_overlay:right :
        if_sethide(conq_scroll_overlay:arrow_right, false);
    case conq_scroll_overlay:top_right_r :
        if_sethide(conq_scroll_overlay:arrow_top_right, false);
    case conq_scroll_overlay:top_right_t :
        if_sethide(conq_scroll_overlay:arrow_top_right, false);
    case conq_scroll_overlay:bottom_right_r :
        if_sethide(conq_scroll_overlay:arrow_bottom_right, false);
    case conq_scroll_overlay:bottom_right_b :
        if_sethide(conq_scroll_overlay:arrow_bottom_right, false);
    case conq_scroll_overlay:top_left_l :
        if_sethide(conq_scroll_overlay:arrow_top_left, false);
    case conq_scroll_overlay:top_left_t :
        if_sethide(conq_scroll_overlay:arrow_top_left, false);
    case conq_scroll_overlay:bottom_left_l :
        if_sethide(conq_scroll_overlay:arrow_bottom_left, false);
    case conq_scroll_overlay:bottom_left_b :
        if_sethide(conq_scroll_overlay:arrow_bottom_left, false);
}
