// 337
[proc,script337](int $int0, int $int1)
if_settext(toplevel:xpsplat_text, "<tostring_localised($int0, true)><col=ffffff>(<tostring($int1)>+)</col>xp");
if_settext(toplevel_fullscreen:xpsplat_text, "<tostring_localised($int0, true)><col=ffffff>(<tostring($int1)>+)</col>xp");
if_setontimer(toplevel:xpbaselayer, "script3369(toplevel:xpbaselayer, clientclock)");
if_setontimer(toplevel_fullscreen:xpbaselayer, "script3370(toplevel_fullscreen:xpbaselayer, clientclock)");
