// 776
[proc,script776]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_string $string0 = "Hello";
def_string $string1 = "00:00";
def_string $string2 = "1.1x";
if (%doublexp_setupflag = 1) {
    $int0 = calc(%doublexp_timetotal / 60);
    $int1 = calc(%doublexp_timetotal % 60);
    $int2 = calc(~script338(16) / 1000);
    $int3 = calc(~script338(16) % 1000 / 100);
    if ($int1 < 10) {
        if ($int0 < 10) {
            $string1 = "0<tostring($int0)>:0<tostring($int1)>";
        } else {
            $string1 = "<tostring($int0)>:0<tostring($int1)>";
        }
    } else if ($int0 < 10) {
        $string1 = "0<tostring($int0)>:<tostring($int1)>";
    } else {
        $string1 = "<tostring($int0)>:<tostring($int1)>";
    }
    $string2 = "<tostring($int2)>.<tostring($int3)>x";
    $string0 = "Multiplier:<col=ff0000><$string2></col><br>Elapsed:<col=ff0000><$string1></col><br>Bonus:<col=ff0000><tostring(calc(%doublexp_runningtotal / 10))>xp</col>";
    if_setonmouserepeat(toplevel_fullscreen:xptotallayer, "addtooltip(toplevel_fullscreen:xptotallayer, toplevel_fullscreen:xptooltip, $string0, 0, 500)");
    if_setonmouseleave(toplevel_fullscreen:xptotallayer, "deltooltip(toplevel_fullscreen:xptooltip)");
    if_setonmouserepeat(toplevel:xptotallayer, "addtooltip(toplevel:xptotallayer, toplevel:xptooltip, $string0, 0, 500)");
    if_setonmouseleave(toplevel:xptotallayer, "deltooltip(toplevel:xptooltip)");
}
