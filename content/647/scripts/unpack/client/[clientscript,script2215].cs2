// 2215
[clientscript,script2215]
if (if_gety(easter10_nuts:bar) < 180) {
    if_setontimer(easter10_nuts:content, "script2215");
    if_setposition(easter10_nuts:bar, if_getx(easter10_nuts:bar), calc(2 + if_gety(easter10_nuts:bar)), ^setpos_abs_left, ^setpos_abs_top);
} else {
    %easter10_pushbarstatus = 0;
}
