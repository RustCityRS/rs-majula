    ~loginscreen_setactivemenu(5);
    if (%varclient_1273 = true) {
        return;
    } else {
        if_setontimer(south_progress9:login_button, "login_delay(south_progress9:login_button, 0)");
    }
} else if (~userflowflags(3) = true) {
