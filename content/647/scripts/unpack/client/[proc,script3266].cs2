// 3266
[proc,script3266](int $int0)(int, int)
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
if ($int0 = 0 & %rand_deaths ! 0) {
    return(1, 0);
}
while ($int1 < min(calc(%rand_deaths - 1), 15)) {
    $int2 = calc($int2 + (22 - $int3));
    $int3 = min(calc($int3 + 3), 19);
    if ($int0 = $int2) {
        return(1, calc($int1 + 1));
