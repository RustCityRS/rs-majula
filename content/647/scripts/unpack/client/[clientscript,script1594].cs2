    if (~cc_gety_absolute < scale(3, 5, 261)) {
        ~aif_tooltip($component0, $component1, $int2, $string0, 120, verdana_11pt_regular, verdana_11pt_regular, ^white, 13, 4, 2, $int3, $int4);
    } else {
        ~aif_tooltip($component0, $component1, $int2, $string0, 120, verdana_11pt_regular, verdana_11pt_regular, ^white, 13, 4, 0, $int3, $int4);
