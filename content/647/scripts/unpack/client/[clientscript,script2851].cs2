// 2851
[clientscript,script2851](component $component0, int $key1, int $int2)
if (if_gethide(machinima_livecamera:chattop) = false) {
    if ($key1 = ^key_f2) {
        ~script835(true);
    }
    return;
}
if (clientclock > calc($int2 + 5) | %machinima_livecamera_targetmode = 2) {
    switch_int (map_lang) {
        case 2 :
            switch_int ($key1) {
                case ^key_f2 :
                    ~script835(false);
                case ^key_f6 :
                    ~script3455;
                case ^key_f7 :
                    ~script3453;
                case ^key_f8 :
                    ~script3456;
                case ^key_e :
                    ~machinima_camera_up;
                case ^key_r :
                    ~machinima_camera_north;
                case ^key_t :
                    ~machinima_camera_down;
                case ^key_d :
                    ~machinima_camera_west;
                case ^key_f :
                    ~machinima_camera_south;
                case ^key_g :
                    ~machinima_camera_east;
