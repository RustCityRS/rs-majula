                    ~script2860;
                case ^key_down :
                    ~script2861;
                case ^key_left :
                    ~script2863;
                case ^key_right :
                    ~script2862;
                case ^key_escape :
                    ~script675;
                case ^key_f1 :
                    ~script3455;
                    if (%machinima_livecamera_targetmode = 0) {
                        %machinima_livecamera_targetmode = 1;
                        if_setgraphic(machinima_livecamera:mode_icon, "catcon_catapult_icons,9");
                        if_settext(machinima_livecamera:message_text, "You are now in Focus Mode");
                        if (if_gethide(machinima_livecamera:com_54) = false) {
                            if_sethide(machinima_livecamera:com_54, true);
                            if_sethide(machinima_livecamera:com_33, false);
                            if_sethide(machinima_livecamera:com_100, true);
                            if_sethide(machinima_livecamera:storemovie, false);
                        }
                    } else if (%machinima_livecamera_targetmode = 2) {
                        %machinima_livecamera_targetmode = 0;
                        if_setgraphic(machinima_livecamera:mode_icon, "catcon_catapult_icons,8");
                        if_settext(machinima_livecamera:message_text, "You are now in Aim Mode");
                        if (if_gethide(machinima_livecamera:com_100) = false) {
                            if_sethide(machinima_livecamera:com_33, true);
                            if_sethide(machinima_livecamera:com_54, false);
                            if_sethide(machinima_livecamera:com_100, true);
                            if_sethide(machinima_livecamera:storemovie, false);
                        }
                    } else {
                        %machinima_livecamera_targetmode = 2;
                        if_setgraphic(machinima_livecamera:mode_icon, "catcon_catapult_icons,7");
                        if_settext(machinima_livecamera:message_text, "You are now in Fine Control Mode");
                        if (if_gethide(machinima_livecamera:com_33) = false) {
