            }
        case default :
            switch_int ($key1) {
                case ^key_f2 :
                    ~script835(false);
                case ^key_f6 :
                    ~script3455;
                case ^key_f7 :
                    ~script3453;
                case ^key_f8 :
                    ~script3456;
                case ^key_q :
                    ~machinima_camera_up;
                case ^key_w :
                    ~machinima_camera_north;
                case ^key_e :
                    ~machinima_camera_down;
                case ^key_a :
                    ~machinima_camera_west;
                case ^key_s :
                    ~machinima_camera_south;
