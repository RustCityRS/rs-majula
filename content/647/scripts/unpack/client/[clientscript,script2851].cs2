                            if_sethide(machinima_livecamera:com_54, true);
                            if_sethide(machinima_livecamera:com_100, false);
                            if_sethide(machinima_livecamera:storemovie, true);
                        }
                    }
                    if_setontimer($component0, "script2853($component0, clientclock)");
                case ^key_space :
                    if (%machinima_livecamera_targetmode = 0) {
                        if (if_gethide(machinima_livecamera:com_54) = true) {
                            if_sethide(machinima_livecamera:com_54, false);
                            if_sethide(machinima_livecamera:com_33, true);
                            if_sethide(machinima_livecamera:com_100, true);
