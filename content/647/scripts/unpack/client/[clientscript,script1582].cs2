// 1582
[clientscript,script1582](component $component0, component $component1)
def_string $string0 = %hvh_opp_name;
def_int $int2 = if_getwidth($component0);
if (parawidth("<$string0> ", ^max_32bit_int, p12_full) > $int2) {
    while (parawidth("<$string0>... ", ^max_32bit_int, p12_full) > $int2) {
        $string0 = substring($string0, 0, calc(string_length($string0) - 1));
    }
    $string0 = "<$string0>...";
    if_setonmouserepeat($component0, "addtooltip(event_com, $component1, %hvh_opp_name, 25, 5000)");
    if_setonmouseleave($component0, "deltooltip($component1)");
} else {
    if_setonmouserepeat($component0, null);
    if_setonmouseleave($component0, null);
}
if_settext($component0, $string0);
