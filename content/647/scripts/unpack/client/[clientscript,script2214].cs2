// 2214
[clientscript,script2214]
if (%easter10_pushbarstatus = 1) {
    if (if_getx(%easter10_currentmodel) < 256) {
        if_setposition(%easter10_currentmodel, calc(1 + if_getx(%easter10_currentmodel)), if_gety(%easter10_currentmodel), ^setpos_abs_left, ^setpos_abs_top);
    }
    if (if_getx(%easter10_currentmodel) > 256) {
        if_setposition(%easter10_currentmodel, calc(if_getx(%easter10_currentmodel) - 1), if_gety(%easter10_currentmodel), ^setpos_abs_left, ^setpos_abs_top);
    }
    if (if_gety(easter10_nuts:bar) > 70) {
        if_setposition(%easter10_currentmodel, if_getx(%easter10_currentmodel), calc(if_gety(%easter10_currentmodel) - 2), ^setpos_abs_left, ^setpos_abs_top);
        if_setposition(easter10_nuts:bar, if_getx(easter10_nuts:bar), calc(if_gety(easter10_nuts:bar) - 2), ^setpos_abs_left, ^setpos_abs_top);
        if_setontimer(easter10_nuts:content, "script2214");
    } else {
        if_sethide(%easter10_currentmodel, true);
        if_setontimer(easter10_nuts:content, "script2215");
    }
}
