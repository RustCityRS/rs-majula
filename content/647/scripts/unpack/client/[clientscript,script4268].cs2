        } else {
            if_settext(lunarfm_rewards_new:extra_info, "Learned!");
        }
    case 5 :
        if (%lunarfm_spells_unlocked < 5) {
            if_settext(lunarfm_rewards_new:extra_info, "Requires level 80 Magic to cast. You must unlock the spells in order.");
        } else {
            if_settext(lunarfm_rewards_new:extra_info, "Learned!");
        }
    case 6 :
        if (%lunarfm_spells_unlocked < 6) {
            if_settext(lunarfm_rewards_new:extra_info, "Requires level 83 Magic to cast. You must unlock the spells in order.");
        } else {
            if_settext(lunarfm_rewards_new:extra_info, "Learned!");
        }
    case 7 :
        if (%lunarfm_spells_unlocked < 7) {
            if_settext(lunarfm_rewards_new:extra_info, "Requires level 90 Magic to cast. You must unlock the spells in order.");
        } else {
            if_settext(lunarfm_rewards_new:extra_info, "Learned!");
        }
    case 8 :
        if (%lunarfm_spells_unlocked < 8) {
            if_settext(lunarfm_rewards_new:extra_info, "Requires level 95 Magic to cast. You must unlock the spells in order.");
        } else {
            if_settext(lunarfm_rewards_new:extra_info, "Learned!");
        }
    case default :
        if (%lunarfm_spells_unlocked < 8) {
            if_settext(lunarfm_rewards_new:extra_info, "You must unlock all the spells before you can use wishes.");
        }
}
if ($int0 < 9) {
    if_sethide(lunarfm_rewards_new:spell_icon_layer, false);
} else {
    if_sethide(lunarfm_rewards_new:spell_icon_layer, true);
}
