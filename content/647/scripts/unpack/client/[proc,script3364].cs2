def_int $int12 = 0;
def_int $int13 = 0;
def_int $int14 = 0;
def_component $component15 = null;
if ($int1 = -1 & if_find($component0) = true | cc_find($component0, $int1) = true) {
    if (%tooltip_time < calc(clientclock + $int3)) {
        if (%tooltip_time < clientclock) {
            %tooltip_time = clientclock;
        }
        %tooltip_time = calc(%tooltip_time + 2);
