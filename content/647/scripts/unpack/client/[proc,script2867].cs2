// 2867
[proc,script2867](coord $coord0, coord $coord1)(int)
if ($coord0 = $coord1) {
    return(0);
}
if (calc(coordx($coord0) - coordx($coord1)) > calc(2 * ((coordz($coord0) - coordz($coord1)) * -1))) {
    if (calc(coordx($coord0) - coordx($coord1)) > calc(2 * (coordz($coord0) - coordz($coord1)))) {
        return(7);
    } else if (calc(2 * (coordx($coord0) - coordx($coord1))) > calc(coordz($coord0) - coordz($coord1))) {
        return(6);
    } else if (calc(2 * (coordx($coord0) - coordx($coord1))) > calc((coordz($coord0) - coordz($coord1)) * -1)) {
        return(5);
    } else {
        return(4);
    }
} else if (calc(coordx($coord0) - coordx($coord1)) > calc(2 * (coordz($coord0) - coordz($coord1)))) {
    if (calc(2 * (coordx($coord0) - coordx($coord1))) > calc(coordz($coord0) - coordz($coord1))) {
        if (calc(2 * (coordx($coord0) - coordx($coord1))) > calc((coordz($coord0) - coordz($coord1)) * -1)) {
            return(8);
        } else {
            return(1);
        }
    } else {
        return(2);
    }
} else {
    return(3);
}
