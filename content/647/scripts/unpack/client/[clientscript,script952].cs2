// 952
[clientscript,script952]
switch_int (%rand_ready_state_player3) {
    case 0 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player3, 0xffb400);
    case 1 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player3, ^green);
    case 2 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player3, ^red);
}
