// 1126
[clientscript,script1126](component $component0)
%autocast_over_xp_button = 0;
switch_component ($component0) {
    case magic:com_2 :
        ~deltooltip_action(magic:tooltip2);
        if (%autocast_defmode = 0) {
            if_setgraphic($component0, "magic_icon_set,0");
        }
    case magic_zaros:com_18 :
        ~deltooltip_action(magic_zaros:tooltip2);
        if (%autocast_defmode = 0) {
            if_setgraphic($component0, "magic_icon_set,0");
        }
    case magic_lunar:com_20 :
        ~deltooltip_action(magic_lunar:tooltip2);
        if (%autocast_defmode = 0) {
            if_setgraphic($component0, "magic_icon_set,0");
        }
    case rand_magic:com_2 :
        ~deltooltip_action(rand_magic:tooltip2);
        if (%autocast_defmode = 0) {
            if_setgraphic($component0, "magic_icon_set,0");
        }
}
