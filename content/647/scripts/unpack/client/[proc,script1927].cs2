// 1927
[proc,script1927](component $component0)
def_int $int1 = 1;
while ($int1 <= 6) {
    if ($int1 = enum(component, int, enum_2027, $component0) | $int1 = %sc_client_selected_reward) {
        if_sethide(enum(int, component, enum_2031, $int1), false);
        if_setcolour(enum(int, component, enum_2030, $int1), ^white);
        if_setcolour(enum(int, component, enum_2029, $int1), ^white);
    } else {
        if_sethide(enum(int, component, enum_2031, $int1), true);
        if_setcolour(enum(int, component, enum_2030, $int1), 0xc8aa64);
        if_setcolour(enum(int, component, enum_2029, $int1), 0xc8aa64);
