// 1700
[proc,script1700]
if (%prayer_stats_if_visible = 1) {
    if_settext(prayer:com_12, "Hide stat adjustments.");
    if_setop(prayer:com_12, 1, "Hide stat adjustments");
} else {
    if_settext(prayer:com_12, "Show stat adjustments.");
    if_setop(prayer:com_12, 1, "Show stat adjustments");
}
