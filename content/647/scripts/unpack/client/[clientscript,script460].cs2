// 460
[clientscript,script460](component $component0)
if (stat_base(strength) < 25) {
    if_settext($component0, "<col=c80000>A Strength level of <tostring(25)> is required.</col>");
} else if (%varplayerbit_2086 < 1) {
    if_settext($component0, "<col=c80000>1 Commendation required.</col>");
} else {
    if_settext($component0, "<tostring(calc(pow(stat_base(strength), 2) / 600 * 35))> XP per Commendation.");
}
