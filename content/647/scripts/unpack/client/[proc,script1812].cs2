// 1812
[proc,script1812](string $string0, component $component0)
if (string_length($string0) = 0) {
    if_settext($component0, "");
    %clanwars_caller_lastusedstring = "";
    if_setontimer($component0, null);
    return;
}
if_settext($component0, $string0);
%clanwars_caller_lastusedstring = $string0;
