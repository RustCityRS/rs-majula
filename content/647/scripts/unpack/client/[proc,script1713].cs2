// 1713
[proc,script1713](stat $stat0)(int)
def_int $int1 = 0;
if (inv_getobj(worn, 2) = rand_reward_amulet_of_hopelessness) {
    $int1 = scale(stat_base($stat0), 100, 5);
}
switch_stat ($stat0) {
    case attack :
        if (%varplayerbit_6830 = 1) {
            return(~script1714(attack, ~script1718(attack, calc($int1 + 5))));
        }
    case strength :
        if (%varplayerbit_6834 = 1) {
            return(~script1714(strength, ~script1718(strength, calc($int1 + 5))));
        }
    case defence :
        if (%varplayerbit_6833 = 1) {
            return(~script1714(defence, ~script1718(defence, calc($int1 + 5))));
        }
    case ranged :
        if (%varplayerbit_6831 = 1) {
            return(~script1714(ranged, ~script1718(ranged, calc($int1 + 5))));
        }
    case magic :
        if (%varplayerbit_6832 = 1) {
            return(~script1714(magic, ~script1718(magic, calc($int1 + 5))));
        }
}
return(0);
