// 1135
[clientscript,script1135](component $component0)
def_coord $coord1 = ~coord_0_0(coord);
switch_int (%tutorial3_cutscene_tracker) {
    case default :
        cc_deleteall($component0);
        cam_smoothreset;
    case 1 :
        ~tutorial3_fadeout(^white, 50, $component0);
        sound_synth(dream_whiteout, 1, 0);
    case 2 :
        spline_new(0, 2);
        spline_new(1, 2);
        spline_addpoint(0, 0, ~dream_instance(25, 25, $coord1), 750, ~dream_instance(25, 25, $coord1), 750, 0);
        spline_addpoint(0, 1, ~dream_instance(25, 26, $coord1), 750, ~dream_instance(25, 26, $coord1), 750, 0);
        spline_addpoint(1, 0, ~dream_instance(25, 29, $coord1), 600, ~dream_instance(25, 29, $coord1), 600, 0);
        spline_addpoint(1, 1, ~dream_instance(25, 30, $coord1), 600, ~dream_instance(25, 30, $coord1), 600, 0);
        cam_movealong(0, 0, 100, 0, 1, 0);
        ~tutorial3_fadein(45, $component0);
        sound_synth(dream_whiteout, 1, 0);
    case 3 :
        spline_new(0, 7);
        spline_new(1, 7);
        spline_addpoint(0, 0, ~dream_instance(25, 26, $coord1), 750, ~dream_instance(25, 26, $coord1), 1200, 0);
        spline_addpoint(0, 1, ~dream_instance(16, 9, $coord1), 2175, ~dream_instance(18, 11, $coord1), 2175, 0);
        spline_addpoint(0, 2, ~dream_instance(31, 9, $coord1), 2275, ~dream_instance(31, 9, $coord1), 2450, 0);
        spline_addpoint(0, 3, ~dream_instance(39, 20, $coord1), 1950, ~dream_instance(39, 20, $coord1), 1950, 0);
        spline_addpoint(0, 4, ~dream_instance(40, 34, $coord1), 1550, ~dream_instance(40, 34, $coord1), 1550, 0);
        spline_addpoint(0, 5, ~dream_instance(31, 40, $coord1), 1125, ~dream_instance(31, 40, $coord1), 1125, 0);
        spline_addpoint(0, 6, ~dream_instance(24, 38, $coord1), 900, ~dream_instance(24, 38, $coord1), 900, 0);
        spline_addpoint(1, 0, ~dream_instance(25, 30, $coord1), 600, ~dream_instance(25, 30, $coord1), 600, 0);
        spline_addpoint(1, 1, ~dream_instance(25, 23, $coord1), 1150, ~dream_instance(25, 23, $coord1), 1150, 0);
        spline_addpoint(1, 2, ~dream_instance(25, 23, $coord1), 1150, ~dream_instance(25, 23, $coord1), 1150, 0);
        spline_addpoint(1, 3, ~dream_instance(25, 23, $coord1), 950, ~dream_instance(25, 23, $coord1), 950, 0);
        spline_addpoint(1, 4, ~dream_instance(25, 23, $coord1), 950, ~dream_instance(25, 23, $coord1), 950, 0);
        spline_addpoint(1, 5, ~dream_instance(25, 23, $coord1), 850, ~dream_instance(25, 23, $coord1), 850, 0);
        spline_addpoint(1, 6, ~dream_instance(26, 23, $coord1), 725, ~dream_instance(26, 23, $coord1), 725, 0);
        cam_movealong(0, 0, 800, 400, 1, 0);
    case 4 :
        if (spline_length(0) = 7) {
            cam_movealong(0, 1, 400, 400, 1, 1);
        } else {
            cam_smoothreset;
        }
    case 5 :
        if (spline_length(0) = 7) {
            cam_movealong(0, 2, 400, 400, 1, 2);
        } else {
            cam_smoothreset;
        }
    case 6 :
        if (spline_length(0) = 7) {
            cam_movealong(0, 3, 400, 400, 1, 3);
        } else {
            cam_smoothreset;
        }
    case 7 :
        if (spline_length(0) = 7) {
            cam_movealong(0, 4, 400, 600, 1, 4);
            if_setoncamfinished($component0, "script1144($component0)");
        } else {
            cam_smoothreset;
        }
    case 8 :
        ~tutorial3_fadein(50, $component0);
        sound_synth(dream_whiteout, 1, 0);
}
