if_sethide(conq_scroll_overlay:arrow_top, true);
if_sethide(conq_scroll_overlay:arrow_bottom, true);
if_sethide(conq_scroll_overlay:arrow_left, true);
if_sethide(conq_scroll_overlay:arrow_right, true);
