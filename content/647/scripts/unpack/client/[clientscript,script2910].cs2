// 2910
[clientscript,script2910](component $component0, component $component1)
if (compare(if_gettext($component1), "Hide") = 0) {
    if_setontimer($component0, "ii_resize_if(false, 24, calc(if_getheight(if_getlayer($component0)) - 24), 0, $component0)");
    if_settext($component1, "Show");
    if_setop($component1, 1, "Show");
} else {
    if_setontimer($component0, "ii_resize_if(true, 24, calc(if_getheight(if_getlayer($component0)) - 24), 0, $component0)");
    if_settext($component1, "Hide");
    if_setop($component1, 1, "Hide");
}
