// 555
[clientscript,script555]
def_int $int0 = calc((15 - %lotg_connectors_1) * 6);
if_setposition(lotg_fairy_ring_power_interface:meter_1, 0, $int0, ^setpos_abs_left, ^setpos_abs_top);
if_settext(lotg_fairy_ring_power_interface:counter1, tostring(%lotg_connectors_1));
$int0 = calc((15 - %lotg_connectors_2) * 6);
if_setposition(lotg_fairy_ring_power_interface:meter_2, 0, $int0, ^setpos_abs_left, ^setpos_abs_top);
if_settext(lotg_fairy_ring_power_interface:counter2, tostring(%lotg_connectors_2));
$int0 = calc((15 - %lotg_connectors_3) * 6);
if_setposition(lotg_fairy_ring_power_interface:meter_3, 0, $int0, ^setpos_abs_left, ^setpos_abs_top);
if_settext(lotg_fairy_ring_power_interface:counter3, tostring(%lotg_connectors_3));
