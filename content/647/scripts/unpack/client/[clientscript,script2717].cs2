// 2717
[clientscript,script2717](component $component0)
if (%shop_sample ! null) {
    ~script2726($component0, %shop_sample);
    if_setoninvtransmit($component0, "script2725($component0, %shop_sample){%shop_sample}");
    if_sethide(shop_template:main_title, false);
    if_sethide(shop_template:com_21, false);
}
