// 752
[clientscript,script752]
if (%varplayerbit_4534 = 0 & %varplayerbit_4290 = 0) {
    if_settext(lore_stats_side:animal_time_left, "---");
    return;
}
if (%varplayerbit_4290 = 0) {
    if_settext(lore_stats_side:animal_time_left, "<tostring(%varplayerbit_4534)>.00");
} else {
    if_settext(lore_stats_side:animal_time_left, "<tostring(%varplayerbit_4534)>.30");
}
