// 393
[clientscript,script393]
if_sethide(conq_side_turn:com_4, true);
if_sethide(conq_side_turn:time_left_layer, true);
if_settext(conq_side_turn:main_title_text, "Command Options");
if_setposition(conq_side_turn:gery_rectangle, 0, 133, ^setpos_abs_left, ^setpos_abs_top);
if_setsize(conq_side_turn:gery_rectangle, 190, 116, ^setsize_abs, ^setsize_abs);
if_settext(conq_side_turn:opponents_turn_text, "Comm Orb Recharging");
if_setposition(conq_side_turn:opponents_turn_text, 0, 133, ^setpos_abs_left, ^setpos_abs_top);
if_setsize(conq_side_turn:opponents_turn_text, 190, 116, ^setsize_abs, ^setsize_abs);
if_settextalign(conq_side_turn:opponents_turn_text, ^settextalign_centre, ^settextalign_centre, 0);
if_setposition(conq_side_turn:end_phase_button_layer, 30, 152, ^setpos_abs_left, ^setpos_abs_top);
if_setposition(conq_side_turn:end_turn_button_layer, 30, 200, ^setpos_abs_left, ^setpos_abs_top);
if_settext(conq_side_turn:end_turn_text, "Recharge");
if_setop(conq_side_turn:end_turn_text, 1, "Recharge");
if_setposition(conq_side_turn:confirm_end_text, 4, 148, ^setpos_abs_left, ^setpos_abs_top);
if_setposition(conq_side_turn:confirm_end_yes_layer, 15, 204, ^setpos_abs_left, ^setpos_abs_top);
if_setposition(conq_side_turn:confirm_end_no_layer, 105, 204, ^setpos_abs_left, ^setpos_abs_top);
if_sethide(conq_side_turn:opponents_turn_layer, true);
if_sethide(conq_side_diplomacy:com_5, true);
if_sethide(conq_side_diplomacy:com_6, true);
if_sethide(conq_side_diplomacy:ignore_truce_layer, true);
if_sethide(conq_side_diplomacy:truce_instructions, true);
if_settext(conq_side_diplomacy:main_title_text, "Retreat");
if_sethide(conq_side_diplomacy:offer_truce_button_layer, true);
if_settext(conq_side_diplomacy:resign_text, "Retreat");
if_setop(conq_side_diplomacy:resign_text, 1, "Retreat");
if_setposition(conq_side_diplomacy:resign_button_layer, 30, 0, ^setpos_abs_left, ^setpos_abs_centre);
if_setposition(conq_side_diplomacy:resign_instructions, 0, 50, ^setpos_abs_left, ^setpos_abs_centre);
if_settext(conq_side_diplomacy:resign_instructions, "Force Savant to teleport you to safety and order your remaining troops to fall back.");
