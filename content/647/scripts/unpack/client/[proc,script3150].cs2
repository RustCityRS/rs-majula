// 3150
[proc,script3150](component $component0, int $int1, string $string0)
if ($int1 < 0) {
    if_setonmouserepeat($component0, "script3151($component0, $int1, calc(clientclock + 25), $string0, event_mousex, event_mousey)");
} else if (cc_find($component0, $int1) = true) {
    cc_setonmouserepeat("script3151($component0, $int1, calc(clientclock + 25), $string0, event_mousex, event_mousey)");
}
