// 951
[clientscript,script951]
switch_int (%rand_ready_state_player2) {
    case 0 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player2, 0xffb400);
    case 1 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player2, ^green);
    case 2 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player2, ^red);
}
