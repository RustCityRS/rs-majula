// 2519
[clientscript,script2519](component $component0)
def_int $int1 = ~script2520;
switch_component ($component0) {
    case mob_special_units:minus_button1 :
        if (%mob_client_cannon_qty > 0) {
            %mob_client_cannon_qty = calc(%mob_client_cannon_qty - 1);
            if_settext(mob_special_units:quantity_field1, tostring(%mob_client_cannon_qty));
        }
    case mob_special_units:minus_button2 :
