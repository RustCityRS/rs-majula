// 399
[clientscript,script399](component $component0)
if (if_getx($component0) < calc(if_getwidth(easter09_nuts:content) - 1) | calc(if_gety($component0) - if_getheight($component0)) > 110) {
    if (if_getx($component0) = calc(140 + if_getwidth($component0))) {
        if_setontimer(easter09_nuts:control2, "script1550(easter09_nuts:model2)");
    }
    if_setposition($component0, calc(1 + if_getx($component0)), if_gety($component0), ^setpos_abs_left, ^setpos_abs_top);
} else {
    ~easter09_nuts_reset_model1;
}
