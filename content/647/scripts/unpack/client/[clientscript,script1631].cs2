// 1631
[clientscript,script1631]
if (%wtl_spline_step <= spline_length(0)) {
    %wtl_spline_step = calc(%wtl_spline_step + 1);
    switch_int (%wtl_spline_step) {
        case default :
            if_setoncamfinished(wtl_cutscenes:cutscene_controller, null);
        case 2, 4 :
            if_setoncamfinished(wtl_cutscenes:cutscene_controller, "script1631");
            cam_movealong(0, %wtl_spline_step, 200, 200, 1, %wtl_spline_step);
    }
} else {
    %wtl_spline_step = 0;
}
