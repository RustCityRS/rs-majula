// 4267
[proc,script4267]
def_int $int0 = calc(%lunarfm_produce_points * 10);
if_settext(lunarfm_rewards_new:current_points, ~tostring_spacer($int0, ","));
if (%lunarfm_spells_unlocked > 0) {
    if_setgraphic(lunarfm_rewards_new:spell_unlock_falador, null);
}
if (%lunarfm_spells_unlocked > 1) {
    if_setgraphic(lunarfm_rewards_new:spell_unlock_rune, null);
}
if (%lunarfm_spells_unlocked > 2) {
    if_setgraphic(lunarfm_rewards_new:spell_unlock_ardougne, null);
}
if (%lunarfm_spells_unlocked > 3) {
    if_setgraphic(lunarfm_rewards_new:spell_unlock_remote, null);
}
if (%lunarfm_spells_unlocked > 4) {
    if_setgraphic(lunarfm_rewards_new:spell_unlock_spirit, null);
}
if (%lunarfm_spells_unlocked > 5) {
    if_setgraphic(lunarfm_rewards_new:spell_unlock_leather, null);
}
if (%lunarfm_spells_unlocked > 6) {
    if_setgraphic(lunarfm_rewards_new:spell_unlock_shield, null);
}
if (%lunarfm_spells_unlocked > 7) {
    if_setgraphic(lunarfm_rewards_new:spell_unlock_vengeance, null);
    if_setgraphic(lunarfm_rewards_new:spell_unlock_rune, null);
    if_setgraphic(lunarfm_rewards_new:wish_unlock_seeds, null);
    if_setgraphic(lunarfm_rewards_new:wish_unlock_herbs, null);
    if_setgraphic(lunarfm_rewards_new:wish_unlock_vials, null);
    if_setgraphic(lunarfm_rewards_new:wish_unlock_runes, null);
    if_setgraphic(lunarfm_rewards_new:wish_unlock_burn, null);
    if_setgraphic(lunarfm_rewards_new:wish_unlock_planks, null);
}
