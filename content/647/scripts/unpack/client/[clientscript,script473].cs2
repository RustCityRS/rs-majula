// 473
[clientscript,script473](component $component0, int $int1)
if (stat_base(farming) < 25) {
    if_settext($component0, "<col=c80000>A Farming level of <tostring(25)> is required.</col>");
    return;
}
if (%varplayerbit_2086 < $int1) {
    if_settext($component0, "<col=c80000><tostring($int1)> Commendations required.</col>");
} else {
    if_settext($component0, "<tostring($int1)> Commendations.");
}
