// 934
[proc,script934](obj $obj0)(string)
def_string $string0 = "";
def_int $int1 = oc_param($obj0, param_742);
switch_int (oc_param($obj0, param_741)) {
    case 1 :
        if ($int1 = 1) {
            $string0 = "Rescued 1 dignitary in Recipe for Disaster";
        } else {
            $string0 = "Rescued <tostring($int1)> dignitaries in Recipe for Disaster";
        }
        return(~objreq_info_requirement(%hundred_subquest_tally, oc_param($obj0, param_742), $string0));
    case 2 :
        return(~objreq_info_requirement(%brut_smith_hasta, 2, "Barbarian spearmaking"));
    case 3 :
        return(~objreq_info_requirement(%dsd_quest, 10, "Complete: Chaos Tunnels"));
    case 4 :
        return(~objreq_info_requirement(%myreque_2_quest, 280, "Part of quest: In Aid of the Myreque"));
    case 5 :
        return(~objreq_info_requirement(%hundred_main_quest_var, 4, "Part of quest: Recipe for Disaster"));
    case 6 :
        return(~objreq_info_requirement(%slice_quest, 8, "Part of quest: Another Slice of H.A.M."));
    case 7 :
        return(~objreq_info_requirement(%elem_4_main, 7, "You need to complete the first puzzle in the Elemental Workshop IV Quest."));
    case default :
        return("");
}
