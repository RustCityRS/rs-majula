// 304
[proc,script304](coord $coord0)
if ($coord0 = null) {
    return;
}
sound_synth(interface_select1, 1, 0);
def_wma $wma1 = worldmap_getmap($coord0);
$wma1 = ~script2785($wma1);
if ($wma1 = null) {
    return;
}
~worldmap_overlay_clear(worldmap:worldmap_overlay);
%worldmap_findtext = "";
~script308(worldmap:findbox_text);
if_settext(worldmap:mapname, worldmap_getmapname($wma1));
~deltooltip_action(worldmap:tooltip);
worldmap_setmap_coord_override($wma1, $coord0);
worldmap_jumptosourcecoord($coord0);
%worldmap_zoom = worldmap_getconfigzoom($wma1);
~worldmap_setzoom;
~worldmap_vartransmit_effects;
