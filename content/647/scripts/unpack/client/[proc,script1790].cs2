// 1790
[proc,script1790](component $component0)
def_int $int1 = scale(3, 5, %clanwars_countdown_timer);
if ($int1 <= 3) {
    if_settext($component0, "<col=ff0000>GET READY!</col>");
    return;
}
def_int $int2 = calc($int1 / 60);
$int1 = calc($int1 % 60);
if ($int1 >= 10) {
    if_settext($component0, "<tostring($int2)>m <tostring($int1)>s");
} else {
    if_settext($component0, "<tostring($int2)>m 0<tostring($int1)>s");
}
