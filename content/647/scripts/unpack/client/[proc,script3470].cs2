// 3470
[proc,script3470](component $component0, coord $coord1)
switch_int (%tutorial3_cutscene_tracker) {
    case 1 :
        cc_deleteall($component0);
        ~tutorial3_fadeout(^black, 75, $component0);
    case 2 :
        spline_new(0, 5);
        spline_new(1, 5);
        spline_addpoint(0, 0, ~script3459(0_59_89_9_10, $coord1), 510, ~script3459(0_59_89_10_6, $coord1), 715, 0);
