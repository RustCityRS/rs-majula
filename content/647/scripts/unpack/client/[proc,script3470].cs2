        spline_addpoint(1, 1, ~script3459(0_59_89_40_15, $coord1), 170, ~script3459(0_59_89_43_21, $coord1), 170, 0);
        spline_addpoint(0, 2, ~script3459(0_59_89_40_42, $coord1), 2095, ~script3459(0_59_89_30_49, $coord1), 2095, 0);
        spline_addpoint(1, 2, ~script3459(0_59_89_31_30, $coord1), 170, ~script3459(0_59_89_24_32, $coord1), 170, 0);
        spline_addpoint(0, 3, ~script3459(0_59_89_10_40, $coord1), 1565, ~script3459(0_59_89_3_33, $coord1), 965, 0);
