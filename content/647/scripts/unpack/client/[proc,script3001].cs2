// 3001
[proc,script3001]
def_boolean $boolean0 = false;
def_int $int1 = 0;
def_int $int2 = 0;
def_string $string0 = "";
def_int $int3 = 0;
def_int $int4 = 0;
def_int $int5 = 0;
def_string $string1 = "";
def_string $string2 = "";
def_string $string3 = "";
$int1, $int2, $boolean0 = userdetail_lobby_membership;
if ($boolean0 = false & playermember = true) {
    $string0 = format_datetime_from_minutes($int1);
    $int3 = calc($int2 / 1440);
    $int4 = calc($int2 % 1440 / 60);
    $int5 = calc($int2 % 60);
    if (calc($int3 + $int4 + $int5) ! 0) {
        $string1 = " (in <~date_tostring($int3, $int4, $int5)>)";
    }
    $string2 = "Your membership will expire on <$string0><$string1>. Renew now to avoid losing member status. Click <col=0166ff><u=0166ff>here</u></col> to renew.";
    $string3 = "Your membership will expire on <$string0><$string1>. Renew now to avoid losing member status. Click <col=0296fe><u=0296fe>here</u></col> to renew.";
    if_settext(lobbyscreen_pane_playerinfo:circlesslide, $string2);
    if_setonmouseover(lobbyscreen_pane_playerinfo:circlesslide, "text_swapper(event_com, $string3)");
    if_setonmouseleave(lobbyscreen_pane_playerinfo:circlesslide, "text_swapper(event_com, $string2)");
}
def_int $int6 = userdetail_lobby_lastloginday;
if ($int6 = 0) {
    if_settext(lobbyscreen_pane_playerinfo:login_address, "Welcome to RuneScape!");
    return;
}
def_int $int7 = calc(date_runeday - $int6);
if ($int7 < 1) {
    if_settext(lobbyscreen_pane_playerinfo:login_address, "You last logged in earlier today from: <userdetail_lobby_lastloginaddress>");
} else if ($int7 = 1) {
    if_settext(lobbyscreen_pane_playerinfo:login_address, "You last logged in yesterday from: <userdetail_lobby_lastloginaddress>");
} else {
    if_settext(lobbyscreen_pane_playerinfo:login_address, "You last logged in <tostring($int7)> days ago from: <userdetail_lobby_lastloginaddress>");
}
