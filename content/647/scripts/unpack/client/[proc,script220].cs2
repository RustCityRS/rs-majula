// 220
[proc,script220]
~snapshot_update_select_button;
if (compare(%snapshot_name, "") = 0) {
    return;
}
%snapshot_mode = 2;
if_sethide(snapshot_main_v2:type_name_layer, true);
if_sethide(snapshot_main_v2:type_name_blackout_layer, true);
if_sethide(snapshot_main_v2:name_list_layer, true);
if_sethide(snapshot_main_v2:namelist_help_layer, true);
if_sethide(snapshot_main_v2:offence_help_layer, true);
if_sethide(snapshot_main_v2:honour_help_layer, true);
if_sethide(snapshot_main_v2:respect_help_layer, true);
if_sethide(snapshot_main_v2:security_help_layer, true);
if_sethide(snapshot_main_v2:ignore_help_layer, true);
if_sethide(snapshot_main_v2:offence_layer, false);
if_sethide(snapshot_main_v2:ignore_layer, true);
if_sethide(snapshot_main_v2:name_blackout_layer, true);
if_sethide(snapshot_main_v2:offence_blackout_layer, true);
if_sethide(snapshot_main_v2:ignore_blackout_layer, true);
