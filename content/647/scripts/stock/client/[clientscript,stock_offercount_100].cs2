// 600
[clientscript,stock_offercount_100]
if (%varplayer_1113 = 0) {
    if (%stock_offercount_visible <= 2147483547) {
        %stock_offercount_visible = calc(%stock_offercount_visible + 100);
    }
} else {
    %stock_offercount_visible = 100;
}
if_settext(stockmarket:offercount, tostring_localised(%stock_offercount_visible, true));
~sm_offercount_settimer;
