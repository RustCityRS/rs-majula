// 1561
[proc,chatdefault_openmeslayer]
def_string $string0 = chat_gethistorymessage(0);
def_int $int0 = 1;
def_int $int1 = 0;
def_string $string1 = "";
while ($int1 = 0 & $int0 < chat_gethistorylength) {
    $string1 = chat_gethistorymessage($int0);
    if (chat_gethistorytype($int0) ! ^chattype_gamemessage & chat_gethistorytype($int0) ! ^chattype_engine & chat_gethistorytype($int0) ! ^chattype_obj_examine & chat_gethistorytype($int0) ! ^chattype_npc_examine & chat_gethistorytype($int0) ! ^chattype_loc_examine & chat_gethistorytype($int0) ! ^chattype_snapshotfeedback & chat_gethistorytype($int0) ! ^chattype_friendnotification & chat_gethistorytype($int0) ! ^chattype_ignorenotification) {
        $int1 = 1;
    } else if (chat_getprevuid($int0) <= %last_meslayer_line_timestamp) {
        $int1 = 1;
    } else if (string_length(removetags($string1)) > 0) {
        $string0 = append(append($string1, "<br>"), $string0);
