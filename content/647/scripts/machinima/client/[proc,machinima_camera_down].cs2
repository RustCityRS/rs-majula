// 2859
[proc,machinima_camera_down]
if (%machinima_livecamera_height >= 100) {
    %machinima_livecamera_height = calc(%machinima_livecamera_height - 50);
}
if (%machinima_livecamera_lookatheight > %machinima_livecamera_height) {
    %machinima_livecamera_lookatheight = %machinima_livecamera_height;
}
