    case multi4:multi4a : return($ret1);
    case multi4:multi4b : return($ret2);
    case multi4:multi4c : return($ret3);
    case default : return($ret4);
}

// p_choice4 with the caller's header in place of "Select an Option" (289's signature).
[proc,p_choice4_header](string $string1, int $ret1, string $string2, int $ret2, string $string3, int $ret3, string $string4, int $ret4, string $headertext)(int)
