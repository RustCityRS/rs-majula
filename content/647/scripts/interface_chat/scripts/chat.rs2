// --- 5 options: interface 234 (multi5) ---
// Components: title=com1, line1=com2, line2=com3, line3=com4, line4=com5, line5=com6, thin_swords=com9, wide_swords=com10
[proc,p_choice5](string $string1, int $ret1, string $string2, int $ret2, string $string3, int $ret3, string $string4, int $ret4, string $string5, int $ret5)(int)
