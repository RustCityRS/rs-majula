// 289's choice labels (interface_chat/scripts/chat.rs2): ask, then jump to the
// label of the option picked.
[label,multi2](string $string1, label $label1, string $string2, label $label2)
def_int $choice = ~p_choice2($string1, 1, $string2, 2);
if ($choice = 1) jump($label1);
jump($label2);

[label,multi3](string $string1, label $label1, string $string2, label $label2, string $string3, label $label3)
def_int $choice = ~p_choice3($string1, 1, $string2, 2, $string3, 3);
if ($choice = 1) jump($label1);
if ($choice = 2) jump($label2);
jump($label3);

[label,multi4](string $string1, label $label1, string $string2, label $label2, string $string3, label $label3, string $string4, label $label4)
def_int $choice = ~p_choice4($string1, 1, $string2, 2, $string3, 3, $string4, 4);
if ($choice = 1) jump($label1);
if ($choice = 2) jump($label2);
if ($choice = 3) jump($label3);
jump($label4);

[label,multi5](string $string1, label $label1, string $string2, label $label2, string $string3, label $label3, string $string4, label $label4, string $string5, label $label5)
def_int $choice = ~p_choice5($string1, 1, $string2, 2, $string3, 3, $string4, 4, $string5, 5);
if ($choice = 1) jump($label1);
if ($choice = 2) jump($label2);
if ($choice = 3) jump($label3);
if ($choice = 4) jump($label4);
jump($label5);

[label,multi2_header](string $string1, label $label1, string $string2, label $label2, string $headertext)
def_int $choice = ~p_choice2_header($string1, 1, $string2, 2, $headertext);
if ($choice = 1) jump($label1);
jump($label2);

[label,multi3_header](string $string1, label $label1, string $string2, label $label2, string $string3, label $label3, string $headertext)
def_int $choice = ~p_choice3_header($string1, 1, $string2, 2, $string3, 3, $headertext);
if ($choice = 1) jump($label1);
if ($choice = 2) jump($label2);
jump($label3);

[label,multi4_header](string $string1, label $label1, string $string2, label $label2, string $string3, label $label3, string $string4, label $label4, string $headertext)
def_int $choice = ~p_choice4_header($string1, 1, $string2, 2, $string3, 3, $string4, 4, $headertext);
if ($choice = 1) jump($label1);
if ($choice = 2) jump($label2);
if ($choice = 3) jump($label3);
jump($label4);

[label,multi5_header](string $string1, label $label1, string $string2, label $label2, string $string3, label $label3, string $string4, label $label4, string $string5, label $label5, string $headertext)
def_int $choice = ~p_choice5_header($string1, 1, $string2, 2, $string3, 3, $string4, 4, $string5, 5, $headertext);
if ($choice = 1) jump($label1);
if ($choice = 2) jump($label2);
if ($choice = 3) jump($label3);
if ($choice = 4) jump($label4);
jump($label5);

// ── Convenience wrappers (auto-detect active NPC) ─────────────────────────

[proc,chatnpc](string $string)
split_init($string, 380, 4, q8_full)
def_int $page = 0
def_int $pagetotal = split_pagecount
while ($page < $pagetotal) {
    ~chatnpc_page(npc_name, npc_type, $page)
    facesquare(npc_coord)
    if (npc_getmode ! opplayer2 & npc_getmode ! applayer2) {
        npc_setmode(playerfaceclose)
    }
    p_pausebutton
    if_close
    $page = calc($page + 1)
}

// 289's chatnpcrange: chatnpc for an npc spoken to across a counter (a bank
// teller), who turns to the player from where it stands (playerface, not
// playerfaceclose) unless it is fighting. 2011's line width, as chatnpc.
[proc,chatnpcrange](string $string)
split_init($string, 380, 4, q8_full)
def_int $page = 0
def_int $pagetotal = split_pagecount
while ($page < $pagetotal) {
    ~chatnpc_page(npc_name, npc_type, $page)
    facesquare(npc_coord)
    if (npc_getmode ! opplayer2 & npc_getmode ! applayer2) {
        npc_setmode(playerface)
    }
    p_pausebutton
    if_close
    $page = calc($page + 1)
}

// 289's chatnpcnoturn: chatnpc for an npc that does not turn to the player
// (it carries on with its work); the player still faces it. 2011's line
// width, as chatnpc.
[proc,chatnpcnoturn](string $string)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~chatnpc_page(npc_name, npc_type, $page);
    facesquare(npc_coord);
    p_pausebutton;
    if_close;
    $page = calc($page + 1);
}

// 289's .chatnpc, .chatnpcrange and .chatnpcnoturn: the same three, spoken by
// the script's second npc (.npc), as when one npc answers for another.
[proc,.chatnpc](string $string)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~chatnpc_page(.npc_name, .npc_type, $page);
    facesquare(.npc_coord);
    if (.npc_getmode ! opplayer2 & .npc_getmode ! applayer2) {
        .npc_setmode(playerfaceclose);
    }
    p_pausebutton;
    if_close;
    $page = calc($page + 1);
}

[proc,.chatnpcrange](string $string)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~chatnpc_page(.npc_name, .npc_type, $page);
    facesquare(.npc_coord);
    if (.npc_getmode ! opplayer2 & .npc_getmode ! applayer2) {
        .npc_setmode(playerface);
    }
    p_pausebutton;
    if_close;
    $page = calc($page + 1);
}

[proc,.chatnpcnoturn](string $string)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~chatnpc_page(.npc_name, .npc_type, $page);
    facesquare(.npc_coord);
    p_pausebutton;
    if_close;
    $page = calc($page + 1);
}

// ── NPC chat with a model for a head ────────────────────────────────────────
// 289's chatnpc_model: an npc's chat box with a model id for its head, for a
// speaker that is no npc (a parrot on a shoulder, a scarecrow). 2011's npc
// chat boxes and line width, as chatnpc_page; the head is com2, as there.
// 289's callers pass 289's model ids: check each against cache 786 when they
// are ported.
[proc,chatnpc_model_page](string $npc_name, int $chathead, int $page)
def_int $lines = split_linecount($page);
if ($lines = 0) {
    // sanity check
    return;
} else if ($lines = 1) {
    if_setmodel(npcchat1:npcchat1head_1, $chathead);
    if_setanim(npcchat1:npcchat1head_1, split_getanim($page));
    if_settext(npcchat1:npcchat1name, $npc_name);
    if_settext(npcchat1:npcchat1a, split_get($page, 0));
    if_openchat(npcchat1);
} else if ($lines < 3) {
    if_setmodel(npcchat2:npcchat2head_1, $chathead);
    if_setanim(npcchat2:npcchat2head_1, split_getanim($page));
    if_settext(npcchat2:npcchat2name, $npc_name);
    if_settext(npcchat2:npcchat2a, split_get($page, 0));
    if_settext(npcchat2:npcchat2b, split_get($page, 1));
    if_openchat(npcchat2);
} else if ($lines = 3) {
    if_setmodel(npcchat3:npcchat3head_1, $chathead);
    if_setanim(npcchat3:npcchat3head_1, split_getanim($page));
    if_settext(npcchat3:npcchat3name, $npc_name);
    if_settext(npcchat3:npcchat3a, split_get($page, 0));
    if_settext(npcchat3:npcchat3b, split_get($page, 1));
    if_settext(npcchat3:npcchat3c, split_get($page, 2));
    if_openchat(npcchat3);
} else if ($lines = 4) {
    if_setmodel(npcchat4:npcchat4head_1, $chathead);
    if_setanim(npcchat4:npcchat4head_1, split_getanim($page));
    if_settext(npcchat4:npcchat4name, $npc_name);
    if_settext(npcchat4:npcchat4a, split_get($page, 0));
    if_settext(npcchat4:npcchat4b, split_get($page, 1));
    if_settext(npcchat4:npcchat4c, split_get($page, 2));
    if_settext(npcchat4:npcchat4d, split_get($page, 3));
    if_openchat(npcchat4);
}

[proc,chatnpc_model](string $npc_name, int $chathead, string $string)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~chatnpc_model_page($npc_name, $chathead, $page);
    p_pausebutton;
    if_close;
    $page = calc($page + 1);
}

// ── Cutscene NPC chat ───────────────────────────────────────────────────────
// 289's chatnc_cutscene: an npc's line during a cutscene. It waits for no
// click: each page opens in turn and the cutscene's own delays pace them.
// 289 shows it in inter_213, a four-line npc box with no "Click here to
// continue", a page of 1-2 lines on its middle two. 2011's npc boxes with no
// continue are npcchat_np1-4 (cache 786, 245-248: head com2, name com3,
// lines com4-7, and no continue component), one per line count as
// npcchat1-4 are, so a page takes the box of its line count. 2011's line
// width, as chatnpc.
[proc,chatnpc_cutscene_page](string $npc_name, npc $npc, int $page)
def_int $lines = split_linecount($page);
if ($lines = 0) {
    return;
} else if ($lines = 1) {
    if_setnpchead(npcchat_np1:npcchat_np1head_1, $npc);
    if_setanim(npcchat_np1:npcchat_np1head_1, split_getanim($page));
    if_settext(npcchat_np1:npcchat_np1name, $npc_name);
    if_settext(npcchat_np1:npcchat_np1a, split_get($page, 0));
    if_openchat(npcchat_np1);
} else if ($lines = 2) {
    if_setnpchead(npcchat_np2:npcchat_np2head_1, $npc);
    if_setanim(npcchat_np2:npcchat_np2head_1, split_getanim($page));
    if_settext(npcchat_np2:npcchat_np2name, $npc_name);
    if_settext(npcchat_np2:npcchat_np2a, split_get($page, 0));
    if_settext(npcchat_np2:npcchat_np2b, split_get($page, 1));
    if_openchat(npcchat_np2);
} else if ($lines = 3) {
    if_setnpchead(npcchat_np3:npcchat_np3head_1, $npc);
    if_setanim(npcchat_np3:npcchat_np3head_1, split_getanim($page));
    if_settext(npcchat_np3:npcchat_np3name, $npc_name);
    if_settext(npcchat_np3:npcchat_np3a, split_get($page, 0));
    if_settext(npcchat_np3:npcchat_np3b, split_get($page, 1));
    if_settext(npcchat_np3:npcchat_np3c, split_get($page, 2));
    if_openchat(npcchat_np3);
} else if ($lines = 4) {
    if_setnpchead(npcchat_np4:npcchat_np4head_1, $npc);
    if_setanim(npcchat_np4:npcchat_np4head_1, split_getanim($page));
    if_settext(npcchat_np4:npcchat_np4name, $npc_name);
    if_settext(npcchat_np4:npcchat_np4a, split_get($page, 0));
    if_settext(npcchat_np4:npcchat_np4b, split_get($page, 1));
    if_settext(npcchat_np4:npcchat_np4c, split_get($page, 2));
    if_settext(npcchat_np4:npcchat_np4d, split_get($page, 3));
    if_openchat(npcchat_np4);
}

[proc,chatnc_cutscene](string $npc_name, npc $npc, string $string)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~chatnpc_cutscene_page($npc_name, $npc, $page);
    $page = calc($page + 1);
}

// A voiced line: VORBIS_SPEECH_STOP (66) first, then the line's VORBIS_SPEECH_SOUND (7). The 647
// client plays every speech sound it is sent side by side (AClass55.method3670 adds each to its
// sound list; 66 stops them all, Class95_Sub3.method3214), so a line clicked through before its
// voice ended played on under the next one's. Not on each continue: cache 786's clip 3177 is one
// take of both of Explorer Jack's boxes, which a stop at the second box would cut off.
[proc,speech_line](vorbis $clip)
sound_speech_stop;
sound_speech_volume($clip, 1, 0, 255);
