// ── Make-X (2011) ───────────────────────────────────────────────────────────
// 289 asks "What would you like to make?" with skill_multi2-5: an item model
// per choice, and Make 1/5/10/X under each. 2011 asks in skillmulti2010
// (905), with its number panel skillmulti2010_numbers (916) mounted at com4:
// up to ten items, and one amount chosen beforehand from 1/5/10/All/+1/-1.
// The client lays both out in 905's onload (clientscript 711) from varcs --
// 754 the verb, 755-760 and 1139-1142 the items, 132-137 and 280-283 their
// names -- and two varbits of varp 1363: skill_creation_maximum, All's count,
// and skill_creation_amount, the amount chosen (it persists). An item is a
// pause button (`active_properties=1` in the cache). The layout and names
// follow void-634's MakeAmount.
//
// The skill_multi procs keep 289's signatures, so 289's callers port as they
// are. 2005's model positions, scales and captions have no place in 2011's
// layout, which names each item by its own name.

[proc,skill_make](string $text, int $verb, int $maximum, namedobj $obj1, namedobj $obj2, namedobj $obj3, namedobj $obj4, namedobj $obj5)(namedobj, int)
def_namedobj $product;
def_int $count;
$product, $count = ~skill_make10($text, $verb, $maximum, $obj1, $obj2, $obj3, $obj4, $obj5, null, null, null, null, null);
return($product, $count);

// All ten of the dialogue's items (choices com14 to com23, void-634's
// dialogue_skill_creation), for makes with more than five, such as smelting.
[proc,skill_make10](string $text, int $verb, int $maximum, namedobj $obj1, namedobj $obj2, namedobj $obj3, namedobj $obj4, namedobj $obj5, namedobj $obj6, namedobj $obj7, namedobj $obj8, namedobj $obj9, namedobj $obj10)(namedobj, int)
sendvarc(754, $verb); // the verb: ^skill_make_make, ^skill_make_cook, ...
~skill_make_item(755, 132, $obj1);
~skill_make_item(756, 133, $obj2);
~skill_make_item(757, 134, $obj3);
~skill_make_item(758, 135, $obj4);
~skill_make_item(759, 136, $obj5);
~skill_make_item(760, 137, $obj6);
~skill_make_item(1139, 280, $obj7);
~skill_make_item(1140, 281, $obj8);
~skill_make_item(1141, 282, $obj9);
~skill_make_item(1142, 283, $obj10);
~skill_make_amount($maximum);
if_openchat(skillmulti2010);
if_opensub(skillmulti2010_numbers, skillmulti2010:com4, ^false);
if_settext(skillmulti2010_numbers:com1, $text);
if_setevents(skillmulti2010_numbers:com8, 0, 0, ^if_op1, 0, 0, ^false, ^false);
p_pausebutton;
def_component $com = last_com;
if_close;
def_int $amount = %skill_creation_amount;
switch_component ($com) {
    case skillmulti2010:com14 : return($obj1, $amount);
    case skillmulti2010:com15 : return($obj2, $amount);
    case skillmulti2010:com16 : return($obj3, $amount);
    case skillmulti2010:com17 : return($obj4, $amount);
    case skillmulti2010:com18 : return($obj5, $amount);
    case skillmulti2010:com19 : return($obj6, $amount);
    case skillmulti2010:com20 : return($obj7, $amount);
    case skillmulti2010:com21 : return($obj8, $amount);
    case skillmulti2010:com22 : return($obj9, $amount);
    case skillmulti2010:com23 : return($obj10, $amount);
    case default : return(null, 0);
}

[proc,skill_make_item](int $varc, int $varc_name, namedobj $obj)
if ($obj = null) {
    sendvarc($varc, -1);
    return;
}
sendvarc($varc, $obj);
sendvarc_str($varc_name, oc_name($obj));

// The number panel. All is the maximum; +1 stops at it, -1 at nothing.
[if_button,skillmulti2010_numbers:com5]
%skill_creation_amount = 1;
%skill_creation_saved = add(%skill_creation_amount, 1);

[if_button,skillmulti2010_numbers:com6]
%skill_creation_amount = min(5, %skill_creation_maximum);
%skill_creation_saved = add(%skill_creation_amount, 1);

[if_button,skillmulti2010_numbers:com7]
%skill_creation_amount = min(10, %skill_creation_maximum);
%skill_creation_saved = add(%skill_creation_amount, 1);

[if_button,skillmulti2010_numbers:com8]
%skill_creation_amount = %skill_creation_maximum;
%skill_creation_saved = add(%skill_creation_amount, 1);

[if_button,skillmulti2010_numbers:com19]
%skill_creation_amount = min(add(%skill_creation_amount, 1), %skill_creation_maximum);
%skill_creation_saved = add(%skill_creation_amount, 1);

[if_button,skillmulti2010_numbers:com20]
%skill_creation_amount = max(sub(%skill_creation_amount, 1), 0);
%skill_creation_saved = add(%skill_creation_amount, 1);


// 289's signatures. All is 28, a full backpack: the most any of 289's makes
// can use, and the make stops sooner when the materials run out.
[proc,skill_multi2](namedobj $obj1, int $x1, int $y1, int $scale1, string $string1, namedobj $obj2, int $x2, int $y2, int $scale2, string $string2)(namedobj, int)
def_namedobj $product;
def_int $count;
$product, $count = ~skill_make(^skill_make_text, ^skill_make_make, 28, $obj1, $obj2, null, null, null);
return($product, $count);

[proc,skill_multi2_header](string $header, namedobj $obj1, int $x1, int $y1, int $scale1, string $string1, namedobj $obj2, int $x2, int $y2, int $scale2, string $string2)(namedobj, int)
def_namedobj $product;
def_int $count;
$product, $count = ~skill_make($header, ^skill_make_make, 28, $obj1, $obj2, null, null, null);
return($product, $count);

[proc,skill_multi3](namedobj $obj1, int $x1, int $y1, int $scale1, string $string1, namedobj $obj2, int $x2, int $y2, int $scale2, string $string2, namedobj $obj3, int $x3, int $y3, int $scale3, string $string3)(namedobj, int)
def_namedobj $product;
def_int $count;
$product, $count = ~skill_make(^skill_make_text, ^skill_make_make, 28, $obj1, $obj2, $obj3, null, null);
return($product, $count);

[proc,skill_multi4](namedobj $obj1, int $x1, int $y1, int $scale1, string $string1, namedobj $obj2, int $x2, int $y2, int $scale2, string $string2, namedobj $obj3, int $x3, int $y3, int $scale3, string $string3, namedobj $obj4, int $x4, int $y4, int $scale4, string $string4)(namedobj, int)
def_namedobj $product;
def_int $count;
$product, $count = ~skill_make(^skill_make_text, ^skill_make_make, 28, $obj1, $obj2, $obj3, $obj4, null);
return($product, $count);

[proc,skill_multi5](namedobj $obj1, int $x1, int $y1, int $scale1, string $string1, namedobj $obj2, int $x2, int $y2, int $scale2, string $string2, namedobj $obj3, int $x3, int $y3, int $scale3, string $string3, namedobj $obj4, int $x4, int $y4, int $scale4, string $string4, namedobj $obj5, int $x5, int $y5, int $scale5, string $string5)(namedobj, int)
def_namedobj $product;
def_int $count;
$product, $count = ~skill_make(^skill_make_text, ^skill_make_make, 28, $obj1, $obj2, $obj3, $obj4, $obj5);
return($product, $count);

[proc,skill_multi5_header](string $header, namedobj $obj1, int $x1, int $y1, int $scale1, string $string1, namedobj $obj2, int $x2, int $y2, int $scale2, string $string2, namedobj $obj3, int $x3, int $y3, int $scale3, string $string3, namedobj $obj4, int $x4, int $y4, int $scale4, string $string4, namedobj $obj5, int $x5, int $y5, int $scale5, string $string5)(namedobj, int)
def_namedobj $product;
def_int $count;
$product, $count = ~skill_make($header, ^skill_make_make, 28, $obj1, $obj2, $obj3, $obj4, $obj5);
return($product, $count);

// 289's multiobj2 asks which of two items, with no amount; 2011 asks such
// questions in the same dialogue, so it is skill_make with All at 1.
[proc,multiobj2](string $title, namedobj $obj1, int $x1, int $y1, int $scale1, string $string1, int $sx1, int $sy1, namedobj $obj2, int $x2, int $y2, int $scale2, string $string2, int $sx2, int $sy2)(namedobj)
def_namedobj $product;
def_int $count;
$product, $count = ~skill_make($title, ^skill_make_make, 1, $obj1, $obj2, null, null, null);
return($product);

// The amount on 2011's make-X is the player's last choice:
// - While playing, the client keeps it in skill_creation_amount (varbit 8095)
//   and writes it as the 1/5/10/All and +1/-1 buttons are pressed
//   (clientscripts 2022, 2023); the server mirrors each button (above).
// - Across logouts it is kept as void-634 keeps it (skill_creation_amount,
//   persist = true), in %skill_creation_saved: each button press and each
//   open updates it, as void-634's varbit is updated.
// - A player's first make starts at 1: void-634's default. No Jagex source
//   gives a first amount.
// - An amount above this make's maximum comes down to it, and stays down
//   (void-634 setMax sets the varbit).
//   The client labels an amount at or above the maximum "Make All" or "Cook
//   All" (clientscripts 1111, 2047; verbs 1, 9 and 12 have no All, script
//   1103), so a remembered All is still All.
[proc,skill_make_amount](int $maximum)
%skill_creation_maximum = $maximum;
// %skill_creation_saved holds the amount plus 1, so that 0 is a player who
// never chose: -1 can take the amount to 0 (clientscript 2023), which
// void-634 keeps as it is.
def_int $amount = 1;
if (%skill_creation_saved > 0) {
    $amount = sub(%skill_creation_saved, 1);
}
if ($amount > $maximum) {
    $amount = $maximum;
}
%skill_creation_amount = $amount;
%skill_creation_saved = add($amount, 1);
