// 2439
[clientscript,trawler_net_status]
if (%trawler_is_net_ripped_client = 1) {
    if_settext(trawler_game_overlay:net_text, "Net: Ripped!");
    if_setcolour(trawler_game_overlay:net_text, 0xe12323);
} else {
    if_settext(trawler_game_overlay:net_text, "Net: OK");
    if_setcolour(trawler_game_overlay:net_text, 0xff9900);
}
