// 1232
[clientscript,trawler_reward_setup](component $component0, component $component1, component $component2)
if_setsize($component2, if_getwidth($component2), calc(paraheight(if_gettext($component2), if_getwidth($component2), p11_full) * 12 + 3), ^setsize_abs, ^setsize_abs);
cc_deleteall($component0);
def_int $int3 = calc((if_getwidth($component0) - 36 * 8) / 7);
def_int $int4 = calc((if_getheight($component0) - 32 * 5) / 4);
def_int $int5 = 0;
while ($int5 < inv_size(trawler_rewardinv)) {
    cc_create($component0, ^iftype_graphic, $int5);
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc((36 + $int3) * ($int5 % 8)), calc($int5 / 8 * (32 + $int4)), ^setpos_abs_left, ^setpos_abs_top);
    cc_sethide(false);
    if (inv_getobj(trawler_rewardinv, $int5) ! null) {
        cc_setobject(inv_getobj(trawler_rewardinv, $int5), inv_getnum(trawler_rewardinv, $int5));
        cc_setopbase("<col=ff981f><oc_name(inv_getobj(trawler_rewardinv, $int5))>");
