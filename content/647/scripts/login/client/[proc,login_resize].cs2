// 3230
[proc,login_resize]
def_int $int0 = 0;
if (getwindowmode < 2) {
    if_setposition(login:main, 0, 16, ^setpos_abs_centre, ^setpos_abs_centre);
    if_setposition(login:popup, 0, 16, ^setpos_abs_centre, ^setpos_abs_centre);
    if_setsize(loginscreen:com_16, 0, 0, ^setsize_minus, ^setsize_minus);
    if_setposition(loginscreen:runescape_logo, 0, 26, ^setpos_abs_centre, ^setpos_abs_top);
} else {
    if_setposition(login:main, 0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    if_setposition(login:popup, 0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    if_setsize(loginscreen:com_16, 956, 503, ^setsize_abs, ^setsize_abs);
    $int0 = if_gety(loginscreen:com_16);
    $int0 = calc($int0 - if_getheight(loginscreen:runescape_logo));
    $int0 = calc($int0 / 2);
    if_setposition(loginscreen:runescape_logo, 0, max($int0, 0), ^setpos_abs_centre, ^setpos_abs_top);
}
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 2;
$int1 = calc(if_getx(loginscreen:com_99) + if_getx(loginscreen:com_16));
$int1 = calc($int1 - (if_getwidth(loginscreen:toolbar_layer) + $int3));
$int2 = calc(if_gety(loginscreen:com_101) + if_gety(loginscreen:com_16));
$int2 = calc($int2 + $int3);
$int2 = calc($int2 + if_getheight(loginscreen:com_101));
if_setposition(loginscreen:toolbar_layer, $int1, $int2, ^setpos_abs_left, ^setpos_abs_top);
$int1 = if_getx(loginscreen:toolbar_layer);
$int1 = calc($int1 + if_getwidth(loginscreen:toolbar_layer));
$int1 = calc(if_getwidth(loginscreen:background_layer) - $int1);
if_setposition(loginscreen:toolbar_layer, $int1, $int2, ^setpos_abs_right, ^setpos_abs_top);
if (detailget_maxscreensize = 2 & getwindowmode ! ^windowmode_small) {
    if_setposition(loginscreen:toolbar_layer, 9, 57, ^setpos_abs_right, ^setpos_abs_top);
    if_setsize(loginscreen:com_16, 800, 503, ^setsize_abs, ^setsize_abs);
} else if (calc(if_getwidth(loginscreen:toolbar_layer) + if_getx(loginscreen:toolbar_layer)) > if_getwidth(loginscreen:background_layer)) {
    if_setposition(loginscreen:toolbar_layer, 5, 5, ^setpos_abs_right, ^setpos_abs_top);
}
if (%loginscreen_camera_disabled = false) {
    if_setposition(loginscreen:toolbar_layer, 5, 5, ^setpos_abs_right, ^setpos_abs_top);
}
