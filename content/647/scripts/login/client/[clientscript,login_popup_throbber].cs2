// 2951
[clientscript,login_popup_throbber]
def_component $component0 = login:popup_throbber;
if (unknown_command_5623 = true) {
    $component0 = south_progress9:popup_throbber;
}
def_int $int1 = ~login_getreply;
if ($int1 ! -3) {
    if_setontimer($component0, null);
    return;
}
if (clientclock < %throbber_last) {
    return;
}
%throbber_last = calc(clientclock + 5);
switch_graphic (if_getgraphic($component0)) {
    case "loading_wheel_1,0" :
        if_setgraphic($component0, "loading_wheel_1,1");
    case "loading_wheel_1,1" :
        if_setgraphic($component0, "loading_wheel_1,2");
    case "loading_wheel_1,2" :
        if_setgraphic($component0, "loading_wheel_1,3");
    case "loading_wheel_1,3" :
        if_setgraphic($component0, "loading_wheel_1,4");
    case "loading_wheel_1,4" :
        if_setgraphic($component0, "loading_wheel_1,5");
    case "loading_wheel_1,5" :
        if_setgraphic($component0, "loading_wheel_1,6");
    case "loading_wheel_1,6" :
        if_setgraphic($component0, "loading_wheel_1,7");
    case "loading_wheel_1,7" :
        if_setgraphic($component0, "loading_wheel_1,0");
    case default :
        if_setgraphic($component0, "loading_wheel_1,0");
}
