// 1143
[proc,combat_side_button](string $string0, graphic $graphic0, string $string1, string $string2, graphic $graphic1, string $string3, string $string4, graphic $graphic2, string $string5, string $string6, graphic $graphic3, string $string7)
if (compare($string0, "") ! 0 & $graphic0 ! null) {
    if_setgraphic(combat_side:icon1, $graphic0);
    if_settext(combat_side:text1, $string0);
    if_sethide(combat_side:button1, false);
    if_setop(combat_side:button1, 1, $string0);
    if_setonmouserepeat(combat_side:button1, "addtooltip(combat_side:button1, combat_side:tooltip, $string1, 25, 190)");
    if_setonmouseleave(combat_side:button1, "deltooltip(combat_side:tooltip)");
} else {
    if_clearops(combat_side:button1);
    if_sethide(combat_side:button1, true);
}
