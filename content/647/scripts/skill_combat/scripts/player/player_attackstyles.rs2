// in osrs attack styles are strongqueued
// for us its normal queued. Its likely queued because if you're delayed
// and setting attack style, it wont go through at all. Queueing allows
// for it to go through after delay is over
//
// 289 sends one attack tab per weapon category (combat_heavysword, combat_axe,
// ...), each with its own style buttons. 2011 has one, combat_side (884): its
// scripts lay out the worn weapon's styles (script 1142, from the weapon's
// params), light the one %com_mode (varp 43) names (1134), and show auto
// retaliate (varp 172, 1139) and special energy (varp 300, 1137). Its four
// style buttons are 11-14 in style order (void-634's `style1`-`style4`); they
// carry no op until login unlocks them.
[if_button,combat_side:button1] ~set_attackstyle(0);
[if_button,combat_side:button2] ~set_attackstyle(1);
[if_button,combat_side:button3] ~set_attackstyle(2);
[if_button,combat_side:button4] ~set_attackstyle(3);

// 289's staff tab has an autocast toggle (combat_staff_2:auto_toggle); 2011's
// staffs autocast from the spellbook (skill_combat/scripts/player/auto_cast.rs2).

// 289 turns auto retaliate on and off from its controls tab
// (interface_controls/scripts/player_controls.rs2, controls:com_2 and com_3);
// 2011's is one toggle on combat_side (15).
[if_button,combat_side:auto_retaliate]
if_close; // closes interfaces in osrs
if (p_finduid(uid) = true) {
    p_stopaction; // https://oldschool.runescape.wiki/w/Update:Slayer_Cave_%26_High_Risk_Worlds
    if (%option_nodef = ^player_auto_retaliate_on) {
        %option_nodef = ^player_auto_retaliate_off;
    } else {
        %option_nodef = ^player_auto_retaliate_on;
    }
    return;
}
%option_nodef = %option_nodef; // resync varp

[proc,set_attackstyle](int $style)
if_close;
if (p_finduid(uid) = true) {
    p_clearpendingaction;
    %com_mode = $style;
    ~player_combat_stat;
    return;
}
%com_mode = %com_mode; // resync varp

// updates the attack style tab depending on the
// weapon currently equipped or not by the player
[proc,update_weapon_category](obj $previous)
// dont remove attack style if the equipted item is not a weapon
if ($previous ! null & oc_wearpos($previous) ! ^wearpos_rhand) {
    return;
}
def_obj $obj = inv_getobj(worn, ^wearpos_rhand);
if ($previous = null | $obj = null | oc_category($previous) ! oc_category($obj)) {
    // todo somehow confirm this
    // osrs keeps track of selected per category
    ~player_autocast_reset;
}
// 289 then sends the tab for the weapon's category, with the weapon's name,
// its picture and its special bar; combat_side draws all of them itself from
// the worn weapon (scripts 1132, 1136 and 1142).

[proc,.update_weapon_category](obj $previous)
// dont remove attack style if the equipted item is not a weapon
if ($previous ! null & oc_wearpos($previous) ! ^wearpos_rhand) {
    return;
}
def_obj $obj = .inv_getobj(worn, ^wearpos_rhand);
if ($previous = null | $obj = null | oc_category($previous) ! oc_category($obj)) {
    // todo somehow confirm this
    // osrs keeps track of selected per category
    ~.player_autocast_reset;
}
