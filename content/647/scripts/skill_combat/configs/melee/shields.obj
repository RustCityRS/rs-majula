// 289's antidragonbreathshield, obj 1540, which 289 names "Dragonfire shield":
// 2011's anti-dragon shield, 1540 (the 2011 wiki's Anti-dragon shield, 22 May
// 2011: "formerly named the dragonfire shield"). Its examine is 2011's
// (void-634's, as player/configs/wearpos.obj gave it).
[anti_dragon_shield]
desc=This provides partial protection from dragonbreath attacks.
wearpos=lefthand
category=armour_shield
weight=12lb
param=stabdefence,7
param=slashdefence,9
param=crushdefence,8
param=magicdefence,2
param=rangedefence,8
param=defend_anim,human_shield_defence
// 289's brassclash2: cache 786's 1976, its bytes (647's brassclash2, 513, is another sound)
param=defend_sound,synth_1976

