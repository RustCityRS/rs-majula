[wooden_shield]
desc=A solid wooden shield.
wearpos=lefthand
category=armour_shield
weight=5lb
param=stabdefence,4
param=slashdefence,5
param=crushdefence,3
param=magicdefence,1
param=rangedefence,4
param=defend_anim,human_shield_defence
param=defend_sound,wood_armour3_1

