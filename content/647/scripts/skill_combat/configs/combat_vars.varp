// The server keys of 289's combat varps (protect, type, scope), as 289 has them --
// most in its rev-225 unpack. 647 names them at 289's ids where the 2011 client
// does not read the varp, or reads it the same way (com_mode 43, poison 102,
// option_nodef 172, sa_energy 300, sa_attack 301); 289's transmit is the cache's.

[aggressive_npc]
type=npc_uid
protect=no

[autocast_spell]
scope=perm

[com_attackanim]
protect=no
type=seq

[com_attacksound]
protect=no
type=synth

[com_crushattack]
protect=no

[com_crushdef]
protect=no

[com_defendanim]
protect=no
type=seq

// 289's armourhitsound is its varp 375; 786's varp 375 is the client's, so this
// one is server-only.
[armourhitsound]
protect=no
type=synth

[com_magicattack]
protect=no

[com_magicdef]
protect=no

[com_maxhit]
protect=no

[com_mode]
protect=no

[com_rangeattack]
protect=no

[com_rangedef]
protect=no

[com_slashattack]
protect=no

[com_slashdef]
protect=no

[com_stabattack]
protect=no

[com_stabdef]
protect=no

[damagestyle]
protect=no

[damagetype]
protect=no

[death]

[dragon_goblin]
type=int
scope=perm

[frozen]

[guthmage]
scope=perm

[iban_staff_charges]
scope=perm

[lastcombat]
protect=no

[lastcombat_pvp]
protect=no

[magearena]
protect=no
scope=perm

[magearena_charge]
scope=perm

[option_nodef]
protect=no
scope=perm

[pk_binder]
