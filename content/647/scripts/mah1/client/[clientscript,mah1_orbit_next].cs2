// 2346
[clientscript,mah1_orbit_next]
%mah1_orbit_step = calc(%mah1_orbit_step + 1);
if (%mah1_orbit_step >= calc(spline_length(0) - 1)) {
    %mah1_orbit_step = 0;
    if_setoncamfinished(mah1_orbitsplines:controller, null);
    return;
}
if (%mah1_orbit_step = calc(spline_length(0) - 2)) {
    cam_movealong(0, %mah1_orbit_step, 200, 75, 1, %mah1_orbit_step);
} else {
    cam_movealong(0, %mah1_orbit_step, 200, 200, 1, %mah1_orbit_step);
}
if_setoncamfinished(mah1_orbitsplines:controller, "mah1_orbit_next");
