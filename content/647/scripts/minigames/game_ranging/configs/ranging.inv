[ranging_guild_bowshop]
// https://oldschool.runescape.wiki/w/Dargaud%27s_Bow_and_Arrows.
// https://storage.googleapis.com/tannerdino/images/dargaudsbowandarrows.png (2006)
// https://www.spookspring.com/noobsquad/imagegif/spookart/arch.GIF
scope=shared
size=27
// 2011's shop holds 27 (the cache's inventory 80; void-634's list):
// it adds bronze_brutal, iron_brutal, steel_brutal, black_brutal, mithril_brutal, adamant_brutal, rune_brutal, comp_ogre_bow
restock=yes
stackall=yes
allstock=no
stock1=arrow_shaft,1000,50
stock2=bronze_arrowtips,500,10
stock3=iron_arrowtips,400,20
stock4=steel_arrowtips,300,30
stock5=mithril_arrowtips,200,40
stock6=adamant_arrowtips,200,50
stock7=rune_arrowtips,150,60
stock8=bronze_arrow,1000,10
stock9=iron_arrow,500,20
stock10=steel_arrow,500,40
stock11=mithril_arrow,500,60
stock12=adamant_arrow,450,120
stock13=rune_arrow,400,130
stock14=bronze_brutal,0,100
stock15=iron_brutal,0,100
stock16=steel_brutal,0,100
stock17=black_brutal,0,100
stock18=mithril_brutal,0,100
stock19=adamant_brutal,0,100
stock20=rune_brutal,0,100
stock21=shortbow,20,50
stock22=oak_shortbow,20,60
stock23=willow_shortbow,20,70
stock24=longbow,20,50
stock25=oak_longbow,20,60
stock26=willow_longbow,20,70
stock27=comp_ogre_bow,10,100

[ranging_guild_armourshop]
// https://oldschool.runescape.wiki/w/Aaron%27s_Archery_Appendages.
