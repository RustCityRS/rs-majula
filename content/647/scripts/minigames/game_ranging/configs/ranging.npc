// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[ranging_guild_guard]
desc=Keeps order in the ranging guild.
wanderrange=1
maxrange=20
attackrange=10
respawnrate=50
hitpoints=500
attack=20
strength=20
defence=20
ranged=40
param=attackrate,6
param=attackbonus,19
param=strengthbonus,8
param=rangebonus,8
param=stabdefence,18
param=slashdefence,23
param=crushdefence,27
param=magicdefence,10
param=rangedefence,19
param=damagetype,^crush_style
param=attack_anim,human_bow
param=defend_sound,null
param=death_sound,null
param=rangeattack_sound,arrowlaunch2
param=proj_launch,iron_arrow_launch
param=proj_travel,iron_arrow_travel
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_6056
// this npc havent any hit or death sounds...

