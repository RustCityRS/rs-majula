// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[loar_shadow]
desc=A shadowy sort of entity, kind of creepy looking.
wanderrange=30
maxrange=60
moverestrict=blocked+normal
respawnrate=35
hitpoints=380
attack=45
strength=30
defence=26
magic=0
ranged=0
param=damagetype,^crush_style
param=attack_anim,shade_attack
param=defend_anim,shade_block
param=death_anim,shade_sink
param=attack_sound,shade_attack
param=defend_sound,shade_hit
param=death_sound,shade_death
param=death_drop,loar_remains
param=undead,^true
huntmode=shades
timer=1
param=next_npc_type,loar_shade
// guess
huntrange=3
category=shade
// TODO immune to poison
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_1276

