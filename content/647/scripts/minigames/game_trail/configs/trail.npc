// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[zamorak_wizard]
desc=A servant of Zamorak.
wanderrange=3
maxrange=5
attackrange=5
// void-634 has 760; 289's 80 hitpoints would be 800.
hitpoints=760
attack=24
strength=24
defence=24
magic=80
param=magicdefence,3
param=damagetype,^crush_style
param=attack_sound,null
param=defend_sound,null
param=death_sound,null
param=npc_forcemulti,^true
timer=20
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_2954

[saradomin_wizard]
desc=A follower of Saradomin.
wanderrange=3
maxrange=5
attackrange=5
hitpoints=1200
attack=100
strength=80
defence=80
magic=80
param=attackbonus,40
param=strengthbonus,40
param=magicdefence,30
param=damagetype,^stab_style
param=attack_anim,human_ddagger_lunge
param=defend_anim,human_ddagger_block
param=attack_sound,null
param=defend_sound,null
param=death_sound,null
param=npc_forcemulti,^true
timer=20
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_2955
