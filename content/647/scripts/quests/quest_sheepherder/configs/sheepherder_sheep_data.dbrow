// 289's rows. sheep_in_pen_coord is where cache 786 spawns each sheep's
// herder_plaguesheep_N_enclosure npc (maps/n40_52.jm2), the player's own
// sheep in the pen: 289's first two stood a tile off (_36_34, _37_35).
[herder_plaguesheep_1]
table=sheep_table
data=sheep_type,plaguesheep_1
data=sheep_in_pen_coord,0_40_52_37_34
data=sheep_start_bit,1
data=sheep_bones,sheepbonesa

