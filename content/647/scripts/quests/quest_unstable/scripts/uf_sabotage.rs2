// Unstable Foundations: "Talk to Sir Vant Again" (Task 3511, varp 281 93-95) and "Sabotage!"
// (3512, 96-115): the supplies, the oily rags and fuses on the two wooden pillars, the tinderbox,
// and the fire. Lines from 2011's recordings (design note 3.4 s021-s037) and the voiced takes
// (3.7); 4KO2h2xPtdM (2011-04-30) @289-396 for the order and the inventory:
// - after s023 the backpack holds two tinderboxes, the cloth, a fuse of each of cache 786's two
//   fuse objs (15282, 15283), and the oil can, in that order (@292);
// - the cloth is ripped first, each rag soaked, wrapped, then the fuses (@294-357).
// The pillars are locs 45564 (24, 31) and 45565 (24, 39), multilocs on varbits 6496 and 6497: 0
// bare, 1 the oily rag on, 2 the fuse on, 3 the fuse alight (seq 12242), 4 burning (seq 12243).
// Sir Vant stands by the first (Task 1715: "by the wooden pillar just south-east of the dragon's
// nest"); the player lights "the pillar farthest from Sir Vant" (the 2011 wiki, Unstable
// Foundations, 2011-05-05), "the fuse on the right" (Task 1716).
// The values inside the band (96 the supplies taken, 98 the cloth ripped, 100 the rags soaked,
// 105 both rags on, 110 both fuses on, 115 Sir Vant's tinderbox given): no source; cs2 4098/3227
// read only the band.

// "Talk to Sir Vant Again" (93): s021, s022 (V87, V8; clips 911, 993).
[proc,uf_vant_sabotage]
if (%tutorial = 93) {
    hint_stop_slot(0);
    ~speech_line(vorbis_911);
    ~chatnpc("<p,neutral>We need to destroy these pillars to collapse the ceiling on the dragon.");
    ~speech_line(vorbis_993);
    ~chatnpc("<p,neutral>Could you get the rest of the supplies from my bag please?");
    %tutorial = 95;
    ~uf_task_pin;
    return;
}
if (%tutorial = 95) {
    // V24 (clip 870), then s022a and s022b (VwpdbjfigD4 2011-01-17 @392-395; P4, V60).
    ~speech_line(vorbis_870);
    ~chatnpc("<p,neutral>Have you got the stuff from my bag?");
    ~uf_player_voice(vorbis_1819, vorbis_640);
    ~chatplayer("<p,neutral>I haven't searched it yet.");
    ~speech_line(vorbis_932);
    ~chatnpc("<p,neutral>Oh. Well, search my bag and bring the supplies to me before the dragon wakes up!");
    return;
}
if (%tutorial >= 96 & %tutorial < 115) {
    if (%tutorial3_leftpillar = 2 & %tutorial3_rightpillar = 2) {
        // s034 (V73, clip 931): both pillars ready.
        ~speech_line(vorbis_931);
        ~chatnpc("<p,neutral>Thanks, that's perfect. Now, hand me a tinderbox.");
        return;
    }
    if (%tutorial = 96) {
        // s024-s026 (VwpdbjfigD4 @411-419; V58, V14, V98, clips 795, 876, 844).
        ~speech_line(vorbis_795);
        ~chatnpc("<p,neutral>Now we're going to burn these wooden pillars and bring the ceiling down on this fat old worm!");
        ~speech_line(vorbis_876);
        ~chatnpc("<p,neutral>First, we need to wrap the pillars in oily rags. There was a big cloth in my bag. Rip it in half, then soak the pieces in oil.");
        ~speech_line(vorbis_844);
        ~chatnpc("<p,neutral>Wrap the oily rags around the pillars, then add a fuse to each one.");
        return;
    }
    // s026a-s026e (rX5vda5px3w 2011-01-28 @66-81; V29 clip 757, V54 clip 907).
    ~speech_line(vorbis_757);
    ~chatnpc("<p,neutral>How are you getting on?");
    def_int $choice = ~p_choice3("What am I meant to be doing?", 1, "I'm getting there.", 2, "Why don't you do it yourself?", 3);
    if ($choice = 1) {
        ~uf_player_voice(vorbis_1880, vorbis_661);
        ~chatplayer("<p,neutral>What am I meant to be doing?");
        ~speech_line(vorbis_844);
        ~chatnpc("<p,neutral>Wrap the oily rags around the pillars, then add a fuse to each one.");
    } else if ($choice = 2) {
        ~uf_player_voice(vorbis_1839, vorbis_414);
        ~chatplayer("<p,neutral>I'm getting there.");
    } else {
        ~uf_player_voice(vorbis_1859, vorbis_578);
        ~chatplayer("<p,neutral>Why don't you do it yourself?");
        ~speech_line(vorbis_907);
        ~chatnpc("<p,neutral>Me? Touch oily rags? You've clearly never tried to clean oil off white armour!");
        ~chatnpc("<p,neutral>No, I'll let you have all the fun.");
    }
    return;
}
if (%tutorial = 115) {
    // s036 again (V72, clip 893).
    ~speech_line(vorbis_893);
    ~chatnpc("<p,neutral>Thank you. When you're ready, set fire to the other pillar. I'll light this one at the same moment.");
}

// The supplies: s023 (IwS6rBpkcyE @234, 23/31), N28 (clip 1488); afterwards N27 (clip 1739).
[proc,uf_bag_supplies]
if (%tutorial = 95) {
    if (inv_freespace(inv) < 6) {
        ~mesbox("You don't have enough inventory space.");
        return;
    }
    inv_add(inv, tinderbox, 1);
    inv_add(inv, tinderbox, 1);
    inv_add(inv, tutorial3_bigcloth, 1);
    inv_add(inv, tutorial3_fuse_1, 1);
    inv_add(inv, tutorial3_fuse_2, 1);
    inv_add(inv, tutorial3_oilcan, 1);
    %tutorial = 96;
    %varclient_1425 = 3511;
    ~uf_task_tab;
    ~uf_task_pin;
    ~speech_line(vorbis_1488);
    ~objbox(tutorial3_bigcloth, "You search Sir Vant's bag and take a selection of supplies.", 250, 0, 0);
    return;
}
~speech_line(vorbis_1739);
~mesbox("There's nothing useful left in the bag except for Sir Vant's spare underpants, which you leave well alone.");

// Rip: s027 / s030 (N10, N11; clips 1382, 1452).
[opheld1,tutorial3_bigcloth]
inv_del(inv, tutorial3_bigcloth, 1);
inv_add(inv, tutorial3_rag, 2);
if (%tutorial = 96) {
    %tutorial = 98;
}
~speech_line(vorbis_1382);
~objbox(tutorial3_rag, "You rip the cloth and end up with two rags.", 250, 0, 0);

[opheld1,tutorial3_bigcloth_oily]
inv_del(inv, tutorial3_bigcloth_oily, 1);
inv_add(inv, tutorial3_rag_oily, 2);
if (%tutorial = 96) {
    %tutorial = 100;
}
~speech_line(vorbis_1452);
~objbox(tutorial3_rag_oily, "You rip the oily cloth and end up with two oily rags.", 250, 0, 0);

// Soak: the oil can with the cloth or a rag, either way round (s028 N13 clip 1379, s029 N12 clip
// 1541; already soaked: s031 N14 / N15, clips 1344, 1598; on a fuse: N16, clip 1770).
[opheldu,tutorial3_oilcan] ~uf_soak(last_item, last_useitem);
[opheldu,tutorial3_bigcloth] ~uf_soak(last_item, last_useitem);
[opheldu,tutorial3_rag] ~uf_soak(last_item, last_useitem);
[opheldu,tutorial3_rag_oily] ~uf_soak(last_item, last_useitem);
[opheldu,tutorial3_bigcloth_oily] ~uf_soak(last_item, last_useitem);
[opheldu,tutorial3_fuse_1] ~uf_soak(last_item, last_useitem);
[opheldu,tutorial3_fuse_2] ~uf_soak(last_item, last_useitem);

[proc,uf_soak](obj $held, obj $other)
def_obj $item = $held;
if ($item = tutorial3_oilcan) {
    $item = $other;
} else if ($other ! tutorial3_oilcan) {
    ~displaymessage(^dm_default);
    return;
}
if ($item = tutorial3_bigcloth) {
    inv_del(inv, tutorial3_bigcloth, 1);
    inv_add(inv, tutorial3_bigcloth_oily, 1);
    ~speech_line(vorbis_1541);
    ~objbox(tutorial3_bigcloth_oily, "You soak the cloth in oil.", 250, 0, 0);
} else if ($item = tutorial3_rag) {
    inv_del(inv, tutorial3_rag, 1);
    inv_add(inv, tutorial3_rag_oily, 1);
    if (%tutorial = 98 & inv_total(inv, tutorial3_rag) = 0) {
        %tutorial = 100;
    }
    ~speech_line(vorbis_1379);
    ~objbox(tutorial3_rag_oily, "You soak the rag in oil.", 250, 0, 0);
} else if ($item = tutorial3_bigcloth_oily) {
    ~speech_line(vorbis_1344);
    ~mesbox("The cloth has already been soaked in oil.");
} else if ($item = tutorial3_rag_oily) {
    ~speech_line(vorbis_1598);
    ~mesbox("The rag has already been soaked in oil.");
} else if ($item = tutorial3_fuse_1 | $item = tutorial3_fuse_2) {
    ~speech_line(vorbis_1770);
    ~mesbox("There's no need to put oil on the fuse.");
} else {
    ~displaymessage(^dm_default);
}

// Items on a pillar.
[oplocu,tutorial3_pillar_wooden] ~uf_pillar_use(last_useitem);
[oplocu,tutorial3_pillar_wooden_rag] ~uf_pillar_use(last_useitem);
[oplocu,tutorial3_pillar_wooden_rag_fuse] ~uf_pillar_use(last_useitem);
[oplocu,tutorial3_pillar_wooden_rag_fuse_lit] ~uf_pillar_use(last_useitem);
[oplocu,tutorial3_pillar_explosion] ~uf_pillar_use(last_useitem);

[proc,uf_pillar_use](obj $item)
if (region_findbycoord(coord) = false) {
    return;
}
// Which pillar: Sir Vant's (24, 31), varbit 6496, or the other (24, 39), 6497.
def_boolean $his = false;
if (coordz(loc_coord) < coordz(~uf_cellar_coord(24, 35))) {
    $his = true;
}
def_int $state = %tutorial3_rightpillar;
if ($his = true) {
    $state = %tutorial3_leftpillar;
}
if ($item = tutorial3_rag_oily) {
    if ($state > 0) {
        // V77 (clip 786; N21, clip 1773, is the narrator's).
        ~speech_line(vorbis_786);
        ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,neutral>That pillar's already got an oil-soaked cloth around it.");
        return;
    }
    inv_del(inv, tutorial3_rag_oily, 1);
    ~uf_pillar_set($his, 1);
    ~speech_line(vorbis_1698);
    ~objbox(tutorial3_rag_oily, "You wrap the oily rag around the pillar.", 250, 0, 0);
    if (%tutorial3_leftpillar >= 1 & %tutorial3_rightpillar >= 1 & %tutorial < 105) {
        %tutorial = 105;
    }
    return;
}
if ($item = tutorial3_rag) {
    // s031a (promi6pWj8k @627), V105 (clip 750).
    ~speech_line(vorbis_750);
    ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,neutral>You're supposed to soak the rag in oil first. Try using the rag with the oil can.");
    return;
}
if ($item = tutorial3_bigcloth | $item = tutorial3_bigcloth_oily) {
    // V103 (clip 791).
    ~speech_line(vorbis_791);
    ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,neutral>You're supposed to rip the cloth in half first.");
    return;
}
if ($item = tutorial3_fuse_1 | $item = tutorial3_fuse_2) {
    if ($state = 0) {
        // V41 (clip 991): its take runs on; the box keeps the first sentence.
        ~speech_line(vorbis_991);
        ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,neutral>I think you should wrap the oily rag around the pillar before adding the fuse.");
        return;
    }
    if ($state >= 2) {
        // V79 (clip 905).
        ~speech_line(vorbis_905);
        ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,neutral>The pillar's already fully prepared for burning.");
        return;
    }
    inv_del(inv, $item, 1);
    ~uf_pillar_set($his, 2);
    ~speech_line(vorbis_1621);
    ~objbox($item, "You attach the fuse to the pillar.", 250, 0, 0);
    if (%tutorial3_leftpillar = 2 & %tutorial3_rightpillar = 2 & %tutorial < 110) {
        %tutorial = 110;
    }
    return;
}
if ($item = tinderbox) {
    if (%tutorial3_leftpillar ! 2 | %tutorial3_rightpillar ! 2) {
        // s033a (p7ufqPwAXLg 2011-03-07 @464), V83 (clip 833).
        ~speech_line(vorbis_833);
        ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,neutral>Wait a minute! You're supposed to get both pillars prepared before we light them.");
        return;
    }
    if (%tutorial < 115) {
        // s034a (7_neJ6mCLXc 2010-12-23 @299), V101 (clip 913).
        ~speech_line(vorbis_913);
        ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,neutral>You'll need to give me a tinderbox first - otherwise, I can't light my pillar at the same time as you light yours.");
        return;
    }
    if ($his = true) {
        // V39 (clip 799): its take runs on; the box keeps the first sentence.
        ~speech_line(vorbis_799);
        ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,neutral>I think it would be better if you lit the other pillar.");
        return;
    }
    ~uf_light_pillars;
    return;
}
~displaymessage(^dm_default);

[proc,uf_pillar_set](boolean $his, int $state)
if ($his = true) {
    %tutorial3_leftpillar = $state;
} else {
    %tutorial3_rightpillar = $state;
}

// Anything used on Sir Vant while he keeps the dragon's attention (8852): s033b, as below.
[opnpcu,tutorial3_knight_distracting]
~speech_line(vorbis_798);
~chatnpc("<p,neutral>I don't think I need that just at the moment, thank you.");

// The tinderbox to Sir Vant: s035 (N53, clip 1556), s036 (V72, clip 893). Anything else: s033b
// (V32, clip 798).
[opnpcu,tutorial3_knight_waitingforbattle]
if (last_useitem = tinderbox & %tutorial >= 96 & %tutorial < 115) {
    if (%tutorial3_leftpillar ! 2 | %tutorial3_rightpillar ! 2) {
        ~speech_line(vorbis_833);
        ~chatnpc("<p,neutral>Wait a minute! You're supposed to get both pillars prepared before we light them.");
        return;
    }
    inv_del(inv, tinderbox, 1);
    %tutorial = 115;
    ~speech_line(vorbis_1556);
    ~objbox(tinderbox, "You offer Sir Vant a tinderbox.", 250, 0, 0);
    ~speech_line(vorbis_893);
    ~chatnpc("<p,neutral>Thank you. When you're ready, set fire to the other pillar. I'll light this one at the same moment.");
    return;
}
if (%tutorial >= 120 & %tutorial < 128) {
    ~uf_return_item(last_useitem);
    return;
}
~speech_line(vorbis_798);
~chatnpc("<p,neutral>I don't think I need that just at the moment, thank you.");
