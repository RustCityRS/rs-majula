// Unstable Foundations, 2011's tutorial (cache 786; docs/647-unstable-foundations.md). Progress is
// %learning_the_ropes (varp 281): quest config 131 starts the quest at 5 and completes it at 1000;
// cs2 4098 picks the Task panel's Task from it (section 3.1).

// Character creation's end (cc_name.rs2) and a login mid-tutorial (login.rs2) start here: the
// player in a fresh cellar on local (30, 9) (design note 3.5 #1), the plank on local (35, 15)
// (3.5 #2), and the cellar's track, The Mentor (3.5 #6; the 2011 wiki's "Tutorial Cellar").
[proc,uf_start]
~uf_cellar_enter_at(30, 9);
// A login in the dragon cutscene starts it again from the talk.
if (%tutorial = 9) {
    %tutorial = 7;
}
~uf_cellar_populate;
// The side panel opens on the options tab, as 2011's first frame in the cellar shows it
// (8jKH_7To46o @56, a yellow arrow pointing at the task system tab); the other tabs stay shut
// until unlocked (uf_tabs.rs2).
if_settabactive(12);
if (%tutorial < 7) {
    ~uf_controls_open;
}
~uf_task_pin;
// The Mentor plays without being unlocked: no recording shows an unlock message in the cellar
// (only Harmony's, on arrival in Lumbridge), and the 2011 wiki unlocks it "after defeating the
// dragon".
~uf_play_song(music_The_Mentor);

// What stands in the cellar at each step: a fresh cellar for a new player, and the cellar as the
// step left it for a login mid-tutorial (where 2011 put such a player: no source found).
[proc,uf_cellar_populate]
// A login in the sleep cutscene starts it again from the meat.
if (%tutorial = 82 | %tutorial = 83) {
    %tutorial = 80;
    %tutorial3_meatplacement = 0;
    if (inv_total(inv, tutorial3_meat) = 0) {
        inv_add(inv, tutorial3_meat, 1);
    }
}
def_int $p = %tutorial;
// Sir Vant in the start room's north doorway and his squire south of it: the 2011 minimaps put
// them on (32, 16) and (33, 15) (4KO2h2xPtdM and VwpdbjfigD4, fitted against ours), and the 3D
// view shows the knight in the doorway. Of cache 786's six Sir Vants, 8850 (bas_1614) is the one
// holding his orange shield up in front, feet wide, as 2011's does (4KO2h2xPtdM 9-14 s).
if ($p < 90) {
    npc_add(~uf_cellar_coord(32, 16), tutorial3_knight_waitingforbattle, 0);
    npc_setmode(none);
    // Until the camera is turned a hint points the new player at Sir Vant: the yellow ring and
    // arrow at their feet (vGlx_SDOI7s 2011-02-28 @13.6-15.6; gone once Rotate Your Camera is
    // done, @17.6); again after the dragon cutscene (4KO2h2xPtdM @54.8-75) and after the goblin.
    if ($p < 7 | $p = 10 | ($p >= 45 & $p <= 49)) {
        hint_npc_slot(0, 0, ^uf_hint_ring);
    }
}
if ($p < 9) {
    npc_add(~uf_cellar_coord(33, 15), tutorial3_squire, 0);
    npc_setmode(none);
}
if ($p >= 10) {
    // The dragon's fire burnt the ladder (shot 5).
    if (loc_find(~uf_cellar_coord(32, 12), tutorial3_cellar_ladder) = true) {
        loc_change(tutorial3_cellar_ladder_breaking, ^uf_cellar_obj_duration);
    }
}
if ($p >= 10 & $p < 90) {
    // At the wall over Sir Vant, as the cutscene leaves it.
    npc_add(~uf_cellar_coord(30, 18), tutorial3_dragon_initial, 0);
    npc_setmode(none);
    npc_facesquare(~uf_cellar_coord(32, 16));
}
if ($p >= 90) {
    // The start room as stage 2 has it, from the sleep cutscene on (uf_cellar_stage2).
    ~uf_cellar_stage2;
}
if ($p >= 90 & $p < 117) {
    // Asleep on its nest, as the sleep cutscene leaves it (uf_sleep.rs2), until the roof comes
    // down on it.
    ~uf_dragon_asleep;
}
if ($p >= 90 & $p < 117) {
    // By the pillars from the sleep cutscene on.
    npc_add(~uf_cellar_coord(26, 30), tutorial3_knight_waitingforbattle, 0);
    npc_setmode(none);
    npc_facesquare(~uf_cellar_coord(24, 31));
    if ($p = 93) {
        hint_npc_slot(0, 0, ^uf_hint_ring);
    }
    ~uf_bag_by_pillars;
}
if ($p >= 10 & $p < 45) {
    // At Sir Vant's bag, as the cutscene leaves it.
    npc_add(~uf_cellar_coord(34, 13), tutorial3_goblin, 0);
    npc_setmode(none);
    npc_facesquare(~uf_cellar_coord(35, 13));
    // Rummaging, as the cutscene's shot 9 leaves it (uf_dragon.rs2: seq 9963).
    npc_anim(seq_9963, 0);
    npc_settimer(1);
    if ($p >= 35) {
        hint_npc_slot(0, 0, ^uf_hint_ring);
    }
}
if ($p >= 10 & $p <= 15) {
    // The squire's kit where he burnt (shot 5), less what is already held.
    if (inv_total(inv, bronze_platebody) + inv_total(worn, bronze_platebody) = 0) {
        obj_add(~uf_cellar_coord(32, 13), bronze_platebody, 1, ^uf_cellar_obj_duration);
    }
    if (inv_total(inv, bronze_sq_shield) + inv_total(worn, bronze_sq_shield) = 0) {
        obj_add(~uf_cellar_coord(32, 13), bronze_sq_shield, 1, ^uf_cellar_obj_duration);
    }
    if (inv_total(inv, bronze_sword) + inv_total(worn, bronze_sword) = 0) {
        obj_add(~uf_cellar_coord(32, 13), bronze_sword, 1, ^uf_cellar_obj_duration);
    }
    if ($p = 15) {
        if (~uf_kit_held = 3) {
            // All three already held: on as the third pickup would.
            ~uf_gear_taken;
        } else {
            hint_coord_slot(0, 0, 2, ~uf_cellar_coord(32, 13), 0, 0, ^uf_hint_ring);
        }
    }
}
if ($p = 20) {
    // Logged in with the kit held and none of it worn: the pack's hint again (uf_gear.rs2).
    ~uf_equip_hint;
}
if ($p >= 117) {
    // After the roof came down: Roddeck's cellar in the region, Sir Vant by the rubble, Roddeck
    // out of his cupboard (uf_collapse.rs2).
    ~uf_cellar_collapsed;
    npc_add(~uf_cellar_coord(28, 31), tutorial3_knight_waitingforbattle, 0);
    npc_setmode(none);
    npc_add(~uf_cellar_coord(32, 32), tutorial3_advisor_walkoverrocks, 0);
    npc_setmode(none);
    if (%tutorial = 117) {
        %tutorial = 125;
    }
    if (%tutorial >= 160) {
        if (loc_find(~uf_cellar_coord(14, 35), tutorial3_mine_wall_start) = true & %tutorial3_tool <= 1) {
            loc_change(tutorial3_mine_wall_end, ^uf_cellar_obj_duration);
        }
        if (loc_find(~uf_cellar_coord(14, 38), tutorial3_vine_wall_start) = true & %tutorial3_tool >= 2) {
            loc_change(tutorial3_vine_wall_end, ^uf_cellar_obj_duration);
        }
    }
}
// How long 2011 left the plank on the floor: no source found. Players pick it up minutes in
// (Kw7h2jY9ANQ @265 s), so it stays for the cellar's life.
if ($p < 75 & inv_total(inv, tutorial3_plank) = 0) {
    obj_add(~uf_cellar_coord(35, 15), tutorial3_plank, 1, ^uf_cellar_obj_duration);
}

// ::ufstage <n> puts you in a fresh cellar at step n of varp 281, as a login there would.
[debugproc,ufstage](int $n)
if_close;
if (p_finduid(uid) = false) { return; }
%tutorial = $n;
~uf_start;
~initalltabs;

// Each player gets their own copy of the cellar, map square 57_77, every level. Cache 786's
// l57_77.jm2 places its bag, bowl, pillars, walls, cupboard and ladder, and the square is not part
// of the static world. The copy's (0,0) is the region's (16,16): the client's cutscene camera paths
// (cs2 2764) add 16 to every point (design note 8.2), so the square's 8x8 zones sit two zones in.
// A region nobody has been in for 50 ticks is freed; a player who logs out in it comes back to the
// tile they came from, and login builds them a fresh cellar.
[proc,uf_cellar_enter_at](int $x, int $z)
region_create(4, 10, 10);
def_int $level = 0;
def_int $a = 0;
def_int $b = 0;
while ($level < 4) {
    $a = 0;
    while ($a < 8) {
        $b = 0;
        while ($b < 8) {
            // Not yet the square's south-west 24x24 (zones x 0-2, z 0-2): the room west of the
            // start room (the practice rocks) and Explorer Jack's cellar. 2011's minimap shows
            // nothing west of the start room until the exit stage (4KO2h2xPtdM, sampled every
            // 15 s); our copy of the whole square showed a room there from the start. The
            // boundary is read off our own minimap (that room spans about x 12-24, z 5-16).
            // Nor the square's x 56-63: the start room as stage 2 has it (uf_cellar_stage2), which
            // tutorial3_1 does not draw (its subareas: x 24-55, z 0-63 and x 0-23, z 24-47).
            if (($a > 2 | $b > 2) & $a < 7) {
                region_set($level, calc(2 + $a), calc(2 + $b), movecoord(0_57_77_0_0, calc($a * 8), $level, calc($b * 8)), 0);
            }
            $b = calc($b + 1);
        }
        $a = calc($a + 1);
    }
    $level = calc($level + 1);
}
p_telejump(~uf_cellar_coord($x, $z));

// The region tile of local tile ($x, $z) of square 57_77, in the region selected last.
[proc,uf_cellar_coord](int $x, int $z)(coord)
return(region_getcoord(0, calc(16 + $x), calc(16 + $z)));

// ::ufcellar <x> <z> builds a cellar and puts you on its local tile (<x>, <z>); ::ufcellarleave
// puts you back in Lumbridge (the copy goes 50 ticks later). For matching 2011's recordings tile
// by tile.
[debugproc,ufcellar](int $x, int $z)
if_close;
if (p_finduid(uid) = false) { return; }
if (region_findbycoord(coord) = true) {
    mes("You are in a region already: ::ufcellarleave first.");
    return;
}
~uf_cellar_enter_at($x, $z);
mes("Cellar <tostring(region_uid)>, local <tostring($x)>,<tostring($z)>.");

[debugproc,ufcellarleave]
if_close;
if (p_finduid(uid) = false) { return; }
p_telejump(0_50_50_22_18);

// ::ufnpc <npc> <x> <z> adds an npc on local tile (<x>, <z>) of the cellar you stand in, to match
// the cache's npc variants (six Sir Vants) against the 2011 recordings.
[debugproc,ufnpc](npc $npc, int $x, int $z)
if (region_findbycoord(coord) = false) {
    mes("Not in a cellar: ::ufcellar first.");
    return;
}
npc_add(~uf_cellar_coord($x, $z), $npc, 0);
// Held where it is put (a dragon's default wander took it out of shot in the ufactor probe).
npc_setmode(none);

// ::ufhead <n> shows Sir Vant's first line with chathead expression n, and ::ufheadp <n> the
// player's "Hello!", to match each against the 2011 recordings frame by frame. n: 1 neutral,
// 2 shock, 3 scared, 4 confused, 5 angry, 6 quiz, 7 happy, 8 sad, 9 bored.
[debugproc,ufhead](int $n)
if (p_finduid(uid) = false) { return; }
switch_int ($n) {
    case 1 : ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,neutral>Wait a moment - there's a dragon coming!");
    case 2 : ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,shock>Wait a moment - there's a dragon coming!");
    case 3 : ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,scared>Wait a moment - there's a dragon coming!");
    case 4 : ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,confused>Wait a moment - there's a dragon coming!");
    case 5 : ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,angry>Wait a moment - there's a dragon coming!");
    case 6 : ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,quiz>Wait a moment - there's a dragon coming!");
    case 7 : ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,happy>Wait a moment - there's a dragon coming!");
    case 8 : ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,sad>Wait a moment - there's a dragon coming!");
    case 9 : ~chatnpc_specific("Sir Vant", tutorial3_knight_waitingforbattle, "<p,bored>Wait a moment - there's a dragon coming!");
}

[debugproc,ufheadp](int $n)
if (p_finduid(uid) = false) { return; }
switch_int ($n) {
    case 1 : ~chatplayer("<p,neutral>Hello!");
    case 2 : ~chatplayer("<p,shock>Hello!");
    case 3 : ~chatplayer("<p,scared>Hello!");
    case 4 : ~chatplayer("<p,confused>Hello!");
    case 5 : ~chatplayer("<p,angry>Hello!");
    case 6 : ~chatplayer("<p,quiz>Hello!");
    case 7 : ~chatplayer("<p,happy>Hello!");
    case 8 : ~chatplayer("<p,sad>Hello!");
    case 9 : ~chatplayer("<p,bored>Hello!");
}

// ::ufshot <n> runs the client's cutscene camera shot n: interface 899 tutorial3_cutscenes runs
// cs2 2765 whenever varc 1007 changes (design note 4): 1-10 the dragon, 101-107, 201-204 and
// 301-303 the later scenes, 0 back to the player's camera. Which slot 2011 opened 899 into: no
// source found; the game view's overlay slot here.
[debugproc,ufshot](int $n)
if (p_finduid(uid) = false) { return; }
if (getwindowmode = 1) {
    if_opensub(tutorial3_cutscenes, toplevel:mainoverlay);
} else {
    if_opensub(tutorial3_cutscenes, toplevel_fullscreen:mainoverlay);
}
%tutorial3_cutscene_tracker = $n;

// ::ufcreated, with character creation open, queues what an accepted name queues (cc_name.rs2's
// cc_name_loop): for a test account that already owns its name, which the name page refuses.
[debugproc,ufcreated]
queue(character_created, 0, 0);

// ::ufsong <n> plays the tutorial's tracks the 2011 wiki names, to match against recordings'
// audio: 1 Destiny, 2 The Mentor, 3 The Adventurer, 4 Harmony.
[debugproc,ufsong](int $n)
def_dbrow $song = music_Destiny;
if ($n = 2) {
    $song = music_The_Mentor;
} else if ($n = 3) {
    $song = music_The_Adventurer;
} else if ($n = 4) {
    $song = music_Harmony;
}
midi_song(db_getfield($song, music:track, 0));

// ::uffire <spotanim> <z> <height> <end height> <duration> flies a fireball candidate from (32, z),
// north of the start room's door, onto (32, 13), where the squire burns in the dragon cutscene's
// shot 5 (4KO2h2xPtdM @34.0-35.0), to find which of cache 786's spotanims 2011 used and how it
// flew. Heights are the packet's (the 647 client draws 16 units, 1/32 tile, per step).
[debugproc,uffire](spotanim $anim, int $z, int $height, int $end_height, int $duration)
if (region_findbycoord(coord) = false) {
    mes("Not in a cellar: ::ufcellar first.");
    return;
}
projanim_map(~uf_cellar_coord(32, $z), ~uf_cellar_coord(32, 13), $anim, $height, $end_height, 0, $duration, 0, 0);

// ::ufmapanim <spotanim> <height> plays a spotanim on (32, 13), the squire's tile.
[debugproc,ufmapanim](spotanim $anim, int $height)
if (region_findbycoord(coord) = false) {
    mes("Not in a cellar: ::ufcellar first.");
    return;
}
spotanim_map($anim, ~uf_cellar_coord(32, 13), $height, 0);

// ::ufspot <npc> <spotanim> plays a spotanim on the nearest npc of a type.
[debugproc,ufspot](npc $npc, spotanim $anim)
if (npc_find(coord, $npc, 16, 0) = true) {
    spotanim_npc($anim, 0, 0);
}

// ::ufat <x> <z> moves you to a tile of the cellar you are in, and ::ufnpcat <npc> <x> <z> moves
// the nearest npc of a type there (out of wander mode), and ::ufsay <npc> <text> makes it speak:
// for fitting where 2011's actors stand in each cutscene shot.
[debugproc,ufat](int $x, int $z)
if (p_finduid(uid) = false) { return; }
if (region_findbycoord(coord) = false) {
    mes("Not in a cellar: ::ufcellar first.");
    return;
}
p_telejump(~uf_cellar_coord($x, $z));

[debugproc,ufnpcat](npc $npc, int $x, int $z)
if (region_findbycoord(coord) = false) {
    mes("Not in a cellar: ::ufcellar first.");
    return;
}
if (npc_find(coord, $npc, 32, 0) = true) {
    npc_setmode(none);
    npc_tele(~uf_cellar_coord($x, $z));
}

[debugproc,ufsay](npc $npc, string $text)
if (npc_find(coord, $npc, 32, 0) = true) {
    npc_say($text);
}

// ::ufanim <seq> plays a seq on you, turned to the squire's tile (32, 13): for fitting the
// player's moves in the dragon cutscene against the recordings.
[debugproc,ufanim](int $seq)
if (p_finduid(uid) = false) { return; }
if (region_findbycoord(coord) = false) {
    mes("Not in a cellar: ::ufcellar first.");
    return;
}
facesquare(~uf_cellar_coord(32, 13));
anim($seq, 0);

// One of the tutorial's tracks, as music.rs2's music_play without its jump and without unlocking
// it: Destiny during character creation, The Mentor in the cellar (refs GAPS 6).
[proc,uf_play_song](dbrow $song)
if_settext(music_v3:now_playing_text, db_getfield($song, music:name, 0));
%currentsong = db_getfield($song, music:track, 0);
%musicstart = map_clock;
%varplayer_415 = midi_length(%currentsong);
midi_song(%currentsong);

// ::ufvanttype <npc> turns Sir Vant into one of cache 786's other Sir Vants (8851-8853, each
// with its own ready seq) for 200 ticks, to match his stance in each cutscene shot.
[debugproc,ufvanttype](npc $type)
if (region_findbycoord(coord) = false) {
    mes("Not in a cellar: ::ufcellar first.");
    return;
}
if (npc_find(coord, tutorial3_knight_waitingforbattle, 32, 0) = true) {
    npc_setmode(none);
    npc_facesquare(~uf_cellar_coord(32, 20));
    npc_changetype($type, 200);
}

// ::ufavcal plays a voice clip and snaps the camera in the same tick, so a recording shows how far
// its audio sits from its video.
[debugproc,ufavcal]
if (p_finduid(uid) = false) { return; }
cam_moveto(movecoord(coord, 6, 0, 6), 600, 100, 100);
cam_lookat(movecoord(coord, -6, 0, -6), 0, 100, 100);
~speech_line(vorbis_1284);

// ::ufhint <model> <icon> puts a hint arrow over Sir Vant with a model at the player's feet (-1 for
// none), to find the yellow ring 2011 draws under a new player (vGlx_SDOI7s @13.6, refs GAPS 18).
// ::ufhintstop clears it.
[debugproc,ufhint](int $model, int $icon)
if (region_findbycoord(coord) = false) {
    mes("Not in a cellar: ::ufcellar first.");
    return;
}
if (npc_find(coord, tutorial3_knight_waitingforbattle, 32, 0) = true) {
    hint_npc_slot(0, $icon, $model);
}

[debugproc,ufhintstop]
hint_stop_slot(0);

// ::ufcam <x> <z> <height> <lookx> <lookz> <lookheight> puts the camera on a cellar tile looking at
// another, at once, for close looks at the cutscene's actors (::ufshot 0 first: the cutscene
// interface drives the camera while it is open).
[debugproc,ufcam](int $x, int $z, int $height, int $lookx, int $lookz, int $lookheight)
if (region_findbycoord(coord) = false) {
    mes("Not in a cellar: ::ufcellar first.");
    return;
}
cam_moveto(~uf_cellar_coord($x, $z), $height, 100, 100);
cam_lookat(~uf_cellar_coord($lookx, $lookz), $lookheight, 100, 100);

// ::ufnpcanim <npc> <seq> plays a seq on the nearest npc of a type anywhere in the cellar (::animnpc
// looks only 8 tiles from the player), held still where it stands.
[debugproc,ufnpcanim](npc $npc, int $seq)
if (npc_find(coord, $npc, 40, 0) = true) {
    npc_setmode(none);
    npc_anim($seq, 0);
}

// ::ufnpcface <npc> <x> <z> turns the nearest npc of a type in the cellar toward a tile (held).
[debugproc,ufnpcface](npc $npc, int $x, int $z)
if (region_findbycoord(coord) = false) {
    mes("Not in a cellar: ::ufcellar first.");
    return;
}
if (npc_find(coord, $npc, 40, 0) = true) {
    npc_setmode(none);
    npc_facesquare(~uf_cellar_coord($x, $z));
}

// The cellar from the sleep cutscene's end (varp 281 93) on. Cache 786's world map area
// tutorial3_2 (clientscript 2785 picks it from 93; tutorial3_3, from 120, keeps these three
// subareas) draws the start room's east half, local x 32-39, z 8-23, from the square's x 56-63,
// z 0-15: the same room with a plain barrel where Sir Vant's bag stood (35, 13), no blocker in his
// doorway (32, 16), ladder 45787 for the burnt one and a few wall pieces on x 37 changed. 2011
// rebuilds in sleep cutscene 106's black: "Loading - please wait." (4KO2h2xPtdM 2011-04-30 @233).
[proc,uf_cellar_stage2]
def_int $level = 0;
while ($level < 4) {
    region_set($level, 6, 3, movecoord(0_57_77_0_0, 56, $level, 0), 0);
    region_set($level, 6, 4, movecoord(0_57_77_0_0, 56, $level, 8), 0);
    $level = calc($level + 1);
}

// Sir Vant's bag by the pillars once he is there: tutorial3_2's "Bag of supplies" (mapelement_711)
// is on (27, 29), the map's barrel there. The bag's model is a barrel with the bedroll over it, the
// sack beside and a flask in front (2011's shot 107 @234.6; @283.5-289 "Search Sir Vant's bag" by
// the pillar), and stage 2's start room has a plain barrel where the bag was: so the bag takes the
// barrel's place, as the barrel stands (angle 3: the sack on its north side, as @234.6 shows).
[proc,uf_bag_by_pillars]
if (loc_find(~uf_cellar_coord(27, 29), tutorial3_barrel) = true) {
    loc_change(tutorial3_knights_bag, ^uf_cellar_obj_duration);
}

// The dragon asleep on its nest's corner (18, 33), lying as the sleep cutscene's lie-down ends:
// facing north, its head to the north side (4KO2h2xPtdM 2011-04-30 @229.05-231.0, uf_sleep.rs2).
[proc,uf_dragon_asleep]
npc_add(~uf_cellar_coord(18, 33), tutorial3_dragon_sleeping, 0);
npc_setmode(none);
npc_facesquare(~uf_cellar_coord(20, 42));
