// Unstable Foundations' first Task, "Rotate Your Camera" (3522; struct 1702: done when varp 281
// >= 7, cs2 3227). 2011's arrival (8jKH_7To46o @56-66):
// - the Controls overlay in the game view: cache 897 tutorial3_cameracontrols (1079 is a copy);
// - its listener binds the four arrow keys to ops 1-4 (opkey1-4 96-99) and transmits them;
// - turning the camera closes it, the panel goes on to "Talk to Sir Vant", and the task system's
//   popup shows "TASK COMPLETE!" for Rotate Your Camera, with nothing in the chat box.
// Varp 281 is 6 while the overlay is up: its key lights wait for 6 (cs2 2773 returns below it);
// what else 6 meant: no source found.

[proc,uf_controls_open]
%tutorial = 6;
if (getwindowmode = 1) {
    if_opensub(tutorial3_cameracontrols, toplevel:mainoverlay);
} else {
    if_opensub(tutorial3_cameracontrols, toplevel_fullscreen:mainoverlay);
}
if_setevents(tutorial3_cameracontrols:listener, 0, 0, calc(^if_op1 | ^if_op2 | ^if_op3 | ^if_op4), 0, 0, false, false);
// The yellow arrow at the task system tab, flashing it while another tab shows (8jKH_7To46o @56,
// options open): varbit 3756 is the tab to flash, + 1 (cs2 117 flashside_vartransmit, 2756
// flashside_arrow); clicking that tab stops both (uf_tabs.rs2, uf_side_clicked).
%varplayerbit_3756 = 2;

[proc,uf_controls_close]
if (getwindowmode = 1) {
    if_closesub(toplevel:mainoverlay);
} else {
    if_closesub(toplevel_fullscreen:mainoverlay);
}

[if_button1,tutorial3_cameracontrols:listener] ~uf_camera_turned;
[if_button2,tutorial3_cameracontrols:listener] ~uf_camera_turned;
[if_button3,tutorial3_cameracontrols:listener] ~uf_camera_turned;
[if_button4,tutorial3_cameracontrols:listener] ~uf_camera_turned;

[proc,uf_camera_turned]
if (p_finduid(uid) = false) {
    return;
}
if (%tutorial ! 6) {
    return;
}
%tutorial = 7;
~uf_controls_close;
hint_stop_slot(0);
// No arrow shows after this (8jKH_7To46o @63-70, the task tab open): when 2011 cleared it, no
// source shows; here with the Task.
%varplayerbit_3756 = 0;
// Interface 1055 wakes on varc 1425 (cs2 3968) and shows the Task's title under "TASK COMPLETE!".
%varclient_1425 = 3522;
~uf_task_tab;
~uf_task_pin;

// A new Task brings the side panel round to the task system (slot 1), with no click: 4KO2h2xPtdM
// (2011-04-30) @83.75 (the inventory showing as "Kill the Goblin" comes) and @103.75 (worn
// equipment showing, "Find Out Sir Vant's Plan"), the cursor nowhere near the tab, and the Task
// panel up at every later Task in it (@140, @151, @184, @426). No clientscript switches to slot
// 1 by itself; switchside (clientscript 115) is the client's own tab switch.
[proc,uf_task_tab]
runclientscript("switchside(1)");

// The task system's panel shows the tutorial's current Task (cs2 3973 draws varbit 8576's when
// varc 1428 arrives): Rotate Your Camera while the overlay is up, then cs2 4098's Task for the
// stage (Talk to Sir Vant at 7).
[proc,uf_task_pin]
if (%tutorial < 7) {
    %varplayerbit_8576 = 3522;
} else if (%tutorial = 1000 & %tutorial3_postquest < 3) {
    // Done, Explorer Jack not yet talked to: 2011 pins Introducing...Explorer Jack (3520) from
    // the quest's end until that talk (4KO2h2xPtdM 2011-04-30 @607-640), where 4098 gives 1000
    // The Journey Begins (3521), the Task after it (in-client runs 19 and 20 showed 3521).
    %varplayerbit_8576 = 3520;
} else if (%tutorial >= 135 & %tutorial <= 160) {
    // The way out, the tool held: the panel's overview (a null-like pin, cs2 3973) until
    // level 2, then the blockage Task's summary (4KO2h2xPtdM @532 and @571.2; U9ajh4bwWsI
    // @432 and @487.0).
    ~uf_task_slots;
    if (%tutorial < 150) {
        %varplayerbit_8576 = 4091;
    } else if (%tutorial3_tool <= 1) {
        %varplayerbit_8576 = 3516;
    } else {
        %varplayerbit_8576 = 3515;
    }
} else {
    %varplayerbit_8576 = ~script4098;
}
%varclient_1428 = 0;

// The overview's slots on the way out: Discover an Exit, then the blockage's Task, by the
// client's own rules for them (4KO2h2xPtdM @532: 3514, 3516, four empty; U9ajh4bwWsI @432:
// 3514, 3515). The skill Task as a third slot at level 1 from 140 follows from the same
// rules; no recording shows the overview then. "Progress: 16/21" (@532, and still @572.4 at
// level 2): what makes up the 21 is not known, so the two numbers are set as read.
[proc,uf_task_slots]
def_int $slot = 1;
def_int $index = 3514;
while ($index <= 3518) {
    if (~task_done($index) = false & ~task_requirements_fulfilled($index) = true) {
        ~task_set_slot($slot, $index);
        $slot = add($slot, 1);
    }
    $index = add($index, 1);
}
while ($slot <= 6) {
    ~task_set_slot($slot, 4091);
    $slot = add($slot, 1);
}
%varclient_1423 = 21;
%varclient_1424 = 16;
