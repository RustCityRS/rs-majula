// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[clocktower_rat]
desc=A dirty rat.
wanderrange=6
maxrange=8
respawnrate=50
hitpoints=120
attack=10
strength=10
defence=10
param=damagetype,^stab_style
param=attack_anim,giantrat_attack
param=defend_anim,giantrat_block
param=death_anim,giantrat_death
param=attack_sound,rat_attack
param=defend_sound,rat_hit
param=death_sound,rat_death
// osrs stats and Vislvl match 1:1
