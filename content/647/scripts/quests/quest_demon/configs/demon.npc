// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[delrith]
desc=A freshly summoned demon.
wanderrange=2
maxrange=4
// TODO respawnrate?
hitpoints=70
attack=32
strength=25
defence=27
param=damagetype,^crush_style
param=attack_anim,demon_attack
param=defend_anim,demon_block
param=death_anim,demon_death
param=attack_sound,black_demon_attack
param=defend_sound,black_demon_hit
param=death_sound,black_demon_death
param=demonbane_vulnerable,yes
param=death_drop,ashes
timer=100
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_5079

[weakened_delrith]
desc=The demon doesn't look so strong now.
defaultmode=none
wanderrange=0
moverestrict=nomove
timer=100
param=death_anim,demon_portalend
param=death_sound,black_demon_death
