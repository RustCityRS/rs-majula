// 289's demonstart, on its id, 222: cache 786 splits it into Demon Slayer's
// varbits (2561 the stage, 2562-2566 the incantation's order, 2567
// Silverlight, 2568 the drain key, 2569 Delrith summoned, 6922 the sword
// case), which 2011's quest list and multilocs read, so the client must see it.
[demonstart]
scope=perm
transmit=yes

// void-634's demon_slayer_bones (demon_slayer.vars.toml): the bones Traiborn
// still wants. Server-only. 0 until he asks; ^demon_bones_given once he has
// all 25.
[demon_slayer_bones]
scope=perm

// Sir Prysin's sword in hand (varbit 6923, bit 20) while he takes Silverlight
// out of its case: npc_9359 shows sir_prysin_4657 at 1.
[varp_1366]
transmit=yes
