// The three keys to Silverlight's case: 2011's names and examines (void-634's
// demon_slayer.items.toml), 289's weight.
[silverlight_key_wizard_traiborn]
desc=The Wizard Traiborn gave me this key to Silverlight's case.
weight=1kg
tradeable=no

[silverlight_key_captain_rovin]
desc=Captain Rovin gave me this key to Silverlight's case.
weight=1kg
tradeable=no

[silverlight_key_sir_prysin]
desc=Sir Prysin dropped this key down the drain.
weight=1kg
tradeable=no

// 289's Silverlight. 2011's bonuses are 289's (2011 wiki, Silverlight: stab +9,
// slash +14, crush -2, slash def +3, crush def +2, magic def +1, str +12,
// speed 5) and so is its examine.
[silverlight]
desc=The magical sword 'Silverlight'.
wearpos=righthand
category=weapon_slash
weight=4lb
param=stabattack,9
param=slashattack,14
param=crushattack,-2
param=slashdefence,3
param=crushdefence,2
param=magicdefence,1
param=strengthbonus,12
param=attackrate,5
param=slashattack_anim,human_sword_slash
param=stabattack_anim,human_sword_stab
param=defend_anim,human_sword_def
param=slash_sound,hacksword_slash
param=stab_sound,hacksword_stab
tradeable=no
