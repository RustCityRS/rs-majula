// 2011's stake and stake hammer (2011 wiki, Stake and Stake hammer): both
// untradeable, both from Dr Harlow, and neither weighs anything. The stake
// hammer's examine is the 2011 wiki's (void-634: "...into vampyres."); the
// wear slots are as player/configs/wearpos.obj had them.
[stake]
desc=A very pointy stick.
wearpos=lefthand
tradeable=no

[stake_hammer]
desc=Specially made for driving stakes into vampires.
wearpos=righthand
tradeable=no
