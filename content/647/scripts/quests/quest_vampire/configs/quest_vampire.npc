// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[count_draynor]
desc=Stop looking and run!
hitpoints=350
attack=30
strength=25
defence=30
param=stabdefence,2
param=slashdefence,1
param=crushdefence,3
param=damagetype,^crush_style
// 2011's Count is his own model on his own skeleton (base 2688, frame set
// 3036): his render anims (bas 1669) stand in seq 3330 and walk in 3333, and
// a human animation (289's punch and block, the death default, vamp_claw)
// twists him. Of the other seqs on that skeleton, 3331 and 3332 are the two
// combat-priority (6) ones; played on him in client B, 3331 swings an arm
// down (attack), 3332 draws in behind the cape (block), and 3112 falls to
// the ground (death).
param=attack_anim,seq_3331
param=defend_anim,seq_3332
param=death_anim,seq_3112
param=attack_sound,vampire_attack
param=defend_sound,vampire_hit
param=death_sound,vampire_death
param=combat_xp_multiplier,100
timer=1
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_3481

[dr_harlow]
desc=A retired vampyre hunter.
