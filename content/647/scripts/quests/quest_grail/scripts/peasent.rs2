// 289's quests/quest_grail/scripts/peasent.rs2, line for line.
[opnpc1,unhappy_peasant]
~chatnpc("<p,sad>Woe is me!|Our crops are all failing...|how shall I feed myself this winter?");

[opnpc1,happy_peasant]
~chatnpc("<p,happy>Oh happy day!|Suddenly our crops are growing again!|It'll be a bumper harvest this year!");
