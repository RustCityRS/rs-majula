// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[restless_ghost]
desc=Eek! A ghost!
moverestrict=indoors

[skull_skeleton]
desc=It rattles when it walks.
wanderrange=3
maxrange=5
hitpoints=180
attack=10
strength=11
defence=7
param=stabdefence,5
param=slashdefence,5
param=crushdefence,-5
param=rangedefence,5
param=damagetype,^crush_style
param=attack_anim,skeleton_attack
param=defend_anim,skeleton_block
param=death_anim,skeleton_death
param=attack_sound,skeleton_attack
param=defend_sound,skelly_hit
param=death_sound,skeleton_death
param=undead,^true
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_924
