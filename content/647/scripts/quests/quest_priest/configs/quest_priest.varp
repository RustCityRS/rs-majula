[prieststart]
scope=perm

// The coffin's skull (varbit restless_ghost_coffin, 2129) and the swamp
// rocks' (rocks_restless_ghost, 2130) are bits of varp 728, which the 2011
// coffin (15061) and rocks (47713) read as multilocs (cache 786); void-634
// keeps both (persist = true).
[varp_728]
scope=perm
transmit=yes
