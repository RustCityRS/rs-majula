// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[jossik]
desc=Apparently he keeps a lighthouse.
wanderrange=5
category=shop_keeper
param=owned_shop,lighthouseshop
param=shop_sell_multiplier,1100
param=shop_buy_multiplier,550
param=shop_delta,30
param=shop_title,The Lighthouse Store

[horror_lighthousekeeeper_injured]
desc=Looks like he's in trouble...
defaultmode=none
wanderrange=0
moverestrict=nomove
timer=30

[larrissa]
desc=A fremennik girl.
wanderrange=5

[horror_girlfriend_postquest]
desc=A fremennik girl.
wanderrange=5

[dagannoth]
desc=A horror from the ocean depths...
