maxrange=10
hitpoints=220
attack=17
strength=18
defence=12
param=attackrate,5
param=attackbonus,9
param=strengthbonus,5
param=stabdefence,33
param=slashdefence,34
param=crushdefence,29
param=magicdefence,-7
param=rangedefence,33
param=damagetype,^crush_style
param=attack_anim,human_blunt_pound
param=defend_anim,human_blunt_def
param=attack_sound,warhammer_crush
param=defend_sound,blade2
