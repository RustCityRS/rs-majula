// Tribal Totem (289's quests/quest_totem/scripts/quest_totem.rs2), line for line. Sources for
// what 2011 changes: C is cache 786, W is the 2011 wiki's Tribal Totem page.
// - C moves every loc of the mansion (maps/l41_51.jm2): the front door to 0_41_51_11_55, the
//   combination door to _9_58, the delivered crate to _18_56, the stairs to _6_60, the chest
//   to 1_41_51_12_60. W walks it the same way: "go through the west door and try to go through
//   the next west door. There is a code lock", "investigate the stairs", "Climb up the
//   stairs", "Enter the room to the east. Open the chest".
// - Both doors open as tribaltotemdoor_open_inac, C's op-less loc on their model
//   (model_36451), where 289 has loc_1535.
// - The lock's screen is C's interface 369 (tribal_door): four letters, a Left and a Right
//   each and Enter, as 289's tribal_door2; the letters are set by the server as 289's are
//   (the screen has no clientscript of its own).
[oploc1,tribaltotemdoor]
if(coordz(coord) > coordz(loc_coord)) {
    ~open_and_close_door(tribaltotemdoor_open_inac, ~check_axis(coord, loc_coord, loc_angle), false);
    return;
}
mes("This door is securely locked.");

[oploc2,horncrate]
if(%totemquest >= ^totem_started) {
    if(inv_total(inv, tribal_totem_label) = 0) {
        ~mesbox("There is a label on this crate. It says; To Lord Handelmort, Handelmort Mansion, Ardougne.You carefully peel it off and take it.");
        inv_add(inv, tribal_totem_label, 1);
    } else {
        ~mesbox("You can see the gluey outline from where you peeled the address label off.");
    }
}
mes("This crate is securely fastened shut.");

[oplocu,teleportcrate]
switch_obj(last_useitem) {
    case tribal_totem_label :
        if(%totemquest >= ^totem_crate_marked) {
            mes("You have already replaced the delivery address label.");
            return;
        }
        ~mesbox("You carefully place the delivery label over the existing label, covering it completely.");
        inv_del(inv, tribal_totem_label, 1);
        %totemquest = ^totem_crate_marked;
        ~chatplayer("<p,happy>Now I just need someone to deliver it for me.");
        return;
    case default : ~displaymessage(^dm_default);
}

// for the %handlemort_traps_disabled varp, bit 0 holds the lock completion state (0/1), bits 1-20 store the current lock values (a-z -> 1-25)
// bit 21 stores the stairs trap state (0/1)
[if_button1,tribal_door:tribalenter2]
if_close;
if(testbit(%handelmort_traps_disabled, 0) = ^false) {
    if(~get_tribal_door_lock(1) = 10 & ~get_tribal_door_lock(2) = 20 & ~get_tribal_door_lock(3) = 17 & ~get_tribal_door_lock(4) = 19) {
        mes("The combination seems correct!");
        %handelmort_traps_disabled = setbit(%handelmort_traps_disabled, 0);
        return;
    }
    mes("This combination is incorrect.");
    return;
} 

// OSRS seems to have a bug with this lock puzzle where the shown letter and the stored varp value 
// can desync somehow, todo: figure out how to recreate that
[if_button1,tribal_door:tribala_left] @tribal_door_combo(1, -1);
[if_button1,tribal_door:tribalb_left] @tribal_door_combo(2, -1);
[if_button1,tribal_door:tribalc_left] @tribal_door_combo(3, -1);
[if_button1,tribal_door:tribald_left] @tribal_door_combo(4, -1);

[if_button1,tribal_door:tribala_right] @tribal_door_combo(1, 1);
[if_button1,tribal_door:tribalb_right] @tribal_door_combo(2, 1);
[if_button1,tribal_door:tribalc_right] @tribal_door_combo(3, 1);
[if_button1,tribal_door:tribald_right] @tribal_door_combo(4, 1);

[proc,clear_tribaldoor_inter]
%handelmort_traps_disabled = clearbit_range(%handelmort_traps_disabled, 0, 19);
if_settext(tribal_door:tribala, enum(int, string, alphabet, 0));
if_settext(tribal_door:tribalb, enum(int, string, alphabet, 0));
if_settext(tribal_door:tribalc, enum(int, string, alphabet, 0));
if_settext(tribal_door:tribald, enum(int, string, alphabet, 0));

[proc,calc_tribaldoor_value](int $current, int $change)(int)
def_int $stage = calc($current + $change);
if($stage > 25) {
    $stage = 0;
} else if ($stage < 0) {
    $stage = 25;
}
return ($stage);

[proc,get_tribal_door_lock](int $lock_index)(int)
return (getbit_range(%handelmort_traps_disabled, calc(5 * $lock_index - 4), calc(5 * $lock_index)));

[label,tribal_door_combo](int $lock_index, int $change)
def_int $current_stage = ~get_tribal_door_lock($lock_index);
def_int $stage = ~calc_tribaldoor_value($current_stage, $change);
%handelmort_traps_disabled = setbit_range_toint(%handelmort_traps_disabled, $stage, calc(5 * $lock_index - 4), calc(5 * $lock_index));
switch_int($lock_index) {
    case 1 : if_settext(tribal_door:tribala, enum(int, string, alphabet, $stage));
    case 2 : if_settext(tribal_door:tribalb, enum(int, string, alphabet, $stage));
    case 3 : if_settext(tribal_door:tribalc, enum(int, string, alphabet, $stage));
    case 4 : if_settext(tribal_door:tribald, enum(int, string, alphabet, $stage));
}

[oploc1,combodoor]
if(testbit(%handelmort_traps_disabled, 0) = ^false) {
    // The screen is open before its letters are set: 647 writes a modal's open at the end
    // of the tick, after a script's packets.
    if_openmain(tribal_door);
    p_delay(0);
    ~clear_tribaldoor_inter;
    return;
}
~open_and_close_door(tribaltotemdoor_open_inac, ~check_axis(coord, loc_coord, loc_angle), false);

[oploc1,totemtrapstairs]
// OSRS seems to only allow interaction from the top side of the ladder, so just going to assume
// this is probably how it worked in 2004
// C: the stairs (0_41_51_6_60, angle 3, two by two) are climbed from their east, the tile
// their forceapproach gives, where 289's are walked to from the north.
def_coord $start = movecoord(loc_coord, 2, 0, 0);
p_delay(0);
p_walk($start);
p_delay(calc(distance(coord, $start) + 1));
if(testbit(%handelmort_traps_disabled, 21) = ^true) {
    // Up as 2011's other stairs go (ladders+stairs/configs/loc_tele_2011.dbrow,
    // loc_tele_2011_368): three west of the player's tile and a level up.
    p_telejump(movecoord(coord, -3, 1, 0));
    mes("You climb up the stairs.");
    return;
}
mes("As you climb the stairs you hear a click...");
sound_synth(locked, 1, 0);
// todo: screen fade to blackout
p_delay(2);
mes("You have fallen through a trap!");
p_telejump(^totem_stairs_fail_coord);
// unfade
p_delay(2);
// 289's stat(hitpoints) * 20 / 100 + 1 hitpoints, in 2011's life points.
~damage_self(calc(((%life_points / 50) + 1) * 10));

[oploc2,totemtrapstairs]
def_coord $start = movecoord(loc_coord, 2, 0, 0);
p_delay(0);
p_walk($start);
p_delay(calc(distance(coord, $start) + 1));
if(stat(thieving) < 21) {
    mes("You don't find anything interesting");
    return;
}
// doesn't use the stage varp here either even though it could
%handelmort_traps_disabled = setbit(%handelmort_traps_disabled, 21);
// https://storage.googleapis.com/tannerdino/images/7_10.png
~mesbox("Your trained senses as a thief enable you|to see that there is a trap in these stairs.|You make a note of its location for|future reference when using these stairs.");

[oploc1,totemshutchest]
~open_chest(totemopenchest);
mes("You open the chest.");

[oploc1,totemopenchest]
if(inv_total(inv, tribal_totem) = 0 & inv_total(bank, tribal_totem) = 0) {
    ~mesbox("Inside the chest you find the tribal totem.");
    inv_add(inv, tribal_totem, 1);
} else {
    mes("The chest is empty.");
}
// Temp note: dur does not need updated
loc_change(totemshutchest, 300);

[oploc2,totemopenchest]
~close_chest(totemshutchest);
mes("You close the chest.");

[oploc2,teleportcrate]
~mesbox("There is a label on this crate. It says;");
if(%totemquest >= ^totem_crate_marked) {
    ~mesbox("To Lord Handelmort, Handelmort Mansion, Ardougne.");
}
~mesbox("Senior Patents Clerk, Chamber of Invention, The Wizards' Tower, Misthalin. The crate is securely fastened shut and ready for delivery.");

[queue,totem_quest_complete]
%totemquest = ^totem_complete;
session_log(^log_adventure, "Quest complete: Tribal Totem");
// W: "1 Quest Point", "1775 Thieving experience", "5 Swordfish", as 289. No source found shows
// 2011's scroll (W's picture of it is not on the local wiki): the sentence is 289's on one line
// (2011's scroll wraps its own), the reward lines are W's.
~send_quest_complete2(^questlist_totem, tribal_totem, 250, ^totem_questpoints, "You have completed the Tribal Totem Quest!", "1,775 Thieving XP|5 Swordfish");
stat_advance(thieving, 17750);
inv_add(inv, swordfish, 5);
