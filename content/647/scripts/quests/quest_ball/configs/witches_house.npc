// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[nora_t__hagg]
desc=Her friends call her Nor-T for short.
maxrange=50
defaultmode=patrol
timer=1
patrol1=0_45_54_50_7,0
patrol2=0_45_54_41_7,0
patrol3=0_45_54_32_7,0
patrol4=0_45_54_24_7,0
patrol5=0_45_54_32_7,0
patrol6=0_45_54_41_7,0

[shapeshifterglob]
desc=Looks unnatural.
// TODO respawnrate?
hitpoints=210
attack=18
strength=10
defence=19
param=damagetype,^crush_style
param=attack_anim,skavid_attack
param=defend_anim,skavid_block
param=death_anim,skavid_death
param=attack_sound,unarmed_punch
param=defend_sound,imp_hit
param=death_sound,imp_death
param=death_drop,null
category=witches_experiment
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_3996

