param=defend_sound,zombie_hit
param=death_sound,zombie_death
param=next_npc_type,mort_ton_local
category=category_348
huntmode=cowardly
// guess
huntrange=1
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_1293
param=attack_anim,human_unarmedpunch
param=defend_anim,human_unarmedblock
param=death_anim,human_death

