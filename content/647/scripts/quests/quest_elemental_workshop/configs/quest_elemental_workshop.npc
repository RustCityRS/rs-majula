// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[fire_elemental]
desc=A fire elemental.
respawnrate=100
hitpoints=300
attack=35
strength=35
defence=20
magic=20
ranged=20
param=death_drop,ashes
param=damagetype,^slash_style
param=attack_anim,elemental_fire_attack
param=defend_anim,elemental_fire_defend
param=death_anim,elemental_fire_death
param=attack_sound,fire_elemental_attack
param=defend_sound,fire_elemental_hit
param=death_sound,fire_elemental_death

[earth_elemental]
desc=An earth elemental.
respawnrate=100
hitpoints=350
attack=20
strength=35
defence=35
magic=10
ranged=30
param=attackrate,6
param=death_drop,swamprocks1
param=damagetype,^crush_style
param=attack_anim,elemental_earth_attack
param=defend_anim,elemental_earth_defend
param=death_anim,elemental_earth_death
param=attack_sound,earth_elemental_attack
param=defend_sound,earth_elemental_hit
param=death_sound,earth_elemental_death

