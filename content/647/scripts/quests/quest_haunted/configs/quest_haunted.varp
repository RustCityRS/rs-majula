[haunted]
scope=perm

// 289's lever bits (quest_haunted.rs2) on the cache's varp 33, as 289's id:
// 2011's levers A-F are multilocs on its bits 1-6 (varbits 1788-1793), so the
// client must see it.
[ernestlever]
scope=perm
transmit=yes

// 2011's basement doors (quest_haunted.loc): multilocs on bits 0-8 of the
// cache's varp 668 (varbits 1794-1802), a door with Open where the levers let
// it open. Recomputed after every pull.
[ernest_doors]
scope=perm
transmit=yes

// 289's, on its id, 34, which cache 786 neither transmits nor reads.
[haunted_manor_fountain_poisoned]
scope=perm
