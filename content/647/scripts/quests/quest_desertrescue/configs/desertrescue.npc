// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[ana]
desc=She looks like a tourist.
wanderrange=3

[anabarrel]
wanderrange=0
moverestrict=nomove

[female_slave]
desc=She looks like she's been down here a long time.
wanderrange=3
//There are 2 male slave npc on the osrs side that have
//a different id than the others, they have wander 3
//these 2 are the original id versions from before the rework.

[male_slave]
desc=It looks like he's been here a long time.
wanderrange=3
//There are 2 male slave npc on the osrs side that have
//a different id than the others, they have wander 3
//these 2 are the original id versions from before the rework.

[escaping_slave]
desc=He's making a break for it!

[rowdy_slave]
desc=He looks a bit aggressive.
wanderrange=3
maxrange=40
respawnrate=100
hitpoints=160
attack=7
strength=7
defence=7
magic=0
ranged=0
param=damagetype,^crush_style
param=defend_anim,human_unarmedblock
param=attack_sound,baxe_crush
huntmode=cowardly
huntrange=1
// Unknown reason osrs side this npc use unarmed attacks --attack seq_422 defend seq_424--
// osrs stats and Vislvl match 1:1

