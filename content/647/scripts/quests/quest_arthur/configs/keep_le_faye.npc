// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[renegade_knight]
desc=He isn't very friendly.
respawnrate=500
// void-634 has 470; 289's 48 hitpoints would be 480.
hitpoints=470
attack=28
strength=28
defence=28
param=attackbonus,20
param=strengthbonus,16
param=stabdefence,99
param=slashdefence,82
param=crushdefence,62
param=damagetype,^slash_style
param=attack_anim,human_unarmedpunch
param=defend_anim,human_sword_def
param=attack_sound,stabsword_stab
param=defend_sound,blade4
huntmode=cowardly
huntrange=1
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_3517

