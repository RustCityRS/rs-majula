// Shield of Arrav: 289's quests/quest_blackarmgang/scripts/quest_blackarmgang.rs2 on cache 786's
// ids (the book 757, the Phoenix half broken_shield 763, the certificate 769), with what the
// 2011-02-28 recordings (YouTube LhbN1Qi39D4 Phoenix Gang, TSNR-A0LI8s Black Arm Gang) and the
// 2011-03-02 one (UgONltQDj38) show:
// - both halves are found with "You find half of a shield, which you take." (289: "half a
//   shield"; LhbN1Qi39D4 369.6s, TSNR-A0LI8s 539.1s);
// - the curator writes each player two half-certificates (curator_haig_halen.rs2); two halves
//   used together, after "The certificate will become untradable. Continue?" (LhbN1Qi39D4 500.6s,
//   TSNR-A0LI8s 631.2s, UgONltQDj38 772.8s), make the certificate the King takes;
// - 2011's scroll: "You have completed the Shield Of Arrav Quest!", the Phoenix crossbow, "600
//   coins" (LhbN1Qi39D4 570s, TSNR-A0LI8s 676s).
[oploc2,questbookcase] // palace bookcase
if(%blackarmgang ! ^phoenixgang_started) {
    mes("A large collection of books.");
    return;
}
if(inv_total(inv, the_shield_of_arrav) > 0) {
    mes("You already own 'The Shield of Arrav', the book that was kept here.");
    return;
}
// 2011's line (LhbN1Qi39D4 38.9s, TSNR-A0LI8s 51.0s): "'The Shield Of Arrav'!", with "Of".
~chatplayer("<p,happy>Aha! 'The Shield Of Arrav'! Exactly what I was looking for.");
~mesbox("You take the book from the bookcase.");
inv_add(inv, the_shield_of_arrav, 1);

[oploc1,phoenixdoor]
// 1 tile away from player
def_boolean $leaving = ~check_axis(coord, loc_coord, loc_angle);
if(%blackarmgang >= ^phoenixgang_joined | $leaving = true) {
    ~open_hideout_door($leaving, "The door automatically opens for you.");
    return;
}
if (npc_find(coord, straven, 1, 0) = true) {
    if(%phoenixgang >= ^blackarmgang_joined) {
        @straven_blackarmdog;
    }
    if(%blackarmgang = ^phoenixgang_spoken_straven) {
        @straven_mission;
    }
    @straven_cant_enter;
}
mes("The door is securely locked.");

[oploc1,phoenixshutchest] ~open_chest(phoenixopenchest);

[oploc1,phoenixopenchest]
~mesbox("You search the chest.");
if(%blackarmgang = ^phoenixgang_complete | inv_total(inv, arravshield1) > 0 | inv_total(bank, arravshield1) > 0) {
    ~mesbox("The chest is empty.");
    return;
}
~objbox(arravshield1, "You find half of a shield, which you take.", 250, 0, 0);
inv_add(inv, arravshield1, 1);

[oploc2,phoenixopenchest] ~close_chest(phoenixshutchest);

[oploc1,phoenixdoor2] @unlock_weaponstore_door(false);
[oplocu,phoenixdoor2]
if(last_useitem = phoenixkey2) {
    @unlock_weaponstore_door(true);
}
~displaymessage(^dm_default);

[label,unlock_weaponstore_door](boolean $key_used)
def_boolean $leaving= ~check_axis(coord, loc_coord, loc_angle);
def_string $message;
if($leaving = false & $key_used = false) {
    mes("The door is securely locked.");
    return;
}
if($key_used = true) {
    $message = "You unlock the door.";
} else {
    $message = "You slip out through the door.";
}
~open_hideout_door($leaving, $message);

[proc,open_hideout_door](boolean $leaving, string $message)
def_int $x;
def_int $z;
def_int $angle = loc_angle;
def_locshape $shape = loc_shape;
def_coord $loc_coord = loc_coord;
$x, $z = ~door_open($angle, loc_shape);
def_coord $dest = $loc_coord;
sound_synth(nicedoor_open, 1, 0);
mes($message);
if ($leaving = true) {
    if (coord ! $loc_coord) {
        p_teleport($loc_coord);
        p_delay(1);
    }
    $dest = movecoord(loc_coord, $x, 0, $z);
}
p_teleport($dest);
// Temp note: dur updated
loc_change(inviswall, 3);
loc_add(movecoord($loc_coord, $x, 0, $z), inactiveposhdoor, modulo(add($angle, 1), 4), $shape, 3);

[opobj3,phoenix_crossbow]
// not a zone specific check, you can drop a crossbow in the nearby building to trigger this dialogue
if(npc_find(coord, weaponsmaster, 10, 0) = true) {
    @weaponsmaster_stop;
}
if (inv_itemspace(inv, obj_type, obj_count, inv_size(inv)) = false) {
    mes("You don't have enough inventory space to hold that item.");
    return;
}
@pickup_obj;

[oploc1,blackarmdoor]
def_boolean $leaving = ~check_axis(coord, loc_coord, loc_angle);
if(%phoenixgang >= ^blackarmgang_joined) {
    ~open_hideout_door($leaving, "You hear heavy bolts being drawn back as the door is unlocked.");
    return;
}
mes("This door seems to be locked from the inside.");

[oploc1,blackarmcupboardshut] @open_cupboard(~cupboards_use_message);
[oploc1,blackarmcupboardopen] @close_cupboard(~cupboards_use_message);

[oploc2,blackarmcupboardopen]
if(%phoenixgang = ^blackarmgang_complete | inv_total(inv, arravshield2) > 0 | inv_total(bank, arravshield2) > 0) {
    ~mesbox("The cupboard is bare.");
    return;
}
~objbox(arravshield2, "You find half of a shield, which you take.", 250, 0, 0);
inv_add(inv, arravshield2, 1);

// 2011's half-certificates (cache 786 objs 11173 and 11174, "Half certificate"; void-634's
// half_certificate_right and _left). Either used on the other asks first (title "The certificate
// will become untradable. Continue?", "Yes." / "No."; nothing is said after Yes in any of the
// three recordings) and makes the certificate (769), which the King takes.
[opheldu,arravcertificate_lft]
if(last_useitem = arravcertificate_rht) {
    @join_half_certificates;
}
~displaymessage(^dm_default);

[opheldu,arravcertificate_rht]
if(last_useitem = arravcertificate_lft) {
    @join_half_certificates;
}
~displaymessage(^dm_default);

[label,join_half_certificates]
if(~p_choice2_header("Yes.", 1, "No.", 2, "The certificate will become untradable. Continue?") ! 1) {
    return;
}
if(inv_total(inv, arravcertificate_lft) < 1 | inv_total(inv, arravcertificate_rht) < 1) {
    return;
}
inv_del(inv, arravcertificate_lft, 1);
inv_del(inv, arravcertificate_rht, 1);
inv_add(inv, arravcertificate, 1);

[queue,blackarmgang_quest_complete]
if(%blackarmgang = ^phoenixgang_joined) {
    %blackarmgang = ^phoenixgang_complete;
    session_log(^log_adventure, "Quest complete: Shield of Arrav (Phoenix Gang)");
} else {
    %phoenixgang = ^blackarmgang_complete;
    session_log(^log_adventure, "Quest complete: Shield of Arrav (Black Arm Gang)");
}
~send_quest_complete2(^questlist_blackarmgang, phoenix_crossbow, 250, ^blackarmgang_questpoints, "You have completed the Shield Of Arrav Quest!", "600 coins");
inv_del(inv, arravcertificate, 1);
inv_add(inv, coins, 600);
