// 289's Monkey Madness varbits (quest_mm.varpbit). Cache 786 has no varbit on these
// varps and none free to give them (its varbit group is the client's, checked by the CRC
// gate), so each is read and set here on 289's varp and bits, as Eadgar's Ruse reads its
// eadgar_bits with testbit.

[proc,mm_daero_option_bit_one]()(int)
return(getbit_range(%mm_flags, 0, 0));

[proc,set_mm_daero_option_bit_one](int $value)
%mm_flags = setbit_range_toint(%mm_flags, $value, 0, 0);

[proc,mm_daero_option_bit_two]()(int)
return(getbit_range(%mm_flags, 1, 1));

[proc,set_mm_daero_option_bit_two](int $value)
%mm_flags = setbit_range_toint(%mm_flags, $value, 1, 1);

