[ai_timer,mm_demon]
if(finduid(%npc_aggressive_player) = false) {
    npc_del;
    return;
}
if(inzone(1_42_143_0_0, 1_42_143_63_63, coord) = false) {
    npc_del;
}

[opnpc2,mm_demon]
if (%npc_aggressive_player ! uid) {
    mes("That is not your enemy!");
    return;
}
@player_combat_start;

[apnpc2,mm_demon] 
if (%npc_aggressive_player ! uid) {
    mes("That is not your enemy!");
    return;
}
@player_combat_start_ap;

[ai_queue1,mm_demon] ~npc_default_retaliate_ap;
[ai_opplayer2,mm_demon] npc_setmode(applayer2);
[ai_applayer2,mm_demon] @mm_demon_attack;

[label,mm_demon_attack]
if (%npc_action_delay > map_clock) {
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}

def_int $spell;
def_synth $success;
def_synth $fail;
// 289 reads each wave spell's projectile and impact off magic_spell_table. 647's rows still name
// 289's spotanims (windwave_travel and so on), which 647's pack does not have, so each packs as -1
// (rs-pack's tests/dbrow_refs_647.known.tsv) and projanim_pl fails on it: every cast was a script
// error, with no projectile. No 2011 source found shows the demon's spells (the 2011 wiki's Wind
// Wave page, 2011-05-01, only dates the players' new spell graphics, 24 June 2010): kept as 289's
// spotanims by id. Cache 786 keeps each wave's travel and impact pair (unnamed, new models): wind
// 159 and 160, water 162 and 163, earth 165 and 166, fire 156 and 157.
def_spotanim $travel;
def_spotanim $impact;
switch_int(random(4)) {
    case 0 :
        $spell = ^wind_wave;
        $success = wind_wave_all;
        $fail = wind_wave_fail;
        $travel = spotanim_159;
        $impact = spotanim_160;
    case 1 :
        $spell = ^water_wave;
        $success = water_wave_all;
        $fail = water_wave_fail;
        $travel = spotanim_162;
        $impact = spotanim_163;
    case 2 :
        $spell = ^earth_wave;
        $success = earth_wave_all;
        $fail = earth_wave_fail;
        $travel = spotanim_165;
        $impact = spotanim_166;
    case default : 
        $spell = ^fire_wave;
        $success = fire_wave_all;
        $fail = fire_wave_fail;
        $travel = spotanim_156;
        $impact = spotanim_157;
}
if(npc_range(coord) < 3) { // melee range of 2 :)
    if (random(2) = 0) {
        ~mm_demon_spellcast($spell, $success, $fail, $travel, $impact);
    } else {
        ~npc_default_attack;
    }
} else {
    ~mm_demon_spellcast($spell, $success, $fail, $travel, $impact);
}

[proc,mm_demon_spellcast](int $spell, synth $success, synth $fail, spotanim $travel, spotanim $impact)
if (~npc_combat_spell_checks = false) {
    return;
}

def_dbrow $spell_data = ~get_spell_data($spell);
// 289's ~npc_spell_cast($spell_data, 4), line for line, with the demon's travel spotanim in place
// of the row's (see mm_demon_attack) on the wave rows' flight (magic_spell_table:spotanim_proj:
// 43, 31, 51, 16, -5, 64, 10). 289's cast spotanims on the caster (windwave_casting 158,
// waterwave_casting 161, earthwave_casting 164, firewave_casting 155) are not in cache 786, so
// the demon shows none.
if_close;
npc_anim(npc_param(magicattack_anim), 0);
%npc_action_delay = add(map_clock, 4);
def_int $duration = 64;
if (db_getfieldcount($spell_data, magic_spell_table:spotanim_proj) > 0) {
    $duration = ~player_projectile(npc_coord, coord, uid, $travel, 43, 31, 51, 16, -5, 64, 10);
}
// 289's most, 31 hitpoints, in life points (x10), as the demon's own hitpoints key (all.npc) and
// 647's magic_spell_table maxhit column are. The 2011 wiki's Jungle demon page (2011-05-22) has
// "max hit = 320 (approx)"; no source found gives the exact figure.
def_int $maxhit = 310;

// it will still splash with prot prayer on, seems to just be based on hit roll
if(~check_protect_prayer(^magic_style) = true) {
    $maxhit = 0;
}

// uses the original synths for wave spells, even today
if (~npc_player_hit_roll(^magic_style) = true) {
    if_close;
    sound_synth($success, 0, $duration);
    def_int $damage = randominc($maxhit);
    if ($maxhit ! null) {
        // npc vs player spells have no 1t extra damage delay. Whereas player vs npc spells do (osrs)
        // With 2011's magic hitmark, as 647's ~npc_spell_success paints an npc's spell.
        queue(combat_damage_player, calc($duration / 30), ~combat_hit($damage, ^hitmark_magic, $maxhit));
    }
    // The wave rows' height (magic_spell_table:spotanim_target: 124).
    spotanim_pl($impact, 124, $duration);
    queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
} else {
    if_close;
    sound_synth($fail, 0, $duration);
    // splash sound would play here (still plays here even though the spells use old sounds)
    spotanim_pl(failedspell_impact, 92, $duration);
    // splashing in osrs causes insta auto retal
    queue*(playerhit_n_retaliate, 0)(npc_uid);
}
~npc_set_attack_vars;

[ai_queue3,mm_demon]
gosub(npc_death);
if(npc_findhero = ^true) {
    obj_add(npc_coord, ashes, 1, ^lootdrop_duration);
    // osrs seems to have changed this to happen before death, but the arrow is still set to garkor after death
    if(%mm_main = ^mm_completed_ch3) {
        queue(queue_defeat_jungledemon, 0, 0);
    }
}

[queue,queue_defeat_jungledemon]
~music_jingle("mission over");
%mm_main = ^mm_defeated_demon;
// if you are far enough away it wont set the arrow on osrs
// https://www.youtube.com/watch?v=YJtoktu_3qk, seems to spawn the npc if this fails?
npc_findallany(coord, 15, 0);
while(npc_findnext = true) {
    if(npc_type = mm_garkor_final_battle & %npc_aggressive_player = uid) {
        hint_npc;
        return;
    }
}
npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_garkor_final_battle, add(2000, random(200)));
hint_npc;
%npc_aggressive_player = uid;

[ai_queue4,mm_demon]
// for npc damage from the gnomes, if its killing damage it heals instead
def_int $damage = last_int;
if (npc_stat(hitpoints) = 0) {
    return;
}
if ($damage = 0) {
    npc_damage(^hitmark_block, 0);
} else {
    npc_damage(^hitmark_damage, $damage);
}
if (npc_stat(hitpoints) > 0) {
    return;
}
npc_statheal(hitpoints, 0, 15);

// 289's loc_4729-4742 are other locs in cache 786; 2011's cracks and trapdoors stand on 289's
// tiles as mm_wallcrack_* (5793-5798) and mm_trapdoor_* (5799-5806), one for one.
