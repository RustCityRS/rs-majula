// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[priestperilevilmonk1]
desc=An evil human cleric.
wanderrange=12
maxrange=14
hitpoints=200
attack=18
strength=18
defence=22
magic=25
param=damagetype,^crush_style
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_3484
param=attack_anim,human_unarmedpunch
param=defend_anim,human_blunt_def
param=death_anim,human_death
param=attack_sound,monk_of_zamorak_attack
param=defend_sound,brassclash2
param=death_sound,black_knight_death

