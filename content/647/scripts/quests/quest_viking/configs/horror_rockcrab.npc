// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[rock_crab]
desc=No one likes crabs...
wanderrange=7
maxrange=9
respawnrate=100
hitpoints=500
param=death_drop,null
param=damagetype,^crush_style
param=attack_anim,horror_crab_defend
param=defend_anim,horror_crab_attack
param=death_anim,horror_crab_hide
param=attack_sound,insect_attack
param=defend_sound,insect_hit
param=death_sound,insect_death
// osrs sounds rock_crab_attack, rock_crab_hit, rock_crab_death
// Sounds are guesses.

[rocks]
desc=A rocky outcrop.
wanderrange=0
maxrange=9
respawnrate=100
hitpoints=500
param=death_drop,null
param=attack_anim,horror_crab_defend
param=defend_anim,horror_crab_attack
param=death_anim,horror_crab_hide
param=attack_sound,insect_attack
param=defend_sound,insect_hit
param=death_sound,insect_death
huntrange=1
attackrange=1
huntmode=aggressive_ranged
// osrs sounds rock_crab_attack, rock_crab_hit, rock_crab_death
// Sounds are guesses.

