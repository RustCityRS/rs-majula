}
// 2011's: d01: ROB_P-ogto4 2011-03-01 @290; WKPggURQByY 2011-10-30 @175.
~chatplayer("<p,neutral>This must be Stikklebrix.");
// 2011's: d02: ROB_P-ogto4 2011-03-01 @292; WKPggURQByY 2011-10-30 @177.
