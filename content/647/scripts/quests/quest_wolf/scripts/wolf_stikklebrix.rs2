// No source found: how many he gives and at which line (not readable in any recording). d06
// says "enough wolf bones for Pikkupstix", who asks for two lots: two, given here.
inv_add(inv, wolf_bones, ^wolf_kit_bones);
%wolf_bones_taken = 1;
// 2011's: d06, "It looks he got" with no "like": WKPggURQByY 2011-10-30 @180; f5AzI4WjuVc
