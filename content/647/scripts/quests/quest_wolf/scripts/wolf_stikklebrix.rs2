if (inv_total(inv, wolf_bones) >= ^wolf_kit_bones) {
    // With the bones already held.
    // 2011's: d03: ROB_P-ogto4 2011-03-01 @294 (1 of 17 recordings).
    ~chatplayer("<p,neutral>I don't have time to search him. I have to get these wolf bones back to Pikkupstix so that Stikklebrix's sacrifice is not in vain.");
