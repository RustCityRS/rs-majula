// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[grubor]
desc=A rough looking thief.
hitpoints=120
attack=5
strength=8
defence=6
param=damagetype,^crush_style
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_4916

