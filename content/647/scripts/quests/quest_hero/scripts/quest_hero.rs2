// Heroes' Quest (289's quests/quest_hero/scripts/quest_hero.rs2), line for line.
[proc,has_hero_quest_requirements]()(boolean)
if (%qp < ^hero_required_questpoints | %zanaris < ^zanaris_complete | 
    %dragonquest < ^dragon_complete | %arthur < ^arthur_complete |
    (%blackarmgang < ^blackarmgang_complete & %phoenixgang < ^phoenixgang_complete)) {
  return (false);
}
return (true);

[proc,hero_in_progress]()(boolean)
if (%heroquest > ^hero_not_started & %heroquest < ^hero_complete) {
  return(true);
}
return(false);

[proc,hero_phoenix_in_progress]()(boolean)
if (%heroquest > ^hero_started & %heroquest < ^hero_phoenix_obtained_armband) {
  return(true);
}
return(false);

[proc,wearing_black_armour]()(boolean)
if((inv_total(worn, black_platelegs) > 0) & (inv_total(worn, black_platebody) > 0) & (inv_total(worn, black_full_helm) > 0)) {
    return (true);
}
return (false);

[queue,hero_quest_complete]
%heroquest = ^hero_complete;
stat_advance(attack, 30750);
stat_advance(defence, 30750);
stat_advance(strength, 30750);
stat_advance(hitpoints, 30750);
stat_advance(ranged, 20750);
stat_advance(fishing, 27250);
stat_advance(cooking, 28250);
stat_advance(woodcutting, 15750);
stat_advance(firemaking, 15750);
stat_advance(smithing, 22750);
stat_advance(mining, 25750);
stat_advance(herblore, 13250);
session_log(^log_adventure, "Quest complete: Hero's Quest");
// W (2011 wiki, Heroes' Quest, 2011-05-12): "1 quest point", access to the Heroes' Guild, and
// the twelve experience rewards as 289 (W has Smithing as "2,257", 289 2,275: one of the two is
// a slip, and 289's own source is a 2004 screenshot, so 289's stands). No source found shows
// 2011's scroll: the sentence is 289's, the reward lines are W's order.
~send_quest_complete2(^questlist_hero, dragon_battleaxe, 180, ^hero_questpoints, "You have completed the Heroes' Quest!", "Access to the Heroes' Guild|A total of 29,250 XP spread|over twelve skills");
