// 289's quests/quest_hero/scripts/objs/fire_feather.rs2, line for line but for the burn's life points.
[opobj3,hot_feather]
if (%heroquest = ^hero_not_started) {
  mes("It looks dangerously hot, and you have no reason to take it.");
  return;
}
if (inv_total(worn, ice_gloves) = 0) {
  // 289: calc((stat(hitpoints) / 8) + 1) hitpoints (OSRS wiki says "about 1/8 of current hp damage").
  // 2011 counts life points, ten to a hitpoint.
  queue(damage_player, 0, multiply(calc(((%life_points / 10) / 8) + 1), 10));
  p_delay(1);
  mes("It is too hot to take. You need something cold to pick it up with.");
  say("Ouch!");
  return;
} 
@pickup_obj;
