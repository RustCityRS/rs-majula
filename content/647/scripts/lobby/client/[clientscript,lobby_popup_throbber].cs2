// 3094
[clientscript,lobby_popup_throbber]
def_int $int0 = lobby_entergamereply;
if ($int0 ! -3 & %lobby_newuserhack = false) {
    if_setontimer(lobbyscreen:popup_throbber, null);
    return;
}
if (%lobby_newuserhack = true & $int0 = -3) {
    %lobby_newuserhack = false;
}
if (clientclock < %throbber_last) {
    return;
}
%throbber_last = calc(clientclock + 5);
switch_graphic (if_getgraphic(lobbyscreen:popup_throbber)) {
    case "loading_wheel_1,0" :
        if_setgraphic(lobbyscreen:popup_throbber, "loading_wheel_1,1");
    case "loading_wheel_1,1" :
        if_setgraphic(lobbyscreen:popup_throbber, "loading_wheel_1,2");
    case "loading_wheel_1,2" :
        if_setgraphic(lobbyscreen:popup_throbber, "loading_wheel_1,3");
    case "loading_wheel_1,3" :
        if_setgraphic(lobbyscreen:popup_throbber, "loading_wheel_1,4");
    case "loading_wheel_1,4" :
        if_setgraphic(lobbyscreen:popup_throbber, "loading_wheel_1,5");
    case "loading_wheel_1,5" :
        if_setgraphic(lobbyscreen:popup_throbber, "loading_wheel_1,6");
    case "loading_wheel_1,6" :
        if_setgraphic(lobbyscreen:popup_throbber, "loading_wheel_1,7");
    case "loading_wheel_1,7" :
        if_setgraphic(lobbyscreen:popup_throbber, "loading_wheel_1,0");
    case default :
        if_setgraphic(lobbyscreen:popup_throbber, "loading_wheel_1,0");
}
