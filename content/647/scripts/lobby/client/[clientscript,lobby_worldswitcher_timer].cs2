        if_setsize(lobbyscreen_pane_worldselect:qchat_main_div, if_getwidth(lobbyscreen_pane_worldselect:qchat_main_div), 0, ^setsize_abs, ^setsize_minus);
        if_sethide(lobbyscreen_pane_worldselect:ws_fav_divs, false);
    }
} else {
    if_sethide(lobbyscreen_pane_worldselect:ws_fav_divs, true);
}
if_sethide(lobbyscreen_pane_worldselect:please_wait, true);
if_sethide(lobbyscreen_pane_worldselect:list_content, false);
return;
