// 1420
[clientscript,flashside_timer]
def_component $component0 = ~getsideicon(calc(%varplayerbit_3756 - 1));
if ($component0 ! null) {
    if (calc(clientclock % 40) > 20) {
        if_sethide($component0, false);
        if (calc(clientclock % 40) = 21) {
            sound_synth(synth_5009, 1, 0);
        }
    } else {
        if_sethide($component0, true);
    }
}
