// 1291
[clientscript,farming_tools_main_update](component $component0, obj $obj1, int $int2, component $component3)
def_component $component4 = if_getlayer($component0);
def_int $int5 = 0;
switch_obj ($obj1) {
    case rake :
        $int5 = %farming_tools_rake;
        if_settext($component3, "<oc_name($obj1)><br>(<tostring($int5)>/<tostring($int2)>)");
    case dibber :
        $int5 = %farming_tools_dibber;
        if_settext($component3, "Dibber<br>(<tostring($int5)>/<tostring($int2)>)");
    case spade :
        $int5 = %farming_tools_spade;
        if_settext($component3, "<oc_name($obj1)><br>(<tostring($int5)>/<tostring($int2)>)");
    case gardening_trowel :
        $int5 = %farming_tools_trowel;
        if_settext($component3, "Trowel<br>(<tostring($int5)>/<tostring($int2)>)");
    case scarecrow_complete :
        $int5 = %varplayerbit_1778;
        if_settext($component3, "<oc_name($obj1)><br>(<tostring($int5)>/<tostring($int2)>)");
    case bucket_empty :
        $int5 = %farming_tools_buckets;
        if_settext($component3, "<oc_name($obj1)><br>(<tostring($int5)>/<tostring($int2)>)");
    case bucket_compost :
        $int5 = %farming_tools_compost;
        if_settext($component3, "<oc_name($obj1)><br>(<tostring($int5)>/<tostring($int2)>)");
    case bucket_supercompost :
        $int5 = %farming_tools_supercompost;
        if_settext($component3, "<oc_name($obj1)><br>(<tostring($int5)>/<tostring($int2)>)");
    case secateurs :
        $int5 = %farming_tools_secateurs;
        if_settext($component3, "<oc_name($obj1)><br>(<tostring($int5)>/<tostring($int2)>)");
        if (%farming_tools_fairysecateurs = 1) {
            $obj1 = fairy_enchanted_secateurs;
        }
    case watering_can_dummy :
        switch_int (%farming_tools_wateringcan) {
            case 10 :
                $obj1 = ft3_watering_can;
                $int5 = 1;
                if_settext($component3, "Magic watering can<br>(1/1)");
                if_setopbase($component0, "<col=ff9040>Magic watering can");
            case 9 :
                $obj1 = watering_can_8;
                $int5 = 1;
                if_settext($component3, "Watering can (8)<br>(1/1)");
                if_setopbase($component0, "<col=ff9040>Watering can (8)");
            case 8 :
                $obj1 = watering_can_7;
                $int5 = 1;
                if_settext($component3, "Watering can (7)<br>(1/1)");
                if_setopbase($component0, "<col=ff9040>Watering can (7)");
            case 7 :
                $obj1 = watering_can_6;
                $int5 = 1;
                if_settext($component3, "Watering can (6)<br>(1/1)");
                if_setopbase($component0, "<col=ff9040>Watering can (6)");
            case 6 :
                $obj1 = watering_can_5;
                $int5 = 1;
                if_settext($component3, "Watering can (5)<br>(1/1)");
                if_setopbase($component0, "<col=ff9040>Watering can (5)");
            case 5 :
                $obj1 = watering_can_4;
                $int5 = 1;
                if_settext($component3, "Watering can (4)<br>(1/1)");
                if_setopbase($component0, "<col=ff9040>Watering can (4)");
            case 4 :
                $obj1 = watering_can_3;
                $int5 = 1;
                if_settext($component3, "Watering can (3)<br>(1/1)");
                if_setopbase($component0, "<col=ff9040>Watering can (3)");
            case 3 :
                $obj1 = watering_can_2;
                $int5 = 1;
                if_settext($component3, "Watering can (2)<br>(1/1)");
                if_setopbase($component0, "<col=ff9040>Watering can (2)");
            case 2 :
                $obj1 = watering_can_1;
                $int5 = 1;
                if_settext($component3, "Watering can (1)<br>(1/1)");
                if_setopbase($component0, "<col=ff9040>Watering can (1)");
            case 1 :
                $obj1 = watering_can_0;
                $int5 = 1;
                if_settext($component3, "Watering can (0)<br>(1/1)");
                if_setopbase($component0, "<col=ff9040>Watering can (0)");
            case default :
                $int5 = 0;
                if_settext($component3, "Watering can<br>(0/1)");
                if_setopbase($component0, "<col=ff9040>Watering can");
        }
}
if_setobject_nonum($component0, $obj1, -1);
if_setoutline($component0, 1);
if ($int5 > 0) {
    if_setcolour($component3, 0x7dd764);
} else {
    if_setcolour($component3, 0x872300);
}
