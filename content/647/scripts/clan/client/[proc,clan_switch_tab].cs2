// 4400
[proc,clan_switch_tab](component $component0)
if_sethide(clan_motif_chooser:top_icon_layer, true);
if_sethide(clan_motif_chooser:scroll_bar1, true);
if_sethide(clan_motif_chooser:bottom_icon_layer, true);
if_sethide(clan_motif_chooser:scroll_bar2, true);
if_sethide(clan_motif_chooser:colour_layer, true);
if_sethide(clan_motif_chooser:com_167, true);
if_sethide(clan_motif_chooser:com_179, true);
if_sethide(clan_motif_chooser:com_191, true);
switch_component ($component0) {
    case clan_motif_chooser:com_170 :
        if_sethide(clan_motif_chooser:top_icon_layer, false);
        if_sethide(clan_motif_chooser:scroll_bar1, false);
        if_sethide(clan_motif_chooser:com_167, false);
    case clan_motif_chooser:com_182 :
        if_sethide(clan_motif_chooser:bottom_icon_layer, false);
        if_sethide(clan_motif_chooser:scroll_bar2, false);
        if_sethide(clan_motif_chooser:com_179, false);
    case clan_motif_chooser:colour_tab :
        if_sethide(clan_motif_chooser:colour_layer, false);
        if_sethide(clan_motif_chooser:com_191, false);
}
