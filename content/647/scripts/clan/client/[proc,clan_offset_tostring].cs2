// 4337
[proc,clan_offset_tostring](int $int0)(string)
def_string $string0 = "+";
if ($int0 < 0) {
    $string0 = "-";
    $int0 = calc(0 - $int0);
}
def_int $int1 = calc($int0 / 60);
def_int $int2 = calc($int0 % 60);
def_string $string1 = tostring($int1);
if ($int1 < 10) {
    $string1 = "0<tostring($int1)>";
}
def_string $string2 = tostring($int2);
if ($int2 < 10) {
    $string2 = "0<tostring($int2)>";
}
return("<$string0><$string1>:<$string2>");
