// 4378
[clientscript,clan_motto_text_init](component $component0, component $component1, component $component2)
if_setonkey($component0, "clan_motto_text_input($component0, $component1, event_keychar, event_keycode, $component2)");
if_setonclick($component0, "clan_motto_text_click($component0, $component2, event_mousex)");
if_setontimer($component0, "caret_flash(clientclock, $component2)");
