// 4369
[clientscript,clan_qfc_text_input](component $component0, char $char1, int $key2, component $component3)
%qfc_input_varc = if_gettext($component0);
switch_int ($key2) {
    case ^key_return :
        ~clan_qfc_return(1);
    case ^key_left, ^key_right, ^key_up, ^key_down, ^key_home, ^key_end :
        if (keyheld_shift = false) {
            return;
        }
        ~script1553($key2, %qfc_input_caret_varc, %qfc_input_varc);
    case ^key_backspace :
        if (string_length(%qfc_input_varc) > 0) {
            %qfc_input_varc = substring(%qfc_input_varc, 0, calc(string_length(%qfc_input_varc) - 1));
        }
    case default :
        if ($key2 = ^key_v & keyheld_ctrl = true) {
            ~clan_paste_qfc;
            return;
        }
        if (string_length(%qfc_input_varc) < 13) {
            %qfc_input_varc = ~add_to_inputstring(%qfc_input_varc, 0, $key2, $char1);
        }
}
%qfc_input_caret_varc = ~script1552(%qfc_input_caret_varc, %qfc_input_varc, verdana_11pt_regular_multiline, $component0, -1);
if_setposition($component3, %qfc_input_caret_varc, if_gety($component3), ^setpos_abs_left, ^setpos_abs_top);
if_settext($component0, %qfc_input_varc);
