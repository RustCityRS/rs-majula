[proc,clan_noticeboard_watch_tick_update](component $component0)
switch_int (%clan_event_current_varp) {
    case 1 :
        if (%clan_event_notification_1 = 0) {
            if_setgraphic($component0, "aif_checkbox_small,4");
        } else {
            if_setgraphic($component0, "aif_checkbox_small,0");
