// 1124
[clientscript,autocast_highlight_glow](component $component0)
def_int $int1 = if_gettrans($component0);
if (%autocast_highlight_glow_increasing_client = 1) {
    $int1 = calc($int1 + 1);
    if ($int1 >= 255) {
        %autocast_highlight_glow_increasing_client = 0;
    }
} else {
    $int1 = calc($int1 - 1);
    if ($int1 <= 0) {
        %autocast_highlight_glow_increasing_client = 1;
    }
}
if ($int1 > 255) {
    $int1 = 255;
} else if ($int1 < 0) {
    $int1 = 0;
}
if_settrans($component0, $int1);
