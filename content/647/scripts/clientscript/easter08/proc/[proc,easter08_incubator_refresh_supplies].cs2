// 896
[proc,easter08_incubator_refresh_supplies]
def_int $int0 = calc(116 / 12);
def_int $int1 = calc($int0 * %varplayerbit_4527);
def_int $int2 = calc($int0 * %varplayerbit_4526);
if_setposition(if_getx(easter08_incubator_side:water_indicator), calc(122 + (116 - $int1)), ^setpos_abs_left, ^setpos_abs_top, easter08_incubator_side:water_indicator);
if_setposition(if_getx(easter08_incubator_side:coal_indicator), calc(122 + (116 - $int2)), ^setpos_abs_left, ^setpos_abs_top, easter08_incubator_side:coal_indicator);
if_setsize(27, $int1, ^setsize_abs, ^setsize_abs, easter08_incubator_side:water_indicator);
if_setsize(27, $int2, ^setsize_abs, ^setsize_abs, easter08_incubator_side:coal_indicator);
