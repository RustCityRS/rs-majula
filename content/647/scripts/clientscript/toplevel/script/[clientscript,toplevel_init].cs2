// 1433
[clientscript,toplevel_init]
if (getwindowmode >= 1) {
    if_setonvarctransmit("toplevel_fovchange{varclient_184}", toplevel_fullscreen:mainoverlay);
    if_setonvarctransmit("toplevel_fovchange{varclient_184}", toplevel:main);
}
if_setonvarctransmit("meslayer_varc_update{varclient_5}", chattop:mes_layer);
if_setonresize("window_resize", toplevel_fullscreen:maingame);
if (getwindowmode >= 2) {
    if_setonvartransmit("script1850(toplevel_fullscreen:advisorbutton){learning_the_ropes, varplayer_1255}", toplevel_fullscreen:com_10);
    ~script1886(toplevel_fullscreen:advisorbutton);
} else {
    if_setonvartransmit("script1850(toplevel:advisorbutton){learning_the_ropes, varplayer_1255}", toplevel:minimap);
    ~script1886(toplevel:advisorbutton);
}
~toplevel_minimenu_setup;
