// 4553
[clientscript,friends2_switchmode](int $int0)
if ($int0 = 1) {
    if_sethide(true, friends2:friends_layer);
    if_sethide(false, friends2:ignore_layer);
    if_sethide(true, friends2:friends_button_selected);
    if_sethide(false, friends2:ignore_button_selected);
    ~ignore_init;
} else {
    if_sethide(true, friends2:ignore_layer);
    if_sethide(false, friends2:friends_layer);
    if_sethide(true, friends2:ignore_button_selected);
    if_sethide(false, friends2:friends_button_selected);
    ~friend_init;
}
