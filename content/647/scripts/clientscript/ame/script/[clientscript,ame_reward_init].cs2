while ($int5 < inv_size(macro_certer)) {
    if (inv_getnum(macro_certer, $int5) > 0) {
        ~ame_reward_createbutton($int5, $int6, $int7, $component0, $component3, $component4);
        $int6 = calc($int6 + 1);
    } else {
        ~ame_reward_blankbutton($int5, $component0);
    }
    $int5 = calc($int5 + 1);
}
$int5 = calc($int7 + ($int6 + 1) / 2 * ($int7 + 64));
if_setscrollpos($component0, 0, 0);
if ($int5 > if_getheight($component0)) {
    if_setscrollsize($component0, 0, $int5);
    ~scrollbar_vertical($component1, $component0, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
