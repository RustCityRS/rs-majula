// 2353
[clientscript,qj_begin_loading](component $component0)
if (%varclient_771 = 1) {
    if_setontimer("qj_loading_anim($component0)", $component0);
} else {
    if_setontimer(null, $component0);
    if_settext("Saving your game and loading QuestHelp", $component0);
    if_sethide(true, $component0);
    if_sethide(false, questjournal_scroll:com_14);
}
