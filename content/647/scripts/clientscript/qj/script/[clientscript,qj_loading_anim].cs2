// 2354
[clientscript,qj_loading_anim](component $component0)
if (%varclient_772 = 1) {
    if_settext("Saving your game and loading QuestHelp", $component0);
    %varclient_772 = calc(%varclient_772 + 1);
} else if (%varclient_772 = 20) {
    if_settext("Saving your game and loading QuestHelp.", $component0);
    %varclient_772 = calc(%varclient_772 + 1);
} else if (%varclient_772 = 40) {
    if_settext("Saving your game and loading QuestHelp..", $component0);
    %varclient_772 = calc(%varclient_772 + 1);
} else if (%varclient_772 = 60) {
    if_settext("Saving your game and loading QuestHelp.", $component0);
    %varclient_772 = calc(%varclient_772 + 1);
} else if (%varclient_772 = 80) {
    %varclient_772 = 1;
} else {
    %varclient_772 = calc(%varclient_772 + 1);
}
