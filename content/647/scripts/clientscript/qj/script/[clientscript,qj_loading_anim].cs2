// 2354
[clientscript,qj_loading_anim](component $component0)
if (%qj_help_anim = 1) {
    if_settext($component0, "Saving your game and loading QuestHelp");
    %qj_help_anim = calc(%qj_help_anim + 1);
} else if (%qj_help_anim = 20) {
    if_settext($component0, "Saving your game and loading QuestHelp.");
    %qj_help_anim = calc(%qj_help_anim + 1);
} else if (%qj_help_anim = 40) {
    if_settext($component0, "Saving your game and loading QuestHelp..");
    %qj_help_anim = calc(%qj_help_anim + 1);
} else if (%qj_help_anim = 60) {
    if_settext($component0, "Saving your game and loading QuestHelp.");
    %qj_help_anim = calc(%qj_help_anim + 1);
} else if (%qj_help_anim = 80) {
    %qj_help_anim = 1;
} else {
    %qj_help_anim = calc(%qj_help_anim + 1);
}
