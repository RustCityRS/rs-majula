// 771
[proc,lore_itemcount](obj $obj0)(int)
switch_obj ($obj0) {
    case snake_hide :
        return(calc(inv_total(inv, snake_hide) + inv_total(inv, snake_hide_7801)));
    case granite__500g :
        return(calc(inv_total(inv, granite__500g) + inv_total(inv, granite__2kg) + inv_total(inv, granite__5kg)));
    case red_flowers :
        return(calc(inv_total(inv, red_flowers) + inv_total(inv, flowers) + inv_total(inv, blue_flowers) + inv_total(inv, yellow_flowers) + inv_total(inv, purple_flowers) + inv_total(inv, orange_flowers) + inv_total(inv, flowers_waterfall_quest_mixed)));
    case default :
        return(~inv_total_available(inv, $obj0));
}
