[clientscript,lore_pouch_counter]
def_obj $obj0 = enum(111, 111, enum_1283, %varp_448);
if ($obj0 = bones) {
    if_settext("0", lore_stats_side:com66);
    return;
}
def_int $int1 = inv_total(inv, $obj0);
if ($int1 > 0) {
    if ($int1 > 1000000) {
        $int1 = calc($int1 / 1000000);
        if_settext("<tostring($int1)>M", lore_stats_side:com66);
        return;
    } else if ($int1 > 1000) {
        $int1 = calc($int1 / 1000);
        if_settext("<tostring($int1)>K", lore_stats_side:com66);
        return;
    } else {
        if_settext(tostring(inv_total(inv, $obj0)), lore_stats_side:com66);
        return;
    }
} else {
    if_settext("0", lore_stats_side:com66);
    return;
}
return;
