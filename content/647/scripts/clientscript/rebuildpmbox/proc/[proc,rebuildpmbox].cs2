[proc,rebuildpmbox]
if (hud_test(49414144, -1) = true) {
    if_setontimer("rebuildpmbox_timer()", private_chat:com0);
    return;
}
def_int $int0 = 0;
def_component $component1 = null;
def_int $int2 = 0;
def_int $int3 = 0;
if (reboottimer > 0) {
    $int2 = calc(reboottimer / 50 % 60);
    $int3 = calc(reboottimer / 3000);
    if ($int2 < 10) {
        if_settext("<col=ffff00>System update in: <tostring($int3)>:0<tostring($int2)>", private_chat:com5);
    } else {
        if_settext("<col=ffff00>System update in: <tostring($int3)>:<tostring($int2)>", private_chat:com5);
    }
    $int0 = 1;
    if_clearops(private_chat:com5);
    if_setonop(null, private_chat:com5);
    if_settextshadow(true, private_chat:com5);
}
def_int $int4 = 0;
def_int $int5 = 0;
def_colour $colour6 = enum(105, 105, enum_3056, %option_pm);
def_boolean $boolean7 = enum(105, 49, enum_3057, %option_pm);
if (%option_pm > 0 & (getwindowmode < 2 | %varc_int_41 ! -1)) {
    while ($int4 < 100 & $int0 < 5) {
        if (~pm_filtertest($int4) = true) {
            $component1 = enum(105, 73, enum_580, $int0);
            if_setcolour($colour6, $component1);
            if_settextshadow($boolean7, $component1);
            $int5 = chat_gethistory_length($int4);
            switch_int ($int5) {
                case 3, 7, 18:
                    if_settext("From <player_getdisplayname($int4)>: <chat_gethistory_bytypeandline($int4)>", $component1);
                case 5:
                    if_settext(chat_gethistory_bytypeandline($int4), $component1);
                case 6, 19:
                    if_settext("To <player_getdisplayname($int4)>: <chat_gethistory_bytypeandline($int4)>", $component1);
            }
            if_clearops($component1);
            if_setonop("private_op(^event_op, chat_gethistory_message($int4), $int4)", $component1);
            switch_int ($int5) {
                case 3, 6, 7:
                    if_setopbase("<col=ffffff><removetags(player_getdisplayname($int4))>", $component1);
                    if (compare(removetags(chat_playername), removetags(player_getdisplayname($int4))) ! 0) {
                        if (friend_test(chat_gethistory_message($int4)) = true) {
                            if (is_quickchat_only = false & is_subscriber = false) {
                                if_setop(7, "Message", $component1);
                            }
                        } else {
                            if_setop(7, "Add friend", $component1);
                            if_setop(8, "Add ignore", $component1);
                        }
                        if (staffmodlevel > 0 | autosetup_isactive > 0) {
                            if_setop(10, "Report abuse", $component1);
                        }
                    }
                case 18, 19:
                    if_setopbase("<col=ffffff><removetags(player_getdisplayname($int4))>", $component1);
                    if (compare(removetags(chat_playername), removetags(player_getdisplayname($int4))) ! 0) {
                        if (friend_test(chat_gethistory_message($int4)) = true) {
                            if (is_quickchat_only = false & is_subscriber = false) {
                                if_setop(7, "Message", $component1);
                            }
                        } else {
                            if_setop(7, "Add friend", $component1);
                            if_setop(8, "Add ignore", $component1);
                        }
                        if ($int5 = 18 & quickchat_phrase_getautocount(chat_gethistory_rank($int4)) > 0) {
                            if (%varc_int_132 = -1) {
                                %varc_int_132 = chat_gethistory_rank($int4);
                                %varc_string_29 = player_getdisplayname($int4);
                                %varc_int_133 = 5;
                                if (friend_test(chat_gethistory_message($int4)) = true) {
                                    if_setop(9, "Quick Response", $component1);
                                }
                            } else {
                                if_setop(9, "Quick Response", $component1);
                            }
                        }
                    }
            }
            $int0 = calc($int0 + 1);
        }
        $int4 = calc($int4 + 1);
    }
}
while ($int0 < 5) {
    $component1 = enum(105, 73, enum_580, $int0);
    if_settext("", $component1);
    if_clearops($component1);
    $int0 = calc($int0 + 1);
}
