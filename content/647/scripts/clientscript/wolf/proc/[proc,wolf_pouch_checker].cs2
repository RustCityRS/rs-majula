// 795
[proc,wolf_pouch_checker](obj $obj0)(int)
if (inv_total(inv, wolf_bones) < 1) {
    return(0);
}
if (inv_total(inv, wolf_spirit_shard) < 1) {
    return(0);
}
if (inv_total(inv, wolf_creature_charm) < 1) {
    return(0);
}
if (inv_total(inv, wolf_druid_pouch) < 1) {
    return(0);
}
return(1);
