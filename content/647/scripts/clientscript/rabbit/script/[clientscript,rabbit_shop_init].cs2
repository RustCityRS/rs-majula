// 960
[clientscript,rabbit_shop_init]
~verticalgradient(rabbit_shop:com_3, 0, 4537650, 0, 0);
~verticalgradient(rabbit_shop:bottomgradient, 4537650, 6052707, 0, 0);
if_sethide(rabbit_shop:xp_container, true);
~v2_stone_button_filled(rabbit_shop:xp_confirm);
if_setonmouseover(rabbit_shop:xp_confirm, "v2_stone_button_in_filled(event_com)");
if_setonmouseleave(rabbit_shop:xp_confirm, "v2_stone_button_filled(event_com)");
if_setonop(rabbit_shop:xp_confirm, "comp_sethide(true, rabbit_shop:xp_container)");
~v2_stone_button_filled(rabbit_shop:xp_cancel);
if_setonmouseover(rabbit_shop:xp_cancel, "v2_stone_button_in_filled(event_com)");
if_setonmouseleave(rabbit_shop:xp_cancel, "v2_stone_button_filled(event_com)");
if_setonop(rabbit_shop:xp_cancel, "comp_sethide(true, rabbit_shop:xp_container)");
~rabbit_shop_pointsupdate;
if_setonvartransmit(rabbit_shop:universe, "rabbit_shop_pointsupdate{rabbit_main}");
if_setonstattransmit(rabbit_shop:universe, "rabbit_shop_pointsupdate{farming}");
