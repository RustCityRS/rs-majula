def_int $int22 = if_getchildcount($component3);
cc_setonclick("dropdownbox_openclose($enum0, $int2, $component4, $graphic10, $component5, $component6, $component3, $colour11, $colour12, $int13, $int14, $int22, $int21, $graphic15, $graphic16, $graphic17, $graphic18, $graphic19, $graphic20)");
cc_create($component3, ^iftype_text, $int22);
cc_settext(enum(105, 115, $enum0, $int1));
cc_setposition(5, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(calc(if_getwidth($component3) - 22), if_getheight($component3), ^setsize_abs, ^setsize_abs);
cc_settextshadow(false);
