if ($int1 >= $int2) {
    cc_setcolour($colour12);
    cc_setonmouseleave("dropdownbox_mouseoutelement($component3, $int22, $colour12)");
} else {
    cc_setcolour($colour11);
    cc_setonmouseleave("dropdownbox_mouseoutelement($component3, $int22, $colour11)");
}
