// 1207
[clientscript,questjournal_setscrollpos](int $int0, int $int1)
if ($int0 <= 11) {
    if_setscrollsize(404, 215, questjournal_scroll:qj_layer1);
    ~scrollbar_resize(questjournal_scroll:scroll_bar, questjournal_scroll:qj_layer1, 0);
} else {
    if_setscrollsize(404, calc($int0 * 20), questjournal_scroll:qj_layer1);
    if ($int1 = 1) {
        ~scrollbar_resize(questjournal_scroll:scroll_bar, questjournal_scroll:qj_layer1, 0);
    } else {
        ~scrollbar_resize(questjournal_scroll:scroll_bar, questjournal_scroll:qj_layer1, calc($int0 * 20 - 180));
    }
}
