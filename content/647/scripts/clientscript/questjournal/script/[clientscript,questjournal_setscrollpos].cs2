[clientscript,questjournal_setscrollpos](int $int0, int $int1)
if ($int0 <= 11) {
    if_setscrollsize(404, 215, questjournal_scroll:scroll);
    ~scrollbar_resize(questjournal_scroll:com7, questjournal_scroll:scroll, 0);
} else {
    if_setscrollsize(404, calc($int0 * 20), questjournal_scroll:scroll);
    if ($int1 = true) {
        ~scrollbar_resize(questjournal_scroll:com7, questjournal_scroll:scroll, 0);
    } else {
        ~scrollbar_resize(questjournal_scroll:com7, questjournal_scroll:scroll, calc($int0 * 20 - 180));
    }
}
