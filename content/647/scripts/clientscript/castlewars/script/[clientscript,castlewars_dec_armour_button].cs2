// 1960
[clientscript,castlewars_dec_armour_button]
if (%varclient_1279 ! 0) {
    sound_synth(synth_9445, 1, 0);
}
%varclient_1279 = 0;
if_sethide(false, castlewars_trade:decorative_armour_layer);
if_sethide(true, castlewars_trade:consumables_layer);
if_sethide(true, castlewars_trade:misc_layer);
if_sethide(false, castlewars_trade:dec_armour_button_line);
if_sethide(true, castlewars_trade:deleteditemcontract_line);
if_sethide(true, castlewars_trade:misc_button_line);
