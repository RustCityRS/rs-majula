[clientscript,clanwars_setup_magic](int $int)
if (~clanwars_setup_clicktest($int) = false) {
    return;
}
if (map_members = false) {
    if (%varc_int_252 = true) {
        %varc_int_252 = 2;
    } else if (%varc_int_252 = 2) {
        %varc_int_252 = 3;
    } else {
        %varc_int_252 = 1;
    }
} else {
    %varc_int_252 = calc((%varc_int_252 + 1) % 4);
}
~clanwars_resynch_magic;
