$int0 = calc($int0 + 7);
$int0, $int2 = ~clanwars_updateside_textbox("~ Arena ~", $int0, $int2, $int1, 1);
$int0, $int2 = ~clanwars_updateside_textbox(struct_param(enum(105, 74, enum_1604, %varc_int_257), param_555), $int0, $int2, $int1, 0);
if ($int0 > if_getheight(clanwars_setup_side:com3)) {
    if_sethide(false, clanwars_setup_side:com4);
    if_setposition(7, 46, ^setpos_abs_left, ^setpos_abs_top, clanwars_setup_side:com3);
    if_setscrollsize(0, $int0, clanwars_setup_side:com3);
    ~scrollbar_vertical(clanwars_setup_side:com4, clanwars_setup_side:com3, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
    if (cc_find(clanwars_setup_side:com4, 1) = true) {
        ~scrollbar_vertical_doscroll(clanwars_setup_side:com4, clanwars_setup_side:com3, if_getscrolly(clanwars_setup_side:com3), 1);
