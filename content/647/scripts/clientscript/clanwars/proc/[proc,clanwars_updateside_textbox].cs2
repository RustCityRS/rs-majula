[proc,clanwars_updateside_textbox](int $int0, int $int1, int $int2, int $int3, string $string)(int, int)
cc_create(clanwars_setup_side:com3, ^iftype_text, $int1);
cc_setposition(0, $int0, ^setpos_abs_left, ^setpos_abs_top);
cc_settextfont(p12_full);
cc_settextshadow(true);
cc_setsize($int2, calc(paraheight($string, $int2, p12_full) * 12 + 5), ^setsize_abs, ^setsize_abs);
cc_settext($string);
if ($int3 = true) {
    cc_settextalign(^settextalign_centre, ^settextalign_top, 0);
    cc_setcolour(0xff981f);
    return(calc($int0 + cc_getheight + 12), calc($int1 + 1));
}
cc_settextalign(^settextalign_left, ^settextalign_top, 0);
cc_setcolour(0xc8aa64);
return(calc($int0 + cc_getheight + 5), calc($int1 + 1));
return(0, 0);
