// 1782
[proc,clanwars_resynch_accept]
if (%varplayer_1149 ! -1) {
    ~script1801;
    if (%varclient_258 = false) {
        ~v2_stone_button_out_proc(clanwars_setup:com_143);
        if_setonmouserepeat("v2_stone_button_in_filled(event_com)", clanwars_setup:com_143);
        if_setonmouseleave("v2_stone_button_out_filled(event_com)", clanwars_setup:com_143);
        if (%varclient_259 = 0) {
            if_settext("Accept", clanwars_setup:com_146);
            if_settextfont(b12_full, clanwars_setup:com_146);
        } else {
            if_settext("Accept -<br>Opponent has accepted.", clanwars_setup:com_146);
            if_settextfont(p11_full, clanwars_setup:com_146);
        }
    } else {
        ~v2_stone_button_in_proc(clanwars_setup:com_143);
        if_setonmouserepeat(null, clanwars_setup:com_143);
        if_setonmouseleave(null, clanwars_setup:com_143);
        if_settext("Waiting for opponent...", clanwars_setup:com_146);
        if_settextfont(p12_full, clanwars_setup:com_146);
    }
} else {
    ~script1802;
}
