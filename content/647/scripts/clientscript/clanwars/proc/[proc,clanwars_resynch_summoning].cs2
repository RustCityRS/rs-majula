// 1778
[proc,clanwars_resynch_summoning]
if (%clanwars_rulevarc_nosummoning = false) {
    if_setgraphic(clanwars_setup:summoning_indicator, "options_radio_buttons,2");
    if_settrans(clanwars_setup:summoning, 0);
} else {
    if_setgraphic(clanwars_setup:summoning_indicator, "options_radio_buttons,1");
    if_settrans(clanwars_setup:summoning, 225);
}
~clanwars_updateside;
