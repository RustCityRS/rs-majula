// 1779
[proc,clanwars_resynch_food]
if (%clanwars_rulevarc_nofood = false) {
    if_setgraphic(clanwars_setup:food_indicator, "options_radio_buttons,2");
    if_settrans(clanwars_setup:food, 0);
} else {
    if_setgraphic(clanwars_setup:food_indicator, "options_radio_buttons,1");
    if_settrans(clanwars_setup:food, 225);
}
~clanwars_updateside;
