// 2313
[clientscript,dob_dayarrow_click]
if (if_gethide(chatdefault:dayddlist) = true) {
    if_setvflip(true, chatdefault:dayarrow);
    if_sethide(false, chatdefault:dayddlist);
    if_sethide(false, chatdefault:dayddlistborder);
    if_sethide(false, chatdefault:dayddscroll);
    if_sethide(false, chatdefault:dayddback);
} else {
    if_setvflip(false, chatdefault:dayarrow);
    if_sethide(true, chatdefault:dayddlist);
    if_sethide(true, chatdefault:dayddlistborder);
    if_sethide(true, chatdefault:dayddscroll);
    if_sethide(true, chatdefault:dayddback);
}
if_setvflip(false, chatdefault:montharrow);
if_sethide(true, chatdefault:monthddlist);
if_sethide(true, chatdefault:monthddlistborder);
if_sethide(true, chatdefault:monthddscroll);
if_sethide(true, chatdefault:monthddback);
