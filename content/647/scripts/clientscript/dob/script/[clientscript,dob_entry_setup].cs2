// 2312
[clientscript,dob_entry_setup]
def_int $int0 = 0;
while ($int0 < 31) {
    cc_create(chatdefault:dayddlist, ^iftype_text, $int0);
    cc_setsize(46, 20, ^setsize_abs, ^setsize_abs);
    cc_setposition(4, calc($int0 * 20), ^setpos_abs_left, ^setpos_abs_top);
    cc_settextfont(b12_full);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_settext(tostring(calc($int0 + 1)));
    cc_setcolour(^white);
    cc_setop(1, "Select");
    cc_setonop("script2316($int0)");
    cc_setonmouseover("cc_text_colour_swapper(event_com, event_comsubid, ^green)");
    cc_setonmouseleave("cc_text_colour_swapper(event_com, event_comsubid, ^white)");
    $int0 = calc($int0 + 1);
}
if_setscrollsize(0, calc($int0 * 20), chatdefault:dayddlist);
~scrollbar_vertical(chatdefault:dayddscroll, chatdefault:dayddlist, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
$int0 = 0;
while ($int0 < 12) {
    cc_create(chatdefault:monthddlist, ^iftype_text, $int0);
    cc_setsize(158, 20, ^setsize_abs, ^setsize_abs);
    cc_setposition(4, calc($int0 * 20), ^setpos_abs_left, ^setpos_abs_top);
    cc_settextfont(b12_full);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_settext(enum(int, string, enum_950, $int0));
    cc_setcolour(^white);
    cc_setop(1, "Select");
    cc_setonop("script2334($int0)");
    cc_setonmouseover("cc_text_colour_swapper(event_com, event_comsubid, ^green)");
    cc_setonmouseleave("cc_text_colour_swapper(event_com, event_comsubid, ^white)");
    $int0 = calc($int0 + 1);
}
if_setscrollsize(0, calc($int0 * 20), chatdefault:monthddlist);
~scrollbar_vertical(chatdefault:monthddscroll, chatdefault:monthddlist, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
if_sethide(true, chatdefault:dayddlist);
if_sethide(true, chatdefault:dayddlistborder);
if_sethide(true, chatdefault:dayddscroll);
if_sethide(true, chatdefault:monthddlist);
if_sethide(true, chatdefault:monthddlistborder);
if_sethide(true, chatdefault:monthddscroll);
if_sethide(true, chatdefault:yearddlist);
if_sethide(true, chatdefault:yearddscroll);
if_sethide(true, chatdefault:yearddlistborder);
if_sethide(true, chatdefault:dayddback);
if_sethide(true, chatdefault:monthddback);
if_sethide(true, chatdefault:yearddback);
if_sethide(false, chatdefault:day);
if_sethide(false, chatdefault:month);
if_sethide(false, chatdefault:year);
