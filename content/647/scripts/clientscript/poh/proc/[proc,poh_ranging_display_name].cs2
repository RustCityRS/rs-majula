// 1592
[proc,poh_ranging_display_name](component $component0, component $component1, string $string0)
def_string $string1 = $string0;
def_int $int2 = if_getwidth($component0);
if (parawidth($string1, ^max_32bit_int, p12_full) > $int2) {
    while (parawidth("<$string1>...", ^max_32bit_int, p12_full) > $int2) {
        $string1 = substring($string1, 0, calc(string_length($string1) - 1));
    }
    $string1 = "<$string1>...";
    if_setonmouserepeat("addtooltip(event_com, $component1, $string0, 25, 5000)", $component0);
    if_setonmouseleave("deltooltip($component1)", $component0);
} else {
    if_setonmouserepeat(null, $component0);
    if_setonmouseleave(null, $component0);
}
if_settext($string1, $component0);
