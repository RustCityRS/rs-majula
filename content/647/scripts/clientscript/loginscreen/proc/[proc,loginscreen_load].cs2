// 2708
[proc,loginscreen_load](component $component0, component $component1, component $component2, component $component3, component $component4, component $component5)
setup_messagebox(0, 0, 4, 3, 135, 30, loadingbox_border_corner, loadingbox_border_side, tradebacking, ^white, verdana_11pt_regular);
if_setsize(loginscreen:runescape_logo, 278, 90, ^setsize_abs, ^setsize_abs);
if_setgraphic(loginscreen:runescape_logo, logo_alpha);
if_setgraphic(loginscreen:com_8, battle_title_widescreen_2);
if_setgraphic(loginscreen:com_9, battle_title_widescreen_1);
if_setgraphic(loginscreen:com_10, battle_title_widescreen_3);
if_setgraphic(loginscreen:com_11, battle_title_widescreen_4);
if_setgraphic(loginscreen:telekinetic_push, battle_title_widescreen_6);
if_setgraphic(loginscreen:com_13, battle_title_widescreen_5);
if_setgraphic(loginscreen:com_14, battle_title_widescreen_7);
if_setgraphic(loginscreen:com_15, battle_title_widescreen_8);
if_setgraphic(loginscreen:com_22, "corner_flourish,0");
if_setgraphic(loginscreen:com_97, "corner_flourish,0");
if_setgraphic(loginscreen:com_100, "corner_flourish,0");
if_setgraphic(loginscreen:general_messages_top_left, "corner_frame_1,4");
if_sethflip(loginscreen:general_messages_top_left, true);
if_setvflip(loginscreen:general_messages_top_left, true);
if_setgraphic(loginscreen:general_messages_top_right, "corner_frame_1,4");
if_sethflip(loginscreen:general_messages_top_right, false);
if_setvflip(loginscreen:general_messages_top_right, true);
if_setgraphic(loginscreen:bottom_left, "corner_frame_1,4");
if_setgraphic(loginscreen:bottom_right, "corner_frame_1,4");
unknown_command_6039(random(18));
if (%varclient_176 <= 0) {
    %varclient_176 = calc((random(5) + 1) * 10);
}
if_setonresize(loginscreen:background_layer, "login_resize");
~loginscreen_setup_login_text;
%varclient_1551 = "";
%loginscreen_password = "";
%loginscreen_pvp_warned = 0;
%login_members = false;
if_opensubclient(loginscreen:options, loginscreen_graphics_options);
~graphics_options_init(0);
if_setonclick(loginscreen_graphics_options:cancel, "loginscreen_setactivemenu(11)");
if_setonkey(loginscreen:background_layer, "loginscreen_keypress(event_keycode, event_keychar)");
~loginscreen_initialisecamera($component0, $component1, $component2, $component3, $component4, $component5);
~cursors_login;
if (frombilling = true) {
    %loginscreen_lastmenu = 11;
    %loginscreen_lastmenu_options = 11;
    ~loginscreen_setactivemenu_full(11, true, false);
} else {
    if (%graphics_options_version = 2 & detailget_toolkit ! 0) {
        %graphics_options_version = 3;
    }
    if (unknown_command_5420 = true) {
        %graphics_options_version = 3;
    }
    if (detailget_chosesafemode = false & unknown_command_5420 = false & (%graphics_options_version < 3 | detailget_safemode = true | detailget_toolkit_default = 0)) {
        %loginscreen_lastmenu = 0;
        %loginscreen_lastmenu_options = 0;
        ~loginscreen_setactivemenu_full(0, true, false);
    } else if (unknown_command_5623 = true) {
        %loginscreen_lastmenu = 5;
        %loginscreen_lastmenu_options = 5;
        ~loginscreen_setactivemenu_full(5, true, false);
        if (%varclient_1273 = true) {
            return;
        } else {
            if_setontimer(south_progress9:login_button, "login_delay(south_progress9:login_button, 0)");
        }
    } else if (~userflowflags(3) = true) {
        %loginscreen_lastmenu = 7;
        %loginscreen_lastmenu_options = 7;
        ~loginscreen_setactivemenu_full(7, true, false);
    } else {
        %loginscreen_lastmenu = 11;
        %loginscreen_lastmenu_options = 11;
        ~loginscreen_setactivemenu_full(11, true, false);
    }
}
~login_resize;
