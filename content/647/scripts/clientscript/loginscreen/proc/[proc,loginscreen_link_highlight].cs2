[proc,loginscreen_link_highlight](component $component0, component $component1, int $int2, int $int3, string $string)
if ($component0 ! null) {
    if ($int3 = true) {
        if_settext("<u=fafafa><$string></u>", $component1);
        if_setcolour(0xfafafa, $component1);
        if_setsize(op4125($string, $int2), if_getheight($component0), ^setsize_abs, ^setsize_abs, $component0);
    } else {
        if_settext("<u=c8c8c8><$string></u>", $component1);
        if_setcolour(0xc8c8c8, $component1);
        if_setsize(op4125($string, $int2), if_getheight($component0), ^setsize_abs, ^setsize_abs, $component0);
    }
}
