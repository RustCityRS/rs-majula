// 2925
[proc,loginscreen_button_highlight](component $component0, graphic $graphic1, component $component2, graphic $graphic3, component $component4, graphic $graphic5)
if ($component0 ! null) {
    if_setgraphic($graphic1, $component0);
}
if ($component2 ! null) {
    if_setgraphic($graphic3, $component2);
}
if ($component4 ! null) {
    if_setgraphic($graphic5, $component4);
}
