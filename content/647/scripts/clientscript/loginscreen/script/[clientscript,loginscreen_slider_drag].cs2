[clientscript,loginscreen_slider_drag](component $component0, component $component1, int $int2, int $int3)
def_int $int4 = max(calc(if_getwidth($component0) - if_getwidth($component1)), 1);
$int2 = min(max($int2, 0), $int4);
switch_int ($int3) {
    case 0:
        set_clientopt_6018(scale($int2, $int4, 127));
        ~loginscreen_soundvol($component0, $component1);
    case 1:
        set_clientopt_6019(scale($int2, $int4, 255));
        ~loginscreen_musicvol($component0, $component1);
    case 2:
        set_clientopt_6020(scale($int2, $int4, 127));
        ~loginscreen_bgsoundvol($component0, $component1);
    case 3:
        set_clientopt_6001(calc(min(scale($int2, $int4, 4), 3) + 1));
        ~loginscreen_brightness($component0, $component1);
    case 4:
        set_clientopt_6038(scale($int2, $int4, 255));
        ~loginscreen_loginvol($component0, $component1, 1, 1);
}
