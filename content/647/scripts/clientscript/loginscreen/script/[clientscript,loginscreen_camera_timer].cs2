[clientscript,loginscreen_camera_timer](component $component0, component $component1, component $component2)
if (clientclock < %varc_int_177) {
    return;
}
def_int $int3 = calc(%varc_int_176 % 10);
def_coord $coord4 = -1;
def_colour $colour5 = ^black;
if ($int3 = false) {
    if_sethide(false, $component2);
    if_setontimer(null, $component2);
    if_settrans(0, $component2);
    $coord4, $colour5 = ~clientscript_1239(0);
    cam_moveto($coord4, 1000, 100, 100);
    cam_lookat($coord4, 0, 100, 100);
    %varc_int_177 = calc(clientclock + 30);
    %varc_int_176 = calc(%varc_int_176 + 2);
} else if ($int3 = 2) {
    if (if_gethide($component1) = false) {
        if_setontimer("clientscript_1252($component1, 3)", $component1);
