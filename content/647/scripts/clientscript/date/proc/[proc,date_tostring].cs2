// 4582
[proc,date_tostring](int $int0, int $int1, int $int2)(string)
if ($int0 > 0) {
    if ($int1 > 0) {
        if ($int2 > 0) {
            return("<tostring($int0)> <~text_plural($int0, "day", "days")>, <tostring($int1)> <~text_plural($int0, "hour", "hours")> and <tostring($int2)> <~text_plural($int0, "minute", "minutes")>");
        } else {
            return("<tostring($int0)> <~text_plural($int0, "day", "days")> and <tostring($int1)> <~text_plural($int0, "hour", "hours")>");
        }
    } else if ($int2 > 0) {
        return("<tostring($int0)> <~text_plural($int0, "day", "days")> and <tostring($int2)> <~text_plural($int0, "minute", "minutes")>");
    } else {
        return("<tostring($int0)> <~text_plural($int0, "day", "days")>");
    }
} else if ($int1 > 0) {
    if ($int2 > 0) {
        return("<~text_plural($int0, "hour", "hours")> and <tostring($int2)> <~text_plural($int0, "minute", "minutes")>");
    } else {
        return("<tostring($int1)> <~text_plural($int0, "hour", "hours")>");
    }
} else if ($int2 > 0) {
    return("<tostring($int2)> <~text_plural($int0, "minute", "minutes")>");
} else {
    return("");
}
