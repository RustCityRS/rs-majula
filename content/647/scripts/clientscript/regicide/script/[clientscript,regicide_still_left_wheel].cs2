// 2030
[clientscript,regicide_still_left_wheel](component $component0)
if (testbit(%regicide_still_settings, 26) = ^true) {
    if_setmodelangle(0, 0, 512, 1024, 0, 1000, $component0);
} else if (testbit(%regicide_still_settings, 27) = ^true) {
    if_setmodelangle(0, 0, 512, 1536, 0, 1000, $component0);
} else if (testbit(%regicide_still_settings, 28) = ^true) {
    if_setmodelangle(0, 0, 512, 0, 0, 1000, $component0);
}
