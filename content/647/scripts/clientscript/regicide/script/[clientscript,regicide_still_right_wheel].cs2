[clientscript,regicide_still_right_wheel](component $component)
if (testbit(%varp_331, 29) = true) {
    if_setmodelangle(0, 0, 512, 1024, 0, 1000, $component);
} else if (testbit(%varp_331, 30) = true) {
    if_setmodelangle(0, 0, 512, 1536, 0, 1000, $component);
} else if (testbit(%varp_331, 31) = true) {
    if_setmodelangle(0, 0, 512, 0, 0, 1000, $component);
}
