[clientscript,regicide_still_pressure_needle](component $component)
if (testbit(%varp_331, 0) = true) {
    if_setmodelangle(0, 0, 512, 1536, 0, 400, $component);
} else if (testbit(%varp_331, 1) = true) {
    if_setmodelangle(0, 0, 512, 1664, 0, 400, $component);
} else if (testbit(%varp_331, 2) = true) {
    if_setmodelangle(0, 0, 512, 1792, 0, 400, $component);
} else if (testbit(%varp_331, 3) = true) {
    if_setmodelangle(0, 0, 512, 1920, 0, 400, $component);
} else if (testbit(%varp_331, 4) = true) {
    if_setmodelangle(0, 0, 512, 0, 0, 400, $component);
} else if (testbit(%varp_331, 5) = true) {
    if_setmodelangle(0, 0, 512, 128, 0, 400, $component);
} else if (testbit(%varp_331, 6) = true) {
    if_setmodelangle(0, 0, 512, 256, 0, 400, $component);
} else if (testbit(%varp_331, 7) = true) {
    if_setmodelangle(0, 0, 512, 384, 0, 400, $component);
} else if (testbit(%varp_331, 8) = true) {
    if_setmodelangle(0, 0, 512, 512, 0, 400, $component);
} else if (testbit(%varp_331, 9) = true) {
    if_setmodelangle(0, 0, 512, 640, 0, 400, $component);
} else if (testbit(%varp_331, 10) = true) {
    if_setmodelangle(0, 0, 512, 768, 0, 400, $component);
} else if (testbit(%varp_331, 11) = true) {
    if_setmodelangle(0, 0, 512, 896, 0, 400, $component);
} else if (testbit(%varp_331, 12) = true) {
    if_setmodelangle(0, 0, 512, 1024, 0, 400, $component);
}
