// 677
[clientscript,letter_lj_setscrollpos](int $int0)
if ($int0 <= 9) {
    if_setscrollsize(358, 225, letter_lj:com_2);
    if_sethide(true, letter_lj:com_1);
} else {
    if_sethide(false, letter_lj:com_1);
    if_setscrollsize(358, calc($int0 * 20 + 30), letter_lj:com_2);
    ~scrollbar_resize(letter_lj:com_1, letter_lj:com_2, 0);
}
