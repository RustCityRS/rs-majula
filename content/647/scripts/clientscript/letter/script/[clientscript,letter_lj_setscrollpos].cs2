[clientscript,letter_lj_setscrollpos](int $int)
if ($int <= 9) {
    if_setscrollsize(358, 225, letter_lj:com2);
    if_sethide(true, letter_lj:com1);
} else {
    if_sethide(false, letter_lj:com1);
    if_setscrollsize(358, calc($int * 20 + 30), letter_lj:com2);
    ~scrollbar_resize(letter_lj:com1, letter_lj:com2, 0);
}
