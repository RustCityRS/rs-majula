[clientscript,bowls_main_text]
def_int $int0 = inv_total(inv, cheese);
def_int $int1 = inv_total(inv, gnome_spice);
def_int $int2 = inv_total(inv, king_worm);
def_int $int3 = inv_total(inv, onion);
def_int $int4 = inv_total(inv, dwellberries);
def_int $int5 = inv_total(inv, equa_leaves);
def_int $int6 = inv_total(inv, toad_s_legs);
def_int $int7 = inv_total(inv, chocolate_bar);
def_int $int8 = inv_total(inv, potato);
if ($int2 >= 4 & ($int3 >= 2 & $int1 >= 1)) {
    if_setcolour(^green, mm9430654:com45);
} else {
    if_setcolour(^red, mm9430654:com45);
}
