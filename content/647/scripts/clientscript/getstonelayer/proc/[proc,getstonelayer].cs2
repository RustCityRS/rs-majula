[proc,getstonelayer](int $int)(component)
if (getwindowmode >= 2) {
    switch_int ($int) {
        case 0:
            return(toplevel_fullscreen:com36);
        case 1:
            return(toplevel_fullscreen:com37);
        case 2:
            return(toplevel_fullscreen:com38);
        case 3:
            return(toplevel_fullscreen:com39);
        case 4:
            return(toplevel_fullscreen:com40);
        case 5:
            return(toplevel_fullscreen:com41);
        case 6:
            return(toplevel_fullscreen:com42);
        case 7:
            return(toplevel_fullscreen:com43);
        case 8:
            return(toplevel_fullscreen:com44);
        case 9:
            return(toplevel_fullscreen:com45);
        case 10:
            return(toplevel_fullscreen:com46);
        case 11:
            return(toplevel_fullscreen:com47);
        case 12:
            return(toplevel_fullscreen:com48);
        case 13:
            return(toplevel_fullscreen:com49);
        case 14:
            return(toplevel_fullscreen:com50);
        case 15:
            return(toplevel_fullscreen:com51);
    }
} else {
    switch_int ($int) {
        case 0:
            return(toplevel:com128);
        case 1:
            return(toplevel:com129);
        case 2:
            return(toplevel:com130);
        case 3:
            return(toplevel:com131);
        case 4:
            return(toplevel:com132);
        case 5:
            return(toplevel:com133);
        case 6:
            return(toplevel:com134);
        case 7:
            return(toplevel:com135);
        case 8:
            return(toplevel:com98);
        case 9:
            return(toplevel:com99);
        case 10:
            return(toplevel:com100);
        case 11:
            return(toplevel:com101);
        case 12:
            return(toplevel:com102);
        case 13:
            return(toplevel:com103);
        case 14:
            return(toplevel:com104);
        case 15:
            return(toplevel:com105);
    }
}
return(null);
return(null);
