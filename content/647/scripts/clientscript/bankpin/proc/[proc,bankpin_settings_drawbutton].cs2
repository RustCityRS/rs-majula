// 4149
[proc,bankpin_settings_drawbutton](component $component0, string $string0, boolean $boolean1)
if ($boolean1 = true) {
    ~v2_stone_button_in_filled_proc($component0);
} else {
    ~v2_stone_button_out_filled($component0);
}
cc_create($component0, ^iftype_text, if_getnextsubid($component0));
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_settextfont(p12_full);
cc_settextshadow(true);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
if ($boolean1 = true) {
    cc_setcolour(^white);
} else {
    cc_setcolour(0xff981f);
}
cc_settext($string0);
