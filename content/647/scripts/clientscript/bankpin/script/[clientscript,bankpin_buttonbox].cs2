if (%varclient_98 >= 1) {
    if_sethide(false, $component0);
    if_setpausetext("I don't know it.", $component0);
    if_setposition(0, calc(0 - if_getheight($component1) / 2), ^setpos_abs_centre, ^setpos_abs_centre, $component1);
} else {
    if_sethide(true, $component0);
    if_clearops($component0);
