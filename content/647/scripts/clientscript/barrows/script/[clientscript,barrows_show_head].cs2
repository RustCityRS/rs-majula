[clientscript,barrows_show_head]
def_component $component = null;
if (%varc_int_1043 = -1) {
    return;
}
switch_int (%varc_int_1043) {
    case 4761, 4762:
        $component = barrows_overlay:com10;
    case 4763, 4764:
        $component = barrows_overlay:com8;
    case 4765, 4766:
        $component = barrows_overlay:com9;
    case 4767, 4768:
        $component = barrows_overlay:com11;
    case 4769, 4770:
        $component = barrows_overlay:com12;
    case 4771, 4772:
        $component = barrows_overlay:com13;
}
if ($component = null) {
    return;
}
if_setobject(%varc_int_1043, -1, $component);
if_setmodelzoom(1600, $component);
if_setmodelanim(seq_12554, $component);
