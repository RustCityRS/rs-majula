// 1715
[clientscript,barrows_show_head]
def_component $component0 = null;
if (%barrows_overlay_head = null) {
    return;
}
switch_obj (%barrows_overlay_head) {
    case barrows_interface_ahrim, barrows_interface_ahrim_green :
        $component0 = barrows_overlay:barrows_ahrim;
    case barrows_interface_dharok, barrows_interface_dharok_green :
        $component0 = barrows_overlay:barrows_dharok;
    case barrows_interface_guthan, barrows_interface_guthan_green :
        $component0 = barrows_overlay:barrows_guthan;
    case barrows_interface_karil, barrows_interface_karil_green :
        $component0 = barrows_overlay:barrows_karil;
    case barrows_interface_torag, barrows_interface_torag_green :
        $component0 = barrows_overlay:barrows_torag;
    case barrows_interface_verac, barrows_interface_verac_green :
        $component0 = barrows_overlay:barrows_verac;
}
if ($component0 = null) {
    return;
}
if_setobject($component0, %barrows_overlay_head, -1);
if_setmodelzoom($component0, 1600);
if_setmodelanim($component0, seq_12554);
