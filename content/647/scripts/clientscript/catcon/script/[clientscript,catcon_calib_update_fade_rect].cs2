// 1745
[clientscript,catcon_calib_update_fade_rect]
if (%catcon_calib_fade_delay < 1) {
    %catcon_calib_fade_delay = calc(%catcon_calib_fade_delay + 1);
    return;
}
%catcon_calib_fade_delay = 0;
if (%catcon_calib_fade_direction = 1) {
    %catcon_calib_fade = calc(%catcon_calib_fade - 9);
} else {
    %catcon_calib_fade = calc(%catcon_calib_fade + 9);
}
%catcon_calib_fade = min(%catcon_calib_fade, 255);
%catcon_calib_fade = max(%catcon_calib_fade, 0);
if_settrans(catcon_calibration_puzzle:blackout_rect, %catcon_calib_fade);
