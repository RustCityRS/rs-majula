// 2756
[proc,flashside_arrow]
if (%varplayerbit_3756 = calc(16 + 1)) {
    ~arrow_set(toplevel_fullscreen:com_orb_energy, -1, toplevel:com_orb_energy, -1);
} else if (%varplayerbit_3756 = calc(17 + 1)) {
    ~arrow_set(toplevel_fullscreen:com_172, -1, toplevel:com_183, -1);
} else if (%varplayerbit_3756 = calc(18 + 1)) {
    ~arrow_set(toplevel_fullscreen:com_178, -1, toplevel:com_179, -1);
} else if (%varplayerbit_3756 = calc(19 + 1)) {
    ~arrow_set(toplevel_fullscreen:com_171, -1, toplevel:com_177, -1);
} else {
    ~arrow_set(~getsideicon_resizeable(calc(%varplayerbit_3756 - 1)), -1, ~getsideicon(calc(%varplayerbit_3756 - 1)), -1);
}
