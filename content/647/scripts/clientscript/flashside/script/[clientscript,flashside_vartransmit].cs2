// 117
[clientscript,flashside_vartransmit]
if (%varplayerbit_3756 < 1 | %varplayerbit_3756 > 20 | ~getsidehidden(calc(%varplayerbit_3756 - 1)) = false) {
    if_setontimer(null, toplevel_fullscreen:stones_on);
    if_setontimer(null, toplevel:backhmid1_hide);
    ~arrow_set(null, -1, null, -1);
    ~subchanged;
    return;
}
~flashside_arrow;
if_setontimer("flashside_timer", toplevel_fullscreen:stones_on);
if_setontimer("flashside_timer", toplevel:backhmid1_hide);
