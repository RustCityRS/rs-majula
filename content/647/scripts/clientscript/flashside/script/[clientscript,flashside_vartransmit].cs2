[clientscript,flashside_vartransmit]
if (%varplayerbit_3756 < 1 | %varplayerbit_3756 > 20 | ~getsidehidden(calc(%varplayerbit_3756 - 1)) = false) {
    if_setontimer(toplevel_fullscreen:stones_on, null);
    if_setontimer(toplevel:backhmid1_hide, null);
    ~arrow_set(null, -1, null, -1);
    ~subchanged;
    return;
}
~flashside_arrow;
if_setontimer(toplevel_fullscreen:stones_on, "flashside_timer");
if_setontimer(toplevel:backhmid1_hide, "flashside_timer");
