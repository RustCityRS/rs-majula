[clientscript,flashside_timer]
def_component $component = ~getsideicon(calc(%varbit_3756 - 1));
if ($component ! null) {
    if (calc(clientclock % 40) > 20) {
        if_sethide(false, $component);
        if (calc(clientclock % 40) = 21) {
            sound_synth(synth_5009, 1, 0);
        }
    } else {
        if_sethide(true, $component);
    }
}
