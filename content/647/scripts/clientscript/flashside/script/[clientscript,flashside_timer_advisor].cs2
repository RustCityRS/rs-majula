[clientscript,flashside_timer_advisor]
def_component $component = ~getsideicon(8);
if (~current_side_if ! 8 & (~clientscript_1569 = false & if_hasoverlay(~getsidelayer(8)) = true)) {
    if ($component ! null) {
        if (calc(clientclock % 40) > 20) {
            if_sethide(false, $component);
            if (calc(clientclock % 40) = 21) {
                sound_synth(synth_5009, 1, 0);
            }
        } else {
            if_sethide(true, $component);
        }
    }
} else {
    ~advisor_flashside_off;
}
