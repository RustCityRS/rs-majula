// 1223
[clientscript,chosen_statue_interface_open]
if (gender = 1) {
    if_sethide(false, chosen_reward_statue_interface:female_melee);
    if_sethide(false, chosen_reward_statue_interface:female_wizard);
    if_sethide(false, chosen_reward_statue_interface:female_ranger);
    if_sethide(false, chosen_reward_statue_interface:com_26);
    if_sethide(false, chosen_reward_statue_interface:com_28);
    if_sethide(false, chosen_reward_statue_interface:female_feeding);
    if_sethide(false, chosen_reward_statue_interface:com_32);
    if_sethide(true, chosen_reward_statue_interface:male_melee);
    if_sethide(true, chosen_reward_statue_interface:male_wizard);
    if_sethide(true, chosen_reward_statue_interface:male_ranger);
    if_sethide(true, chosen_reward_statue_interface:com_25);
    if_sethide(true, chosen_reward_statue_interface:com_27);
    if_sethide(true, chosen_reward_statue_interface:male_feeding);
    if_sethide(true, chosen_reward_statue_interface:com_31);
} else {
    if_sethide(true, chosen_reward_statue_interface:female_melee);
    if_sethide(true, chosen_reward_statue_interface:female_wizard);
    if_sethide(true, chosen_reward_statue_interface:female_ranger);
    if_sethide(true, chosen_reward_statue_interface:com_26);
    if_sethide(true, chosen_reward_statue_interface:com_28);
    if_sethide(true, chosen_reward_statue_interface:female_feeding);
    if_sethide(true, chosen_reward_statue_interface:com_32);
    if_sethide(false, chosen_reward_statue_interface:male_melee);
    if_sethide(false, chosen_reward_statue_interface:male_wizard);
    if_sethide(false, chosen_reward_statue_interface:male_ranger);
    if_sethide(false, chosen_reward_statue_interface:com_25);
    if_sethide(false, chosen_reward_statue_interface:com_27);
    if_sethide(false, chosen_reward_statue_interface:male_feeding);
    if_sethide(false, chosen_reward_statue_interface:com_31);
}
