// 1223
[clientscript,chosen_statue_interface_open]
if (gender = 1) {
    if_sethide(chosen_reward_statue_interface:female_melee, false);
    if_sethide(chosen_reward_statue_interface:female_wizard, false);
    if_sethide(chosen_reward_statue_interface:female_ranger, false);
    if_sethide(chosen_reward_statue_interface:com_26, false);
    if_sethide(chosen_reward_statue_interface:com_28, false);
    if_sethide(chosen_reward_statue_interface:female_feeding, false);
    if_sethide(chosen_reward_statue_interface:com_32, false);
    if_sethide(chosen_reward_statue_interface:male_melee, true);
    if_sethide(chosen_reward_statue_interface:male_wizard, true);
    if_sethide(chosen_reward_statue_interface:male_ranger, true);
    if_sethide(chosen_reward_statue_interface:com_25, true);
    if_sethide(chosen_reward_statue_interface:com_27, true);
    if_sethide(chosen_reward_statue_interface:male_feeding, true);
    if_sethide(chosen_reward_statue_interface:com_31, true);
} else {
    if_sethide(chosen_reward_statue_interface:female_melee, true);
    if_sethide(chosen_reward_statue_interface:female_wizard, true);
    if_sethide(chosen_reward_statue_interface:female_ranger, true);
    if_sethide(chosen_reward_statue_interface:com_26, true);
    if_sethide(chosen_reward_statue_interface:com_28, true);
    if_sethide(chosen_reward_statue_interface:female_feeding, true);
    if_sethide(chosen_reward_statue_interface:com_32, true);
    if_sethide(chosen_reward_statue_interface:male_melee, false);
    if_sethide(chosen_reward_statue_interface:male_wizard, false);
    if_sethide(chosen_reward_statue_interface:male_ranger, false);
    if_sethide(chosen_reward_statue_interface:com_25, false);
    if_sethide(chosen_reward_statue_interface:com_27, false);
    if_sethide(chosen_reward_statue_interface:male_feeding, false);
    if_sethide(chosen_reward_statue_interface:com_31, false);
}
