[proc,duel2_scoreboard_build_element](component $component0, int $int1, int $int2, string $string)(int, int)
if (compare($string, "") = false) {
    return($int1, $int2);
}
cc_create($component0, ^iftype_text, $int1);
cc_settext($string);
cc_settextfont(p12_full);
def_int $int3 = paraheight($string, 430, p12_full);
if ($int3 < 1) {
    $int3 = 1;
}
cc_setsize(430, calc(14 * $int3), ^setsize_abs, ^setsize_abs);
cc_setposition(3, calc($int2 * 15 + 4), ^setpos_abs_left, ^setpos_abs_top);
cc_settextalign(^settextalign_centre, ^settextalign_top, 14);
cc_setcolour(0xaaaaaa);
cc_settextshadow(true);
return(calc($int1 + 1), calc($int2 + $int3));
return(0, 0);
