// 1192
[clientscript,duel2_spectator_init](component $component0, component $component1)
if_setsize(calc(parawidth(if_gettext($component1), 512, p12_full) + 34), if_getheight($component0), ^setsize_abs, ^setsize_abs, $component0);
if_setonvarctransmit("duel2_spectator_setcam(true){varclient_1002}", $component0);
if_setontimer("duel2_spectator_setcam(false)", $component0);
~duel2_spectator_setcam;
