[clientscript,task_side_close_hover](int $int)
if ($int = false) {
    if_setgraphic(4324, task_side:com138);
    if_setgraphic(4324, task_side:com139);
    if_setgraphic(4325, task_side:com137);
    if_setgraphic("task_arrow,1", task_side:com141);
} else {
    if_setgraphic(4322, task_side:com138);
    if_setgraphic(4322, task_side:com139);
    if_setgraphic(4323, task_side:com137);
    if_setgraphic("task_arrow,0", task_side:com141);
    ~deltooltip_action(task_side:com136);
}
