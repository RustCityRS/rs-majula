// 4034
[clientscript,task_toggle_popup]
if (%varclient_1429 = 0) {
    %varclient_1429 = 1;
    if_setgraphic("check_box_2,2", task_main:com_142);
    if_setonmouseover("task_main_popup_hover(0, 1)", task_main:com_142);
    if_setonmouseleave("task_main_popup_hover(1, 1)", task_main:com_142);
    if_setop(1, "Turn-on", task_main:com_142);
} else {
    %varclient_1429 = 0;
    if_setgraphic("check_box_2,0", task_main:com_142);
    if_setonmouseover("task_main_popup_hover(0, 0)", task_main:com_142);
    if_setonmouseleave("task_main_popup_hover(1, 0)", task_main:com_142);
    if_setop(1, "Turn-off", task_main:com_142);
}
