// 4005
[clientscript,task_side_advice_hover](int $int0)
if ($int0 = 0) {
    if_setgraphic("task_pin_but,2", task_side:advice_close_l);
    if_setgraphic("task_pin_but,2", task_side:advice_close_r);
    if_setgraphic("task_pin_but,3", task_side:advice_close_m);
    if_setgraphic("task_arrow,1", task_side:advice_close_arrow);
} else {
    if_setgraphic("task_pin_but,0", task_side:advice_close_l);
    if_setgraphic("task_pin_but,0", task_side:advice_close_r);
    if_setgraphic("task_pin_but,1", task_side:advice_close_m);
    if_setgraphic("task_arrow,0", task_side:advice_close_arrow);
    ~deltooltip_action(task_side:summary_tooltip);
}
