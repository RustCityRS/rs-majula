            $int2 = calc(cc_gety + cc_getheight + 5 - if_getscrolly(task_main:com98));
        }
        if ($int2 < 0) {
            $int2 = if_getscrolly(task_main:com98);
        } else if ($int2 > calc(if_getheight($component9) - $int7 - 25)) {
            $int2 = calc(if_getheight($component9) - $int7 - 25);
        }
        if_setsize($int5, $int7, ^setsize_abs, ^setsize_abs, task_main:com101);
        if_setposition($int1, $int2, ^setpos_abs_left, ^setpos_abs_top, task_main:com101);
