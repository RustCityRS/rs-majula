// 4023
[clientscript,task_main_close_hover](int $int0)
if ($int0 = 0) {
    if_setgraphic(task_main:close_bg_l, "task_pin_but,2");
    if_setgraphic(task_main:close_bg_r, "task_pin_but,2");
    if_setgraphic(task_main:close_bg_m, "task_pin_but,3");
    if_setgraphic(task_main:close_arrow, "task_arrow,1");
} else {
    ~deltooltip_action(task_main:summary_tooltip);
    if_setgraphic(task_main:close_bg_l, "task_pin_but,0");
    if_setgraphic(task_main:close_bg_r, "task_pin_but,0");
    if_setgraphic(task_main:close_bg_m, "task_pin_but,1");
    if_setgraphic(task_main:close_arrow, "task_arrow,0");
}
