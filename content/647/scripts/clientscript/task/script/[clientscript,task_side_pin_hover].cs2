// 4006
[clientscript,task_side_pin_hover](int $int0)
if ($int0 = 0) {
    if_setgraphic("task_pin_but,2", task_side:com_118);
    if_setgraphic("task_pin_but,2", task_side:com_119);
    if_setgraphic("task_pin_but,3", task_side:pin_button_m);
} else {
    if_setgraphic("task_pin_but,0", task_side:com_118);
    if_setgraphic("task_pin_but,0", task_side:com_119);
    if_setgraphic("task_pin_but,1", task_side:pin_button_m);
    ~deltooltip_action(task_side:summary_tooltip);
}
