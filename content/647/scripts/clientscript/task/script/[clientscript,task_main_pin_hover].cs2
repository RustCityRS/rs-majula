// 4024
[clientscript,task_main_pin_hover](int $int0)
if ($int0 = 0) {
    if_setgraphic("task_pin_but,2", task_main:com_90);
    if_setgraphic("task_pin_but,2", task_main:pin_button_r);
    if_setgraphic("task_pin_but,3", task_main:pin_button_m);
} else {
    ~deltooltip_action(task_main:summary_tooltip);
    if_setgraphic("task_pin_but,0", task_main:com_90);
    if_setgraphic("task_pin_but,0", task_main:pin_button_r);
    if_setgraphic("task_pin_but,1", task_main:pin_button_m);
}
