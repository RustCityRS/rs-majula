// 3982
[proc,task_side_list_tooltip](component $component0, string $string0)
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = 0;
def_int $int7 = 178;
def_component $component8 = task_side:com_163;
def_int $int9 = 0;
def_int $int10 = 0;
def_component $component11 = null;
if (if_find($component0) = true) {
    if (%varclient_1 < calc(clientclock + 45)) {
        if (%varclient_1 < clientclock) {
            %varclient_1 = clientclock;
        }
        %varclient_1 = calc(%varclient_1 + 2);
        return;
    }
    %varclient_1 = calc(clientclock + 55);
    if (%varclient_2 ! 1) {
        $int1 = calc(cc_getx + 5);
        $int2 = calc(cc_gety + cc_getheight + 5);
        $component11 = task_side:com_98;
        if ($component11 ! null & $int7 >= if_getwidth($component11)) {
            $int7 = if_getwidth($component11);
        }
        $int9 = calc(4 + parawidth($string0, calc($int7 - 4), p12_full));
        $int10 = calc(4 + 16 * paraheight($string0, calc($int7 - 4), p12_full));
        if ($component11 ! null) {
            $int3 = calc($int1 - if_getscrollx($component11));
            $int4 = calc($int2 - if_getscrolly($component11));
            if ($int3 < 0) {
                $int1 = if_getscrollx($component11);
                $int3 = 0;
            }
            if ($int4 < 0) {
                $int2 = if_getscrolly($component11);
                $int4 = 0;
            }
            if ($int3 > 0) {
                $int5 = calc($int3 - if_getwidth($component11) + $int9);
                if ($int5 > 0) {
                    $int1 = calc($int1 - $int5);
                }
            }
            if ($int4 > 0) {
                $int6 = calc($int4 - if_getheight($component11) + $int10);
                if ($int6 > 0) {
                    $int2 = calc($int2 - $int6 - cc_getheight - 10);
                }
            }
        }
        if ($int1 < 0) {
            $int1 = 0;
        }
        if ($int2 < 0) {
            $int2 = 0;
        }
        if_setsize($int9, $int10, ^setsize_abs, ^setsize_abs, $component8);
        if_setposition($int1, $int2, ^setpos_abs_left, ^setpos_abs_top, $component8);
        cc_deleteall($component8);
        cc_create($component8, ^iftype_rectangle, 0);
        cc_setsize(if_getwidth($component8), if_getheight($component8), ^setsize_abs, ^setsize_abs);
        cc_setfill(true);
        cc_setcolour(^black);
        cc_settrans(80);
        cc_create($component8, ^iftype_rectangle, 1);
        cc_setsize(if_getwidth($component8), if_getheight($component8), ^setsize_abs, ^setsize_abs);
        cc_setfill(false);
        cc_setcolour(^black);
        cc_create($component8, ^iftype_text, 2);
        cc_setsize(calc($int7 - 4), if_getheight($component8), ^setsize_abs, ^setsize_abs);
        cc_setposition(2, 0, ^setpos_abs_left, ^setpos_abs_top);
        cc_settext($string0);
        cc_settextalign(^settextalign_left, ^settextalign_centre, 16);
        cc_settextfont(p12_full);
