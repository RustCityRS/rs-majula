[clientscript,ql4_tooltip](int $int)
def_string $string = "";
switch_int ($int) {
    case 12451849, 12451850:
        if (%varc_int_692 = true) {
            $string = "Click to hide the quests you cannot start.<br><br>Some recommended stats and abilities (such as combat levels) are left for you to decide.";
        } else {
            $string = "Click to show all quests regardless of requirements.";
        }
    case 12451851, 12451852:
        if (%varc_int_692 = true) {
            $string = "Click to hide the quests you have completed.";
        } else {
            $string = "Click to show all quests regardless of completion status.";
        }
}
~addtooltip_action_dynamic(questlist_v4:com19, -1, questlist_v4:com20, $string, 25, 450);
