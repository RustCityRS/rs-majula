// 596
[clientscript,stock_offercount_minus]
def_string $string0 = null;
if (%stock_offercount_visible > 0) {
    %stock_offercount_visible = calc(%stock_offercount_visible - 1);
    $string0 = tostring_localised(%stock_offercount_visible, true);
    if_settext(stockmarket:offercount, $string0);
    ~sm_offercount_settimer;
}
