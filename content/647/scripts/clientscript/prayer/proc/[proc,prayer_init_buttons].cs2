// 1717
[proc,prayer_init_buttons]
if (%varclient_181 = true) {
    cc_deleteall(prayer:glow);
    cc_deleteall(prayer:prayer_buttons);
    if_sethide(false, prayer:customise);
    if_sethide(true, prayer:prayer_level_layer);
    ~prayer_load_customise(prayer:customise);
    ~prayer_load_buttons(prayer:prayer_buttons);
    if_sethide(true, prayer:stats_layer);
    cc_deleteall(prayer:scrollbar_layer);
    if_setscrollpos(0, 0, prayer:prayer_and_glow_layer);
    if_setsize(16384, 16384, ^setsize_rel, ^setsize_rel, prayer:prayer_and_glow_layer);
} else {
    cc_deleteall(prayer:customise);
    if_sethide(true, prayer:customise);
    if_sethide(false, prayer:prayer_level_layer);
    ~prayer_load_buttons(prayer:prayer_buttons);
    ~prayer_load_glow(prayer:glow);
    if_sethide(false, prayer:stats_layer);
    if_setsize(16384, calc(if_getheight(prayer:stats_layer) + if_getheight(prayer:prayer_level_layer)), ^setsize_rel, ^setsize_minus, prayer:prayer_and_glow_layer);
    ~prayer_refresh_scrollbar;
}
