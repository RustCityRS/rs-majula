// 1717
[proc,prayer_init_buttons]
if (%varclient_181 = 1) {
    cc_deleteall(prayer:com_7);
    cc_deleteall(prayer:com_8);
    if_sethide(false, prayer:com_42);
    if_sethide(true, prayer:com_0);
    ~prayer_load_customise(prayer:com_42);
    ~prayer_load_buttons(prayer:com_8);
    if_sethide(true, prayer:com_9);
    cc_deleteall(prayer:com_6);
    if_setscrollpos(0, 0, prayer:com_5);
    if_setsize(16384, 16384, ^setsize_rel, ^setsize_rel, prayer:com_5);
} else {
    cc_deleteall(prayer:com_42);
    if_sethide(true, prayer:com_42);
    if_sethide(false, prayer:com_0);
    ~prayer_load_buttons(prayer:com_8);
    ~prayer_load_glow(prayer:com_7);
    if_sethide(false, prayer:com_9);
    if_setsize(16384, calc(if_getheight(prayer:com_9) + if_getheight(prayer:com_0)), ^setsize_rel, ^setsize_minus, prayer:com_5);
    ~prayer_refresh_scrollbar;
}
