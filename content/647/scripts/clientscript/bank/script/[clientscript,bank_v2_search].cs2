// 1471
[clientscript,bank_v2_search]
if_clearops(bank_v2_main:bank_search_button);
if_setonop(null, bank_v2_main:bank_search_button);
%varclient_190 = false;
if (%varclient_188 = false) {
    %open_bank_tab = 0;
    ~bank_v2_searchmode_on;
} else {
    %open_bank_tab = 1;
    ~bank_v2_searchmode_off;
}
