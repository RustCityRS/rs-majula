// 1459
[proc,bank_v2_build_tabs]
def_int $int0 = 2;
def_int $int1 = 0;
def_int $int2 = 0;
while ($int0 <= 9) {
    switch_int ($int0) {
        case 2 :
            $int1 = %bank_tab_1;
        case 3 :
            $int1 = %bank_tab_2;
        case 4 :
            $int1 = %bank_tab_3;
        case 5 :
            $int1 = %bank_tab_4;
        case 6 :
            $int1 = %bank_tab_5;
        case 7 :
            $int1 = %bank_tab_6;
        case 8 :
            $int1 = %bank_tab_7;
        case 9 :
            $int1 = %bank_tab_8;
    }
    if ($int1 > 0) {
        ~bank_v2_build_tab_occupied($int0, ~bank_v2_get_firstslot($int0));
    } else if ($int2 = 0) {
        ~bank_v2_build_tab_add($int0);
        $int2 = 1;
    } else {
        ~bank_v2_build_tab_hide($int0);
    }
    $int0 = calc($int0 + 1);
}
~bank_v2_tab_highlight(%open_bank_tab);
