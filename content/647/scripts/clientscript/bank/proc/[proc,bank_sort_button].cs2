[proc,bank_sort_button]
def_string $string = "";
if (%bankinsert = false) {
    if_setgraphic("bank_buttons_new2,0", bank_v2_main:com15);
    if_setgraphic("bank_buttons_new1,2", bank_v2_main:com16);
    $string = "Switch to insert items mode";
} else {
    if_setgraphic("bank_buttons_new2,2", bank_v2_main:com15);
    if_setgraphic("bank_buttons_new1,3", bank_v2_main:com16);
    $string = "Switch to swap items mode";
}
if_setop(1, $string, bank_v2_main:com15);
if_setonmouserepeat("addtooltip(^event_com, bank_v2_main:com119, $string, 25, 150)", bank_v2_main:com15);
