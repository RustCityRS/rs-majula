if (~bank_v2_get_tab_size($int1) > 0) {
    if ($int0 = 1) {
        if (%varclient_188 = true) {
            ~bank_v2_searchmode_off;
        }
        ~bank_v2_hide_all;
        ~bank_v2_show_range(~bank_v2_get_tab_range($int1));
