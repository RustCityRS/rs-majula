        ~scrollbar_ondrag_doscroll(bank_v2_main:com_114, bank_v2_main:bank_v2_inv, if_getscrolly(bank_v2_main:bank_v2_inv), 1);
        %open_bank_tab = $int1;
    } else if ($int0 = 2) {
