// 1475
[proc,bank_v2_search_update]
%varclient_1657 = %meslayerinput;
if (clientclock > %varclient_191) {
    ~bank_v2_show_search(%varclient_1657);
    if_setontimer(bank_v2_main:bank_search_button, null);
    %varclient_191 = calc(clientclock + 10);
} else {
    if_setontimer(bank_v2_main:bank_search_button, "bank_v2_search_delayed(%varclient_191)");
}
