[proc,bank_v2_searchmode_off]
if_sethide(true, bank_v2_main:message_nomatches);
if_sethide(true, bank_v2_main:message_nosearch);
if_setgraphic("bank_buttons_new1,0", bank_v2_main:bank_search_icon);
if_setgraphic("bank_buttons_new2,0", bank_v2_main:bank_search_button);
if (%open_bank_tab = 0) {
    ~bank_v2_show_all;
}
~bank_v2_tab_highlight(1);
%varclient_1657 = "";
~meslayer_close(11);
%varclient_188 = false;
if_settext("Bank of RuneScape", bank_v2_main:title);
if_setontimer(null, bank_v2_main:bank_search_button);
