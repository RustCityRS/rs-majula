// 2319
[proc,bank_v2_showequipscreen]
if (%bank_hidden = 1) {
    if_sethide(true, bank_v2_main:com_0);
    if_sethide(true, bank_v2_side:com_0);
    if_sethide(false, equip_screen2:com_0);
    if_sethide(false, bank_v2_side:com_1);
} else {
    if_sethide(false, bank_v2_main:com_0);
    if_sethide(false, bank_v2_side:com_0);
    if_sethide(true, equip_screen2:com_0);
    if_sethide(true, bank_v2_side:com_1);
}
~window_resize;
