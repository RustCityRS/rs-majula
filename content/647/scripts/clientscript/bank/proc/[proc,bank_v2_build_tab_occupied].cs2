[proc,bank_v2_build_tab_occupied](int $int0, int $int1)
def_component $component2 = enum(105, 73, enum_1614, $int0);
def_component $component3 = enum(105, 73, enum_1615, $int0);
if_sethide(false, $component2);
if_sethide(false, $component3);
if_setobject_nonum(inv_getobj(bank, $int1), inv_getnum(bank, $int1), $component3);
if_setoutline(1, $component3);
if_setgraphicshadow(0x333333, $component3);
if_clearops($component2);
if_setop(1, "View tab <tostring($int0)>", $component2);
if_setop(2, "Collapse tab <tostring($int0)>", $component2);
if_setonclick(null, $component2);
def_string $string = "Click here to select tab <tostring($int0)>";
if_setonmouserepeat("addtooltip(^event_com, bank_v2_main:com119, $string, 25, 150)", $component2);
if_setonmouseleave("deltooltip(bank_v2_main:com119)", $component2);
