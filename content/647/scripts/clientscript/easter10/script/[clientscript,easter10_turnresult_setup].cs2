[clientscript,easter10_turnresult_setup]
if_settext("+ <tostring(%varplayer_1693)> ( <tostring(%varplayer_1687)> )<br>+ <tostring(%varplayer_1692)> ( <tostring(%varplayer_1686)> )<br>+ <tostring(%varplayer_1694)> ( <tostring(%varplayer_1688)> )<br>", easter10_turnresult:resources_text);
if_settext("+ <tostring(%varplayer_1695)> ( <tostring(%varplayer_1689)> )<br>+ <tostring(%varplayer_1697)> ( <tostring(%varplayer_1690)> )<br>+ <tostring(%varplayer_1696)> ( <tostring(%varplayer_1691)> )<br>", easter10_turnresult:products_text);
if (%varplayerbit_7324 = 1) {
    if_settext("WORKING", easter10_turnresult:incubator_status);
    if_setcolour(^green, easter10_turnresult:incubator_status);
} else {
    sound_synth(synth_8723, 10, 0);
    if_settext("NEEDS REPAIR", easter10_turnresult:incubator_status);
    if_setcolour(^red, easter10_turnresult:incubator_status);
}
if (%varplayerbit_7326 = 1) {
    if_settext("WORKING", easter10_turnresult:conveyor_status);
    if_setcolour(^green, easter10_turnresult:conveyor_status);
} else {
    sound_synth(synth_8723, 10, 1);
    if_settext("NEEDS REPAIR", easter10_turnresult:conveyor_status);
    if_setcolour(^red, easter10_turnresult:conveyor_status);
}
if (%varplayerbit_7325 = 1) {
    if_settext("WORKING", easter10_turnresult:painter_status);
    if_setcolour(^green, easter10_turnresult:painter_status);
} else {
    sound_synth(synth_8723, 10, 2);
    if_settext("NEEDS REPAIR", easter10_turnresult:painter_status);
    if_setcolour(^red, easter10_turnresult:painter_status);
}
if_settext(tostring(calc(%varclient_1135 / 5)), easter10_turnresult:workerupkeep_text);
switch_int (%varplayer_1698) {
    case 5 :
        if_settext("Your workers uncover a hidden stash and you receive", easter10_turnresult:event_text1);
        if_settext("3 extra resources.", easter10_turnresult:event_text2);
        sound_synth(synth_8728, 1, 0);
    case 6 :
        if_settext("An accident at work has taken place. As a result you have", easter10_turnresult:event_text1);
        if_settext("lost 3 resources.", easter10_turnresult:event_text2);
        sound_synth(synth_8723, 10, 0);
    case 7 :
        if_settext("The paint machine is out of glaze and requires a repair to work at full efficiency.", easter10_turnresult:event_text1);
        if_settext("Painter needs repair.", easter10_turnresult:event_text2);
    case 8 :
        if_settext("The conveyor team needs re-training in order to work at full efficiency.", easter10_turnresult:event_text1);
        if_settext("Conveyor needs repair.", easter10_turnresult:event_text2);
    case 9 :
        if_settext("The oven is coated in soot. It requires a repair to work at full efficiency.", easter10_turnresult:event_text1);
        if_settext("Oven needs repair.", easter10_turnresult:event_text2);
    case default :
        if_settext("", easter10_turnresult:event_text1);
        if_settext("Nothing unusual happened.", easter10_turnresult:event_text2);
}
