[proc,chatout_scrolldown]
def_string $string = "null";
if (%character_creation_name_required ! -1) {
    %character_creation_name_required = calc(%character_creation_name_required + 1);
    if (%character_creation_name_required >= 20) {
        %character_creation_name_required = 0;
    }
    if (%character_creation_name_required = %varc_int_4) {
        %varc_string_1 = "";
        %character_creation_name_required = -1;
    } else {
        $string = ~chatout_get(%character_creation_name_required);
        if (string_length($string) > 0) {
            %varc_string_1 = $string;
        }
    }
}
