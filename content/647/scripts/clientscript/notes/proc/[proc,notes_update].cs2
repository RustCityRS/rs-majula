// 2444
[proc,notes_update]
if (%varplayer_1437 = 0) {
    return;
}
if (if_gethide(notes:dragger) = false) {
    if_setontimer(notes:main, "notes_update");
    return;
} else {
    if_setontimer(notes:main, null);
}
~meslayer_close(13);
if_sethide(notes:colours, true);
%notes_scrolldelay = 0;
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_string $string0 = "";
cc_deleteall(notes:main);
if (userdetail_quickchat = true) {
    if_settext(notes:loading_mes, "The notes system is not available for users restricted to quick-chat.");
    if_sethide(notes:loading_mes, false);
    return;
} else {
    if_settext(notes:loading_mes, "");
    if_sethide(notes:loading_mes, true);
}
while ($int1 < 30) {
    $string0 = ~notes_get_note($int1);
    if (compare($string0, "") ! 0) {
        $int0 = ~notes_build($string0, $int0, $int2, ~notes_get_colour($int1));
        $int2 = calc($int2 + 1);
    }
    $int1 = calc($int1 + 1);
}
if ($int2 <= 0) {
    if_settext(notes:loading_mes, "No notes");
    if_sethide(notes:loading_mes, false);
    if_settext(notes:title, "Notes");
} else if ($int2 > 0 & $int2 <= 30) {
    if_settext(notes:title, "Notes (<tostring($int2)>/<30>)");
} else {
    if_settext(notes:title, "Notes");
}
if ($int0 > 0 & $int0 < 13) {
    if (cc_find(notes:main, calc($int2 - 1)) = true) {
        if_setsize(notes:bottom, cc_getwidth, calc(if_getheight(notes:main) - (cc_gety + cc_getheight)), ^setsize_abs, ^setsize_abs);
        if_setposition(notes:bottom, cc_getx, calc(cc_gety + cc_getheight), ^setpos_abs_left, ^setpos_abs_top);
        if_sethide(notes:bottom, false);
    }
} else {
    if_sethide(notes:bottom, true);
}
if ($int0 < 1) {
    if_setscrollsize(notes:main, 0, 0);
} else {
    if_setscrollsize(notes:main, 0, calc($int0 * 15 + 10));
}
~scrollbar_resize(notes:scrollbar, notes:main, if_getscrolly(notes:main));
if_sethide(notes:noclick, true);
