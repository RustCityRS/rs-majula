[proc,notes_click](int $int0)
def_int $int1 = 0;
while (cc_find(notes:com9, $int1) = true) {
    cc_setop(1, "Select");
    $int1 = calc($int1 + 1);
}
if (cc_find(notes:com9, %varp_1439) = true) {
    cc_setop(1, "Unselect");
    if (if_gethide(notes:com10) = false) {
        if_sethide(true, notes:com14);
        return;
    }
    if_sethide(false, notes:com14);
    if_setposition(cc_getx, cc_gety, ^setpos_abs_left, ^setpos_abs_top, notes:com14);
    if_setsize(cc_getwidth, cc_getheight, ^setsize_abs, ^setsize_abs, notes:com14);
    if ($int0 = true) {
        if (cc_gety < if_getscrolly(notes:com9)) {
            ~scrollbar_ondrag_doscroll(notes:com15, notes:com9, calc(cc_gety - 5), 1);
        } else if (calc(cc_gety + cc_getheight) > calc(if_getscrolly(notes:com9) + if_getheight(notes:com9))) {
            ~scrollbar_ondrag_doscroll(notes:com15, notes:com9, calc(cc_gety - if_getheight(notes:com9) + cc_getheight + 5), 1);
        }
    }
} else {
    if_sethide(true, notes:com14);
}
