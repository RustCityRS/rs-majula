// 1911
[clientscript,sc_processing_show_armour]
if_sethide(true, sc_processing:weapons_button_highlight);
if_sethide(true, sc_processing:weapons_layer);
if_sethide(false, sc_processing:armour_button_highlight);
if_sethide(false, sc_processing:armour_layer);
if_sethide(true, sc_processing:supplies_button_highlight);
if_sethide(true, sc_processing:supplies_layer);
if_sethide(true, sc_processing:potions_button_highlight);
if_sethide(true, sc_processing:potions_layer);
if_sethide(true, sc_processing:highlight_rect);
%varclient_582 = 0;
