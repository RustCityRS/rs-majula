[clientscript,sc_overlay_timer]
def_int $int0 = calc(%varp_1332 + %varp_1334 + %varp_1337 + 2 * (%varp_1333 - %varp_1335));
if_settext("Score: <tostring($int0)>", sc_in_game_overlay:com17);
if (%varc_int_556 = false) {
    return;
}
def_int $int1 = calc(%varc_int_556 - clientclock);
def_int $int2 = calc($int1 / 3000);
def_int $int3 = calc($int1 / 50 % 60);
if ($int2 < 0 | $int3 < 0) {
    if_settext("Game ending", sc_in_game_overlay:com15);
    if_settextshadow(true, sc_in_game_overlay:com15);
    ~clientscript_1942;
} else if ($int2 = false & $int3 = false) {
    if_settext("Game ending", sc_in_game_overlay:com15);
} else if ($int3 < 10) {
    if_settext("<tostring($int2)>:0<tostring($int3)>", sc_in_game_overlay:com15);
} else {
    if_settext("<tostring($int2)>:<tostring($int3)>", sc_in_game_overlay:com15);
}
if ($int2 < 1) {
    if_setcolour(^red, sc_in_game_overlay:com15);
    if_settextshadow(true, sc_in_game_overlay:com15);
    ~clientscript_1942;
} else if (if_gethide(sc_in_game_overlay:com18) = false) {
    if_sethide(true, sc_in_game_overlay:com18);
}
