[clientscript,booth_init]
cc_deleteall(boothpreview:com110);
if_sethide(true, boothpreview:com15);
def_int $int = 0;
while ($int < 14) {
    cc_create(boothpreview:com110, ^iftype_graphic, $int);
    if ($int ! 6 & ($int ! 8 & $int ! 11)) {
        if (inv_getobj(worn, $int) ! null) {
            cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
            if ($int = false) {
                cc_setposition(~clientscript_788(boothpreview:com116, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            } else if ($int = true) {
                cc_setposition(~clientscript_788(boothpreview:com117, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            } else if ($int = 2) {
                cc_setposition(~clientscript_788(boothpreview:com118, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            } else if ($int = 3) {
                cc_setposition(~clientscript_788(boothpreview:com120, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            } else if ($int = 4) {
                cc_setposition(~clientscript_788(boothpreview:com121, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            } else if ($int = 5) {
                cc_setposition(~clientscript_788(boothpreview:com122, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            } else if ($int = 7) {
                cc_setposition(~clientscript_788(boothpreview:com123, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            } else if ($int = 9) {
                cc_setposition(~clientscript_788(boothpreview:com125, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            } else if ($int = 10) {
                cc_setposition(~clientscript_788(boothpreview:com124, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            } else if ($int = 12) {
                cc_setposition(~clientscript_788(boothpreview:com126, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            } else if ($int = 13) {
                cc_setposition(~clientscript_788(boothpreview:com119, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
            }
            cc_setobject(inv_getobj(worn, $int), inv_getnum(worn, $int));
            cc_setopbase(oc_name(inv_getobj(worn, $int)));
            cc_setop(1, "Remove<col=ff9040>");
            cc_setop(10, "Examine<col=ff9040>");
            cc_setgraphicshadow(0x111111);
            cc_setoutline(1);
        } else {
            cc_setsize(32, 32, ^setsize_abs, ^setsize_abs);
            if ($int = false) {
                cc_setposition(~clientscript_788(boothpreview:com116, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,0");
            } else if ($int = true) {
                cc_setposition(~clientscript_788(boothpreview:com117, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,1");
            } else if ($int = 2) {
                cc_setposition(~clientscript_788(boothpreview:com118, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,2");
            } else if ($int = 3) {
                cc_setposition(~clientscript_788(boothpreview:com120, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,3");
            } else if ($int = 4) {
                cc_setposition(~clientscript_788(boothpreview:com121, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,5");
            } else if ($int = 5) {
                cc_setposition(~clientscript_788(boothpreview:com122, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,6");
            } else if ($int = 7) {
                cc_setposition(~clientscript_788(boothpreview:com123, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,7");
            } else if ($int = 9) {
                cc_setposition(~clientscript_788(boothpreview:com125, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,8");
            } else if ($int = 10) {
                cc_setposition(~clientscript_788(boothpreview:com124, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,9");
            } else if ($int = 12) {
                cc_setposition(~clientscript_788(boothpreview:com126, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,4");
            } else if ($int = 13) {
                cc_setposition(~clientscript_788(boothpreview:com119, 2, 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("wornicons,10");
            }
        }
    }
    $int = calc($int + 1);
}
