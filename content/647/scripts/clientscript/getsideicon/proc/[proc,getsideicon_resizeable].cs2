    case 6:
        return(toplevel_fullscreen:com26);
    case 7:
        return(toplevel_fullscreen:com27);
    case 8:
        return(toplevel_fullscreen:com28);
    case 9:
        return(toplevel_fullscreen:com29);
    case 10:
        return(toplevel_fullscreen:com30);
    case 11:
        return(toplevel_fullscreen:com31);
    case 12:
