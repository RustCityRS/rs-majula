// 4143
[proc,options_chat_filter]
def_string $string0 = null;
if (%varplayerbit_8780 = 1) {
    if_setgraphic("filter_chat_icon,1", options:com_3);
    $string0 = "Toggle Profanity Filter<br>(filter is currently off)";
    if_setonmouserepeat("addtooltip(event_com, options:options_tooltip, $string0, 25, 180)", options:com_3);
    %varclient_2 = 0;
} else if (%varplayerbit_8780 = 0) {
    if_setgraphic("filter_chat_icon,0", options:com_3);
    $string0 = "Toggle Profanity Filter<br>(filter is currently on)";
    if_setonmouserepeat("addtooltip(event_com, options:options_tooltip, $string0, 25, 180)", options:com_3);
    %varclient_2 = 0;
}
