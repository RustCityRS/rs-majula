[proc,options_aid]
def_string $string = "null";
if (%varp_427 = false) {
    if_setgraphic("options_boxes,0", options:com7);
    $string = "Accept aid<br>(currently off)";
    if_setonmouserepeat("addtooltip(^event_com, options:com20, $string, 25, 180)", options:com7);
    %varc_int_2 = 0;
} else if (%varp_427 = true) {
    if_setgraphic("options_boxes,1", options:com7);
    $string = "Accept aid<br>(currently on)";
    if_setonmouserepeat("addtooltip(^event_com, options:com20, $string, 25, 180)", options:com7);
    %varc_int_2 = 0;
}
