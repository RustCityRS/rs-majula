[proc,options_chat]
def_string $string = "null";
if (%option_chat = true) {
    if_setgraphic("options_boxes,0", options:com4);
    $string = "Chat effects<br>(currently off)";
    if_setonmouserepeat("addtooltip(^event_com, options:com20, $string, 25, 180)", options:com4);
    %varc_int_2 = 0;
} else if (%option_chat = false) {
    if_setgraphic("options_boxes,1", options:com4);
    $string = "Chat effects<br>(currently on)";
    if_setonmouserepeat("addtooltip(^event_com, options:com20, $string, 25, 180)", options:com4);
    %varc_int_2 = 0;
}
