[clientscript,inventory_drag](component $component0, int $int1, component $component2, int $int3)
if ($component0 ! $component2) {
    return;
}
def_int $int4 = inv_size(inv);
$int1 = calc($int1 % $int4);
$int3 = calc($int3 % $int4);
def_obj $obj5 = null;
def_int $int6 = 0;
if (cc_find($component0, $int1) = true & .cc_find($component2, $int3) = true) {
    $obj5, $int6 = cc_getinvobject, cc_getinvcount;
    cc_setobject(.cc_getinvobject, .cc_getinvcount);
    .cc_setobject($obj5, $int6);
    cc_clearops;
    .cc_clearops;
    if (cc_getinvobject ! null) {
        cc_sethide(false);
        ~inventory_setophelds(cc_getinvobject);
    } else {
        cc_setonvartransmit(null);
        cc_sethide(true);
    }
    if (cc_find($component2, $int3) = true) {
        if (cc_getinvobject ! null) {
            cc_sethide(false);
            ~inventory_setophelds(cc_getinvobject);
        } else {
            cc_setonvartransmit(null);
            cc_sethide(true);
        }
    }
}
