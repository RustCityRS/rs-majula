// 2436
[proc,gravestone_stop_timer]
%gravestone_countdown = 0;
~statusicons_deltooltip;
if (getwindowmode < 2) {
    if_setontimer(toplevel:gravestone_layer, null);
    if_sethide(toplevel:gravestone_timer, true);
    if_sethide(toplevel:gravestone_background, true);
} else {
    if_setontimer(toplevel_fullscreen:gravestone_layer, null);
    if_sethide(toplevel_fullscreen:gravestone_timer, true);
    if_sethide(toplevel_fullscreen:gravestone_background, true);
}
