// 2436
[proc,gravestone_stop_timer]
%varclient_815 = 0;
~statusicons_deltooltip;
if (getwindowmode < 2) {
    if_setontimer(null, toplevel:com_11);
    if_sethide(true, toplevel:com_13);
    if_sethide(true, toplevel:com_12);
} else {
    if_setontimer(null, toplevel_fullscreen:com_11);
    if_sethide(true, toplevel_fullscreen:com_166);
    if_sethide(true, toplevel_fullscreen:com_165);
}
