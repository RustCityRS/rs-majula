[clientscript,gravestone_update_timer]
if (%varc_int_815 > 0) {
    %varc_int_815 = calc(%varc_int_815 - 1);
} else {
    ~gravestone_stop_timer;
    return;
}
def_int $int0 = calc(%varc_int_815 / 50);
def_int $int1 = calc($int0 / 60);
$int0 = calc($int0 - $int1 * 60);
def_string $string0 = "";
def_string $string1 = "";
if ($int1 = false) {
    $string0 = "00";
} else if ($int1 < 10) {
    $string0 = "0<tostring($int1)>";
} else {
    $string0 = tostring($int1);
}
if ($int0 = false) {
    $string1 = "00";
} else if ($int0 < 10) {
    $string1 = "0<tostring($int0)>";
} else {
    $string1 = tostring($int0);
}
if (getwindowmode < 2) {
    if_sethide(false, toplevel:com13);
    if_sethide(false, toplevel:com12);
    if_settext("<$string0>:<$string1>", toplevel:com13);
} else {
    if_sethide(false, toplevel_fullscreen:com166);
    if_sethide(false, toplevel_fullscreen:com165);
    if_settext("<$string0>:<$string1>", toplevel_fullscreen:com166);
}
