// 2435
[clientscript,gravestone_update_timer]
if (%varclient_815 > 0) {
    %varclient_815 = calc(%varclient_815 - 1);
} else {
    ~gravestone_stop_timer;
    return;
}
def_int $int0 = calc(%varclient_815 / 50);
def_int $int1 = calc($int0 / 60);
$int0 = calc($int0 - $int1 * 60);
def_string $string0 = "";
def_string $string1 = "";
if ($int1 = 0) {
    $string0 = "00";
} else if ($int1 < 10) {
    $string0 = "0<tostring($int1)>";
} else {
    $string0 = tostring($int1);
}
if ($int0 = 0) {
    $string1 = "00";
} else if ($int0 < 10) {
    $string1 = "0<tostring($int0)>";
} else {
    $string1 = tostring($int0);
}
if (getwindowmode < 2) {
    if_sethide(false, toplevel:com_13);
    if_sethide(false, toplevel:com_12);
    if_settext("<$string0>:<$string1>", toplevel:com_13);
} else {
    if_sethide(false, toplevel_fullscreen:com_166);
    if_sethide(false, toplevel_fullscreen:com_165);
    if_settext("<$string0>:<$string1>", toplevel_fullscreen:com_166);
}
