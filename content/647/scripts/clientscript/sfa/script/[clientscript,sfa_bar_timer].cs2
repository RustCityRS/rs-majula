// 2896
[clientscript,sfa_bar_timer](component $component0)
if (calc(clientclock % 5) = 0) {
    if (scale(%varclient_1078, 2000, 200) > scale(%varplayerbit_7189, 2000, 200)) {
        if_setsize(20, scale(%varclient_1078, 2000, 200), ^setsize_abs, ^setsize_abs, $component0);
        %varclient_1078 = calc(%varclient_1078 - 1);
    } else {
        if_setontimer(null, $component0);
        %varclient_1079 = 0;
    }
}
