// 4083
[clientscript,xmas10_snowball_mouse_leave]
if (if_find(xmas10_snowball:com_3) = true & cc_getgraphic = "set_but_end_2,1") {
    cc_setgraphic("set_but_end_2,0");
}
if (if_find(xmas10_snowball:com_4) = true & cc_getgraphic = "set_but_end_2,4") {
    cc_setgraphic("set_but_end_2,3");
}
if (if_find(xmas10_snowball:com_5) = true & cc_getgraphic = "set_but_fill_2,1") {
    cc_setgraphic("set_but_fill_2,0");
}
