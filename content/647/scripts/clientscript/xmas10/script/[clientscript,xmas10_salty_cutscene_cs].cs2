// 4075
[clientscript,xmas10_salty_cutscene_cs](component $component0)
switch_int (%varclient_1433) {
    case 1 :
        ~tutorial3_fadeout(^black, 50, $component0);
    case 2 :
        ~tutorial3_fadein(50, $component0);
        spline_new(0, 2);
        spline_new(1, 2);
        spline_addpoint(0, 0, ~xmas10_cs(16, 11), 500, ~xmas10_cs(16, 11), 500, 0);
        spline_addpoint(0, 1, ~xmas10_cs(14, 12), 400, ~xmas10_cs(14, 12), 400, 0);
        spline_addpoint(1, 0, ~xmas10_cs(15, 15), 400, ~xmas10_cs(15, 15), 400, 0);
        spline_addpoint(1, 1, ~xmas10_cs(15, 15), 300, ~xmas10_cs(15, 15), 300, 0);
        cam_movealong(0, 0, 100, 100, 1, 0);
    case 3 :
        ~tutorial3_fadeout(^black, 30, $component0);
    case 4 :
        cam_reset;
        ~tutorial3_fadein(50, $component0);
}
