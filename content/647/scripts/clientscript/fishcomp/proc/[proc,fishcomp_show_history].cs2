// 273
[proc,fishcomp_show_history]
if_setsize(if_getwidth(fishcomp_overlay:com_1), 185, ^setsize_abs, ^setsize_abs, fishcomp_overlay:com_1);
if_setonop("fishcomp_hide_history", fishcomp_overlay:com_23);
if_settext("Hide", fishcomp_overlay:com_31);
~scrollbar_vertical(fishcomp_overlay:com_5, fishcomp_overlay:com_6, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
if_setvflip(true, fishcomp_overlay:com_29);
if_setvflip(true, fishcomp_overlay:com_30);
