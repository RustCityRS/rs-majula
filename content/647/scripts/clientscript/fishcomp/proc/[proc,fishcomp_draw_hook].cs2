[proc,fishcomp_draw_hook]
def_string $string = "None";
switch_int (%varc_int_1110) {
    case 1:
        $string = "Standard";
    case 3:
        $string = "Large";
    case 2:
        $string = "Slim";
    case 4:
        $string = "Bone";
    case 5:
        $string = "Wooden";
    case 6:
        $string = "Double";
}
if_settext($string, fishcomp_side:com52);
