// 275
[proc,fishcomp_hide_history]
if_setsize(if_getwidth(fishcomp_overlay:content_layer), 75, ^setsize_abs, ^setsize_abs, fishcomp_overlay:content_layer);
if_setonop("fishcomp_show_history", fishcomp_overlay:dropdown_button_layer);
if_settext("Show All", fishcomp_overlay:com_31);
cc_deleteall(fishcomp_overlay:history_scrollbar);
if_setvflip(false, fishcomp_overlay:dropdown_arrow_left);
if_setvflip(false, fishcomp_overlay:dropdown_arrow_right);
if_setscrollpos(0, 0, fishcomp_overlay:history_scrolllayer);
