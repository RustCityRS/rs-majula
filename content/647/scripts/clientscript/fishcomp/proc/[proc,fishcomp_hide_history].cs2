[proc,fishcomp_hide_history]
if_setsize(if_getwidth(fishcomp_overlay:com1), 75, ^setsize_abs, ^setsize_abs, fishcomp_overlay:com1);
if_setonop("fishcomp_show_history()", fishcomp_overlay:com23);
if_settext("Show All", fishcomp_overlay:com31);
cc_deleteall(fishcomp_overlay:com5);
if_setvflip(false, fishcomp_overlay:com29);
if_setvflip(false, fishcomp_overlay:com30);
if_setscrollpos(0, 0, fishcomp_overlay:com6);
