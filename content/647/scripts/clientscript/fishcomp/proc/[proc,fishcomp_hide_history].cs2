// 275
[proc,fishcomp_hide_history]
if_setsize(if_getwidth(fishcomp_overlay:com_1), 75, ^setsize_abs, ^setsize_abs, fishcomp_overlay:com_1);
if_setonop("fishcomp_show_history", fishcomp_overlay:com_23);
if_settext("Show All", fishcomp_overlay:com_31);
cc_deleteall(fishcomp_overlay:com_5);
if_setvflip(false, fishcomp_overlay:com_29);
if_setvflip(false, fishcomp_overlay:com_30);
if_setscrollpos(0, 0, fishcomp_overlay:com_6);
