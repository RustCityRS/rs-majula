// 275
[proc,fishcomp_hide_history]
if_setsize(fishcomp_overlay:content_layer, if_getwidth(fishcomp_overlay:content_layer), 75, ^setsize_abs, ^setsize_abs);
if_setonop(fishcomp_overlay:dropdown_button_layer, "fishcomp_show_history");
if_settext(fishcomp_overlay:com_31, "Show All");
cc_deleteall(fishcomp_overlay:history_scrollbar);
if_setvflip(fishcomp_overlay:dropdown_arrow_left, false);
if_setvflip(fishcomp_overlay:dropdown_arrow_right, false);
if_setscrollpos(fishcomp_overlay:history_scrolllayer, 0, 0);
