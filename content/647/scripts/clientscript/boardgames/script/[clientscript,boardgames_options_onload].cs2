[clientscript,boardgames_options_onload]
if (%varbit_61 = true) {
    if_settext("Draughts: Options", boardgames_options:com10);
    ~clientscript_1406(boardgames_options:com3);
} else if (%varbit_61 = 2) {
    if_settext("Runelink: Options", boardgames_options:com10);
    ~clientscript_1406(boardgames_options:com4);
} else if (%varbit_61 = 3) {
    if_settext("Runesquares: Options", boardgames_options:com10);
    ~clientscript_1406(boardgames_options:com8);
} else if (%varbit_61 = 4) {
    if_settext("Runeversi: Options", boardgames_options:com10);
    ~clientscript_1406(boardgames_options:com6);
}
~boardgames_options_ranked;
~boardgames_options_time;
~boardgames_options_pick_piece;
