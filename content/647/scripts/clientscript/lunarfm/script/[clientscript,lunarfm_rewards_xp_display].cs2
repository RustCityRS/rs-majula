[clientscript,lunarfm_rewards_xp_display]
if_sethide(true, lunarfm_rewards_new:com152);
if_sethide(true, lunarfm_rewards_new:com153);
if_sethide(false, lunarfm_rewards_new:com154);
if_sethide(true, lunarfm_rewards_new:com149);
if_sethide(true, lunarfm_rewards_new:com150);
if_sethide(false, lunarfm_rewards_new:com151);
if_sethide(true, lunarfm_rewards_new:com238);
if_sethide(true, lunarfm_rewards_new:com248);
if_sethide(false, lunarfm_rewards_new:com389);
if_sethide(true, lunarfm_rewards_new:com155);
if_settext(tostring(calc(2 * 10)), lunarfm_rewards_new:com410);
if (stat_base(magic) < 83) {
    if_settext("<tostring(calc(2 / 2 * 10))> (halved)", lunarfm_rewards_new:com411);
} else {
    if_settext(tostring(calc(2 * 10)), lunarfm_rewards_new:com411);
}
if (stat_base(magic) < 80) {
    if_settext("<tostring(calc(12 / 2 * 10))> (halved)", lunarfm_rewards_new:com412);
} else {
    if_settext(tostring(calc(12 * 10)), lunarfm_rewards_new:com412);
}
if (stat_base(magic) < 86) {
    if_settext("<tostring(calc(2 / 2 * 10))> (halved)", lunarfm_rewards_new:com413);
} else {
    if_settext(tostring(calc(2 * 10)), lunarfm_rewards_new:com413);
}
if (stat_base(magic) < 91) {
    if_settext("<tostring(calc(10 / 2 * 10))> (halved)", lunarfm_rewards_new:com414);
} else {
    if_settext(tostring(calc(10 * 10)), lunarfm_rewards_new:com414);
}
if_settext("Magic and Farming", lunarfm_rewards_new:com415);
if (stat_base(magic) < 83) {
    if_settext("Farming (no Magic)", lunarfm_rewards_new:com416);
} else {
    if_settext("Magic and Farming", lunarfm_rewards_new:com416);
}
if (stat_base(magic) < 80) {
    if_settext("Crafting (no Magic)", lunarfm_rewards_new:com417);
} else {
    if_settext("Magic and Crafting", lunarfm_rewards_new:com417);
}
if (stat_base(magic) < 86) {
    if_settext("Construction (no Magic)", lunarfm_rewards_new:com418);
} else {
    if_settext("Magic and Construction", lunarfm_rewards_new:com418);
}
if (stat_base(magic) < 91) {
    if_settext("Agility (no Magic)", lunarfm_rewards_new:com419);
} else {
    if_settext("Magic and Agility", lunarfm_rewards_new:com419);
}
