// 4266
[clientscript,lunarfm_rewards_onload]
~script4267;
~script4274;
if_settext("", lunarfm_rewards_new:name);
if_settext("Select a reward for more information.", lunarfm_rewards_new:description);
if_settext("", lunarfm_rewards_new:extra_info);
if_sethide(true, lunarfm_rewards_new:spell_icon_layer);
if_sethide(true, lunarfm_rewards_new:task_list);
if_sethide(true, lunarfm_rewards_new:gold_frame_tasks);
if_sethide(false, lunarfm_rewards_new:gold_frame_list);
if_sethide(false, lunarfm_rewards_new:gold_frame_desc);
if_sethide(false, lunarfm_rewards_new:breakdown_layer);
if (%varplayerbit_9067 < 8) {
    ~lunarfm_rewards_spells_display;
    if_settext("Spells", lunarfm_rewards_new:name);
} else {
    ~lunarfm_rewards_wishes_display;
    if_settext("Wishes", lunarfm_rewards_new:name);
}
