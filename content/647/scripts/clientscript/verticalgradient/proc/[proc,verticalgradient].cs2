[proc,verticalgradient](component $component0, colour $colour1, colour $colour2, int $int3, int $int4)
def_int $int5 = 0;
def_int $int6 = 0;
def_int $int7 = 0;
$int5, $int6, $int7 = ~hex_to_rgb($colour1);
def_int $int8 = 0;
def_int $int9 = 0;
def_int $int10 = 0;
$int8, $int9, $int10 = ~hex_to_rgb($colour2);
def_int $int11 = calc($int8 - $int5);
def_int $int12 = calc($int9 - $int6);
def_int $int13 = calc($int10 - $int7);
def_int $int14 = calc(if_getheight($component0) - $int4);
$int3 = calc($int3 * 2);
def_int $int15 = $int4;
def_int $int16 = 0;
def_int $int17 = calc($int14 - $int15);
while ($int15 < $int14) {
    cc_create($component0, ^iftype_rectangle, if_getchildcount($component0));
    cc_setsize($int3, 1, ^setsize_minus, ^setsize_abs);
    cc_setfill(true);
    cc_setposition(0, $int15, ^setpos_abs_centre, ^setpos_abs_top);
    cc_setcolour(~rgb_to_hex(calc($int5 + scale($int16, $int17, $int11)), calc($int6 + scale($int16, $int17, $int12)), calc($int7 + scale($int16, $int17, $int13))));
    $int16 = calc($int16 + 1);
    $int15 = calc($int15 + 1);
}
