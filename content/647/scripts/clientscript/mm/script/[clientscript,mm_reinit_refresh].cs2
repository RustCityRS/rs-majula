// 1618
[clientscript,mm_reinit_refresh]
def_inv $inv0 = null;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
if_sethide(reinitialisation_puzzle:inv_layer, false);
if (%mm_reinit_active = 1) {
    $inv0 = reinitialisation_inv;
} else {
    $inv0 = reinitialisation_inv_inactive;
}
$int1 = inv_size($inv0);
if ($int1 ! calc(5 * 5)) {
    mes("Nothing happens, as if something is wrong.");
    return;
}
while ($int4 < $int1) {
    ~script1619($int2, $int3, inv_getobj($inv0, $int4));
    $int2 = calc($int2 + 1);
    if ($int2 >= 5) {
        $int2 = 0;
        $int3 = calc($int3 + 1);
    }
    $int4 = calc($int4 + 1);
}
