// 3634
[proc,trail_failure](component $component0)
if (if_find($component0) = true) {
    if_setcolour(0xcc0000, $component0);
    if_setsize(27, 27, ^setsize_abs, ^setsize_abs, $component0);
    if_setposition(cc_param(param_1101), cc_param(param_1102), ^setpos_abs_left, ^setpos_abs_top, $component0);
}
