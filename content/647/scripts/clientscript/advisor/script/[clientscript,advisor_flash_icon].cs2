// 1427
[clientscript,advisor_flash_icon](component $component0)
def_int $int1 = calc(clientclock % 32);
if (%advisor_flash_cc = %advisor_tutorial_id & %advisor_flash_cc ! 0) {
    if ($int1 < 8) {
        if_settrans($component0, 0);
    } else if ($int1 < 16) {
        if_settrans($component0, 85);
    } else if ($int1 < 24) {
        if_settrans($component0, 255);
    } else {
        if_settrans($component0, 85);
    }
} else if (if_gettrans($component0) ! 0) {
    if_settrans($component0, 0);
} else {
    if_setontimer($component0, null);
}
