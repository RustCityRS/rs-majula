[clientscript,advisor_flashside]
if (~current_side_if ! 8 & (~clientscript_1569 = false & (if_hasoverlay(~getsidelayer(8)) = true & (%varbit_6521 ! 3 & %varbit_6521 ! 10)))) {
    ~arrow_set(~getsideicon_resizeable(8), -1, ~getsideicon(8), -1);
    if_setontimer("flashside_timer_advisor()", toplevel_fullscreen:com19);
    if_setontimer("flashside_timer_advisor()", toplevel:com127);
}
