[proc,graphics_options_startcountdown](int $int0, int $int1, boolean $boolean2, boolean $boolean3)
def_int $int4 = calc(clientclock + 750);
if ($int1 = true) {
    if_setontimer("graphics_options_countdown($int4, $int0, $int1, $boolean2, $boolean3)", toplevel_fullscreen:com80);
    if_setontimer("graphics_options_countdown($int4, $int0, $int1, $boolean2, $boolean3)", toplevel:com20);
    ~graphics_options_opencountdown($int0, $boolean2, $boolean3);
} else if ($int1 = 2) {
    if_setontimer("graphics_options_countdown($int4, $int0, $int1, $boolean2, $boolean3)", lobbyscreen:com13);
    ~lobbyscreen_countdown;
    if_setonop("graphics_options_decision(true, $int0, $int1, $boolean2, $boolean3)", lobbyscreen:com116);
    if_setonop("graphics_options_decision(false, $int0, $int1, $boolean2, $boolean3)", lobbyscreen:com118);
} else {
    if_setontimer("graphics_options_countdown($int4, $int0, $int1, $boolean2, $boolean3)", loginscreen:com17);
    ~loginscreen_setactivemenu(10);
    if_setonclick("graphics_options_decision(true, $int0, $int1, $boolean2, $boolean3)", loginscreen:com56);
    if_setonclick("graphics_options_decision(false, $int0, $int1, $boolean2, $boolean3)", loginscreen:com57);
}
