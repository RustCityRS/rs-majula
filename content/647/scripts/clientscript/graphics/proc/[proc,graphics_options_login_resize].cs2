[proc,graphics_options_login_resize](int $int0)
def_int $int1 = 0;
def_int $int2 = 33;
if ($int0 = false) {
    return;
}
$int2 = 30;
if (if_getheight(loginscreen_graphics_options:com4) < calc(if_getheight(loginscreen_graphics_options:com22) + 146)) {
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, loginscreen_graphics_options:com8);
    if_setposition(0, calc(if_gety(loginscreen_graphics_options:com8) + $int2), ^setpos_abs_centre, ^setpos_abs_top, loginscreen_graphics_options:com22);
    if_sethide(true, loginscreen:com23);
} else {
    $int1 = calc(if_gety(loginscreen:com23) + if_getheight(loginscreen:com23));
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, loginscreen_graphics_options:com8);
    if (calc(if_gety(loginscreen_graphics_options:com8) - 2) < $int1) {
        if_setposition(0, calc($int1 + 2), ^setpos_abs_centre, ^setpos_abs_top, loginscreen_graphics_options:com8);
    }
    if_setposition(0, calc(if_gety(loginscreen_graphics_options:com8) + $int2), ^setpos_abs_centre, ^setpos_abs_top, loginscreen_graphics_options:com22);
    if_sethide(false, loginscreen:com23);
}
