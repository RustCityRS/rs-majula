[clientscript,graphics_options_mouseoveroption](component $component0, int $int1, boolean $int2, int $int3, int $colour4, boolean $int5)
if ($int5 = true & cc_find($component0, $int3) = true) {
    cc_setcolour($colour4);
}
if (cc_find($component0, $int1) = true) {
    if ($int2 = true) {
        if (cc_getgraphic = 2554) {
            cc_setgraphic(2555);
        } else if (cc_getgraphic = 2556) {
            cc_setgraphic(2557);
        }
    } else if (cc_getgraphic = 2555) {
        cc_setgraphic(2554);
    } else if (cc_getgraphic = 2557) {
        cc_setgraphic(2556);
    }
}
