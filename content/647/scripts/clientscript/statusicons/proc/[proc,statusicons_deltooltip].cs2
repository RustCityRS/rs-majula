// 1952
[proc,statusicons_deltooltip]
def_component $component0 = null;
def_component $component1 = null;
if (getwindowmode < 2) {
    $component0 = toplevel:com_15;
    $component1 = toplevel:com_224;
} else {
    $component0 = toplevel_fullscreen:com_13;
    $component1 = toplevel_fullscreen:com_164;
}
if_settext("", $component1);
if_sethide(true, $component0);
%varclient_2 = 0;
