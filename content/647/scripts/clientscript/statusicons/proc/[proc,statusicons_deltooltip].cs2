[proc,statusicons_deltooltip]
def_component $component0 = null;
def_component $component1 = null;
if (getwindowmode < 2) {
    $component0 = toplevel:com15;
    $component1 = toplevel:com224;
} else {
    $component0 = toplevel_fullscreen:com13;
    $component1 = toplevel_fullscreen:com164;
}
if_settext("", $component1);
if_sethide(true, $component0);
%varc_int_2 = 0;
