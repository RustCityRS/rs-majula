// 2131
[clientscript,bees_init](component $component0, component $component1)
if_setontimer($component0, "bees($component0, calc(random(6) - 3), calc(random(6) - 3), $component1, 0)");
if_setonmouseover($component0, "bees_mouseover($component0)");
if_setonmouserepeat($component0, "bees_mouserepeat($component0, event_mousex, event_mousey)");
if_setonmouseleave($component0, "bees_mouseleave($component0)");
