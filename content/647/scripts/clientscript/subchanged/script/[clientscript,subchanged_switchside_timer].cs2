// 2464
[clientscript,subchanged_switchside_timer](int $int0, component $component1)
if ($int0 > calc(clientclock - 5)) {
    return;
}
if_setontimer(null, $component1);
if (~script2465(~current_side_if) = false) {
    if (getwindowmode >= 2) {
        ~if_switchside(-1);
        return;
    }
    if (~script2465(4) = true) {
        ~if_switchside(4);
    } else if (~script2465(9) = true) {
        ~if_switchside(9);
    } else if (~script2465(12) = true & %learning_the_ropes > 3) {
        ~if_switchside(12);
    }
}
