[clientscript,lobbyscreen_pane_clanchat_caret_flash](int $int0, component $component1)
if (clanchannel2_find_affined = false) {
    if_settext("", lobbyscreen_pane_clanchat:com25);
    if_sethide(true, $component1);
    return;
}
if (calc((clientclock - $int0) % 40) < 20 & has_focus = true) {
    if_sethide(false, $component1);
} else {
    if_sethide(true, $component1);
}
