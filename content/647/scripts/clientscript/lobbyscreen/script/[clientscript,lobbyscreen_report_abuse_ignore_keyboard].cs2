// 3206
[clientscript,lobbyscreen_report_abuse_ignore_keyboard](int $key0)
switch_int ($key0) {
    case ^key_f1 :
        ~lobbyscreen_report_abuse_help(6, lobbyscreen_report_abuse_ignore:com_14, lobbyscreen_report_abuse_ignore:com_15, lobbyscreen_report_abuse_ignore:com_3, lobbyscreen_report_abuse_ignore:com_2, lobbyscreen_report_abuse_ignore:com_0);
    case ^key_escape :
        if (if_gethide(lobbyscreen_report_abuse_ignore:com_2) = false) {
            ~lobbyscreen_report_abuse_help_close(lobbyscreen_report_abuse_ignore:com_14, lobbyscreen_report_abuse_ignore:com_15, lobbyscreen_report_abuse_ignore:com_3, lobbyscreen_report_abuse_ignore:com_2, lobbyscreen_report_abuse_ignore:com_0);
        } else {
            ~lobbyscreen_report_abuse_ignore_close;
        }
}
