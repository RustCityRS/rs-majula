// 3056
[clientscript,lobbyscreen_pane_friendslist_chat_op](int $int0, string $string0, string $string1)
switch_int ($int0) {
    case 1 :
        if (friend_test(removetags($string1)) = false) {
            friend_add(removetags($string1));
        }
    case 2 :
        if (friend_test(removetags($string1)) = false) {
            ignore_add(removetags($string1));
        }
    case 3 :
        ~lobbyscreen_input("Send message to <$string0>", "", 0, $string1, "");
    case 5 :
        ~script3177($string0, false);
}
