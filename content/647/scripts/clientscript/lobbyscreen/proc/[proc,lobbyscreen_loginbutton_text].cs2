// 3064
[proc,lobbyscreen_loginbutton_text](int $int0)
if ($int0 = 1) {
    if_settext(lobbyscreen:loginbutton_text, "Play");
    if_setop(lobbyscreen:loginbutton, 1, "Play");
    if_setonop(lobbyscreen:loginbutton, "lobbyscreen_entergame(lobbyscreen:loginbutton)");
} else {
    if_settext(lobbyscreen:loginbutton_text, "Entering game...");
    if_clearops(lobbyscreen:loginbutton);
    if_setonop(lobbyscreen:loginbutton, null);
}
~script3065($int0);
