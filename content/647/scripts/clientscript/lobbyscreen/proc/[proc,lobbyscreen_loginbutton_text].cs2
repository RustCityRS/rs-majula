// 3064
[proc,lobbyscreen_loginbutton_text](int $int0)
if ($int0 = 1) {
    if_settext("Play", lobbyscreen:loginbutton_text);
    if_setop(1, "Play", lobbyscreen:loginbutton);
    if_setonop("lobbyscreen_entergame(lobbyscreen:loginbutton)", lobbyscreen:loginbutton);
} else {
    if_settext("Entering game...", lobbyscreen:loginbutton_text);
    if_clearops(lobbyscreen:loginbutton);
    if_setonop(null, lobbyscreen:loginbutton);
}
~script3065($int0);
