// 3018
[proc,lobbyscreen_input_clear]
if_settext("", lobbyscreen:input_title);
if_settext("", lobbyscreen:input_text);
if_setonkey(null, lobbyscreen:input_text);
if_setonop(null, lobbyscreen:input_ok);
if_settext("Ok", lobbyscreen:input_ok_text);
if_setop(1, "Ok", lobbyscreen:input_ok_text);
if_settext("Close", lobbyscreen:input_close_text);
if_setop(1, "Close", lobbyscreen:input_close_text);
if_setsize(265, 136, ^setsize_abs, ^setsize_abs, lobbyscreen:input_window);
if_setsize(0, 0, ^setsize_minus, ^setsize_minus, lobbyscreen:input_text);
if_setsize(8034, 0, ^setsize_rel, ^setsize_minus, lobbyscreen:input_ok);
if_setsize(8034, 0, ^setsize_rel, ^setsize_minus, lobbyscreen:input_ok_text);
if_setsize(8034, 0, ^setsize_rel, ^setsize_minus, lobbyscreen:input_close);
if_setsize(8034, 0, ^setsize_rel, ^setsize_minus, lobbyscreen:input_close_text);
if_sethide(false, lobbyscreen:input_close);
if_sethide(false, lobbyscreen:input_close_text);
%varclient_1796 = "";
