// 4547
[proc,lobbyscreen_pane_clanchat_clear](component $component0, component $component1, component $component2, component $component3, component $component4, component $component5)
cc_deleteall($component0);
cc_deleteall($component1);
cc_deleteall($component2);
cc_deleteall($component3);
if_sethide(false, lobbyscreen_pane_clanchat:info_layer);
if_settext("Not in chat", lobbyscreen_pane_clanchat:clan_detail_name_text);
if_setsize(if_getwidth(lobbyscreen_pane_clanchat:clan_vdiv), if_getheight(lobbyscreen_pane_clanchat:clan_titles), ^setsize_abs, ^setsize_abs, lobbyscreen_pane_clanchat:clan_vdiv);
if_setscrollsize(0, 0, lobbyscreen_pane_clanchat:clan_main);
if_setscrollpos(0, 0, lobbyscreen_pane_clanchat:clan_main);
~scrollbar_resize(lobbyscreen_pane_clanchat:clan_build_layer_scroll, lobbyscreen_pane_clanchat:clan_main, 0);
