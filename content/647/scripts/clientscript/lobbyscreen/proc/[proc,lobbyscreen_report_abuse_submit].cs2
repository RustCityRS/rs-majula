    chat_sendabusereport(%varc_string_279, $int, %varc_int_6, "");
}
~lobbyscreen_report_abuse_stage2_close;
if (string_length(%varc_string_279) > 0 & (ignores_test(%varc_string_279) = false & compare(%varc_string_279, chat_playername) ! 0)) {
