[proc,lobbyscreen_chat_count]()(int, int, int)
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
while ($int3 < 100) {
    switch_int (chat_gethistory_length($int3)) {
        case 3, 7, 18:
            $int0 = calc($int0 + 1);
        case 9, 20:
            $int2 = calc($int2 + 1);
        case 41, 42, 44, 45:
            $int1 = calc($int1 + 1);
    }
    $int3 = calc($int3 + 1);
}
return($int0, $int1, $int2);
return(0, 0, 0);
