[proc,lobbyscreen_pane_clanchat_chat_line](int $int0, int $int1, int $int2, string $string0, string $string1, string $string2)(int)
cc_create(lobbyscreen_pane_clanchat:com21, ^iftype_text, $int0);
cc_setposition(0, calc($int0 * 15), ^setpos_abs_left, ^setpos_abs_bottom);
cc_setsize(0, 15, ^setsize_minus, ^setsize_abs);
cc_setcolour(^white);
cc_settextfont(p11_full);
cc_settext($string0);
if ($int1 = true) {
    cc_setopbase(removetags($string1));
    cc_setonop("lobbyscreen_pane_clanchat_chat_op(^event_op, $string1, $string2)");
    switch_int ($int2) {
        case 41, 42, 44, 45, 9, 20:
            if (compare(removetags(docheat), removetags($string2)) ! 0) {
                if (friend_test(removetags($string2)) = false & ignores_test(removetags($string2)) = false) {
                    cc_setop(1, "Add friend");
                    cc_setop(2, "Add ignore");
                } else if (friend_test(removetags($string2)) = true & is_subscriber = false) {
                    cc_setop(3, "Message");
                }
                if (staffmodlevel > 0 | autosetup_isactive > 0) {
                    cc_setop(5, "Report abuse");
                }
                if (~clientscript_4467 = true) {
                    cc_setop(10, "Kick/ban");
                }
            }
    }
}
return(calc($int0 + 1));
return(0);
