[proc,lobbyscreen_input_link_highlight](component $component0, int $int1, string $string)
if ($component0 ! null) {
    if ($int1 = true) {
        if_settext("<u=91b1f4><$string></u>", $component0);
        if_setcolour(0x91b1f4, $component0);
    } else {
        if_settext("<u=2c6ff8><$string></u>", $component0);
        if_setcolour(0x2c6ff8, $component0);
    }
}
