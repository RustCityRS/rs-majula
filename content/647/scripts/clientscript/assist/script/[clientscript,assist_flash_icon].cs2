// 537
[clientscript,assist_flash_icon](int $int0, int $int1)
def_int $int2 = 0;
def_int $int3 = calc($int1 + 25);
def_int $int4 = calc(clientclock - $int0);
if (clientclock >= $int1) {
    if (clientclock < $int3) {
        $int2 = calc(255 / ($int3 - $int1));
        $int2 = calc(255 - $int2 * (clientclock - $int1));
        if_settrans($int2, statusicons:assist_engaged);
        return;
    } else {
        if_setontimer(null, statusicons:assist_engaged);
        if_settrans(0, statusicons:assist_engaged);
        return;
    }
} else if ($int4 <= 5) {
    if_settrans(0, statusicons:assist_engaged);
} else if ($int4 <= 10) {
    if_settrans(85, statusicons:assist_engaged);
} else if ($int4 <= 15) {
    if_settrans(200, statusicons:assist_engaged);
} else {
    if_settrans(85, statusicons:assist_engaged);
}
