// 528
[proc,assist_set_icon](int $int0, graphic $graphic1, graphic $graphic2, component $component3, component $component4)
if ($int0 = 1) {
    if_setgraphic($component3, $graphic1);
    if_sethide($component4, false);
} else {
    if_setgraphic($component3, $graphic2);
    if_sethide($component4, true);
}
