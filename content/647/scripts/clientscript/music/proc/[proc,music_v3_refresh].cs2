[proc,music_v3_refresh]
~deltooltip_action(music_v3:com16);
%varc_int_1 = 0;
def_int $int0 = -1;
if (if_find(music_v3:com4) = true) {
    $int0 = cc_getparam(param_1133);
}
def_int $int1 = 0;
def_int $int2 = 0;
def_string $string = "";
def_int $int3 = string_length(%varc_string_196);
def_int $int4 = 5;
while ($int0 ! -1) {
    if (cc_find(music_v3:com1, calc($int0 * 2)) = true & .cc_find(music_v3:com1, calc($int0 * 2 + 1)) = true) {
        cc_clearops;
        .cc_clearops;
        $string = lowercase(cc_gettext);
        if (string_length($string) > 0) {
            if (~music_track_unlocked($int0) = true) {
                if ($int3 = false | string_indexof_string($string, %varc_string_196, 0) ! -1) {
