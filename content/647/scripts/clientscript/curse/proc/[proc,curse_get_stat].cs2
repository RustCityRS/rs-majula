// 1697
[proc,curse_get_stat](stat $stat0)(int)
switch_stat ($stat0) {
    case attack :
        return(calc(%varplayerbit_6857 - 30));
    case strength :
        return(calc(%varplayerbit_6858 - 30));
    case defence :
        return(calc(%varplayerbit_6859 - 30));
    case ranged :
        return(calc(%varplayerbit_6860 - 30));
    case magic :
        return(calc(%varplayerbit_6861 - 30));
    case default :
        return(0);
}
