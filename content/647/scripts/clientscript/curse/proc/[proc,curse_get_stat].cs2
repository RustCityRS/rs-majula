[proc,curse_get_stat](stat $stat)(int)
switch_stat ($stat) {
    case attack:
        return(calc(%varbit_6857 - 30));
    case strength:
        return(calc(%varbit_6858 - 30));
    case defence:
        return(calc(%varbit_6859 - 30));
    case ranged:
        return(calc(%varbit_6860 - 30));
    case magic:
        return(calc(%varbit_6861 - 30));
    case default:
        return(0);
}
