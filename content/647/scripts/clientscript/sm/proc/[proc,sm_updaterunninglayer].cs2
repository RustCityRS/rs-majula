// 593
[proc,sm_updaterunninglayer](int $int0)
def_inv $inv1 = enum(int, inv, enum_1079, %varplayer_1112);
def_obj $obj2 = inv_getobj($inv1, 0);
if_setobject($obj2, inv_getnum($inv1, 0), stockmarket:com_206);
if_clearops(stockmarket:com_206);
if ($obj2 ! null) {
    if (oc_cert($obj2) ! $obj2) {
        if (inv_getnum($inv1, 0) > 1) {
            if_setop(1, "Collect-notes", stockmarket:com_206);
            if_setop(2, "Collect-items", stockmarket:com_206);
        } else {
            if_setop(1, "Collect-items", stockmarket:com_206);
            if_setop(2, "Collect-notes", stockmarket:com_206);
        }
    } else {
        if_setop(1, "Collect", stockmarket:com_206);
    }
    if_setopbase(oc_name($obj2), stockmarket:com_206);
} else {
    if_setopbase("", stockmarket:com_206);
}
def_obj $obj3 = inv_getobj($inv1, 1);
if_setobject($obj3, inv_getnum($inv1, 1), stockmarket:com_208);
if_clearops(stockmarket:com_208);
if ($obj3 ! null) {
    if (oc_cert($obj3) ! $obj3) {
        if (inv_getnum($inv1, 1) > 1) {
            if_setop(1, "Collect-notes", stockmarket:com_208);
            if_setop(2, "Collect-items", stockmarket:com_208);
        } else {
            if_setop(1, "Collect-items", stockmarket:com_208);
            if_setop(2, "Collect-notes", stockmarket:com_208);
        }
    } else {
        if_setop(1, "Collect", stockmarket:com_208);
    }
    if_setopbase(oc_name($obj3), stockmarket:com_208);
} else {
    if_setopbase("", stockmarket:com_208);
}
if_setoninvtransmit("stockmarket_oninvtransmit{$inv1}", stockmarket:com_197);
def_int $int4 = stockmarket_getoffertype($int0);
def_int $int5 = stockmarket_getoffercount($int0);
def_int $int6 = stockmarket_getoffercompletedcount($int0);
def_int $int7 = stockmarket_getoffercompletedgold($int0);
def_string $string0 = tostring_localised($int6, true);
def_string $string1 = tostring_localised($int7, true);
cc_deleteall(stockmarket:com_199);
if (if_find(stockmarket:com_199) = true) {
    if (stockmarket_isofferadding($int0) = true) {
        .cc_create(stockmarket:com_199, ^iftype_text, 0);
        .cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
        .cc_setsize(cc_getwidth, cc_getheight, ^setsize_abs, ^setsize_abs);
        .cc_settextfont(p11_full);
        .cc_setcolour(0xdbd884);
        .cc_settext("Submitting offer...");
        .cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    } else {
        ~sm_draw_progress_bar(0, 0, cc_getwidth, cc_getheight, $int0, stockmarket:com_199, 0, stockmarket:com_210, 2);
    }
}
if (stockmarket_isofferfinished($int0) = true) {
    if ($int4 = 0) {
        if_settext("You bought a total of <col=cc9900><$string0></col><br>for a total price of <col=cc9900><$string1></col> gp.", stockmarket:com_198);
    } else {
        if_settext("You sold a total of <col=cc9900><$string0></col><br>for a total price of <col=cc9900><$string1></col> gp.", stockmarket:com_198);
    }
    if_sethide(true, stockmarket:com_200);
} else {
    if ($int4 = 0) {
        if_settext("You have bought a total of <col=cc9900><$string0></col> so far<br>for a total price of <col=cc9900><$string1></col> gp.", stockmarket:com_198);
    } else {
        if_settext("You have sold a total of <col=cc9900><$string0></col> so far<br>for a total price of <col=cc9900><$string1></col> gp.", stockmarket:com_198);
    }
    if_sethide(false, stockmarket:com_200);
}
