def_int $int7 = stockmarket_getoffergold($int0);
def_string $string0 = op4124($int6, 1);
def_string $string1 = op4124($int7, 1);
cc_deleteall(stockmarket:com199);
if (if_find(stockmarket:com199) = true) {
    if (stockmarket_isbuying($int0) = true) {
        .cc_create(stockmarket:com199, ^iftype_text, 0);
        .cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
        .cc_setsize(cc_getwidth, cc_getheight, ^setsize_abs, ^setsize_abs);
