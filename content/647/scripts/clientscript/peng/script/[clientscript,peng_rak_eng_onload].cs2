// 2414
[clientscript,peng_rak_eng_onload]
if (%varplayerbit_6180 = 120) {
    if_sethide(false, peng_rak_engine:fish_tools);
    if_sethide(true, peng_rak_engine:normal_tools);
    if (inv_total(inv, swordfish_14831) = 0) {
        if_sethide(true, peng_rak_engine:swordfish);
    }
    if (inv_total(inv, octopus) = 0 & inv_total(worn, octopus) = 0) {
        if_sethide(true, peng_rak_engine:octopus);
    }
    if (inv_total(inv, seaweed_14830) = 0) {
        if_sethide(true, peng_rak_engine:seaweed);
    }
    if (inv_total(inv, puffer) = 0 & inv_total(worn, puffer) = 0) {
        if_sethide(true, peng_rak_engine:blowfish);
    }
    if (inv_total(inv, electric_eel) = 0) {
        if_sethide(true, peng_rak_engine:eel);
    }
    if (inv_total(inv, shark_tooth) = 0) {
        if_sethide(true, peng_rak_engine:sharktooth);
    }
    if (inv_total(inv, crab_claw_14827) = 0) {
        if_sethide(true, peng_rak_engine:crab);
    }
} else {
    if_sethide(true, peng_rak_engine:fish_tools);
    if_sethide(false, peng_rak_engine:normal_tools);
}
if_setmodelanim(null, peng_rak_engine:gauge);
if_sethide(false, peng_rak_engine:wirebox_cover);
if_setmodel(model_46967, peng_rak_engine:wirebox);
if_setmodelanim(seq_11762, peng_rak_engine:gauge);
if_sethide(true, peng_rak_engine:lever_down);
if_sethide(false, peng_rak_engine:lever_up);
if_sethide(true, peng_rak_engine:bellows_demo);
if_sethide(false, peng_rak_engine:bellows);
if_setmodelanim(null, peng_rak_engine:lever_up);
if_sethide(true, peng_rak_engine:lever_up_fish);
if_sethide(true, peng_rak_engine:lever_down_fish);
if_sethide(true, peng_rak_engine:blowfish_demo);
%varclient_805 = 0;
%varclient_806 = 0;
