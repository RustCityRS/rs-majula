// 2416
[clientscript,peng_rak_engine_ops_wirebox](component $component0)
if (%peng_rak_eng_tools = 2 | %peng_rak_eng_tools = 8) {
    if_setop($component0, 1, "Cut wire");
} else if (%peng_rak_eng_tools = 3 | %peng_rak_eng_tools = 9) {
    if_setop($component0, 1, "Replace wire");
} else if (%peng_rak_eng_tools = 4 | %peng_rak_eng_tools = 10) {
    if_setop($component0, 1, "Repair wire");
} else {
    if_setop($component0, 1, "Inspect");
}
