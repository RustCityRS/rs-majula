// 4257
[clientscript,aif_build_close_button_on](component $component0)
if (if_find($component0) = true) {
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_setsize(16, 15, ^setsize_abs, ^setsize_abs);
    cc_setgraphic("aif_bronze_close_button_1,0");
    cc_setonclick("closebutton_click");
}
