// 4510
[proc,aif_build_button_layer_init](component $component0, struct $struct1)
if ($component0 = null | $struct1 = null) {
    return;
}
def_int $int2 = struct_param($struct1, param_1346);
if ($int2 = 2) {
    if_setonmouseover("script4159(event_com, 0, 0)", $component0);
    if_setonmouseleave("script4159(event_com, 255, 0)", $component0);
} else if ($int2 = 3) {
    if_setonclick("script4162(event_com)", $component0);
    if_setonrelease("script4163(event_com)", $component0);
    if_setonmouseleave("script4163(event_com)", $component0);
} else if ($int2 = 5) {
    return;
}
~aif_build_button_layer($component0, $struct1);
