[clientscript,snp_tutorial_tooltips](component $component0, component $component1)
def_string $string = "";
switch_component ($component0) {
    case di9181176:com8, di9181176:com12, di9181176:com27:
        $string = "The number of times that the avatar has been killed.";
    case di9181176:com9, di9181176:com13, di9181176:com24:
        $string = "The Slayer level required to attack each avatar.";
    case di9181176:com10, di9181176:com14, di9181176:com23:
        $string = "The remaining health of each avatar.";
    case di9181176:com25, di9181176:com26:
        $string = "How much time the game has remaining.";
    case di9181176:com7:
        $string = "This column displays the blue team's statistics.";
    case di9181176:com11:
        $string = "This column displays the red team's statistics.";
    case di9181176:com28:
        $string = "Shows which team controls the soul obelisk.";
    case di9181176:com29:
        $string = "Shows which team controls the western graveyard.";
    case di9181176:com30:
        $string = "Shows which team controls the eastern graveyard.";
    case di9181176:com68:
        $string = "Shows how much control a team has over the soul obelisk.";
    case di9181176:com74:
        $string = "Shows how active you have been during the game.";
    case default:
        return;
}
~addtooltip_action($component0, $component1, $string, 25, if_getwidth(if_getlayer($component1)));
