// 2100
[clientscript,snp_tutorial_tooltips](component $component0, component $component1)
def_string $string0 = "";
switch_component ($component0) {
    case snp_tutorial_game_overlay:blue_kills, snp_tutorial_game_overlay:red_kills, snp_tutorial_game_overlay:kills_title :
        $string0 = "The number of times that the avatar has been killed.";
    case snp_tutorial_game_overlay:blue_level, snp_tutorial_game_overlay:red_level, snp_tutorial_game_overlay:avatar_level :
        $string0 = "The Slayer level required to attack each avatar.";
    case snp_tutorial_game_overlay:blue_health, snp_tutorial_game_overlay:red_health, snp_tutorial_game_overlay:avatar_health :
        $string0 = "The remaining health of each avatar.";
    case snp_tutorial_game_overlay:time_left_title, snp_tutorial_game_overlay:time_left :
        $string0 = "How much time the game has remaining.";
    case snp_tutorial_game_overlay:blue_title :
        $string0 = "This column displays the blue team's statistics.";
    case snp_tutorial_game_overlay:red_title :
        $string0 = "This column displays the red team's statistics.";
    case snp_tutorial_game_overlay:obelisk_icon_colour :
        $string0 = "Shows which team controls the soul obelisk.";
    case snp_tutorial_game_overlay:west_icon_colour :
        $string0 = "Shows which team controls the western graveyard.";
    case snp_tutorial_game_overlay:east_icon_colour :
        $string0 = "Shows which team controls the eastern graveyard.";
    case snp_tutorial_game_overlay:com_68 :
        $string0 = "Shows how much control a team has over the soul obelisk.";
    case snp_tutorial_game_overlay:activity_bar_fill :
        $string0 = "Shows how active you have been during the game.";
    case default :
        return;
}
~addtooltip_action($component0, $component1, $string0, 25, if_getwidth(if_getlayer($component1)));
