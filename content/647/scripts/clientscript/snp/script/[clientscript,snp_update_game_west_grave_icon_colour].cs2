// 2087
[clientscript,snp_update_game_west_grave_icon_colour]
if (%snp_west_control_is_client <= 5) {
    if_setcolour(snp_game_overlay:west_icon_colour, 0x3366ff);
} else if (%snp_west_control_is_client >= 25) {
    if_setcolour(snp_game_overlay:west_icon_colour, 0xe12323);
} else {
    if_setcolour(snp_game_overlay:west_icon_colour, 0x666666);
}
