// 2095
[clientscript,snp_tutorial_flash_icons]
if (%varclient_654 < 100) {
    %varclient_654 = calc(%varclient_654 + 1);
}
if (%varclient_654 = 50) {
    if_sethide(true, snp_tutorial_game_overlay:east_grave_flash_layer);
    if_sethide(true, snp_tutorial_game_overlay:west_grave_flash_layer);
    if_sethide(true, snp_tutorial_game_overlay:obelisk_flash_layer);
}
if (%varclient_654 = 100) {
    if_sethide(false, snp_tutorial_game_overlay:east_grave_flash_layer);
    if_sethide(false, snp_tutorial_game_overlay:west_grave_flash_layer);
    if_sethide(false, snp_tutorial_game_overlay:obelisk_flash_layer);
    %varclient_654 = 0;
}
