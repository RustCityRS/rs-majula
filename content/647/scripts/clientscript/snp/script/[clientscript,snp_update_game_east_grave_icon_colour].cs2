// 2086
[clientscript,snp_update_game_east_grave_icon_colour]
if (%varclient_647 <= 5) {
    if_setcolour(0x3366ff, snp_game_overlay:east_icon_colour);
} else if (%varclient_647 >= 25) {
    if_setcolour(0xe12323, snp_game_overlay:east_icon_colour);
} else {
    if_setcolour(0x666666, snp_game_overlay:east_icon_colour);
}
