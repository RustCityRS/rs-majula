// 3211
[proc,create_resize]
if (getwindowmode < 2) {
    if_setposition(account_create:main, 0, 25, ^setpos_abs_centre, ^setpos_abs_centre);
    if_setposition(account_create:com_25, 0, 25, ^setpos_abs_centre, ^setpos_abs_centre);
} else {
    if_setposition(account_create:main, 0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    if_setposition(account_create:com_25, 0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
}
