// 3208
[proc,create_please_wait](int $int0)
def_graphic $graphic1 = "set_but_end_3,1";
def_graphic $graphic2 = "set_but_fill_3,1";
if ($int0 = 1) {
    ~script3209;
    if_setonclick(null, account_create:com_51);
    if_setonmouseover(null, account_create:com_51);
    if_settext("Please wait...", account_create:continue_text);
    if_settext("Please wait...", account_create:continue_text_shadow);
    if_setonclick(null, account_create:continue);
    if_setonmouseover(null, account_create:continue);
} else {
    if_setonclick("create_exit", account_create:com_51);
    if_setonmouseover("text_colour_swapper(event_com, 0xfafafa)", account_create:com_51);
    if_settext("Continue", account_create:continue_text);
    if_settext("Continue", account_create:continue_text_shadow);
    if_setonclick("create_go", account_create:continue);
    if_setonmouseover("script3937(account_create:continue_left, $graphic1, account_create:com_53, $graphic2, account_create:com_54, $graphic2, account_create:continue_right, $graphic1)", account_create:continue);
}
