[proc,create_check_username](string $string)(int)
def_int $int0 = string_length($string);
if ($int0 > 12) {
    return(0);
}
def_int $int1 = 0;
while ($int1 < $int0) {
    if (string_indexof_string("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_@.  ", substring($string, $int1, calc($int1 + 1)), 0) = -1) {
        return(0);
    }
    $int1 = calc($int1 + 1);
}
return(1);
return(-1);
