[proc,create_suggestions_highlight](component $component0, int $int1, string $string)
if ($int1 = true) {
    if_setcolour(0x43c800, $component0);
    if_settext("<u=43c800><$string></u>", $component0);
} else {
    if_setcolour(0x339900, $component0);
    if_settext("<u=339900><$string></u>", $component0);
}
