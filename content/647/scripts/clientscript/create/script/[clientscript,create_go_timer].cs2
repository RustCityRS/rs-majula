// 3220
[clientscript,create_go_timer]
def_int $int0 = create_reply;
if ($int0 = -3) {
    return;
}
if_setontimer(null, account_create:continue);
def_int $int1 = 0;
def_string $string0 = "accountappeal";
def_string $string1 = "passwordchoice.ws";
if ($int0 = 2) {
    notify_accountcreated;
    ~create_complete;
} else {
    switch_int ($int0) {
        case default :
            ~create_error("Unexpected server response.", account_create:com_81);
        case -4, -1, 3 :
            ~create_error("Error contacting server.", account_create:com_81);
        case -5 :
            ~create_error("No response from server.", account_create:com_81);
        case 7 :
            ~create_error("The server is currently very busy. Please try again shortly.", account_create:com_81);
        case 9, 38 :
