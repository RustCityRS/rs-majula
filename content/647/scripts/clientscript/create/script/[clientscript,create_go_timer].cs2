        case 30 :
            $int1 = string_length(%varclient_1643);
            if ($int1 < 5) {
                ~create_error("Passwords must be at least 5 characters long.", account_create:com_71);
            } else if ($int1 > 20) {
                ~create_error("Passwords must be no more than <tostring(20)> characters long.", account_create:com_71);
            } else {
                ~create_error("Please supply a valid password.", account_create:com_71);
            }
        case 31 :
            ~create_error("Passwords may only contain letters and numbers.", account_create:com_71);
        case 32, 33 :
