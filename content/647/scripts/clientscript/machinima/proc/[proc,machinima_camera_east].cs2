// 2856
[proc,machinima_camera_east]
if (~script2869(movecoord(%machinima_livecamera_position, 1, 0, 0)) = true) {
    return;
}
if (~machinima_distance(coord, movecoord(%machinima_livecamera_position, 1, 0, 0)) < 31) {
    %machinima_livecamera_position = movecoord(%machinima_livecamera_position, 1, 0, 0);
}
