// 2545
[proc,mob_set_head_9]
if (%mob_side_unit_head_9 = 1) {
    if_setgraphic(mob_side_units:unit9, "mob_unit_heads,4");
} else if (%mob_side_unit_head_9 = 2) {
    if_setgraphic(mob_side_units:unit9, "mob_unit_heads,1");
} else if (%mob_side_unit_head_9 = 3) {
    if_setgraphic(mob_side_units:unit9, "mob_unit_heads,2");
}
