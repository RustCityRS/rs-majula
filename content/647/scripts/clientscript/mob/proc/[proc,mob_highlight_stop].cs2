// 2635
[proc,mob_highlight_stop]
%mob_client_highlight = 0;
if_setontimer(mob_side_command:attack, null);
if_setgraphic(mob_side_command:attack, "mob_command_icons,0");
if_setontimer(mob_side_command:move, null);
if_setgraphic(mob_side_command:move, "mob_command_icons,1");
if_setontimer(mob_side_command:explore, null);
if_setgraphic(mob_side_command:explore, "mob_command_icons,2");
if_setontimer(mob_side_command:attack_wall, null);
if_setgraphic(mob_side_command:attack_wall, "mob_command_icons,3");
if_setontimer(mob_side_command:rescue, null);
if_setgraphic(mob_side_command:rescue, "mob_command_icons,7");
if_setontimer(mob_side_command:cave_collect, null);
if_setgraphic(mob_side_command:cave_collect, "mob_command_icons,4");
if_setontimer(mob_side_command:steal, null);
if_setgraphic(mob_side_command:steal, "mob_command_icons,5");
if_setontimer(mob_side_command:collect, null);
if_setgraphic(mob_side_command:collect, "mob_command_icons,6");
