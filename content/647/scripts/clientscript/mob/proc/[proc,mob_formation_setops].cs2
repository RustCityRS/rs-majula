    if ($int0 <= $int1) {
        $component2 = enum(105, 73, enum_2400, $int0);
        $component3 = enum(105, 73, enum_2402, $int0);
        if_setonclick("mob_formation_click(^event_com)", $component2);
        if_setonclick("mob_formation_click($component2)", $component3);
