// 2628
[proc,mob_side_command_status_icon]
if (%varclient_906 = 0) {
    if_setgraphic(graphic_1868, mob_side_command:status_graphic);
    if_settext("Idle", mob_side_command:unit_status);
} else if (%varclient_906 = 2) {
    if_setgraphic(graphic_1867, mob_side_command:status_graphic);
    switch_int (%varclient_907) {
        case 0 :
            %varclient_906 = 0;
            if_setgraphic(graphic_1868, mob_side_command:status_graphic);
            if_settext("Idle", mob_side_command:unit_status);
        case 1, 2 :
            if_settext("Exploring", mob_side_command:unit_status);
        case 3, 4 :
            if_settext("Attacking wall", mob_side_command:unit_status);
        case 5, 6, 7 :
            if_settext("Rescuing TzHaar", mob_side_command:unit_status);
        case 8, 9 :
            if_settext("Collecting gold", mob_side_command:unit_status);
        case 10, 11, 12 :
            if_settext("Stealing TzHaar", mob_side_command:unit_status);
        case 13, 14, 15 :
            if_settext("Collecting parts", mob_side_command:unit_status);
        case 16, 17, 18 :
            if_settext("Collecting Rocks", mob_side_command:unit_status);
        case 19, 20 :
            if_settext("Attacking catapult", mob_side_command:unit_status);
        case 21 :
            if_settext("Retaliating", mob_side_command:unit_status);
        case 22 :
            if_settext("Moving to destination", mob_side_command:unit_status);
        case 23 :
            if_settext("Attacking", mob_side_command:unit_status);
        case default :
            if_settext("Busy", mob_side_command:unit_status);
    }
}
