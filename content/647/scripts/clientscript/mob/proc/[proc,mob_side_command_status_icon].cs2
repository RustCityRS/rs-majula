[proc,mob_side_command_status_icon]
if (%varc_int_906 = false) {
    if_setgraphic(1868, mob_side_command:com25);
    if_settext("Idle", mob_side_command:com11);
} else if (%varc_int_906 = 2) {
    if_setgraphic(1867, mob_side_command:com25);
    switch_int (%varc_int_907) {
        case 0:
            %varc_int_906 = 0;
            if_setgraphic(1868, mob_side_command:com25);
            if_settext("Idle", mob_side_command:com11);
        case 1, 2:
            if_settext("Exploring", mob_side_command:com11);
        case 3, 4:
            if_settext("Attacking wall", mob_side_command:com11);
        case 5, 6, 7:
            if_settext("Rescuing TzHaar", mob_side_command:com11);
        case 8, 9:
            if_settext("Collecting gold", mob_side_command:com11);
        case 10, 11, 12:
            if_settext("Stealing TzHaar", mob_side_command:com11);
        case 13, 14, 15:
            if_settext("Collecting parts", mob_side_command:com11);
        case 16, 17, 18:
            if_settext("Collecting Rocks", mob_side_command:com11);
        case 19, 20:
            if_settext("Attacking catapult", mob_side_command:com11);
        case 21:
            if_settext("Retaliating", mob_side_command:com11);
        case 22:
            if_settext("Moving to destination", mob_side_command:com11);
        case 23:
            if_settext("Attacking", mob_side_command:com11);
        case default:
            if_settext("Busy", mob_side_command:com11);
    }
}
