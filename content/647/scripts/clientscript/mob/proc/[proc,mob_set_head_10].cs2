// 2547
[proc,mob_set_head_10]
if (%mob_side_unit_head_10 = 1) {
    if_setgraphic(mob_side_units:unit10, "mob_unit_heads,4");
} else if (%mob_side_unit_head_10 = 2) {
    if_setgraphic(mob_side_units:unit10, "mob_unit_heads,1");
} else if (%mob_side_unit_head_10 = 3) {
    if_setgraphic(mob_side_units:unit10, "mob_unit_heads,2");
}
