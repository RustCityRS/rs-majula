// 2630
[proc,mob_highlight_start](component $component0)
def_graphic $graphic1 = null;
def_graphic $graphic2 = null;
%varclient_905 = $component0;
%varclient_904 = 1;
switch_component ($component0) {
    case mob_side_command:button1 :
        $component0 = mob_side_command:attack;
        $graphic1 = "mob_command_icons,0";
        $graphic2 = "mob_command_icons,8";
    case mob_side_command:button2 :
        $component0 = mob_side_command:move;
        $graphic1 = "mob_command_icons,1";
        $graphic2 = "mob_command_icons,9";
    case mob_side_command:button3 :
        $component0 = mob_side_command:explore;
        $graphic1 = "mob_command_icons,2";
        $graphic2 = "mob_command_icons,10";
    case mob_side_command:button4 :
        if (%varplayerbit_6357 = 2) {
            $component0 = mob_side_command:attack_wall;
            $graphic1 = "mob_command_icons,3";
            $graphic2 = "mob_command_icons,11";
        }
        if (%varplayerbit_6357 = 3) {
            $component0 = mob_side_command:cave_collect;
            $graphic1 = "mob_command_icons,4";
            $graphic2 = "mob_command_icons,12";
        }
        if (%varplayerbit_6357 = 4) {
            $component0 = mob_side_command:rescue;
            $graphic1 = "mob_command_icons,7";
            $graphic2 = "mob_command_icons,15";
        }
    case mob_side_command:button5 :
        if (%varplayerbit_6357 = 2) {
            $component0 = mob_side_command:collect;
            $graphic1 = "mob_command_icons,6";
            $graphic2 = "mob_command_icons,14";
        }
        if (%varplayerbit_6357 = 4) {
            $component0 = mob_side_command:steal;
            $graphic1 = "mob_command_icons,5";
            $graphic2 = "mob_command_icons,13";
        }
}
if_setontimer("mob_highlight_timer($component0, $graphic1, $graphic2)", $component0);
