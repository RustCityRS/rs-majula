// 2537
[proc,mob_set_head_5]
if (%mob_side_unit_head_5 = 1) {
    if_setgraphic(mob_side_units:unit5, "mob_unit_heads,4");
} else if (%mob_side_unit_head_5 = 2) {
    if_setgraphic(mob_side_units:unit5, "mob_unit_heads,1");
} else if (%mob_side_unit_head_5 = 3) {
    if_setgraphic(mob_side_units:unit5, "mob_unit_heads,2");
}
