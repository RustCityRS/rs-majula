[proc,mob_locator_resource_setup]
if (%varclient_826 < 0) {
    %varclient_826 = 0;
}
if (%varclient_827 < 0) {
    %varclient_827 = 1;
}
if_settext("Charges left: <tostring(%varclient_826)>", mob_locator:charges);
if_setobject_nonum(copper_ore, 1, mob_locator:ore1);
if_setobject_nonum(tin_ore, 1, mob_locator:ore2);
if_setobject_nonum(iron_ore, 1, mob_locator:ore3);
if_setobject_nonum(silver_ore, 1, mob_locator:ore4);
