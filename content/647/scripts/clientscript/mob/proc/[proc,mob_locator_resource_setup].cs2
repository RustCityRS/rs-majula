    if_setcolour(0xe1981f, mob_locator:woodtext5);
}
if (%varclient_827 >= 4) {
    if_setcolour(0xe1981f, mob_locator:woodtext6);
}
if_setobject_nonum(raw_shrimps, 1, mob_locator:fish1);
