if_setcolour(0x996600, mob_locator:oretext8);
if_setcolour(0x996600, mob_locator:oretext9);
if (%varclient_827 >= 2) {
    if_setcolour(0xe1981f, mob_locator:oretext4);
    if_setcolour(0xe1981f, mob_locator:oretext5);
}
if (%varclient_827 >= 3) {
