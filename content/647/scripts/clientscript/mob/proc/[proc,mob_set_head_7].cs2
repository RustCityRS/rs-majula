// 2541
[proc,mob_set_head_7]
if (%mob_side_unit_head_7 = 1) {
    if_setgraphic(mob_side_units:unit7, "mob_unit_heads,4");
} else if (%mob_side_unit_head_7 = 2) {
    if_setgraphic(mob_side_units:unit7, "mob_unit_heads,1");
} else if (%mob_side_unit_head_7 = 3) {
    if_setgraphic(mob_side_units:unit7, "mob_unit_heads,2");
}
