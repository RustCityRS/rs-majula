// 2539
[proc,mob_set_head_6]
if (%mob_side_unit_head_6 = 1) {
    if_setgraphic(mob_side_units:unit6, "mob_unit_heads,4");
} else if (%mob_side_unit_head_6 = 2) {
    if_setgraphic(mob_side_units:unit6, "mob_unit_heads,1");
} else if (%mob_side_unit_head_6 = 3) {
    if_setgraphic(mob_side_units:unit6, "mob_unit_heads,2");
}
