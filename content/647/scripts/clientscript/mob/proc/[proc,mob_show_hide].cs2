// 2621
[proc,mob_show_hide]
if (if_gethide(mob_chat:com_1) = false) {
    if_sethide(true, mob_chat:com_1);
    if_sethide(false, mob_chat:com_47);
    if_sethflip(false, mob_chat:com_50);
} else {
    if_sethide(false, mob_chat:com_1);
    if_sethide(true, mob_chat:com_47);
    if_sethflip(true, mob_chat:com_50);
}
