[clientscript,mob_shop_init]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
$int2 = calc((if_getwidth(mob_reward_shop:com15) - 36 * 10) / (10 - 1));
$int3 = calc((if_getheight(mob_reward_shop:com15) - 128) / 3);
cc_deleteall(mob_reward_shop:com15);
cc_deleteall(mob_shop_side:com0);
while ($int4 = false) {
    if (enum(105, 79, %varc_int_875, $int0) ! logs_11760) {
        cc_create(mob_reward_shop:com15, ^iftype_graphic, $int0);
        cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
        cc_setposition(calc((36 + $int2) * ($int0 % 10)), calc($int0 / 10 * (32 + $int3)), ^setpos_abs_left, ^setpos_abs_top);
        cc_setobject(enum(105, 79, %varc_int_875, $int0), -1);
        cc_setopbase("<col=ff981f><oc_name(enum(105, 79, %varc_int_875, $int0))>");
        cc_setop(1, "Value");
        cc_setop(2, "Buy 1");
        cc_setop(3, "Examine");
