        cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
        cc_setposition(calc(42 * ($int0 % 4)), calc($int0 / 4 * 42), ^setpos_abs_left, ^setpos_abs_top);
        cc_setobject(enum(105, 79, %varc_int_875, $int0), inv_total(inv, enum(105, 79, %varc_int_875, $int0)));
        cc_setopbase("<col=ff981f><oc_name(enum(105, 79, %varc_int_875, $int0))>");
