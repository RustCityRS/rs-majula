        cc_setop(3, "Sell X");
        cc_setop(4, "Examine");
        cc_setgraphicshadow(0x333333);
        cc_setoutline(1);
        $int0 = calc($int0 + 1);
    } else {
        $int4 = 1;
    }
}
$int1 = $int0;
$int0 = 0;
$int4 = 0;
while ($int4 = false) {
    if (enum(105, 79, %varc_int_875, $int0) ! logs_11760) {
