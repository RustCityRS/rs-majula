// 2638
[clientscript,mob_command_unit_weight_icon]
if (%varclient_903 = 0) {
    if_setgraphic("mob_heavy_light_icons,1", mob_side_command:weight_graphic);
    if_settext("Light", mob_side_command:weight_txt);
} else if (%varclient_903 = 1) {
    if_setgraphic("mob_heavy_light_icons,0", mob_side_command:weight_graphic);
    if_settext("Heavy", mob_side_command:weight_txt);
}
