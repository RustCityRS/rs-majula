[clientscript,mob_command_onload]
if_settargetcursors(mob_side_command:button1, cursor_0, cursor_1);
if_settargetcursors(mob_side_command:button2, cursor_2, cursor_3);
if (%varplayerbit_6357 = 2) {
    if_settargetcursors(mob_side_command:button4, cursor_4, cursor_5);
    if_settargetcursors(mob_side_command:button5, cursor_12, cursor_13);
} else if (%varplayerbit_6357 = 3) {
    if_settargetcursors(mob_side_command:button4, cursor_6, cursor_7);
} else if (%varplayerbit_6357 = 4) {
    if_settargetcursors(mob_side_command:button4, cursor_10, cursor_11);
    if_settargetcursors(mob_side_command:button5, cursor_8, cursor_9);
}
~mob_side_command_status_icon;
