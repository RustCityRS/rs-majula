// 2555
[clientscript,mob_set_cross_8]
if (%mob_side_unit_cross_8 = 1) {
    if_setgraphic(mob_side_units:unit8_cross, "mob_cross_icon,0");
} else if (%mob_side_unit_cross_8 = 2) {
    if_setgraphic(mob_side_units:unit8_cross, "mob_cross_icon,2");
} else if (%mob_side_unit_cross_8 = 3) {
    if_setgraphic(mob_side_units:unit8_cross, "mob_cross_icon,3");
} else if (%mob_side_unit_cross_8 = 4) {
    if_setgraphic(mob_side_units:unit8_cross, "mob_cross_icon,1");
}
