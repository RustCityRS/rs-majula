        cc_setopbase("<col=ff981f><oc_name($obj6)>");
        cc_setop(1, "Examine");
        cc_setgraphicshadow(0x333333);
        cc_setoutline(1);
        $int2 = calc($int2 + 1);
        $int7 = cc_gety;
    }
    $int1 = calc($int1 + 1);
}
def_int $int8 = 0;
while ($int8 <= inv_size(inv)) {
    $obj6 = inv_getobj(inv, $int8);
    if ($obj6 ! null & enum_hasoutput(obj, enum_1939, $obj6) = true) {
