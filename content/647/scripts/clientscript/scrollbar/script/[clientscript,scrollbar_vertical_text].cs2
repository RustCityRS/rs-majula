// 3283
[clientscript,scrollbar_vertical_text](component $component0, component $component1, fontmetrics $fontmetrics2, int $int3)
if ($int3 = 0) {
    $int3 = 12;
}
def_int $int4 = paraheight(if_gettext($component1), calc(if_getwidth($component1) + 16), $fontmetrics2);
$int4 = calc($int4 * $int3);
mes("txt <tostring($int4)>, layer <tostring(if_getheight($component1))>");
if (if_getheight($component1) >= $int4) {
    mes("No scroll txt <tostring($int4)>, layer <tostring(if_getheight($component1))>");
    if_setsize($component1, calc(if_getwidth($component1) + 16), if_getheight($component1), ^setsize_abs, ^setsize_abs);
    if_sethide($component0, true);
} else {
    $int4 = paraheight(if_gettext($component1), if_getwidth($component1), $fontmetrics2);
    $int4 = calc($int4 * $int3);
    if_setscrollsize($component1, 0, calc($int4 + 10));
    mes("Scroll txt <tostring($int4)>, layer <tostring(if_getheight($component1))>");
    ~scrollbar_vertical($component0, $component1, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
}
