// 3290
[proc,scrollbar_vertical_2](component $component0, component $component1, component $component2, graphic $graphic3, graphic $graphic4, graphic $graphic5, graphic $graphic6, graphic $graphic7, graphic $graphic8)
def_int $int9 = if_getscrollheight($component1);
def_int $int10 = if_getheight($component0);
def_int $int11 = calc($int10 - 32);
def_int $int12 = 0;
if ($int9 > 0) {
    $int12 = scale($int10, $int9, $int11);
} else {
    $int12 = $int11;
}
$int12 = max($int12, 10);
def_int $int13 = if_getscrolly($component1);
def_int $int14 = 0;
def_int $int15 = 0;
if ($int13 > 0) {
    $int14 = calc($int9 - if_getheight($component1));
    if ($int14 = 0) {
        $int14 = 1;
    }
    if ($int13 > $int14) {
        if_setscrollpos(0, $int14, $component1);
        if_setscrollpos(0, $int14, $component2);
        $int13 = $int14;
    }
    $int15 = scale($int13, $int14, calc($int11 - $int12));
    $int15 = min(max($int15, 0), calc($int11 - $int12));
}
cc_create($component0, ^iftype_graphic, 0);
cc_setposition(0, 16, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(16, 32, ^setsize_abs, ^setsize_minus);
cc_setgraphic($graphic3);
cc_settiling(true);
cc_setonclick("scrollbar_vertical_jump_2($component0, $component1, $component2, event_mousey)");
cc_create($component0, ^iftype_graphic, 1);
cc_setposition(0, calc(16 + $int15), ^setpos_abs_left, ^setpos_abs_top);
cc_setgraphic($graphic5);
cc_settiling(true);
cc_setdraggable($component0, 0);
cc_setdragrenderbehaviour(1);
cc_setsize(16, $int12, ^setsize_abs, ^setsize_abs);
cc_setondrag("scrollbar_vertical_drag_2($component0, $component1, $component2, event_mousey, false)");
cc_setondragcomplete("scrollbar_vertical_drag_2($component0, $component1, $component2, event_mousey, true)");
cc_create($component0, ^iftype_graphic, 2);
cc_setposition(0, calc(16 + $int15), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(16, 5, ^setsize_abs, ^setsize_abs);
cc_setgraphic($graphic4);
cc_settiling(false);
cc_create($component0, ^iftype_graphic, 3);
cc_setposition(0, calc(16 + $int15 + $int12 - 5), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(16, 5, ^setsize_abs, ^setsize_abs);
cc_setgraphic($graphic6);
cc_settiling(false);
cc_create($component0, ^iftype_graphic, 4);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(16, 16, ^setsize_abs, ^setsize_abs);
cc_setgraphic($graphic7);
cc_settiling(false);
cc_setonhold("scrollbar_vertical_up_2($component0, $component1, $component2)");
cc_create($component0, ^iftype_graphic, 5);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_bottom);
cc_setsize(16, 16, ^setsize_abs, ^setsize_abs);
cc_setgraphic($graphic8);
cc_settiling(false);
cc_setonhold("scrollbar_vertical_down_2($component0, $component1, $component2)");
if_setonscrollwheel("scrollbar_vertical_wheel_2($component0, $component1, $component2, event_mousey)", $component0);
if_setonscrollwheel("scrollbar_vertical_wheel_2($component0, $component1, $component2, event_mousey)", $component1);
if_setonscrollwheel("scrollbar_vertical_wheel_2($component0, $component1, $component2, event_mousey)", $component2);
