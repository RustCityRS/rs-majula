[clientscript,imp_bank_setup]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
while ($int0 < inv_size(inv)) {
    cc_create(bank_deposit_imp:com14, ^iftype_graphic, $int0);
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc(40 * $int1), calc(40 * $int2), ^setpos_abs_left, ^setpos_abs_top);
    if (inv_getobj(inv, $int0) ! null) {
        cc_setobject(inv_getobj(inv, $int0), inv_getnum(inv, $int0));
        cc_setopbase(oc_name(inv_getobj(inv, $int0)));
        cc_setop(1, "Deposit");
        cc_setop(2, "Examine");
        cc_setondragcomplete("imp_deposit_drag(^event_com, ^event_subid, ^event_dragcom, ^event_dragsubid)");
        cc_setdragdeadzone(5);
        cc_setdragdeadtime(10);
    }
    $int0 = calc($int0 + 1);
    $int1 = calc($int1 + 1);
    if ($int1 = 8) {
        $int1 = 0;
        $int2 = calc($int2 + 1);
    }
}
