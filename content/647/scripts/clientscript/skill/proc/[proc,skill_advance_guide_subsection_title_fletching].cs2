[proc,skill_advance_guide_subsection_title_fletching](int $int)(int, string)
switch_int ($int) {
    case 0:
        return("Arrows", 1);
    case 1:
        return("Bows", 1);
    case 2:
        return("Bolts", 1);
    case 3:
        return("Darts", 1);
    case 4:
        return("Crossbows", 1);
    case 5:
        return("Other", 1);
    case 6:
        return("Activities", 1);
    case 7:
        return("Dungeoneering", 1);
    case 8:
        return("Milestones", 1);
    case default:
        return("", -1);
}
return("", 0);
