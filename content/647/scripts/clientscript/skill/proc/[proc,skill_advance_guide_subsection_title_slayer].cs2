[proc,skill_advance_guide_subsection_title_slayer](int $int)(int, string)
switch_int ($int) {
    case 0:
        return("Equipment", 1);
    case 1:
        return("Monsters", 1);
    case 2:
        return("Slayer Masters", 1);
    case 3:
        return("Dungeoneering", 1);
    case 4:
        return("Milestones", 1);
    case default:
        return("", -1);
}
return("", 0);
