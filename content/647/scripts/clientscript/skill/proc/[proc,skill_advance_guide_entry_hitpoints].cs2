// 994
[proc,skill_advance_guide_entry_hitpoints](int $int0, int $int1)(int, obj, string, string)
switch_int ($int0) {
    case 0 :
        switch_int ($int1) {
            case 0 :
                return(-1, silvthrill_rod, "Your Constitution tells you how healthy your character can be. A character with low Constitution will only have a small number of life points when they're fully healed, whereas a character with high Constitution can have many more life points.", "");
            case 1 :
                return(-1, silvthrill_rod, "If you see any <col=800000>red 'hitsplats'</col> during combat, the number shown corresponds to the number of life points lost as a result of that strike.", "");
            case 2 :
                return(-1, silvthrill_rod, "<col=800000>Blue hitsplats</col> mean no damage has been dealt.", "");
            case 3 :
                return(-1, silvthrill_rod, "<col=800000>Green hitsplats</col> are poison damage (members).", "");
            case 4 :
                return(-1, silvthrill_rod, "<col=800000>Yellow hitsplats</col> are disease damage (members).", "");
            case 5 :
                return(-1, silvthrill_rod, "<col=800000>Pink hitsplats</col> show life points restored through healing (while in Daemonheim).", "");
        }
    case 1 :
        switch_int ($int1) {
            case 0 :
                return(35, agile_top, "Members: Agile top (with 35 Defence)", "Members now have the Constitution level required to wear <col=000080>agile tops</col>. (They also need level 35 Defence.)");
            case 1 :
                return(35, agile_legs, "Members: Agile legs (with 35 Defence)", "Members now have the Constitution level required to wear <col=000080>agile legs</col>. (They also need level 35 Defence.)");
            case 2 :
                return(42, void_melee_helm, "Members: Void melee helm", "Members now have the Constitution level required to wear <col=000080>Void melee helms</col>.");
            case 3 :
                return(42, void_ranger_helm, "Members: Void ranger helm", "Members now have the Constitution level required to wear <col=000080>Void ranger helms</col>.");
            case 4 :
                return(42, void_mage_helm, "Members: Void mage helm", "Members now have the Constitution level required to wear <col=000080>Void mage helms</col>.");
            case 5 :
                return(42, void_knight_top, "Members: Void knight top", "Members now have the Constitution level required to wear <col=000080>Void knight tops</col>.");
            case 6 :
                return(42, void_knight_robe, "Members: Void knight robe", "Members now have the Constitution level required to wear <col=000080>Void knight robes</col>.");
            case 7 :
                return(42, void_knight_gloves, "Members: Void knight gloves", "Members now have the Constitution level required to wear <col=000080>Void knight gloves</col>.");
            case 8 :
                return(42, void_knight_deflector_19712, "Members: Void knight deflector", "Members now have the Constitution level required to wear <col=000080>Void knight deflectors</col>.");
            case 9 :
                return(42, void_knight_mace, "Members: Void knight mace", "Members now have the Constitution level required to wield <col=000080>Void knight maces</col>.");
            case 10 :
                return(42, silvthrill_rod, "Void knight equipment requires 42 Attack, Defence, Strength, Ranged, Magic and Constitution and 22 Prayer.", "<col=000080>Void knight equipment</col> requires 42 Attack, Defence, Strength, Ranged, Magic and Constitution and 22 Prayer.");
            case 11 :
                return(80, torva_full_helm, "Members: Torva full helm<br> (with 80 Strength and Defence)", "Members can now wear <col=000080>torva full helms</col>. (They also need level 80 Strength and Defence)");
            case 12 :
                return(80, torva_platebody, "Members: Torva platebody<br> (with 80 Strength and Defence)", "Members can now wear <col=000080>torva platebodies</col>. (They also need level 80 Strength and Defence)");
            case 13 :
                return(80, torva_platelegs, "Members: Torva platelegs<br> (with 80 Strength and Defence)", "Members can now wear <col=000080>torva platelegs</col>. (They also need level 80 Strength and Defence)");
            case 14 :
                return(80, virtus_mask, "Members: Virtus mask<br> (with 80 Magic and Defence)", "Members can now wear <col=000080>virtus masks</col>. (They also need level 80 Magic and Defence)");
            case 15 :
                return(80, virtus_robe_top, "Members: Virtus robe top<br> (with 80 Magic and Defence)", "Members can now wear <col=000080>virtus robe tops</col>. (They also need level 80 Magic and Defence)");
            case 16 :
                return(80, virtus_robe_legs, "Members: Virtus robe legs<br> (with 80 Magic and Defence)", "Members can now wear <col=000080>virtus robe legs</col>. (They also need level 80 Magic and Defence)");
            case 17 :
                return(80, pernix_cowl, "Members: Pernix cowl<br> (with 80 Ranged and Defence)", "Members can now wear <col=000080>pernix cowls</col>. (They also need level 80 Ranged and Defence)");
            case 18 :
                return(80, pernix_body, "Members: Pernix body<br> (with 80 Ranged and Defence)", "Members can now wear <col=000080>pernix bodies</col>. (They also need level 80 Ranged and Defence)");
            case 19 :
                return(80, pernix_chaps, "Members: Pernix chaps<br> (with 80 Ranged and Defence)", "Members can now wear <col=000080>pernix chaps</col>. (They also need level 80 Ranged and Defence)");
        }
    case 2 :
        switch_int ($int1) {
            case 0 :
                return(70, oak_door, "Members: Zamorak's Fortress in the God Wars Dungeon", "Members can now access the <col=000080>Zamorak Fortress</col> in the <col=000080>God Wars Dungeon</col>.");
            case 1 :
                return(99, constitution_cape, "Skill mastery", "<col=000080>Congratulations! You are now a master of <col=800000>Constitution<col=000080>. Members can visit <col=800000>Surgeon General Tafani<col=000080> at the <col=800000>Duel Arena Hospital<col=000080>. She has something special that is only available to true masters of the <col=800000>Constitution<col=000080> skill!");
        }
}
