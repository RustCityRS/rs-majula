// 2276
[proc,rand_interface_update_titles](int $int0, int $int1, component $component2)
def_string $string0 = enum(int, string, enum_2857, $int1);
def_int $int3 = enum(int, int, enum_2858, $int1);
def_string $string1 = enum(int, string, enum_2859, $int1);
if ($int0 = 1) {
    if_settext($string0, $component2);
    if ($int3 = 2) {
        if_setcolour(0x00a000, $component2);
    } else if ($int3 = 1) {
        if_setcolour(0x909000, $component2);
    } else if ($int3 = 0) {
        if_setcolour(0xa00000, $component2);
    }
    if_setonmouserepeat("addtooltip(event_com, rand_dungeon_rewards_v2:tooltip_layer, $string1, 25, 200)", $component2);
    if_setonmouseleave("deltooltip(rand_dungeon_rewards_v2:tooltip_layer)", $component2);
} else {
    if_settext("", $component2);
}
