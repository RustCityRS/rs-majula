// 3488
[clientscript,rand_ring_interface_init]
%varclient_1186 = 1337;
%varclient_1184 = 0;
if_setposition(if_getx(rand_ring_interface:ring_a_layer), 52, ^setpos_abs_left, ^setpos_abs_top, rand_ring_interface:ring_a_layer);
if_setposition(if_getx(rand_ring_interface:ring_b_layer), 52, ^setpos_abs_left, ^setpos_abs_top, rand_ring_interface:ring_b_layer);
if_setposition(if_getx(rand_ring_interface:ring_c_layer), 52, ^setpos_abs_left, ^setpos_abs_top, rand_ring_interface:ring_c_layer);
if_sethide(true, rand_ring_interface:melee_class_clicked);
if_sethide(true, rand_ring_interface:ranged_class_clicked);
if_sethide(true, rand_ring_interface:magic_class_clicked);
if_sethide(true, rand_ring_interface:skiller_class_clicked);
if_settrans(255, rand_ring_interface:melee_class_onhover);
if_settrans(255, rand_ring_interface:ranged_class_onhover);
if_settrans(255, rand_ring_interface:magic_class_onhover);
if_settrans(255, rand_ring_interface:skiller_class_onhover);
if_sethide(true, rand_ring_interface:melee_link);
if_sethide(true, rand_ring_interface:ranged_link);
if_sethide(true, rand_ring_interface:magic_link);
if_sethide(true, rand_ring_interface:skiller_link);
if_sethide(true, rand_ring_interface:confirm_upgrade_layer);
if_sethide(true, rand_ring_interface:reset_interface);
