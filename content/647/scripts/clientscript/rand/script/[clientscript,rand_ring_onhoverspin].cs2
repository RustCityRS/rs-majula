// 3490
[clientscript,rand_ring_onhoverspin](component $component0)
def_component $component1 = $component0;
switch_component ($component0) {
    case rand_ring_interface:com_184 :
        $component1 = rand_ring_interface:com_257;
    case rand_ring_interface:com_185 :
        $component1 = rand_ring_interface:com_242;
    case rand_ring_interface:com_186 :
        $component1 = rand_ring_interface:com_227;
    case rand_ring_interface:com_187 :
        $component1 = rand_ring_interface:com_212;
}
if (if_gettrans($component1) > 220) {
    if_settrans(calc(if_gettrans($component1) - 2), $component1);
}
