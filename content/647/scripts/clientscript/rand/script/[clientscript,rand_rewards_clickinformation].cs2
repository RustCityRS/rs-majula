// 2250
[clientscript,rand_rewards_clickinformation](int $int0)
def_int $int1 = calc($int0 / 5);
def_enum $enum2 = enum_3016;
if (map_members = true) {
    $enum2 = enum_3015;
}
if (map_members = true & $int1 = 41 | map_members = false & $int1 = 17) {
    if_sethide(true, rand_rewards_interface:confirm_layer);
    if_settext(struct_param(enum(int, struct, $enum2, $int1), param_1078), rand_rewards_interface:info_text);
    if_sethide(false, rand_rewards_interface:info_title);
    if_settext(oc_name(struct_param(enum(int, struct, $enum2, $int1), param_1070)), rand_rewards_interface:info_title);
    if_sethide(false, rand_rewards_interface:info_graphic);
    if_setobject(struct_param(enum(int, struct, $enum2, $int1), param_1070), -1, rand_rewards_interface:info_graphic);
    if_sethide(false, rand_rewards_interface:button_layer);
    if_sethide(false, rand_rewards_interface:buytext);
    if_sethide(false, rand_rewards_interface:button_buy);
    if_sethide(false, rand_rewards_interface:tokencost);
    if_sethide(false, rand_rewards_interface:tokengraphic);
    if_sethide(true, rand_rewards_interface:failbg);
    if_sethide(true, rand_rewards_interface:failtext);
    if_settext("1 : 1xp", rand_rewards_interface:tokencost);
} else if (stat_base(dungeoneering) < struct_param(enum(int, struct, $enum2, $int1), param_1071)) {
    if_sethide(true, rand_rewards_interface:confirm_layer);
    if_settext(struct_param(enum(int, struct, $enum2, $int1), param_1078), rand_rewards_interface:info_text);
    if_sethide(false, rand_rewards_interface:info_title);
    if_settext(oc_name(struct_param(enum(int, struct, $enum2, $int1), param_1070)), rand_rewards_interface:info_title);
    if_sethide(false, rand_rewards_interface:info_graphic);
    if_setobject(struct_param(enum(int, struct, $enum2, $int1), param_1070), -1, rand_rewards_interface:info_graphic);
    if_sethide(false, rand_rewards_interface:button_layer);
    if_sethide(true, rand_rewards_interface:buytext);
    if_sethide(true, rand_rewards_interface:button_buy);
    if_sethide(true, rand_rewards_interface:tokencost);
    if_sethide(true, rand_rewards_interface:tokengraphic);
    if_sethide(false, rand_rewards_interface:failbg);
    if_sethide(false, rand_rewards_interface:failtext);
    if_settext("Dungeoneering <tostring(struct_param(enum(int, struct, $enum2, $int1), param_1071))> required", rand_rewards_interface:failtext);
} else {
    if_sethide(true, rand_rewards_interface:confirm_layer);
    if_settext(struct_param(enum(int, struct, $enum2, $int1), param_1078), rand_rewards_interface:info_text);
    if_sethide(false, rand_rewards_interface:info_title);
    if_settext(oc_name(struct_param(enum(int, struct, $enum2, $int1), param_1070)), rand_rewards_interface:info_title);
    if_sethide(false, rand_rewards_interface:info_graphic);
    if_setobject(struct_param(enum(int, struct, $enum2, $int1), param_1070), -1, rand_rewards_interface:info_graphic);
    if_sethide(false, rand_rewards_interface:button_layer);
    if_sethide(false, rand_rewards_interface:buytext);
    if_sethide(false, rand_rewards_interface:button_buy);
    if_sethide(false, rand_rewards_interface:tokencost);
    if_sethide(false, rand_rewards_interface:tokengraphic);
    if_sethide(true, rand_rewards_interface:failbg);
    if_sethide(true, rand_rewards_interface:failtext);
    if_settext(tostring(struct_param(enum(int, struct, $enum2, $int1), param_1072)), rand_rewards_interface:tokencost);
}
