// 3497
[clientscript,rand_construction_onexit](component $component0)
switch_component ($component0) {
    case rand_start_room_construction:portal_button :
        if_sethide(true, rand_start_room_construction:portal_hover);
    case rand_start_room_construction:photo_booth_button :
        if_sethide(true, rand_start_room_construction:photo_booth_hover);
    case rand_start_room_construction:farming_button :
        if_sethide(true, rand_start_room_construction:farming_patch_hover);
    case rand_start_room_construction:range_button :
        if_sethide(true, rand_start_room_construction:range_hover);
    case rand_start_room_construction:altar_button :
        if_sethide(true, rand_start_room_construction:altar_hover);
    case rand_start_room_construction:skillcape_button :
        if_sethide(true, rand_start_room_construction:skillcape_hover);
}
