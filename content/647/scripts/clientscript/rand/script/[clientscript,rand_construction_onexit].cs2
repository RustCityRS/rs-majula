    case rand_start_room_construction:com_95 :
        if_sethide(true, rand_start_room_construction:com_107);
    case rand_start_room_construction:com_78 :
        if_sethide(true, rand_start_room_construction:com_90);
    case rand_start_room_construction:com_61 :
        if_sethide(true, rand_start_room_construction:com_73);
    case rand_start_room_construction:com_44 :
        if_sethide(true, rand_start_room_construction:com_57);
}
