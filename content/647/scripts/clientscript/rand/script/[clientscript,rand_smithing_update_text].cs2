// 2263
[clientscript,rand_smithing_update_text](component $component0, int $int1, string $string0, string $string1)
if ($int1 ! 1) {
    if_setop($component0, 1, "Make 1 <$string1>(<tostring($int1)>) ");
    if_setop($component0, 2, "Make 5 <$string1>(<tostring(calc($int1 * 5))>)");
    if_setop($component0, 3, "Make X <$string1>");
    if_setop($component0, 4, "Make All <$string1>");
    return;
}
if_setop($component0, 1, "Make 1 <$string0>");
if_setop($component0, 2, "Make 5 <$string1>");
if_setop($component0, 3, "Make X <$string1>");
if_setop($component0, 4, "Make All <$string1>");
