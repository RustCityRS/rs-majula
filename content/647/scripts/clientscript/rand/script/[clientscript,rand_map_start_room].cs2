[clientscript,rand_map_start_room](int $int0, int $int1, int $int2)
def_int $int3 = 0;
def_int $int4 = 0;
switch_int ($int2) {
    case 1:
        $int3 = calc(if_getwidth(rand_dungeon_map:com3) / 4);
        $int4 = calc(if_getheight(rand_dungeon_map:com3) / 4);
    case 2:
        $int3 = calc(if_getwidth(rand_dungeon_map:com3) / 4);
    case default:
}
cc_create(rand_dungeon_map:com4, ^iftype_graphic, %varc_int_1151);
%varc_int_1151 = calc(%varc_int_1151 + 1);
cc_setsize(32, 32, ^setsize_abs, ^setsize_abs);
cc_setgraphic("rand_map_room_special,0");
