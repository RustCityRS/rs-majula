// 3493
[clientscript,rand_ring_onexit](component $component0)
switch_component ($component0) {
    case rand_ring_interface:com_136 :
        if_sethide(true, rand_ring_interface:com_137);
    case rand_ring_interface:com_43 :
        if_sethide(true, rand_ring_interface:com_44);
    case rand_ring_interface:com_85 :
        if_sethide(true, rand_ring_interface:com_86);
    case rand_ring_interface:cancel_button :
        if_setgraphic("login_lobby_button,8", rand_ring_interface:cancel_button_left);
        if_setgraphic("login_lobby_button,9", rand_ring_interface:cancel_button_middle);
        if_setgraphic("login_lobby_button,8", rand_ring_interface:cancel_button_right);
    case rand_ring_interface:confirm_button :
        if_setgraphic("login_lobby_button,8", rand_ring_interface:confirm_button_left);
        if_setgraphic("login_lobby_button,9", rand_ring_interface:confirm_button_middle);
        if_setgraphic("login_lobby_button,8", rand_ring_interface:confirm_button_right);
}
