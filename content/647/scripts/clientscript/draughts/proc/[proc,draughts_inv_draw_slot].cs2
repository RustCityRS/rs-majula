[proc,draughts_inv_draw_slot](inv $inv0, int $int1, component $component2, int $int3)
def_string $string = "";
if (cc_find($component2, $int3) = true) {
    if (inv_getobj($inv0, $int1) ! null) {
        $string = "<col=ff981f><oc_name(inv_getobj($inv0, $int1))>";
        cc_setobject(inv_getobj($inv0, $int1), inv_getnum($inv0, $int1));
        cc_setopbase($string);
        cc_setop(10, "Examine<col=ff9040>");
        cc_setdragdeadzone(5);
        cc_setdragdeadtime(10);
        cc_setgraphicshadow(0x333333);
        cc_setoutline(1);
    } else {
        cc_setmodel(null);
        cc_clearops;
        cc_setdragdeadzone(0);
        cc_setdragdeadtime(0);
        cc_setondragcomplete(null);
    }
}
