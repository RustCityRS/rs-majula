// 783
[clientscript,quickchat_tutorial_loadcontent]
if (%quickchat_tutorial_show ! %quickchat_tutorial_show_client) {
    %quickchat_tutorial_show_client = %quickchat_tutorial_show;
    if (%quickchat_tutorial_show = 1) {
        ~script1029(enum_1484, 9);
    } else if (%quickchat_tutorial_show = 2) {
        ~quickchat_tutorial_showpage(enum_1486, 0, 7);
    } else if (%quickchat_tutorial_show = 3) {
        ~script1030(1485);
    }
}
