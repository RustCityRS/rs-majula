[proc,quickchat_enter_search](component $component0, component $component1, int $int2, int $int3)
%varclient_159 = 0;
%varclient_158 = 0;
def_int $int4 = 0;
while (cc_find($component0, $int4) = true) {
    if ($int4 = $int2) {
        cc_setonmouseover(null);
        cc_setonmouseleave(null);
        if (.cc_find($component1, $int4) = true) {
            .cc_sethide(false);
            .cc_setcolour(0x969777);
        }
    } else {
        cc_setonmouseover("quickchat_menu_highlight_show(calc($int3 - 1), $component1, $int4)");
        cc_setonmouseleave("quickchat_menu_highlight_hide(calc($int3 - 1), $component1, $int4)");
        if (.cc_find($component1, $int4) = true) {
            .cc_sethide(true);
        }
    }
    $int4 = calc($int4 + 1);
}
%varclient_128 = -1;
%varclient_129 = 0;
%varclient_1549 = "";
def_string $string0 = "Search phrases...";
if (%varclient_126 = 1) {
    $string0 = "To <%varclient_1546>: <col=800000><$string0>";
} else if (%varclient_126 = 2) {
    $string0 = "[<col=0000ff><clan_getchatdisplayname><col=000000>]: <col=800000><$string0>";
} else if (%varclient_126 = 8) {
