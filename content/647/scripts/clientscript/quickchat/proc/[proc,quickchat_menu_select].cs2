[proc,quickchat_menu_select](component $component0, component $component1, int $int2, component $component3, int $int4, int $int5)
%varc_int_159 = 0;
%varc_int_158 = 0;
def_int $int6 = 0;
while (cc_find($component0, $int6) = true) {
    if ($int6 = $int2) {
        cc_setonmouseover(null);
        cc_setonmouseleave(null);
        if (.cc_find($component1, $int6) = true) {
            .cc_sethide(false);
            .cc_setcolour(0x969777);
        }
    } else {
        cc_setonmouseover("clientscript_1082(calc($int4 - 1), $component1, $int6)");
        cc_setonmouseleave("clientscript_1083(calc($int4 - 1), $component1, $int6)");
        if (.cc_find($component1, $int6) = true) {
            .cc_sethide(true);
        }
    }
    $int6 = calc($int6 + 1);
}
~quickchat_menu_add($component3, $int4, $int5, -1, 0);
