if (if_gethide(chatbox_background:com_0) = true) {
    if (getwindowmode >= 2) {
        if_setgraphic(chat_background, chatbox:com_1);
        if_setalpha(false, chatbox:com_1);
        if_sethide(false, chatbox:com_1);
        if_sethide(false, chatbox:com_2);
    }
    if_sethide(true, chatbox_background:com_50);
    if_setonkey(null, chatbox_background:com_55);
    if_sethide(false, chatbox_background:com_0);
    if_sethide(true, chatbox_background:com_7);
    if_sethide(true, chatbox_background:com_9);
    if_sethide(true, chatbox_background:com_13);
    if_sethide(false, chatbox_background:com_17);
    if_sethide(false, chatbox_background:com_1);
    if_sethide(true, chatbox_background:com_3);
    if_setscrollpos(0, 0, chatbox_background:com_17);
}
~quickchat_phrase(chatbox_background:com_1, %varclient_130, -1);
