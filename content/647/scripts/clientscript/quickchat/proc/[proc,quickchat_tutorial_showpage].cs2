[proc,quickchat_tutorial_showpage](enum $enum0, int $int1, int $int2)
if_setscrollpos(0, 0, quickchat_tutorial:com25);
cc_deleteall(quickchat_tutorial:com24);
if_sethide(false, quickchat_tutorial:com17);
if_sethide(false, quickchat_tutorial:com35);
if_setonclick("clientscript_1028()", quickchat_tutorial:com30);
if_settext("Shortcut keys", quickchat_tutorial:com30);
cc_deleteall(quickchat_tutorial:com23);
cc_deleteall(quickchat_tutorial:com25);
~quickchat_tutorial_displaydata(enum(105, 115, $enum0, $int1));
if_settext("Page <tostring(calc($int1 + 1))> of <tostring($int2)>", quickchat_tutorial:com20);
def_int $int3 = calc($int1 + 1);
def_int $int4 = calc($int1 - 1);
if ($int1 ! calc($int2 - 1)) {
    if_setonclick("quickchat_tutorial_showpage($enum0, $int3, $int2)", quickchat_tutorial:com21);
    if_settrans(0, quickchat_tutorial:com21);
} else {
    if_setonclick(null, quickchat_tutorial:com21);
    if_settrans(200, quickchat_tutorial:com21);
}
if ($int1 ! 0) {
    if_setonclick("quickchat_tutorial_showpage($enum0, $int4, $int2)", quickchat_tutorial:com22);
    if_settrans(0, quickchat_tutorial:com22);
} else {
    if_setonclick(null, quickchat_tutorial:com22);
    if_settrans(200, quickchat_tutorial:com22);
