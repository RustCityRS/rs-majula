[proc,quickchat_objdialog_refreshsearch](component $component0, component $component1, component $component2, int $int3)
cc_deleteall($component1);
if (string_length(%varc_string_30) > 0) {
    ~quickchat_objdialog_dosearch($component0, $component1, $component2, $int3);
} else {
    if_setscrollsize(0, 0, $component1);
    ~quickchat_objdialog_doscrollbar($component1, $component2);
}
