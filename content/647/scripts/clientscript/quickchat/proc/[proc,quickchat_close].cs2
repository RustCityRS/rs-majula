// 1054
[proc,quickchat_close]
if_sethide(false, chatbox_background:com_50);
if_setonkey("chatdefault_onkey(event_keycode, event_keychar)", chatbox_background:com_55);
if_sethide(true, chatbox_background:com_0);
def_int $int0 = 0;
while (enum(int, component, enum_1550, $int0) ! null) {
    if_setonkey(null, enum(int, component, enum_1550, $int0));
    $int0 = calc($int0 + 1);
}
if (getwindowmode >= 2) {
    ~subchanged;
}
