// 1054
[proc,quickchat_close]
if_sethide(chatdefault:chat, false);
if_setonkey(chatdefault:input, "chatdefault_onkey(event_keycode, event_keychar)");
if_sethide(chatdefault:quickchat, true);
def_int $int0 = 0;
while (enum(int, component, enum_1550, $int0) ! null) {
    if_setonkey(enum(int, component, enum_1550, $int0), null);
    $int0 = calc($int0 + 1);
}
if (getwindowmode >= 2) {
    ~subchanged;
}
