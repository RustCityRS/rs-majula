// 2142
[proc,spirittree_entry](string $string0, int $int0, int $int1, int $int2)(int)
def_int $int3 = paraheight($string0, 390, p12_full);
def_int $int4 = 15;
cc_create(spirittree:com_7, ^iftype_text, $int0);
cc_setsize(390, calc($int3 * $int4), ^setsize_abs, ^setsize_abs);
cc_settext($string0);
cc_setposition(15, $int1, ^setpos_abs_left, ^setpos_abs_top);
cc_settextalign(^settextalign_left, ^settextalign_top, 0);
cc_setcolour(0x46320a);
cc_settextfont(p12_full);
cc_settextshadow(false);
cc_setop(1, "Teleport");
cc_setonmouseover("cc_text_colour_swapper(event_com, event_comsubid, 0x645028)");
cc_setonmouseleave("cc_text_colour_swapper(event_com, event_comsubid, 0x46320a)");
return(calc($int3 * $int4 + 5));
