[proc,spirittree_entry](int $int0, int $int1, int $int2, string $string)(int)
def_int $int3 = paraheight($string, 390, p12_full);
def_int $int4 = 15;
cc_create(spirittree:com7, ^iftype_text, $int0);
cc_setsize(390, calc($int3 * $int4), ^setsize_abs, ^setsize_abs);
cc_settext($string);
cc_setposition(15, $int1, ^setpos_abs_left, ^setpos_abs_top);
cc_settextalign(^settextalign_left, ^settextalign_top, 0);
cc_setcolour(0x46320a);
cc_settextfont(p12_full);
cc_settextshadow(false);
cc_setop(1, "Teleport");
cc_setonmouseover("cc_text_colour_swapper(^event_com, ^event_subid, 6574120)");
cc_setonmouseleave("cc_text_colour_swapper(^event_com, ^event_subid, 4600330)");
return(calc($int3 * $int4 + 5));
return(0);
