// 1332
[clientscript,script1332]
if (%varplayerbit_275 = 1) {
    if_setontimer(null, advisor_tutorial_chat:com_5);
    if_sethide(true, advisor_tutorial_chat:com_7);
    if_setgraphic(null, advisor_tutorial_chat:com_4);
} else if (~current_side_if = 7) {
    if_settext("To set Wind Rush to auto-cast, click on the flashing spell icon. You can hover over spell icons to read a brief description of the spell and the runes required to cast it.", advisor_tutorial_chat:com_7);
    if_settext("", advisor_tutorial_chat:com_6);
    if_setgraphic("magicon,50", advisor_tutorial_chat:com_4);
} else {
    if_settext("Click on the Magic icon to open your magic spellbook.", advisor_tutorial_chat:com_7);
    if_settext("", advisor_tutorial_chat:com_6);
    if_setgraphic("stonemenusideicons,7", advisor_tutorial_chat:com_4);
}
