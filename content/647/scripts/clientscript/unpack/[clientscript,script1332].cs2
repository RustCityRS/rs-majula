// 1332
[clientscript,script1332]
if (%autocast_set = 1) {
    if_setontimer(advisor_tutorial_chat:title, null);
    if_sethide(advisor_tutorial_chat:graphic_text, true);
    if_setgraphic(advisor_tutorial_chat:graphic, null);
} else if (~current_side_if = 7) {
    if_settext(advisor_tutorial_chat:graphic_text, "To set Wind Rush to auto-cast, click on the flashing spell icon. You can hover over spell icons to read a brief description of the spell and the runes required to cast it.");
    if_settext(advisor_tutorial_chat:body, "");
    if_setgraphic(advisor_tutorial_chat:graphic, "magicon,50");
} else {
    if_settext(advisor_tutorial_chat:graphic_text, "Click on the Magic icon to open your magic spellbook.");
    if_settext(advisor_tutorial_chat:body, "");
    if_setgraphic(advisor_tutorial_chat:graphic, "stonemenusideicons,7");
}
