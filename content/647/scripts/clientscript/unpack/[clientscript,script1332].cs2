// 1332
[clientscript,script1332]
if (%varplayerbit_275 = 1) {
    if_setontimer(null, advisor_tutorial_chat:title);
    if_sethide(true, advisor_tutorial_chat:graphic_text);
    if_setgraphic(null, advisor_tutorial_chat:graphic);
} else if (~current_side_if = 7) {
    if_settext("To set Wind Rush to auto-cast, click on the flashing spell icon. You can hover over spell icons to read a brief description of the spell and the runes required to cast it.", advisor_tutorial_chat:graphic_text);
    if_settext("", advisor_tutorial_chat:body);
    if_setgraphic("magicon,50", advisor_tutorial_chat:graphic);
} else {
    if_settext("Click on the Magic icon to open your magic spellbook.", advisor_tutorial_chat:graphic_text);
    if_settext("", advisor_tutorial_chat:body);
    if_setgraphic("stonemenusideicons,7", advisor_tutorial_chat:graphic);
}
