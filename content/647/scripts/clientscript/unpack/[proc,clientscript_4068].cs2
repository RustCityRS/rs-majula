[proc,clientscript_4068](component $component)
switch_component ($component) {
    case warguild_token_choice:com22:
        if (if_getgraphic(warguild_token_choice:com19) ! 4444) {
            if_setposition(-160, 18, ^setpos_abs_centre, ^setpos_abs_top, $component);
        }
    case warguild_token_choice:com23:
        if (if_getgraphic(warguild_token_choice:com17) ! 4445) {
            if_setposition(-80, 18, ^setpos_abs_centre, ^setpos_abs_top, $component);
        }
    case warguild_token_choice:com24:
        if (if_getgraphic(warguild_token_choice:com15) ! 4446) {
            if_setposition(0, 18, ^setpos_abs_centre, ^setpos_abs_top, $component);
        }
    case warguild_token_choice:com26:
        if (if_getgraphic(warguild_token_choice:com13) ! 4447) {
            if_setposition(80, 18, ^setpos_abs_centre, ^setpos_abs_top, $component);
        }
    case warguild_token_choice:com25:
        if (if_getgraphic(warguild_token_choice:com11) ! 4448) {
            if_setposition(160, 18, ^setpos_abs_centre, ^setpos_abs_top, $component);
        }
}
