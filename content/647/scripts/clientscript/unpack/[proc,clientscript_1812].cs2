[proc,clientscript_1812](component $component, string $string)
if (string_length($string) = false) {
    if_settext("", $component);
    %varc_string_39 = "";
    if_setontimer(null, $component);
    return;
}
if_settext($string, $component);
%varc_string_39 = $string;
if_setontimer("clientscript_1813(calc(clientclock + 1000), $component)", $component);
