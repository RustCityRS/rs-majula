// 2603
[clientscript,script2603]
sound_synth(synth_6784, 1, 0);
if_sethide(mob_squad_exchange:confirm_layer, false);
if_settext(mob_squad_exchange:confirm_text, "Are you sure you wish to resupply all defeated squads?");
if_sethide(mob_squad_exchange:confirm_resupply_all_layer, false);
if_sethide(mob_squad_exchange:confirm_reset_layer, true);
if_sethide(mob_squad_exchange:confirm_apply, true);
