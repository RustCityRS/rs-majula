// 3950
[clientscript,script3950](component $component0, int $int1)
if ($int1 = 1) {
    if_setcolour(0xfafafa, $component0);
    if_settext(append("<u=fafafa>", removetags(if_gettext($component0))), $component0);
} else {
    if_setcolour(0xcdbe9a, $component0);
    if_settext(append("<u=cdbe9a>", removetags(if_gettext($component0))), $component0);
}
