// 3950
[clientscript,script3950](component $component0, int $int1)
if ($int1 = 1) {
    if_setcolour($component0, 0xfafafa);
    if_settext($component0, append("<u=fafafa>", removetags(if_gettext($component0))));
} else {
    if_setcolour($component0, 0xcdbe9a);
    if_settext($component0, append("<u=cdbe9a>", removetags(if_gettext($component0))));
}
