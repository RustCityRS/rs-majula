// 2326
[proc,script2326](model $model0)
def_int $int1 = clientclock;
switch_model ($model0) {
    case model_32826, model_32828, model_32820 :
        %varclient_767 = 0;
        if_sethide(false, easter09_nuts:result);
        if_settext("Incorrect", easter09_nuts:result_text);
        sound_synth(synth_6424, 1, 0);
        if_setcolour(^red, easter09_nuts:result_text);
        if_setontimer("script2327($int1)", easter09_nuts:result);
    case default :
        %varclient_767 = calc(%varclient_767 + 1);
        if (%varclient_767 = 10) {
            if_sethide(false, easter09_nuts:end_layer);
            if_setop(1, "Train", easter09_nuts:end);
            if_setonclick(null, easter09_nuts:wirengoes);
        } else {
            if_sethide(false, easter09_nuts:result);
            if_settext("Correct", easter09_nuts:result_text);
            sound_synth(synth_6423, 1, 0);
            if_setcolour(^green, easter09_nuts:result_text);
            if_setontimer("script2327($int1)", easter09_nuts:result);
        }
}
if_settext("Correct: <tostring(%varclient_767)>/<tostring(10)>", easter09_nuts:correct_count);
sound_synth(synth_6423, 1, 0);
