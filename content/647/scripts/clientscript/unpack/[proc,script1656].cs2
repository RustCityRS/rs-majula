[proc,script1656]
if (%varplayerbit_6673 = 0) {
    if_setonop("closebutton_click", bank_v2_help:close_button);
    if_sethide(true, bank_v2_help:open_bank);
} else {
    if_setonop(null, bank_v2_help:close_button);
    if_sethide(false, bank_v2_help:open_bank);
    ~v2_stone_button(bank_v2_help:com_55);
}
