if_setposition(0, 133, ^setpos_abs_left, ^setpos_abs_top, conq_side_turn:opponents_turn_text);
if_setsize(190, 116, ^setsize_abs, ^setsize_abs, conq_side_turn:opponents_turn_text);
if_settextalign(^settextalign_centre, ^settextalign_centre, 0, conq_side_turn:opponents_turn_text);
if_setposition(30, 152, ^setpos_abs_left, ^setpos_abs_top, conq_side_turn:com_34);
if_setposition(30, 200, ^setpos_abs_left, ^setpos_abs_top, conq_side_turn:com_37);
if_settext("Recharge", conq_side_turn:com_39);
if_setop(1, "Recharge", conq_side_turn:com_39);
if_setposition(4, 148, ^setpos_abs_left, ^setpos_abs_top, conq_side_turn:confirm_end_text);
if_setposition(15, 204, ^setpos_abs_left, ^setpos_abs_top, conq_side_turn:com_25);
if_setposition(105, 204, ^setpos_abs_left, ^setpos_abs_top, conq_side_turn:com_28);
if_sethide(true, conq_side_turn:opponents_turn_layer);
if_sethide(true, conq_side_diplomacy:com_5);
if_sethide(true, conq_side_diplomacy:com_6);
if_sethide(true, conq_side_diplomacy:ignore_truce_layer);
if_sethide(true, conq_side_diplomacy:truce_instructions);
