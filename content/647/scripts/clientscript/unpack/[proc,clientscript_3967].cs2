[proc,clientscript_3967](component $component0, int $int1)
if ($int1 = true) {
    if (cc_find($component0, 0) = true) {
        cc_setgraphic("set_but_fill_3,1");
    }
    if (cc_find($component0, 1) = true) {
        cc_setgraphic("set_but_end_3,1");
    }
    if (cc_find($component0, 2) = true) {
        cc_setgraphic("set_but_end_3,1");
    }
} else {
    if (cc_find($component0, 0) = true) {
        cc_setgraphic("set_but_fill_3,0");
    }
    if (cc_find($component0, 1) = true) {
        cc_setgraphic("set_but_end_3,0");
    }
    if (cc_find($component0, 2) = true) {
        cc_setgraphic("set_but_end_3,0");
    }
    ~playerdesign4_tooltip_clear;
}
