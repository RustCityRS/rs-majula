        } else {
            if_settext("Learned!", lunarfm_rewards_new:extra_info);
        }
    case default :
        if (%varplayerbit_9067 < 8) {
            if_settext("You must unlock all the spells before you can use wishes.", lunarfm_rewards_new:extra_info);
        }
}
