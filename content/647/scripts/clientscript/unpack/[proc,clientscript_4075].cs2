[proc,clientscript_4075](component $component)
switch_int (%varc_int_1433) {
    case 1:
        ~tutorial3_fadeout(^black, 50, $component);
    case 2:
        ~tutorial3_fadein(50, $component);
        cam_allocpath(0, 2);
        cam_allocpath(1, 2);
        cam_addwaypoint(0, 0, ~xmas10_cs(16, 11), 500, ~xmas10_cs(16, 11), 500, 0);
        cam_addwaypoint(0, 1, ~xmas10_cs(14, 12), 400, ~xmas10_cs(14, 12), 400, 0);
        cam_addwaypoint(1, 0, ~xmas10_cs(15, 15), 400, ~xmas10_cs(15, 15), 400, 0);
        cam_addwaypoint(1, 1, ~xmas10_cs(15, 15), 300, ~xmas10_cs(15, 15), 300, 0);
        cam_startpath(0, 0, 100, 100, 1, 0);
    case 3:
        ~tutorial3_fadeout(^black, 30, $component);
    case 4:
        cam_clear_5503;
        ~tutorial3_fadein(50, $component);
}
