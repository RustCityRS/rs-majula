// 279
[clientscript,script279](int $int0, component $component1)
def_string $string0 = "";
switch_int ($int0) {
    case 1 :
        $string0 = "Found the perfect tackle for three species.";
    case 2 :
        $string0 = "Found the perfect tackle for all six species.";
    case 3 :
        $string0 = "Achieved an average rating of at least 80%.";
    case 4 :
        $string0 = "At least 80% of fish caught were the heaviest species.";
}
if_setonmouserepeat("addtooltip(event_com, fishcomp_scores:com_57, $string0, 25, 128)", $component1);
if_setonmouseleave("deltooltip(fishcomp_scores:com_57)", $component1);
