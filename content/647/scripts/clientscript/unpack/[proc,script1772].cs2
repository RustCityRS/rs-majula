// 1772
[proc,script1772]
if (%clanwars_rulevarc_nostragglers = false) {
    if_setgraphic(clanwars_setup:stragglers_indicator, "options_radio_buttons,2");
    if_setgraphic(clanwars_setup:nostragglers_indicator, "options_radio_buttons,0");
} else {
    if_setgraphic(clanwars_setup:stragglers_indicator, "options_radio_buttons,0");
    if_setgraphic(clanwars_setup:nostragglers_indicator, "options_radio_buttons,2");
}
~clanwars_updateside;
