// 1772
[proc,script1772]
if (%varclient_248 = false) {
    if_setgraphic("options_radio_buttons,2", clanwars_setup:stragglers_indicator);
    if_setgraphic("options_radio_buttons,0", clanwars_setup:nostragglers_indicator);
} else {
    if_setgraphic("options_radio_buttons,0", clanwars_setup:stragglers_indicator);
    if_setgraphic("options_radio_buttons,2", clanwars_setup:nostragglers_indicator);
}
~clanwars_updateside;
