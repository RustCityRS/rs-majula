// 827
[clientscript,script827](int $int0)
def_int $int1 = 0;
if (clientclock >= calc($int0 + 32) & clientclock < calc($int0 + 140)) {
    if_settext("Varrock Herald", afr_newspaper_interface:title);
    if_settext("Covering all of Misthalin and beyond.", afr_newspaper_interface:slogan);
    if_settext("1 gp", afr_newspaper_interface:price);
    if_settext("Oo'glog Ogresses Open Health Spa!", afr_newspaper_interface:byline);
} else {
    if_settext(" ", afr_newspaper_interface:title);
    if_settext(" ", afr_newspaper_interface:slogan);
    if_settext(" ", afr_newspaper_interface:price);
    if_settext(" ", afr_newspaper_interface:byline);
}
