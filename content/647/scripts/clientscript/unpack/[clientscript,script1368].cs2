[clientscript,script1368]
if_settext("Zamorak = <tostring(%varplayerbit_155)>", castlewars_status_overlay_zamorak:zamorak_score);
if_settext("<tostring(%varplayerbit_145)> = Saradomin", castlewars_status_overlay_zamorak:saradomin_score);
if_settext("<tostring(%varplayer_380)> min", castlewars_status_overlay_zamorak:time_remaining);
if (%varplayerbit_146 = 0) {
    if_settext("Health: <tostring(%varplayerbit_146)>%", castlewars_status_overlay_zamorak:health);
    if_setcolour(^red, castlewars_status_overlay_zamorak:health);
} else {
    if_settext("Health <tostring(%varplayerbit_146)>%", castlewars_status_overlay_zamorak:health);
    if_setcolour(^green, castlewars_status_overlay_zamorak:health);
}
if (%varplayerbit_143 = 0) {
    if_settext("Safe", castlewars_status_overlay_zamorak:saradomin_flag);
    if_setcolour(^green, castlewars_status_overlay_zamorak:saradomin_flag);
} else if (%varplayerbit_143 = 1) {
    if_settext("Taken", castlewars_status_overlay_zamorak:saradomin_flag);
    if_setcolour(^red, castlewars_status_overlay_zamorak:saradomin_flag);
} else if (%varplayerbit_143 = 2) {
    if_settext("Dropped", castlewars_status_overlay_zamorak:saradomin_flag);
    if_setcolour(^yellow, castlewars_status_overlay_zamorak:saradomin_flag);
}
