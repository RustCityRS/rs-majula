    case default:
        if_sethide(false, dv1710092:com126);
        if_sethide(true, dv1710092:com131);
        if_sethide(true, dv1710092:com140);
        ~clientscript_670;
        if_settext("First, you will see a selection of boxes. You can make several offers simultaneously, one in each box.", dv1710092:com124);
