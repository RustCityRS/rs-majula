// 3066
[proc,script3066](int $int0, int $int1, component $component2, component $component3, int $int4)
if ($int0 > 0) {
    if_setgraphic(graphic_4661, $component2);
    if_settext(tostring($int0), $component3);
    if ($int4 = 1) {
        if_setop(1, "Click Here To Play", $component2);
        if_setonop("script3067($int1)", $component2);
    } else {
        if_clearops($component2);
        if_setonop(null, $component2);
    }
    if_setonmouseover("script3068($component2)", $component2);
    if_setonmouseleave("script3069($component2)", $component2);
} else {
    if_setgraphic(graphic_4660, $component2);
    if_settext("", $component3);
    if_setonmouseover(null, $component2);
    if_setonmouseleave(null, $component2);
    if_setonop(null, $component2);
    if_clearops($component2);
}
return;
