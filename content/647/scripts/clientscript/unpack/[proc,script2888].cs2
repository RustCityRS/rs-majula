// 2888
[proc,script2888]
if (getwindowmode >= 2) {
    if_setposition(sfa:shard_num, 0, 287, ^setpos_abs_left, ^setpos_abs_top);
    if_setposition(sfa:shard, 0, 254, ^setpos_abs_left, ^setpos_abs_top);
} else {
    if_setposition(sfa:shard_num, 18, 40, ^setpos_abs_right, ^setpos_abs_top);
    if_setposition(sfa:shard, 18, 7, ^setpos_abs_right, ^setpos_abs_top);
}
