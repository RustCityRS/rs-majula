[proc,clientscript_4614](component $component)
switch_component ($component) {
    case skillcape_customise:com2:
        if_setcolour(hsv_to_rgb(%varbit_9254), $component);
    case skillcape_customise:com8:
        if_setcolour(hsv_to_rgb(%varbit_9255), $component);
    case skillcape_customise:com11:
        if_setcolour(hsv_to_rgb(%varbit_9256), $component);
    case skillcape_customise:com5:
        if_setcolour(hsv_to_rgb(%varbit_9257), $component);
}
