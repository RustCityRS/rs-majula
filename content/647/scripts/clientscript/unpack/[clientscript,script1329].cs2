[clientscript,script1329]
if (~current_side_if = 6) {
    if (%varplayerbit_6522 = 1) {
        if_settext("Click the flashing Prayer icon to activate the Thick Skin prayer. This prayer increases your Defence by 5%, which can be seen if you hover your mouse over the flashing Prayer icon.", advisor_tutorial_chat:com_7);
        if_settext("", advisor_tutorial_chat:com_6);
        if_setgraphic("prayeron,0", advisor_tutorial_chat:com_4);
    }
} else {
    if_settext("Click on the stone with the Prayer icon to open the Prayer side interface.", advisor_tutorial_chat:com_7);
    if_settext("", advisor_tutorial_chat:com_6);
    if_setgraphic("stonemenusideicons,6", advisor_tutorial_chat:com_4);
}
