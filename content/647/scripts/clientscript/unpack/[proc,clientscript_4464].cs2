[proc,clientscript_4464]()(int)
def_int $int = -1;
if (ignore_getname = true) {
    if (clanchannel2_find_affined = true) {
        $int = clanchannel_findname(removetags(docheat));
        if ($int ! -1 & clanchannel2_getuserrank($int) >= clanchannel_getbyte2) {
            return(1);
        }
    } else {
        mes("You must be in a clan to do that.");
    }
} else {
    mes("You must be in a clan to do that.");
}
return(0);
return(0);
