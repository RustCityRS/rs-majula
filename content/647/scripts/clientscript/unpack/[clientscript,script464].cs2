// 464
[clientscript,script464](component $component0)
if (stat_base(ranged) < 25) {
    if_settext($component0, "<col=c80000>A Ranged level of <tostring(25)> is required.</col>");
} else if (%varplayerbit_2086 < 1) {
    if_settext($component0, "<col=c80000>1 Commendation required.</col>");
} else {
    if_settext($component0, "<tostring(calc(pow(stat_base(ranged), 2) / 600 * 32))> XP per Commendation.");
}
