// 3418
[proc,script3418](component $component0, int $int1, int $int2)
def_graphic $graphic3 = "km_colourpickerbox,1";
def_graphic $graphic4 = "km_colourpickerbox,0";
if ($int2 = $int1) {
    if (cc_find($component0, 1) = true) {
        cc_setgraphic($graphic3);
        if_setonmouseover(null, $component0);
        if_setonmouseleave(null, $component0);
    }
} else if (cc_find($component0, 1) = true) {
    cc_setgraphic($graphic4);
    if_setonmouseover("cc_graphic_swapper(event_com, cc_getid, $graphic3)", $component0);
    if_setonmouseleave("cc_graphic_swapper(event_com, cc_getid, $graphic4)", $component0);
}
