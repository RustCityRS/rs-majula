// 473
[clientscript,script473](component $component0, int $int1)
if (stat_base(farming) < 25) {
    if_settext("<col=c80000>A Farming level of <tostring(25)> is required.</col>", $component0);
    return;
}
if (%varplayerbit_2086 < $int1) {
    if_settext("<col=c80000><tostring($int1)> Commendations required.</col>", $component0);
} else {
    if_settext("<tostring($int1)> Commendations.", $component0);
}
