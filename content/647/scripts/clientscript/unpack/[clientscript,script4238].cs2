// 4238
[clientscript,script4238](int $int0, component $component1, component $component2)
def_int $int3 = 0;
if (%acs_cooldown_varc ! 0) {
    $int3 = max(0, calc(120 - (clientclock - %acs_cooldown_varc)));
}
if ($int3 >= 60 & $int3 <= 120) {
    if_set2dangle($component2, min(calc($int3 * 545), 65353));
    if_set2dangle($component1, 0);
} else if ($int3 > 0 & $int3 < 60) {
    if_set2dangle($component2, 32768);
    if_set2dangle($component1, min(calc(32768 + $int3 * 545), 65353));
} else {
    if_set2dangle($component2, 32768);
    if_set2dangle($component1, 32768);
    if (%acs_cooldown_varc ! 0) {
        %acs_cooldown_varc = 0;
    }
}
