// 2863
[proc,script2863]
if (%machinima_livecamera_targetmode = 0) {
    if (%machinima_livecamera_lookatposition = 0) {
        %machinima_livecamera_lookatposition = 19;
    } else {
        %machinima_livecamera_lookatposition = calc(%machinima_livecamera_lookatposition - 1);
    }
} else if (%machinima_livecamera_targetmode = 1) {
    %machinima_livecamera_lookatpositioncoord = movecoord(%machinima_livecamera_lookatpositioncoord, -1, 0, 0);
} else {
    cam_dec_y;
}
