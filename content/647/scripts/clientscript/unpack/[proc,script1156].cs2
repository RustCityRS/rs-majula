[proc,script1156]
if (detailget_stereo = 0) {
    if_setgraphic("radio_buttons,0", sound_options:com_51);
    if_setgraphic("radio_buttons,1", sound_options:com_49);
} else {
    if_setgraphic("radio_buttons,0", sound_options:com_49);
    if_setgraphic("radio_buttons,1", sound_options:com_51);
}
