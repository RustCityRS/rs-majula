// 1868
[clientscript,script1868](component $component0)
if (calc(clientclock % 50) = 0 & reboottimer > 0) {
    if_setposition(0, -8, ^setpos_abs_centre, ^setpos_abs_centre, lobbyscreen:menu);
    ~script1870(lobbyscreen:update_timer_text);
    if_setontimer("script1869(lobbyscreen:update_timer_text)", $component0);
}
