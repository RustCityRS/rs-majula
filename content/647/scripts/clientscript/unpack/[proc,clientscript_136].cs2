[proc,clientscript_136](component $component)
def_string $string = "";
if ($component = pog_coin_machine:com15) {
    $string = oc_name(%varp_1068);
    if (%varp_1068 = -1) {
        $string = "Empty";
    }
} else if ($component = pog_coin_machine:com16) {
    $string = oc_name(%varp_1069);
    if (%varp_1069 = -1) {
        $string = "Empty";
    }
} else if ($component = pog_coin_machine:com17) {
    $string = oc_name(%varp_1070);
    if (%varp_1070 = -1) {
        $string = "Empty";
    }
}
~addtooltip_action($component, pog_coin_machine:com23, $string, 25, 199);
