[proc,clientscript_1175]
if (calc(clientclock % 10) ! 0) {
    return;
}
def_int $int0 = 0;
def_int $int1 = coordz(coord);
def_int $int2 = coordx(coord);
if ($int1 > 9919 & ($int1 < 10368 & ($int2 > 3007 & $int2 < 3136))) {
    $int0 = calc(($int1 - 9920) / 8 + 1);
} else if ($int1 > 3524 & ($int1 < 3968 & ($int2 > 2943 & ($int2 < 3393 & %varbit_5447 = false)))) {
    $int0 = calc(($int1 - 3520) / 8 + 1);
}
if ($int0 < 0) {
    $int0 = 0;
} else if ($int0 > 60) {
    $int0 = 60;
}
def_int $int3 = player_getcomlevel;
def_int $int4 = 0;
def_int $int5 = 0;
if (~pvpwild_world_check = true) {
    $int4 = calc($int3 - $int0);
    if ($int4 < 20) {
        $int4 = 20;
    }
    $int5 = calc($int3 + $int0);
    if ($int5 > 138) {
        $int5 = 138;
    }
    if ($int4 = $int5) {
        if (getwindowmode < 2) {
            if_settext(" ", toplevel:com9);
        } else {
            if_settext(" ", toplevel_fullscreen:com14);
        }
        return;
    }
} else {
    $int4 = calc($int3 - ($int0 + (5 + $int3 / 10)));
    if ($int4 < 20) {
        $int4 = 20;
    }
    $int5 = calc($int3 + ($int0 + (5 + $int3 / 10)));
    if ($int5 > 138) {
        $int5 = 138;
    }
    while ($int5 < 139 & calc($int5 - ($int0 + (5 + $int5 / 10))) <= $int3) {
        $int5 = calc($int5 + 1);
    }
    $int5 = calc($int5 - 1);
}
if (getwindowmode < 2) {
    if_settext("<tostring($int4)> - <tostring($int5)>", toplevel:com9);
} else {
    if_settext("<tostring($int4)> - <tostring($int5)>", toplevel_fullscreen:com14);
}
