// 776
[proc,script776]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_string $string0 = "Hello";
def_string $string1 = "00:00";
def_string $string2 = "1.1x";
if (%doublexp_setupflag = 1) {
    $int0 = calc(%doublexp_timetotal / 60);
    $int1 = calc(%doublexp_timetotal % 60);
    $int2 = calc(~doublexp_multiplier_for_stat(16) / 1000);
    $int3 = calc(~doublexp_multiplier_for_stat(16) % 1000 / 100);
    if ($int1 < 10) {
        if ($int0 < 10) {
            $string1 = "0<tostring($int0)>:0<tostring($int1)>";
        } else {
            $string1 = "<tostring($int0)>:0<tostring($int1)>";
        }
    } else if ($int0 < 10) {
        $string1 = "0<tostring($int0)>:<tostring($int1)>";
    } else {
        $string1 = "<tostring($int0)>:<tostring($int1)>";
    }
    $string2 = "<tostring($int2)>.<tostring($int3)>x";
    $string0 = "Multiplier:<col=ff0000><$string2></col><br>Elapsed:<col=ff0000><$string1></col><br>Bonus:<col=ff0000><tostring(calc(%doublexp_runningtotal / 10))>xp</col>";
    if_setonmouserepeat("addtooltip(toplevel_fullscreen:com_187, toplevel_fullscreen:com_183, $string0, 0, 500)", toplevel_fullscreen:com_187);
    if_setonmouseleave("deltooltip(toplevel_fullscreen:com_183)", toplevel_fullscreen:com_187);
    if_setonmouserepeat("addtooltip(toplevel:com_26, toplevel:com_22, $string0, 0, 500)", toplevel:com_26);
    if_setonmouseleave("deltooltip(toplevel:com_22)", toplevel:com_26);
}
