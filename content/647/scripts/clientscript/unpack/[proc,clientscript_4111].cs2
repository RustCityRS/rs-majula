} else {
    if_settext("You can set how many you wish to buy, and the price you're willing to pay, before clicking the 'Confirm Offer' button. We'll suggest a guide price for the item, but you can offer whatever you like.", handle_fills_03:com84);
    if_sethide(false, handle_fills_03:com85);
    if_setobject_nonum(staff_of_air, 1, handle_fills_03:com85);
