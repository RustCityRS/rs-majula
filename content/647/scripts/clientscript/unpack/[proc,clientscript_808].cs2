[proc,clientscript_808]
if_sethide(false, health_orb:com7);
def_int $int0 = scale(%life_points, ~clientscript_2916, 100);
def_int $int1 = calc(clientclock % 32);
if ($int0 > 25) {
    %varc_int_615 = 0;
    if (~clientscript_2916 < 200 & (%life_points < 45 & ($int0 < 100 & stat_base(hitpoints) > 0))) {
        ~clientscript_1888;
    } else {
        %varc_int_1025 = 0;
    }
    if (if_gettrans(health_orb:com7) ! 0) {
        if_settrans(0, health_orb:com7);
    } else {
        return;
    }
} else {
    if ($int1 = true) {
        if (%varc_int_615 <= 0) {
            %varc_int_615 = clientclock;
        }
        if (calc(clientclock - %varc_int_615) < 1500) {
            sound_synth(synth_5644, 1, 0);
        }
        if (stat_base(hitpoints) > 0) {
            ~clientscript_1888;
        }
    }
    if ($int1 < 8) {
        if_settrans(0, health_orb:com7);
    } else if ($int1 < 16) {
        if_settrans(85, health_orb:com7);
    } else if ($int1 < 24) {
        if_settrans(255, health_orb:com7);
    } else {
        if_settrans(85, health_orb:com7);
    }
}
