// 3161
[proc,script3161](int $int0)
if ($int0 = 1 & userdetail_quickchat = false) {
    if_setonkey("lobbyscreen_pane_clanchat_keyboard(event_keycode, event_keychar)", lobbyscreen_pane_clanchat:chat_input);
    if_setontimer("lobbyscreen_pane_clanchat_caret_flash(clientclock, lobbyscreen_pane_clanchat:input_caret)", lobbyscreen_pane_clanchat:chat_input_text);
} else {
    if_setonkey(null, lobbyscreen_pane_clanchat:chat_input);
    if_setontimer(null, lobbyscreen_pane_clanchat:chat_input_text);
    if_settext(escape(%varclient_1797), lobbyscreen_pane_clanchat:chat_input_text);
}
