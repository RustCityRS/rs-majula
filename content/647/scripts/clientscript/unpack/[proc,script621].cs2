// 621
[proc,script621]
def_int $int0 = 0;
def_string $string0 = null;
~sm_hideall;
if (%varplayer_1112 = -1 | stockmarket_isofferempty(%varplayer_1112) = true & %varplayer_1113 = -1) {
    ~deltooltip_action(stockmarket:offertooltip);
    if_sethide(false, stockmarket:summarylayer);
    ~script628;
    if_setoninvtransmit(null, stockmarket:runninglayer);
    %varclient_83 = 0;
    %varclient_82 = 0;
} else {
    while ($int0 < 6) {
        ~deltooltip_action(~script626($int0));
        $int0 = calc($int0 + 1);
    }
    if (stockmarket_isofferempty(%varplayer_1112) = false) {
        if_sethide(false, stockmarket:offerlayer);
