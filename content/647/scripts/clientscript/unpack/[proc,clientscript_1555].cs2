[proc,clientscript_1555](int $int)
if_setposition(~clientscript_1551(%varc_int_1028, %varc_string_1, 495, $int), if_gety(chatbox_background:com56), ^setpos_abs_left, ^setpos_abs_top, chatbox_background:com56);
if (string_length(%varc_string_1) <= 0) {
    if_sethide(true, chatbox_background:com56);
    if_setontimer(null, chatbox_background:com55);
} else {
    if (has_focus = true) {
        if_sethide(false, chatbox_background:com56);
    } else {
        if_sethide(true, chatbox_background:com56);
    }
    if_setontimer("caret_flash(clientclock, chatbox_background:com56)", chatbox_background:com55);
}
