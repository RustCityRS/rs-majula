// 477
[clientscript,script477](component $component0)
def_int $int1 = if_getx($component0);
def_int $int2 = calc(if_gety($component0) + if_getheight($component0));
if (stat_base(attack) < 42 | stat_base(strength) < 42 | stat_base(defence) < 42 | stat_base(hitpoints) < 42 | stat_base(ranged) < 42 | stat_base(magic) < 42 | stat_base(prayer) < 22) {
    if (calc($int1 + if_getwidth(conq_rewards:requirements_layer)) >= calc(if_getx(conq_rewards:com_55) + if_getwidth(conq_rewards:com_55))) {
        $int1 = calc(if_getx($component0) - (if_getwidth(conq_rewards:requirements_layer) - if_getwidth($component0)));
    }
    if (calc($int2 + if_getheight(conq_rewards:requirements_layer)) >= calc(if_gety(conq_rewards:com_55) + if_getheight(conq_rewards:com_55))) {
        $int2 = calc(if_gety($component0) - if_getheight(conq_rewards:requirements_layer));
    }
    if_setposition($int1, $int2, ^setpos_abs_left, ^setpos_abs_top, conq_rewards:requirements_layer);
    if_sethide(false, conq_rewards:requirements_layer);
}
