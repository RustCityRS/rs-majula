// 1179
[clientscript,script1179]
if (%doublexp_setupflag = 1) {
    if (map_lang = 1) {
        if_setgraphic("xp_token_with_plus,3", toplevel:xp_orb);
        if_setgraphic("xp_token_with_plus,3", toplevel_fullscreen:xp_orb);
    } else {
        if_setgraphic("xp_token_with_plus,1", toplevel:xp_orb);
        if_setgraphic("xp_token_with_plus,1", toplevel_fullscreen:xp_orb);
    }
} else if (map_lang = 1) {
    if_setgraphic("xp_token,3", toplevel:xp_orb);
    if_setgraphic("xp_token,3", toplevel_fullscreen:xp_orb);
} else {
    if_setgraphic("xp_token,1", toplevel:xp_orb);
    if_setgraphic("xp_token,1", toplevel_fullscreen:xp_orb);
}
