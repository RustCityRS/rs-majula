// 425
[clientscript,script425]
if (%varclient_1366 = 1) {
    if_setop(1, "Accept Victory", conq_side_diplomacy:com_16);
    if_settext("Accept Victory", conq_side_diplomacy:com_16);
    if_settext("Your opponent has logged out. You may end the Conquest now and be declared the winner.", conq_side_diplomacy:com_0);
} else {
    if_setop(1, "Resign", conq_side_diplomacy:com_16);
    if_settext("Resign", conq_side_diplomacy:com_16);
    if_settext("If you resign, the Conquest will end immediately.", conq_side_diplomacy:com_0);
    if_close;
}
