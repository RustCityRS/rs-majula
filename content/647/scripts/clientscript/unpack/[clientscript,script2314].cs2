[clientscript,script2314]
if (if_gethide(chatbox_background:com_78) = true) {
    if_setvflip(true, chatbox_background:com_131);
    if_sethide(false, chatbox_background:com_78);
    if_sethide(false, chatbox_background:com_77);
    if_sethide(false, chatbox_background:com_79);
    if_sethide(false, chatbox_background:com_69);
} else {
    if_setvflip(false, chatbox_background:com_131);
    if_sethide(true, chatbox_background:com_78);
    if_sethide(true, chatbox_background:com_77);
    if_sethide(true, chatbox_background:com_79);
    if_sethide(true, chatbox_background:com_69);
}
if_setvflip(false, chatbox_background:com_146);
if_sethide(true, chatbox_background:com_75);
if_sethide(true, chatbox_background:com_74);
if_sethide(true, chatbox_background:com_76);
if_sethide(true, chatbox_background:com_68);
