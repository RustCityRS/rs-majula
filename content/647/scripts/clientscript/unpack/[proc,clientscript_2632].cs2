[proc,clientscript_2632](component $component)
if ($component ! mob_side_command:com0) {
    ~v2_stone_button_in_proc($component);
}
switch_component ($component) {
    case mob_side_command:com0:
        if_settext("Go to", mob_side_command:com28);
        if_settext("Click to view this squad.", mob_side_command:com29);
    case mob_side_command:com13:
        if_settext("Attack", mob_side_command:com28);
        if_settext("Select the enemy squad you wish to attack.", mob_side_command:com29);
    case mob_side_command:com14:
        if_settext("Move", mob_side_command:com28);
        if_settext("Select the destination for your squad.", mob_side_command:com29);
    case mob_side_command:com15:
        if_settext("Explore", mob_side_command:com28);
        if_settext("Send the unit to explore for treasure.", mob_side_command:com29);
    case mob_side_command:com16:
        if (%varbit_6357 = 2) {
            if_settext("Attack wall/catapult", mob_side_command:com28);
            if_settext("Select the wall or catapult you want your squad to attack.", mob_side_command:com29);
        } else if (%varbit_6357 = 3) {
            if_settext("Collect gold", mob_side_command:com28);
            if_settext("Select the cave entrance from which your squad should gather gold.", mob_side_command:com29);
        } else if (%varbit_6357 = 4) {
            if_settext("Rescue", mob_side_command:com28);
            if_settext("Select the fissure from which your squad should rescue TzHaar.", mob_side_command:com29);
        }
    case mob_side_command:com17:
        if (%varbit_6357 = 2) {
            if_settext("Collect", mob_side_command:com28);
            if_settext("Select a resource for your squad to collect.", mob_side_command:com29);
        } else if (%varbit_6357 = 4) {
            if_settext("Steal", mob_side_command:com28);
            if_settext("Select a lander to steal TzHaar from.", mob_side_command:com29);
        }
}
