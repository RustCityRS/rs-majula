// 608
[proc,script608]
if (cc_find(lore_stats_side:spell_icon, 0) = true) {
    cc_setopbase("<col=00ff00><%varclient_1723>");
    cc_settargetverb("Cast");
    if (%lore_spell_op_binary = 1) {
        cc_setop(1, "Cast");
    }
}
if (cc_find(topstat_lore:spell_icon, 0) = true) {
    cc_setopbase("<col=00ff00><%varclient_1723>");
    cc_settargetverb("Cast");
    if (%lore_spell_op_binary = 1) {
        cc_setop(1, "Cast");
    }
}
