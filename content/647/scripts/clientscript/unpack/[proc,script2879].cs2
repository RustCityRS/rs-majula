// 2879
[proc,script2879](int $int0, int $int1, int $int2)(int)
def_string $string0 = "Remove from Playlist";
if (cc_find(music_v3:playlist, $int0) = true & .cc_find(music_v3:playlist, calc($int0 + 12)) = true) {
    if ($int1 = 32767) {
        cc_sethide(true);
        .cc_sethide(true);
        return($int2);
    }
    cc_setposition(15, $int2, ^setpos_abs_left, ^setpos_abs_top);
    cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
    if (%currentsong_id = $int1 & %playlist_mode = 1) {
        cc_setcolour(0xffff66);
        cc_setonmouseleave("cc_text_colour_swapper(event_com, event_comsubid, 0xffff66)");
    } else {
        cc_setcolour(^cyan);
        cc_setonmouseleave("cc_text_colour_swapper(event_com, event_comsubid, ^cyan)");
    }
    cc_setonmouseover("cc_text_colour_swapper(event_com, event_comsubid, ^white)");
    cc_settext(enum_string(enum_1345, $int1));
    cc_setsize(150, 15, ^setsize_abs, ^setsize_abs);
    cc_setop(1, "Play");
    cc_setop(2, "Remove");
    cc_setopbase(enum_string(enum_1345, $int1));
    .cc_setopbase(enum_string(enum_1345, $int1));
    cc_settextshadow(false);
    cc_settextfont(p11_full);
    cc_setdraggable(music_v3:playlist, -1);
    .cc_setdraggable(null, -1);
    cc_setdragrenderbehaviour(2);
    .cc_setsize(12, 12, ^setsize_abs, ^setsize_abs);
    .cc_setposition(2, calc($int2 + 1), ^setpos_abs_left, ^setpos_abs_top);
    .cc_setop(2, "Remove");
    .cc_setgraphic("music_icons_new,1");
    .cc_setonop("script2885(event_com, event_comsubid, 150, 0, 20, event_op)");
    .cc_setonmouserepeat("script1160(music_v3:playlist, event_comsubid, music_v3:music_tooltip_layer, $string0, 25, 189)");
    .cc_setonmouseleave("deltooltip(music_v3:music_tooltip_layer)");
    .cc_setonclick("deltooltip(music_v3:music_tooltip_layer)");
}
return(calc($int2 + 15));
