[proc,clientscript_439](component $component)
switch_int (%varbit_8087) {
    case 0:
        if_settext("0:30", $component);
    case 1:
        if_settext("1:00", $component);
    case 2:
        if_settext("1:30", $component);
    case 3:
        if_settext("2:00", $component);
    case 4:
