[proc,clientscript_3046](int $int)
if ($int > 1) {
    ~clientscript_3047(calc($int - 2));
} else {
    switch_int (chat_getfilter_private) {
        case 0:
            ~clientscript_3047(1);
        case 1:
            ~clientscript_3047(2);
        case 2:
            ~clientscript_3047(0);
    }
}
