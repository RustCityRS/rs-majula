// 950
[clientscript,script950]
switch_int (%varclient_1397) {
    case 0 :
        if_setcolour(0xffb400, rand_dungeon_rewards_v2:readyborder_player1);
    case 1 :
        if_setcolour(^green, rand_dungeon_rewards_v2:readyborder_player1);
    case 2 :
        if_setcolour(^red, rand_dungeon_rewards_v2:readyborder_player1);
}
