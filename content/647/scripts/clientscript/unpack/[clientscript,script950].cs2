// 950
[clientscript,script950]
switch_int (%rand_ready_state_player1) {
    case 0 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player1, 0xffb400);
    case 1 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player1, ^green);
    case 2 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player1, ^red);
}
