[proc,clientscript_278](int $int)(string)
switch_int ($int) {
    case 1:
        return("Standard");
    case 3:
        return("Large");
    case 2:
        return("Slim");
    case 6:
        return("Double");
    case 5:
        return("Wood");
    case 4:
        return("Bone");
}
return("Unknown hook");
return("");
