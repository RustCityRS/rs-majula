[proc,clientscript_2741]
def_string $string0 = "Confirm";
def_string $string1 = "Continue";
def_int $int = calc(op4125($string0, 495) + 30);
~clientscript_3965(playerdesign4:com117, $string0, $int, "");
~playerdesign4_button(playerdesign4:com115, $string1, calc(op4125($string1, 495) + 30), "");
$string1 = "Back";
$int = calc($int + 55);
~playerdesign4_button(playerdesign4:com116, $string1, calc(op4125($string1, 495) + 30), "");
if (%character_creation_multipage = true & %character_creation_page = false) {
    if_setposition(20, 0, ^setpos_abs_right, ^setpos_abs_bottom, playerdesign4:com115);
    if_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_bottom, playerdesign4:com116);
} else {
    if_setposition($int, 0, ^setpos_abs_right, ^setpos_abs_bottom, playerdesign4:com115);
    if_setposition($int, 0, ^setpos_abs_right, ^setpos_abs_bottom, playerdesign4:com116);
}
