// 3370
[clientscript,script3370](component $component0, int $int1)
def_int $int2 = calc(clientclock - $int1);
def_int $int3 = 0;
if ($int2 > 70) {
    if_sethide(true, toplevel_fullscreen:com_184);
    if_setontimer(null, toplevel_fullscreen:com_181);
    return;
}
$int3 = min(70, calc($int2 * 2));
if_setposition(7, $int3, ^setpos_abs_left, ^setpos_abs_top, toplevel_fullscreen:com_184);
if_sethide(false, toplevel_fullscreen:com_184);
