// 3116
[proc,script3116]
if (map_world = -1) {
    if_sethide(true, lobbyscreen_pane_worldselect:current_icon);
    if_settext("World: Auto", lobbyscreen_pane_worldselect:current_text);
    return;
}
def_int $int0 = 0;
def_string $string0 = "";
def_int $int1 = 0;
def_string $string1 = "";
def_int $int2 = 0;
def_int $int3 = 0;
def_string $string2 = "";
$int0, $string0, $int1, $string1, $int2, $int3, $string2 = worldlist_specific(map_world);
def_int $int4 = 0;
if (testbit($int0, 0) = ^true) {
    $int4 = 1;
} else {
    $int4 = 0;
}
def_string $string3 = "World <tostring(map_world)>";
if_settext($string3, lobbyscreen_pane_worldselect:current_text);
if_setposition(calc(stringwidth($string3, verdana_11pt_regular) + 5), 0, ^setpos_abs_right, ^setpos_abs_bottom, lobbyscreen_pane_worldselect:current_icon);
if ($int4 = 1) {
    if_setgraphic("world_select_stars,0", lobbyscreen_pane_worldselect:current_icon);
} else {
    if_setgraphic("world_select_stars,1", lobbyscreen_pane_worldselect:current_icon);
}
return;
