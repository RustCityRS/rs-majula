if_setgraphic("radio_buttons,0", conq_friendly_options:com_27);
if_setgraphic("radio_buttons,0", conq_friendly_options:com_28);
if_setgraphic("radio_buttons,0", conq_friendly_options:com_29);
switch_component ($component0) {
    case conq_friendly_options:com_30 :
        if_setgraphic("radio_buttons,1", conq_friendly_options:com_24);
    case conq_friendly_options:com_31 :
        if_setgraphic("radio_buttons,1", conq_friendly_options:com_25);
