[proc,script2221]
switch_int (%varplayer_1685) {
    case 0 :
        if_settext("", easter10_resourcegame:error_text);
    case 1 :
        if_settext("Not enough workers.", easter10_resourcegame:error_text);
    case 2 :
        if_settext("Not enough resources.", easter10_resourcegame:error_text);
    case 3 :
        if_settext("Worker limit reached.", easter10_resourcegame:error_text);
}
