[proc,clientscript_463](component $component)
if (stat_base(hitpoints) < 25) {
    if_settext("<col=c80000>A Constitution level of <tostring(25)> is required.</col>", $component);
} else if (%varbit_2086 < 1) {
    if_settext("<col=c80000>1 Commendation required.</col>", $component);
} else {
    if_settext("<tostring(calc(pow(stat_base(hitpoints), 2) / 600 * 35))> XP per Commendation.", $component);
}
