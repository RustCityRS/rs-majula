// 3032
[proc,script3032](component $component0, int $int1, int $int2)
def_component $component3 = null;
if ($int2 = 1) {
    $component3 = lobbyscreen_pane_friendslist:com_43;
} else if ($int2 = 0) {
    $component3 = lobbyscreen_pane_friendslist:com_85;
}
if (cc_find($component0, $int1) = true) {
    if_sethide(false, $component3);
    if_setposition(if_getx($component3), cc_gety, ^setpos_abs_left, ^setpos_abs_top, $component3);
}
if ($int2 = 1) {
    ~friend_deltooltip(lobbyscreen_pane_friendslist:com_32, lobbyscreen_pane_friendslist:com_35);
} else {
    ~friend_deltooltip(lobbyscreen_pane_friendslist:com_80, lobbyscreen_pane_friendslist:com_83);
}
