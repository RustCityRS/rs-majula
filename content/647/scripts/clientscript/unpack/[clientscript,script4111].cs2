// 4111
[clientscript,script4111]
if (%varplayer_1108 <= 3) {
    if_settext(handle_fills_03:com_84, "If you selected the 'Buy' option, you would see this screen. You can choose an item to buy by clicking on the indicated box.");
    if_sethide(handle_fills_03:com_85, true);
    if_settext(handle_fills_03:offeritem_marketprice, "N/A");
    if_sethide(handle_fills_03:com_68, false);
    if_settext(handle_fills_03:offeritem_name, "Choose an item to exchange");
    if_settext(handle_fills_03:offercount, "1");
    if_settext(handle_fills_03:offerprice, "1 gp");
    if_settext(handle_fills_03:totalvalue, "1 gp");
} else {
    if_settext(handle_fills_03:com_84, "You can set how many you wish to buy, and the price you're willing to pay, before clicking the 'Confirm Offer' button. We'll suggest a guide price for the item, but you can offer whatever you like.");
    if_sethide(handle_fills_03:com_85, false);
    if_setobject_nonum(handle_fills_03:com_85, staff_of_air, 1);
    if_settext(handle_fills_03:offeritem_marketprice, "1,281 gp");
    if_sethide(handle_fills_03:com_68, true);
    if_settext(handle_fills_03:offeritem_name, "Staff of air");
    if_settext(handle_fills_03:offercount, "2");
    if_settext(handle_fills_03:offerprice, "1,281 gp");
    if_settext(handle_fills_03:totalvalue, "2,562 gp");
}
