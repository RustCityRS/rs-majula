// 2853
[clientscript,script2853](component $component0, int $int1)
def_int $int2 = calc(clientclock - $int1);
def_int $int3 = 0;
if ($int2 <= 30) {
    if ($int2 = 5) {
        sound_synth(synth_2871, 1, 0);
    }
    $int3 = calc(11 * $int2 - 325);
    if_setposition($int3, 5, ^setpos_abs_left, ^setpos_abs_top, machinima_livecamera:messagelayer);
    return;
}
if ($int2 < 170) {
    return;
}
if ($int2 < 201) {
    if ($int2 = 5) {
        sound_synth(synth_2871, 1, 0);
    }
    $int3 = calc(5 - 11 * ($int2 - 170));
    if_setposition($int3, 5, ^setpos_abs_left, ^setpos_abs_top, machinima_livecamera:messagelayer);
    return;
}
if_setontimer(null, $component0);
