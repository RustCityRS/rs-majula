[proc,clientscript_2113](component $component)
if_setmodelangle(0, 0, random(2048), random(2048), random(2048), if_getmodelzoom($component), $component);
switch_int (random(3)) {
    case 0:
        if_setontimer("spinner(calc(random(3) + 9), 0, calc(random(3) + 9), $component)", $component);
    case 1:
        if_setontimer("spinner(calc(random(3) + 9), calc(random(3) + 9), 0, $component)", $component);
    case default:
        if_setontimer("spinner(0, calc(random(3) + 9), calc(random(3) + 9), $component)", $component);
}
