if (if_gethide(enum(int, component, enum_941, 5)) = false) {
    ~script3161(0);
}
if (string_length(%varclient_1798) > 0) {
    if_settext("Reporting: <%varclient_1798>", interface_915:com_49);
} else {
    if_settext("Report Abuse", interface_915:com_49);
}
if (playermod = 1 | staffmodlevel > 0) {
    if (%varclient_6 = false) {
        if_setgraphic("check_box_2,0", interface_915:com_46);
    } else {
        if_setgraphic("check_box_2,2", interface_915:com_46);
