    }
    if_setsize(calc(stringwidth(if_gettext(interface_915:com_47), verdana_11pt_regular) + 18), if_getheight(interface_915:com_45), ^setsize_abs, ^setsize_abs, interface_915:com_45);
    if_sethide(false, interface_915:com_45);
} else {
    if_sethide(true, interface_915:com_45);
}
