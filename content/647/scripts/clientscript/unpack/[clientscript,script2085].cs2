// 2085
[clientscript,script2085]
if (%varclient_645 <= 5) {
    if_setcolour(0x3366ff, snp_game_overlay:obelisk_icon_colour);
} else if (%varclient_645 >= 25) {
    if_setcolour(0xe12323, snp_game_overlay:obelisk_icon_colour);
} else {
    if_setcolour(0x666666, snp_game_overlay:obelisk_icon_colour);
}
