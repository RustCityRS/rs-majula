[proc,clientscript_1550](component $component)
if (if_getx($component) < calc(if_getwidth(easter09_nuts:com1) - 1)) {
    if (if_getx($component) = calc(140 + if_getwidth($component))) {
        if_setontimer("clientscript_2321(easter09_nuts:com8)", easter09_nuts:com21);
    }
    if_setposition(calc(1 + if_getx($component)), if_gety($component), ^setpos_abs_left, ^setpos_abs_top, $component);
} else {
    ~clientscript_2056;
}
