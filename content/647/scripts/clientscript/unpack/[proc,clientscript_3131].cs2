[proc,clientscript_3131](component $component0, int $int1, int $int2)
if (cc_find($component0, $int1) = true) {
    if_sethide(false, lobbyscreen_pane_worldselect:com65);
    if_sethide(false, lobbyscreen_pane_worldselect:com66);
    if_setposition(if_getx(lobbyscreen_pane_worldselect:com65), cc_gety, ^setpos_abs_left, ^setpos_abs_top, lobbyscreen_pane_worldselect:com65);
    if_setposition(if_getx(lobbyscreen_pane_worldselect:com66), cc_gety, ^setpos_abs_left, ^setpos_abs_top, lobbyscreen_pane_worldselect:com66);
}
if_setcolour(0x404040, lobbyscreen_pane_worldselect:com66);
if_setcolour(0x606060, lobbyscreen_pane_worldselect:com65);
return;
