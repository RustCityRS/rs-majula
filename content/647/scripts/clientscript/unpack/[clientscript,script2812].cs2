// 2812
[clientscript,script2812](int $int0, component $component1)
def_int $int2 = if_gettrans($component1);
def_int $int3 = min(max(calc($int2 + $int0 * 1), 225), 255);
if ($int3 = 225 | $int3 = 255) {
    if_setontimer("script2812(calc(0 - $int0), $component1)", $component1);
}
if_settrans($int3, $component1);
