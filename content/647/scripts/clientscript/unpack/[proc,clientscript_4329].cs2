[proc,clientscript_4329](component $component)
if (%clansetting_long_2 ! -1L) {
    if_settext(long_to_base36(%clansetting_long_2), $component);
    if_setonmouseover("text_colour_swapper($component, 255)", $component);
    if_setonmouseleave("text_colour_swapper($component, 15393218)", $component);
    if_setmouseover_cursor(175, $component);
    if_setonclick("clientscript_4330(%clansetting_long_2)", $component);
    if_setopbase("Visit Clan Forum", $component);
} else {
    if_settext("", $component);
}
