// 466
[clientscript,script466](component $component0)
if (stat_base(magic) < 25) {
    if_settext("<col=c80000>A Magic level of <tostring(25)> is required.</col>", $component0);
} else if (%varplayerbit_2086 < 1) {
    if_settext("<col=c80000>1 Commendation required.</col>", $component0);
} else {
    if_settext("<tostring(calc(pow(stat_base(magic), 2) / 600 * 32))> XP per Commendation.", $component0);
}
