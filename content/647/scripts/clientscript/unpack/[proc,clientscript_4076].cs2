[proc,clientscript_4076](component $component)
switch_int (%varc_int_1434) {
    case 1:
        ~tutorial3_fadeout(^black, 50, $component);
    case 2:
        ~tutorial3_fadein(50, $component);
        cam_allocpath(0, 2);
        cam_allocpath(1, 2);
        cam_addwaypoint(0, 0, ~xmas10_cs(14, 6), 1200, ~xmas10_cs(14, 6), 1200, 0);
        cam_addwaypoint(0, 1, ~xmas10_cs(14, 4), 1100, ~xmas10_cs(14, 4), 1100, 0);
        cam_addwaypoint(1, 0, ~xmas10_cs(15, 15), 500, ~xmas10_cs(15, 15), 500, 0);
        cam_addwaypoint(1, 1, ~xmas10_cs(15, 14), 400, ~xmas10_cs(15, 14), 400, 0);
        cam_startpath(0, 0, 260, 260, 1, 0);
    case 3:
        cam_allocpath(0, 2);
        cam_allocpath(1, 2);
        cam_addwaypoint(0, 0, ~xmas10_cs(14, 4), 1100, ~xmas10_cs(14, 4), 1100, 0);
        cam_addwaypoint(0, 1, ~xmas10_cs(14, 0), 900, ~xmas10_cs(14, 0), 900, 0);
        cam_addwaypoint(1, 0, ~xmas10_cs(15, 14), 400, ~xmas10_cs(15, 14), 400, 0);
        cam_addwaypoint(1, 1, ~xmas10_cs(15, 14), 300, ~xmas10_cs(15, 14), 300, 0);
        cam_startpath(0, 0, 250, 250, 1, 0);
    case 4:
        ~tutorial3_fadeout(^black, 30, $component);
    case 5:
        cam_clear_5503;
        ~tutorial3_fadein(50, $component);
}
