[proc,clientscript_4431](component $component)
def_string $string = "";
if (clanchannel2_find_affined = true) {
    if_setontimer(null, $component);
    ~clan_chat_onclansettingstransmit;
    if_sethook1431("clan_chat_onclansettingstransmit()", clan_chat:com3);
    if_sethook1432("clan_chat_onclansettingstransmit()", clan_chat:com3);
    if_setgraphic("aif_clanchat_icons,12", clan_chat:com86);
} else {
    ~clan_chat_clearlist;
    $string = "Join Clan Chat channel.";
    if_setonmouserepeat("aif_tooltip(clan_chat:com60, ^event_com, -1, $string, 120, 3793, verdana_11pt_regular, 16777215, 13, 4, 0, ^event_mousex, ^event_mousey)", clan_chat:com85);
    if_setop(1, "Join Clan Chat channel", clan_chat:com85);
    ~clientscript_4589;
}
