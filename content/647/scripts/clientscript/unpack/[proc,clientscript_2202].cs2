def_int $int1 = 0;
while ($int1 < $int0) {
    if (string_indexof_string("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", substring($string, $int1, calc($int1 + 1)), 0) = -1) {
