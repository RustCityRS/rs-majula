[proc,clientscript_4074](string $string)
def_int $int = 0;
$int = calc(paraheight($string, 346, p12_full) * 13);
if ($int > 48) {
    $int = calc(paraheight($string, 328, p12_full) * 13);
}
if ($int > 48) {
    if_setscrollsize(0, $int, quest_intro:com65);
    ~scrollbar_vertical(quest_intro:com63, quest_intro:com65, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
    if_setsize(334, 48, ^setsize_abs, ^setsize_abs, quest_intro:com65);
    if_setsize(16384, $int, ^setsize_rel, ^setsize_abs, quest_intro:com2);
    if_setsize(16384, $int, ^setsize_rel, ^setsize_abs, quest_intro:com3);
    if_settextalign(^settextalign_left, ^settextalign_top, 0, quest_intro:com66);
} else {
    if_setsize(354, 48, ^setsize_abs, ^setsize_abs, quest_intro:com65);
    if_settextalign(^settextalign_left, ^settextalign_centre, 0, quest_intro:com66);
}
