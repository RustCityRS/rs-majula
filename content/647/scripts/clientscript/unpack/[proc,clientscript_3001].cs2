def_int $int6 = get_accountinfo_6904;
if ($int6 = false) {
    if_settext("Welcome to RuneScape!", ix926645:com1);
    return;
}
def_int $int7 = calc(date_getdays - $int6);
if ($int7 < 1) {
    if_settext("You last logged in earlier today from: <get_clipboard>", ix926645:com1);
} else if ($int7 = true) {
    if_settext("You last logged in yesterday from: <get_clipboard>", ix926645:com1);
} else {
    if_settext("You last logged in <tostring($int7)> days ago from: <get_clipboard>", ix926645:com1);
}
