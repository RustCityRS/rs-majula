[proc,clientscript_3001]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_string $string0 = "";
def_int $int3 = 0;
def_int $int4 = 0;
def_int $int5 = 0;
def_string $string1 = "";
def_string $string2 = "";
def_string $string3 = "";
$int1, $int2, $int0 = subscription_info;
if ($int0 = false & is_logged_in = true) {
    $string0 = date_to_string($int1);
    $int3 = calc($int2 / 1440);
    $int4 = calc($int2 % 1440 / 60);
    $int5 = calc($int2 % 60);
    if (calc($int3 + $int4 + $int5) ! 0) {
        $string1 = " (in <~date_tostring($int3, $int4, $int5)>)";
    }
    $string2 = "Your membership will expire on <$string0><$string1>. Renew now to avoid losing member status. Click <col=0166ff><u=0166ff>here</u></col> to renew.";
    $string3 = "Your membership will expire on <$string0><$string1>. Renew now to avoid losing member status. Click <col=0296fe><u=0296fe>here</u></col> to renew.";
    if_settext($string2, ix926645:com54);
    if_setonmouseover("text_swapper(^event_com, $string3)", ix926645:com54);
    if_setonmouseleave("text_swapper(^event_com, $string2)", ix926645:com54);
