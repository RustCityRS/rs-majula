// 3095
[proc,script3095](component $component0, component $component1, int $int2)
def_string $string0 = "";
def_string $string1 = "";
switch_int ($int2) {
    case 4 :
        $string0 = "ticketing";
        $string1 = "inbox.ws";
        if_setonop($component0, "lobbyscreen_link($string0, $string1, true)");
    case 11 :
        $string0 = "password_history";
        $string1 = "password.ws";
        if_setonop($component0, "lobbyscreen_link($string0, $string1, true)");
    case 18 :
        $string0 = "accountappeal";
        $string1 = "lockchoice.ws";
        if_setonop($component0, "script3089($string0, $string1, true)");
    case 31 :
        $string0 = "displaynames";
        $string1 = "name.ws";
        if_setonop($component0, "lobbyscreen_link($string0, $string1, true)");
    case 32, 12, 19, 30, -2000, -3000 :
        $string0 = "dob";
        $string1 = "set_members_dob.ws";
        if_setonop($component0, "lobbyscreen_link($string0, $string1, true)");
    case 21 :
        if_setonclick($component0, "lobby_hop_abort");
        if_setonclick($component1, null);
        return;
    case default :
        if_setonop($component0, null);
}
if_setonop($component1, "lobby_popup_close");
