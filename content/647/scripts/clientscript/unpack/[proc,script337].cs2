// 337
[proc,script337](int $int0, int $int1)
if_settext("<tostring_localised($int0, true)><col=ffffff>(<tostring($int1)>+)</col>xp", toplevel:xpsplat_text);
if_settext("<tostring_localised($int0, true)><col=ffffff>(<tostring($int1)>+)</col>xp", toplevel_fullscreen:xpsplat_text);
if_setontimer("script3369(toplevel:xpbaselayer, clientclock)", toplevel:xpbaselayer);
if_setontimer("script3370(toplevel_fullscreen:xpbaselayer, clientclock)", toplevel_fullscreen:xpbaselayer);
