// 3471
[clientscript,script3471](component $component0, int $int1)
if ($int1 < calc(spline_length(0) - 1)) {
    cam_movealong(0, $int1, 700, 700, 1, $int1);
    if_setoncamfinished($component0, "script3471($component0, calc($int1 + 1))");
} else {
    if_setoncamfinished($component0, null);
    cam_smoothreset;
}
