[proc,clientscript_4079](int $int)
if (cc_find(dg3547867:com2, 0) = true) {
    if ($int <= 30) {
        cc_setsize(calc($int * 8), 8, ^setsize_abs, ^setsize_abs);
    }
} else {
    cc_create(dg3547867:com2, ^iftype_rectangle, 0);
    cc_setposition(44, 44, ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(calc(8 * 30), 8, ^setsize_abs, ^setsize_abs);
    cc_setcolour(0xc96c3e);
    cc_setfill(true);
}
