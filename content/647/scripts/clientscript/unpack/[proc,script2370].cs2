// 2370
[proc,script2370]
def_int $int0 = if_getscrollx(skillmulti2010:menu);
if ($int0 <= 0) {
    if_settrans(150, skillmulti2010:left);
    if_setgraphic("sm_select_body_button,0", skillmulti2010:left);
} else {
    if_settrans(0, skillmulti2010:left);
}
if ($int0 >= calc(if_getscrollwidth(skillmulti2010:menu) - if_getwidth(skillmulti2010:menu))) {
    if_settrans(150, skillmulti2010:right);
    if_setgraphic("sm_select_body_button,2", skillmulti2010:right);
} else {
    if_settrans(0, skillmulti2010:right);
}
%varclient_93 = $int0;
