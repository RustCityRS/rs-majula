// 2321
[clientscript,script2321](component $component0)
if (if_getx($component0) < calc(if_getwidth(easter09_nuts:content) - 1)) {
    if (if_getx($component0) = calc(140 + if_getwidth($component0))) {
        if_setontimer(easter09_nuts:control4, "script2323(easter09_nuts:model4)");
    }
    if_setposition($component0, calc(1 + if_getx($component0)), if_gety($component0), ^setpos_abs_left, ^setpos_abs_top);
} else {
    ~easter09_nuts_reset_model3;
}
