// 2321
[clientscript,script2321](component $component0)
if (if_getx($component0) < calc(if_getwidth(easter09_nuts:content) - 1)) {
    if (if_getx($component0) = calc(140 + if_getwidth($component0))) {
        if_setontimer("script2323(easter09_nuts:model4)", easter09_nuts:control4);
    }
    if_setposition(calc(1 + if_getx($component0)), if_gety($component0), ^setpos_abs_left, ^setpos_abs_top, $component0);
} else {
    ~script2322;
}
