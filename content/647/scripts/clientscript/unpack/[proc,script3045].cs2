// 3045
[proc,script3045]
switch_int (chat_getfilter_private) {
    case ^chatfilter_on :
        if_settext("Everybody", lobbyscreen_pane_friendslist:com_66);
    case ^chatfilter_friends :
        if_settext("Friends", lobbyscreen_pane_friendslist:com_66);
    case ^chatfilter_off :
        if_settext("Nobody", lobbyscreen_pane_friendslist:com_66);
}
