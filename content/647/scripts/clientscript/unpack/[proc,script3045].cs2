// 3045
[proc,script3045]
switch_int (chat_getfilter_private) {
    case ^chatfilter_on :
        if_settext(lobbyscreen_pane_friendslist:pm_button_text, "Everybody");
    case ^chatfilter_friends :
        if_settext(lobbyscreen_pane_friendslist:pm_button_text, "Friends");
    case ^chatfilter_off :
        if_settext(lobbyscreen_pane_friendslist:pm_button_text, "Nobody");
}
