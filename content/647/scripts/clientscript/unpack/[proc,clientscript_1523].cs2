[proc,clientscript_1523]
if (%varbit_4895 = 2) {
    cc_create(questjournal_scroll:com9, ^iftype_text, 0);
    cc_setposition(0, -2, ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(102, 23, ^setsize_abs, ^setsize_abs);
    cc_settextfont(quill_oblique_large);
    cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
    cc_settext("Back");
    cc_setcolour(0x46320a);
    cc_settextshadow(false);
    cc_setonmouseover("cc_text_colour_swapper(^event_com, ^event_subid, 16777215)");
    cc_setonmouseleave("cc_text_colour_swapper(^event_com, ^event_subid, 4600330)");
    if_setop(1, "Back to Index", questjournal_scroll:com9);
}
