[proc,clientscript_394](component $component)
if (%varc_int_1391 = false) {
    if_settrans(max(calc(if_gettrans($component) - 10), 0), $component);
    if (if_gettrans($component) = false) {
        %varc_int_1391 = 1;
    }
} else {
    if_settrans(min(calc(if_gettrans($component) + 10), 255), $component);
    if (if_gettrans($component) = 255) {
        %varc_int_1391 = 0;
    }
}
