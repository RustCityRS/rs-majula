// 209
[clientscript,script209]
if (%pvpwild_bh_potential < 8) {
    if_setgraphic(pvpwildy_overlay:target_icon, "bounty_hunter_timer_icon,0");
} else if (%pvpwild_bh_potential < 15) {
    if_setgraphic(pvpwildy_overlay:target_icon, "bounty_hunter_timer_icon,1");
} else if (%pvpwild_bh_potential < 23) {
    if_setgraphic(pvpwildy_overlay:target_icon, "bounty_hunter_timer_icon,2");
} else if (%pvpwild_bh_potential < 30) {
    if_setgraphic(pvpwildy_overlay:target_icon, "bounty_hunter_timer_icon,3");
} else if (%pvpwild_bh_potential < 38) {
    if_setgraphic(pvpwildy_overlay:target_icon, "bounty_hunter_timer_icon,4");
} else if (%pvpwild_bh_potential < 45) {
    if_setgraphic(pvpwildy_overlay:target_icon, "bounty_hunter_timer_icon,5");
} else if (%pvpwild_bh_potential < 53) {
    if_setgraphic(pvpwildy_overlay:target_icon, "bounty_hunter_timer_icon,6");
} else if (%pvpwild_bh_potential < 60) {
    if_setgraphic(pvpwildy_overlay:target_icon, "bounty_hunter_timer_icon,7");
} else {
    if_setgraphic(pvpwildy_overlay:target_icon, "bounty_hunter_timer_icon,8");
}
