// 2850
[clientscript,script2850]
%varclient_1069 = 500;
%varclient_1070 = movecoord(coord, 0, 0, -8);
%varclient_1071 = 0;
%varclient_1072 = coord;
%varclient_1073 = 450;
%varclient_1074 = 0;
%varclient_1282 = 25;
cam_moveto(%varclient_1070, %varclient_1069, 10, 3);
cam_lookat(~script2865(%varclient_1070, %varclient_1071), %varclient_1073, 10, 3);
%varclient_1075 = 0;
%varclient_1076 = 0;
if_setonkey("script2851(event_com, event_keycode, 0)", machinima_livecamera:blockclick);
if_sethide(false, machinima_livecamera:com_54);
if_sethide(false, machinima_livecamera:compasslayer);
if_sethide(false, machinima_livecamera:storemovie);
if_sethide(true, machinima_livecamera:com_33);
if_setgraphic("catcon_catapult_icons,8", machinima_livecamera:mode_icon);
if_settext("You are now in Aim Mode", machinima_livecamera:message_text);
if_setontimer("script2853(machinima_livecamera:blockclick, clientclock)", machinima_livecamera:blockclick);
if_setontimer("script2852(machinima_livecamera:compasslayer)", machinima_livecamera:compasslayer);
if_sethide(false, machinima_livecamera:exithint);
if_setontimer("script2870(event_com, calc(clientclock + 150))", machinima_livecamera:exithint);
~script3455;
