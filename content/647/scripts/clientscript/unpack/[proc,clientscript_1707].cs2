[proc,clientscript_1707](stat $stat)(component)
switch_stat ($stat) {
    case attack:
        return(prayer:com34);
    case strength:
        return(prayer:com33);
    case defence:
        return(prayer:com32);
    case ranged:
        return(prayer:com31);
    case magic:
        return(prayer:com30);
    case default:
        return(null);
}
