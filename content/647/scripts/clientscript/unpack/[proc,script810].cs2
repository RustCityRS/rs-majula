// 810
[proc,script810]
if (map_members = true & %show_summoning_orb = 1) {
    if_sethide(false, topstat_lore:topstat_background_lore);
    if_sethide(false, topstat_lore:topstat_circle_lore);
    if_sethide(false, topstat_lore:topstat_graphic_lore);
    if_sethide(false, topstat_lore:com_4);
    if_sethide(false, topstat_lore:select_leftclick_layer);
    ~script817(summoning);
    if_sethide(false, topstat_lore:com_5);
    if_setcolour(~script805(summoning), topstat_lore:com_5);
    if_settext(tostring(stat(summoning)), topstat_lore:com_5);
} else {
    if_sethide(true, topstat_lore:topstat_background_lore);
    if_sethide(true, topstat_lore:topstat_circle_lore);
    if_sethide(true, topstat_lore:com_5);
    if_sethide(true, topstat_lore:topstat_graphic_lore);
    if_sethide(true, topstat_lore:com_4);
    if_sethide(true, topstat_lore:select_leftclick_layer);
}
