[proc,clientscript_1366]
if (%varp_380 = 25) {
    if_settext("Time until next game starts: 0", castlewars_status_overlay:com0);
} else if (%varp_380 > 0) {
    if_settext("Time until next game starts: <tostring(%varp_380)>", castlewars_status_overlay:com0);
} else {
    if_settext("Waiting for players to join the other team.", castlewars_status_overlay:com0);
}
