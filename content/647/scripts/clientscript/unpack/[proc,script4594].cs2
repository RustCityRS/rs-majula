// 4594
[proc,script4594](obj $obj0, int $int1, int $int2, int $int3, component $component4)
cc_create($component4, ^iftype_graphic, if_getnextsubid($component4));
if ($int2 ! -1 & $int3 ! -1) {
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc($int2 + 2), calc($int3 + 2), ^setpos_abs_left, ^setpos_abs_top);
    if ($int1 <= 0) {
        cc_setobject_nonum($obj0, 1);
    } else {
        cc_setobject($obj0, $int1);
    }
    cc_setop(10, "Examine");
    cc_setgraphicshadow(0x302020);
    cc_setoutline(1);
    cc_setopbase("<col=ff9040><oc_name($obj0)></col>");
} else {
    cc_sethide(true);
}
