[proc,clientscript_1571](component $component0, component $component1, fontmetrics $fontmetrics2)
def_string $string = %varc_string_203;
def_int $int3 = if_getwidth($component0);
if (parawidth("<$string> ", $int3, $fontmetrics2) > $int3) {
    while (op4125("<$string>... ", $fontmetrics2) > $int3) {
        $string = substring($string, 0, calc(string_length($string) - 1));
    }
    $string = "<$string>...";
    if_setonmouserepeat("addtooltip(^event_com, $component1, %varc_string_203, 25, 5000)", $component0);
    if_setonmouseleave("deltooltip($component1)", $component0);
} else {
    if_setonmouserepeat(null, $component0);
    if_setonmouseleave(null, $component0);
}
if_settext($string, $component0);
