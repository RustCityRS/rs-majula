// 2106
[clientscript,script2106](component $component0, component $component1, int $int2, int $int3, int $int4, int $int5)
$int4 = max(min(calc($int4 + randominc(1) - randominc(1)), 5), -5);
$int5 = max(min(calc($int5 + randominc(1) - randominc(1)), 5), -5);
if_setposition($component1, calc($int2 + $int4), calc($int3 + $int5), ^setpos_abs_left, ^setpos_abs_top);
if_setontimer($component0, "script2106($component0, $component1, $int2, $int3, $int4, $int5)");
