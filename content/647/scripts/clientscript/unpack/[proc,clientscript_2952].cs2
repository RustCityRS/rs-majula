[proc,clientscript_2952](component $component0, component $component1, int $int2)
def_string $string0 = "";
def_string $string1 = "";
switch_int ($int2) {
    case 3:
        $string0 = "accountappeal";
        $string1 = "passwordchoice.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close()", $component1);
    case 4:
        $string0 = "ticketing";
        $string1 = "inbox.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close()", $component1);
    case 11:
        $string0 = "password_history";
        $string1 = "password.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close()", $component1);
    case 18:
        $string0 = "accountappeal";
        $string1 = "lockchoice.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close()", $component1);
    case 30:
        if (is_unsigned = true) {
            $string1 = "slu.ws";
            if_setonclick("loginscreen_link_nologin($string1, false)", $component0);
        } else {
            $string0 = "dob";
            $string1 = "set_members_dob.ws";
            if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        }
        if_setonclick("login_popup_close()", $component1);
    case 31:
        $string0 = "displaynames";
        $string1 = "name.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close()", $component1);
    case 32, 12, 19:
        $string0 = "dob";
        $string1 = "set_members_dob.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close()", $component1);
    case 21:
        if_setonclick("login_hop_abort()", $component0);
        if_setonclick(null, $component1);
    case default:
        if_setonclick(null, $component0);
        if_setonclick("login_popup_close()", $component1);
}
