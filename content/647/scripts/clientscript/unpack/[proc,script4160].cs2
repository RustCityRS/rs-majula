// 4160
[proc,script4160](component $component0, int $int1, int $int2)
if ($int2 > 0) {
    if_setontimer("script4159(event_com, $int1, calc($int2 - 1))", $component0);
    return;
}
def_int $int3 = 0;
def_int $int4 = 0;
if (cc_find($component0, 0) = true) {
    $int3 = cc_gettrans;
    if ($int1 = 0) {
        $int4 = calc($int3 - 22);
    } else {
        $int4 = calc($int3 + 22);
    }
    $int4 = max($int4, 0);
    $int4 = min($int4, 255);
}
if ($int4 = 0 & $int1 = 0 | $int4 = 255 & $int1 = 1) {
    if_setontimer(null, $component0);
} else {
    if_setontimer("script4159(event_com, $int1, 0)", $component0);
}
~script4161($component0, $int4);
