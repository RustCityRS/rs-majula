// 753
[clientscript,script753]
if (%varplayerbit_4286 ! 101) {
    if_settext("<tostring(%varplayerbit_4286)>%", lore_stats_side:hunger);
    if (%varplayerbit_4286 > 74) {
        if_setcolour(^red, lore_stats_side:hunger);
    } else {
        if_setcolour(^white, lore_stats_side:hunger);
    }
} else {
    if_settext("NA", lore_stats_side:hunger);
}
if (%varplayerbit_4285 ! 101) {
    if_settext("<tostring(%varplayerbit_4285)>%", lore_stats_side:size_percentage);
    if_settext("<tostring(%varplayerbit_4285)>%", lore_stats_side:size_percent);
} else {
    if_settext("NA", lore_stats_side:size_percentage);
    if_settext("NA", lore_stats_side:size_percent);
}
