[clientscript,script753]
if (%varplayerbit_4286 ! 101) {
    if_settext("<tostring(%varplayerbit_4286)>%", lore_stats_side:com_48);
    if (%varplayerbit_4286 > 74) {
        if_setcolour(^red, lore_stats_side:com_48);
    } else {
        if_setcolour(^white, lore_stats_side:com_48);
    }
} else {
    if_settext("NA", lore_stats_side:com_48);
}
if (%varplayerbit_4285 ! 101) {
