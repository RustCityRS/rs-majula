// 4454
[clientscript,script4454](component $component0, int $int1)
if (activeclanchannel_find_listened = true) {
    if_setontimer(null, clan_chat:guest_list_parent_layer);
    ~clan_chat_guest_list_build(%varclient_1506);
} else {
    if_setgraphic("aif_clanchat_icons,13", clan_chat:guest_joinleave_button_graphic);
    if (calc(clientclock - $int1) > 200) {
        ~clan_chat_guest_list_clear;
        if_setontimer("script4454($component0, clientclock)", clan_chat:guest_list_parent_layer);
    }
}
