// 1199
[clientscript,script1199]
switch_int (%rand_ready_state_player5) {
    case 0 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player5, 0xffb400);
    case 1 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player5, ^green);
    case 2 :
        if_setcolour(rand_dungeon_rewards_v2:readyborder_player5, ^red);
}
