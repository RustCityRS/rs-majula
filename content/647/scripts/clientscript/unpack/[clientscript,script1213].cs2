// 1213
[clientscript,script1213]
if (~current_side_if = 7) {
    if_settext("To cast Wind Strike, click on the flashing spell icon, then click on a chicken. You can hover over spell icons to read a brief description of the spell and the runes required to cast it.", advisor_tutorial_chat:com_7);
    if_settext("", advisor_tutorial_chat:com_6);
    if_setgraphic("magicon,0", advisor_tutorial_chat:com_4);
} else {
    if_settext("Click on the Magic icon to open your magic spellbook.", advisor_tutorial_chat:com_7);
    if_settext("", advisor_tutorial_chat:com_6);
    if_setgraphic("stonemenusideicons,7", advisor_tutorial_chat:com_4);
}
