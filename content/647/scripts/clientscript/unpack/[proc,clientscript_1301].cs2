[proc,clientscript_1301](component $component0, component $component1)
def_int $int2 = 0;
if (getwindowmode >= 2) {
    ~scrollbar_vertical($component0, $component1, "scrollbar_alpha,3", "scrollbar_alpha,0", "scrollbar_alpha,1", "scrollbar_alpha,2", 641, 642);
    while ($int2 < if_getchildcount($component0)) {
        if (cc_find($component0, $int2) = true) {
            cc_setalpha(1);
        }
        $int2 = calc($int2 + 1);
    }
} else {
    ~scrollbar_vertical($component0, $component1, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
    while ($int2 < if_getchildcount($component0)) {
        if (cc_find($component0, $int2) = true) {
            cc_setalpha(0);
        }
        $int2 = calc($int2 + 1);
    }
}
