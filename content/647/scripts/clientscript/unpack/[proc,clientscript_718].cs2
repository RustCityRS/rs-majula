[proc,clientscript_718](int $int)(colour)
switch_int ($int) {
    case default:
        return(^white);
    case 1:
        return(^red);
    case 2:
        return(0xff8000);
    case 3:
        return(^yellow);
    case 4:
        return(^green);
    case 5:
        return(^blue);
    case 6:
        return(0x4000ff);
    case 7:
        return(0x8000ff);
}
return(^black);
