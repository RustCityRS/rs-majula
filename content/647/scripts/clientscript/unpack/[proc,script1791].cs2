// 1791
[proc,script1791](component $component0)
def_int $int1 = calc(%clanwars_transmit_time / 60);
def_int $int2 = calc(%clanwars_transmit_time % 60);
if ($int2 >= 10) {
    if_settext($component0, "<tostring($int1)>h <tostring($int2)>m");
} else {
    if_settext($component0, "<tostring($int1)>h 0<tostring($int2)>m");
}
