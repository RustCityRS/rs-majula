[proc,clientscript_2178](int $int, string $string)
if (cc_find(questlist_v4:com18, $int) = true) {
    if (calc(clientclock % 20) > 9) {
        cc_settext("");
        if (calc(clientclock % 20) = 10) {
            sound_synth(synth_5009, 1, 0);
        }
    } else {
        cc_settext($string);
    }
}
