[proc,clientscript_2879](int $int0, int $int1, int $int2)(int)
def_string $string = "Remove from Playlist";
if (cc_find(music_v3:com9, $int0) = true & .cc_find(music_v3:com9, calc($int0 + 12)) = true) {
    if ($int1 = 32767) {
        cc_sethide(true);
        .cc_sethide(true);
        return($int2);
    }
    cc_setposition(15, $int2, ^setpos_abs_left, ^setpos_abs_top);
    cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
    if (%varbit_4388 = $int1 & %varbit_7078 = true) {
        cc_setcolour(0xffff66);
        cc_setonmouseleave("cc_text_colour_swapper(^event_com, ^event_subid, 16777062)");
    } else {
        cc_setcolour(^cyan);
        cc_setonmouseleave("cc_text_colour_swapper(^event_com, ^event_subid, 65535)");
    }
    cc_setonmouseover("cc_text_colour_swapper(^event_com, ^event_subid, 16777215)");
    cc_settext(enum_string(enum_1345, $int1));
    cc_setsize(150, 15, ^setsize_abs, ^setsize_abs);
    cc_setop(1, "Play");
    cc_setop(2, "Remove");
    cc_setopbase(enum_string(enum_1345, $int1));
    .cc_setopbase(enum_string(enum_1345, $int1));
    cc_settextshadow(false);
    cc_settextfont(p11_full);
    cc_setdraggable(music_v3:com9, -1);
    .cc_setdraggable(null, -1);
    cc_setdragbehaviour(2);
    .cc_setsize(12, 12, ^setsize_abs, ^setsize_abs);
    .cc_setposition(2, calc($int2 + 1), ^setpos_abs_left, ^setpos_abs_top);
    .cc_setop(2, "Remove");
    .cc_setgraphic("music_icons_new,1");
    .cc_setonop("clientscript_2885(^event_com, ^event_subid, 150, 0, 20, ^event_op)");
    .cc_setonmouserepeat("clientscript_1160(music_v3:com9, ^event_subid, music_v3:com16, $string, 25, 189)");
    .cc_setonmouseleave("deltooltip(music_v3:com16)");
    .cc_setonclick("deltooltip(music_v3:com16)");
