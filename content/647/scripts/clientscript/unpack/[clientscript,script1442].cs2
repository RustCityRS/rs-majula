// 1442
[clientscript,script1442]
switch_int (%journey_number) {
    case 0 :
        return;
    case 1 :
        if_sethide(ship_journey:sarim_entrana_layer, false);
        if_setmodelanim(ship_journey:sarim_to_entrana_ship, sarim_entrana);
    case 2 :
        if_sethide(ship_journey:entrana_sarim_layer, false);
        if_setmodelanim(ship_journey:entrana_to_sarim_ship, entrana_sarim);
    case 3 :
        if_sethide(ship_journey:sarim_crandor_layer, false);
        if_setmodelanim(ship_journey:sarim_to_crandor_ship, sarim_crandor);
    case 5 :
        if_sethide(ship_journey:sarim_karamja_layer, false);
        if_setmodelanim(ship_journey:sarim_to_karamja_ship, sarim_karamja);
    case 6 :
        if_sethide(ship_journey:karamja_sarim_layer, false);
        if_setmodelanim(ship_journey:karamja_to_sarim_ship, karamja_sarim);
    case 7 :
        if_sethide(ship_journey:ardougne_brimhaven_layer, false);
        if_setmodelanim(ship_journey:ardougne_to_brimhaven_ship, seq_636);
    case 8 :
        if_sethide(ship_journey:brimhaven_ardougne_layer, false);
        if_setmodelanim(ship_journey:brimhaven_to_ardougne_ship, seq_637);
    case 10 :
        if_sethide(ship_journey:cairn_khazzard_layer, false);
        if_setmodelanim(ship_journey:cairn_to_khazzard_ship, cairn_khazzard);
    case 11 :
        if_sethide(ship_journey:khazzard_trawler_layer, false);
        if_setmodelanim(ship_journey:khazzard_to_trawler_ship, khazzard_trawler);
    case 12 :
        if_sethide(ship_journey:trawler_khazzard_layer, false);
        if_setmodelanim(ship_journey:trawler_to_khazzard_ship, trawler_khazzard);
    case 13 :
        if_sethide(ship_journey:cairn_sarim_layer, false);
        if_setmodelanim(ship_journey:cairn_to_sarim_ship, cairn_sarim);
    case 14 :
        if_sethide(ship_journey:sarim_voidknight_layer, false);
        if_setmodelanim(ship_journey:sarim_to_voidknight_ship, sarim_voidknight);
    case 15 :
        if_sethide(ship_journey:karamja_voidknight_layer, false);
        if_setmodelanim(ship_journey:karamja_to_voidknight_ship, voidknight_sarim);
    case 16 :
        if_sethide(ship_journey:feldip_tai_layer, false);
        if_setmodelanim(ship_journey:feldip_to_tai_bwo_wannai_boat, ogre_boat_feldip_to_tai);
    case 17 :
        if_sethide(ship_journey:tai_feldip_layer, false);
        if_setmodelanim(ship_journey:tai_bwo_wannai_to_feldip_boat, ogre_boat_tai_to_feldip);
}
