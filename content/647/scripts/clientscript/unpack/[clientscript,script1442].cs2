// 1442
[clientscript,script1442]
switch_int (%journey_number) {
    case 0 :
        return;
    case 1 :
        if_sethide(false, ship_journey:sarim_entrana_layer);
        if_setmodelanim(sarim_entrana, ship_journey:sarim_to_entrana_ship);
    case 2 :
        if_sethide(false, ship_journey:entrana_sarim_layer);
        if_setmodelanim(entrana_sarim, ship_journey:entrana_to_sarim_ship);
    case 3 :
        if_sethide(false, ship_journey:sarim_crandor_layer);
        if_setmodelanim(sarim_crandor, ship_journey:sarim_to_crandor_ship);
    case 5 :
        if_sethide(false, ship_journey:sarim_karamja_layer);
        if_setmodelanim(sarim_karamja, ship_journey:sarim_to_karamja_ship);
    case 6 :
        if_sethide(false, ship_journey:karamja_sarim_layer);
        if_setmodelanim(karamja_sarim, ship_journey:karamja_to_sarim_ship);
    case 7 :
        if_sethide(false, ship_journey:ardougne_brimhaven_layer);
        if_setmodelanim(seq_636, ship_journey:ardougne_to_brimhaven_ship);
    case 8 :
        if_sethide(false, ship_journey:brimhaven_ardougne_layer);
        if_setmodelanim(seq_637, ship_journey:brimhaven_to_ardougne_ship);
    case 10 :
        if_sethide(false, ship_journey:cairn_khazzard_layer);
        if_setmodelanim(cairn_khazzard, ship_journey:cairn_to_khazzard_ship);
    case 11 :
        if_sethide(false, ship_journey:khazzard_trawler_layer);
        if_setmodelanim(khazzard_trawler, ship_journey:khazzard_to_trawler_ship);
    case 12 :
        if_sethide(false, ship_journey:trawler_khazzard_layer);
        if_setmodelanim(trawler_khazzard, ship_journey:trawler_to_khazzard_ship);
    case 13 :
        if_sethide(false, ship_journey:cairn_sarim_layer);
        if_setmodelanim(cairn_sarim, ship_journey:cairn_to_sarim_ship);
    case 14 :
        if_sethide(false, ship_journey:sarim_voidknight_layer);
        if_setmodelanim(seq_3545, ship_journey:sarim_to_voidknight_ship);
    case 15 :
        if_sethide(false, ship_journey:karamja_voidknight_layer);
        if_setmodelanim(seq_3546, ship_journey:karamja_to_voidknight_ship);
    case 16 :
        if_sethide(false, ship_journey:feldip_tai_layer);
        if_setmodelanim(seq_3476, ship_journey:feldip_to_tai_bwo_wannai_boat);
    case 17 :
        if_sethide(false, ship_journey:tai_feldip_layer);
        if_setmodelanim(seq_3477, ship_journey:tai_bwo_wannai_to_feldip_boat);
}
