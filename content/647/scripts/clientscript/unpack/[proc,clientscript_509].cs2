[proc,clientscript_509](component $component)
def_string $string = "";
if ($component = pog_coin_machine:com9) {
    $string = oc_name(%varp_1065);
    if (%varp_1065 = -1) {
        $string = "Empty";
    }
} else if ($component = pog_coin_machine:com10) {
    $string = oc_name(%varp_1066);
    if (%varp_1066 = -1) {
        $string = "Empty";
    }
} else if ($component = pog_coin_machine:com11) {
    $string = oc_name(%varp_1067);
    if (%varp_1067 = -1) {
        $string = "Empty";
    }
}
~addtooltip_action($component, pog_coin_machine:com24, $string, 25, 199);
