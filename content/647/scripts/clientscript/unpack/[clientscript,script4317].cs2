// 4317
[clientscript,script4317](component $component0, int $int1)
def_int $int2 = 0;
if (activeclanchannel_find_affined = true) {
    if ($int1 < 0 | $int1 >= activeclanchannel_getusercount) {
        %varclient_1518 = -1;
        %varclient_1645 = "";
        mes("That person isn't in your clan channel.");
        return;
    }
    if (cc_find($component0, $int1) = true) {
        $int2 = cc_gety;
    }
    %varclient_1518 = $int1;
    %varclient_1645 = activeclanchannel_getuserdisplayname($int1);
    if (if_find(clan_chat:com_20) = true) {
        cc_setsize(1, 19, ^setsize_abs, ^setsize_abs);
        cc_setposition(0, $int2, ^setpos_abs_right, ^setpos_abs_top);
        cc_setontimer("script4629(1)");
