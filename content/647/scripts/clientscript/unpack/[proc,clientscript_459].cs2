[proc,clientscript_459](component $component)
if (stat_base(attack) < 25) {
    if_settext("<col=c80000>An Attack level of <tostring(25)> is required.</col>", $component);
} else if (%varbit_2086 < 1) {
    if_settext("<col=c80000>1 Commendation required.</col>", $component);
} else {
    if_settext("<tostring(calc(pow(stat_base(attack), 2) / 600 * 35))> XP per Commendation.", $component);
}
