// 3949
[clientscript,script3949](component $component0, int $int1)
if ($int1 = 1) {
    if_setcolour($component0, 0xfafafa);
    if_settext($component0, append("<u=fafafa>", removetags(if_gettext($component0))));
} else {
    if_setcolour($component0, 0xebe0bc);
    if_settext($component0, append("<u=ebe0bc>", removetags(if_gettext($component0))));
}
