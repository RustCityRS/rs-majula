// 1575
[proc,script1575](component $component0, component $component1, string $string0)
def_string $string1 = $string0;
def_int $int2 = if_getwidth($component0);
if (parawidth($string1, ^max_32bit_int, q8_full) > $int2) {
    while (parawidth("<$string1>...", ^max_32bit_int, q8_full) > $int2) {
        $string1 = substring($string1, 0, calc(string_length($string1) - 1));
    }
    $string1 = "<$string1>...";
    if_setonmouserepeat($component0, "addtooltip(event_com, $component1, $string0, 25, 5000)");
    if_setonmouseleave($component0, "deltooltip($component1)");
} else {
    if_setonmouserepeat($component0, null);
    if_setonmouseleave($component0, null);
}
if_settext($component0, $string1);
