    $string0 = append($string0, " (<tostring(%varbit_4288)> Special Move points)");
    ~lore_updateicon_v2(lore_stats_side:com74, $graphic2, $graphic3, $int4, $obj5, $int6, $obj7, $int8, $obj9, $int10, $obj11, $int12);
