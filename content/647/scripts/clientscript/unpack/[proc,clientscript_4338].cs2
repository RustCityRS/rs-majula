[proc,clientscript_4338](int $int)(string)
def_string $string = "";
if ($int < 10) {
    $string = append_num("00:0", $int);
} else if ($int < 60) {
    $string = append_num("00:", $int);
} else if ($int < 959) {
    $string = "0<tostring(calc($int / 100))>:<tostring(calc($int % 100))>";
} else {
    $string = "<tostring(calc($int / 100))>:<tostring(calc($int % 100))>";
}
return($string);
return("");
