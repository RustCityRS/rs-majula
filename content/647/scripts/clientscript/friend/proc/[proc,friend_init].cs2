// 4552
[proc,friend_init]
if_settext(friends2:friends_title, "Friends List<br>RuneScape <tostring(map_world)>");
if_setonfriendtransmit(friends2:friend_name_layer, "friend_transmit");
if_setscrollsize(friends2:friend_scrolling_layer, 0, 0);
if_setscrollpos(friends2:friend_scrolling_layer, 0, 0);
~scrollbar_vertical(friends2:friend_scrollbar_layer, friends2:friend_scrolling_layer, "aif_scrollbar_dragger_2,3", "aif_scrollbar_dragger_2,0", "aif_scrollbar_dragger_2,1", "aif_scrollbar_dragger_2,2", "aif_scrollbar_arrow_2,1", "aif_scrollbar_arrow_2,0");
def_component $component0 = friends2:friend_rectangles;
cc_deleteall($component0);
def_int $int1 = 0;
def_int $int2 = 0;
while ($int2 < 200) {
    $int1 = calc($int2 * 15 + 5);
    if (calc($int2 % 2) ! 0) {
        cc_create($component0, ^iftype_rectangle, if_getnextsubid($component0));
        cc_setsize(16384, 15, ^setsize_rel, ^setsize_abs);
        cc_setposition(0, $int1, ^setpos_abs_left, ^setpos_abs_top);
        cc_setcolour(0x232220);
        cc_setfill(true);
        cc_settrans(128);
    }
    $int2 = calc($int2 + 1);
}
~friend_update(%friends_line_pos);
