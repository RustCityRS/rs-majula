[clientscript,conq_update_time_left]
if (%varc_int_1362 < 1) {
    return;
}
def_int $int0 = calc(%varc_int_1362 * 6 / 10);
def_int $int1 = 0;
def_int $int2 = 0;
def_string $string = "";
if ($int0 < 60) {
    $int1 = $int0;
} else {
    $int1 = calc($int0 % 60);
    $int2 = calc($int0 / 60);
}
if ($int1 < 10) {
    $string = append("0", tostring($int1));
    if ($int2 = false & %varc_int_1389 = false) {
        %varc_int_1389 = 1;
        if (%varbit_7511 = true) {
