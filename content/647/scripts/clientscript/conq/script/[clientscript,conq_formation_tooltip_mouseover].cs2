// 1417
[clientscript,conq_formation_tooltip_mouseover](component $component0)
if (%conq_loading = 1) {
    return;
}
def_int $int1 = ~script1502($component0);
def_npc $npc2 = null;
def_int $int3 = if_getx($component0);
def_int $int4 = if_gety($component0);
if (%conq_unit_1_pos = $int1) {
    $npc2 = ~script486(%conq_unit_1_type);
} else if (%conq_unit_2_pos = $int1) {
    $npc2 = ~script486(%conq_unit_2_type);
} else if (%conq_unit_3_pos = $int1) {
    $npc2 = ~script486(%conq_unit_3_type);
