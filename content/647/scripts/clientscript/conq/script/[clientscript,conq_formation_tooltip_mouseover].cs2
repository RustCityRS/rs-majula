    $npc2 = ~script486(%conq_unit_5_type);
} else if (%conq_unit_6_pos = $int1) {
    $npc2 = ~script486(%conq_unit_6_type);
} else if (%conq_unit_7_pos = $int1) {
    $npc2 = ~script486(%conq_unit_7_type);
} else if (%conq_unit_8_pos = $int1) {
    $npc2 = ~script486(%conq_unit_8_type);
} else if (%conq_unit_9_pos = $int1) {
    $npc2 = ~script486(%conq_unit_9_type);
} else if (%conq_unit_10_pos = $int1) {
    $npc2 = ~script486(%conq_unit_10_type);
