if ($npc2 ! null) {
    if_settext(conq_set_formation:tooltip_name, nc_param($npc2, param_1139));
    if_setsize(conq_set_formation:tooltip_content_layer, calc(stringwidth(nc_param($npc2, param_1139), welcome_font_tiny) + 10), if_getheight(conq_set_formation:tooltip_content_layer), ^setsize_abs, ^setsize_abs);
    $int3 = calc($int3 + if_getwidth($component0) - 3);
    $int4 = calc($int4 - if_getheight($component0));
    if (calc($int3 + if_getwidth(conq_set_formation:tooltip_content_layer)) >= calc(if_getx(conq_set_formation:grid_text_layer) + if_getwidth(conq_set_formation:grid_text_layer))) {
        $int3 = calc(if_getx($component0) - if_getwidth(conq_set_formation:tooltip_content_layer) + 3);
    }
    if_setposition(conq_set_formation:tooltip_content_layer, $int3, $int4, ^setpos_abs_left, ^setpos_abs_top);
    if_sethide(conq_set_formation:tooltip_content_layer, false);
} else {
