// 4380
[clientscript,clan_motto_text_click](component $component0, component $component1, int $int2)
%motto_input_varc = if_gettext($component0);
%motto_input_caret_varc = ~script1552($int2, %motto_input_varc, verdana_11pt_regular_multiline, $component0, -1);
if_setposition($component1, %motto_input_caret_varc, 5, ^setpos_abs_left, ^setpos_abs_top);
