// 4368
[clientscript,clan_qfc_text_init](component $component0, component $component1)
if_setonkey($component0, "clan_qfc_text_input($component0, event_keychar, event_keycode, $component1)");
if_setonclick($component0, "clan_qfc_text_click($component0, $component1, event_mousex)");
if_setontimer($component0, "caret_flash(clientclock, $component1)");
