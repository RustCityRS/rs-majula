// 4388
[clientscript,clan_motif_set](component $component0, component $component1)
def_graphic $graphic2 = null;
def_graphic $graphic3 = null;
if (activeclansettings_find_affined = true) {
    $graphic2, $graphic3 = ~script4384(%varplayerbit_9086, %varplayerbit_9087, 0);
    if_setgraphic($graphic2, $component0);
    if_setgraphic($graphic3, $component1);
    if_setcolour(hsvtorgb(%varplayer_2094), $component0);
    if_setcolour(hsvtorgb(%varplayer_2095), $component1);
}
