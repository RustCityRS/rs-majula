// 4322
[clientscript,clan_setup_flags](component $component0, component $component1, component $component2, component $component3)
cc_deleteall($component2);
cc_deleteall($component3);
def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = 8;
def_int $int7 = 8;
def_int $int8 = 50;
def_int $int9 = 36;
def_int $int10 = 0;
def_int $int11 = 0;
def_int $int12 = calc((if_getwidth($component0) - $int6 * 2) / ($int6 + $int8));
def_int $int13 = enum_getoutputcount(enum_3722);
def_int $int14 = enum_getoutputcount(enum_3721);
def_int $int15 = min($int13, $int14);
while ($int4 < $int15) {
    $int10 = calc($int6 + ($int8 + $int6) * ($int4 - $int5 * $int12));
    $int11 = calc($int7 + $int5 * ($int9 + $int7));
    cc_create($component2, ^iftype_graphic, $int4);
    cc_setsize($int8, $int9, ^setsize_abs, ^setsize_abs);
    cc_setposition($int10, $int11, ^setpos_abs_left, ^setpos_abs_top);
    cc_setgraphic("aif_smalltabs_whole,0");
    cc_setonvartransmit("clan_flag_highlight_update($int15){clan_flag_varp}");
    cc_setonmouseover("clan_flag_background_mouseover($int4, $component2)");
    cc_setonmouseleave("clan_flag_background_mouseleave($int4, $component2)");
    cc_create($component3, ^iftype_graphic, $int4);
    cc_setsize(calc($int8 - 8), calc($int9 - 8), ^setsize_abs, ^setsize_abs);
    cc_setposition(calc($int10 + 4), calc($int11 + 4), ^setpos_abs_left, ^setpos_abs_top);
    cc_setgraphic(enum(int, graphic, enum_3721, $int4));
    cc_setop(1, "Select");
    cc_setonop("clan_flag_highlight($int4, $component2, $int15)");
    cc_setonmouserepeat("addtooltip_dynamic($component3, $int4, clan_flag_selection:tooltip, enum(int, string, enum_3722, $int4), 20, 350)");
    cc_setonmouseleave("deltooltip(clan_flag_selection:tooltip)");
    $int4 = calc($int4 + 1);
    if (calc($int4 % $int12) = 0) {
        $int5 = calc($int5 + 1);
    }
}
if_setscrollpos($component0, 0, 0);
if_setscrollsize($component0, 0, calc($int5 * ($int7 + $int9)));
~scrollbar_vertical($component1, $component0, "aif_scrollbar_dragger_2,3", "aif_scrollbar_dragger_2,0", "aif_scrollbar_dragger_2,1", "aif_scrollbar_dragger_2,2", "aif_scrollbar_arrow_2,1", "aif_scrollbar_arrow_2,0");
