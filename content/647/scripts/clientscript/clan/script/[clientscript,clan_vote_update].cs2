// 4377
[clientscript,clan_vote_update]
if (%varplayer_2134 = %varclient_1499) {
    if_settext("You have voted.", clan_voting:com_82);
} else {
    if_settext("You have not yet voted.<br>How would you like to vote?", clan_voting:com_82);
}
if (%varplayerbit_9151 = 0) {
    if_settext("Results of last vote:", clan_voting:com_12);
} else if (%varplayerbit_9154 = 1 | %varplayerbit_9154 = 0) {
    if_settext("Vote open for less than a minute.", clan_voting:com_12);
} else {
    if_settext("Vote open for less than <tostring(%varplayerbit_9154)> minutes.", clan_voting:com_12);
}
def_int $int0 = calc(%varplayerbit_9149 + %varplayerbit_9150);
def_int $int1 = 0;
def_int $int2 = 0;
if ($int0 > 0) {
    if ($int0 = %varplayerbit_9149) {
        $int1 = 100;
    } else if ($int0 = %varplayerbit_9150) {
        $int2 = 100;
    } else {
        $int1 = calc(100 * %varplayerbit_9149 / $int0);
        if (%varplayerbit_9150 = 0) {
            $int2 = 0;
        } else {
            $int2 = calc(100 - $int1);
        }
    }
}
if_settext(tostring(%varplayerbit_9149), clan_voting:com_7);
if_settext(tostring(%varplayerbit_9150), clan_voting:com_8);
~aif_progressbar_set($int1, clan_voting:com_59, clan_voting:com_64);
~aif_progressbar_set($int2, clan_voting:com_69, clan_voting:com_74);
