// 4589
[proc,clan_reset_clanlist]
cc_deleteall(clan_chat:clanlist);
cc_deleteall(clan_chat:clan_rectangles);
cc_deleteall(clan_chat:clan_list_rank_layer);
cc_deleteall(clan_chat:clan_list_world_layer);
cc_deleteall(clan_chat:clan_list_world_icon_layer);
cc_deleteall(clan_chat:clan_list_button_layer);
if_sethide(true, clan_chat:drag_layer);
if_sethide(false, clan_chat:clan_info_layer);
if_settext("You are not currently in a Clan Chat channel.", clan_chat:clan_info_txt);
if_sethide(true, clan_chat:clanlistscrollbar);
if_sethide(false, clan_chat:kick_button_layer);
~script4469;
if_setgraphic("aif_clanchat_icons,13", clan_chat:clan_join_affinedchat_button_gfx);
if_sethide(true, clan_chat:selected_highlight_layer);
if_setsize(1, 19, ^setsize_abs, ^setsize_abs, clan_chat:clan_list_button_popout_layer);
%varclient_1518 = -1;
%varclient_1645 = "";
if_settext("", clan_chat:clan_name);
def_string $string0 = "Join your clan chat channel.";
if_setonmouserepeat("aif_tooltip(clan_chat:tooltip, event_com, -1, $string0, 120, verdana_11pt_regular, verdana_11pt_regular, ^white, 13, 4, 0, event_mousex, event_mousey)", clan_chat:clan_join_affinedchat_button);
if_setop(1, "Join Clan Chat channel", clan_chat:clan_join_affinedchat_button);
