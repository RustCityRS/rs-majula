// 4400
[proc,clan_switch_tab](component $component0)
if_sethide(true, clan_motif_chooser:top_icon_layer);
if_sethide(true, clan_motif_chooser:scroll_bar1);
if_sethide(true, clan_motif_chooser:bottom_icon_layer);
if_sethide(true, clan_motif_chooser:scroll_bar2);
if_sethide(true, clan_motif_chooser:colour_layer);
if_sethide(true, clan_motif_chooser:com_167);
if_sethide(true, clan_motif_chooser:com_179);
if_sethide(true, clan_motif_chooser:com_191);
switch_component ($component0) {
    case clan_motif_chooser:com_170 :
        if_sethide(false, clan_motif_chooser:top_icon_layer);
        if_sethide(false, clan_motif_chooser:scroll_bar1);
        if_sethide(false, clan_motif_chooser:com_167);
    case clan_motif_chooser:com_182 :
        if_sethide(false, clan_motif_chooser:bottom_icon_layer);
        if_sethide(false, clan_motif_chooser:scroll_bar2);
        if_sethide(false, clan_motif_chooser:com_179);
    case clan_motif_chooser:colour_tab :
        if_sethide(false, clan_motif_chooser:colour_layer);
        if_sethide(false, clan_motif_chooser:com_191);
}
