// 4445
[proc,clan_chat_guest_list_clear]
cc_deleteall(clan_chat:guestclanlist);
cc_deleteall(clan_chat:guest_list_rank_layer);
cc_deleteall(clan_chat:guest_list_world_layer);
cc_deleteall(clan_chat:guest_list_world_icon_layer);
cc_deleteall(clan_chat:guest_rectangles);
if_setop(1, "Join chat", clan_chat:guest_joinleave_button_active_layer);
if_setgraphic("aif_clanchat_icons,13", clan_chat:guest_joinleave_button_graphic);
if_sethide(true, clan_chat:guest_drag);
if_sethide(false, clan_chat:guest_info_layer);
if_settext("", clan_chat:guest_clan_name);
def_string $string0 = "Join another<br>clan's clanchat.";
if_setonmouserepeat("aif_tooltip(clan_chat:tooltip, event_com, -1, $string0, 120, verdana_11pt_regular, verdana_11pt_regular, ^white, 13, 4, 0, event_mousex, event_mousey)", clan_chat:guest_joinleave_button_active_layer);
if_setop(1, "Join Clan Chat channel", clan_chat:guest_joinleave_button_active_layer);
