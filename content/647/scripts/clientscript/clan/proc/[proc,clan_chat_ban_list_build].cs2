// 4462
[proc,clan_chat_ban_list_build]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 19;
def_string $string0 = "";
def_component $component3 = clan_chat:ignorelist;
def_component $component4 = clan_chat:ignore_list_scrolling_layer;
def_component $component5 = clan_chat:ignorelistscrollbar;
def_component $component6 = clan_chat:banned_rectangles;
def_int $int7 = calc(if_getheight($component4) / 19);
def_int $int8 = 0;
cc_deleteall($component3);
cc_deleteall($component6);
if (activeclansettings_find_affined = true) {
    if_settext("", clan_chat:ignore_info_txt);
    if_sethide(true, clan_chat:ignore_info_layer);
    $int1 = activeclansettings_getbannedcount;
    while ($int0 < $int1) {
        $int8 = calc($int0 * 19);
        $string0 = activeclansettings_getbanneddisplayname($int0);
        cc_create($component3, ^iftype_text, if_getnextsubid($component3));
        cc_settext($string0);
        cc_setposition(0, calc($int0 * $int2), ^setpos_abs_left, ^setpos_abs_top);
        cc_setsize(16384, $int2, ^setsize_rel, ^setsize_abs);
        cc_setcolour(0xa4997d);
        cc_settextfont(verdana_11pt_regular);
        cc_settextshadow(true);
        cc_setopbase("<col=ffffff><$string0>");
        cc_setop(1, "Remove ban");
        cc_setonop("script4580");
        cc_settextalign(^settextalign_left, ^settextalign_top, 0);
        if (calc($int0 % 2) ! 0) {
            cc_create($component6, ^iftype_rectangle, if_getnextsubid($component6));
            cc_setsize(16384, $int2, ^setsize_rel, ^setsize_abs);
            cc_setposition(0, calc($int0 * $int2), ^setpos_abs_left, ^setpos_abs_top);
            cc_setcolour(0x232220);
            cc_setfill(true);
            cc_settrans(128);
        }
        $int0 = calc($int0 + 1);
    }
    while ($int0 < $int7) {
        $int8 = calc($int0 * $int2);
        if (calc($int0 % 2) ! 0) {
            cc_create($component6, ^iftype_rectangle, if_getnextsubid($component6));
            cc_setsize(16384, $int2, ^setsize_rel, ^setsize_abs);
            cc_setposition(0, $int8, ^setpos_abs_left, ^setpos_abs_top);
            cc_setcolour(0x232220);
            cc_setfill(true);
            cc_settrans(128);
        }
        $int0 = calc($int0 + 1);
    }
} else {
    if_sethide(false, clan_chat:ignore_info_layer);
    if_settext("You must be part of a clan to<br>view the ban list.", clan_chat:ignore_info_txt);
    cc_deleteall($component3);
    cc_deleteall($component6);
}
if_sethide(false, $component5);
def_int $int9 = if_getscrolly(clan_chat:ignore_list_scrolling_layer);
if_setscrollsize(if_getwidth(clan_chat:ignore_list_scrolling_layer), calc($int2 * max($int1, $int7)), clan_chat:ignore_list_scrolling_layer);
$int9 = min($int9, if_getscrollheight(clan_chat:ignore_list_scrolling_layer));
if_setscrollpos(0, $int9, clan_chat:ignore_list_scrolling_layer);
~scrollbar_vertical(clan_chat:ignorelistscrollbar, clan_chat:ignore_list_scrolling_layer, "aif_scrollbar_dragger_2,3", "aif_scrollbar_dragger_2,0", "aif_scrollbar_dragger_2,1", "aif_scrollbar_dragger_2,2", "aif_scrollbar_arrow_2,1", "aif_scrollbar_arrow_2,0");
