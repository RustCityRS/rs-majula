if_sethide(false, chatbox_background:com55);
if (getwindowmode >= 2) {
    if_sethide(true, chatbox:com2);
    if_setgraphic(1247, chatbox:com1);
    if_setalpha(1, chatbox:com1);
    if_sethide(false, chatbox:com1);
    if_sethide(true, chatbox_background:com51);
    if_sethide(false, chatbox_background:com52);
