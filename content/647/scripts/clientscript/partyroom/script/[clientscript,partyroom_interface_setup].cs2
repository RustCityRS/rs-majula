~scrollbar_vertical(partydrop_main_rwt:scrollbar_right, partydrop_main_rwt:drop_inv_layer, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
