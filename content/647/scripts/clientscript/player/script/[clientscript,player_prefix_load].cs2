[clientscript,player_prefix_load]
def_int $int = 1;
cc_create(player_prefix:com9, ^iftype_text, 0);
cc_setcolour(0x11ff00);
cc_settext("No Prefix");
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(165, 17, ^setsize_abs, ^setsize_abs);
cc_settextshadow(false);
cc_settextfont(p12_full);
cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
cc_setop(1, "Select");
cc_setonclick("player_prefix_highlight(^event_subid)");
while ($int <= enum_getoutputcount(enum_1093)) {
    cc_create(player_prefix:com9, ^iftype_text, $int);
    cc_settext(enum(105, 115, enum_1093, $int));
    cc_setposition(0, calc(2 + 17 * $int), ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(165, 17, ^setsize_abs, ^setsize_abs);
    cc_settextshadow(false);
    cc_settextfont(p12_full);
    cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
    cc_setop(1, "Select");
    cc_setonclick("player_prefix_highlight(^event_subid)");
    if (~player_prefix_check($int) = true) {
        cc_setcolour(0x11ff00);
    } else {
        cc_setcolour(0xff1100);
    }
    $int = calc(1 + $int);
}
