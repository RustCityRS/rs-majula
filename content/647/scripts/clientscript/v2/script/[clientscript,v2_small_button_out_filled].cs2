[clientscript,v2_small_button_out_filled](component $component0)
cc_deleteall($component0);
def_int $int1 = if_getwidth($component0);
def_int $int2 = if_getheight($component0);
def_int $int3 = calc($int1 - 9);
def_int $int4 = calc($int2 - 9);
def_int $int5 = calc($int1 - 18);
def_int $int6 = calc($int2 - 18);
~create_graphic($component0, 0, tradebacking_light, 0, 0, $int1, $int2);
~create_graphic($component0, 1, 1275, 0, 0, 9, 9);
~create_graphic($component0, 2, 1276, $int3, 0, 9, 9);
~create_graphic($component0, 3, 1277, 0, $int4, 9, 9);
~create_graphic($component0, 4, 1278, $int3, $int4, 9, 9);
~create_graphic($component0, 5, 1279, 0, 9, 9, $int6);
~create_graphic($component0, 6, 1280, 9, 0, $int5, 9);
~create_graphic($component0, 7, 1281, $int3, 9, 9, $int6);
~create_graphic($component0, 8, 1282, 9, $int4, $int5, 9);
