// 958
[clientscript,fairyrings_log_shuffle](component $component0, component $component1, component $component2)
if (%fairyrings_log_order = 0) {
    ~fairyrings_log_sort($component0, $component1, 1);
    if_setgraphic($component2, "grand_exchange_misc_graphics,7");
} else {
    ~fairyrings_log_sort($component0, $component1, 0);
    if_setgraphic($component2, "grand_exchange_misc_graphics,6");
}
