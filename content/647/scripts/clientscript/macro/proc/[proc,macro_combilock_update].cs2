// 2112
[proc,macro_combilock_update](component $component0, component $component1, component $component2, component $component3, int $int4, int $int5)
if_setmodelangle($component0, 0, 0, if_getmodelangle_x($component0), if_getmodelangle_y($component0), if_getmodelangle_z($component0), calc(395 + $int5 + $int5));
if_setmodelangle($component1, 0, 0, if_getmodelangle_x($component1), if_getmodelangle_y($component1), if_getmodelangle_z($component1), calc(395 + $int5 + $int5));
if_setmodelangle($component2, 0, 0, if_getmodelangle_x($component2), if_getmodelangle_y($component2), if_getmodelangle_z($component2), calc(395 + $int5 + $int5));
if_setmodelangle($component3, 0, 0, if_getmodelangle_x($component3), if_getmodelangle_y($component3), if_getmodelangle_z($component3), calc(395 + $int5 + $int5));
switch_int ($int4) {
    case 0 :
        if_setposition($component0, 0, 43, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component1, 0, 126, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component2, 0, 210, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component3, 0, -70, ^setpos_abs_centre, ^setpos_abs_top);
    case 1 :
        if_setposition($component1, 0, 43, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component2, 0, 126, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component3, 0, 210, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component0, 0, -70, ^setpos_abs_centre, ^setpos_abs_top);
    case 2 :
        if_setposition($component2, 0, 43, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component3, 0, 126, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component0, 0, 210, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component1, 0, -70, ^setpos_abs_centre, ^setpos_abs_top);
    case default :
        if_setposition($component3, 0, 43, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component0, 0, 126, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component1, 0, 210, ^setpos_abs_centre, ^setpos_abs_top);
        if_setposition($component2, 0, -70, ^setpos_abs_centre, ^setpos_abs_top);
}
