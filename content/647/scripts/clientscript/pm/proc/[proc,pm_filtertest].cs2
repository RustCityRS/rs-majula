[proc,pm_filtertest](int $int)(int)
switch_int (chat_gethistory_length($int)) {
    case 7:
        return(1);
    case 3, 18:
        if (chat_getfilter_private = false) {
            return(1);
        }
        if (chat_getfilter_private = true & friend_test(chat_gethistory_message($int)) = true) {
            return(1);
        }
        return(0);
    case 5, 6, 19:
        if (chat_getfilter_private < 2) {
            return(1);
        }
        return(0);
}
return(0);
return(-1);
