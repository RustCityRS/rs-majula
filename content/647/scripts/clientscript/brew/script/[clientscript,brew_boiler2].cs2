[clientscript,brew_boiler2](component $component0, component $component1)
if (%varc_int_229 > 2) {
    if_setmodel(model_15680, $component0);
    if_setcolour(0x33ff00, $component1);
} else {
    if_setmodel(model_15679, $component0);
    if_setcolour(0x910000, $component1);
}
if_settext(tostring(%varc_int_229), $component1);
