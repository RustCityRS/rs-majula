// 2439
[clientscript,trawler_net_status]
if (%varclient_818 = 1) {
    if_settext("Net: Ripped!", trawler_game_overlay:com_16);
    if_setcolour(0xe12323, trawler_game_overlay:com_16);
} else {
    if_settext("Net: OK", trawler_game_overlay:com_16);
    if_setcolour(0xff9900, trawler_game_overlay:com_16);
}
