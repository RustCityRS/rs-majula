// 1131
[proc,combat_side_comlevel](component $component0)
if (%varclient_1000 > comlevel_active) {
    if_settext("Combat Lvl: <tostring(comlevel_active)>+<tostring(calc(%varclient_1000 - comlevel_active))>", $component0);
} else {
    if_settext("Combat Lvl: <tostring(comlevel_active)>", $component0);
}
