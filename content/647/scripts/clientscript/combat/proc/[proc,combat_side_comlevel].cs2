// 1131
[proc,combat_side_comlevel](component $component0)
if (%comlevel_potential_varc > comlevel_active) {
    if_settext($component0, "Combat Lvl: <tostring(comlevel_active)>+<tostring(calc(%comlevel_potential_varc - comlevel_active))>");
} else {
    if_settext($component0, "Combat Lvl: <tostring(comlevel_active)>");
}
