[clientscript,lobby_friends_friendop](int $int0, int $int1, int $int2, string $string)
switch_int ($int0) {
    case 1:
        if (is_subscriber = false) {
            ~lobbyscreen_input("Send message to <$string>", "", 0, $string, "");
        } else {
            mes("Users restricted to quick-chat cannot send messages from the Lobby.");
        }
    case 2:
        ~lobby_friends_join($int1);
    case 3, 4:
        mes("That player is currently offline.");
    case 10:
        friend_del(removetags($string));
}
