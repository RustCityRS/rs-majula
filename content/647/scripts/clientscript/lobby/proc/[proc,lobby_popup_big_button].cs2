// 3099
[proc,lobby_popup_big_button](string $string0, string $string1, component $component0, component $component1, component $component2, component $component3)
def_graphic $graphic4 = "set_but_end_1,0";
def_graphic $graphic5 = "set_but_end_1,0";
def_graphic $graphic6 = "set_but_fill_1,0";
if_setonmouseleave("lobbyscreen_button_highlight($component1, $graphic4, $component2, $graphic6, $component3, $graphic5)", $component0);
if_setgraphic($graphic4, $component1);
if_setgraphic($graphic6, $component2);
if_setgraphic($graphic5, $component3);
$graphic4 = "set_but_end_1,1";
$graphic6 = "set_but_fill_1,1";
$graphic5 = "set_but_end_1,1";
if_setonmouseover("lobbyscreen_button_highlight($component1, $graphic4, $component2, $graphic6, $component3, $graphic5)", $component0);
if_settext($string0, lobbyscreen:popup_big_button_text);
if_setop(1, $string1, lobbyscreen:popup_big_button);
