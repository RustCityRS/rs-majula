[proc,lobby_popup_small_button](string $string0, string $string1, component $component0, component $component1, component $component2, component $component3, int $int4)
def_graphic $graphic5 = "set_but_end_1,0";
def_graphic $graphic6 = "set_but_end_1,0";
def_graphic $graphic7 = "set_but_fill_1,0";
if_setonmouseleave($component0, "lobbyscreen_button_highlight($component1, $graphic5, $component2, $graphic7, $component3, $graphic6)");
if_setgraphic($component1, $graphic5);
if_setgraphic($component2, $graphic7);
if_setgraphic($component3, $graphic6);
$graphic5 = "set_but_end_1,1";
$graphic6 = "set_but_end_1,1";
$graphic7 = "set_but_fill_1,1";
if_setonmouseover($component0, "lobbyscreen_button_highlight($component1, $graphic5, $component2, $graphic7, $component3, $graphic6)");
if_settext(lobbyscreen:popup_small_button_text, $string0);
if_setop(lobbyscreen:popup_small_button, 1, $string1);
