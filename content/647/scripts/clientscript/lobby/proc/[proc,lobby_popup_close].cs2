// 3097
[proc,lobby_popup_close]
if_clearops(lobbyscreen:popup_small_button);
if_clearops(lobbyscreen:popup_big_button);
if_setonop(null, lobbyscreen:popup_small_button);
if_setonop(null, lobbyscreen:popup_big_button);
if_setonmouseover(null, lobbyscreen:popup_big_button);
if_setonmouseleave(null, lobbyscreen:popup_big_button);
if_setonmouseover(null, lobbyscreen:popup_small_button);
if_setonmouseleave(null, lobbyscreen:popup_small_button);
if_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_bottom, lobbyscreen:popup_small_button);
if_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_bottom, lobbyscreen:popup_big_button);
if_settext("", lobbyscreen:popup_small_button_text);
if_settext("", lobbyscreen:popup_big_button_text);
if_sethide(true, lobbyscreen:popup_small_button);
if_sethide(true, lobbyscreen:popup_big_button);
if_settext("", lobbyscreen:popup_text);
%varclient_1092 = 0;
if_setgraphic(null, lobbyscreen:popup_throbber);
if_setontimer(null, lobbyscreen:popup_throbber);
if_setonkey(null, lobbyscreen:popup);
if_sethide(true, lobbyscreen:popup);
if_sethide(true, lobbyscreen:popup_body);
