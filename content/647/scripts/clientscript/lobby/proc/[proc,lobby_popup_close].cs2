// 3097
[proc,lobby_popup_close]
if_clearops(lobbyscreen:com_225);
if_clearops(lobbyscreen:com_231);
if_setonop(null, lobbyscreen:com_225);
if_setonop(null, lobbyscreen:com_231);
if_setonmouseover(null, lobbyscreen:com_231);
if_setonmouseleave(null, lobbyscreen:com_231);
if_setonmouseover(null, lobbyscreen:com_225);
if_setonmouseleave(null, lobbyscreen:com_225);
if_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_bottom, lobbyscreen:com_225);
if_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_bottom, lobbyscreen:com_231);
if_settext("", lobbyscreen:com_230);
if_settext("", lobbyscreen:com_236);
if_sethide(true, lobbyscreen:com_225);
if_sethide(true, lobbyscreen:com_231);
if_settext("", lobbyscreen:com_224);
%varclient_1092 = 0;
if_setgraphic(null, lobbyscreen:com_223);
if_setontimer(null, lobbyscreen:com_223);
if_setonkey(null, lobbyscreen:com_33);
if_sethide(true, lobbyscreen:com_33);
if_sethide(true, lobbyscreen:com_19);
