[proc,if_getx_absolute](component $component0)(int)
def_int $int1 = if_getx($component0);
def_component $component2 = if_getlayer($component0);
while ($component2 ! null) {
    $int1 = calc($int1 + if_getx($component2) - if_getscrollx($component2));
    $component2 = if_getlayer($component2);
}
return($int1);
return(0);
