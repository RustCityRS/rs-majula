// 7
[clientscript,if_switchside_previous]
def_int $int0 = calc(%last_switchsided_stone - 100);
%last_switchsided_stone = 0;
if ($int0 < -1 | $int0 = ~current_side_if) {
    return;
}
def_component $component1 = ~getsidelayer($int0);
if ($component1 = null) {
    return;
}
if (if_hassub($component1) = false) {
    return;
}
~if_switchside($int0);
