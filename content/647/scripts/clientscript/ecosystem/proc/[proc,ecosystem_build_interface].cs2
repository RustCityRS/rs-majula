// 2971
[proc,ecosystem_build_interface](int $int0, int $int1)
def_string $string0 = "";
def_string $string1 = "";
def_string $string2 = "";
def_model $model2 = null;
def_component $component3 = null;
switch_int ($int0) {
    case default :
        $string0 = "Unknown";
        $string1 = "This should not get here.";
        $string2 = "This should never get here.";
        $model2 = model_62129;
        $component3 = crosstiled:build_none;
    case 0 :
        $string0 = "Nothing.";
        $string1 = "There are no requirements for building this feature.";
        $string2 = "This feature is an abscence of anything. Oddly, some creatures prefer the minimalist approach.";
        $model2 = model_62129;
        $component3 = crosstiled:build_none;
    case 1 :
        $string0 = "Pond";
        $string1 = "You need a Construction level of 65 to build a pond.";
        $string2 = "Ponds attract creatures with an affinity for water. They are essentially very small, man-made lakes...or glorified puddles, depending on your view.";
        $component3 = crosstiled:build_pond;
        $model2 = model_62128;
    case 2 :
        $string0 = "Tall grass";
        $string1 = "You need a Construction level of 62 to build tall grass.";
        $string2 = "Tall grass is favoured by creatures who sneak and hide. It's also a favourite with people too lazy to trim their lawn. Essentially, it's a patch of land allowed to grow wild.";
        $component3 = crosstiled:build_grass;
        $model2 = model_62134;
    case 3 :
        $string0 = "Abandoned house";
        $string1 = "You need a Construction level of 57 to build an abandoned house.";
        $string2 = "Something approximating an abandoned house: popular amongst creatures that think they're domesticated.";
        $component3 = crosstiled:build_house;
        $model2 = model_62132;
    case 4 :
        $string0 = "Thermal vent";
        $string1 = "You need a Construction level of 59 to build a thermal vent.";
        $string2 = "A home-made volcano, or, at least, something that looks like one. These are popular among earthy creatures.";
        $component3 = crosstiled:build_vent;
        $model2 = model_62133;
    case 5 :
        $string0 = "Standing stones";
        $string1 = "You need a Construction level of 70 to build standing stones.";
        $string2 = "A circle of home-made mystical stones, popular among creatures that are more magically inclined.";
        $component3 = crosstiled:build_stones;
        $model2 = model_62136;
    case 6 :
        $string0 = "Dark pit";
        $string1 = "You need a Construction level of 80 to build a dark pit.";
        $string2 = "A deep, dark, endless pit, popular among the more sinister creatures. Don't look too closely: you might fall in.";
        $component3 = crosstiled:build_pit;
        $model2 = model_62131;
    case 7 :
        $string0 = "Boneyard";
        $string1 = "You need a Construction level of 56 to build a boneyard.";
        $string2 = "An animal graveyard, or a collection of well-made bone mockeries. Popular among scavengers and sinister creatures.";
        $component3 = crosstiled:build_boneyard;
        $model2 = model_62135;
}
~script2973;
if (stat(construction) < $int1) {
    if_setcolour(0xcccc00, crosstiled:feature_name);
    $string2 = append($string2, "<br><br>You can pay Papa Mambo to build this for you.");
} else {
    if_setcolour(0x00cc00, crosstiled:feature_name);
}
if_settext($string0, crosstiled:feature_name);
if_settext($string1, crosstiled:build_requirements);
if_settext($string2, crosstiled:description_text);
if_setmodel($model2, crosstiled:feature_model);
if_sethide(true, crosstiled:build_none);
if_sethide(true, crosstiled:build_pond);
if_sethide(true, crosstiled:build_grass);
if_sethide(true, crosstiled:build_house);
if_sethide(true, crosstiled:build_vent);
if_sethide(true, crosstiled:build_stones);
if_sethide(true, crosstiled:build_pit);
if_sethide(true, crosstiled:build_boneyard);
if ($component3 ! null) {
    if_sethide(false, $component3);
} else {
    if_sethide(false, crosstiled:build_none);
}
