// 2046
[proc,worldmap_overlay_clear](component $component0)
if_setontimer("worldmap_overlay($component0, worldmap:worldmap, 0, 0, 0)", $component0);
cc_deleteall($component0);
cc_deleteall(worldmap:you_are_here);
cc_deleteall(worldmap:arrow0);
cc_deleteall(worldmap:arrow1);
cc_deleteall(worldmap:arrow2);
cc_deleteall(worldmap:arrow3);
cc_deleteall(worldmap:arrow_gravestone);
cc_deleteall(worldmap:arrow_waypoint);
