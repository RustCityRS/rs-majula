[proc,worldmap_overlay_clear](component $component)
if_setontimer("worldmap_overlay($component, worldmap:com28, 0, 0, 0)", $component);
cc_deleteall($component);
cc_deleteall(worldmap:com36);
cc_deleteall(worldmap:com37);
cc_deleteall(worldmap:com38);
cc_deleteall(worldmap:com39);
cc_deleteall(worldmap:com40);
cc_deleteall(worldmap:com41);
cc_deleteall(worldmap:com42);
