[proc,worldmap_setuptext](int $int0, int $int1, int $int2, int $int3, colour $colour4, coord $coord5, string $string0, string $string1, string $string2)
cc_sethide(false);
cc_setsize($int0, $int1, ^setsize_abs, ^setsize_abs);
cc_setposition($int2, $int3, ^setpos_abs_centre, ^setpos_abs_centre);
cc_setcolour($colour4);
cc_settextfont(menu_font_small);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 13);
cc_settext($string0);
if ($coord5 ! -1) {
    cc_setopbase("<col=ff9040><$string1></col>");
    cc_setop(1, $string2);
    cc_setonop("worldmap_op(^event_op, ^event_com, $coord5)");
} else {
    cc_setop(1, "");
    cc_setonop(null);
}
