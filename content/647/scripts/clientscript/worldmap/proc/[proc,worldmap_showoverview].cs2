// 1374
[proc,worldmap_showoverview](int $int0)
if ($int0 = 1) {
    if_sethide(false, worldmap:com_46);
    if_setop(1, "Hide overview", worldmap:com_6);
} else {
    if_sethide(true, worldmap:com_46);
    if_setop(1, "Show overview", worldmap:com_6);
}
if_setonop("worldmap_toggleoverview", worldmap:com_6);
