[clientscript,worldmap_tooltip_key](component $component0, int $int1, string $string)
def_int $int2 = 0;
def_int $int3 = 0;
if (cc_find($component0, $int1) = true) {
    $int2, $int3 = calc(cc_getx + cc_getheight + 1), calc(cc_gety + cc_getheight + 1);
    $int3 = calc($int3 - if_getscrolly($component0));
    ~worldmap_tooltip($string, $int2, $int3);
}
