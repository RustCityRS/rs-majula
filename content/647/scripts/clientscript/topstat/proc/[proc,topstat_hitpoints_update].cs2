// 2654
[proc,topstat_hitpoints_update]
if (getwindowmode >= 2) {
    if_setgraphic(graphic_1207, topstat_hitpoints:com_1);
    if_setgraphic(graphic_1207, topstat_hitpoints:background_op);
    if_setposition(25, 1, ^setpos_abs_left, ^setpos_abs_top, topstat_hitpoints:globe);
    if_setposition(3, 15, ^setpos_abs_left, ^setpos_abs_top, topstat_hitpoints:text);
} else {
    if_setgraphic(graphic_1206, topstat_hitpoints:com_1);
    if_setgraphic(graphic_1206, topstat_hitpoints:background_op);
    if_setposition(1, 1, ^setpos_abs_left, ^setpos_abs_top, topstat_hitpoints:globe);
    if_setposition(31, 15, ^setpos_abs_left, ^setpos_abs_top, topstat_hitpoints:text);
}
