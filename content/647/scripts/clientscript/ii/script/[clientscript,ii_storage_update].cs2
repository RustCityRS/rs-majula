// 2905
[clientscript,ii_storage_update](component $component0, obj $obj1, int $int2, component $component3)
def_component $component4 = if_getlayer($component0);
def_int $int5 = 0;
if ($obj1 = butterfly_net) {
    switch_int (%varplayerbit_7193) {
        case 1 :
            $int5 = 1;
        case 2 :
            $int5 = 1;
            $obj1 = magic_butterfly_net;
    }
} else if ($obj1 = imp_repellent) {
    $int5 = %varplayerbit_7192;
} else if ($obj1 = impling_jar) {
    $int5 = %varplayerbit_7194;
}
if_settext("<oc_name($obj1)><br>(<tostring($int5)>/<tostring($int2)>)", $component3);
if_setobject_nonum($obj1, -1, $component0);
if_setoutline(1, $component0);
if ($int5 > 0) {
    if_setcolour(^yellow, $component3);
} else {
    if_setcolour(0xcc0000, $component3);
}
