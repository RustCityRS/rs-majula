// 2041
[clientscript,blast_furnace_bar_stock]
if_settext(blast_furnace_bar_stock:bf_bronze, "Bronze: <tostring(%blast_furnace_bronze_bars)>");
if (%blast_furnace_bronze_bars > 0) {
    if_setcolour(blast_furnace_bar_stock:bf_bronzeall, 0xff981f);
    if_setcolour(blast_furnace_bar_stock:bf_bronze, 0xff981f);
} else {
    if_setcolour(blast_furnace_bar_stock:bf_bronzeall, 0x999999);
    if_setcolour(blast_furnace_bar_stock:bf_bronze, 0x999999);
}
