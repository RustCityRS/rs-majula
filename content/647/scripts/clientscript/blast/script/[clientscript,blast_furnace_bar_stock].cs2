// 2041
[clientscript,blast_furnace_bar_stock]
if_settext("Bronze: <tostring(%varplayerbit_941)>", blast_furnace_bar_stock:bf_bronze);
if (%varplayerbit_941 > 0) {
    if_setcolour(0xff981f, blast_furnace_bar_stock:bf_bronzeall);
    if_setcolour(0xff981f, blast_furnace_bar_stock:bf_bronze);
} else {
    if_setcolour(0x999999, blast_furnace_bar_stock:bf_bronzeall);
    if_setcolour(0x999999, blast_furnace_bar_stock:bf_bronze);
}
