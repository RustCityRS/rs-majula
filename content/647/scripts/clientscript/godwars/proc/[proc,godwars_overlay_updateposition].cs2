// 2337
[proc,godwars_overlay_updateposition](component $component0)
if (getwindowmode >= 2) {
    if_setposition(calc(if_getwidth(toplevel_fullscreen:com_10) + 10), 10, ^setpos_abs_right, ^setpos_abs_top, $component0);
} else {
    if_setposition(10, 10, ^setpos_abs_right, ^setpos_abs_top, $component0);
}
