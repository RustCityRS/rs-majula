[proc,meslayer_setupdynamicbutton]
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settextfont(p12_full);
cc_setcolour(^blue);
cc_settextshadow(false);
cc_setsize(0, calc(if_getheight(cc_getlayer) - (if_gety(chatbox:com5) + if_getheight(chatbox:com5))), ^setsize_minus, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_bottom);
cc_setonmouseover("cc_text_colour_swapper(^event_com, ^event_subid, 16777215)");
cc_setonmouseleave("cc_text_colour_swapper(^event_com, ^event_subid, 255)");
