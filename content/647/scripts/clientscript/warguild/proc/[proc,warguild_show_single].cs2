// 4057
[proc,warguild_show_single](component $component0)
if (%warguild_roller_delay = 1 | if_gethide(warguild_token_choice:single_token_layer) = false) {
    return;
}
if (if_gethide(warguild_token_choice:single_token_layer) = true & if_gethide(warguild_token_choice:multi_token_layer) = true) {
    if_sethide(warguild_token_choice:single_token_layer, false);
    if_setposition(warguild_token_choice:single_token_layer, 0, calc(1 - if_getheight(warguild_token_choice:single_token_layer)), ^setpos_abs_centre, ^setpos_abs_top);
    %warguild_roller_delay = 1;
    if_clearops(warguild_token_choice:single_token_button);
    if_clearops(warguild_token_choice:multi_token_button);
    if_setontimer($component0, "script4059(warguild_token_choice:single_token_layer, $component0)");
} else {
    %warguild_roller_delay = 1;
    if_clearops(warguild_token_choice:single_token_button);
    if_clearops(warguild_token_choice:multi_token_button);
    if_setontimer($component0, "script4058(warguild_token_choice:multi_token_layer, warguild_token_choice:single_token_layer, $component0)");
}
if_setgraphic(warguild_token_choice:com_32, graphic_4465);
if_setgraphic(warguild_token_choice:com_33, graphic_2657);
if_setgraphic(warguild_token_choice:com_34, graphic_2657);
if_setgraphic(warguild_token_choice:com_36, graphic_4464);
if_setgraphic(warguild_token_choice:com_37, graphic_2659);
if_setgraphic(warguild_token_choice:com_38, graphic_2659);
if (%warguild_tokens_strength < 200 & %warguild_tokens_defence < 200 & %warguild_tokens_attack < 200 & %warguild_tokens_combat < 200 & %warguild_tokens_balance < 200) {
    ~warguild_not_enough_tokens;
} else {
    ~script4062;
}
%varclient_1431 = 1;
