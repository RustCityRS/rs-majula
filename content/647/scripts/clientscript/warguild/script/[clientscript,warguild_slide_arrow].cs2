// 4052
[clientscript,warguild_slide_arrow](component $component0, int $int1)
if ($int1 = 1) {
    if (if_gety($component0) < calc(1 - if_getheight($component0))) {
        if_setontimer(null, $component0);
        if_sethide(true, $component0);
    } else {
        if_setposition(0, calc(if_gety($component0) - 1), ^setpos_abs_right, ^setpos_abs_top, $component0);
        if (if_gettrans($component0) < 245) {
            if_settrans(calc(if_gettrans($component0) + 10), $component0);
        }
    }
} else if (if_gety($component0) > 30) {
    if_setontimer(null, $component0);
    if_sethide(true, $component0);
} else {
    if_setposition(0, calc(if_gety($component0) + 1), ^setpos_abs_right, ^setpos_abs_top, $component0);
    if (if_gettrans($component0) < 245) {
        if_settrans(calc(if_gettrans($component0) + 10), $component0);
    }
}
