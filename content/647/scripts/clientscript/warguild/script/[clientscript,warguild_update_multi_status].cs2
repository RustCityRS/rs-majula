// 4053
[clientscript,warguild_update_multi_status]
switch_int (%varplayerbit_8661) {
    case 0 :
        if_settext("Using multiple token types", warguild_token_overlay:token_type_text);
    case 1 :
        if_settext("Using attack tokens", warguild_token_overlay:token_type_text);
    case 2 :
        if_settext("Using defence tokens", warguild_token_overlay:token_type_text);
    case 3 :
        if_settext("Using strength tokens", warguild_token_overlay:token_type_text);
    case 4 :
        if_settext("Using combat tokens", warguild_token_overlay:token_type_text);
    case 5 :
        if_settext("Using balance tokens", warguild_token_overlay:token_type_text);
}
