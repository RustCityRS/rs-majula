// 4072
[clientscript,warguild_trans_off](component $component0)
if ($component0 = warguild_token_choice:ok_button) {
    if_sethide(warguild_token_choice:ok_trans, true);
} else if ($component0 = warguild_token_choice:single_token_button) {
    if_sethide(warguild_token_choice:single_trans, true);
} else if ($component0 = warguild_token_choice:multi_token_button) {
    if_sethide(warguild_token_choice:multi_trans, true);
}
