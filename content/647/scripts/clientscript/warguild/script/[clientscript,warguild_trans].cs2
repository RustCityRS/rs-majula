// 4071
[clientscript,warguild_trans](component $component0)
if ($component0 = warguild_token_choice:ok_button) {
    if_sethide(false, warguild_token_choice:ok_trans);
} else if ($component0 = warguild_token_choice:com_2) {
    if_sethide(false, warguild_token_choice:single_trans);
} else if ($component0 = warguild_token_choice:com_3) {
    if_sethide(false, warguild_token_choice:multi_trans);
}
