[proc,apply_zoom_item_text1](component $component)
if (if_getx($component) < calc(if_getwidth(easter09_nuts:com1) - 1) | calc(if_gety($component) - if_getheight($component)) > 110) {
    if (if_getx($component) = calc(140 + if_getwidth($component))) {
        if_setontimer("clientscript_1550(easter09_nuts:com7)", easter09_nuts:com20);
    }
    if_setposition(calc(1 + if_getx($component)), if_gety($component), ^setpos_abs_left, ^setpos_abs_top, $component);
} else {
    ~clientscript_1411;
}
