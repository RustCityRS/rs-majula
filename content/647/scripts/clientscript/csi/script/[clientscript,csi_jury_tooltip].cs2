// 3442
[clientscript,csi_jury_tooltip](component $component0, component $component1, int $int2)
if (~script3441 = true) {
    ~addtooltip_action_dynamic($component0, -1, $component1, ~script3443($int2), 50, 150);
} else {
    ~addtooltip_action_dynamic($component0, -1, $component1, "A member of the Jury.", 50, 150);
}
