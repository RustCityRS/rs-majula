// 1598
[clientscript,loot_ontimer](component $component0)
if (%varclient_53 < clientclock) {
    if (%varplayerbit_4072 = 1 | %varplayerbit_4073 = 1) {
        if_setgraphic("loot_icon,2", $component0);
    } else if (%varplayerbit_4071 = 1) {
        if (%varplayerbit_4465 = 1) {
            if_setgraphic("loot_icon,3", $component0);
        } else {
            if_setgraphic("loot_icon,0", $component0);
        }
    } else {
        if_setgraphic("loot_icon,1", $component0);
    }
    %varclient_53 = calc(clientclock + 500);
}
