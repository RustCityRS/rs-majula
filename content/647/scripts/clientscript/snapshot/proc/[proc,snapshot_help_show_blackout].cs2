// 232
[proc,snapshot_help_show_blackout]
if_sethide(true, snapshot_main_v2:name_blackout_layer);
if_sethide(true, snapshot_main_v2:offence_blackout_layer);
if_sethide(true, snapshot_main_v2:ignore_blackout_layer);
if_sethide(true, snapshot_main_v2:type_name_blackout_layer);
if (if_gethide(snapshot_main_v2:name_list_layer) = false) {
    if_sethide(false, snapshot_main_v2:name_blackout_layer);
} else if (if_gethide(snapshot_main_v2:offence_layer) = false) {
    if_sethide(false, snapshot_main_v2:offence_blackout_layer);
} else if (if_gethide(snapshot_main_v2:ignore_layer) = false) {
    if_sethide(false, snapshot_main_v2:ignore_blackout_layer);
} else if (if_gethide(snapshot_main_v2:type_name_layer) = false) {
    if_sethide(false, snapshot_main_v2:type_name_blackout_layer);
}
