// 134
[clientscript,snapshot_mutetoggle]
if (playermodlevel = 5 | playermodlevel = 6) {
    if_settext("Suggest to mute this player for 48 hours", snapshot_main_v2:mutetoggle);
    if_settext("Suggest to mute this player for 48 hours", snapshot_main_v2:mutetoggle_offence);
    if_settext("Suggest to mute this player for 48 hours", snapshot_main_v2:com_60);
} else {
    if_settext("Mute this player for 48 hours", snapshot_main_v2:mutetoggle);
    if_settext("Mute this player for 48 hours", snapshot_main_v2:mutetoggle_offence);
    if_settext("Mute this player for 48 hours", snapshot_main_v2:com_60);
}
if (%varclient_6 = true) {
    %varclient_6 = false;
} else {
    %varclient_6 = true;
}
if (%varclient_6 = false) {
    if_setgraphic("options_radio_buttons_boxed,0", snapshot_main_v2:com_82);
    if_setgraphic("options_radio_buttons_boxed,0", snapshot_main_v2:com_9);
    if_setgraphic("options_radio_buttons_boxed,0", snapshot_main_v2:com_59);
} else {
    if_setgraphic("options_radio_buttons_boxed,2", snapshot_main_v2:com_82);
    if_setgraphic("options_radio_buttons_boxed,2", snapshot_main_v2:com_9);
    if_setgraphic("options_radio_buttons_boxed,2", snapshot_main_v2:com_59);
}
