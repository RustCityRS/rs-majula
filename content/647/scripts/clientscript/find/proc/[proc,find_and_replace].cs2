[proc,find_and_replace](string $string0, string $string1, string $string2)(string)
def_int $int0 = string_indexof_string($string0, $string1, 0);
def_int $int1 = string_length($string1);
while ($int0 ! -1) {
    $string0 = "<substring($string0, 0, $int0)><$string2><substring($string0, calc($int0 + $int1), string_length($string0))>";
    $int0 = string_indexof_string($string0, $string1, $int0);
}
return($string0);
return("");
