[proc,find_and_replace_single](string $string0, string $string1, string $string2)(string)
def_int $int0 = 0;
def_int $int1 = 0;
def_string $string3 = "";
def_string $string4 = "";
def_int $int2 = string_length($string0);
def_int $int3 = string_length($string1);
if ($int2 > 0) {
    $int1 = string_indexof_string($string0, $string1, $int1);
    while ($int1 ! -1) {
        $string4 = substring($string0, $int0, $int1);
        if (compare($string4, "") ! 0) {
            $string3 = "<$string3><$string4><$string2>";
        }
        $int1 = calc($int1 + $int3);
        $int0 = $int1;
        $int1 = string_indexof_string($string0, $string1, $int1);
    }
    $string4 = substring($string0, $int0, $int2);
    if (compare($string4, "") ! 0) {
        $string3 = "<$string3><$string4>";
    }
}
return($string3);
return("");
