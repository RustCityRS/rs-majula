// 2352
[clientscript,xbows_setfont]
if (map_lang = 2 | map_lang = 3) {
    if_settextfont(xbows_pouch:text1, p11_full);
    if_settextfont(xbows_pouch:text2, p11_full);
    if_settextfont(xbows_pouch:text3, p11_full);
    if_settextfont(xbows_pouch:text4, p11_full);
    if_settextfont(xbows_pouch:text5, p11_full);
}
