[clientscript,login_back_button](component $component0, component $component1, component $component2, int $int3, int $int4, string $string)
if ($component0 ! null) {
    if ($int4 = true) {
        if_setgraphic(2525, $component0);
    } else {
        if_setgraphic(2524, $component0);
    }
}
if ($component1 ! null) {
    if ($int4 = true) {
        if_settext($string, $component0);
        if_setcolour(0xfad786, $component2);
        if_setsize(calc(op4125($string, $int3) + 23), if_getheight($component1), ^setsize_abs, ^setsize_abs, $component1);
    } else {
        if_settext($string, $component2);
        if_setcolour(0xe7ac24, $component2);
        if_setsize(calc(op4125($string, $int3) + 23), if_getheight($component1), ^setsize_abs, ^setsize_abs, $component1);
    }
}
