// 2937
[proc,login_load]
%varclient_1089 = -1;
if_setgraphic("corner_frame_1,3", login:top_left);
if_setgraphic("corner_frame_1,3", login:top_right);
if_setgraphic("corner_frame_1,2", login:bottom_left);
if_setgraphic("corner_frame_1,2", login:bottom_right);
if_setgraphic("corner_frame_1,2", login:popup_top_left);
if_setvflip(true, login:popup_top_left);
if_sethflip(true, login:popup_top_left);
if_setgraphic("corner_frame_1,2", login:popup_top_right);
if_setvflip(true, login:popup_top_right);
if_sethflip(false, login:popup_top_right);
if_setgraphic("corner_frame_1,2", login:popup_bottom_left);
if_setgraphic("corner_frame_1,2", login:popup_bottom_right);
