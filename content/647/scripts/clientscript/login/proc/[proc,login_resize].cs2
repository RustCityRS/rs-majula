def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 2;
$int1 = calc(if_getx(loginscreen:com_99) + if_getx(loginscreen:com_16));
$int1 = calc($int1 - (if_getwidth(loginscreen:toolbar_layer) + $int3));
$int2 = calc(if_gety(loginscreen:com_101) + if_gety(loginscreen:com_16));
$int2 = calc($int2 + $int3);
$int2 = calc($int2 + if_getheight(loginscreen:com_101));
if_setposition($int1, $int2, ^setpos_abs_left, ^setpos_abs_top, loginscreen:toolbar_layer);
$int1 = if_getx(loginscreen:toolbar_layer);
$int1 = calc($int1 + if_getwidth(loginscreen:toolbar_layer));
$int1 = calc(if_getwidth(loginscreen:background_layer) - $int1);
if_setposition($int1, $int2, ^setpos_abs_right, ^setpos_abs_top, loginscreen:toolbar_layer);
if (detailget_maxscreensize = 2 & getwindowmode ! ^windowmode_small) {
    if_setposition(9, 57, ^setpos_abs_right, ^setpos_abs_top, loginscreen:toolbar_layer);
    if_setsize(800, 503, ^setsize_abs, ^setsize_abs, loginscreen:com_16);
} else if (calc(if_getwidth(loginscreen:toolbar_layer) + if_getx(loginscreen:toolbar_layer)) > if_getwidth(loginscreen:background_layer)) {
    if_setposition(5, 5, ^setpos_abs_right, ^setpos_abs_top, loginscreen:toolbar_layer);
