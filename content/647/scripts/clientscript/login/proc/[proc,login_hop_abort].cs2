// 3235
[proc,login_hop_abort]
def_component $component0 = login:login_button;
if (unknown_command_5623 = true) {
    $component0 = south_progress9:login_button;
}
if (%loginscreen_hopblocked_time > 0) {
    if_setonclick($component0, "login_dologin");
    if_setontimer($component0, null);
    login_resetreply;
    ~login_popup_close;
}
