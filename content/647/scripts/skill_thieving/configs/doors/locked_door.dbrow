// 2011 rebuilt East Ardougne: 289's level-1 door (loc_2550, 2674,3305) is gone
// and two level-1 doors, door_34812 (2672,3301 and 2672,3308), open onto
// door_34813 (void-634's ardougne_locked_door_closed/_opened, level 1).
[locked_door_loc_2550]
table=locked_door
data=loc,area_ardougne_door2_locked
data=replacement,area_ardougne_door2_open
data=level,1
data=experience,38
data=door_successchance,32,250

