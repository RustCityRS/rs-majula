// 3680
[proc,music_v3_refresh]
~deltooltip_action(music_v3:music_tooltip_layer);
%tooltip_time = 0;
def_int $int0 = -1;
if (if_find(music_v3:now_playing_text) = true) {
    $int0 = cc_param(param_1133);
}
def_int $int1 = 0;
def_int $int2 = 0;
def_string $string0 = "";
def_int $int3 = string_length(%music_searchstring);
def_int $int4 = 5;
while ($int0 ! -1) {
    if (cc_find(music_v3:jukebox, calc($int0 * 2)) = true & .cc_find(music_v3:jukebox, calc($int0 * 2 + 1)) = true) {
        cc_clearops;
        .cc_clearops;
        $string0 = lowercase(cc_gettext);
        if (string_length($string0) > 0) {
            if (~music_getvar($int0) = ^true) {
                if ($int3 = 0 | string_indexof_string($string0, %music_searchstring, 0) ! -1) {
                    cc_setop(2, "Unlock hint");
                    ~script3681($int0);
                    cc_sethide(false);
                    .cc_sethide(false);
                    cc_setposition(15, $int4, ^setpos_abs_left, ^setpos_abs_top);
                    .cc_setposition(2, calc($int4 + 1), ^setpos_abs_left, ^setpos_abs_top);
                    $int4 = calc($int4 + 15);
                } else {
                    cc_sethide(true);
                    .cc_sethide(true);
                }
                $int1 = calc($int1 + 1);
            } else {
                if ($int3 = 0 | string_indexof_string($string0, %music_searchstring, 0) ! -1) {
                    cc_setop(2, "Unlock hint");
                    cc_setcolour(^red);
                    cc_setonmouseleave("cc_text_colour_swapper(event_com, event_comsubid, ^red)");
                    .cc_setonop(null);
                    cc_sethide(false);
                    cc_setposition(15, $int4, ^setpos_abs_left, ^setpos_abs_top);
                    .cc_setposition(2, calc($int4 + 1), ^setpos_abs_left, ^setpos_abs_top);
                    $int4 = calc($int4 + 15);
                } else {
                    cc_sethide(true);
                }
                .cc_sethide(true);
            }
            $int2 = calc($int2 + 1);
        }
        $int0 = cc_param(param_1133);
    } else {
        $int0 = -1;
    }
}
if_setscrollsize(music_v3:jukebox, 167, calc(5 + $int4));
~scrollbar_resize(music_v3:scrollbar, music_v3:jukebox, %playerdesign2_client_jaw);
if_settext(music_v3:unlock_counter, "Unlocked:<br><tostring($int1)> / <tostring($int2)>");
if ($int4 = 5) {
    if_sethide(music_v3:music_search_empty, false);
} else {
    if_sethide(music_v3:music_search_empty, true);
}
