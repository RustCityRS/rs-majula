// 289's music/scripts/music.rs2 on 2011's music player (music_v3, 187).
//
// 2011's changes:
// - A track's unlock is its place in the music player's list (enum 1345):
//   musicmulti_<index / 32 + 1>, bit index % 32 (clientscript 837; 289's
//   musicmulti_1-9 are its first nine), and its song is enum 1351's for its
//   index, as clientscript 828 lists it (music.dbrow).
// - 2011's music system plays a song to its end and then the area's song;
//   entering an area interrupts the song only when it unlocks the area's
//   track, and the unlock is announced in red. 2011 wiki, Update:Audio Week
//   and Improved Edgeville Dungeon (5 February 2008): "our new music system
//   plays songs all the way to the end, at which point a new song is chosen
//   that is appropriate to your area ... if you unlock a track by entering a
//   new area, the system will interrupt your current song in favour of the
//   new tune"; Music Player: "Players will be informed via red text in the
//   chat box whenever they unlock a new track". The message's words: The
//   Task at Hand (2011-03-05), "You have unlocked a new music track: ".
// - The music player has no Auto, Manual or Loop button (interface 187), so
//   289's %musicplay and %musicloop are gone: an area's track plays when
//   nothing else is (music_end).

[proc,music_getvar](int $var)(int)
if ($var = 1) {
    return(%musicmulti_1);
} else if ($var = 2) {
    return(%musicmulti_2);
} else if ($var = 3) {
    return(%musicmulti_3);
} else if ($var = 4) {
    return(%musicmulti_4);
} else if ($var = 5) {
    return(%musicmulti_5);
} else if ($var = 6) {
    return(%musicmulti_6);
} else if ($var = 7) {
    return(%musicmulti_7);
} else if ($var = 8) {
    return(%musicmulti_8);
} else if ($var = 9) {
    return(%musicmulti_9);
} else if ($var = 10) {
    return(%musicmulti_10);
} else if ($var = 11) {
    return(%musicmulti_11);
} else if ($var = 12) {
    return(%musicmulti_12);
} else if ($var = 13) {
    return(%musicmulti_13);
} else if ($var = 14) {
    return(%musicmulti_14);
} else if ($var = 15) {
    return(%musicmulti_15);
} else if ($var = 16) {
    return(%musicmulti_16);
} else if ($var = 17) {
    return(%musicmulti_17);
} else if ($var = 18) {
    return(%musicmulti_18);
} else if ($var = 19) {
    return(%musicmulti_19);
} else if ($var = 20) {
    return(%musicmulti_20);
} else if ($var = 21) {
    return(%musicmulti_21);
} else if ($var = 22) {
    return(%musicmulti_22);
} else if ($var = 23) {
    return(%musicmulti_23);
} else if ($var = 24) {
    return(%musicmulti_24);
} else if ($var = 25) {
    return(%musicmulti_25);
} else if ($var = 26) {
    return(%musicmulti_26);
} else if ($var = 27) {
    return(%musicmulti_27);
} else if ($var = 29) {
    return(%musicmulti_29);
} else if ($var = 30) {
    return(%musicmulti_30);
} else if ($var = 31) {
    return(%musicmulti_31);
}
return(null);

[proc,music_setvar](int $var, int $bit)
if ($var = 1) {
    %musicmulti_1 = setbit(%musicmulti_1, $bit);
} else if ($var = 2) {
    %musicmulti_2 = setbit(%musicmulti_2, $bit);
} else if ($var = 3) {
    %musicmulti_3 = setbit(%musicmulti_3, $bit);
} else if ($var = 4) {
    %musicmulti_4 = setbit(%musicmulti_4, $bit);
} else if ($var = 5) {
    %musicmulti_5 = setbit(%musicmulti_5, $bit);
} else if ($var = 6) {
    %musicmulti_6 = setbit(%musicmulti_6, $bit);
} else if ($var = 7) {
    %musicmulti_7 = setbit(%musicmulti_7, $bit);
} else if ($var = 8) {
    %musicmulti_8 = setbit(%musicmulti_8, $bit);
} else if ($var = 9) {
    %musicmulti_9 = setbit(%musicmulti_9, $bit);
} else if ($var = 10) {
    %musicmulti_10 = setbit(%musicmulti_10, $bit);
} else if ($var = 11) {
    %musicmulti_11 = setbit(%musicmulti_11, $bit);
} else if ($var = 12) {
    %musicmulti_12 = setbit(%musicmulti_12, $bit);
} else if ($var = 13) {
    %musicmulti_13 = setbit(%musicmulti_13, $bit);
} else if ($var = 14) {
    %musicmulti_14 = setbit(%musicmulti_14, $bit);
} else if ($var = 15) {
    %musicmulti_15 = setbit(%musicmulti_15, $bit);
} else if ($var = 16) {
    %musicmulti_16 = setbit(%musicmulti_16, $bit);
} else if ($var = 17) {
    %musicmulti_17 = setbit(%musicmulti_17, $bit);
} else if ($var = 18) {
    %musicmulti_18 = setbit(%musicmulti_18, $bit);
} else if ($var = 19) {
    %musicmulti_19 = setbit(%musicmulti_19, $bit);
} else if ($var = 20) {
    %musicmulti_20 = setbit(%musicmulti_20, $bit);
} else if ($var = 21) {
    %musicmulti_21 = setbit(%musicmulti_21, $bit);
} else if ($var = 22) {
    %musicmulti_22 = setbit(%musicmulti_22, $bit);
} else if ($var = 23) {
    %musicmulti_23 = setbit(%musicmulti_23, $bit);
} else if ($var = 24) {
    %musicmulti_24 = setbit(%musicmulti_24, $bit);
} else if ($var = 25) {
    %musicmulti_25 = setbit(%musicmulti_25, $bit);
} else if ($var = 26) {
    %musicmulti_26 = setbit(%musicmulti_26, $bit);
} else if ($var = 27) {
    %musicmulti_27 = setbit(%musicmulti_27, $bit);
} else if ($var = 29) {
    %musicmulti_29 = setbit(%musicmulti_29, $bit);
} else if ($var = 30) {
    %musicmulti_30 = setbit(%musicmulti_30, $bit);
} else if ($var = 31) {
    %musicmulti_31 = setbit(%musicmulti_31, $bit);
}

[label,music_play](midi $song)
%currentsong = $song;
%musicstart = map_clock;
%musiclength = midi_length($song);
midi_song(%currentsong);

[proc,music_jingle](midi $jingle)
// we only offset for music looping
// the client will handle playing the last song after this jingle ends
%musicstart = add(map_clock, midi_length($jingle));
midi_jingle($jingle);

[proc,.music_jingle](midi $jingle)
.%musicstart = add(map_clock, midi_length($jingle));
.midi_jingle($jingle);

// A track by its place in 2011's list (musicplayer.rs2), 289's button.
[label,music_playbybutton](int $playbutton)
db_find(music:playbutton, $playbutton);
def_dbrow $song = db_findnext;
if ($song = null) {
    return;
}

def_int $unlock;
def_int $bit;
$unlock, $bit = db_getfield($song, music:unlock, 0);

if ($unlock ! null) {
    if (testbit(~music_getvar($unlock), $bit) = ^false) {
        mes("You have not unlocked this piece of music yet!");
        return;
    }
}

// 289: %musicplay = 0, its Manual mode. 2011 has none: the track plays to
// its end, and then the area's (header).
if_settext(music_v3:com4, db_getfield($song, music:name, 0));
@music_play(db_getfield($song, music:track, 0));

[label,music_playbyregion](coord $coord)
// first, search for the song linked to this mapsquare
def_int $map_x = calc(coordx($coord) / 64 * 64);
def_int $map_z = calc(coordz($coord) / 64 * 64);

db_find(musicregion:mapsquare, movecoord(0_0_0_0_0, $map_x, 0, $map_z));
def_dbrow $region = db_findnext;
if ($region = null) {
    return;
}

// now that we have the region, we can grab info on the song
def_dbrow $song = db_getfield($region, musicregion:musicdata, 0);
def_int $unlock;
def_int $bit;
$unlock, $bit = db_getfield($song, music:unlock, 0);

if ($unlock ! null) {
    if (testbit(~music_getvar($unlock), $bit) = ^false) {
        ~music_setvar($unlock, $bit);
        // 2011: a new track is announced, and it interrupts the song playing
        mes("@red@You have unlocked a new music track: <db_getfield($song, music:name, 0)>.");
        %currentsong = null;
    }
}

// 289: if (%musicplay ! 0), its Auto mode. 2011: when nothing is playing.
if (%currentsong = null) {
    if_settext(music_v3:com4, db_getfield($song, music:name, 0));
    @music_play(db_getfield($song, music:track, 0));
}

// 2011: a song plays to its end, and then the area's song follows (header).
// 289's musicloop timer, which replayed a song once it had played for its
// length, is the model: the length counts from the song's start, or from the
// end of a jingle that interrupted it, as the client starts the song again.
[softtimer,music_end]
if (%currentsong = null) {
    return;
}

if (map_clock > add(%musicstart, %musiclength)) {
    %currentsong = null;
    @music_playbyregion(coord);
}

// 2011's listed tracks that "unlock automatically." (the music player's Unlock
// hint, enums 1349 and 952, clientscript 833), unlocked at login.
[proc,music_unlock_automatic]
~music_unlock_index(89);
~music_unlock_index(103);
~music_unlock_index(150);
~music_unlock_index(151);
~music_unlock_index(152);
~music_unlock_index(153);
~music_unlock_index(350);
~music_unlock_index(377);
~music_unlock_index(514);
~music_unlock_index(517);
~music_unlock_index(518);
~music_unlock_index(519);
~music_unlock_index(520);
~music_unlock_index(602);
~music_unlock_index(611);
~music_unlock_index(717);
~music_unlock_index(931);

[proc,music_unlock_index](int $index)
~music_setvar(calc($index / 32 + 1), modulo($index, 32));
