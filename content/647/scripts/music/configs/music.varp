// 289's music.varp. musicstart, currentsong and musiclength are server-only
// at 647: past the cache's 2,181 varps.
[musicstart]
scope=temp
protect=no

[currentsong]
type=midi
scope=temp
protect=no

[musiclength]
scope=temp
protect=no

// 289's track unlocks, a bit per track in the music player's order. 2011
// keeps 289's musicmulti_1-9 (varps 20-25, 298, 311, 346) and adds one per
// 32 tracks, in the order clientscript 837 reads them: musicmulti_N holds
// tracks (N - 1) * 32 to N * 32 - 1. 2011 has no varp for tracks 864-895
// (837 counts them unlocked), so there is no musicmulti_28. The cache
// transmits them; 289 saves them.
[musicmulti_1]
scope=perm
protect=no

[musicmulti_2]
scope=perm
protect=no

[musicmulti_3]
scope=perm
protect=no

[musicmulti_4]
scope=perm
protect=no

[musicmulti_5]
scope=perm
protect=no

