// 4266
[clientscript,lunarfm_rewards_onload]
~script4267;
~script4274;
if_settext(lunarfm_rewards_new:name, "");
if_settext(lunarfm_rewards_new:description, "Select a reward for more information.");
if_settext(lunarfm_rewards_new:extra_info, "");
if_sethide(lunarfm_rewards_new:spell_icon_layer, true);
if_sethide(lunarfm_rewards_new:task_list, true);
if_sethide(lunarfm_rewards_new:gold_frame_tasks, true);
if_sethide(lunarfm_rewards_new:gold_frame_list, false);
if_sethide(lunarfm_rewards_new:gold_frame_desc, false);
if_sethide(lunarfm_rewards_new:breakdown_layer, false);
if (%lunarfm_spells_unlocked < 8) {
    ~lunarfm_rewards_spells_display;
    if_settext(lunarfm_rewards_new:name, "Spells");
} else {
    ~lunarfm_rewards_wishes_display;
    if_settext(lunarfm_rewards_new:name, "Wishes");
}
