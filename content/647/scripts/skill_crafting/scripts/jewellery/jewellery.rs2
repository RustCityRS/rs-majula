// 289's gold and silver jewellery (skill_crafting/scripts/jewellery/
// jewellery.rs2) on 2011's interfaces, crafting_gold (446) and
// crafting_silver_casting (438), opened as 289's were: a gold or silver bar
// used on a furnace (smelting.rs2). The 2011 wiki's Crafting page (18 May
// 2011) agrees: "Gold items are made by using a gold bar with a furnace, while
// carrying a mould"; "Silver items can be crafted by using a Silver Bar on a
// Furnace while carrying the proper mould".
//
// 289's gold interface (crafting_jewelry) put its items in three inv rows
// (crafting_make_rings, _necklaces and _amulets, invisible stand-ins in the
// gem slots) with Make 1, 5 and 10. 2011's has a model and a button over it
// for each item, Make 1, 5, All and X on each, and no script of its own: the
// server puts each item in its model (if_setobject) and hides the button of
// what cannot be made, as void-634's Jewellery.kt does. Its ids are the
// cache's (positional; void-634's crafting.ifaces.toml, make_mould_slayer,
// agrees). void-634 opens 446 on members' worlds and 675, the same without
// the slayer ring and the keys, on free ones; 446 serves both here.
//
// 2011's gold interface adds bracelets, onyx, the slayer ring and the gold
// elemental key, and its silver interface the lightning rod, tiara,
// Silvthrill rod, demonic sigil, silver bolts, Silvthril chain and silver key,
// which 289 does not make: they stay hidden until they are ported.

// 2011's buttons, Make 1, 5, All and X on each item, where 289 had Make 1, 5
// and 10 on each inv slot (inv_button1-3).
// Gold ring
[if_button1,crafting_gold:gold_ring] @craft_gold(gold_ring, 1);
[if_button2,crafting_gold:gold_ring] @craft_gold(gold_ring, 5);
[if_button3,crafting_gold:gold_ring] @craft_gold(gold_ring, ^crafting_make_all);
[if_button4,crafting_gold:gold_ring] @craft_gold(gold_ring, ^crafting_make_x);
// Sapphire ring
[if_button1,crafting_gold:sapphire_ring] @craft_gold(sapphire_ring, 1);
[if_button2,crafting_gold:sapphire_ring] @craft_gold(sapphire_ring, 5);
[if_button3,crafting_gold:sapphire_ring] @craft_gold(sapphire_ring, ^crafting_make_all);
[if_button4,crafting_gold:sapphire_ring] @craft_gold(sapphire_ring, ^crafting_make_x);
// Emerald ring
[if_button1,crafting_gold:emerald_ring] @craft_gold(emerald_ring, 1);
[if_button2,crafting_gold:emerald_ring] @craft_gold(emerald_ring, 5);
[if_button3,crafting_gold:emerald_ring] @craft_gold(emerald_ring, ^crafting_make_all);
[if_button4,crafting_gold:emerald_ring] @craft_gold(emerald_ring, ^crafting_make_x);
// Ruby ring
[if_button1,crafting_gold:ruby_ring] @craft_gold(ruby_ring, 1);
[if_button2,crafting_gold:ruby_ring] @craft_gold(ruby_ring, 5);
[if_button3,crafting_gold:ruby_ring] @craft_gold(ruby_ring, ^crafting_make_all);
[if_button4,crafting_gold:ruby_ring] @craft_gold(ruby_ring, ^crafting_make_x);
// Diamond ring
[if_button1,crafting_gold:diamond_ring] @craft_gold(diamond_ring, 1);
[if_button2,crafting_gold:diamond_ring] @craft_gold(diamond_ring, 5);
[if_button3,crafting_gold:diamond_ring] @craft_gold(diamond_ring, ^crafting_make_all);
[if_button4,crafting_gold:diamond_ring] @craft_gold(diamond_ring, ^crafting_make_x);
// Dragonstone ring
[if_button1,crafting_gold:dragonstone_ring] @craft_gold(dragonstone_ring, 1);
[if_button2,crafting_gold:dragonstone_ring] @craft_gold(dragonstone_ring, 5);
[if_button3,crafting_gold:dragonstone_ring] @craft_gold(dragonstone_ring, ^crafting_make_all);
[if_button4,crafting_gold:dragonstone_ring] @craft_gold(dragonstone_ring, ^crafting_make_x);
// Gold necklace
[if_button1,crafting_gold:gold_necklace] @craft_gold(gold_necklace, 1);
[if_button2,crafting_gold:gold_necklace] @craft_gold(gold_necklace, 5);
[if_button3,crafting_gold:gold_necklace] @craft_gold(gold_necklace, ^crafting_make_all);
[if_button4,crafting_gold:gold_necklace] @craft_gold(gold_necklace, ^crafting_make_x);
// Sapphire necklace
[if_button1,crafting_gold:sapphire_necklace] @craft_gold(sapphire_necklace, 1);
[if_button2,crafting_gold:sapphire_necklace] @craft_gold(sapphire_necklace, 5);
[if_button3,crafting_gold:sapphire_necklace] @craft_gold(sapphire_necklace, ^crafting_make_all);
[if_button4,crafting_gold:sapphire_necklace] @craft_gold(sapphire_necklace, ^crafting_make_x);
// Emerald necklace
[if_button1,crafting_gold:emerald_necklace] @craft_gold(emerald_necklace, 1);
[if_button2,crafting_gold:emerald_necklace] @craft_gold(emerald_necklace, 5);
[if_button3,crafting_gold:emerald_necklace] @craft_gold(emerald_necklace, ^crafting_make_all);
[if_button4,crafting_gold:emerald_necklace] @craft_gold(emerald_necklace, ^crafting_make_x);
// Ruby necklace
[if_button1,crafting_gold:ruby_necklace] @craft_gold(ruby_necklace, 1);
[if_button2,crafting_gold:ruby_necklace] @craft_gold(ruby_necklace, 5);
[if_button3,crafting_gold:ruby_necklace] @craft_gold(ruby_necklace, ^crafting_make_all);
[if_button4,crafting_gold:ruby_necklace] @craft_gold(ruby_necklace, ^crafting_make_x);
// Diamond necklace
[if_button1,crafting_gold:diamond_necklace] @craft_gold(diamond_necklace, 1);
[if_button2,crafting_gold:diamond_necklace] @craft_gold(diamond_necklace, 5);
[if_button3,crafting_gold:diamond_necklace] @craft_gold(diamond_necklace, ^crafting_make_all);
[if_button4,crafting_gold:diamond_necklace] @craft_gold(diamond_necklace, ^crafting_make_x);
// Dragon necklace
[if_button1,crafting_gold:dragonstone_necklace] @craft_gold(dragonstone_necklace, 1);
[if_button2,crafting_gold:dragonstone_necklace] @craft_gold(dragonstone_necklace, 5);
[if_button3,crafting_gold:dragonstone_necklace] @craft_gold(dragonstone_necklace, ^crafting_make_all);
[if_button4,crafting_gold:dragonstone_necklace] @craft_gold(dragonstone_necklace, ^crafting_make_x);
// Gold amulet
[if_button1,crafting_gold:gold_amulet] @craft_gold(unstrung_gold_amulet, 1);
[if_button2,crafting_gold:gold_amulet] @craft_gold(unstrung_gold_amulet, 5);
[if_button3,crafting_gold:gold_amulet] @craft_gold(unstrung_gold_amulet, ^crafting_make_all);
[if_button4,crafting_gold:gold_amulet] @craft_gold(unstrung_gold_amulet, ^crafting_make_x);
// Sapphire amulet
[if_button1,crafting_gold:sapphire_amulet] @craft_gold(unstrung_sapphire_amulet, 1);
[if_button2,crafting_gold:sapphire_amulet] @craft_gold(unstrung_sapphire_amulet, 5);
[if_button3,crafting_gold:sapphire_amulet] @craft_gold(unstrung_sapphire_amulet, ^crafting_make_all);
[if_button4,crafting_gold:sapphire_amulet] @craft_gold(unstrung_sapphire_amulet, ^crafting_make_x);
// Emerald amulet
[if_button1,crafting_gold:emerald_amulet] @craft_gold(unstrung_emerald_amulet, 1);
[if_button2,crafting_gold:emerald_amulet] @craft_gold(unstrung_emerald_amulet, 5);
[if_button3,crafting_gold:emerald_amulet] @craft_gold(unstrung_emerald_amulet, ^crafting_make_all);
[if_button4,crafting_gold:emerald_amulet] @craft_gold(unstrung_emerald_amulet, ^crafting_make_x);
// Ruby amulet
[if_button1,crafting_gold:ruby_amulet] @craft_gold(unstrung_ruby_amulet, 1);
[if_button2,crafting_gold:ruby_amulet] @craft_gold(unstrung_ruby_amulet, 5);
[if_button3,crafting_gold:ruby_amulet] @craft_gold(unstrung_ruby_amulet, ^crafting_make_all);
[if_button4,crafting_gold:ruby_amulet] @craft_gold(unstrung_ruby_amulet, ^crafting_make_x);
// Diamond amulet
[if_button1,crafting_gold:diamond_amulet] @craft_gold(unstrung_diamond_amulet, 1);
[if_button2,crafting_gold:diamond_amulet] @craft_gold(unstrung_diamond_amulet, 5);
[if_button3,crafting_gold:diamond_amulet] @craft_gold(unstrung_diamond_amulet, ^crafting_make_all);
[if_button4,crafting_gold:diamond_amulet] @craft_gold(unstrung_diamond_amulet, ^crafting_make_x);
// Dragonstone amulet
[if_button1,crafting_gold:dragonstone_amulet] @craft_gold(unstrung_dragonstone_amulet, 1);
[if_button2,crafting_gold:dragonstone_amulet] @craft_gold(unstrung_dragonstone_amulet, 5);
[if_button3,crafting_gold:dragonstone_amulet] @craft_gold(unstrung_dragonstone_amulet, ^crafting_make_all);
[if_button4,crafting_gold:dragonstone_amulet] @craft_gold(unstrung_dragonstone_amulet, ^crafting_make_x);

// 289 stopped transmitting its three inv rows here; 2011's interface has none.
// [if_close,crafting_jewelry]
// inv_stoptransmit(crafting_jewelry:rings_inv);
// inv_stoptransmit(crafting_jewelry:necklaces_inv);
// inv_stoptransmit(crafting_jewelry:amulets_inv);

//--- Label to open, and handle the gold jewelry interface
[label,craft_gold_interface]()
p_arrivedelay();

// each gem total
def_int $diamond_total = inv_total(inv, diamond);
def_int $ruby_total = inv_total(inv, ruby);
def_int $emerald_total = inv_total(inv, emerald);
def_int $sapphire_total = inv_total(inv, sapphire);
def_int $dragonstone_total = inv_total(inv, dragonstone);
// https://i.imgur.com/BwS99Hp.png
// from https://web.archive.org/web/20051025132703/http://www.runeweb.net/index.php?page=rs2-crafting
// check if player has the corresponding moulds
// 289 put an item in an inv slot (inv_setslot) where it could be made and
// emptied the slot (inv_delslot) where not; 2011 shows the item in its model
// and its button over it, or 289's black stand-in with no button. 289's
// if_setobject zooms (110, 100, 75) are 2011's counts: 2011 zooms each item
// as its obj does (the 647 client's IF_SETOBJECT reads a count and takes
// the zoom from the obj's zoom2d).
if (inv_total(inv, ring_mould) > 0) {
    if_sethide(crafting_gold:com_17, true); // hide "You need a ring mould to craft rings."
    if_sethide(crafting_gold:com_18, false);

    // 289's gold ring always sat in its first slot (crafting_make_rings' stock)
    if_setobject(crafting_gold:gold_dark1, gold_ring, 1);
    if_sethide(crafting_gold:gold_ring, false);
    // if they have one or more of corresponding gem, show corresponding ring
    if ($sapphire_total > 0) {
        if_sethide(crafting_gold:sapphire_ring, false);
        if_setobject(crafting_gold:sapphire_dark1, sapphire_ring, 1);
    } else {
        if_sethide(crafting_gold:sapphire_ring, true);
        if_setobject(crafting_gold:sapphire_dark1, black_ring, 1);
    }
    if ($emerald_total > 0) {
        if_sethide(crafting_gold:emerald_ring, false);
        if_setobject(crafting_gold:emerald_dark1, emerald_ring, 1);
    } else {
        if_sethide(crafting_gold:emerald_ring, true);
        if_setobject(crafting_gold:emerald_dark1, black_ring, 1);
    }
    if ($ruby_total > 0) {
        if_sethide(crafting_gold:ruby_ring, false);
        if_setobject(crafting_gold:ruby_dark1, ruby_ring, 1);
    } else {
        if_sethide(crafting_gold:ruby_ring, true);
        if_setobject(crafting_gold:ruby_dark1, black_ring, 1);
    }
    if ($diamond_total > 0) {
        if_sethide(crafting_gold:diamond_ring, false);
        if_setobject(crafting_gold:diamond_dark1, diamond_ring, 1);
    } else {
        if_sethide(crafting_gold:diamond_ring, true);
        if_setobject(crafting_gold:diamond_dark1, black_ring, 1);
    }
    if ($dragonstone_total > 0) {
        if_sethide(crafting_gold:dragonstone_ring, false);
        if_setobject(crafting_gold:dragon_dark1, dragonstone_ring, 1);
    } else {
        if_sethide(crafting_gold:dragonstone_ring, true);
        if_setobject(crafting_gold:dragon_dark1, black_ring, 1);
    }
} else {
    // normalize: show "You need a ring mould to craft rings." (default)
    if_sethide(crafting_gold:com_17, false);
    // normalize: hide ring selection layer
    if_sethide(crafting_gold:com_18, true);
}
if (inv_total(inv, necklace_mould) > 0) {
    if_sethide(crafting_gold:com_21, true); // hide "You need a necklace mould to craft necklaces."
    if_sethide(crafting_gold:com_23, false);

    if_setobject(crafting_gold:gold_dark2, gold_necklace, 1);
    if_sethide(crafting_gold:gold_necklace, false);
    // if they have one or more of corresponding gem, show corresponding necklace
    if ($sapphire_total > 0) {
        if_sethide(crafting_gold:sapphire_necklace, false);
        if_setobject(crafting_gold:sapphire_dark2, sapphire_necklace, 1);
    } else {
        if_sethide(crafting_gold:sapphire_necklace, true);
        if_setobject(crafting_gold:sapphire_dark2, black_necklace, 1);
    }
    if ($emerald_total > 0) {
        if_sethide(crafting_gold:emerald_necklace, false);
        if_setobject(crafting_gold:emerald_dark2, emerald_necklace, 1);
    } else {
        if_sethide(crafting_gold:emerald_necklace, true);
        if_setobject(crafting_gold:emerald_dark2, black_necklace, 1);
    }
    if ($ruby_total > 0) {
        if_sethide(crafting_gold:ruby_necklace, false);
        if_setobject(crafting_gold:ruby_dark2, ruby_necklace, 1);
    } else {
        if_sethide(crafting_gold:ruby_necklace, true);
        if_setobject(crafting_gold:ruby_dark2, black_necklace, 1);
    }
    if ($diamond_total > 0) {
        if_sethide(crafting_gold:diamond_necklace, false);
        if_setobject(crafting_gold:diamond_dark2, diamond_necklace, 1);
    } else {
        if_sethide(crafting_gold:diamond_necklace, true);
        if_setobject(crafting_gold:diamond_dark2, black_necklace, 1);
    }
    if ($dragonstone_total > 0) {
        if_sethide(crafting_gold:dragonstone_necklace, false);
        if_setobject(crafting_gold:dragon_dark2, dragonstone_necklace, 1);
    } else {
        if_sethide(crafting_gold:dragonstone_necklace, true);
        if_setobject(crafting_gold:dragon_dark2, black_necklace, 1);
    }
} else {
    // normalize: show "You need a necklace mould to craft necklaces." (default)
    if_sethide(crafting_gold:com_21, false);
    // normalize: hide necklace selection layer
    if_sethide(crafting_gold:com_23, true);
}
if (inv_total(inv, amulet_mould) > 0) {
    if_sethide(crafting_gold:com_26, true); // hide "You need a amulet mould to craft amulets."
    if_sethide(crafting_gold:com_27, false);

    if_setobject(crafting_gold:gold_dark3, unstrung_gold_amulet, 1);
    if_sethide(crafting_gold:gold_amulet, false);
    // if they have one or more of corresponding gem, show corresponding amulet
    if ($sapphire_total > 0) {
        //sets slot to the invisable amulet
        if_sethide(crafting_gold:sapphire_amulet, false);
        if_setobject(crafting_gold:sapphire_dark3, unstrung_sapphire_amulet, 1);
    } else {
        if_sethide(crafting_gold:sapphire_amulet, true);
        if_setobject(crafting_gold:sapphire_dark3, black_amulet, 1);
    }
    if ($emerald_total > 0) {
        if_sethide(crafting_gold:emerald_amulet, false);
        if_setobject(crafting_gold:emerald_dark3, unstrung_emerald_amulet, 1);
    } else {
        if_sethide(crafting_gold:emerald_amulet, true);
        if_setobject(crafting_gold:emerald_dark3, black_amulet, 1);
    }
    if ($ruby_total > 0) {
        if_sethide(crafting_gold:ruby_amulet, false);
        if_setobject(crafting_gold:ruby_dark3, unstrung_ruby_amulet, 1);
    } else {
        if_sethide(crafting_gold:ruby_amulet, true);
        if_setobject(crafting_gold:ruby_dark3, black_amulet, 1);
    }
    if ($diamond_total > 0) {
        if_sethide(crafting_gold:diamond_amulet, false);
        if_setobject(crafting_gold:diamond_dark3, unstrung_diamond_amulet, 1);
    } else {
        if_sethide(crafting_gold:diamond_amulet, true);
        if_setobject(crafting_gold:diamond_dark3, black_amulet, 1);
    }
    if ($dragonstone_total > 0) {
        if_sethide(crafting_gold:dragonstone_amulet, false);
        if_setobject(crafting_gold:dragon_dark3, unstrung_dragonstone_amulet, 1);
    } else {
        if_sethide(crafting_gold:dragonstone_amulet, true);
        if_setobject(crafting_gold:dragon_dark3, black_amulet, 1);
    }
} else {
    // normalize: show "You need an amulet mould to craft amulets." (default)
    if_sethide(crafting_gold:com_26, false);
    // normalize: hide amulet selection layer
    if_sethide(crafting_gold:com_27, true);
}
// 2011's onyx items and slayer ring, and its bracelets' row (title, model,
// "You need a bracelet mould", items), which 289 does not make. Its keys' row
// is hidden in the cache.
if_sethide(crafting_gold:onyx_dark1, true);
if_sethide(crafting_gold:onyx_ring, true);
if_sethide(crafting_gold:onyx_dark6, true);
if_sethide(crafting_gold:slayer_dark1, true);
if_sethide(crafting_gold:slayer_ring, true);
if_sethide(crafting_gold:onyx_dark2, true);
if_sethide(crafting_gold:onyx_necklace, true);
if_sethide(crafting_gold:onyx_dark3, true);
if_sethide(crafting_gold:onyx_amulet, true);
if_sethide(crafting_gold:bracelet_title, true);
if_sethide(crafting_gold:com_29, true);
if_sethide(crafting_gold:need_bracelet_mould, true);
if_sethide(crafting_gold:got_bracelet_mould, true);
// open jewelry interface
if_openmain(crafting_gold);
//----------------------


//--- Label to check if the player has high enough level
//--- also calcs the real count of jewelry, and calls the weakqueue
// 289 took the item from the clicked inv slot (inv_getobj) and its struct from
// the item (crafting_jewelry_struct); 2011's button gives the struct.
[label,craft_gold](struct $struct, int $count)
def_namedobj $gem = struct_param($struct, gem);
// check if mems objs are selected
// 289 checked for the dragonstone slots' stand-ins (invis_ring5,
// invis_necklace5, invis_amulet5).
if ($gem = dragonstone) {
    if (map_members = ^false) {
        mes(^mes_members_feature);
        return;
    }
}
// 2011's Make X (op4 in cache 786) asks how many, as void-634's Jewellery.kt
// does ("Enter amount:"); its Make All makes as many as the bars and gems
// make.
if ($count = ^crafting_make_x) {
    p_countdialog;
    if (last_int <= 0) return;
    $count = last_int;
} else if ($count = ^crafting_make_all) {
    $count = add(inv_total(inv, gold_bar), inv_total(inv, perfect_gold_bar));
    if ($gem ! null) {
        $count = min($count, inv_total(inv, $gem));
    }
}
def_int $level = struct_param($struct, levelrequired);
if (stat(crafting) < $level) {
    if_close;
    ~mesbox("You need at least level <tostring($level)> Crafting to make that.");
    return;
}
// macro event
if (afk_event = ^true) {
    ~macro_event_general_spawn(~macro_event_set_random);
    return;
}
// ****** FOR WEAKQUEUE *******
// // make sure the player doesnt produce more than they can
// // the gem_total is only 0 when the player selects gold crafting
// def_int $gem_total = inv_total(inv,  struct_param($struct, gem));
// if ($gem_total = 0) {
//     $count = min($count, inv_total(inv, gold_bar));
// } else {
//     $count = min(min($count, inv_total(inv, gold_bar)), $gem_total);
// }
// ****** FOR WEAKQUEUE *******
def_int $productexp = struct_param($struct, productexp);
def_namedobj $product = struct_param($struct, product);
if_close;
// 289's human_furnace keeps its id, seq 899, and its furnace sound is
// void-634's smelt_bar, synth 2725, as smelting has them (smelting.rs2).
anim(seq_899, 0);
sound_synth(furnace, 1, 0);
p_delay(2);
~crafting_gold($product, $gem, $productexp, $count);
// weakqueue(crafting_gold, 1, $productexp, $gem, $product, $count);
//----------------------

[proc,crafting_gold](namedobj $product, namedobj $gem, int $productexp, int $count)

def_obj $bar = gold_bar;
if (inv_total(inv, perfect_gold_bar) >= 1) {
    // Tested on OSRS: if normal gold bar and perfect gold bar are both in inventory, the perfect gold bar gets used first,
    // even if the normal gold bar was explicitly used on the furnace. If you select normal ruby ring with normal gold bar
    // and you have a perfect bar in your inv, a perfect ring will be made instead (and only one, even if you have more
    // gold bars and selected make x).
    $bar = perfect_gold_bar;
    if ($product = ruby_necklace) {
        $product = perfect_ruby_necklace;
    }
    else if ($product = ruby_ring) {
        $product = perfect_ruby_ring;
    }
}
inv_del(inv, $bar, 1);

if ($gem ! null) {
    inv_del(inv, $gem, 1);
}
inv_add(inv, $product, 1);

// 289 pays with stat_advance, here and below; 2011's xp counter
// counts what ~givexp pays (player/scripts/xp.rs2).
~givexp(crafting, $productexp);

if ($bar = gold_bar) {
    // No message for perfect gold items https://youtu.be/e8btuenT4nE?t=729
    mes("You make <~add_article(lowercase(oc_name($product)))>.");
}
$count = calc($count - 1);
if ($count < 1) {
    return;
}

// check if player has enough gold bars or gems
if (inv_total(inv, $bar) < 1) {
    ~mesbox("You don't have enough gold bars to make any more.");
    return;
}
if (inv_total(inv, $gem) < 1 & $gem ! null) {
    ~mesbox("You don't have enough <lowercase(oc_name($gem))>s to make any more.");
    return;
}

anim(seq_899, 0);
sound_synth(furnace, 1, 0);
p_delay(2);
~crafting_gold($product, $gem, $productexp, $count);


// 289 asked in skill_multi2, or skill_multi3 with the sickle when it held a
// sickle mould on a members' world, and said "You require a mould to make
// that." of a mould it lacked. 2011 asks in its silver casting interface,
// whose rows show the item with Make 1, 5, All and X under its mould, or "You
// need a ... mould to make this item." in a layer the server shows instead
// (cache 786; void-634's SilverCasting.kt writes the same over the item).
// https://web.archive.org/web/20060111201853im_/http://www.runeweb.net/Roth/Creature_Quest/10.PNG
// should prob always show holy/unholy and show others depending on inv moulds?
[label,craft_silver]
// if(inv_total(inv, sickle_mould) > 0 & map_members = ^true) {
//     $product, $count = ~skill_multi3(nostringsnake, 0, -10, 175, "\\n\\n\\n\\nSymbol of Zamorak",
//        nostringstar, 0, -10, 175, "\\n\\n\\n\\nSymbol of Saradomin",
//        silver_sickle, 0, -15, 175, "\\n\\n\\n\\n@blu@Silver sickle"
//     );
// } else {
//     $product, $count = ~skill_multi2(nostringsnake, 0, -10, 175, "\\n\\n\\n\\nSymbol of Zamorak",
//        nostringstar, 0, -10, 175, "\\n\\n\\n\\nSymbol of Saradomin"
//     );
// }
~craft_silver_row(crafting_silver_casting:com_15, crafting_silver_casting:com_17, crafting_silver_casting:com_19, crafting_silver_casting:com_20, holy_symbol_mould, nostringstar);
~craft_silver_row(crafting_silver_casting:com_22, crafting_silver_casting:com_24, crafting_silver_casting:com_26, crafting_silver_casting:com_27, unholy_symbol_mould, nostringsnake);
if (map_members = ^true) {
    ~craft_silver_row(crafting_silver_casting:silvercast_sickle, crafting_silver_casting:silvercast_sickle_model, crafting_silver_casting:com_33, crafting_silver_casting:com_34, sickle_mould, silver_sickle);
} else {
    if_sethide(crafting_silver_casting:silvercast_sickle, true);
    if_sethide(crafting_silver_casting:com_33, true);
}
// 2011's rows that 289 does not make; their mould layers are hidden in the
// cache.
if_sethide(crafting_silver_casting:silvercast_lightning, true);
if_sethide(crafting_silver_casting:silvercast_tiara, true);
if_sethide(crafting_silver_casting:silvercast_commandrod, true);
if_sethide(crafting_silver_casting:silvercast_agrith, true);
if_sethide(crafting_silver_casting:com_65, true);
if_sethide(crafting_silver_casting:com_72, true);
if_sethide(crafting_silver_casting:com_78, true);
if_openmain(crafting_silver_casting);

// A row of 2011's silver casting interface: the item and its buttons with the
// mould, the mould and "You need a ... mould" without.
[proc,craft_silver_row](component $make, component $make_model, component $need, component $need_model, namedobj $mould, namedobj $product)
if (inv_total(inv, $mould) > 0) {
    if_sethide($make, false);
    if_sethide($need, true);
    if_setobject($make_model, $product, 1);
} else {
    if_sethide($make, true);
    if_sethide($need, false);
    if_setobject($need_model, $mould, 1);
}

// 2011's buttons, Make 1, 5, All and X, where 289 asked in skill_multi.
// Saradomin symbol
[if_button1,crafting_silver_casting:com_16] @craft_silver_make(nostringstar, 1);
[if_button2,crafting_silver_casting:com_16] @craft_silver_make(nostringstar, 5);
[if_button3,crafting_silver_casting:com_16] @craft_silver_make(nostringstar, ^crafting_make_all);
[if_button4,crafting_silver_casting:com_16] @craft_silver_make(nostringstar, ^crafting_make_x);
// Zamorak symbol
[if_button1,crafting_silver_casting:com_23] @craft_silver_make(nostringsnake, 1);
[if_button2,crafting_silver_casting:com_23] @craft_silver_make(nostringsnake, 5);
[if_button3,crafting_silver_casting:com_23] @craft_silver_make(nostringsnake, ^crafting_make_all);
[if_button4,crafting_silver_casting:com_23] @craft_silver_make(nostringsnake, ^crafting_make_x);
// Silver sickle
[if_button1,crafting_silver_casting:silver_sickle_x] @craft_silver_make(silver_sickle, 1);
[if_button2,crafting_silver_casting:silver_sickle_x] @craft_silver_make(silver_sickle, 5);
[if_button3,crafting_silver_casting:silver_sickle_x] @craft_silver_make(silver_sickle, ^crafting_make_all);
[if_button4,crafting_silver_casting:silver_sickle_x] @craft_silver_make(silver_sickle, ^crafting_make_x);

// 289's craft_silver from its choice on.
[label,craft_silver_make](namedobj $product, int $count)
// 2011's Make X (op4 in cache 786) asks how many, as void-634's
// SilverCasting.kt does; its Make All makes as many as the bars make.
if ($count = ^crafting_make_x) {
    p_countdialog;
    if (last_int <= 0) return;
    $count = last_int;
} else if ($count = ^crafting_make_all) {
    $count = inv_total(inv, silver_bar);
}
if_close;

if($count = 0) {
    return;
}

if(map_members = ^false & oc_members($product) = true) {
    mes(^mes_members_do_that);
    return;
}

def_struct $struct = oc_param($product, crafting_jewelry_struct);
def_namedobj $mould = struct_param($struct, mould);
if(inv_total(inv, $mould) = 0) {
    ~mesbox("You require a mould to make that.");
    return;
}

def_int $level = struct_param($struct, levelrequired);
if (stat(crafting) < $level) {
    ~mesbox("You need at least level <tostring($level)> Crafting to make that.");
    return;
}

// macro event
if (afk_event = ^true) {
    ~macro_event_general_spawn(~macro_event_set_random);
    return;
}
@process_craft_silver($struct, $product, $count);

[label,process_craft_silver](struct $struct, namedobj $product, int $count)
anim(seq_899, 0);
sound_synth(furnace, 1, 0);
// initial is 2t, afterwards is 3t cause processing order, not action_delay dependennt
weakqueue*(craft_silver, 2)($struct, $product, $count);

[queue,craft_silver](struct $struct, namedobj $product, int $count)
if(inv_total(inv, silver_bar) = 0) {
    // https://youtu.be/WJ2gW6dx_vo?si=Hl5EcZQoyaxqyr_P&t=121
    mes("You have run out of silver bars.");
    return;
}
inv_del(inv, silver_bar, 1);
inv_add(inv, $product, 1);
~givexp(crafting, struct_param($struct, productexp));
// Confirmed, no period at the end. https://i.imgur.com/sCKRVO9.png
mes("You make <~add_article(struct_param($struct, name_text))>");
if(sub($count, 1) < 1) {
    return;
}
@process_craft_silver($struct, $product, sub($count, 1));

