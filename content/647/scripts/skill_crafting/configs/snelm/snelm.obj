// 289's snail shells (skill_crafting/configs/snelm/snelm.obj), 2011's
// blamish_*_shell and shellpoint_*: their examine (moved here from
// general/configs/examine.obj) and 289's server keys on 2011's objs. The
// helmets they make are 2011's myre_snelm, blood_n_tar_snelm, ochre_snelm,
// bruise_blue_snelm, broken_bark_snelm and snelm_point_*.

[blamish_myre_shell]
desc=An easy-to-make, 'myre'-coloured, Mort Myre snail shell; looks protective.
category=category_3
param=next_obj_stage,myre_snelm

[blamish_red_shell]
desc=An easy-to-make, red-and-black, Mort Myre snail shell; looks protective.
category=category_3
param=next_obj_stage,blood_n_tar_snelm

[blamish_ochre_shell]
desc=An easy-to-make, muddy-yellow, Mort Myre snail shell; looks protective.
category=category_3
param=next_obj_stage,ochre_snelm

[blamish_blue_shell]
desc=An easy-to-make, blue, Mort Myre snail shell; looks protective.
category=category_3
param=next_obj_stage,bruise_blue_snelm

[blamish_bark_shell]
desc=An easy-to-make, bark-coloured, Mort Myre snail shell; looks protective.
category=category_3
param=next_obj_stage,broken_bark_snelm

[shellpoint_swamp]
desc=An easy-to-make, 'myre'-coloured, Mort Myre snail shell; looks protective.
category=category_3
param=next_obj_stage,snelm_point_swamp

[shellpoint_red+black]
desc=An easy-to-make, red, Mort Myre snail shell; looks protective.
category=category_3
param=next_obj_stage,snelm_point_red+black

[shellpoint_yellow]
desc=An easy-to-make, ochre, Mort Myre snail shell; looks protective.
category=category_3
param=next_obj_stage,snelm_point_yellow

[shellpoint_blue]
desc=An easy-to-make, blue, Mort Myre snail shell; looks protective.
category=category_3
param=next_obj_stage,snelm_point_blue
