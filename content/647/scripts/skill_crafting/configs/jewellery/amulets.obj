// 289's unstrung amulets (skill_crafting/configs/jewellery/amulets.obj): their
// examine (moved here from general/configs/examine.obj) and 289's server key
// on 2011's objs. 289's invisible stand-ins (invis_amulet1-5) held the gem
// slots of its interface's inv rows; 2011's interface has none.

[gold_amulet]
desc=It needs a string so I can wear it.
param=crafting_jewelry_struct,unstrung_gold_amulet

