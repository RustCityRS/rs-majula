// 289's flax and wool (skill_crafting/configs/spinning/spinning.obj): their
// examine (moved here from general/configs/examine.obj) and 289's server key
// on 2011's objs.

[flax]
desc=I should use this with a spinning wheel.
param=crafting_spinning_struct,flax

[wool]
desc=This probably came from a sheep. You can spin it into a ball of wool at a spinning wheel.
param=crafting_spinning_struct,wool

// 2011's black wool, for Sheep Shearer (moved here from examine.obj).
[black_wool]
tradeable=no
desc=This probably came from a black sheep. You can spin it into a ball of black wool at a spinning wheel.
param=crafting_spinning_struct,black_wool
