// 126
[clientscript,friend_op](int $int0, string $string0, int $int1)
if (%has_displayname_client = false) {
    return;
}
def_string $string1 = removetags($string0);
switch_int ($int0) {
    case 1 :
        ~meslayer_mode6($string1);
    case 2 :
        if (friend_platform($int1) = 1) {
            ~quickchat_open(1, $string1);
        } else {
            ~quickchat_open(3, $string1);
        }
    case 3, 4 :
        mes("That player is currently offline.");
    case 5 :
        friend_del($string1);
}
