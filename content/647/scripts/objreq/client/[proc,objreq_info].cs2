    if_setobject_nonum(obj_info:buy_graphic, null, -1);
    if_sethide(obj_info:buy, true);
    if_setsize(obj_info:content, 16384, 187, ^setsize_rel, ^setsize_abs);
    if (%varplayer_1109 ! null & calc(%varplayer_1111 * %varplayer_1110) > $int0) {
        if_setcolour(obj_info:player_has, ^red);
