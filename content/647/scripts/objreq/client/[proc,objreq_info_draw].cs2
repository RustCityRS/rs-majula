// 920
[proc,objreq_info_draw](int $int0)(int)
%objreq_lines = 0;
def_string $string0 = "";
def_int $int1 = 0;
if (%objreq_obj ! null) {
    if (compare(oc_iop(%objreq_obj, 2), "Wear") = 0 | compare(oc_iop(%objreq_obj, 2), "Wield") = 0) {
        $int1 = 1;
    }
    if_setobject_nonum(obj_info:obj_graphic, %objreq_obj, -1);
    if_setobject_nonum(obj_info:obj_name, %objreq_obj, -1);
    if (map_members = false & oc_members(%objreq_obj) = 1) {
        ~objreq_print_warn("This is a members item. Additional information is not available on this world.", ^settextalign_centre, $int0);
    } else {
        $string0 = ~obj_warning;
        if (compare($string0, "") ! 0) {
            ~objreq_print_warn($string0, ^settextalign_centre, $int0);
            %objreq_lines = calc(%objreq_lines + 1);
        }
        ~objreq_print_single(%objreq_desc, ^settextalign_centre, $int0);
        if (compare(oc_param(%objreq_obj, param_690), "") ! 0) {
            ~objreq_print_single(" ", ^settextalign_centre, $int0);
            ~objreq_print_single(oc_param(%objreq_obj, param_690), ^settextalign_centre, $int0);
        }
        if (calc(oc_param(%objreq_obj, param_740) % 2) = 1) {
            if (compare(%objreq_wearable, "") ! 0 & $int1 = 1) {
                ~objreq_print_single(%objreq_wearable, ^settextalign_left, $int0);
            }
            if (compare(%objreq_useable, "") ! 0) {
                ~objreq_print_single(%objreq_useable, ^settextalign_left, $int0);
            }
        } else {
            if (compare(%objreq_useable, "") ! 0) {
                ~objreq_print_single(%objreq_useable, ^settextalign_left, $int0);
            }
            if (compare(%objreq_wearable, "") ! 0 & $int1 = 1) {
                ~objreq_print_single(%objreq_wearable, ^settextalign_left, $int0);
            }
        }
        $string0 = ~script912(%objreq_obj);
        if (compare($string0, "") ! 0) {
            ~objreq_print_single($string0, ^settextalign_left, $int0);
        }
        if (compare(%objreq_bonus_left, "") ! 0 & $int1 = 1) {
            ~objreq_print_triple(%objreq_bonus_left, %objreq_bonus_mid, %objreq_bonus_right, $int0);
        }
    }
} else {
    ~objreq_print_single("Select an item to see its information.", ^settextalign_centre, $int0);
}
return(calc(6 * 2 + %objreq_lines * 11));
