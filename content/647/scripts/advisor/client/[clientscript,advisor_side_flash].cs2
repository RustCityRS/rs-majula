// 1359
[clientscript,advisor_side_flash](component $component0)
if (%advisor_flash_cc = %advisor_tutorial_id & %advisor_flash_cc ! 0) {
    if ($component0 = magic:sb0 | $component0 = magic:sb49) {
        if (%advisor_flash_cc = 28) {
            if_setontimer(magic:sb49, "advisor_flash_icon($component0)");
        } else {
            if_setontimer(magic:sb0, "advisor_flash_icon($component0)");
        }
    } else {
        if_setontimer($component0, "advisor_flash_icon($component0)");
    }
} else {
    if_setontimer($component0, null);
}
