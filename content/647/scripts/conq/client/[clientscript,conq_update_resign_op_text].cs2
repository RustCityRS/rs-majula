// 425
[clientscript,conq_update_resign_op_text]
if (%conq_take_victory_op = 1) {
    if_setop(conq_side_diplomacy:resign_text, 1, "Accept Victory");
    if_settext(conq_side_diplomacy:resign_text, "Accept Victory");
    if_settext(conq_side_diplomacy:resign_instructions, "Your opponent has logged out. You may end the Conquest now and be declared the winner.");
} else {
    if_setop(conq_side_diplomacy:resign_text, 1, "Resign");
    if_settext(conq_side_diplomacy:resign_text, "Resign");
    if_settext(conq_side_diplomacy:resign_instructions, "If you resign, the Conquest will end immediately.");
    if_close;
}
