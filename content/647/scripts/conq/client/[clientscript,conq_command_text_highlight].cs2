// 430
[clientscript,conq_command_text_highlight](component $component0, int $int1)
def_int $int2 = 0;
def_int $rgb3 = ^black;
def_int $int4 = 0;
def_component $component5 = null;
def_int $int6 = 0;
switch_component ($component0) {
    case default :
        return;
    case conq_side_command:ability_layer_1 :
        if (%conq_in_tutorial = 1) {
            $int2 = 1;
        } else {
            $int2 = %conq_command_ability_1;
        }
        $component5 = conq_side_command:name_1;
    case conq_side_command:ability_layer_2 :
        if (%conq_in_tutorial = 1) {
            $int2 = 3;
        } else {
            $int2 = %conq_command_ability_2;
        }
        $component5 = conq_side_command:name_2;
    case conq_side_command:ability_layer_3 :
        if (%conq_in_tutorial = 1) {
            $int2 = 5;
        } else {
            $int2 = %conq_command_ability_3;
        }
        $component5 = conq_side_command:name_3;
    case conq_side_command:ability_layer_4 :
        if (%conq_in_tutorial = 1) {
            $int2 = 6;
        } else {
            $int2 = %conq_command_ability_4;
        }
        $component5 = conq_side_command:name_4;
}
switch_int ($int2) {
    case default :
        return;
    case 1 :
        $int4 = %conq_cooldown_battle_cry;
        $int6 = struct_param(struct_293, param_1154);
    case 2 :
        $int4 = %conq_cooldown_stoicism;
        $int6 = struct_param(struct_299, param_1154);
    case 3 :
        $int4 = %conq_cooldown_regenerate;
        $int6 = struct_param(struct_300, param_1154);
    case 4 :
        $int4 = %conq_cooldown_barrage;
        $int6 = struct_param(struct_301, param_1154);
    case 5 :
        $int4 = %conq_cooldown_bloodlust;
        $int6 = struct_param(struct_305, param_1154);
    case 6 :
        $int4 = %conq_cooldown_chastise;
        $int6 = struct_param(struct_1044, param_1154);
    case 7 :
        $int4 = %conq_cooldown_vigilance;
        $int6 = struct_param(struct_1045, param_1154);
    case 8 :
        $int4 = %conq_cooldown_shield_wall;
        $int6 = struct_param(struct_1046, param_1154);
    case 9 :
        $int4 = %conq_cooldown_winds_of_change;
        $int6 = struct_param(struct_1047, param_1154);
}
if ($int4 = 0 & %conq_command_points >= $int6) {
    if ($int1 = 1) {
        $rgb3 = ^white;
    } else {
        $rgb3 = 0xff981f;
    }
    if_setcolour($component5, $rgb3);
}
