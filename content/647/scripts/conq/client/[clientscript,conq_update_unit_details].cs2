// 497
[clientscript,conq_update_unit_details]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_string $string0 = "";
def_string $string1 = "";
def_string $string2 = "";
def_string $string3 = "";
if (%conq_unit_details_type ! null) {
    $int0 = nc_param(%conq_unit_details_type, param_1134);
    if (%conq_unit_details_movement > $int0) {
        $string0 = "Movement: <col=00c800><tostring(%conq_unit_details_movement)><col=ff981f>/<tostring($int0)>";
    } else if (%conq_unit_details_movement < $int0) {
        $string0 = "Movement: <col=c80000><tostring(%conq_unit_details_movement)><col=ff981f>/<tostring($int0)>";
    } else {
        $string0 = "Movement: <tostring(%conq_unit_details_movement)>/<tostring($int0)>";
    }
    $int1 = nc_param(%conq_unit_details_type, param_1135);
    if (%conq_unit_details_damage > $int1) {
        $string1 = "Damage: <col=00c800><tostring(calc(%conq_unit_details_damage * 100))><col=ff981f>/<tostring(calc($int1 * 100))>";
    } else if (%conq_unit_details_damage < $int1) {
        $string1 = "Damage: <col=c80000><tostring(calc(%conq_unit_details_damage * 100))><col=ff981f>/<tostring(calc($int1 * 100))>";
    } else {
        $string1 = "Damage: <tostring(calc(%conq_unit_details_damage * 100))>/<tostring(calc($int1 * 100))>";
    }
    $int2 = nc_param(%conq_unit_details_type, param_1136);
    if (%conq_unit_details_health > $int2) {
        $string2 = "Health: <col=00c800><tostring(calc(%conq_unit_details_health * 100))><col=ff981f>/<tostring(calc($int2 * 100))>";
    } else if (%conq_unit_details_health < $int2) {
        $string2 = "Health: <col=c80000><tostring(calc(%conq_unit_details_health * 100))><col=ff981f>/<tostring(calc($int2 * 100))>";
    } else {
        $string2 = "Health: <tostring(calc(%conq_unit_details_health * 100))>/<tostring(calc($int2 * 100))>";
    }
    $int3 = nc_param(%conq_unit_details_type, param_1137);
    if (%conq_unit_details_range > $int3) {
        $string3 = "Range: <col=00c800><tostring(%conq_unit_details_range)><col=ff981f>/<tostring($int3)>";
    } else if (%conq_unit_details_range < $int3) {
        $string3 = "Range: <col=c80000><tostring(%conq_unit_details_range)><col=ff981f>/<tostring($int3)>";
    } else {
        $string3 = "Range: <tostring(%conq_unit_details_range)>/<tostring($int3)>";
    }
    if_settext(conq_side_unit_details:unit_movement_text, $string0);
    if_settext(conq_side_unit_details:unit_damage_text, $string1);
    if_settext(conq_side_unit_details:unit_health_text, $string2);
    if_settext(conq_side_unit_details:unit_range_text, $string3);
}
