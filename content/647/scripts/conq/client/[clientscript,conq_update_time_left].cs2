// 407
[clientscript,conq_update_time_left]
if (%conq_turn_time_remaining < 1) {
    return;
}
def_int $int0 = calc(%conq_turn_time_remaining * 6 / 10);
def_int $int1 = 0;
def_int $int2 = 0;
def_string $string0 = "";
if ($int0 < 60) {
    $int1 = $int0;
} else {
    $int1 = calc($int0 % 60);
    $int2 = calc($int0 / 60);
}
if ($int1 < 10) {
    $string0 = append("0", tostring($int1));
    if ($int2 = 0 & %conq_played_low_time_warning = 0) {
        %conq_played_low_time_warning = 1;
        if (%conq_is_active_player = 1) {
            sound_vorbis_volume(vorbis_3434, 1, 0, 255);
        }
    }
} else {
    $string0 = tostring($int1);
}
if_settext(conq_side_turn:time_left_text, "Turn Time Left<br><tostring($int2)>:<$string0>");
if_settext(conq_scroll_overlay:time_left_text, "<tostring($int2)>:<$string0>");
