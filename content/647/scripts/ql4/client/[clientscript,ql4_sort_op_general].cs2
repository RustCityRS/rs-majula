// 943
[clientscript,ql4_sort_op_general](int $int0, int $int1, int $int2, int $rgb3)
def_enum $enum4 = struct_param(enum(int, struct, enum_169, $int0), param_782);
if (map_members = false) {
    mes("More advanced grouping options are available on a members' world.");
} else if (%tutorial < 1000) {
    mes("More advanced grouping options will be available when you've finished the Tutorial.");
} else {
    if (%ql4_sort_mode = $int1) {
        %ql4_reverse_list = calc((1 + %ql4_reverse_list) % 2);
    } else {
        %ql4_sort_mode = $int1;
        %ql4_reverse_list = 0;
    }
    ~ql4_sort($int0, %ql4_sort_mode, %ql4_reverse_list, %ql4_filter_doable, %ql4_filter_done);
    ~dropdownbox_close(questlist_v4:com_16, questlist_v4:com_14, questlist_v4:com_15, null, 1);
    if (cc_find(questlist_v4:com_16, 2) = true) {
        cc_settext(enum(int, string, $enum4, $int1));
        cc_setcolour($rgb3);
        cc_setonmouseleave("dropdownbox_mouseoutelement(questlist_v4:com_16, 2, $rgb3)");
    }
}
