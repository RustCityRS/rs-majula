// 769
[clientscript,lore_pouch_counter]
def_obj $obj0 = enum(obj, obj, enum_1283, %follower_obj);
if ($obj0 = bones) {
    if_settext(lore_stats_side:lore_pouch_counter, "0");
    return;
}
def_int $int1 = inv_total(inv, $obj0);
if ($int1 > 0) {
    if ($int1 > 1000000) {
        $int1 = calc($int1 / 1000000);
        if_settext(lore_stats_side:lore_pouch_counter, "<tostring($int1)>M");
        return;
    } else if ($int1 > 1000) {
        $int1 = calc($int1 / 1000);
        if_settext(lore_stats_side:lore_pouch_counter, "<tostring($int1)>K");
        return;
    } else {
        if_settext(lore_stats_side:lore_pouch_counter, tostring(inv_total(inv, $obj0)));
        return;
    }
} else {
    if_settext(lore_stats_side:lore_pouch_counter, "0");
    return;
}
return;
