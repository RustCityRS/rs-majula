// 771
[proc,lore_itemcount](obj $obj0)(int)
switch_obj ($obj0) {
    case village_snake_hide :
        return(calc(inv_total(inv, village_snake_hide) + inv_total(inv, templetrek_swamp_snake_hide)));
    case enakh_granite_tiny :
        return(calc(inv_total(inv, enakh_granite_tiny) + inv_total(inv, enakh_granite_small) + inv_total(inv, enakh_granite_medium)));
    case flowers_waterfall_quest_red :
        return(calc(inv_total(inv, flowers_waterfall_quest_red) + inv_total(inv, flowers_waterfall_quest) + inv_total(inv, flowers_waterfall_quest_blue) + inv_total(inv, flowers_waterfall_quest_yellow) + inv_total(inv, flowers_waterfall_quest_purple) + inv_total(inv, flowers_waterfall_quest_orange) + inv_total(inv, flowers_waterfall_quest_mixed)));
    case default :
        return(~inv_total_available(inv, $obj0));
}
