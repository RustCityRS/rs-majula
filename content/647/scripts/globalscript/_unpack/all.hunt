// 3
[battle_mage_hunt]
type=player
check_vis=lineofsight
check_nottoostrong=off
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
extracheck_var=%magearena,>5
check_notbusy=off
find_keephunting=off
find_newmode=applayer2

// 4
[king_dragon]
type=player
check_vis=lineofsight
check_nottoostrong=off
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
check_notbusy=off
check_afk=off
find_keephunting=on
find_newmode=applayer2

// 289's general/configs/duckling.hunt: a duckling follows a duck. 289's
// duck_female (its npc 45; 2011's 45 is a banker) is 786's 2693, "Duck",
// by the name bridge, as its duckling (46) is 2694.
// in osrs, ducklings always hunt 11 ticks after respawn
// 5
[duck_hunt]
type=npc
check_npc=duck_female
check_vis=lineofsight
find_keephunting=off
rate=11
find_newmode=opnpc3

// 6
[gnomeball_tackler]
type=player
check_vis=lineofsight
check_afk=off
check_inv=worn,gnomeball,>0
check_notcombat_self=%npc_lastcombat
rate=1
find_newmode=opplayer2

// 7
[shades]
type=player
check_vis=off
check_nottoostrong=outside_wilderness
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
check_notbusy=off
extracheck_var=%morttonmulti,&16
find_keephunting=off
find_newmode=opplayer2

// 8
[chompybird]
type=npc
check_npc=bloated_toad
check_vis=lineofsight
check_afk=off
find_keephunting=on
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
// confirm rate
rate=3
find_newmode=queue4

