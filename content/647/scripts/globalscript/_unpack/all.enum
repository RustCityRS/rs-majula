outputtype=string
val=0,Memorial plaque
val=1,Flag
val=2,Small gravestone
val=3,Ornate gravestone
val=4,Font of Life
val=5,Stele
val=6,Symbol of Saradomin
val=7,Symbol of Zamorak
val=8,Symbol of Guthix
val=9,Symbol of Bandos
val=10,Symbol of Armadyl
val=11,Ancient symbol
val=12,Angel of Death
