param=param_1271,"task_tutorial_icons2,6"
param=param_1293,63
param=param_1268,3514
param=param_1267,60
param=param_1274,The ladder in the starting room is gone, but you may be able to use the ladder in the cellar of the connected house, if you can reach it.
param=param_1275,You'll need to exploit a weak spot in the wall between the two cellars in order to make further progress.
param=param_1276,Talk to Roddeck, the man who just came out of the cupboard, to seek his input.
param=param_1284,0_99_99_0_42
param=param_1269,3515
param=param_1290,1

// 1719
[struct_1719]
param=param_1266,Cutting a Path
param=param_1273,Use a woodcutting hatchet to clear the roots blocking the right-hand path out of the cellar.<br><br>You now have two Tasks: click on the Back button above or the Task System icon to view both, then on one of the icons displayed to find out more.
param=param_1292,Completing this Task will help you escape from the cellar in which you find yourself.
param=param_1271,"task_tutorial_icons2,7"
param=param_1293,63
param=param_1268,3515
param=param_1267,60
param=param_1322,1
param=param_1274,The exit route you have chosen is blocked by thick roots. In order to clear them, you will need a hatchet; simply click on them to attempt to cut through.
param=param_1282,0_99_99_0_43
param=param_1269,3516
param=param_1290,1

// 1720
[struct_1720]
param=param_1266,Breaking Through
