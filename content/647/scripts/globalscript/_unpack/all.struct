param=param_1290,1

// 1706
[struct_1706]
param=param_1266,Equip Yourself
param=param_1273,Wield the bronze armour and weapon you have acquired.<br><br>For more information on this Task, click on the Hints tab above.
param=param_1292,Completing this Task will help you escape from the cellar in which you find yourself.
param=param_1271,"task_tutorial_icons1,10"
param=param_1293,63
param=param_1268,3503
param=param_1267,60
param=param_1274,To wear an object, right-click on it in your inventory and choose 'Wear' or 'Wield'.
param=param_1275,Most weapons and armour can be equipped by simply left-clicking on them in your inventory.
param=param_1276,You can see what you are currently wearing, and what effect it has on your character, via the Worn Equipment tab on the side bar.
param=param_1269,3504
param=param_1290,1

// 1707
[struct_1707]
param=param_1266,Kill the Goblin
param=param_1273,Engage and kill the goblin currently looting Sir Vant's supplies.<br><br>For more information on this Task, click on the Hints tab above.
param=param_1292,Completing this Task will help you escape from the cellar in which you find yourself.
param=param_1271,"task_tutorial_icons2,5"
param=param_1293,63
param=param_1268,3504
param=param_1267,60
param=param_1274,You must have gathered and equipped all three pieces of the squire's gear to engage this goblin.
param=param_1275,Right-click on the goblin and choose 'Attack' to begin combat. You may also left-click the enemy to attack it.
param=param_1276,Once combat begins, you will continue to attack your opponent until one of you dies or flees.
param=param_1277,This goblin poses little threat, but other enemies will be considerably tougher. You can get a rough estimate of an enemy's strength by looking at the level displayed next to their name when you right-click on them.
param=param_1269,3505
param=param_1290,1

