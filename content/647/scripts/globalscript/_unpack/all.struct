param=param_1271,"task_tutorial_icons2,4"
param=param_1293,63
param=param_1268,3510
param=param_1267,60
param=param_1274,Explore the cellar until you find the food bowl.
param=param_1275,Use the food on the bowl to aid Sir Vant with his plan (make sure to right-click and select 'Use').
param=param_1269,3511
param=param_1290,1

// 1715
[struct_1715]
param=param_1266,Talk to Sir Vant Again
param=param_1273,Sir Vant has joined you by the pillars. Talk to him to discover the next step of the plan.
param=param_1292,Completing this Task will help you escape from the cellar in which you find yourself.
param=param_1271,"task_tutorial_icons1,3"
param=param_1293,63
param=param_1268,3511
param=param_1267,60
param=param_1274,Sir Vant has moved; you can now find him by the wooden pillar just south-east of the dragon's nest.
param=param_1269,3512
param=param_1290,1

// 1716
[struct_1716]
param=param_1266,Sabotage!
param=param_1273,Set Sir Vant's trap by tying an oily rag around each pillar and adding a fuse.<br><br>Once you have done this, give Sir Vant a tinderbox and light the fuse on the right.<br><br>For more information on this Task, click on the Hints tab above.
param=param_1292,Completing this Task will help you escape from the cellar in which you find yourself.
param=param_1271,"task_tutorial_icons1,4"
param=param_1293,63
param=param_1268,3512
param=param_1267,60
param=param_1274,To rip the cloth into strips, simply left-click on it in your inventory.
param=param_1275,Use each cloth on the oil can to soak it in oil, then on a pillar to set in place.
param=param_1283,0_99_99_0_40
param=param_1276,Once the cloth is in place, use the fuse on it to ready the trap.
param=param_1277,You can then give a tinderbox to Sir Vant by clicking on it in your inventory and using it on him.
param=param_1285,0_99_99_0_41
param=param_1278,Once all is ready, use the tinderbox on the pillar to light the fuse, then run for cover!
param=param_1269,3513
param=param_1290,1

// 1717
[struct_1717]
param=param_1266,Return the Squire's Gear
