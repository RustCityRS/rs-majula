param=param_1271,"task_tutorial_icons1,8"
param=param_1293,63
param=param_1268,3513
param=param_1267,60
param=param_1274,Take off your armour and weapons by opening the worn equipment tab and clicking on them.
param=param_1282,0_99_99_0_2
