if_sethide(book_small:pic22, true);
if_settext(book_small:book_title, $title);
~book_page_numbers;
if_openmain(book_small);

// its written this way to perserve order that osrs sends them
[proc,book_page_obj](string $title, component $obj_com, namedobj $obj, int $zoom, int $page)
if_settext(book_small:line1a, split_get($page, 0));
