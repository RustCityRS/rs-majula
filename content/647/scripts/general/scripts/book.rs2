if_settext(book_small:line1d, split_get($page, 3));
if_sethide(book_small:pic4, true);
if_settext(book_small:line1e, split_get($page, 4));
if_sethide(book_small:pic5, true);
if_settext(book_small:line1f, split_get($page, 5));
if_sethide(book_small:pic6, true);
if_settext(book_small:line1g, split_get($page, 6));
if_sethide(book_small:pic7, true);
if_settext(book_small:line1h, split_get($page, 7));
if_sethide(book_small:pic8, true);
