if_settext(book_small:line1k, split_get($page, 10));
if_sethide(book_small:pic11, true);
if_settext(book_small:line1l, split_get($page, 11));
if_sethide(book_small:pic12, true);
if_settext(book_small:line1m, split_get($page, 12));
if_sethide(book_small:pic13, true);
if_settext(book_small:line1n, split_get($page, 13));
if_sethide(book_small:pic14, true);
if_settext(book_small:line31, split_get($page, 14));
if_sethide(book_small:pic15, true);
if_settext(book_small:line32, split_get($page, 15));
if_sethide(book_small:pic16, true);
if_settext(book_small:line33, split_get($page, 16));
if_sethide(book_small:pic17, true);
if_settext(book_small:line34, split_get($page, 17));
if_sethide(book_small:pic18, true);
if_settext(book_small:line35, split_get($page, 18));
if_sethide(book_small:pic19, true);
if_settext(book_small:line36, split_get($page, 19));
