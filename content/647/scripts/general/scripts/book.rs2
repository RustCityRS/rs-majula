if_settext(book_small:book_title, $title);
~book_page_numbers;
if_openmain(book_small);

[label,book_flip_page](int $page_direction, int $min_page, int $max_page, proc $proc)
%book_page = add(%book_page, $page_direction);
if (%book_page > $max_page) {
    %book_page = $max_page;
} else if (%book_page < $min_page) {
    %book_page = $min_page;
}

if (%book_page = $min_page) {
    if_sethide(book_small:left_arrow, true);
} else {
    if_sethide(book_small:left_arrow, false);
}

if (%book_page = $max_page) {
    if_sethide(book_small:right_arrow, true);
} else {
    if_sethide(book_small:right_arrow, false);
}

gosub($proc);
// 2011's arrows are pause buttons (cache 786, book com28 "Back" and com29
// "Next": active_properties=1, which the client answers with
// RESUME_PAUSEBUTTON), where 289's were if_buttons (com_84 and com_86, above)
// that found the book again from %open_book. So the book waits on its page
// for one, and turns from here with the same proc and pages.
p_pausebutton;
switch_component (last_com) {
    case book_small:left_arrow : @book_flip_page(^book_direction_backward, $min_page, $max_page, $proc);
    case book_small:right_arrow : @book_flip_page(^book_direction_forward, $min_page, $max_page, $proc);
}
