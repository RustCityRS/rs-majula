[proc,book](string $title, string $string)
split_init($string, 175, 22, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~book_page($title, $page);
    $page = calc($page + 1);
}

[proc,book_obj](string $title, component $obj_com, namedobj $obj, int $zoom, string $string)
split_init($string, 175, 22, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~book_page_obj($title, $obj_com, $obj, $zoom, $page);
    $page = calc($page + 1);
}

[proc,book_doubleobj](string $title, component $obj_com1, namedobj $obj1, int $zoom1, component $obj_com2, namedobj $obj2, int $zoom2, string $string)
split_init($string, 175, 22, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~book_page_doubleobj($title, $obj_com1, $obj1, $zoom1, $obj_com2, $obj2, $zoom2, $page);
    $page = calc($page + 1);
}

[proc,book_page](string $title, int $page)
if_settext(book_small:line1a, split_get($page, 0));
if_sethide(book_small:pic1, true);
