// Seems to be 20-40 ticks

// 289's sheared sheep, npc 42, is 2011's `sheep`.
[ai_timer,sheep] @sheep_baa;

[ai_timer,sheepunsheered] @sheep_baa;

// 2011's other sheep, shorn and unshorn (cache 786 names each "Sheep";
