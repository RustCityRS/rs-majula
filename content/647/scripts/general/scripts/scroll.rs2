[label,scroll_zombiequeen_yellow]
if_settext(messagescroll:messcroll1, ^string_empty);
if_settext(messagescroll:messcroll2, ^string_empty);
if_settext(messagescroll:messcroll3, ^string_empty);
if_settext(messagescroll:messcroll4, "...and rest like your mother who is silent in the");
if_settext(messagescroll:messcroll5, "peace of her tomb far to the North of Ah Za");
if_settext(messagescroll:messcroll6, "Rhoon. Near the sea, and under the hills deep in");
if_settext(messagescroll:messcroll7, "the underground to watch all of nature from the");
if_settext(messagescroll:messcroll8, "darkness of her final resting place.");
if_settext(messagescroll:messcroll9, ^string_empty);
if_settext(messagescroll:messcroll10, ^string_empty);
if_settext(messagescroll:messcroll11, ^string_empty);
