// 289's scroll (general/scripts/scroll.rs2) on 2011's messagescroll (220;
// cache 786: fifteen text lines com1-15, 375 wide in p12_full, yellow, and a
// Close button com16), which void-634 opens for the same reads (its
// message_scroll, as Alfred Grimhand's barcrawl card). 289's scroll has twelve
// lines, com_2-13: they are 2011's com1-12, and 2011's last three are blanked
// when it opens, as void-634's messageScroll sets every line.

[proc,messagescroll_open]
if_settext(messagescroll:messcroll13, ^string_empty);
if_settext(messagescroll:messcroll14, ^string_empty);
if_settext(messagescroll:messcroll15, ^string_empty);
if_openmain(messagescroll);

[label,scroll_pirate_message]
if_settext(messagescroll:messcroll1, ^string_empty);
if_settext(messagescroll:messcroll2, ^string_empty);
if_settext(messagescroll:messcroll3, ^string_empty);
if_settext(messagescroll:messcroll4, "Visit the city of the White Knights. In the park,");
if_settext(messagescroll:messcroll5, "Saradomin points to the X which marks the spot.");
if_settext(messagescroll:messcroll6, ^string_empty);
if_settext(messagescroll:messcroll7, ^string_empty);
if_settext(messagescroll:messcroll8, ^string_empty);
if_settext(messagescroll:messcroll9, ^string_empty);
if_settext(messagescroll:messcroll10, ^string_empty);
if_settext(messagescroll:messcroll11, ^string_empty);
if_settext(messagescroll:messcroll12, ^string_empty);
if_setcolour(messagescroll:messcroll1, ^yellow_rgb);
if_setcolour(messagescroll:messcroll2, ^yellow_rgb);
if_setcolour(messagescroll:messcroll3, ^yellow_rgb);
if_setcolour(messagescroll:messcroll4, ^yellow_rgb);
if_setcolour(messagescroll:messcroll5, ^yellow_rgb);
if_setcolour(messagescroll:messcroll6, ^yellow_rgb);
if_setcolour(messagescroll:messcroll7, ^yellow_rgb);
