if_setcolour(messagescroll:messcroll9, ^yellow_rgb);
if_setcolour(messagescroll:messcroll10, ^yellow_rgb);
if_setcolour(messagescroll:messcroll11, ^yellow_rgb);
if_setcolour(messagescroll:messcroll12, ^yellow_rgb);
~messagescroll_open;

[label,scroll_elena_hangover_cure_recipe]
// Get a bucket of milk.
// Then grind some chocolate with a pestle and mortar.
// Add the ground chocolate to the milk.
// Finally add some snape grass.
if_settext(messagescroll:messcroll1, ^string_empty);
if_settext(messagescroll:messcroll2, ^string_empty);
if_settext(messagescroll:messcroll3, ^string_empty);
if_settext(messagescroll:messcroll4, ^string_empty);
if_settext(messagescroll:messcroll5, "Got a bncket of nnilk");
if_settext(messagescroll:messcroll6, "Tlen qrind sorne lcoculate");
if_settext(messagescroll:messcroll7, "vnith a pestal and rnortar");
if_settext(messagescroll:messcroll8, "ald the grourd dlocolate to tho milt");
if_settext(messagescroll:messcroll9, "fnales add 5cme snape gras5");
if_settext(messagescroll:messcroll10, ^string_empty);
if_settext(messagescroll:messcroll11, ^string_empty);
if_settext(messagescroll:messcroll12, ^string_empty);
if_setcolour(messagescroll:messcroll1, ^yellow_rgb);
if_setcolour(messagescroll:messcroll2, ^yellow_rgb);
if_setcolour(messagescroll:messcroll3, ^yellow_rgb);
if_setcolour(messagescroll:messcroll4, ^yellow_rgb);
if_setcolour(messagescroll:messcroll5, ^black_rgb);
if_setcolour(messagescroll:messcroll6, ^black_rgb);
if_setcolour(messagescroll:messcroll7, ^black_rgb);
if_setcolour(messagescroll:messcroll8, ^black_rgb);
if_setcolour(messagescroll:messcroll9, ^black_rgb);
if_setcolour(messagescroll:messcroll10, ^yellow_rgb);
if_setcolour(messagescroll:messcroll11, ^yellow_rgb);
if_setcolour(messagescroll:messcroll12, ^yellow_rgb);
~messagescroll_open;

// 289's barcrawl card, on %barcrawl's bits (quests/quest_barcrawl).
[label,scroll_barcrawl_card]
if_settext(messagescroll:messcroll1, "@blu@The Official Alfred Grimhand Barcrawl!");
if_settext(messagescroll:messcroll2, ^string_empty);
if(testbit(%barcrawl, ^bluemoon_index) = ^true) {
    if_settext(messagescroll:messcroll3, "@gre@BlueMoon Inn - Completed!");
} else {
    if_settext(messagescroll:messcroll3, "@red@BlueMoon Inn - Not Completed...");
}

if(testbit(%barcrawl, ^blurberry_index) = ^true) {
    if_settext(messagescroll:messcroll4, "@gre@Blurberry's Bar - Completed!");
} else {
    if_settext(messagescroll:messcroll4, "@red@Blurberry's Bar - Not Completed...");
}

if(testbit(%barcrawl, ^deadman_index) = ^true) {
