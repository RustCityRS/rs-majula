[label,scroll_invasion_plans]
// https://web.archive.org/web/20060911005925im_/http://www.runeweb.net/fireball/Grand%20Tree%20Images/GrandTree12.PNG
if_settext(messagescroll:messcroll1, "@red@Invasion");
if_settext(messagescroll:messcroll2, ^string_empty);
if_settext(messagescroll:messcroll3, "Troops board three fleets of battleships at Karamja.");
if_settext(messagescroll:messcroll4, "@gre@Fleet one");
if_settext(messagescroll:messcroll5, "Attacks Misthalin from the south.");
if_settext(messagescroll:messcroll6, "@gre@Fleet two");
if_settext(messagescroll:messcroll7, "Groups at crandor and attacks Asgarnia from the west.");
if_settext(messagescroll:messcroll8, "@gre@Fleet three");
if_settext(messagescroll:messcroll9, "Sails north to attack Kandarin from south, reinforced");
if_settext(messagescroll:messcroll10, "by gnome foot soldiers leaving gnome stronghold.");
if_settext(messagescroll:messcroll11, ^string_empty);
if_settext(messagescroll:messcroll12, "@red@Take no prisoners!");
if_setcolour(messagescroll:messcroll1, ^yellow_rgb);
if_setcolour(messagescroll:messcroll2, ^yellow_rgb);
if_setcolour(messagescroll:messcroll3, ^yellow_rgb);
if_setcolour(messagescroll:messcroll4, ^yellow_rgb);
if_setcolour(messagescroll:messcroll5, ^yellow_rgb);
if_setcolour(messagescroll:messcroll6, ^yellow_rgb);
if_setcolour(messagescroll:messcroll7, ^yellow_rgb);
if_setcolour(messagescroll:messcroll8, ^yellow_rgb);
if_setcolour(messagescroll:messcroll9, ^yellow_rgb);
if_setcolour(messagescroll:messcroll10, ^yellow_rgb);
if_setcolour(messagescroll:messcroll11, ^yellow_rgb);
if_setcolour(messagescroll:messcroll12, ^yellow_rgb);
~messagescroll_open;

[label,upass_well_inscription]
// https://web.archive.org/web/20060908030821im_/http://www.runeweb.net/fireball/Underground%20Pass%20Images/Underground12.PNG
if_settext(messagescroll:messcroll1, ^string_empty);
if_settext(messagescroll:messcroll2, "While I sense the beating of a");
if_settext(messagescroll:messcroll3, "good heart I will not open.");
if_settext(messagescroll:messcroll4, "Feed me three crests of the blessed");
if_settext(messagescroll:messcroll5, "and the creature's remains,");
if_settext(messagescroll:messcroll6, "throw them to me as an offering...");
if_settext(messagescroll:messcroll7, "a gift of hatred, a token.");
if_settext(messagescroll:messcroll8, "Then finally rejoice as all goodness");
if_settext(messagescroll:messcroll9, "dies in my flames.....");
if_settext(messagescroll:messcroll10, ^string_empty);
if_settext(messagescroll:messcroll11, ^string_empty);
if_settext(messagescroll:messcroll12, ^string_empty);
if_setcolour(messagescroll:messcroll1, ^yellow_rgb);
if_setcolour(messagescroll:messcroll2, ^yellow_rgb);
if_setcolour(messagescroll:messcroll3, ^yellow_rgb);
if_setcolour(messagescroll:messcroll4, ^yellow_rgb);
if_setcolour(messagescroll:messcroll5, ^yellow_rgb);
if_setcolour(messagescroll:messcroll6, ^yellow_rgb);
if_setcolour(messagescroll:messcroll7, ^yellow_rgb);
if_setcolour(messagescroll:messcroll8, ^yellow_rgb);
if_setcolour(messagescroll:messcroll9, ^yellow_rgb);
if_setcolour(messagescroll:messcroll10, ^yellow_rgb);
if_setcolour(messagescroll:messcroll11, ^yellow_rgb);
if_setcolour(messagescroll:messcroll12, ^yellow_rgb);
~messagescroll_open;

[label,scroll_zombiequeen_tattered]
if_settext(messagescroll:messcroll1, ^string_empty);
if_settext(messagescroll:messcroll2, "Bervirius, son of King Danthalas, was killed in battle. His");
if_settext(messagescroll:messcroll3, "devout Mother Rashiliyia was so heartbroken that she swore");
if_settext(messagescroll:messcroll4, "fealty to Zamorak if he would return her son to her. Bervirius");
if_settext(messagescroll:messcroll5, "returned as an undead creature and terrorized the King and");
if_settext(messagescroll:messcroll6, "Queen. Many guards died fighting the Undead Bervirius.");
if_settext(messagescroll:messcroll7, "Eventually the undead Bervirius was set on fire and soon only");
if_settext(messagescroll:messcroll8, "the bones remained.His remains were taken far to the South,");
if_settext(messagescroll:messcroll9, "and then towards the setting sun to a tomb that is surrounded");
if_settext(messagescroll:messcroll10, "by and level with the sea. The only remedy for containing the");
if_settext(messagescroll:messcroll11, "spirits of witches and undead.");
if_settext(messagescroll:messcroll12, ^string_empty);
if_setcolour(messagescroll:messcroll1, ^yellow_rgb);
if_setcolour(messagescroll:messcroll2, ^yellow_rgb);
if_setcolour(messagescroll:messcroll3, ^yellow_rgb);
if_setcolour(messagescroll:messcroll4, ^yellow_rgb);
if_setcolour(messagescroll:messcroll5, ^yellow_rgb);
if_setcolour(messagescroll:messcroll6, ^yellow_rgb);
if_setcolour(messagescroll:messcroll7, ^yellow_rgb);
if_setcolour(messagescroll:messcroll8, ^yellow_rgb);
if_setcolour(messagescroll:messcroll9, ^yellow_rgb);
if_setcolour(messagescroll:messcroll10, ^yellow_rgb);
if_setcolour(messagescroll:messcroll11, ^yellow_rgb);
if_setcolour(messagescroll:messcroll12, ^yellow_rgb);
~messagescroll_open;

// if 222 in osrs, can't find any equivalence in this version
// (2011's cache has a 222, messagescroll_handwriting; no source shows 2011
// reading this scroll in it.)
[label,scroll_zombiequeen_crumpled]
if_settext(messagescroll:messcroll1, ^string_empty);
if_settext(messagescroll:messcroll2, ^string_empty);
if_settext(messagescroll:messcroll3, "Rashiliyia's rage went unchecked. She killed");
if_settext(messagescroll:messcroll4, "without mercy for revenge of her son's life. Like");
if_settext(messagescroll:messcroll5, "a spectre through the night she entered houses");
if_settext(messagescroll:messcroll6, "and one by one quietly strangled life from the");
if_settext(messagescroll:messcroll7, "occupants. It is said that only a handful survived,");
if_settext(messagescroll:messcroll8, "protected by necklace wards to keep the Witch");
if_settext(messagescroll:messcroll9, "Queen at bay.");
if_settext(messagescroll:messcroll10, ^string_empty);
if_settext(messagescroll:messcroll11, ^string_empty);
if_settext(messagescroll:messcroll12, ^string_empty);
if_setcolour(messagescroll:messcroll1, ^yellow_rgb);
if_setcolour(messagescroll:messcroll2, ^yellow_rgb);
if_setcolour(messagescroll:messcroll3, ^black_rgb);
if_setcolour(messagescroll:messcroll4, ^black_rgb);
if_setcolour(messagescroll:messcroll5, ^black_rgb);
if_setcolour(messagescroll:messcroll6, ^black_rgb);
if_setcolour(messagescroll:messcroll7, ^black_rgb);
if_setcolour(messagescroll:messcroll8, ^black_rgb);
if_setcolour(messagescroll:messcroll9, ^black_rgb);
if_setcolour(messagescroll:messcroll10, ^yellow_rgb);
if_setcolour(messagescroll:messcroll11, ^yellow_rgb);
if_setcolour(messagescroll:messcroll12, ^yellow_rgb);
~messagescroll_open;

