// 289's general/configs/duckling.hunt: a duckling follows a duck. 289's
// duck_female (its npc 45; 2011's 45 is a banker) is 786's 2693, "Duck",
// by the name bridge, as its duckling (46) is 2694.
// in osrs, ducklings always hunt 11 ticks after respawn
[duck_hunt]
type=npc
check_npc=duck_female
check_vis=lineofsight
find_keephunting=off
rate=11
find_newmode=opnpc3
