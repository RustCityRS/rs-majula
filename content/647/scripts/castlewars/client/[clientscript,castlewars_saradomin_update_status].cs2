// 1367
[clientscript,castlewars_saradomin_update_status]
if_settext(castlewars_status_overlay_saradomin:zamorak_score, "Zamorak = <tostring(%castlewars_zamorak_score)>");
if_settext(castlewars_status_overlay_saradomin:saradomin_score, "<tostring(%castlewars_saradomin_score)> = Saradomin");
if_settext(castlewars_status_overlay_saradomin:time_remaining, "<tostring(%castlewars_timer)> Min");
if (%castlewars_saradomin_maindoor = 0) {
    if_settext(castlewars_status_overlay_saradomin:health, "Health: <tostring(%castlewars_saradomin_maindoor)>%");
    if_setcolour(castlewars_status_overlay_saradomin:health, ^red);
} else {
    if_settext(castlewars_status_overlay_saradomin:health, "Health <tostring(%castlewars_saradomin_maindoor)>%");
    if_setcolour(castlewars_status_overlay_saradomin:health, ^green);
}
if (%castlewars_saradomin_flag = 0) {
    if_settext(castlewars_status_overlay_saradomin:saradomin_flag, "Safe");
    if_setcolour(castlewars_status_overlay_saradomin:saradomin_flag, ^green);
} else if (%castlewars_saradomin_flag = 1) {
    if_settext(castlewars_status_overlay_saradomin:saradomin_flag, "Taken");
    if_setcolour(castlewars_status_overlay_saradomin:saradomin_flag, ^red);
} else if (%castlewars_saradomin_flag = 2) {
    if_settext(castlewars_status_overlay_saradomin:saradomin_flag, "Dropped");
    if_setcolour(castlewars_status_overlay_saradomin:saradomin_flag, ^yellow);
}
if (%castlewars_zamorak_flag = 0) {
    if_settext(castlewars_status_overlay_saradomin:zamorak_flag, "Safe");
    if_setcolour(castlewars_status_overlay_saradomin:zamorak_flag, ^green);
} else if (%castlewars_zamorak_flag = 1) {
    if_settext(castlewars_status_overlay_saradomin:zamorak_flag, "Taken");
    if_setcolour(castlewars_status_overlay_saradomin:zamorak_flag, ^red);
} else if (%castlewars_zamorak_flag = 2) {
    if_settext(castlewars_status_overlay_saradomin:zamorak_flag, "Dropped");
    if_setcolour(castlewars_status_overlay_saradomin:zamorak_flag, ^yellow);
}
if (%castlewars_saradomin_sidedoor = 1) {
    if_settext(castlewars_status_overlay_saradomin:door, "Unlocked");
    if_setcolour(castlewars_status_overlay_saradomin:door, ^red);
} else {
    if_settext(castlewars_status_overlay_saradomin:door, "Locked");
    if_setcolour(castlewars_status_overlay_saradomin:door, ^green);
}
if (%castlewars_saradomin_tunnel1 = 1) {
    if_settext(castlewars_status_overlay_saradomin:tunnel1, "Cleared");
    if_setcolour(castlewars_status_overlay_saradomin:tunnel1, ^red);
} else {
    if_settext(castlewars_status_overlay_saradomin:tunnel1, "Collapsed");
    if_setcolour(castlewars_status_overlay_saradomin:tunnel1, ^green);
}
if (%castlewars_saradomin_tunnel2 = 1) {
    if_settext(castlewars_status_overlay_saradomin:tunnel2, "Cleared");
    if_setcolour(castlewars_status_overlay_saradomin:tunnel2, ^red);
} else {
    if_settext(castlewars_status_overlay_saradomin:tunnel2, "Collapsed");
    if_setcolour(castlewars_status_overlay_saradomin:tunnel2, ^green);
}
if (%castlewars_saradomin_catapult = 1) {
    if_settext(castlewars_status_overlay_saradomin:catapult, "Destroyed");
    if_setcolour(castlewars_status_overlay_saradomin:catapult, ^red);
} else {
    if_settext(castlewars_status_overlay_saradomin:catapult, "Operational");
    if_setcolour(castlewars_status_overlay_saradomin:catapult, ^green);
}
if_setobject(castlewars_status_overlay_saradomin:sara_flag, castlewars_sara_flag_dummy, -1);
if_setobject(castlewars_status_overlay_saradomin:zam_flag, castlewars_zam_flag_dummy, -1);
if_setobject(castlewars_status_overlay_saradomin:main_door_pic, castlewars_main_door_dummy, -1);
if_setobject(castlewars_status_overlay_saradomin:side_door_pic, castlewars_side_door_dummy, -1);
if_setobject(castlewars_status_overlay_saradomin:tunnel1_pic, castlewars_tunnal1_dummy, -1);
if_setobject(castlewars_status_overlay_saradomin:tunnel2_pic, castlewars_tunnel2_dummy, -1);
if_setobject(castlewars_status_overlay_saradomin:catapult_pic, castlewars_catapult_dummy, -1);
