// 1433
[clientscript,toplevel_init]
if (getwindowmode >= 1) {
    if_setonvarctransmit(toplevel_fullscreen:mainoverlay, "toplevel_fovchange{fov}");
    if_setonvarctransmit(toplevel:main, "toplevel_fovchange{fov}");
}
if_setonvarctransmit(chattop:mes_layer, "meslayer_varc_update{meslayermode}");
if_setonresize(toplevel_fullscreen:maingame, "window_resize");
if (getwindowmode >= 2) {
    if_setonvartransmit(toplevel_fullscreen:com_10, "script1850(toplevel_fullscreen:advisorbutton){tutorial, tutorial2_tracking}");
    ~script1886(toplevel_fullscreen:advisorbutton);
} else {
    if_setonvartransmit(toplevel:minimap, "script1850(toplevel:advisorbutton){tutorial, tutorial2_tracking}");
    ~script1886(toplevel:advisorbutton);
}
~toplevel_minimenu_setup;
