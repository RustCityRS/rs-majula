// A label, so 2011's re-issues share it (as rat.rs2's).
[ai_queue3,hobgoblin] @hobgoblin_drop_table; // LVL 28 Hobgoblins

// 2011's hobgoblins 2685-2687 (cache 786: "Hobgoblin", level 28, as 289's) are
// 289's hobgoblin (npc_clones_2011.npc: void-634's clones), so its table. 2688
// is void-634's clone of 289's hobgoblin_armed, but cache 786 gives it level 28,
// not 42 (the 2011 wiki's Hobgoblin, 18 May 2011, has a level-28 hobgoblin
// wield a spear too), so 289's table for its level, as drop_reissues_2011.rs2
// joins by name and level.
[ai_queue3,hobgoblin_2685] @hobgoblin_drop_table;
[ai_queue3,hobgoblin_2686] @hobgoblin_drop_table;
[ai_queue3,hobgoblin_2687] @hobgoblin_drop_table;
[ai_queue3,hobgoblin_2688] @hobgoblin_drop_table;

[label,hobgoblin_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $random = random(128);

if ($random < 3) {
    if (map_members = ^true) {
        obj_add(npc_coord, bronze_spear, 1, ^lootdrop_duration);
    } else {
        obj_add(npc_coord, goblin_armour, 1, ^lootdrop_duration);
    }
} else if ($random < 6) {
    obj_add(npc_coord, iron_sword, 1, ^lootdrop_duration);
} else if ($random < 9) {
    obj_add(npc_coord, steel_dagger, 1, ^lootdrop_duration);
} else if ($random < 11) {
    if (map_members = ^true ){
        obj_add(npc_coord, iron_spear, 1, ^lootdrop_duration);
    } else {
        obj_add(npc_coord, coins, 28, ^lootdrop_duration);
    }
} else if ($random < 13) {
    if (map_members = ^true ){
        obj_add(npc_coord, steel_spear, 1, ^lootdrop_duration);
    } else {
        obj_add(npc_coord, coins, 28, ^lootdrop_duration);
    }
} else if ($random < 14) {
    obj_add(npc_coord, steel_longsword, 1, ^lootdrop_duration);
} else if ($random < 17) {
    obj_add(npc_coord, lawrune, 2, ^lootdrop_duration);
} else if ($random < 19) {
    obj_add(npc_coord, waterrune, 2, ^lootdrop_duration);
} else if ($random < 21) {
    obj_add(npc_coord, firerune, 7, ^lootdrop_duration);
} else if ($random < 23) {
    obj_add(npc_coord, bodyrune, 6, ^lootdrop_duration);
} else if ($random < 25) {
    obj_add(npc_coord, chaosrune, 3, ^lootdrop_duration);
} else if ($random < 27) {
    obj_add(npc_coord, naturerune, 4, ^lootdrop_duration);
} else if ($random < 28) {
    obj_add(npc_coord, cosmicrune, 2, ^lootdrop_duration);
} else if ($random < 35) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($random < 51) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
} else if ($random < 63) {
    obj_add(npc_coord, coins, 28, ^lootdrop_duration);
} else if ($random < 75) {
    obj_add(npc_coord, coins, 5, ^lootdrop_duration);
} else if ($random < 79) {
    obj_add(npc_coord, coins, 62, ^lootdrop_duration);
} else if ($random < 82) {
    obj_add(npc_coord, coins, 42, ^lootdrop_duration);
} else if ($random < 83) {
    obj_add(npc_coord, coins, 1, ^lootdrop_duration);
} else if ($random < 105) {
    obj_add(npc_coord, limpwurt_root, 1, ^lootdrop_duration);
} else if ($random < 107) {
    obj_add(npc_coord, goblin_armour, 1, ^lootdrop_duration);
} else if ($random < 109) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
}

[ai_queue3,hobgoblin_armed] // LVL 42 Hobgoblins
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $random = random(128);

if ($random < 3) {
    obj_add(npc_coord, iron_sword, 1, ^lootdrop_duration);
} else if ($random < 6) {
    obj_add(npc_coord, steel_dagger, 1, ^lootdrop_duration);
} else if ($random < 7) {
    obj_add(npc_coord, steel_longsword, 1, ^lootdrop_duration);
} else if ($random < 10) {
    obj_add(npc_coord, lawrune, 2, ^lootdrop_duration);
} else if ($random < 12) {
    obj_add(npc_coord, waterrune, 2, ^lootdrop_duration);
} else if ($random < 14) {
    obj_add(npc_coord, firerune, 7, ^lootdrop_duration);
} else if ($random < 16) {
    obj_add(npc_coord, bodyrune, 6, ^lootdrop_duration);
} else if ($random < 18) {
    obj_add(npc_coord, chaosrune, 3, ^lootdrop_duration);
} else if ($random < 20) {
    obj_add(npc_coord, naturerune, 4, ^lootdrop_duration);
} else if ($random < 21) {
    obj_add(npc_coord, cosmicrune, 2, ^lootdrop_duration);
} else if ($random < 22) {
    if (map_members = ^true) {
        obj_add(npc_coord, iron_javelin, 5, ^lootdrop_duration);
    }
} else if ($random < 29) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($random < 63) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
} else if ($random < 75) {
    obj_add(npc_coord, coins, 5, ^lootdrop_duration);
} else if ($random < 79) {
    obj_add(npc_coord, coins, 28, ^lootdrop_duration);
} else if ($random < 83) {
    obj_add(npc_coord, coins, 62, ^lootdrop_duration);
} else if ($random < 86) {
    obj_add(npc_coord, coins, 42, ^lootdrop_duration);
} else if ($random < 89) {
    if (map_members = ^true) {
        obj_add(npc_coord, coins, 1, ^lootdrop_duration);
    }
} else if ($random < 90) {
    obj_add(npc_coord, coins, 1, ^lootdrop_duration);
} else if ($random < 111) {
    obj_add(npc_coord, limpwurt_root, 1, ^lootdrop_duration);
} else if ($random < 113) {
    obj_add(npc_coord, goblin_armour, 1, ^lootdrop_duration);
} else if ($random < 115) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
}
