// A label, so 2011's re-issues share it (as rat.rs2's).
[ai_queue3,farmer] @farmer_drop_table;

// 2011's Lumbridge farmers 1757 and 1758 (cache 786: "Farmer", level 7, as
// 289's) are 289's farmer (npc_clones_2011.npc), so its table.
[ai_queue3,farmer_1757] @farmer_drop_table;
[ai_queue3,farmer_1758] @farmer_drop_table;

[label,farmer_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $random = random(128);

// Entire drop table structure changed on Farming release.
// At this point it gets split into F2P/P2P, and tertiary drops added.

if ($random < 2) {
    obj_add(npc_coord, bronze_med_helm, 1, ^lootdrop_duration);
} else if ($random < 3) {
    obj_add(npc_coord, iron_dagger, 1, ^lootdrop_duration);
} else if ($random < 6) {
    obj_add(npc_coord, bronze_arrow, 7, ^lootdrop_duration);
} else if ($random < 8) {
    obj_add(npc_coord, earth_rune, 4, ^lootdrop_duration);
} else if ($random < 10) {
    obj_add(npc_coord, fire_rune, 6, ^lootdrop_duration);
} else if ($random < 12) {
    obj_add(npc_coord, mind_rune, 9, ^lootdrop_duration);
} else if ($random < 13) {
    obj_add(npc_coord, chaos_rune, 2, ^lootdrop_duration);
} else if ($random < 24) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($random < 62) {
    obj_add(npc_coord, coins, 3, ^lootdrop_duration);
} else if ($random < 85) {
    obj_add(npc_coord, coins, 10, ^lootdrop_duration);
} else if ($random < 94) {
    obj_add(npc_coord, coins, 5, ^lootdrop_duration);
} else if ($random < 98) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
} else if ($random < 99) {
    obj_add(npc_coord, coins, 25, ^lootdrop_duration);
} else if ($random < 104) {
    obj_add(npc_coord, fishing_bait, 1, ^lootdrop_duration);
} else if ($random < 106) {
    obj_add(npc_coord, copper_ore, 1, ^lootdrop_duration);
} else if ($random < 108) {
    obj_add(npc_coord, earth_talisman, 1, ^lootdrop_duration);
} else if ($random < 109) {
    obj_add(npc_coord, cabbage, 1, ^lootdrop_duration);
}


