[ai_queue3,skeleton_unarmed] @skeleton_unarmed;
[ai_queue3,skeleton_unagressive] @skeleton_unarmed;

[label,skeleton_unarmed]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $random = random(128);

if ($random < 7) {
    obj_add(npc_coord, bronze_arrow, 2, ^lootdrop_duration);
} else if ($random < 11) {
    obj_add(npc_coord, bronze_arrow, 5, ^lootdrop_duration);
} else if ($random < 15) {
    obj_add(npc_coord, iron_arrow, 1, ^lootdrop_duration);
} else if ($random < 17) {
    obj_add(npc_coord, airrune, 15, ^lootdrop_duration);
} else if ($random < 19) {
    obj_add(npc_coord, earthrune, 3, ^lootdrop_duration);
} else if ($random < 21) {
    obj_add(npc_coord, firerune, 2, ^lootdrop_duration);
} else if ($random < 23) {
    obj_add(npc_coord, chaosrune, 3, ^lootdrop_duration);
} else if ($random < 24) {
    obj_add(npc_coord, naturerune, 3, ^lootdrop_duration);
} else if ($random < 25) {
    obj_add(npc_coord, steel_arrow, 1, ^lootdrop_duration);
} else if ($random < 46) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($random < 64) {
    obj_add(npc_coord, coins, 2, ^lootdrop_duration);
} else if ($random < 79) {
    obj_add(npc_coord, coins, 12, ^lootdrop_duration);
} else if ($random < 86) {
    obj_add(npc_coord, coins, 4, ^lootdrop_duration);
} else if ($random < 90) {
    obj_add(npc_coord, coins, 16, ^lootdrop_duration);
} else if ($random < 94) {
    obj_add(npc_coord, coins, 25, ^lootdrop_duration);
} else if ($random < 98) {
    obj_add(npc_coord, coins, 33, ^lootdrop_duration);
} else if ($random < 99) {
    obj_add(npc_coord, coins, 48, ^lootdrop_duration);
} else if ($random < 105) {
    obj_add(npc_coord, iron_dagger, 1, ^lootdrop_duration);
} else if ($random < 107) {
    obj_add(npc_coord, fire_talisman, 1, ^lootdrop_duration);
} else if ($random < 108) {
    obj_add(npc_coord, iron_ore, 1, ^lootdrop_duration);
} else if ($random < 109) {
    obj_add(npc_coord, grain, 1, ^lootdrop_duration);
} else if ($random < 110) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
}

[ai_queue3,skeleton_armed] @skeleton_armed;
[ai_queue3,giantskeleton] @skeleton_armed;

// 2011's other skeletons that are, or fight as, 289's skeleton_armed or 2011's
// skeleton_5333 and 5338, whose table this is (npc_clones_2011.npc, by
// void-634's clones and combat defs): 5337-5340 (level 25, as 289's), the
// Barrows' and Chaos Tunnels' 2036, 2037, 5381, 5386 and 5422 (level 77), and
// the Stronghold of Security's 4384-4386 and 5365-5368 (levels 60, 68 and 85).
// The 2011 wiki's Skeleton (18 May 2011) gives every level one drop list, so
// 289's.
[ai_queue3,skeleton_armed2] @skeleton_armed;
[ai_queue3,skeleton_armed3] @skeleton_armed;
[ai_queue3,skeleton_armed4] @skeleton_armed;
[ai_queue3,skeleton_armed5] @skeleton_armed;
[ai_queue3,barrows_skeleton_unarmed] @skeleton_armed;
[ai_queue3,barrows_skeleton_armed] @skeleton_armed;
[ai_queue3,barrows_skeleton_unarmed2] @skeleton_armed;
[ai_queue3,barrows_skeleton_armed2] @skeleton_armed;
[ai_queue3,lotr_skeleton_lvl_77] @skeleton_armed;
[ai_queue3,sos_death_skeleton_unarmed] @skeleton_armed;
[ai_queue3,sos_death_skeleton_unarmed2] @skeleton_armed;
[ai_queue3,sos_death_skeleton_armed] @skeleton_armed;
[ai_queue3,sos_death_skeleton_unarmed3] @skeleton_armed;
[ai_queue3,sos_death_skeleton_unarmed4] @skeleton_armed;
[ai_queue3,sos_death_skeleton_armed2] @skeleton_armed;
[ai_queue3,sos_death_skeleton_armed3] @skeleton_armed;

[label,skeleton_armed]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// Default drop from config.
