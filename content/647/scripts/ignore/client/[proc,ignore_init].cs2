// 4551
[proc,ignore_init]
if_setonfriendtransmit(friends2:ignorebox, "ignore_transmit");
~scrollbar_vertical(friends2:ignorescroll, friends2:ignorebox_scrolling_layer, "aif_scrollbar_dragger_2,3", "aif_scrollbar_dragger_2,0", "aif_scrollbar_dragger_2,1", "aif_scrollbar_dragger_2,2", "aif_scrollbar_arrow_2,1", "aif_scrollbar_arrow_2,0");
if_setscrollsize(friends2:ignorebox_scrolling_layer, 0, 0);
if_setscrollpos(friends2:ignorebox_scrolling_layer, 0, 0);
~ignore_update;
