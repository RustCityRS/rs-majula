// 1324
[clientscript,eyeglo_unlock](component $component0, component $component1, component $component2, component $component3, component $component4, component $component5)
if_setmodel($component0, enum(int, model, enum_1595, calc(%eyeglo_coin_value_1 / 10)));
if_setmodel($component1, enum(int, model, enum_1595, calc(%eyeglo_coin_value_1 % 10)));
if_setobject_nonum($component5, %eyeglo_unlock_a, 1);
if (%eyeglo_unlock_val = 0) {
    if_setmodel($component3, model_17219);
    if_setmodel($component2, null);
    if_setmodel($component4, null);
    return;
}
if (%eyeglo_unlock_val > %eyeglo_coin_value_1) {
    if_setmodel($component3, model_17219);
    if_setmodel($component2, model_17221);
    if_setmodel($component4, model_17217);
    return;
}
if (%eyeglo_unlock_val < %eyeglo_coin_value_1) {
    if_setmodel($component3, model_17219);
    if_setmodel($component2, model_17220);
    if_setmodel($component4, model_17218);
    return;
}
if_setmodel($component3, model_17216);
if_setmodel($component2, null);
if_setmodel($component4, null);
