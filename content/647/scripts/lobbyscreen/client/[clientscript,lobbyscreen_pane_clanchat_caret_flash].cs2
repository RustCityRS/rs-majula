// 1391
[clientscript,lobbyscreen_pane_clanchat_caret_flash](int $int0, component $component1)
if (activeclanchannel_find_affined = false) {
    if_settext(lobbyscreen_pane_clanchat:chat_input_text, "");
    if_sethide($component1, true);
    return;
}
if (calc((clientclock - $int0) % 40) < 20 & applet_hasfocus = true) {
    if_sethide($component1, false);
} else {
    if_sethide($component1, true);
}
