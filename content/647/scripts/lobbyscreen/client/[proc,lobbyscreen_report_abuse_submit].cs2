// 3200
[proc,lobbyscreen_report_abuse_submit](int $int0)
if (string_length(%lobbyscreen_report_abuse_name) > 0) {
    chat_sendabusereport(%lobbyscreen_report_abuse_name, $int0, %snapshot_mute, "");
}
~lobbyscreen_report_abuse_stage2_close;
if (string_length(%lobbyscreen_report_abuse_name) > 0 & ignore_test(%lobbyscreen_report_abuse_name) = false & compare(%lobbyscreen_report_abuse_name, chat_playername_unfiltered) ! 0) {
    if ($int0 = 5) {
        %lobbyscreen_report_abuse_bug = true;
    }
    ~lobbyscreen_report_abuse_ignore;
} else {
    %lobbyscreen_report_abuse_bug = false;
    if ($int0 = 5) {
        ~lobbyscreen_input_full("", "Open a bug report form?<br>(opens a new window)", 0, 6, "", "", 1);
    }
}
