// 3201
[clientscript,lobbyscreen_report_abuse_stage2_keyboard](int $key0)
switch_int ($key0) {
    case ^key_backspace :
        if (if_gethide(lobbyscreen_report_abuse_stage2:help_layer) = true) {
            ~lobbyscreen_report_abuse_stage2_back;
        }
    case ^key_f1 :
        ~lobbyscreen_report_abuse_help(1, lobbyscreen_report_abuse_stage2:help_title_text, lobbyscreen_report_abuse_stage2:help_body_text, lobbyscreen_report_abuse_stage2:help_body, lobbyscreen_report_abuse_stage2:help_layer, lobbyscreen_report_abuse_stage2:main);
    case ^key_escape :
        if (if_gethide(lobbyscreen_report_abuse_stage2:help_layer) = false) {
            ~lobbyscreen_report_abuse_help_close(lobbyscreen_report_abuse_stage2:help_title_text, lobbyscreen_report_abuse_stage2:help_body_text, lobbyscreen_report_abuse_stage2:help_body, lobbyscreen_report_abuse_stage2:help_layer, lobbyscreen_report_abuse_stage2:main);
        } else {
            ~lobbyscreen_report_abuse_stage2_close;
        }
}
