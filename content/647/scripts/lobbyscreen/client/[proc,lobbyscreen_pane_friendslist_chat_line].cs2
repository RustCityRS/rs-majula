// 3055
[proc,lobbyscreen_pane_friendslist_chat_line](int $int0, string $string0, int $int1, string $string1, string $string2, int $chattype2)(int)
cc_create(lobbyscreen_pane_friendslist:chat_build, ^iftype_text, $int0);
cc_setposition(0, calc($int0 * 15), ^setpos_abs_left, ^setpos_abs_bottom);
cc_setsize(0, 15, ^setsize_minus, ^setsize_abs);
cc_setcolour(^white);
cc_settextfont(p11_full);
cc_settext($string0);
if ($int1 = 1) {
    cc_setopbase(removetags($string1));
    cc_setonop("lobbyscreen_pane_friendslist_chat_op(event_op, $string1, $string2)");
    switch_int ($chattype2) {
        case ^chattype_privatechat, ^chattype_modprivatechat, ^chattype_quickchat_private_incoming, ^chattype_loginlogoutnotification :
            if (compare(removetags(chat_playername), removetags($string2)) ! 0) {
                if (friend_test(removetags($string2)) = false & ignore_test(removetags($string2)) = false) {
                    cc_setop(1, "Add friend");
                    cc_setop(2, "Add ignore");
                } else if (friend_test(removetags($string2)) = true & userdetail_quickchat = false) {
                    cc_setop(3, "Message");
                }
                if (staffmodlevel > 0 | playermod > 0) {
                    cc_setop(5, "Report abuse");
                }
            }
    }
}
return(calc($int0 + 1));
