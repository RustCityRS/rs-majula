            ~script1875(lobbyscreen:input_text, lobbyscreen:input_caret, %lobbyscreen_input);
        }
        return;
    case null, ^key_backspace, ^key_del :
        if ($int4 ! -1 & $int4 ! 6 & (char_isprintable($char1) = true | $key0 = ^key_backspace | $key0 = ^key_del)) {
            %lobbyscreen_input, %lobby_caret = ~script802(%lobby_caret, %lobbyscreen_input, $int3, $key0, $char1);
