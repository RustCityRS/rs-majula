// 3022
[clientscript,lobbyscreen_input_keyboard](int $key0, char $char1, component $component2, int $int3, int $int4, string $string0)
switch_int ($key0) {
    case ^key_return :
        ~lobbyscreen_input_ok($int4, $string0);
        return;
    case ^key_escape :
        ~lobbyscreen_input_close;
        return;
    case ^key_left, ^key_right, ^key_up, ^key_down, ^key_home, ^key_end :
        if ($int4 ! -1 & $int4 ! 6) {
