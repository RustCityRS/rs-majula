// 4572
[clientscript,lobbyscreen_pane_friendschat_caret_flash](int $int0, component $component1)
if (clan_getchatcount <= 0) {
    if_settext(lobbyscreen_pane_friendschat:chat_input_text, "");
    if_sethide($component1, true);
    return;
}
if (calc((clientclock - $int0) % 40) < 20 & applet_hasfocus = true) {
    if_sethide($component1, false);
} else {
    if_sethide($component1, true);
}
