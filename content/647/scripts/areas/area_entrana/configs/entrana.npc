// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[cave_monk]
desc=Unsurprisingly monk like.
defaultmode=none
wanderrange=0
moverestrict=nomove

[high_priest]
desc=High Priest of Entrana.

[shipmonk2]
desc=Holy looking.

[monk]
desc=A holy man.
wanderrange=3
maxrange=5
respawnrate=50
hitpoints=150
attack=2
strength=2
defence=3
param=damagetype,^crush_style
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_4068
param=attack_sound,synth_2566
param=defend_sound,brassclash2
param=death_sound,black_knight_death

[frincos]
desc=Kind of funny-looking.
category=shop_keeper
param=owned_shop,herbloreshop2
param=shop_sell_multiplier,1000
param=shop_buy_multiplier,700
param=shop_delta,20
param=shop_title,Frincos Fabulous Herb Store.
moverestrict=indoors
