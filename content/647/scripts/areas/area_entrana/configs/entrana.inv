[herbloreshop2]
// https://oldschool.runescape.wiki/w/Frincos%27_Fabulous_Herb_Store.
// https://web.archive.org/web/20110722130514im_/http://www.runevillage.com/images/rs2Cities/rsentrana3.gif (full stocks)
scope=shared
size=5
// 2011's shop holds 5 (the cache's inventory 50; void-634's list):
// it adds vial_pack, eye_of_newt_pack
restock=yes
stackall=yes
allstock=no
stock1=vial,50,100
stock2=vial_pack,6,100
stock3=pestle_and_mortar,3,100
stock4=eye_of_newt,50,20
stock5=eye_of_newt_pack,20,100
