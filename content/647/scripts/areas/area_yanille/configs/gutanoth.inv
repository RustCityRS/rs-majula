[generalshopogre]
// https://oldschool.runescape.wiki/w/Dal%27s_General_Ogre_Supplies
// https://classic.runescape.wiki/w/Ogre_trader_General_Store
// https://web.archive.org/web/20120521193813im_/http://www.runehq.com/images/cityguides/OrgerArea/dalsstore1.png (full stocks)
scope=shared
size=40
restock=yes
stackall=yes
allstock=yes
stock1=empty_pot,3,100
stock2=jug,2,100
stock3=knife,2,100
stock4=bucket,2,100
stock5=tinderbox,2,100
stock6=chisel,2,100
stock7=hammer,5,100

[herbloreshopogre]
// https://oldschool.runescape.wiki/w/Grud%27s_Herblore_Stall. (Trivia)
// https://classic.runescape.wiki/w/Grud%27s_herblaw_stall
// https://web.archive.org/web/20120521193813im_/http://www.runehq.com/images/cityguides/OrgerArea/grudsstore.png (full stocks)
scope=shared
size=5
// 2011's shop holds 5 (the cache's inventory 71; void-634's list):
// it adds vial_pack, eye_of_newt_pack
restock=yes
stackall=yes
allstock=no
stock1=vial,50,100
stock2=vial_pack,6,100
stock3=pestle_and_mortar,3,100
stock4=eye_of_newt,50,20
stock5=eye_of_newt_pack,20,100
