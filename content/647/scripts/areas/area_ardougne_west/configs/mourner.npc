// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[mourner]
desc=A mourner, or plague healer.
respawnrate=140
hitpoints=190
attack=8
strength=8
defence=8
param=attackbonus,6
param=strengthbonus,2
param=stabdefence,6
param=slashdefence,6
param=crushdefence,9
param=attack_anim,human_staff_pummel
param=defend_anim,human_staff_block
param=attack_sound,staff_hit
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_9013

[mourner3]
desc=A mourner, or plague healer.
respawnrate=140
