[mage_arena_boss_names]
// 289's arachnid and ethereal forms are 2011's troll and dark beast (2011
// wiki, Kolodion, 2011-04-17: man, ogre, troll, Dark Beast, black demon): the
// 13 May 2010 patch changed his creatures (runescape.wiki/w/Kolodion). The
// form names follow the creatures; 2011's own text is not on record.
inputtype=int
outputtype=string
val=0,"human"
val=1,"human"
val=2,"ogre"
val=3,"troll"
val=4,"dark beast"
val=5,"demon"
