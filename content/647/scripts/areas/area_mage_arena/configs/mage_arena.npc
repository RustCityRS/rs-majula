// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[gundai]
desc=He must get lonely out here.

// 289's magearena_runeshop is 2011's lundail.
[lundail]
desc=He sells rune stones.
param=owned_shop,magearena_runeshop
param=shop_sell_multiplier,1000
param=shop_buy_multiplier,600
param=shop_delta,30
param=shop_title,Lundail's Arena-side Rune Shop.

[chamber_guardian]
desc=He hasn't seen much sun lately.
param=owned_shop,magearena_staffshop
param=shop_sell_multiplier,1000
param=shop_buy_multiplier,0
param=shop_delta,20
param=shop_title,Mage Arena Staffs.

[kolodion]
desc=He runs the mage arena.
wanderrange=1

[arenamage2]
desc=He runs the mage arena.
wanderrange=0
moverestrict=nomove

[kolhuman]
desc='''In the Mage Arena cave:''' Runs the Mage Arena.<br/>'''In battle:''' He's a shape-shifter.
