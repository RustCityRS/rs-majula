// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[irena]
desc=A resident of Al-Kharid.
wanderrange=2

[shantay]
desc=He's in control of the Shantay Pass.
wanderrange=3
param=owned_shop,shantayshop
param=shop_sell_multiplier,1000
param=shop_buy_multiplier,700
param=shop_delta,10
param=shop_title,Shantay Pass Shop

[shantay_guard]
