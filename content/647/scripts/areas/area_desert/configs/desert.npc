// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[camel]
desc=Oh, it's a camel.
moverestrict=outdoors
param=death_anim,camel_death
param=death_sound,cow_death

[desert_wolf]
desc=A vicious desert wolf.
respawnrate=100
hitpoints=340
attack=20
strength=21
defence=22
magic=0
ranged=0
param=damagetype,^slash_style
param=attack_anim,dog_attack
param=defend_anim,dog_block
param=death_anim,dog_death
param=attack_sound,wolf_attack
param=defend_sound,wolf_hit
param=death_sound,wolf_death
param=death_drop,wolf_bones
huntmode=cowardly
huntrange=1
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_4649

[ugthanki]
desc=A vicious attacking camel.
respawnrate=700
hitpoints=450
attack=35
strength=35
defence=35
magic=0
ranged=0
param=damagetype,^stab_style
param=attack_anim,camel_attack
param=defend_anim,camel_block
param=death_anim,camel_death
param=attack_sound,cow_attack
param=defend_sound,cow_hit
param=death_sound,cow_death
param=retreat,50
huntmode=cowardly
huntrange=2
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_4652
