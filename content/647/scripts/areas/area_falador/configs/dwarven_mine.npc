// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[drogo_dwarf]
desc=He runs a Mining store.
category=shop_keeper
param=owned_shop,miningstore
param=shop_sell_multiplier,1000
param=shop_buy_multiplier,700
param=shop_delta,20
param=shop_title,Drogo's Mining Emporium.
wanderrange=13
param=damagetype,^stab_style
param=death_anim,dwarf_death
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_5895

[dwarven_shopkeeper]
