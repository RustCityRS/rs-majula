// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[white_knight]
desc=The knight seems to be watching something.
respawnrate=100
hitpoints=520
attack=27
strength=29
defence=21
param=attackrate,7
param=attackbonus,30
param=strengthbonus,31
param=stabdefence,83
param=slashdefence,76
param=crushdefence,70
param=magicdefence,-11
param=rangedefence,74
param=damagetype,^slash_style
param=attack_anim,seq_7041
param=defend_anim,human_unarmedblock
param=attack_sound,2H_crush
param=defend_sound,blade3
// osrs defend anim seq_410 (2005)
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_1798
param=death_anim,human_death

[wyson_the_gardener]
desc=The head gardener.
respawnrate=50
hitpoints=70
attack=2
defence=5
param=damagetype,^stab_style
param=attack_anim,human_farmersfork_stab
param=defend_anim,human_farmersfork_def
param=attack_sound,farmersfork_stab
// stats taken 3lv Gardener (Falador) Vislvl match.
// Also Hitpoints match RSC version.
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_3276

[generalshopkeeper4]
desc=A product of a consumerist society.
category=shop_keeper
param=owned_shop,generalshop4
param=shop_sell_multiplier,1300
param=shop_buy_multiplier,400
param=shop_delta,30
param=shop_title,Falador General Store
moverestrict=indoors

