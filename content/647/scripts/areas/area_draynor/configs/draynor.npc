// At some point (in 2005?) the huntmode was updated to be aggressive
// when players are 2x or less than the npc combat level instead of
// being aggressive at every combat level.
huntmode=aggressive_melee
// osrs
huntrange=5
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_4276
param=death_anim,human_death

