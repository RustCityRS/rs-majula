[armourshop]
// https://classic.runescape.wiki/w/Horvik%27s_Armour_Shop
// https://storage.googleapis.com/tannerdino/images/varrock10.png
scope=shared
size=15
// 2011's shop holds 15 (the cache's inventory 2; void-634's list):
// it adds bronze_med_helm, iron_med_helm, bronze_sq_shield, iron_sq_shield, bronze_platelegs, bronze_plateskirt, iron_plateskirt
// and no longer stocks 289's steel_chainbody, mithril_chainbody, studded_body, studded_chaps.
restock=yes
stackall=yes
allstock=no
stock1=bronze_chainbody,5,100
stock2=iron_chainbody,3,200
stock3=bronze_med_helm,10,100
stock4=iron_med_helm,10,100
stock5=bronze_platebody,3,100
stock6=iron_platebody,1,200
stock7=bronze_sq_shield,10,100
stock8=iron_sq_shield,10,100
stock9=bronze_platelegs,10,100
stock10=iron_platelegs,1,100
stock11=bronze_plateskirt,10,100
stock12=iron_plateskirt,10,100
stock13=steel_platebody,1,400
stock14=black_platebody,1,3000
stock15=mithril_platebody,1,3000

