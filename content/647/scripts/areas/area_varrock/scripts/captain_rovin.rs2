// 289's Captain Rovin (areas/area_varrock/scripts/captain_rovin.rs2), at the
// top of the palace's guards' quarters, as 2011's: he holds the second key to
// Silverlight's case (2011 wiki, Demon Slayer: "After some arguing, he will
// reluctantly give you the key"). His lines are void-634's (CaptainRovin.kt).
[opnpc1,captain_rovin]
~chatnpc("<p,angry>What are you doing up here? Only the palace guards are allowed up here.");
if (%demonslayer_main ! ^demon_not_started) {
    switch_int (~p_choice3("I am one of the palace guards.", 1, "What about the king?", 2, "Yes, I know, but this is important.", 3)) {
        case 1 : @captain_rovin_palace_guard;
        case 2 : @captain_rovin_what_about_king;
        case 3 : @captain_rovin_its_important;
    }
    return;
}
switch_int (~p_choice2("I am one of the palace guards.", 1, "What about the king?", 2)) {
    case 1 : @captain_rovin_palace_guard;
    case 2 : @captain_rovin_what_about_king;
}

[label,captain_rovin_palace_guard]
~chatplayer("<p,quiz>I am one of the palace guards.");
~chatnpc("<p,angry>No, you're not! I know all the palace guards.");
switch_int (~p_choice2("I'm a new recruit.", 1, "I've had extensive plastic surgery.", 2)) {
    case 1 :
        ~chatplayer("<p,neutral>I'm a new recruit.");
        ~chatnpc("<p,neutral>I interview all the new recruits. I'd know if you were one of them.");
        ~chatplayer("<p,neutral>That blows that story out of the water then.");
        ~chatnpc("<p,angry>Get out of my sight.");
    case 2 :
        ~chatplayer("<p,neutral>I've had extensive plastic surgery.");
        ~chatnpc("<p,neutral>What sort of surgery is that? I've never heard of it. Besides, you look reasonably healthy.");
        ~chatnpc("<p,angry>Why is this relevant anyway? You still shouldn't be here.");
}

[label,captain_rovin_what_about_king]
~chatplayer("<p,quiz>What about the King? Surely you'd let him up here.");
~chatnpc("<p,neutral>Well, yes, I suppose we'd let him up. He doesn't generally want to come up here, but if he did want to, he could.");
~chatnpc("<p,angry>Anyway, you're not the King either. So get out of my sight.");

[label,captain_rovin_its_important]
~chatplayer("<p,neutral>Yes, I know, but this is important.");
~chatnpc("<p,neutral>Okay, I'm listening. Tell me what's so important.");
if (%demonslayer_main ! ^demon_complete) {
    switch_int (~p_choice3("There's a demon who wants to invade this city.", 1, "Erm, I forgot.", 2, "The castle has just received its ale delivery.", 3)) {
        case 1 : @captain_rovin_theres_a_demon;
        case 2 : @captain_rovin_forgot;
        case 3 : @captain_rovin_ale_delivery;
    }
    return;
}
switch_int (~p_choice2("Erm, I forgot.", 1, "The castle has just received its ale delivery.", 2)) {
    case 1 : @captain_rovin_forgot;
    case 2 : @captain_rovin_ale_delivery;
}

[label,captain_rovin_forgot]
~chatplayer("<p,sad>Erm I forgot.");
~chatnpc("<p,angry>Well it can't be that important then.");
~chatplayer("<p,neutral>How do you know?");
~chatnpc("<p,angry>Just go away.");

[label,captain_rovin_ale_delivery]
~chatplayer("<p,neutral>The castle has just received its ale delivery.");
~chatnpc("<p,neutral>Now that is important. However I'm the wrong person to speak to about it. Go talk to the kitchen staff.");

[label,captain_rovin_theres_a_demon]
~chatplayer("<p,neutral>There's a demon who wants to invade the city.");
if (~demon_owns_key(silverlight_key_2) = true) {
    ~chatnpc("<p,neutral>Yes, you said before, haven't you killed it yet?");
    ~chatplayer("<p,neutral>I'm going to use the powerful sword Silverlight, which I believe you have one of the keys for?");
    if (inv_total(inv, silverlight_key_2) > 0) {
        ~chatnpc("<p,angry>I already gave you my key. Check your pockets.");
    } else {
        ~chatnpc("<p,neutral>I already gave you my key. Maybe you left it somewhere. Have you checked your bank account?");
    }
    return;
}
~chatnpc("<p,quiz>Is it a powerful demon?");
switch_int (~p_choice2("Not really.", 1, "Yes, very.", 2)) {
    case 1 :
        ~chatplayer("<p,neutral>Not really.");
        ~chatnpc("<p,happy>Well, I'm sure the palace guards can deal with it, then. Thanks for the information.");
    case 2 :
        ~chatplayer("<p,sad>Yes, very.");
        ~chatnpc("<p,scared>As good as the palace guards are, I don't know if they're up to taking on a powerful demon.");
        switch_int (~p_choice2("Yeah, the palace guards are rubbish!", 1, "They're not going to fight the demon, I am!", 2)) {
            case 1 :
                ~chatplayer("<p,laugh>Yeah, the palace guards are rubbish!");
                ~chatnpc("<p,laugh>Yeah, they're--");
                ~chatnpc("<p,angry>Wait! How dare you insult the palace guards? Get out of my sight!");
            case 2 :
                ~chatplayer("<p,neutral>They're not going to fight the demon, I am!");
                ~chatnpc("<p,shock>What, all by yourself? How are you going to do that?");
                ~chatplayer("<p,neutral>I'm going to use the powerful sword Silverlight, which I believe you have one of the keys for?");
                ~chatnpc("<p,quiz>Yes, I do. But why should I give it to you?");
                switch_int (~p_choice3("Gypsy Aris said I was destined to kill the demon.", 1, "Otherwise, the demon will destroy the city.", 2, "Sir Prysin said you would give me the key.", 3)) {
                    case 1 : @captain_rovin_aris_said_so;
                    case 2 : @captain_rovin_destroy_city;
                    case 3 : @captain_rovin_prysin_said_so;
                }
        }
}

[label,captain_rovin_aris_said_so]
~chatplayer("<p,neutral>Gypsy Aris said I was destined to kill the demon.");
~chatnpc("<p,angry>A fortune-teller? Destiny? I don't believe in that stuff. I got where I am today by hard work, not by destiny! Why should I care what that mad old fortune-teller says?");
switch_int (~p_choice2("Otherwise, the demon will destroy the city.", 1, "Sir Prysin said you would give me the key.", 2)) {
    case 1 : @captain_rovin_destroy_city;
    case 2 : @captain_rovin_prysin_said_so;
}

[label,captain_rovin_destroy_city]
~chatplayer("<p,scared>Otherwise, the demon will destroy the city.");
~chatnpc("<p,angry>You can't fool me! How do I know you haven't just made that story up to get my key?");
switch_int (~p_choice2("Gypsy Aris said I was destined to kill the demon.", 1, "Sir Prysin said you would give me the key.", 2)) {
    case 1 : @captain_rovin_aris_said_so;
    case 2 : @captain_rovin_prysin_said_so;
}

[label,captain_rovin_prysin_said_so]
~chatplayer("<p,neutral>Sir Prysin said you would give me the key.");
~chatnpc("<p,angry>Oh, he did, did he? Well, I don't report to Sir Prysin, I report directly to the king!");
~chatnpc("<p,angry>I didn't work my way up through the ranks of the palace guards so I could take orders from an ill-bred moron who got his job because his great-grandfather was a silly-named hero!");
switch_int (~p_choice3("Why did he give you one of the keys then?", 1, "Gypsy Aris said I was destined to kill the demon.", 2, "Otherwise, the demon will destroy the city.", 3)) {
    case 1 :
        ~chatplayer("<p,quiz>Why did he give you one of the keys then?");
        ~chatnpc("<p,angry>Only because the king ordered him to! The king couldn't get Sir Prysin to part with his precious ancestral sword, but he made him lock it up so he couldn't lose it.");
        ~chatnpc("<p,quiz>I got given one key and I think some wizard got another. Now, what happened to the third one?");
        ~chatplayer("<p,laugh>Sir Prysin dropped it down a drain!");
        ~chatnpc("<p,laugh>Ha ha ha, the idiot!");
        ~chatnpc("<p,laugh>Okay, I'll give you the key, just so that it's you who kills the demon, and not Sir Prysin.");
        if (inv_freespace(inv) > 0) {
            inv_add(inv, silverlight_key_2, 1);
            ~objbox(silverlight_key_2, "Captain Rovin hands you a key.", 250, 0, 0);
        }
    case 2 : @captain_rovin_aris_said_so;
    case 3 : @captain_rovin_destroy_city;
}
