[werewolfroadblocker]
desc=One of RuneScape's many citizens.

[rufus]
desc=There's something strange about him...
category=shop_keeper
param=owned_shop,werewolfstore1
param=shop_sell_multiplier,1300
param=shop_buy_multiplier,700
param=shop_delta,30
param=shop_title,Rufus' Meat Emporium
moverestrict=indoors
wanderrange=5

[barker]
desc=Has a distinguished air about him.
category=shop_keeper
param=owned_shop,werewolfstore2
param=shop_sell_multiplier,1300
param=shop_buy_multiplier,400
param=shop_delta,30
param=shop_title,Barkers' Habidashery
moverestrict=indoors
wanderrange=5

[fidelio]
desc=A lycanthrope shopkeeper.
category=shop_keeper
param=owned_shop,werewolfgeneralstore
param=shop_sell_multiplier,2000
param=shop_buy_multiplier,100
param=shop_delta,30
param=shop_title,General Store
moverestrict=indoors
wanderrange=5

[sbott]
desc=Has a faint smell of chemicals about him.
wanderrange=5

[roavar]
desc=Seems a jolly chap.
wanderrange=5

[will_o__the_wisp]
