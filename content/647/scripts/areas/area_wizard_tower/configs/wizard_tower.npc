// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[wizard_mizgog]
desc=An old wizard.
hitpoints=30
attack=20
strength=10
defence=15
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_7746

[wizard_grayzag]
desc=Master of imps.
respawnrate=60
hitpoints=340
// stats are from melzar, they line up perfectly with vislevel
attack=37
strength=37
defence=34
magic=40
param=damagetype,^crush_style
param=attack_anim,human_unarmedkick
param=attack_sound,unarmed_kick

[summonedimp]
desc=A vicious little imp.
hitpoints=90
param=attackbonus,-42
param=strengthbonus,-37
param=stabdefence,-42
param=slashdefence,-42
param=crushdefence,-42
param=magicdefence,-42
param=rangedefence,-42
param=damagetype,^stab_style
param=attack_anim,imp_attack
param=defend_anim,imp_block
param=death_anim,imp_death
param=attack_sound,imp_attack
param=defend_sound,imp_hit
param=death_sound,imp_death
param=death_drop,ashes
param=retreat,40
