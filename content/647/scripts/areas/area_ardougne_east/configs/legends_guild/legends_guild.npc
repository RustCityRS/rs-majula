// Hitpoints are 2011's life points: 289's times ten, or void-634's where it has the npc.
[shadow_warrior]
desc=A fighter from the supernatural world. He's a shadow of his former self.
wanderrange=4
maxrange=6
respawnrate=60
hitpoints=670
attack=36
strength=33
defence=36
magic=0
ranged=0
param=attackbonus,20
param=strengthbonus,26
param=stabdefence,43
param=slashdefence,31
param=crushdefence,19
param=magicdefence,15
param=rangedefence,38
param=damagetype,^slash_style
param=attack_anim,seq_391
param=defend_anim,human_trans_axe_def
param=death_anim,human_transdeath
param=attack_sound,ice_warrior_hit
param=defend_sound,steel
huntmode=cowardly
huntrange=1
// osrs stats and Vislvl match 1:1
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_2853
param=death_sound,ice_warrior_death

[legends_guard]
desc=A Legends' Guild guard; he protects the entrance to the Legends' Guild.
param=damagetype,^stab_style
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_3951
category=legends_guard
// These guards randomly switch between wandering and patrolling.
// The timer, random chance, and wander range are guesses
timer=25
wanderrange=3
defaultmode=wander
patrol1=0_42_52_38_21,6
patrol2=0_42_52_43_21,6

[legends_guild_guard2]
desc=A Legends' Guild guard; he protects the entrance to the Legends' Guild.
param=damagetype,^stab_style
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_3952
category=legends_guard
timer=25
// Guess
wanderrange=3
defaultmode=wander
patrol1=0_42_52_38_20,6
patrol2=0_42_52_43_20,6

[radimus_erkle]
desc=Radimus is the Grand Vizier of the Legends Guild.
wanderrange=3
param=damagetype,^stab_style
moverestrict=indoors
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_3953

[fionella]
desc=She sells general items at the Legends' Guild.
wanderrange=3
param=damagetype,^crush_style
category=shop_keeper
param=owned_shop,generallegends
param=shop_sell_multiplier,1550
param=shop_buy_multiplier,550
param=shop_delta,10
param=shop_title,Legends Guild General Store.
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_3960

[siegfried_erkle]
desc=An eccentric shopkeeper, related to the Grand Vizier of the Legends' Guild.
wanderrange=3
param=damagetype,^crush_style
category=shop_keeper
param=owned_shop,legendsguildshop
param=shop_sell_multiplier,1500
param=shop_buy_multiplier,500
param=shop_delta,20
param=shop_title,Legends Guild Shop of Useful Items.
// https://raw.githubusercontent.com/Joshua-F/osrs-dumps/refs/heads/master/config/dump.npc npc_3961
