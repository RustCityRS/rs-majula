// 289's toll gate (areas/area_alkharid/configs/border_gate.loc) on 2011's: the
// map places loc_35549 at 3268,3227 and loc_35551 at 3268,3228 (cache 786,
// l51_50), multilocs on %princequest that show a gate with Open and
// Pay-toll(10gp) (10565, 10566) until it is 100, 289's ^prince_saved, and one
// with Open alone (10567, 10568) after. They open to 35550 and 35552, which
// stand where 289's loc_1562 and loc_1563 did (35552 mirrored, as 1563 is).
[loc_35549]
category=border_gate_toll_left
param=next_loc_stage,loc_35550

[loc_35551]
category=border_gate_toll_right
param=next_loc_stage,loc_35552
