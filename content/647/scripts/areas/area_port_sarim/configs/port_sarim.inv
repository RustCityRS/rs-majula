// [foodshop]: nothing opens it, and 2011's inventory 20 is a
// 1-slot placeholder that 289's 10 stock lines do not fit.

[battleaxeshop]
// https://classic.runescape.wiki/w/Brian%27s_Great_Axes
// https://web.archive.org/web/20111216182350im_/http://www.runehq.com/images/cityguides/axes.jpg
scope=shared
size=6
restock=yes
stackall=yes
allstock=no
stock1=bronze_battleaxe,4,200
stock2=iron_battleaxe,3,300
stock3=steel_battleaxe,2,500
stock4=black_battleaxe,1,700
stock5=mithril_battleaxe,1,1000
stock6=adamant_battleaxe,1,15000

