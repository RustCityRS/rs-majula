// 893
[clientscript,easter08_refresh_incubator]
if (%easter08_incubator_update_delay < 10) {
    %easter08_incubator_update_delay = calc(%easter08_incubator_update_delay + 1);
    return;
}
%easter08_incubator_update_delay = 0;
def_int $int0 = calc(20 - 0);
def_int $int1 = calc(80 - 0);
def_int $int2 = calc($int1 / $int0);
def_int $int3 = calc(%easter08_incubator_temperature * $int2);
if (%easter08_cl_visual_temperature < $int3) {
    %easter08_cl_visual_temperature = calc(%easter08_cl_visual_temperature + 1);
} else if (%easter08_cl_visual_temperature > $int3) {
    %easter08_cl_visual_temperature = calc(%easter08_cl_visual_temperature - 1);
}
if (%easter08_incubator_needle_direction = 0) {
    if (%easter08_incubator_needle_wobble > 0) {
        %easter08_incubator_needle_wobble = calc(%easter08_incubator_needle_wobble - 1);
    } else {
        %easter08_incubator_needle_direction = 1;
    }
} else if (%easter08_incubator_needle_wobble < 4) {
    %easter08_incubator_needle_wobble = calc(%easter08_incubator_needle_wobble + 1);
} else {
    %easter08_incubator_needle_direction = 0;
}
def_int $int4 = calc(%easter08_cl_visual_temperature + (%easter08_incubator_needle_wobble + 2));
def_int $int5 = calc(1024 / $int1);
$int4 = calc($int4 * $int5);
$int4 = calc($int4 + 512);
$int4 = calc(2048 - $int4);
if_setmodelangle(easter08_incubator_side:demo_pointer, 0, 0, 0, 0, $int4, 388);
def_int $int6 = calc(enum(int, int, enum_1422, %easter08_main) * (1024 / $int0));
$int6 = calc($int6 + 512);
$int6 = calc(2048 - $int6);
if_setmodelangle(easter08_incubator_side:temperature_target, 0, 0, 0, 0, $int6, 365);
