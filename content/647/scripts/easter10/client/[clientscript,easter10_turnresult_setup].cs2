// 2241
[clientscript,easter10_turnresult_setup]
if_settext(easter10_turnresult:resources_text, "+ <tostring(%easter10_resourcegame_nutsgenerated)> ( <tostring(%easter10_resourcegame_totalnuts)> )<br>+ <tostring(%easter10_resourcegame_chocgenerated)> ( <tostring(%easter10_resourcegame_totalchoc)> )<br>+ <tostring(%easter10_resourcegame_fruitgenerated)> ( <tostring(%easter10_resourcegame_totalfruit)> )<br>");
if_settext(easter10_turnresult:products_text, "+ <tostring(%easter10_resourcegame_fcgenerated)> ( <tostring(%easter10_resourcegame_totalfc)> )<br>+ <tostring(%easter10_resourcegame_tegggenerated)> ( <tostring(%easter10_resourcegame_totaltegg)> )<br>+ <tostring(%easter10_resourcegame_negggenerated)> ( <tostring(%easter10_resourcegame_totalnegg)> )<br>");
if (%easter10_incubator_status = 1) {
    if_settext(easter10_turnresult:incubator_status, "WORKING");
    if_setcolour(easter10_turnresult:incubator_status, ^green);
} else {
    sound_synth(synth_8723, 10, 0);
    if_settext(easter10_turnresult:incubator_status, "NEEDS REPAIR");
    if_setcolour(easter10_turnresult:incubator_status, ^red);
}
if (%easter10_conveyor_status = 1) {
    if_settext(easter10_turnresult:conveyor_status, "WORKING");
    if_setcolour(easter10_turnresult:conveyor_status, ^green);
} else {
    sound_synth(synth_8723, 10, 1);
    if_settext(easter10_turnresult:conveyor_status, "NEEDS REPAIR");
    if_setcolour(easter10_turnresult:conveyor_status, ^red);
}
if (%easter10_painter_status = 1) {
    if_settext(easter10_turnresult:painter_status, "WORKING");
    if_setcolour(easter10_turnresult:painter_status, ^green);
} else {
    sound_synth(synth_8723, 10, 2);
    if_settext(easter10_turnresult:painter_status, "NEEDS REPAIR");
    if_setcolour(easter10_turnresult:painter_status, ^red);
}
if_settext(easter10_turnresult:workerupkeep_text, tostring(calc(%easter10_totalworkers / 5)));
switch_int (%easter10_resourcegame_randomeventflag) {
    case 5 :
        if_settext(easter10_turnresult:event_text1, "Your workers uncover a hidden stash and you receive");
        if_settext(easter10_turnresult:event_text2, "3 extra resources.");
        sound_synth(synth_8728, 1, 0);
    case 6 :
        if_settext(easter10_turnresult:event_text1, "An accident at work has taken place. As a result you have");
        if_settext(easter10_turnresult:event_text2, "lost 3 resources.");
        sound_synth(synth_8723, 10, 0);
    case 7 :
        if_settext(easter10_turnresult:event_text1, "The paint machine is out of glaze and requires a repair to work at full efficiency.");
        if_settext(easter10_turnresult:event_text2, "Painter needs repair.");
    case 8 :
        if_settext(easter10_turnresult:event_text1, "The conveyor team needs re-training in order to work at full efficiency.");
        if_settext(easter10_turnresult:event_text2, "Conveyor needs repair.");
    case 9 :
        if_settext(easter10_turnresult:event_text1, "The oven is coated in soot. It requires a repair to work at full efficiency.");
        if_settext(easter10_turnresult:event_text2, "Oven needs repair.");
    case default :
        if_settext(easter10_turnresult:event_text1, "");
        if_settext(easter10_turnresult:event_text2, "Nothing unusual happened.");
}
