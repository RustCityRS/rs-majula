[clientscript,meslayer_mode8](string $string0)
if (getwindowmode >= 2) {
    if_sethide(toplevel_fullscreen:chattop, false);
}
if_sethide(chattop:mes_layer, false);
if_sethide(chattop:mes_layer_large, true);
if_sethide(chattop:mes_layer_hide, true);
if_settext(chattop:mes_text, $string0);
%meslayermode = 8;
~meslayer_setupinput("");
if_setonclick(chattop:mes_layer, null);
~script2026;
if_setonkey(chattop:mes_text2, "meslayer_onkey(event_keycode, event_keychar)");
if_setondialogabort(chattop:mes_text2, "meslayer_ondialogabort");
if (%last_namedialog_init = true & string_length(%last_namedialog) > 0) {
    cc_create(chattop:mes_layer, ^iftype_text, 0);
    ~meslayer_setupdynamicbutton;
    cc_settext("Last name entered: <%last_namedialog>");
    cc_setop(1, "Use:");
    cc_setopbase("<col=ff9040><removetags(%last_namedialog)></col>");
    cc_setonop("meslayer_lastname(%meslayermode, event_op, event_com, event_comsubid, %last_namedialog)");
} else {
    %last_namedialog = "";
    %last_namedialog_init = true;
}
~script1188;
