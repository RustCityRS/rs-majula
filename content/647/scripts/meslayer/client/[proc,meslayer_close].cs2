// 1548
[proc,meslayer_close](int $int0)
if ($int0 = 0 | $int0 = %meslayermode) {
    if_sethide(chattop:mes_layer, true);
    if_sethide(chattop:mes_layer_large, true);
    if_sethide(chattop:mes_layer_hide, false);
    ~script2026;
    %meslayermode = 0;
}
if (getwindowmode >= 2) {
    ~subchanged;
}
