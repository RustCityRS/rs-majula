// 1437
[clientscript,tutorial_progress_bar]
if (%tutorial_progress_overlay > 1) {
    if_setcolour(tutorial_progress:tutorial_progress0, 0x8080ff);
} else {
    if_setcolour(tutorial_progress:tutorial_progress0, ^black);
}
