// Tutorial Island is not ported yet. Skills ported from 289 keep their
// tutorial hooks as 289 wrote them; these stand in until the tutorial comes
// across. Port the tutorial, then delete what it replaces here.

// 289's util.rs2, unchanged: 2011's island and its dungeon are where 289's are.
[proc,in_tutorial_island](coord $coord)(boolean)
if (inzone(0_47_47_45_48, 3_49_49_20_0, $coord) = true) {
    // taken from client code: x >= 3053 && x <= 3156 && z >= 3056 && z <= 3136
    return (true);
}

if (inzone(0_48_148_0_20, 3_48_148_46_63, $coord) = true) {
    // taken from client code: x >= 3072 && x <= 3118 && z >= 9492 && z <= 9535
    return (true);
}

return (false);

// 289's cooking hands cooking on the island to the tutorial's own steps; with
// none ported, cooking there does nothing.
[label,tut_attempt_cook_item](obj $uncooked_item)

// 289's tutorial.rs2, unchanged: on the island, combat gives xp only below
// level 3.
[proc,tutorial_give_xp](stat $skill, int $xp)
if (stat_base($skill) >= 3) {
    return;
}
stat_advance($skill, $xp);

// 289's magic hands a spell cast on the island to the tutorial's own; with
// none ported, nothing happens.
[proc,pvm_tutorial_spell](int _$spell)

// 289's anvil hands smithing on the island to the tutorial's own (a bronze
// dagger for its step); with none ported, nothing is made there.
[proc,tut_smithing_anvil](int _$count)
