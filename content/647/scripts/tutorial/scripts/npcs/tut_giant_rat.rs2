[ai_queue1,newbiegiantrat] gosub(npc_default_retaliate);

// death
[ai_queue3,newbiegiantrat]
gosub(npc_death);
if (npc_findhero = ^true) {
    obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);
    if (%varplayer_419 =  ^newbie_combat_instructor_during_attacking_melee
        | %varplayer_419 =  ^newbie_combat_instructor_before_attacking_ranged) {
        queue(set_rat_kill, 0, 0);
    }
}

[ai_opplayer2,newbiegiantrat]
if (%death = ^true) {
    npc_setmode(null);
    return;
}
if (map_clock < %npc_action_delay) {
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}
anim(%com_defendanim, 0);
npc_anim(npc_param(attack_anim), 0);
%npc_action_delay = add(map_clock, npc_param(attackrate));
if (npc_param(attack_sound) ! null) {
    sound_synth(npc_param(attack_sound), 1, 0);
}

def_int $attack_roll = ~npc_melee_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(npc_param(damagetype));
def_int $maxhit = ~npc_melee_maxhit;
def_int $damage = 0;

if_close; // close the player interface when taking a hit.
// 289 spares the last hitpoint; at 647 that is 10 life points (%life_points,
// content's pool; stat(hitpoints) is the level and never falls with a hit).
if (%life_points <= 10) {
    $damage = 0;
} else if (randominc($attack_roll) > randominc($defence_roll)) {
    $damage = randominc($maxhit);
}
// A bite is a melee hit: 2011 paints it with the melee mark (hitmark.rs2).
queue(combat_damage_player, 1, ~combat_hit($damage, ^hitmark_melee, $maxhit));
queue*(playerhit_n_retaliate, 1)(npc_uid);
~npc_set_attack_vars;

[opnpc2,newbiegiantrat]
if (~player_in_combat_check = false) {
    return;
}
if (%varplayer_419 = ^newbie_combat_instructor_before_attacking_melee) {
    %varplayer_419 = ^newbie_combat_instructor_during_attacking_melee;
   ~set_tutorial_progress;
}
@player_combat_start;

[apnpc2,newbiegiantrat]
if (%varplayer_419 > ^newbie_combat_instructor_before_attacking_ranged
    & %varplayer_419 < ^tutorial_complete) {
    if (inv_total(worn, shortbow) < 1 & inv_total(worn, bronze_arrow) < 1
        | inv_total(worn, shortbow) < 1 & inv_total(worn, bronze_arrow) > 1) {
        ~mesbox("You should equip a bow and some arrows before doing that.");
        return;
    }

    if (inv_total(worn, shortbow) > 0 & inv_total(worn, bronze_arrow) < 1) {
        ~mesbox("You need to equip the arrows you have in your inventory.");
        return;
    }
}

// 2013 Vid shows that maybe the check is > tut_step && less than tut complete
// https://youtu.be/7zsi7hiF4SQ?t=536
/*if (%tutorial > ^newbie_combat_instructor_before_attacking_ranged
    & %tutorial < ^tutorial_complete) {
    ~mesbox("You've already done that.|Perhaps you should move on.");
    return;
}*/

def_int $distance = npc_range(coord);
def_int $attackrange = 0;
if (inv_getobj(worn, ^wearpos_rhand) ! null) {
    $attackrange = min(oc_param(inv_getobj(worn, ^wearpos_rhand), attackrange), 10);
    if (%damagestyle = ^style_ranged_longrange) {
        $attackrange = min(add($attackrange, 2), 10);
    }
}

if (~player_autocast_enabled = true){
    $attackrange = 10;
}
if ($attackrange <= 1) {
    p_aprange($attackrange); // walk then op again
    return;
}
if ($distance > $attackrange) {
    p_aprange($attackrange);
    return;
}
if (~player_in_combat_check = false) {
    return;
}
p_aprange($attackrange);
@player_combat_start;

[queue,set_rat_kill]
if (%varplayer_419 = ^newbie_combat_instructor_during_attacking_melee) {
    %varplayer_419 = ^newbie_combat_instructor_after_rat_kill_melee;
    ~set_tutorial_progress;
}

if (%varplayer_419 = ^newbie_combat_instructor_before_attacking_ranged) {
    %varplayer_419 = ^newbie_combat_instructor_after_attacking_ranged;
    ~set_tutorial_progress;
}

[proc,set_hint_icon_giant_rat]
if (npc_find(0_48_148_37_47, newbiegiantrat, 10, 0) = true) {
    hint_npc;
}
