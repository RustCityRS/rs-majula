// Woodcutting skill — rev 647.
//
// Category-based triggers: all trees share category=tree.
// Properties (level, xp, product, success chance, respawn) are stored
// as params on each loc config. Animation per-hatchet via
// oc_param(woodcutting_anim).
//
// Hatchet multipliers (% of bronze, from 2004scape + OSRS wiki):
//   Bronze=100, Iron=150, Steel=200, Black=225,
//   Mithril=250, Adamant=300, Rune=350, Dragon=385
//
// Depletion: 1/8 flat chance (random(8)=0), normal trees always deplete.
//
// XP UNITS: wc_xp params are in the engine's XP units, which are 10x real XP
// (rs-stat stores experience at 10x so awards can be fractional; the client
// divides by 10 to display it). A level-1 tree is 25 xp, so wc_xp=250. Every
// value here was originally authored as plain XP and paid a tenth of what it
// should -- a chop moved the counter by 2 instead of 25. Firemaking had it
// right all along (normal logs are productexp=400 for 40 xp); compare against
// that scale when adding a species.

[oploc1,_tree] @attempt_cut_tree;
[oploc3,_tree] @cut_tree;

// ── attempt_cut_tree (oploc1 handler) ──────────────────────────────────────

[label,attempt_cut_tree]
def_int $level_req = loc_param(wc_levelreq)
if (stat(woodcutting) < $level_req) {
    mes("You need a Woodcutting level of <tostring($level_req)> to chop down this tree.")
    return
}

def_obj $product = loc_param(wc_product)
if ($product ! null) {
    if (inv_freespace(inv) < 1) {
        mes("Your inventory is too full to hold any more logs.")
        return;
    }
}

if (%action_delay < map_clock | %action_delay > calc(map_clock + 10)) {
    if (~wc_find_hatchet = null) {
        return
    }
    %action_delay = calc(map_clock + 3)
    p_oploc(1)
    return
}

def_obj $hatchet = ~wc_find_hatchet
if ($hatchet = null) {
    return
}

anim(oc_param($hatchet, woodcutting_anim), 0)
mes("You swing your hatchet at the tree.")

if (%action_delay = map_clock) {
    @get_logs($hatchet)
}

p_oploc(3)

// ── cut_tree (oploc3 hidden loop) ──────────────────────────────────────────

[label,cut_tree]
def_obj $hatchet = ~wc_find_hatchet
if ($hatchet = null) {
    return
}

def_int $level_req = loc_param(wc_levelreq)
if (stat(woodcutting) < $level_req) {
    mes("You need a Woodcutting level of <tostring($level_req)> to chop down this tree.")
    return
}

def_obj $product = loc_param(wc_product)
if ($product ! null) {
    if (inv_freespace(inv) < 1) {
        mes("Your inventory is too full to hold any more logs.")
        anim(-1, 0)
        return
    }
}

if (%action_delay < map_clock | %action_delay > calc(map_clock + 10)) {
    %action_delay = calc(map_clock + 3)
} else if (%action_delay = map_clock) {
    anim(oc_param($hatchet, woodcutting_anim), 0)
    @get_logs($hatchet)
}

p_oploc(3)

// ── get_logs ───────────────────────────────────────────────────────────────

[label,get_logs](obj $hatchet)
def_int $mult = ~wc_hatchet_power($hatchet)
def_int $chance_low = loc_param(wc_chance_low)
def_int $chance_high = loc_param(wc_chance_high)
def_int $scaled_low = calc($chance_low * $mult / 100)
def_int $scaled_high = calc($chance_high * $mult / 100)

if (stat_random(woodcutting, $scaled_low, $scaled_high) = 1) {
    def_obj $product = loc_param(wc_product)
    if ($product ! null) {
        inv_add(inv, $product, 1)
        mes("You get some logs.")
    } else {
        mes("You successfully cut the ivy.")
    }
    ~givexp(woodcutting, loc_param(wc_xp))

    def_int $respawn = loc_param(wc_respawn)
    def_int $level_req = loc_param(wc_levelreq)
    def_int $multilevel = loc_param(multilevel)

    // Normal trees always deplete; others 1/8 flat chance
    if ($level_req = 1) {
        loc_change(loc_param(next_loc_stage), $respawn)
        if ($multilevel = 1) {
            ~wc_cascade_remove($respawn)
        }
        anim(-1, 0)
        return
    }
    if (random(8) = 0) {
        loc_change(loc_param(next_loc_stage), $respawn)
        if ($multilevel = 1) {
            ~wc_cascade_remove($respawn)
        }
        anim(-1, 0)
        return
    }
}

p_oploc(3)

// ── Hatchet power multiplier (% of bronze) ────────────────────────────────

[proc,wc_hatchet_power](obj $hatchet)(int)
if ($hatchet = dragon_hatchet) {
    return(385)
}
if ($hatchet = rune_hatchet) {
    return(350)
}
if ($hatchet = adamant_hatchet) {
    return(300)
}
if ($hatchet = mithril_hatchet) {
    return(250)
}
if ($hatchet = black_hatchet) {
    return(225)
}
if ($hatchet = steel_hatchet) {
    return(200)
}
if ($hatchet = iron_hatchet) {
    return(150)
}
return(100)

// ── Hatchet finder (highest usable tier) ──────────────────────────────────

[proc,wc_find_hatchet]()(obj)
def_int $wc_level = stat(woodcutting)
def_obj $worn_weapon = inv_getobj(worn, 3)
if ($wc_level >= 61) {
    if ($worn_weapon = dragon_hatchet | inv_total(inv, dragon_hatchet) > 0) {
        return(dragon_hatchet)
    }
}
if ($wc_level >= 41) {
    if ($worn_weapon = rune_hatchet | inv_total(inv, rune_hatchet) > 0) {
        return(rune_hatchet)
    }
}
if ($wc_level >= 31) {
    if ($worn_weapon = adamant_hatchet | inv_total(inv, adamant_hatchet) > 0) {
        return(adamant_hatchet)
    }
}
if ($wc_level >= 21) {
    if ($worn_weapon = mithril_hatchet | inv_total(inv, mithril_hatchet) > 0) {
        return(mithril_hatchet)
    }
}
if ($wc_level >= 11) {
    if ($worn_weapon = black_hatchet | inv_total(inv, black_hatchet) > 0) {
        return(black_hatchet)
    }
}
if ($wc_level >= 6) {
    if ($worn_weapon = steel_hatchet | inv_total(inv, steel_hatchet) > 0) {
        return(steel_hatchet)
    }
}
if ($worn_weapon = iron_hatchet | inv_total(inv, iron_hatchet) > 0) {
    return(iron_hatchet)
}
if ($worn_weapon = bronze_hatchet | inv_total(inv, bronze_hatchet) > 0) {
    return(bronze_hatchet)
}
mes("You do not have a hatchet which you have the woodcutting level to use.")
return(null)

// ── HD tree canopy removal ────────────────────────────────────────────────
// HD trees span multiple planes. When the base is chopped, delete
// trunk/canopy parts on the planes above with the same respawn timer.
// Searches 4 zone corners to handle trees on zone boundaries (8x8 tiles).

[proc,wc_cascade_remove](int $respawn)
def_coord $base = loc_coord
def_int $base_x = coordx($base)
def_int $base_z = coordz($base)
def_int $dy = 1
while ($dy <= calc(3 - coordy($base))) {
    ~wc_zone_del(movecoord($base, -2, $dy, -2), $base_x, $base_z, $respawn)
    ~wc_zone_del(movecoord($base, 2, $dy, -2), $base_x, $base_z, $respawn)
    ~wc_zone_del(movecoord($base, -2, $dy, 2), $base_x, $base_z, $respawn)
    ~wc_zone_del(movecoord($base, 2, $dy, 2), $base_x, $base_z, $respawn)
    $dy = calc($dy + 1)
}

[proc,wc_zone_del](coord $zone_coord, int $base_x, int $base_z, int $respawn)
loc_findallzone($zone_coord)
while (.loc_findnext = true) {
    def_int $dx = calc(coordx(.loc_coord) - $base_x)
    def_int $dz = calc(coordz(.loc_coord) - $base_z)
    if ($dx >= -2 & $dx <= 2 & $dz >= -2 & $dz <= 2) {
        // TODO fix tree trunk/top categories so we don't accidently remove other locs.
        if (.loc_category = tree) {
            .loc_change(inviswall_no_blockrange, $respawn)
        }
    }
}

#testscript

// ── Hatchet power multiplier ────────────────────────────────────
[label,test_wc_hatchet_power_bronze]
assert_eq(~wc_hatchet_power(bronze_hatchet), 100)

[label,test_wc_hatchet_power_iron]
assert_eq(~wc_hatchet_power(iron_hatchet), 150)

[label,test_wc_hatchet_power_steel]
assert_eq(~wc_hatchet_power(steel_hatchet), 200)

[label,test_wc_hatchet_power_black]
assert_eq(~wc_hatchet_power(black_hatchet), 225)

[label,test_wc_hatchet_power_mithril]
assert_eq(~wc_hatchet_power(mithril_hatchet), 250)

[label,test_wc_hatchet_power_adamant]
assert_eq(~wc_hatchet_power(adamant_hatchet), 300)

[label,test_wc_hatchet_power_rune]
assert_eq(~wc_hatchet_power(rune_hatchet), 350)

[label,test_wc_hatchet_power_dragon]
assert_eq(~wc_hatchet_power(dragon_hatchet), 385)

// ── Hatchet finder — level gating ───────────────────────────────
[label,test_wc_find_hatchet_bronze_at_level_1]
setup_player("test_player")
inv_add(inv, bronze_hatchet, 1)
def_obj $found = ~wc_find_hatchet
assert_eq($found, bronze_hatchet)

[label,test_wc_find_hatchet_iron_at_level_1]
setup_player("test_player")
inv_add(inv, iron_hatchet, 1)
def_obj $found = ~wc_find_hatchet
assert_eq($found, iron_hatchet)

[label,test_wc_find_hatchet_steel_requires_6]
setup_player("test_player")
inv_add(inv, steel_hatchet, 1)
inv_add(inv, bronze_hatchet, 1)
def_obj $found = ~wc_find_hatchet
assert_eq($found, bronze_hatchet)
stat_add(woodcutting, 5, 0)
$found = ~wc_find_hatchet
assert_eq($found, steel_hatchet)

[label,test_wc_find_hatchet_picks_highest_tier]
setup_player("test_player")
stat_add(woodcutting, 60, 0)
inv_add(inv, bronze_hatchet, 1)
inv_add(inv, iron_hatchet, 1)
inv_add(inv, steel_hatchet, 1)
inv_add(inv, mithril_hatchet, 1)
inv_add(inv, adamant_hatchet, 1)
inv_add(inv, rune_hatchet, 1)
inv_add(inv, dragon_hatchet, 1)
def_obj $found = ~wc_find_hatchet
assert_eq($found, dragon_hatchet)

[label,test_wc_find_hatchet_no_hatchet]
setup_player("test_player")
def_obj $found = ~wc_find_hatchet
wait_for("mes", 20)
assert_called_with("mes", "You do not have a hatchet which you have the woodcutting level to use.")
assert_eq($found, null)

// ── Integration — attempt_cut_tree ─────────────────────────────
// Use named tree-config symbols (unique to loc.pack so they resolve to the
// correct loc id without colliding with obj.pack `tree` or category `tree`).
// tree_1276 at x=2552,z=3450 (Falador area). Player on tile west of tree.
[label,test_wc_attempt_cut_tree_no_hatchet]
setup_player("test_player");
p_telejump(0_39_53_55_58);
test_op(oploc1, tree_1276, 0_39_53_56_58);
assert_eq(inv_total(inv, logs), 0)

[label,test_wc_attempt_cut_tree_low_level]
setup_player("test_player");
p_telejump(0_43_53_1_41);inv_add(inv, rune_hatchet, 1);
test_op(oploc1, yew, 0_43_53_2_41);
assert_eq(inv_total(inv, yew_logs), 0)

[label,test_wc_attempt_cut_tree_with_hatchet]
setup_player("test_player");
p_telejump(0_39_53_55_58);
inv_add(inv, bronze_hatchet, 1);
test_op(oploc1, tree_1276, 0_39_53_56_58);
// The first op only books the swing (%action_delay, then p_oploc(1)); the
// re-op a tick later swings.
wait_for("mes", 5);
assert_called_with("mes", "You swing your hatchet at the tree.");

// ── Full lifecycle — chop tree, receive logs, tree depletes ────

[label,test_wc_full_lifecycle]
setup_player("test_player");
p_telejump(0_39_53_55_58);
def_coord $jumped_pos = coord;
def_int $jumped_x = coordx($jumped_pos);
def_int $jumped_z = coordz($jumped_pos);
assert_eq($jumped_x, 2551)
assert_eq($jumped_z, 3450)
stat_add(woodcutting, 98, 0);
inv_add(inv, dragon_hatchet, 1);
def_int $logs_before = inv_total(inv, logs);
test_op(oploc1, tree_1276, 0_39_53_56_58);
// A normal tree falls with its one log: wait for that, not the first
// message, which is the swing.
wait_for("loc_change", 20);
assert_called_with("mes", "You get some logs.");
def_int $logs_after = inv_total(inv, logs);
assert_gt($logs_after, $logs_before);
assert_called("loc_change", 1);

// ── Expected failure — low level cannot chop yew ──────────────
// Yew at Edgeville bank (x=2754, z=3433). Player teleport to tile west of it.
[label,test_wc_yew_requires_level]
setup_player("test_player");
p_telejump(0_43_53_1_41);
test_op(oploc1, yew, 0_43_53_2_41);
wait_for("mes", 5);
assert_called_with("mes", "You need a Woodcutting level of 60 to chop down this tree.");