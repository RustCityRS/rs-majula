// 4507
[clientscript,aif_dropdownbox_selectelement](int $int0, component $component1, component $component2)
def_string $string0 = "";
if (cc_find($component1, $int0) = true) {
    $string0 = cc_gettext;
}
cc_deleteall($component2);
cc_create($component2, ^iftype_text, if_getnextsubid($component2));
cc_settext($string0);
cc_settextfont(verdana_11pt_regular);
cc_setposition(5, 0, ^setpos_abs_left, ^setpos_abs_centre);
cc_setsize(5, 16384, ^setsize_minus, ^setsize_rel);
cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
cc_setcolour(^black);
