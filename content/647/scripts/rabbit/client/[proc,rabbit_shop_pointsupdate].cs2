// 2003
[proc,rabbit_shop_pointsupdate]
def_int $int0 = 0;
if (stat_base(farming) >= 40) {
    $int0 = %rabbit_score;
} else {
    $int0 = calc(%rabbit_score * enum(int, int, enum_1369, stat_base(farming)) / 100);
}
if (%rabbit_score = 1) {
    if_settext(rabbit_shop:xp_message, "Trade one point<br>for <tostring_localised($int0, true)> XP?");
} else {
    if_settext(rabbit_shop:xp_message, "Trade <tostring_localised(%rabbit_score, true)> points<br>for <tostring_localised($int0, true)> XP?");
}
cc_deleteall(rabbit_shop:items);
def_int $int1 = enum_getoutputcount(enum_1589);
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
def_int $int5 = 0;
def_obj $obj6 = null;
def_int $int7 = 0;
def_int $int8 = 0;
while ($int8 < $int1) {
    $obj6 = enum(int, namedobj, enum_1589, $int8);
    $int7 = enum(obj, int, enum_1365, $obj6);
    $int2 = calc($int8 % 9 * 50);
    $int3 = calc($int8 / 9 * 54);
    $int4, $int5 = max($int4, $int2), max($int5, $int3);
    cc_create(rabbit_shop:items, ^iftype_graphic, if_getnextsubid(rabbit_shop:items));
    cc_setsize(48, 52, ^setsize_abs, ^setsize_abs);
    cc_setposition($int2, $int3, ^setpos_abs_left, ^setpos_abs_top);
    cc_setgraphic("km_shoptile,0");
    if ($obj6 = grim_turnip_countview_5) {
        cc_setop(1, "Trade points for XP");
        cc_setonop("comp_sethide(false, rabbit_shop:xp_container)");
    } else {
        cc_setopbase("<col=ff981f><oc_name($obj6)></col>");
        cc_setop(1, "Value");
        cc_setop(2, "Buy 1");
        cc_setop(3, "Buy 5");
        cc_setop(4, "Buy 10");
        if ($obj6 ! rabbit_flag) {
            cc_setop(5, "Buy X");
        }
        cc_setop(10, "Examine");
    }
    cc_setonmouseover("cc_settrans(event_com, calc(cc_getid + 1), 0)");
    cc_setonmouseleave("cc_settrans(event_com, calc(cc_getid + 1), 255)");
    cc_create(rabbit_shop:items, ^iftype_graphic, if_getnextsubid(rabbit_shop:items));
    cc_setsize(48, 52, ^setsize_abs, ^setsize_abs);
    cc_setposition($int2, $int3, ^setpos_abs_left, ^setpos_abs_top);
    cc_setgraphic("km_shoptile,1");
    cc_settrans(255);
    cc_create(rabbit_shop:items, ^iftype_graphic, if_getnextsubid(rabbit_shop:items));
    if ($obj6 = grim_turnip_countview_5) {
        cc_setsize(34, 34, ^setsize_abs, ^setsize_abs);
        cc_setposition(calc($int2 + 7), calc($int3 + 2), ^setpos_abs_left, ^setpos_abs_top);
        if (map_lang = 1) {
            cc_setgraphic("xp_token,2");
        } else {
            cc_setgraphic("xp_token,0");
        }
    } else {
        cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
        cc_setposition(calc($int2 + 6), calc($int3 + 4), ^setpos_abs_left, ^setpos_abs_top);
        cc_setobject_nonum($obj6, 5);
        cc_setoutline(1);
    }
    cc_setgraphicshadow(0x302020);
    cc_create(rabbit_shop:items, ^iftype_graphic, if_getnextsubid(rabbit_shop:items));
    cc_setsize(12, 12, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc($int2 + 2), calc($int3 + 38), ^setpos_abs_left, ^setpos_abs_top);
    cc_setobject_nonum(rabbit_flag, 1);
    cc_create(rabbit_shop:items, ^iftype_text, if_getnextsubid(rabbit_shop:items));
    cc_setsize(31, 12, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc($int2 + 13), calc($int3 + 39), ^setpos_abs_left, ^setpos_abs_top);
    cc_settextfont(p11_full);
    cc_settextalign(^settextalign_right, ^settextalign_centre, 0);
    if ($int7 = -1) {
        cc_settext("N/A");
    } else {
        cc_settext(~tostring_shortform($int7));
    }
    if ($int7 <= %rabbit_score) {
        cc_setcolour(^yellow);
    } else {
        cc_setcolour(^red);
    }
    cc_settextshadow(true);
    $int8 = calc($int8 + 1);
}
$int4, $int5 = calc($int4 + 48), calc($int5 + 52);
def_int $int9 = if_getheight(rabbit_shop:items);
if_setsize(rabbit_shop:items, $int4, $int9, ^setsize_abs, ^setsize_abs);
if ($int5 > $int9) {
    if_setposition(rabbit_shop:items, calc((if_getwidth(rabbit_shop:items_container) - if_getwidth(rabbit_shop:items_scrollbar) - $int4) / 2), 0, ^setpos_abs_left, ^setpos_abs_centre);
    if_sethide(rabbit_shop:items_scrollbar, false);
    if_setscrollsize(rabbit_shop:items, 0, $int5);
    ~scrollbar_vertical(rabbit_shop:items_scrollbar, rabbit_shop:items, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
} else {
    if_setposition(rabbit_shop:items, 0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    if_sethide(rabbit_shop:items_scrollbar, true);
}
