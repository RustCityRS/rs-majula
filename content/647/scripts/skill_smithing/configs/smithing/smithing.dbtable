// 289's smithing table (skill_smithing/configs/smithing/smithing.dbtable).
// 2011's anvil interface (smithing_new, 300) shows each product in a slot of
// its own, where 289 transmitted inv columns (smithing.inv, not ported): slot
// is that slot's item, name and bars components, and bar is indexed, for the
// interface is filled from the bar used and a slot's button finds its row by
// the bar.
[smithing]
column=ifproduct,obj,INDEXED,REQUIRED
column=product,namedobj
column=product_amount,int
column=levelrequired,int
column=end_message,string
column=levelfailmessage,string
column=bar,namedobj,INDEXED
column=bar_amount,int
column=slot,component,component,component
