type=inv
default=null

[invcolumn3]
type=inv
default=null

[invcolumn4]
type=inv
default=null

[invcolumn5]
type=inv
default=null

[processfailure]
type=string
default=null

[bar_count]
type=int
default=1

[smithing_anvil_struct]
type=struct
default=null

[queueore_primary]
type=string
default=null

[queueore_secondary]
type=string
default=null
