// 289's [name] (string, null) param is name_text here: registered as name, it
// shadows the `name` command (the player's name) where names are strictly
// checked (#testscript), and every engine load failed.
[name_text]
type=string
default=null

[xpperbar]
type=int
default=0

[invcolumn1]
type=inv
default=null

[invcolumn2]
type=inv
default=null

[invcolumn3]
type=inv
default=null

[invcolumn4]
type=inv
default=null

[invcolumn5]
type=inv
default=null

[processfailure]
type=string
default=null

[bar_count]
type=int
default=1

[smithing_anvil_struct]
type=struct
default=null

[queueore_primary]
type=string
default=null

[queueore_secondary]
type=string
default=null
