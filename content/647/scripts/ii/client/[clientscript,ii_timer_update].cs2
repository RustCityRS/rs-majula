// 2909
[clientscript,ii_timer_update](component $component0, component $component1)
if (%ii_affinity_time_left = 0) {
    if_sethide($component0, true);
} else if (%ii_affinity_time_left < 5) {
    if_settext($component1, "<lt>1 min");
} else {
    if_settext($component1, "<tostring(calc((%ii_affinity_time_left + 4) / 5))> min");
}
