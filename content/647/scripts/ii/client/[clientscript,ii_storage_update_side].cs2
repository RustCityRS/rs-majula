// 2906
[clientscript,ii_storage_update_side](component $component0, obj $obj1, component $component2)
def_component $component3 = if_getlayer($component0);
def_int $int4 = 0;
if ($obj1 = hunting_butterfly_net) {
    $int4 = calc(inv_total(worn, ii_magic_butterfly_net) + inv_total(inv, ii_magic_butterfly_net));
    if ($int4 > 0) {
        $obj1 = ii_magic_butterfly_net;
    }
}
switch_obj ($obj1) {
    case hunting_butterfly_net, ii_magic_butterfly_net :
        if ($int4 = 0) {
            $int4 = calc(inv_total(inv, hunting_butterfly_net) + inv_total(worn, hunting_butterfly_net));
        }
    case default :
        $int4 = inv_total(inv, $obj1);
}
if_settext($component2, oc_name($obj1));
if ($int4 > 0) {
    if_setcolour($component2, ^yellow);
    if_setobject($component0, $obj1, $int4);
} else {
    if_setcolour($component2, 0xcc0000);
    if_setobject($component0, $obj1, -1);
}
if_setoutline($component0, 1);
