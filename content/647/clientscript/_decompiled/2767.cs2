[clientscript,script_2767](int $int0, int $int1)(int, string)
def_int $int2 = 0;
if (cc_find($int1, 0) = 1) {
    $int2 = sub($int0, clientclock);
    if ($int2 <= 0) {
        cc_settrans(0);
        cc_setontimer;
        return(-1, "");
