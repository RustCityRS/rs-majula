[clientscript,script_459](int $int0)
if (stat_base(attack) < 25) {
    if_settext("<col=c80000>" + "An Attack level of " + tostring(25) + " is required." + "</col>");
} else {
    if (%varbit2086 < 1) {
        if_settext("<col=c80000>" + "1 Commendation required." + "</col>");
    }
    if_settext(tostring(calc(pow(stat_base(attack), 2) / 600 * 35)) + " XP per Commendation.");
}
return;
