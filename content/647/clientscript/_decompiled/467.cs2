[clientscript,script_467](int $int0)
if (stat_base(prayer) < 25) {
    if_settext("<col=c80000>" + "A Prayer level of " + tostring(25) + " is required." + "</col>");
} else {
    if (%varbit2086 < 1) {
        if_settext("<col=c80000>" + "1 Commendation required." + "</col>");
    }
    if_settext(tostring(calc(pow(stat_base(prayer), 2) / 600 * 18)) + " XP per Commendation.");
}
return;
