[clientscript,script_1104]
if (is_unsigned = 0) {
    if_settext("When you have finished playing" + "<br>" + "RuneScape, always use a" + "<br>" + "button below to exit the game and logout safely.");
    if_settext("Exit to Lobby");
    if_setop(11927557, "Exit to Lobby");
    if_sethide(11927558);
    if_settext("Exit to Login");
    if_setop(11927562, "Exit to Login");
} else {
    if_settext("When you have finished playing" + "<br>" + "RuneScape, always use the" + "<br>" + "button below to exit the game and logout safely.");
    if_settext("Click here to log out");
    if_setop(11927557, "Logout");
    if_sethide(11927558);
}
return;
