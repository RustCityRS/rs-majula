[clientscript,script_4342](int $int0, int $int1, int $int2, int $int3, int $int4)
def_string $str0 = "";
def_string $str1 = "";
if (mod(clientclock, 3000) = 0) {
    $int1 = add($int1, 1);
    if ($int1 >= 60) {
        $int1 = 0;
        $int0 = add($int0, 1);
        if ($int0 >= 24) {
            $int0 = 0;
        }
    }
    if ($int0 < 10) {
        $str0 = "0" + tostring($int0);
    } else {
        $str0 = tostring($int0);
    }
    if ($int1 < 10) {
        $str1 = "0" + tostring($int1);
    } else {
        $str1 = tostring($int1);
    }
    if_settext($str0 + ":" + $str1);
    if_setontimer;
    $str1 = ~script_4341($int2, $int0, $int1);
    $str0 = ~script_4341($int2, $int0, $int1);
    if_settext($str0 + ":" + $str1);
} else {
    if (mod(clientclock, 50) = 0) {
        if ($int0 < 10) {
            $str0 = "0" + tostring($int0);
        } else {
            $str0 = tostring($int0);
        }
        if ($int1 < 10) {
            $str1 = "0" + tostring($int1);
        } else {
            $str1 = tostring($int1);
        }
        if (mod(clientclock, 100) = 0) {
            if_settext($str0 + ":" + $str1);
        } else {
            if_settext($str0 + " " + $str1);
        }
        $str1 = ~script_4341($int2, $int0, $int1);
        $str0 = ~script_4341($int2, $int0, $int1);
        if (mod(clientclock, 100) = 0) {
            if_settext($str0 + ":" + $str1);
        }
        if_settext($str0 + " " + $str1);
    }
}
return;
