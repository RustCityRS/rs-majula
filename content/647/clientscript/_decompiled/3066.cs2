[clientscript,script_3066](int $int0, int $int1, int $int2, int $int3, int $int4)
if ($int0 > 0) {
    if_setgraphic($int2);
    if_settext(tostring($int0));
    if ($int4 = 1) {
        if_setop($int2, "Click Here To Play");
        if_setonop;
    } else {
        if_clearops;
        if_setonop;
    }
    if_setonmouseover;
    if_setonmouseleave;
} else {
    if_setgraphic($int2);
    if_settext("");
    if_setonmouseover;
    if_setonmouseleave;
    if_setonop;
    if_clearops;
}
return;
