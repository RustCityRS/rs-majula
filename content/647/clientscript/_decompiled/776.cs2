    $int0 = div(%varbit7233, 60);
    $int1 = mod(%varbit7233, 60);
    $int2 = div(~script_338(16), 1000);
    $int3 = calc(~script_338(16) % 1000 / 100);
    if ($int1 < 10) {
        if ($int0 < 10) {
            $str1 = "0" + tostring($int0) + ":0" + tostring($int1);
        } else {
            $str1 = tostring($int0) + ":0" + tostring($int1);
