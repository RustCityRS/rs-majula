[clientscript,script_409]
%varc_int1364 = add(%varc_int1364, 1);
if (%varc_int1364 = 50) {
    if_settext("Opponent's Turn");
} else {
    if (%varc_int1364 = 100) {
        if_settext("Opponent's Turn.");
    }
    if (%varc_int1364 = 150) {
        if_settext("Opponent's Turn..");
    }
    if (%varc_int1364 >= 200) {
        if_settext("Opponent's Turn...");
        %varc_int1364 = 0;
    }
}
return;
