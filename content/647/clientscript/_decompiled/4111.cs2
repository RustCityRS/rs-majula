[clientscript,script_4111]
if (%varp1108 <= 3) {
    if_settext("If you selected the 'Buy' option, you would see this screen. You can choose an item to buy by clicking on the indicated box.");
    if_sethide(7209045);
    if_settext("N/A");
    if_sethide(7209028);
    if_settext("Choose an item to exchange");
    if_settext("1");
    if_settext("1 gp");
    if_settext("1 gp");
} else {
    if_settext("You can set how many you wish to buy, and the price you're willing to pay, before clicking the 'Confirm Offer' button. We'll suggest a guide price for the item, but you can offer whatever you like.");
    if_sethide(7209045);
    if_setobject_nonum;
    if_settext("1,281 gp");
    if_sethide(7209028);
    if_settext("Staff of air");
    if_settext("2");
    if_settext("1,281 gp");
    if_settext("2,562 gp");
}
return;
