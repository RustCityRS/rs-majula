[clientscript,script_99]
def_int $int0 = 5;
def_int $int1 = 5;
def_int $int2 = 0;
if ($int0 < 125) {
    if ($int1 < 120) {
        cc_setposition(0, 41353263, 5, $int2);
        cc_setsize(36, 32, 0, 0);
        cc_setposition2($int1, $int0, 0, 0);
        if (inv_getobj(inv_134, $int2) ! -1) {
            cc_setobject(inv_getobj(inv_134, $int2), inv_getnum(inv_134, $int2));
            cc_setopbase("<col=ff981f>" + oc_name(inv_getobj(inv_134, $int2)));
            cc_setop(1, "Remove 1");
            cc_setop(2, "Remove 5");
            cc_setop(3, "Remove 10");
            cc_setop(4, "Remove All");
            cc_setop(5, "Remove X");
            cc_setop(10, "Examine");
            cc_setgraphicshadow;
            cc_setoutline;
        }
        cc_setposition(0, 41353265, 5, $int2);
        cc_setsize(36, 32, 0, 0);
        cc_setposition2($int1, $int0, 0, 0);
        if (inv_getobj_alwaysnoted(inv_134, $int2) ! -1) {
            cc_setobject($int2, worldid);
            cc_setopbase("<col=ff981f>" + oc_name(inv_getobj_alwaysnoted(inv_134, $int2)));
            cc_setop(1, "Examine");
            cc_setgraphicshadow;
            cc_setoutline;
        }
        $int1 = add($int1, 40);
        $int2 = add($int2, 1);
    }
    $int0 = add($int0, 42);
    $int1 = 5;
}
return;
