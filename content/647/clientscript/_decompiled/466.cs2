[clientscript,script_466](int $int0)
if (stat_base(magic) < 25) {
    if_settext("<col=c80000>" + "A Magic level of " + tostring(25) + " is required." + "</col>");
} else {
    if (%varbit2086 < 1) {
        if_settext("<col=c80000>" + "1 Commendation required." + "</col>");
    }
    if_settext(tostring(calc(pow(stat_base(magic), 2) / 600 * 32)) + " XP per Commendation.");
}
return;
