if_settext(tostring(multiply(2, 10)));
if (stat_base(magic) < 83) {
    if_settext(tostring(calc(2 / 2 * 10)) + " (halved)");
} else {
    if_settext(tostring(multiply(2, 10)));
}
if (stat_base(magic) < 80) {
    if_settext(tostring(calc(12 / 2 * 10)) + " (halved)");
} else {
    if_settext(tostring(multiply(12, 10)));
}
if (stat_base(magic) < 86) {
    if_settext(tostring(calc(2 / 2 * 10)) + " (halved)");
} else {
    if_settext(tostring(multiply(2, 10)));
}
if (stat_base(magic) < 91) {
    if_settext(tostring(calc(10 / 2 * 10)) + " (halved)");
} else {
    if_settext(tostring(multiply(10, 10)));
}
if_settext("Magic and Farming");
if (stat_base(magic) < 83) {
    if_settext("Farming (no Magic)");
} else {
    if_settext("Magic and Farming");
}
if (stat_base(magic) < 80) {
    if_settext("Crafting (no Magic)");
} else {
    if_settext("Magic and Crafting");
}
if (stat_base(magic) < 86) {
    if_settext("Construction (no Magic)");
} else {
    if_settext("Magic and Construction");
}
if (stat_base(magic) < 91) {
