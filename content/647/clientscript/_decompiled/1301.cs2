[clientscript,script_1301](int $int0, int $int1)
def_int $int2 = 0;
if (getwindowmode >= 2) {
    if ($int2 < if_getchildcount($int0)) {
        if (cc_find($int0, $int2) = 1) {
            cc_setalpha(1);
        }
        $int2 = add($int2, 1);
    }
} else {
    if ($int2 < if_getchildcount($int0)) {
        if (cc_find($int0, $int2) = 1) {
            cc_setalpha(0);
        }
        $int2 = add($int2, 1);
    }
}
return;
