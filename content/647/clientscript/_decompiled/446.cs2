[clientscript,script_446](int $int0, int $int1)(string)
def_string $str0 = "";
def_string $str1 = "";
def_string $str2 = "";
if (oc_stackable($int1) = 0) {
    $str2 = append($str2, "<col=ff981f>" + oc_name($int1) + "<col=ffffff>" + " x " + "<col=fff000>" + tostring($int0) + "<br>");
} else {
    if ($int0 < 100000) {
        $str0 = ~script_46($int0, ",");
        $str2 = append($str2, "<col=ff981f>" + oc_name($int1) + "<col=ffffff>" + " x " + "<col=fff000>" + $str0 + "<br>");
    }
    $str0 = ~script_46($int0, ",");
    $str1 = ~script_46(div($int0, 1000), ",");
    $str2 = append($str2, "<col=ff981f>" + oc_name($int1) + "<col=ffffff>" + " x " + "<col=ffffff>" + $str1 + "K (" + $str0 + ")" + "<br>");
}
return($str2);
