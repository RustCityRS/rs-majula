[clientscript,script_43]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
if ($int0 < inv_size(trail_rewardinv)) {
    cc_setposition(0, 23855108, 5, $int0);
    cc_setsize(36, 32, 0, 0);
    cc_setposition2(multiply(40, $int1), multiply(40, $int2), 0, 0);
    if (inv_getobj(trail_rewardinv, $int0) ! -1) {
        cc_setobject(inv_getobj(trail_rewardinv, $int0), inv_getnum(trail_rewardinv, $int0));
        cc_setopbase("<col=ff9040>" + oc_name(inv_getobj(trail_rewardinv, $int0)));
        cc_setop(1, "Examine");
        cc_setoutline;
    }
    $int0 = add($int0, 1);
    $int1 = add($int1, 1);
    if ($int1 = 3) {
        $int1 = 0;
        $int2 = add($int2, 1);
    }
}
return;
