[clientscript,script_1415]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
if ($int0 <= inv_size(inv)) {
    cc_setposition(0, 21168133, 5, $int0);
    cc_setsize(36, 32, 0, 0);
    cc_setposition2(calc(5 + 40 * $int1), multiply(40, $int2), 0, 0);
    if (inv_getobj(inv, $int0) ! -1) {
        cc_setobject(inv_getobj(inv, $int0), inv_getnum(inv, $int0));
        cc_setopbase("<col=ff9040>" + oc_name(inv_getobj(inv, $int0)));
        cc_setop(1, "<col=00ff00>" + "Value");
        cc_setop(2, "Pack " + "<col=ff0000>" + "1");
        cc_setop(3, "Pack " + "<col=ff0000>" + "5");
        cc_setop(4, "Pack " + "<col=ff0000>" + "All");
        cc_setop(5, "Pack " + "<col=ff0000>" + "X");
        cc_setop(10, "Examine");
    }
    $int0 = add($int0, 1);
    $int1 = add($int1, 1);
    if ($int1 > 6) {
        $int1 = 0;
        $int2 = add($int2, 1);
    }
}
return;
