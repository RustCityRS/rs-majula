[clientscript,script_144](int $int0, int $int1, int $int2, int $int3)
def_int $int4 = 0;
if (cc_find($int0, $int1) = 1) {
    if (clientclock >= $int3) {
        cc_delete;
        return;
    }
    if (mod(clientclock, 40) < 20) {
        $int4 = sub(clientclock, $int2);
        $int4 = multiply($int4, 255);
        $int4 = calc($int4 / $int3 - $int2);
        cc_settrans($int4);
    }
    cc_settrans(255);
}
return;
