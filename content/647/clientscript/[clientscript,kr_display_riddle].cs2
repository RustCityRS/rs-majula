L61: push_constant_string "<br>"
L62: push_constant_string "<br>"
L63: push_constant_string "Three boxes contain only air,"
L64: push_constant_string "<br>"
L65: push_constant_string "beware of three boxes, for danger lurks there."
L66: push_constant_string "<br>"
