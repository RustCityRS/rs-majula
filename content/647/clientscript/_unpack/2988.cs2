   46: push_constant_string "Shadow jadinko"
   47: pop_string_local 0
   48: push_constant_string "This species of jadinko is particularly sinister, tied as it is with darkness. Shadow jadinkos produce shadow vines which are useful for those who want to be more stealthy when hunting."
   49: push_constant_string "<br>"
   50: push_constant_string "<br>"
   51: push_constant_string "These jadinkos are caught by tracking."
