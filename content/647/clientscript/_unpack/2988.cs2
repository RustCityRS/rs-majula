  189: push_constant_string "Camouflaged jadinko"
  190: pop_string_local 0
  191: push_constant_string "The camouflaged jadinko is a stealthy critter that takes great delight in hiding itself in foliage. The magic of its striped vines is particularly odd and cannot be turned into a potion; however, Papa Mambo has mentioned that he has uses for these vines."
  192: push_constant_string "<br>"
  193: push_constant_string "<br>"
  194: push_constant_string "These jadinkos are caught by tracking."
  195: join_string 4
  196: pop_string_local 1
  197: push_constant_string "To attract camouflaged jadinkos:"
  198: push_constant_string "<br>"
  199: push_constant_string "<br>"
  200: push_constant_string "grow a lergberry bush and build standing stones. In addition, you must be under the effects of the juju hunter potion."
  201: join_string 4
