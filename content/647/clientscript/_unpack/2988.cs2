   25: push_constant_string "Common jadinko"
   26: pop_string_local 0
   27: push_constant_string "The most abundant form of jadinko. The common jadinkos lack the magical properties of their counterparts; however, they are the easiest of all the jadinkos to attract."
   28: push_constant_string "<br>"
   29: push_constant_string "<br>"
   30: push_constant_string "These jadinkos are caught with marasamaw plants."
   31: join_string 4
