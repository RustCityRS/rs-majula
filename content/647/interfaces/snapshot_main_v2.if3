// 594:156
[respect_help_txt]
type=text
x=33
y=87
width=443
height=169
layer=respect_help_border_layer
textfont=p11_full
text=There's no need to report anyone for using the term 'noob', it simply means 'new player'.<br><br>Seriously offensive language includes racism and chat of a sexual nature.<br><br>You don't need to report players for using abbreviations such as 'lmao', 'wtf', 'gtfo'.<br><br>You shouldn't report any chat that has been starred out (like this: ****), as the censor has prevented anything that may have been offensive from being seen.<br><br>Solicitation includes asking for a boyfriend or girlfriend in-game.<br><br>Disruptive behaviour includes flooding the chat window with lines of unnecessary chat, but only if you feel it's impairing your gameplay.<br><br>Beware of context when reporting players for real-life threats: they could be talking about in-game combat!
textshadow=yes
colour=0xffffc8
transmitop=10
op10=  

