// 767:16
[com_16]
type=text
x=56
y=15
width=391
height=79
layer=com_46
textfont=p12_full
text=Item/note withdrawal: Clicking this button toggles how you withdraw items from your bank. `Item' mode places the actual item in your inventory; `Note' mode places a `noted' version of that object in your inventory. A note is worth the exact same value as the item it depicts, but is not the item itself and cannot be used as such. Notes are typically used for trading in bulk, as noted items can be stacked even if the actual item cannot be.
textshadow=yes
transmitop=10
op10= 

// 767:17
[com_17]
type=text
x=56
y=111
width=391
height=79
layer=com_46
textfont=p12_full
text=Deposit carried items and worn items. One button empties all of the items from your inventory, while the other moves all of the items you are wearing into your bank, if there is space. Items that cannot be placed in your bank will stay where they are.    
textshadow=yes
transmitop=10
op10=  

