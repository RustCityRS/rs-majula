// 597:0
[com_0]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
colour=0x000000
fill=yes
trans=150

// 597:1
[killcounts]
type=layer
x=10
y=10
width=100
height=75
xmode=abs_right
onload=godwars_overlay_init(event_com, had_infoicon03:title, had_infoicon03:armadyl, had_infoicon03:bandos, had_infoicon03:saradomin, had_infoicon03:zamorak, had_infoicon03:armadyl_total, had_infoicon03:bandos_total, had_infoicon03:saradomin_total, had_infoicon03:zamorak_total, had_infoicon03:saradomin_total, had_infoicon03:saradomin_total)

