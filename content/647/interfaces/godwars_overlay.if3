// 601:0
[killcounts]
type=layer
x=10
y=10
width=100
height=90
xmode=abs_right
onload=godwars_overlay_init(event_com, godwars_overlay:title, godwars_overlay:armadyl, godwars_overlay:bandos, godwars_overlay:saradomin, godwars_overlay:zamorak, godwars_overlay:armadyl_total, godwars_overlay:bandos_total, godwars_overlay:saradomin_total, godwars_overlay:zamorak_total, godwars_overlay:zaros, godwars_overlay:zaros_total)

// 601:1
[tint_box]
type=rectangle
width=16384
height=16384
widthmode=proportion
heightmode=proportion
colour=0x010000
fill=yes
trans=255
ontimer=script1170

// 601:2
[title]
type=text
height=15
widthmode=minus
xmode=abs_centre
layer=killcounts
textfont=p11_full
text=Killcounts
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff981f

// 601:3
