// 768:0
[content_layer]
type=layer
width=88
height=122
xmode=abs_right
onload=boardgames_rank_update(boardgames_rank_overlay:game_name, boardgames_rank_overlay:rank, boardgames_rank_overlay:draughts_board, boardgames_rank_overlay:runelink_board, boardgames_rank_overlay:runesquares_board, boardgames_rank_overlay:runeversi_board)
onvartransmit=boardgames_rank_update(boardgames_rank_overlay:game_name, boardgames_rank_overlay:rank, boardgames_rank_overlay:draughts_board, boardgames_rank_overlay:runelink_board, boardgames_rank_overlay:runesquares_board, boardgames_rank_overlay:runeversi_board){boardgames_draughts_rank, boardgames_runelink_rank, boardgames_runesquares_rank, boardgames_runeversi_rank}
onvarctransmit=boardgames_rank_update(boardgames_rank_overlay:game_name, boardgames_rank_overlay:rank, boardgames_rank_overlay:draughts_board, boardgames_rank_overlay:runelink_board, boardgames_rank_overlay:runesquares_board, boardgames_rank_overlay:runeversi_board){boardgames_area}

