// 599:0
[com_0]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
colour=0x000000
fill=yes
trans=175

// 599:1
[killcounts]
type=layer
x=10
y=10
width=100
height=75
xmode=abs_right
onload=godwars_overlay_init(event_com, had_infoicon02:title, had_infoicon02:armadyl, had_infoicon02:bandos, had_infoicon02:saradomin, had_infoicon02:zamorak, had_infoicon02:armadyl_total, had_infoicon02:bandos_total, had_infoicon02:saradomin_total, had_infoicon02:zamorak_total, had_infoicon02:saradomin_total, had_infoicon02:saradomin_total)

// 599:2
[title]
type=text
height=15
widthmode=minus
xmode=abs_centre
layer=killcounts
textfont=p11_full
text=Killcounts
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff981f

