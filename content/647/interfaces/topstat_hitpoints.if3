tiling=yes
colour=0x000000

// 748:7
[icon]
type=graphic
width=19
height=19
xmode=abs_centre
ymode=abs_centre
layer=globe
graphic="topstat_icon,0"
tiling=yes
colour=0x000000
ontimer=topstat_flash_hitpoints_icon

// 748:8
[text]
