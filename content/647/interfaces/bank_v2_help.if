[com976583]
type=text
x=12
y=5
width=436
height=82
parent_id=com34
text_font=p12_full
text=Using this tab system will allow you to easily group together related items as you wish. For instance, you could place all of your food in one tab, or all of your weapons in another. Alternatively, you could create a tab to contain all of those items you use to train a skill or play a certain activity. There is no limit to the number of times you can rearrange your bank, so feel free to experiment. 
text_shadow=yes
color=16777215

