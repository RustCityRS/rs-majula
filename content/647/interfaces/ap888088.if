parent_id=com31
text_font=q8_full
text=A real Jagex Moderator would never ask for a player's account details. You can always tell who an official moderator is as a gold crown will appear before anything they say in the chat window. You can report any player who claims to be a member of Jagex staff by using the Report Abuse button. You can also use the ignore button, which can be found at the bottom of your game window. 
text_shadow=yes
color=10785401

