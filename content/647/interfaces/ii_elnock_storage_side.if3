// 527:2
[impling_repellent]
type=layer
height=5372
widthmode=minus
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=container

// 527:3
[impling_repellent_name]
type=text
y=-23
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=impling_repellent
textfont=p12_full
text=Imp repellent
textalignh=centre
textshadow=yes
colour=0x872300

// 527:4
[impling_repellent_store]
type=graphic
y=8
width=36
height=32
xmode=abs_centre
ymode=abs_centre
layer=impling_repellent
outline=1
graphicshadow=1
colour=0xffffffff
transmitop=1,2,3,4,10
opbase=<col=ff9040>Impling jar
op1=Store 1
op2=Store 5
op3=Store All
op4=Store X
op10=Examine
onload=ii_storage_update_side(event_com, ii_imp_repellent, ii_elnock_storage_side:impling_repellent_name)
oninvtransmit=ii_storage_update_side(event_com, ii_imp_repellent, ii_elnock_storage_side:impling_repellent_name){inv}

