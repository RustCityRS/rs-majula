// 481:6
[wetwilly_layer]
type=layer
x=7
y=61
width=66
height=66
layer=bounds
onmouseleave=deltooltip(acs_bar_overlay:tooltip)
onmouserepeat=addtooltip(event_com, acs_bar_overlay:tooltip, "Wet willy: Lick your finger and poke it in the zombie's ear. Greatly increases zombie's stress level. Long cooldown.", 10, 250)

// 481:7
[nosepinch_layer]
type=layer
x=75
y=61
width=66
height=66
layer=bounds
onmouseleave=deltooltip(acs_bar_overlay:tooltip)
onmouserepeat=addtooltip(event_com, acs_bar_overlay:tooltip, "Nose pinch: Pinch the zombie's nose hard. Slightly increases zombie's stress level and makes his nose sore, doubling the effect of a pig nose attack if used a short time after.", 10, 250)

// 481:8
[pignose_layer]
type=layer
x=143
y=61
width=66
height=66
layer=bounds
onmouseleave=deltooltip(acs_bar_overlay:tooltip)
onmouserepeat=addtooltip(event_com, acs_bar_overlay:tooltip, "Pig nose: Stick your fingers in the zombie's nose and pull up. Moderately increases stress level. Effect doubled if used immediately after a nose pinch.", 10, 250)

// 481:9
