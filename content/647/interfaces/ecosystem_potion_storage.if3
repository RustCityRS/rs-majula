// 513:0
[com_0]
type=rectangle
x=4
y=4
width=355
height=240
xmode=abs_centre
ymode=abs_centre
colour=0x000000
fill=yes
trans=192

// 513:1
[contents]
type=layer
width=355
height=240
xmode=abs_centre
ymode=abs_centre
onload=script1087(event_com, 22)

// 513:2
[background]
type=graphic
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=contents
graphic=tradebacking
tiling=yes

// 513:3
[title]
type=text
y=4
width=320
height=27
xmode=abs_centre
layer=contents
textfont=b12_full
text=Amazing Potion Storage
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff9900

// 513:4
[close_button]
type=graphic
x=9
y=9
width=16
height=16
xmode=abs_right
layer=contents
graphic="v2_stone_close_button,0"
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "v2_stone_close_button,1")
onmouseleave=graphic_swapper(event_com, "v2_stone_close_button,0")
onop=closebutton_click

// 513:5
[hunter]
type=layer
x=10
y=40
width=149
height=61
layer=contents

// 513:6
[hunter_name]
type=text
height=32
widthmode=minus
heightmode=minus
layer=hunter
textfont=p12_full
textalignh=centre
textalignv=bottom
textshadow=yes
colour=0xeae7c4

// 513:7
[hunter_remove]
type=graphic
width=36
height=32
xmode=abs_centre
ymode=abs_bottom
layer=hunter
outline=1
graphicshadow=1
transmitop=1,2,3,4,10
opbase=<col=ff9040>Juju hunter potion
op1=Remove-1
op2=Remove-5
op3=Remove-All
op4=Remove-X
op10=Examine
onload=script2958(event_com, 3doseadvanced_hunter_potion, 30, ecosystem_potion_storage:hunter_name)
onmouseover=script2959(event_com)
onvartransmit=script2958(event_com, 3doseadvanced_hunter_potion, 30, ecosystem_potion_storage:hunter_name){varplayer_1935}

