// 200:0
[display]
type=layer
y=4
width=6
height=24
widthmode=minus
heightmode=minus
xmode=abs_centre
transmitop=10
op10= 
onload=chatmodal_build(event_com, chatmodal:text_layer, chatmodal:scrollbar)
onvartransmit=chatmodal_build(event_com, chatmodal:text_layer, chatmodal:scrollbar){option_mouse}
onvarcstrtransmit=chatmodal_build(event_com, chatmodal:text_layer, chatmodal:scrollbar){varclient_1838, varclient_1839}

// 200:1
[text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=display
transmitop=10
op10= 

// 200:2
[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=display
transmitop=10
op10= 

// 200:3
[continue]
type=layer
width=506
height=20
ymode=abs_bottom

// 200:4
[continue_text]
type=text
width=250
height=20
xmode=abs_centre
ymode=abs_centre
layer=continue
textfont=tutorial_font
text=Click here to continue
textalignh=centre
textalignv=centre
colour=0x0000cc
pausebutton=yes
pausetext=Click here to continue
onmouseover=text_colour_swapper(event_com, ^white)
onmouseleave=text_colour_swapper(event_com, ^blue)
