// 428:0
[hourglass_layer]
type=layer
x=10
width=100
height=128
xmode=abs_right
onload=ntk_text(ntk_overlay:roomnumber, ntk_overlay:levelreq)
onvartransmit=ntk_text(ntk_overlay:roomnumber, ntk_overlay:levelreq){ntk_var_temp}

// 428:1
[bottom]
type=model
width=88
height=37
xmode=abs_centre
ymode=abs_bottom
layer=hourglass_layer
model=model_16351
modelorigin=-7,4
modelangle=124,0,0
modelzoom=656

// 428:2
[sand]
type=model
x=16
y=15
width=53
height=97
layer=hourglass_layer
model=model_16353
modelorigin=0,51
modelangle=133,0,0
modelzoom=656

// 428:3
[top]
type=model
width=95
height=118
xmode=abs_centre
layer=hourglass_layer
model=model_16352
modelorigin=-7,52
modelangle=133,0,0
modelzoom=656

// 428:4
[roomnumber]
type=text
x=-6
y=-7
height=8192
widthmode=minus
heightmode=proportion
xmode=abs_centre
layer=hourglass_layer
textfont=menu_font_small
textlineheight=16
textalignh=centre
textalignv=centre
textshadow=yes

// 428:5
[levelreq]
type=text
x=-6
height=8192
widthmode=minus
heightmode=proportion
xmode=abs_centre
ymode=abs_bottom
layer=hourglass_layer
textfont=menu_font_small
textlineheight=16
textalignh=centre
textalignv=centre
textshadow=yes

// 428:6
[timerbar_layer]
type=layer
x=4
y=10
width=12
height=110
xmode=abs_right
onload=ntk_timer(ntk_overlay:timerbar, ntk_overlay:border, ntk_overlay:sand)
onvartransmit=ntk_timer(ntk_overlay:timerbar, ntk_overlay:border, ntk_overlay:sand){ntk_var2}

// 428:7
[com_7]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=timerbar_layer
colour=0x000000
fill=yes

// 428:8
[border]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=timerbar_layer
colour=0xa4a429

// 428:9
[timerbar_container]
type=layer
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=timerbar_layer

// 428:10
[timerbar]
type=rectangle
height=16391
widthmode=minus
heightmode=proportion
xmode=abs_centre
ymode=abs_bottom
layer=timerbar_container
colour=0xa4a429
fill=yes
