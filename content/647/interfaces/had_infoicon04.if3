// 598:0
[com_0]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
colour=0x000000
fill=yes
trans=100

// 598:1
[killcounts]
type=layer
x=10
y=10
width=100
height=75
xmode=abs_right
onload=godwars_overlay_init(event_com, had_infoicon04:title, had_infoicon04:armadyl, had_infoicon04:bandos, had_infoicon04:saradomin, had_infoicon04:zamorak, had_infoicon04:armadyl_total, had_infoicon04:bandos_total, had_infoicon04:saradomin_total, had_infoicon04:zamorak_total, had_infoicon04:saradomin_total, had_infoicon04:saradomin_total)

