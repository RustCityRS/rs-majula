ymode=abs_centre
layer=universe
graphic=tradebacking
tiling=yes
colour=0x000000
opbase= 

// 793:2
[close]
type=graphic
x=9
y=9
width=16
height=16
xmode=abs_right
layer=universe
graphic="v2_stone_close_button,0"
colour=0x000000
transmitop=1
op1=Close
onload=clanwars_ffa_warning_setup(clanwars_ffa_warning:title, clanwars_ffa_warning:text, clanwars_ffa_warning:left_symbol, clanwars_ffa_warning:right_symbol, clanwars_ffa_warning:nomorewarnings, clanwars_ffa_warning:toggleicon)
onmouseover=graphic_swapper(event_com, "v2_stone_close_button,1")
onmouseleave=graphic_swapper(event_com, "v2_stone_close_button,0")
onvartransmit=clanwars_ffa_warning_setup(clanwars_ffa_warning:title, clanwars_ffa_warning:text, clanwars_ffa_warning:left_symbol, clanwars_ffa_warning:right_symbol, clanwars_ffa_warning:nomorewarnings, clanwars_ffa_warning:toggleicon){clanwars}
onop=closebutton_click

