// 838:0
[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=sidebook_build(event_com, sidebook:titlelayer, sidebook:textlayer)
onvarctransmit=sidebook_build(sidebook:universe, sidebook:titlelayer, sidebook:textlayer){sidebook_currentpage}

// 838:1
[titlelayer]
type=layer
height=28
widthmode=minus
xmode=abs_centre
layer=universe

// 838:2
[textlayer]
type=layer
y=31
height=211
widthmode=minus
xmode=abs_centre
layer=universe

// 838:3
[com_3]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=textlayer
graphic=tradebacking_dark
tiling=yes
colour=0x000000

// 838:4
[com_4]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=titlelayer
graphic=tradebacking
tiling=yes
colour=0x000000

// 838:5
[title]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=titlelayer
textfont=b12_full
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff991f

// 838:6
[close]
type=graphic
x=6
width=16
height=16
xmode=abs_right
ymode=abs_centre
layer=titlelayer
graphic="v2_stone_close_button,0"
colour=0x000000
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "v2_stone_close_button,1")
onmouseleave=graphic_swapper(event_com, "v2_stone_close_button,0")

