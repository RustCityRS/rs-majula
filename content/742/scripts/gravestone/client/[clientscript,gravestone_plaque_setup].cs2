// 663
[clientscript,gravestone_plaque_setup](component $component0, component $component1, component $component2, component $component3)
if_settextfont($component0, barbassault_font);
if_settextalign($component0, ^settextalign_centre, ^settextalign_centre, 0);
if (%gravestone_transmit = 0) {
    if_setgraphic($component1, graphic_13087);
    if_setgraphic($component2, graphic_13088);
    if_setgraphic($component3, graphic_13089);
    if_setcolour($component0, ~rgb_to_hex(242, 242, 242));
} else if (%gravestone_transmit = 1) {
    if_setgraphic($component1, graphic_13084);
    if_setgraphic($component2, graphic_13085);
    if_setgraphic($component3, graphic_13086);
    if_setcolour($component0, ~rgb_to_hex(242, 242, 242));
}
