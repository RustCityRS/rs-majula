// 2224
[clientscript,easter10_nuts_up_arrow]
if (%easter10_chocworkers < 15 & ~easter10_get_assigned_worker_total < %easter10_totalworkers) {
    sound_synth(synth_8729, 1, 0);
    %easter10_nutworkers = calc(%easter10_nutworkers + 1);
} else {
    %easter10_resourcegame_errortextflag = 1;
    sound_vorbis_volume(vorbis_10046, 1, 0, 255);
}
~script2220;
