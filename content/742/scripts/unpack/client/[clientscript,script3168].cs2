// 3168
[clientscript,script3168](component $component0, int $int1, int $int2, string $string0, int $int3, int $int4)
def_int $int5 = 0;
def_int $int6 = 0;
if (clientclock > $int2 & cc_find($component0, $int1) = true) {
    if_sethide(lobbyscreen_pane_clanchat:clan_tooltip, false);
    if_settext(lobbyscreen_pane_clanchat:clan_tooltip_text, $string0);
    if_setsize(lobbyscreen_pane_clanchat:clan_tooltip, calc(if_getx(lobbyscreen_pane_clanchat:clan_tooltip_text) * 2 + stringwidth($string0, p12_full)), if_getheight(lobbyscreen_pane_clanchat:clan_tooltip), ^setsize_abs, ^setsize_abs);
    $int5 = calc(cc_getx + $int3 + 3 - if_getscrollx($component0));
    $int6 = calc(cc_gety + $int4 + if_gety(lobbyscreen_pane_clanchat:clan_content) + if_gety(lobbyscreen_pane_clanchat:clan_main) - 3 - if_getheight(lobbyscreen_pane_clanchat:clan_tooltip) - if_getscrolly(lobbyscreen_pane_clanchat:clan_main));
    if (calc($int5 + if_getwidth(lobbyscreen_pane_clanchat:clan_tooltip)) > if_getwidth(lobbyscreen_pane_clanchat:clan_upper)) {
        $int5 = calc(if_getwidth(lobbyscreen_pane_clanchat:clan_upper) - if_getwidth(lobbyscreen_pane_clanchat:clan_tooltip));
    }
    if ($int6 < 0) {
        $int6 = 0;
    }
    if_setposition(lobbyscreen_pane_clanchat:clan_tooltip, $int5, $int6, ^setpos_abs_left, ^setpos_abs_top);
    cc_setonmouserepeat(null);
}
return;
