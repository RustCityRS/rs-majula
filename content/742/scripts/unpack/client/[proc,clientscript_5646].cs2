// 5646
[proc,clientscript_5646](component $component0, int $int1, int $int2)
if ($int2 = 1) {
    if ($int1 = 1) {
        if_setgraphic($component0, 9194);
    } else {
        if_setgraphic($component0, 9193);
    }
} else if ($int1 = 1) {
    if_setgraphic($component0, "combatboxes_very_large,1");
} else {
    if_setgraphic($component0, "combatboxes_very_large,0");
}
