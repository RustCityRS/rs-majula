// 5510
[proc,clientscript_5510](component $component0, component $component1, int $int2, int $int3)
if ($int3 = 1) {
    if_setscrollsize($component1, 0, calc($int2 + if_getheight($component1)));
} else {
    if_setscrollsize($component1, 0, $int2);
}
~clientscript_5509($component0, $component1, if_getscrolly($component1));
