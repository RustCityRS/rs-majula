// 5955
[proc,clientscript_5955]
if (clientclock < %throbber_last) {
    return;
}
%throbber_last = calc(clientclock + 5);
switch_graphic (if_getgraphic(interface_1255:com_1)) {
    case "loading_wheel_1,0" :
        if_setgraphic(interface_1255:com_1, "loading_wheel_1,1");
    case "loading_wheel_1,1" :
        if_setgraphic(interface_1255:com_1, "loading_wheel_1,2");
    case "loading_wheel_1,2" :
        if_setgraphic(interface_1255:com_1, "loading_wheel_1,3");
    case "loading_wheel_1,3" :
        if_setgraphic(interface_1255:com_1, "loading_wheel_1,4");
    case "loading_wheel_1,4" :
        if_setgraphic(interface_1255:com_1, "loading_wheel_1,5");
    case "loading_wheel_1,5" :
        if_setgraphic(interface_1255:com_1, "loading_wheel_1,6");
    case "loading_wheel_1,6" :
        if_setgraphic(interface_1255:com_1, "loading_wheel_1,7");
    case "loading_wheel_1,7" :
        if_setgraphic(interface_1255:com_1, "loading_wheel_1,0");
    case default :
        if_setgraphic(interface_1255:com_1, "loading_wheel_1,0");
}
