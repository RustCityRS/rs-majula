// 5758
[proc,clientscript_5758](component $component0)
if (if_find($component0) = true) {
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_setsize(16, 15, ^setsize_abs, ^setsize_abs);
    cc_setgraphic(graphic_8339);
    cc_setonmouseover("aif_component_fade_set($component0, 0)");
    cc_setonmouseleave("aif_component_fade_set($component0, 1)");
    cc_settrans(255);
}
