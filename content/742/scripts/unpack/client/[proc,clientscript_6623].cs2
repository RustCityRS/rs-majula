// 6623
[proc,clientscript_6623](int $int0, int $int1, graphic $graphic2, component $component3)
if (clientclock < $int0) {
    if (calc(clientclock % 11) = 0) {
        if ($int1 = 1) {
            if_setgraphic($component3, $graphic2);
            $int1 = 0;
        } else {
            if_setgraphic($component3, null);
            $int1 = 1;
        }
    }
    if_setontimer($component3, "clientscript_6623($int0, $int1, $graphic2, $component3)");
} else {
    if_setgraphic($component3, null);
    if_setontimer($component3, null);
}
