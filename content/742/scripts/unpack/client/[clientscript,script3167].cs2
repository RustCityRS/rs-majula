// 3167
[clientscript,script3167](component $component0, int $int1, string $string0)
def_component $component2 = lobbyscreen_pane_clanchat:clan_active_bg;
if (cc_find($component0, $int1) = true) {
    if_sethide($component2, false);
    if_setposition($component2, if_getx($component2), cc_gety, ^setpos_abs_left, ^setpos_abs_top);
    cc_setonmouserepeat("script3168($component0, $int1, calc(clientclock + 25), $string0, event_mousex, event_mousey)");
}
