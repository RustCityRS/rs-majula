if (if_getwidth(interface_1126:com_124) < $int0) {
    if_setsize(interface_1126:com_124, calc(if_getwidth(interface_1126:com_124) + 1), if_getheight(interface_1126:com_124), ^setsize_abs, ^setsize_abs);
}
