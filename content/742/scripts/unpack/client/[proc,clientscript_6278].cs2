// 6278
[proc,clientscript_6278](int $int0, component $component1, component $component2)
if ($int0 = 0) {
    if_settext($component1, "- ACTIVE -");
    if_setcolour($component2, ^red);
    if_settrans($component2, 200);
} else if ($int0 = 1) {
    if_settext($component1, "Activate");
    if_setcolour($component2, 0x9d4e24);
    if_settrans($component2, 200);
} else if ($int0 = 2) {
    if_settext($component1, "Buy");
} else if ($int0 = 3) {
    if_settext($component1, "Bought");
    if_setcolour($component2, 0x9d4e24);
    if_settrans($component2, 200);
} else if ($int0 = 4) {
    if_settext($component1, "Locked");
}
