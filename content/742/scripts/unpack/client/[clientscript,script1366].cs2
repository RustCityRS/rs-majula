// 1366
[clientscript,script1366](component $component0, component $component1)
if (%castlewars_timer = 25) {
    if_settext($component0, "Time until next game starts: 0");
    if_sethide($component1, true);
} else if (%castlewars_timer > 0) {
    if_settext($component0, "Time until next game starts: <tostring(%castlewars_timer)>");
    if (%castlewars_timer <= 15 & %castlewars_timer >= 6) {
        if_sethide($component1, false);
    } else {
        if_sethide($component1, true);
    }
} else {
    if_settext($component0, "Waiting for players to join the other team.");
    if_sethide($component1, true);
}
