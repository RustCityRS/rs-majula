// 6308
[proc,clientscript_6308](int $int0, int $int1, int $int2)
def_int $int3 = max(1, calc($int1 - $int0));
def_int $int4 = calc(255 / $int3 + 1);
if (if_gethide(interface_1301:com_7) = true) {
    if_sethide(interface_1301:com_7, false);
}
if (if_gethide(interface_1301:com_9) = true) {
    if_sethide(interface_1301:com_9, false);
} else if (clientclock < $int2 & clientclock >= $int1) {
    if (clientclock >= calc($int1 + 25)) {
        if_sethide(interface_1301:com_7, true);
        if_sethide(interface_1301:com_8, true);
        if_sethide(interface_1301:com_9, true);
    }
} else if (clientclock >= $int2) {
    if (if_gethide(interface_1301:com_7) = false) {
        if_sethide(interface_1301:com_7, true);
    }
    if (if_gethide(interface_1301:com_8) = false) {
        if_sethide(interface_1301:com_8, true);
    }
    if (if_gethide(interface_1301:com_9) = false) {
        if_sethide(interface_1301:com_9, true);
    }
    if (if_gettrans(interface_1301:com_0) < 255) {
        if_settrans(interface_1301:com_0, min(255, calc(if_gettrans(interface_1301:com_0) + 10)));
        if_settrans(interface_1301:com_1, min(255, calc(if_gettrans(interface_1301:com_1) + 10)));
        if_settrans(interface_1301:com_2, min(255, calc(if_gettrans(interface_1301:com_2) + 10)));
        if_settrans(interface_1301:com_5, min(255, calc(if_gettrans(interface_1301:com_5) + 10)));
    } else {
        cc_deleteall(interface_1301:com_3);
        if_setontimer(interface_1301:com_6, null);
        if_sethide(interface_1301:com_4, true);
    }
}
