// 2785
[proc,script2785](maparea $maparea0)(maparea)
switch_maparea ($maparea0) {
    case tutorial3_1, tutorial3_2, tutorial3_3 :
        if (%tutorial < 93) {
            return(tutorial3_1);
        }
        if (%tutorial < 120) {
            return(tutorial3_2);
        }
        return(tutorial3_3);
    case carni_sewervariants :
        %worldmap_focus = movecoord(0_28_99_0_0, 24, 0, 8);
        return(ardougne_underground);
}
return($maparea0);
