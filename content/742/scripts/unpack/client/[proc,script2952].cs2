// 2952
[proc,script2952](component $component0, component $component1, int $int2)
def_string $string0 = "";
def_string $string1 = "";
switch_int ($int2) {
    case 3 :
        $string0 = "accountappeal";
        $string1 = "passwordchoice.ws";
        if_setonclick($component0, "loginscreen_link($string0, $string1, true)");
        if_setonclick($component1, "login_popup_close");
    case 4 :
        $string0 = "www";
        $string1 = "account_settings.ws?mod=messages";
        if_setonclick($component0, "loginscreen_link($string0, $string1, true)");
        if_setonclick($component1, "login_popup_close");
    case 11 :
        $string0 = "www";
        $string1 = "account_settings.ws?mod=security";
        if_setonclick($component0, "loginscreen_link($string0, $string1, true)");
        if_setonclick($component1, "login_popup_close");
    case 18 :
        $string0 = "accountappeal";
        $string1 = "lockchoice.ws";
        if_setonclick($component0, "loginscreen_link($string0, $string1, true)");
        if_setonclick($component1, "login_popup_close");
    case 30 :
        $string0 = "dob";
        $string1 = "set_members_dob.ws";
        if_setonclick($component0, "loginscreen_link($string0, $string1, true)");
        if_setonclick($component1, "login_popup_close");
    case 31 :
        $string0 = "www";
        $string1 = "account_settings.ws?mod=charname";
        if_setonclick($component0, "loginscreen_link($string0, $string1, true)");
        if_setonclick($component1, "login_popup_close");
    case 32, 12, 19, 40 :
        $string0 = "dob";
        $string1 = "set_members_dob.ws";
        if_setonclick($component0, "loginscreen_link($string0, $string1, true)");
        if_setonclick($component1, "login_popup_close");
    case 21 :
        if_setonclick($component0, "login_hop_abort");
        if_setonclick($component1, null);
    case 53 :
        if_setonclick($component0, "clientscript_6717");
        if_setonclick($component1, "clientscript_6717");
    case 49, 52 :
        if_setonclick($component0, "clientscript_6713");
        if_setonclick($component1, "clientscript_6714");
    case default :
        if_setonclick($component0, null);
        if_setonclick($component1, "login_popup_close");
}
