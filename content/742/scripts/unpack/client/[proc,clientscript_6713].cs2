// 6713
[proc,clientscript_6713]
if (calc(%varclient_2016 + 3000) <= clientclock) {
    %varclient_2016 = clientclock;
    op5618;
    if_settext(login:popup_text, "Another email has been sent to your registered address. Please follow the link to authorise your current device.");
} else {
    if_settext(login:popup_text, "An email was sent to your registered address recently. Please wait a minute before trying to resend.");
}
