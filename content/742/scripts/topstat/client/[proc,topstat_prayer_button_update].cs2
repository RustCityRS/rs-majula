// 2303
[proc,topstat_prayer_button_update]
def_int $int0 = 1245;
def_graphic $graphic1 = "topstat_fill_full,1";
def_graphic $graphic2 = "topstat_fill_full,5";
def_graphic $graphic3 = "topstat_icon,1";
if (getwindowmode >= 2) {
    $int0 = 8645;
    $graphic1 = 8642;
    $graphic2 = 8646;
    $graphic3 = 8654;
    if (if_getgraphic(topstat_prayer:topstat_background_prayer) ! 8625 & if_getgraphic(topstat_prayer:topstat_background_prayer) ! 8624) {
        if_setgraphic(topstat_prayer:topstat_background_prayer, 8625);
    }
    if_setsize(topstat_prayer:topstat_prayer, 67, 34, ^setsize_abs, ^setsize_abs);
    if_setposition(topstat_prayer:com_5, 2, 1, ^setpos_abs_right, ^setpos_abs_top);
    if_setposition(topstat_prayer:from_define_101, 3, 15, ^setpos_abs_left, ^setpos_abs_top);
    if_setsize(topstat_prayer:from_define_101, 34, 14, ^setsize_abs, ^setsize_abs);
} else {
    if (if_getgraphic(topstat_prayer:topstat_background_prayer) ! graphic_1206 & if_getgraphic(topstat_prayer:topstat_background_prayer) ! graphic_784) {
        if_setgraphic(topstat_prayer:topstat_background_prayer, graphic_1206);
    }
    if_setsize(topstat_prayer:topstat_prayer, 57, 34, ^setsize_abs, ^setsize_abs);
    if_setposition(topstat_prayer:com_5, 1, 1, ^setpos_abs_left, ^setpos_abs_top);
    if_setposition(topstat_prayer:from_define_101, 31, 15, ^setpos_abs_left, ^setpos_abs_top);
    if_setsize(topstat_prayer:from_define_101, 24, 14, ^setsize_abs, ^setsize_abs);
}
if_setgraphic(topstat_prayer:com_2, $graphic3);
if (~bool_to_int(%topstat_prayer_button_client) = 1) {
    if_setgraphic(topstat_prayer:com_0, $graphic2);
    if (%prayer_mode = 1) {
        if_setop(topstat_prayer:topstat_background_prayer, 1, "Turn curses off");
    } else {
        if_setop(topstat_prayer:topstat_background_prayer, 1, "Turn prayers off");
    }
} else {
    if_setgraphic(topstat_prayer:com_0, $graphic1);
    if (%prayer_mode = 1) {
        if_setop(topstat_prayer:topstat_background_prayer, 1, "Turn quick curses on");
    } else {
        if_setop(topstat_prayer:topstat_background_prayer, 1, "Turn quick prayers on");
    }
}
