// 4428
[clientscript,clan_chat_onload]
def_component $component0 = clan_chat:clan_list_parent_layer;
if_setontimer($component0, "clan_chat_poll_clansettings(event_com)");
if (activeclanchannel_find_affined = true) {
    %client_timer = 0;
    if_setonclantransmit($component0, "clan_chat_onclantransmit(event_com)");
    if_setonfriendtransmit($component0, "clan_chat_onclantransmit(event_com)");
    if_setscrollsize($component0, 0, 0);
    if_setscrollpos($component0, 0, 0);
    if_setmouseovercursor(clan_chat:drag_layer, friends_arrow_cursor);
    if_sethide(clan_chat:kick_button_layer, false);
    if_sethide(clan_chat:perm_ban_button_layer, false);
    ~script4470;
    ~clientscript_5395;
    ~script4436($component0, %clan_line_pos);
    ~script4447;
}
cc_deleteall(clan_chat:clan_rectangles);
cc_deleteall(clan_chat:guest_rectangles);
def_int $int1 = 0;
def_int $int2 = calc((500 + 100) / 2);
while ($int1 < $int2) {
    cc_create(clan_chat:clan_rectangles, ^iftype_rectangle, $int1);
    .cc_create(clan_chat:guest_rectangles, ^iftype_rectangle, $int1);
    cc_setsize(0, 19, ^setsize_minus, ^setsize_abs);
    .cc_setsize(0, 19, ^setsize_minus, ^setsize_abs);
    cc_setposition(0, calc($int1 * 2 * 19), ^setpos_abs_centre, ^setpos_abs_top);
    .cc_setposition(0, cc_gety, ^setpos_abs_centre, ^setpos_abs_top);
    cc_setcolour(0x232220);
    .cc_setcolour(0x232220);
    cc_setfill(true);
    .cc_setfill(true);
    cc_settrans(128);
    .cc_settrans(128);
    $int1 = calc($int1 + 1);
}
