// 2665
[clientscript,mah3_strip_up]
def_component $component0 = enum(int, component, enum_2566, %mah3_strip_select);
def_component $component1 = enum(int, component, enum_2565, %mah3_strip_select);
if (if_gety($component0) > -13) {
    sound_vorbis_volume(vorbis_7570, 1, 0, 50);
    if_setposition($component0, if_getx($component0), calc(if_gety($component0) - 2), ^setpos_abs_left, ^setpos_abs_top);
    if_setposition($component1, if_getx($component1), calc(if_gety($component1) - 2), ^setpos_abs_left, ^setpos_abs_top);
}
