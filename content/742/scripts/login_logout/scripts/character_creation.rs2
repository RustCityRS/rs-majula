if (p_finduid(uid) = true) { ~cc_style(6); }
[if_button,playerdesign4:role6]
if (p_finduid(uid) = true) { ~cc_style(7); }
[if_button,playerdesign4:role7]
if (p_finduid(uid) = true) { ~cc_style(8); }
[if_button,playerdesign4:role8]
if (p_finduid(uid) = true) { ~cc_style(9); }
[if_button,playerdesign4:role9]
if (p_finduid(uid) = true) { ~cc_style(10); }
[if_button,playerdesign4:role10]
if (p_finduid(uid) = true) { ~cc_style(11); }
