[debugproc,open_cc]()
if (p_finduid(uid) = false) {
    return;
}
%tutorial = 0;
if (%tutorial < 1000) {
    ~cc_open_interface();
    return;
}

// ── Style tab buttons (com48-com67 = styles 1-20) ────────────────────
[if_button,playerdesign4:role0]
if (p_finduid(uid) = true) { ~cc_style(1); }
[if_button,playerdesign4:role1]
if (p_finduid(uid) = true) { ~cc_style(2); }
