if (p_finduid(uid) = true) { ~cc_style(15); }
[if_button,playerdesign4:role15]
if (p_finduid(uid) = true) { ~cc_style(16); }
[if_button,playerdesign4:role16]
if (p_finduid(uid) = true) { ~cc_style(17); }
