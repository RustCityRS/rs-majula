[login,_]
// The lobby's friend, ignore and join prompts wait for this (clientscripts meslayer_mode2-16,
// friend_op); every account has a display name.
%has_displayname_client = true;
// The website bar over the game off before the game opens (see open_game_frame).
%varclient_2010 = 0;
%varplayer_2526 = 1;
// The lobby screen loads once this is set (clientscript_6347).
%varplayer_2567 = 1;
// Shows the lobby menu (clientscript_2354; 2 is another screen).
%varplayerbit_10242 = 1;
