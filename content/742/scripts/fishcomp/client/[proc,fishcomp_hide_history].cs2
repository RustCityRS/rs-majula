if_sethide(fishcomp_overlay:com_53, true);
if_sethide(fishcomp_overlay:com_56, true);
if_sethide(fishcomp_overlay:com_86, false);
if_setposition(fishcomp_overlay:com_55, 177, 9, ^setpos_abs_left, ^setpos_abs_bottom);
