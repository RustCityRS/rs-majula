// 263
[proc,fishcomp_draw_bait]
if_sethide(fishcomp_side:com_16, true);
if_sethide(fishcomp_side:com_18, true);
if_sethide(fishcomp_side:com_20, true);
if_sethide(fishcomp_side:com_22, true);
if_sethide(fishcomp_side:com_24, true);
if_sethide(fishcomp_side:com_26, true);
if_sethide(fishcomp_side:com_28, true);
if_sethide(fishcomp_side:com_30, true);
if_sethide(fishcomp_side:com_17, true);
if_sethide(fishcomp_side:com_19, true);
if_sethide(fishcomp_side:com_21, true);
if_sethide(fishcomp_side:com_23, true);
if_sethide(fishcomp_side:com_25, true);
if_sethide(fishcomp_side:com_27, true);
if_sethide(fishcomp_side:com_29, true);
if_sethide(fishcomp_side:com_31, true);
def_string $string0 = "Bait: None";
switch_int (%fishcomp_client_bait) {
    case 1 :
        $string0 = "Bait: worm";
        if_sethide(fishcomp_side:com_17, false);
    case 2 :
        $string0 = "Bait: maggot";
        if_sethide(fishcomp_side:com_19, false);
    case 4 :
        $string0 = "Bait: locust";
        if_sethide(fishcomp_side:com_21, false);
    case 3 :
        $string0 = "Bait: cricket";
        if_sethide(fishcomp_side:com_23, false);
    case 5 :
        $string0 = "Bait: cray";
        if_sethide(fishcomp_side:com_25, false);
    case 6 :
        $string0 = "Bait: shrimp";
        if_sethide(fishcomp_side:com_27, false);
    case 7 :
        $string0 = "Bait: green moth";
        if_sethide(fishcomp_side:com_29, false);
    case 8 :
        $string0 = "Bait: grey moth";
        if_sethide(fishcomp_side:com_31, false);
}
if_settext(fishcomp_side:com_112, $string0);
if (%fishcomp_client_bait = 0) {
    if_setontimer(fishcomp_side:com_105, "clientscript_6252");
} else {
    if_setontimer(fishcomp_side:com_105, null);
    if_sethide(fishcomp_side:com_64, false);
}
