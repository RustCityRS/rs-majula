// 178
[proc,redraw_chat_buttons]
if_setonsubchange(filterbuttons:container, "redraw_chat_buttons");
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 8;
if (getwindowmode >= 2) {
    if_sethide(filterbuttons:com_4, false);
    if_setsize(filterbuttons:container, if_getwidth(filterbuttons:container), 27, ^setsize_abs, ^setsize_abs);
    if_setposition(filterbuttons:com_5, -3, 0, ^setpos_abs_left, ^setpos_abs_top);
    if_setsize(filterbuttons:com_14, 63, 27, ^setsize_abs, ^setsize_abs);
    if_setgraphic(filterbuttons:reportabuse_graphic, 8558);
    while ($int0 < $int2) {
        if (%chat_highlight = $int0 & %chat_view = $int0) {
            if_setgraphic(enum(int, component, enum_683, $int0), 8562);
        } else if (%chat_highlight = $int0) {
            if_setgraphic(enum(int, component, enum_683, $int0), 8560);
        } else if (%chat_view = $int0) {
            if_setgraphic(enum(int, component, enum_683, $int0), 8561);
        } else if (calc(~chat_alert_get($int0) / 25 % 2) = 1) {
            if_setgraphic(enum(int, component, enum_683, $int0), 8559);
        } else {
            if_setgraphic(enum(int, component, enum_683, $int0), 8558);
        }
        $int0 = calc($int0 + 1);
    }
} else {
    if_sethide(filterbuttons:com_4, true);
    if_setsize(filterbuttons:container, if_getwidth(filterbuttons:container), 22, ^setsize_abs, ^setsize_abs);
    if_setposition(filterbuttons:com_5, 0, 0, ^setpos_abs_left, ^setpos_abs_top);
    if_setsize(filterbuttons:com_14, 57, 22, ^setsize_abs, ^setsize_abs);
    if_setgraphic(filterbuttons:reportabuse_graphic, large_button);
    while ($int0 < $int2) {
        if (%chat_highlight = $int0 & %chat_view = $int0) {
            if_setgraphic(enum(int, component, enum_683, $int0), small_button_pressed_highlight);
        } else if (%chat_highlight = $int0) {
            if_setgraphic(enum(int, component, enum_683, $int0), small_button_highlight);
        } else if (%chat_view = $int0) {
            if_setgraphic(enum(int, component, enum_683, $int0), small_button_pressed);
        } else if (calc(~chat_alert_get($int0) / 25 % 2) = 1) {
            if_setgraphic(enum(int, component, enum_683, $int0), small_button_blue);
        } else {
            if_setgraphic(enum(int, component, enum_683, $int0), small_button);
        }
        $int0 = calc($int0 + 1);
    }
}
if (~chat_get_filter(1) = 1) {
    if_settext(enum(int, component, enum_684, 1), "<col=ffff00>Filter");
} else {
    if_settext(enum(int, component, enum_684, 1), "All");
}
$int0 = 2;
while ($int0 < $int2) {
    $int1 = ~chat_get_filter($int0);
    if ($int0 = 3 & $int1 = 1 & friend_count < 0) {
        if_settext(enum(int, component, enum_684, $int0), "<col=ffff00>Loading");
    } else if ($int1 = 1) {
        if_settext(enum(int, component, enum_684, $int0), "<col=ffff00>Friends");
    } else if ($int1 = 2) {
        if_settext(enum(int, component, enum_684, $int0), "<col=ff0000>Off");
    } else if ($int1 = 3) {
        if_settext(enum(int, component, enum_684, $int0), "<col=00ffff>Hide");
    } else {
        if_settext(enum(int, component, enum_684, $int0), "On");
    }
    $int0 = calc($int0 + 1);
}
if_sethide(filterbuttons:com_5, false);
