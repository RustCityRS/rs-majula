    case 25 :
        return(~quest_state_basic(%zogre, 14));
    case 26 :
        if (%fenk_quest > 6) {
            return(2);
        }
        if (%fenk_quest = 0 & %fenk_read_signpost = 0) {
            return(0);
        }
        return(1);
    case 27 :
        return(~quest_state_basic(%myq3_main_quest, 320));
    case 28 :
        return(~quest_state_basic(%dttd_main, 13));
    case 29 :
        if (%death_equiproom >= 80) {
            return(2);
        } else {
            return(~quest_state_basic(%varplayerbit_10761, 65));
        }
    case 30 :
        return(~quest_state_basic(%deserttreasure, 15));
