    case 35 :
        return(~quest_state_basic(%eadgar_quest, 110));
    case 36 :
        return(~quest_state_basic(%eaglepeak_quest, 40));
    case 37 :
        if (testbit(%elemental_workshop_bits, 20) = ^true) {
            return(2);
        } else if (testbit(%elemental_workshop_bits, 1) = ^false) {
            return(0);
        } else {
            return(1);
        }
    case 38 :
        return(~quest_state_basic(%elemental_quest_2_main, 11));
