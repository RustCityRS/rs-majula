// 742's quest list (questlist_v4, 190) works out each row's state itself (clientscript 2193,
// ql4_getprogress): 0 not started, 1 started, 2 complete. Its rows' ops depend on that state, so
// the server reads them with the same switch, copied here.
[proc,quest_state](int $quest)(int)
switch_int ($quest) {
    case 147 :
        return(~quest_state_basic(%tutorial, 1000));
    case 159 :
        return(~quest_state_basic(%spy, 4));
    case 1 :
        return(~quest_state_basic(%cookquest, 2));
    case 2 :
        return(~quest_state_basic(%demonslayer_main, 3));
    case 4 :
        return(~quest_state_basic(%dragonquest, 10));
    case 5 :
        return(~quest_state_basic(%haunted, 3));
    case 6 :
        return(~quest_state_basic(%gobdip_main, 6));
    case 7 :
        return(~quest_state_basic(%imp, 2));
    case 8 :
        return(~quest_state_basic(%squire, 7));
    case 9 :
        return(~quest_state_basic(%hunt, 4));
    case 11 :
        return(~quest_state_basic(%prieststart, 5));
    case 13 :
        return(~quest_state_basic(%runemysteries, 6));
    case 15 :
        return(~quest_state_multi(%phoenixgang, 7, %blackarmgang, 4));
    case 16 :
        return(~quest_state_basic(%vampire_quest, 3));
    case 18 :
