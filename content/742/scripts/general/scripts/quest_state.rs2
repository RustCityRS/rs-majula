[proc,quest_state_basic](int $var, int $complete)(int)
return(~quest_state_detail($var, 1, $complete));

[proc,quest_state_detail](int $var, int $start, int $complete)(int)
if ($var < $start) {
    return(0);
}
if ($var < $complete) {
    return(1);
}
return(2);

[proc,quest_state_multi](int $var1, int $complete1, int $var2, int $complete2)(int)
if ($var1 = 0 & $var2 = 0) {
    return(0);
} else if ($var1 < $complete1 & $var2 < $complete2) {
    return(1);
}
return(2);
