// https://www.youtube.com/watch?v=cz0FGYbfzzk
// https://www.youtube.com/watch?v=IC2n8t76DDY
[advancestat,attack](int $levels) @levelup(enum(int, stat, stats, ^attack), $levels);
[advancestat,strength](int $levels) @levelup(enum(int, stat, stats, ^strength), $levels);
[advancestat,ranged](int $levels) @levelup(enum(int, stat, stats, ^ranged), $levels);
[advancestat,magic](int $levels) @levelup(enum(int, stat, stats, ^magic), $levels);
[advancestat,defence](int $levels) @levelup(enum(int, stat, stats, ^defence), $levels);
[advancestat,hitpoints](int $levels) @levelup(enum(int, stat, stats, ^hitpoints), $levels);
[advancestat,prayer](int $levels) @levelup(enum(int, stat, stats, ^prayer), $levels);
[advancestat,agility](int $levels) @levelup(enum(int, stat, stats, ^agility), $levels);
[advancestat,herblore](int $levels) @levelup(enum(int, stat, stats, ^herblore), $levels);
[advancestat,thieving](int $levels) @levelup(enum(int, stat, stats, ^thieving), $levels);
[advancestat,crafting](int $levels) @levelup(enum(int, stat, stats, ^crafting), $levels);
[advancestat,runecraft](int $levels) @levelup(enum(int, stat, stats, ^runecraft), $levels);
[advancestat,mining](int $levels) @levelup(enum(int, stat, stats, ^mining), $levels);
[advancestat,smithing](int $levels) @levelup(enum(int, stat, stats, ^smithing), $levels);
[advancestat,fishing](int $levels) @levelup(enum(int, stat, stats, ^fishing), $levels);
[advancestat,cooking](int $levels) @levelup(enum(int, stat, stats, ^cooking), $levels);
[advancestat,firemaking](int $levels) @levelup(enum(int, stat, stats, ^firemaking), $levels);
[advancestat,woodcutting](int $levels) @levelup(enum(int, stat, stats, ^woodcutting), $levels);
[advancestat,fletching](int $levels) @levelup(enum(int, stat, stats, ^fletching), $levels);

// $levels: how many levels the xp crossed (the engine passes it; 647).
[label,levelup](stat $stat, int $levels)
db_find(levelup:stat, $stat);
def_dbrow $unlock_row = db_findnext;
if ($unlock_row = null) {
    return;
}
def_int $level = stat_base($stat);
// Unstable Foundations' practice: Roddeck's word and the Task tab follow the level's box below.
// Queued as well, and first: a click on the floor shuts that box and drops this script, and the
// level comes once (the user's play-through, 2026-11-12).
if (%tutorial >= 140 & %tutorial < 150) {
    queue(uf_level_box_gone, 0, 0);
}
// Task 425 "How To Train and Level" at Mining 2 (tasks/task_system.rs2), queued behind the boxes.
if ($stat = mining & $level >= 2 & %task_tut4_how_to_2 = 0) {
    queue(task_how_to_train_and_level, 0, 0);
}
// In Unstable Foundations' cellar the level comes as a plain box: s068 / s069 "Congratulations:
// You have reached level 2 Mining." (4KO2h2xPtdM @568, 11 and 10 of 31 recordings), before
// Roddeck's word; no level-up window.
if (%tutorial >= 5 & %tutorial < 1000) {
    spotanim_pl(levelup_anim, 124, 0);
    ~mesbox("Congratulations: You have reached level <tostring($level)> <~stat_name($stat)>.");
    ~uf_levelled($stat);
    return;
}
// 2011's line, game-wide: "You've just advanced a Woodcutting level! You have reached level 4."
// (xqWnfqno_1M 2010-12-12 @372 and four more 2010-11 recordings) and "You've just advanced 2
// Mining levels! You have reached level 4." (4KO2h2xPtdM 2011-04-30 @612). 289's levelup:message
// ("Congratulations, you just advanced a mining level.") is 2004's. "an" before Attack and
// Agility: English, no recording shows either.
def_string $name = ~stat_name($stat);
if ($levels > 1) {
    mes("You've just advanced <tostring($levels)> <$name> levels! You have reached level <tostring($level)>.");
} else if ($stat = attack | $stat = agility) {
    mes("You've just advanced an <$name> level! You have reached level <tostring($level)>.");
} else {
    mes("You've just advanced a <$name> level! You have reached level <tostring($level)>.");
}
// play the fireworks
spotanim_pl(levelup_anim, 124, 0);
// 2011's "Level up fireworks" sound, which "plays when you level up in any skill" (2011 wiki,
// Skills, 15 May 2011): synth 4860, whose whistle and crackles match the level-ups in
// u2OnbN30zfE 2009-10-02 @116, xXoR84Qyblk 2011-03-04 @16 and SO-q8cZ0K88 2011-05-26 @7.6.
// Cache 786's `firework` (2396) is a different sound.
sound_synth(synth_4860, 1, 0);
// 289 plays the stat's second jingle at a level that unlocks something
// (levelup_unlocks.enum). 2011's "changes ... to be slightly more complex,
// whenever the skill reaches level 50" (2011 wiki, Skills, 15 May 2011): the
// second jingles are the ones with more notes. No 2011 recording at hand has a
// level-up that tells the two rules apart (each is level 4 or below).
// def_enum $unlocks_levels = db_getfield($unlock_row, levelup:unlocks_levels, 0);
// def_boolean $has_unlocks = false;
// if ($unlocks_levels ! null) {
//     $has_unlocks = ~enum_containsintvalue($unlocks_levels, $level);
// }
// play the jingle
def_midi $jingle;
if ($level < 50) {
    $jingle = db_getfield($unlock_row, levelup:levelup_jingle, 0);
} else {
    $jingle = db_getfield($unlock_row, levelup:unlocks_jingle, 0);
}
~music_jingle($jingle);
// 2011: the stat's icon flashes in the stats tab until it is clicked
// (skill_guide.rs2), and the level-up box shows the stat's icon. Both are bits
// of %skill_stat_flash (varp 1179). The level before this level-up goes to the client first,
// while the stat's flash bit still says whether its scroll was read since (below).
~levelup_before_varc($unlock_row, calc($level - $levels));
~levelup_flash($unlock_row);
// Unstable Foundations' reward, in Explorer Jack's house copy: the line alone, no level-up box
// (VwpdbjfigD4 2011-01-17 @788-796, the scroll closed then "You've just advanced a Woodcutting
// level!"; 4KO2h2xPtdM 2011-04-30 @606-636). Why 2011 showed none there: no source.
if (~uf_in_house = true) {
    return;
}
// the level up dialogue box
if_settext(db_getfield($unlock_row, levelup:title, 0), db_getfield($unlock_row, levelup:title_text, 0));
if_settext(db_getfield($unlock_row, levelup:body, 0), "<db_getfield($unlock_row, levelup:level_prefix, 0)> <tostring($level)>!");
if_openchat(db_getfield($unlock_row, levelup:interface, 0));
p_pausebutton;
// 2011's 99, once the box is continued: the line in dark red, then three rockets 1.2 s apart,
// synth 4859 (4860 with a bang). gybcOtPkPHM 2011-03-16 @17.5 and UrcTiwPWLHo 2011-01-13 @27.6:
// the line is in chat on the first frame after the box closes, the rockets start 0.2 s later
// and run 2.4 s first to last; o6Ga2FGG1Dc 2011-05-27 @64. #800000 is the 2010 wiki's "99
// chatbox message" image and both recordings' glyphs.
// The graphic: spotanims 1630-1637 came in with synths 4859 and 4860 in the 21 May 2008 level-up
// update (OpenRS2 caches 240 and 706). 1637 is the one with three 1.2 s rockets, in step with the
// sounds, and opens on the white star of the 2011 wiki's 99levelup.gif; at height 92 its bursts
// sit as high over the head as there. That gif and the 2009 one also send rockets out to the
// sides, which 1637 alone doesn't; what else went with it: no source found.
if ($level = 99) {
    mes("<col=800000>Well done! You've achieved the highest possible level in this skill!");
    spotanim_pl(spotanim_1637, 92, 0);
    sound_synth(synth_4859, 1, 0);
    sound_synth(synth_4859, 1, 60);
    sound_synth(synth_4859, 1, 120);
}
// if ($has_unlocks = false) {
//     return;
// }
// 2011's level-up box tells the player what a level unlocks is in the stats
// tab ("Open your stats menu and click on the flashing icon for more
// information.", interface 740 in cache 786), where the level-up messages are
// read (2011 wiki, Update:Level-up Messages, 21 May 2008); so this shows no
// unlock messages after it: 289's levelup_unlocks_*.rs2 are not applicable
// (tools/port_289_not_applicable.tsv).
// jump(~levelup_unlocks($stat));

// 2011: the stat's bit of %skill_stat_flash (varp 1179) lights its icon in the
// stats tab (clientscript 970) until it is clicked, and %level_up_icon
// (varbit 4757, the same varp's top bits) puts its icon in the box
// (clientscript 971), as void-634's LevelUp.kt does.
[proc,levelup_flash](dbrow $row)
%skill_stat_flash = setbit(%skill_stat_flash, db_getfield($row, levelup:flash_bit, 0));
%level_up_icon = db_getfield($row, levelup:icon, 0);

// The level-up details (lvl_scroll, 741) count the levels on the client: clientscript 973
// (unpack/client/[proc,script973].cs2 in this revision's cache, the same as 647's) reads the
// stat's %lvl_<stat>_before_levelup_varc (varcs 1469-1493, pack/varc.pack) and, when that plus
// one is not the stat's base level, titles the scroll "You've just advanced <base - varc> <stat>
// levels!"; it lists only the unlocks above that level too. Nothing on 741's path sets these
// varcs, so the server must: unset they read -1, and the scroll said "You've just advanced 10
// Woodcutting levels! You have now reached level 9." after one level.
// What the varc means at 742, from this cache: interface 1217's onload (clientscript 5689 ->
// 5690 -> 5712) reads it, then sets it to the stat's base level, so it is the stat's level when
// its level-up details were last seen. The server sets the same value:
// the level before this level-up, only while the stat is not flashing. A flashing stat's scroll
// is still unread, and the client's sum (base - varc) then counts every level since it was last
// read, from the varc the first of those level-ups set. The flash ends at logout (varp 1179 is
// not saved), so the first level-up after a login sets the varc again before any scroll can
// read it.
// Keyed by the stat's index in the skill menu (levelup:icon), as clientscript 973's switch is.
[proc,levelup_before_varc](dbrow $row, int $before)
if (testbit(%skill_stat_flash, db_getfield($row, levelup:flash_bit, 0)) = ^true) {
    return;
}
switch_int (db_getfield($row, levelup:icon, 0)) {
    case 1 :
        %lvl_attack_before_levelup_varc = $before;
    case 2 :
        %lvl_strength_before_levelup_varc = $before;
    case 3 :
        %lvl_ranged_before_levelup_varc = $before;
    case 4 :
        %lvl_magic_before_levelup_varc = $before;
    case 5 :
        %lvl_defence_before_levelup_varc = $before;
    case 6 :
        %lvl_hitpoints_before_levelup_varc = $before;
    case 7 :
        %lvl_prayer_before_levelup_varc = $before;
    case 8 :
        %lvl_agility_before_levelup_varc = $before;
    case 9 :
        %lvl_herblore_before_levelup_varc = $before;
    case 10 :
        %lvl_thieving_before_levelup_varc = $before;
    case 11 :
        %lvl_crafting_before_levelup_varc = $before;
    case 12 :
        %lvl_runecraft_before_levelup_varc = $before;
    case 13 :
        %lvl_mining_before_levelup_varc = $before;
    case 14 :
        %lvl_smithing_before_levelup_varc = $before;
    case 15 :
        %lvl_fishing_before_levelup_varc = $before;
    case 16 :
        %lvl_cooking_before_levelup_varc = $before;
    case 17 :
        %lvl_firemaking_before_levelup_varc = $before;
    case 18 :
        %lvl_woodcutting_before_levelup_varc = $before;
    case 19 :
        %lvl_fletching_before_levelup_varc = $before;
    case 20 :
        %lvl_slayer_before_levelup_varc = $before;
    case 21 :
        %lvl_farming_before_levelup_varc = $before;
    case 22 :
        %lvl_construction_before_levelup_varc = $before;
    case 23 :
        %lvl_hunter_before_levelup_varc = $before;
    case 24 :
        %lvl_summoning_before_levelup_varc = $before;
    case 25 :
        %lvl_dungeoneering_before_levelup_varc = $before;
}

