// 1134
[clientscript,combat_side_button_highlight](component $component0, int $int1)
if (%com_mode = $int1) {
    if_setgraphic($component0, "combatboxes_large,1");
    if_setonmouseover($component0, "clientscript_5645($component0, 1, 1)");
    if_setonmouseleave($component0, "clientscript_5645($component0, 1, 0)");
} else {
    if_setgraphic($component0, "combatboxes_large,0");
    if_setonmouseover($component0, "clientscript_5645($component0, 0, 1)");
    if_setonmouseleave($component0, "clientscript_5645($component0, 0, 0)");
}
