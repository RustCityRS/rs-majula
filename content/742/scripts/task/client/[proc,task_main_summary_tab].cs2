        if_sethide(task_main:com_102, true);
        if_setgraphic(task_main:com_26, "task_tab,4");
        if_setgraphic(task_main:com_28, "task_tab,4");
        if_setgraphic(task_main:com_27, "task_tab,5");
    case 3 :
        if_sethide(task_main:com_95, true);
        if_sethide(task_main:com_97, true);
        if_sethide(task_main:com_90_, true);
        if_sethide(task_main:com_102, false);
        if_setgraphic(task_main:com_135, "task_tab,4");
        if_setgraphic(task_main:com_137, "task_tab,4");
        if_setgraphic(task_main:com_136, "task_tab,5");
}
