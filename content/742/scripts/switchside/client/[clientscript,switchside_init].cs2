// 114
[clientscript,switchside_init]
if_setonvarctransmit(toplevel:com_16, "switchside_varc{if_switchside_varc, ql4_switch}");
if_setonvarctransmit(toplevel_fullscreen:com_72, "switchside_varc{if_switchside_varc, ql4_switch}");
if (getwindowmode >= ^windowmode_resizable) {
    if_setonvartransmit(toplevel_fullscreen:stones_on, "flashside_vartransmit{varplayer_1021}");
    ~script1309(1);
} else {
    if_setonvartransmit(toplevel:backhmid1_hide, "flashside_vartransmit{varplayer_1021}");
    ~flashside_arrow;
    ~script1312(1);
}
