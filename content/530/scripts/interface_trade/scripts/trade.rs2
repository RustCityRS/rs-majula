[proc,enough_trade_space]()(boolean)
// check if contents of tempinv fits in other player's inv
def_int $space = .inv_freespace(inv);
def_int $size = inv_size(tradeoffer);
def_int $slot = 0;
while ($slot < $size) {
    def_obj $obj = inv_getobj(tradeoffer, $slot);
    if ($obj ! null) {
        if (oc_stackable($obj) = true) {
            def_int $total = .inv_total(inv, $obj);
            if ($total > 0) {
                if (calc(^max_32bit_int - $total - inv_getnum(tradeoffer, $slot)) < 0) {
                    return(false);
                }
            } else {
                $space = sub($space, 1);
                if ($space < 0) {
                    return(false);
                }
            }
        } else {
            $space = sub($space, 1);
            if ($space < 0) {
                return(false);
            }
        }
    }
    $slot = add($slot, 1);
}
return(true);

[proc,.enough_trade_space]()(boolean)
def_int $space = inv_freespace(inv);
def_int $size = .inv_size(tradeoffer);
def_int $slot = 0;
while ($slot < $size) {
    def_obj $obj = .inv_getobj(tradeoffer, $slot);
    if ($obj ! null) {
        if (oc_stackable($obj) = true) {
            def_int $total = inv_total(inv, $obj);
            if ($total > 0) {
                if (calc(^max_32bit_int - $total - .inv_getnum(tradeoffer, $slot)) < 0) {
                    return(false);
                }
            } else {
                $space = sub($space, 1);
                if ($space < 0) {
                    return(false);
                }
            }
        } else {
            $space = sub($space, 1);
            if ($space < 0) {
                return(false);
            }
        }
    }
    $slot = add($slot, 1);
}
return(true);

[proc,inv_remove_leading_empty_slots](inv $inv)
def_int $slot = 0;
while ($slot < inv_size($inv)) {
    if (inv_getobj($inv, $slot) ! null) {
        inv_movefromslot($inv, $inv, $slot);
    }
    $slot = add($slot, 1);
}

[proc,.inv_remove_leading_empty_slots](inv $inv)
def_int $slot = 0;
while ($slot < .inv_size($inv)) {
    if (.inv_getobj($inv, $slot) ! null) {
        .inv_movefromslot($inv, $inv, $slot);
    }
    $slot = add($slot, 1);
}

// 289's decline was a close button (the client closed the screen); 2011's
// Decline and its close button (com12) are ops the server answers.
[if_button,trademain:decline_button] if_close;
[if_button,trademain:closebutton] if_close;

[if_close,trademain]
// inv_stoptransmit(trademain:inv);
// inv_stoptransmit(trademain:otherinv);
// inv_stoptransmit(tradeside:inv);
inv_stoptransmit(trademain:your_offer_layer_flashy);
inv_stoptransmit(trademain:other_offer_layer_flashy);
inv_stoptransmit(tradeside:side_layer);

~moveallinv(tradeoffer, inv);

if (.finduid(%tradepartner) = true) {
    .%tradepartner = null;
    .if_close;
    if (%tradestatus ! 1 & .%tradestatus ! 1) {
        .mes("Other player declined trade."); // osrs
    }
}

%tradepartner = null;

// [if_button,tradeconfirm:accept]
[if_button,tradeconfirm:trade2accept]
%tradestatus = ^tradestatus_pending_confirm;

if (.finduid(%tradepartner) = true) {
    if (.%tradestatus = ^tradestatus_pending_confirm) {
        mes("Accepted trade.");
        .mes("Accepted trade.");

        both_moveinv(tradeoffer, inv);
        .both_moveinv(tradeoffer, inv);

        %tradepartner = null;
        .%tradepartner = null;

        if_close;
        .if_close;
    } else {
        // .if_settext(tradeconfirm:com_91, "Other player has accepted."); // osrs
        // if_settext(tradeconfirm:com_91, "Waiting for other player."); // https://youtu.be/uSO-ilQk5XY?list=PLn23LiLYLb1bQ7Hwp77KoNBjKvpZQTfJT&t=819
        .if_settext(tradeconfirm:trade2title, "Other player has accepted."); // osrs
        if_settext(tradeconfirm:trade2title, "Waiting for other player."); // https://youtu.be/uSO-ilQk5XY?list=PLn23LiLYLb1bQ7Hwp77KoNBjKvpZQTfJT&t=819
    }
}

// 2011's confirm screen has a Decline and a close button (com6) too.
[if_button,tradeconfirm:trade2decline] if_close;
[if_button,tradeconfirm:closebutton] if_close;

[if_close,tradeconfirm]
// inv_stoptransmit(tradeconfirm:inv1);
// inv_stoptransmit(tradeconfirm:inv2);
// inv_stoptransmit(tradeconfirm:otherinv1);
// inv_stoptransmit(tradeconfirm:otherinv2);
inv_stoptransmit(tradeconfirm:trade2title);

~moveallinv(tradeoffer, inv);
if (.finduid(%tradepartner) = true) {
    .%tradepartner = null;
    .if_close;
    .mes("Other player declined trade."); // osrs
}
%tradepartner = null;

// ----

// [inv_button1,trademain:inv] @removefromtrade(last_slot, 1);
// [inv_button2,trademain:inv] @removefromtrade(last_slot, 5);
// [inv_button3,trademain:inv] @removefromtrade(last_slot, 10);
// [inv_button4,trademain:inv] @removefromtrade(last_slot, ^max_32bit_int);
// [inv_button5,trademain:inv] @removefromtrade(last_slot, null);
[if_button1,trademain:your_offer_layer_flashy] @removefromtrade(last_slot, 1);
[if_button2,trademain:your_offer_layer_flashy] @removefromtrade(last_slot, 5);
[if_button3,trademain:your_offer_layer_flashy] @removefromtrade(last_slot, 10);
[if_button4,trademain:your_offer_layer_flashy] @removefromtrade(last_slot, ^max_32bit_int);
[if_button5,trademain:your_offer_layer_flashy] @removefromtrade(last_slot, null);
// 2011: Examine on either offer.
[if_button10,trademain:your_offer_layer_flashy]
def_obj $obj = inv_getobj(tradeoffer, last_slot);
if ($obj ! null) {
    mes(oc_desc($obj));
}
[if_button9,trademain:other_offer_layer_flashy]
if (.finduid(%tradepartner) = true) {
    def_obj $obj = .inv_getobj(tradeoffer, last_slot);
    if ($obj ! null) {
        mes(oc_desc($obj));
    }
}

[label,removefromtrade](int $slot, int $amount)
if ($amount <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $amount = last_int;
}

def_obj $obj = inv_getobj(tradeoffer, $slot);
def_int $total = inv_total(tradeoffer, $obj);
if ($amount < $total) $total = $amount;
inv_moveitem(tradeoffer, inv, $obj, $total);

%tradestatus = ^tradestatus_reset;
// if_settext(trademain:status, "");
if_settext(trademain:tradestatus, "");
if (.finduid(%tradepartner) = true) {
    session_log(^log_moderator, "Removed offer <oc_debugname($obj)> x<tostring($total)> to <.name>");
    .%tradestatus = ^tradestatus_reset;
    // .if_settext(trademain:status, "");
    .if_settext(trademain:tradestatus, "");
    ~trade_changed;
    // 2011: a removal marks the offer modified on both screens and
    // flashes the slot it left on the other's (clientscript 143; the 2011
    // wiki: "a big red flashing exclamation point will appear where the
    // item used to be").
    %traderemoved = 1;
    .%traderemoved_other = 1;
    .runclientscript("interface_flash_slot(trademain:other_offer_layer, 4, 7, $slot)");
}

// ----

// [inv_button1,tradeside:inv] @movetotrade(last_slot, 1);
// [inv_button2,tradeside:inv] @movetotrade(last_slot, 5);
// [inv_button3,tradeside:inv] @movetotrade(last_slot, 10);
// [inv_button4,tradeside:inv] @movetotrade(last_slot, ^max_32bit_int);
// [inv_button5,tradeside:inv] @movetotrade(last_slot, null);
[if_button1,tradeside:side_layer] @movetotrade(last_slot, 1);
[if_button2,tradeside:side_layer] @movetotrade(last_slot, 5);
[if_button3,tradeside:side_layer] @movetotrade(last_slot, 10);
[if_button4,tradeside:side_layer] @movetotrade(last_slot, ^max_32bit_int);
[if_button5,tradeside:side_layer] @movetotrade(last_slot, null);
[if_button10,tradeside:side_layer] ~inv_examine(last_slot);

[label,movetotrade](int $slot, int $amount)
if ($amount <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $amount = last_int;
}

def_obj $obj = inv_getobj(inv, $slot);

if (oc_tradeable($obj) = false) {
    mes("You can't trade this item.");
    return;
}

if (oc_members($obj) = true & map_members = ^false) {
    mes("You can't trade this item.");
    return;
}

def_int $total = inv_total(inv, $obj);
if ($amount < $total) $total = $amount;
inv_moveitem(inv, tradeoffer, $obj, $total);

%tradestatus = ^tradestatus_reset;
// if_settext(trademain:status, "");
if_settext(trademain:tradestatus, "");
if (.finduid(%tradepartner) = true) {
    session_log(^log_moderator, "Added offer <oc_debugname($obj)> x<tostring($total)> to <.name>");
    .%tradestatus = ^tradestatus_reset;
    // .if_settext(trademain:status, "");
    .if_settext(trademain:tradestatus, "");
    ~trade_changed;
}

// An offer moved, so the other sees this player's free backpack slots.
[proc,trade_changed]
.if_settext(trademain:free_space_text, "has <tostring(inv_freespace(inv))> free inventory slots.");

// The confirm screen's lists: what this player gives under "You are about to
// give:" (com37, or out_left and out_right past 14 items) and what the other
// gives under "In return you will receive:" (com41, or in_left and in_right),
// and the same the other way round on the other player's screen. 289's words
// for an empty offer.
[proc,trade_confirm_lists]
def_int $mine = calc(inv_size(tradeoffer) - inv_freespace(tradeoffer));
def_int $theirs = calc(.inv_size(tradeoffer) - .inv_freespace(tradeoffer));
def_string $mine1 = ~trade_offer_text(0, 14);
def_string $mine2 = ~trade_offer_text(14, 28);
def_string $theirs1 = ~.trade_offer_text(0, 14);
def_string $theirs2 = ~.trade_offer_text(14, 28);
~trade_confirm_list(tradeconfirm:com_37, tradeconfirm:out_left, tradeconfirm:out_right, $mine, $mine1, $mine2);
~trade_confirm_list(tradeconfirm:com_41, tradeconfirm:in_left, tradeconfirm:in_right, $theirs, $theirs1, $theirs2);
~.trade_confirm_list(tradeconfirm:com_37, tradeconfirm:out_left, tradeconfirm:out_right, $theirs, $theirs1, $theirs2);
~.trade_confirm_list(tradeconfirm:com_41, tradeconfirm:in_left, tradeconfirm:in_right, $mine, $mine1, $mine2);

[proc,trade_confirm_list](component $single, component $left, component $right, int $count, string $text1, string $text2)
if ($count > 14) {
    if_settext($left, $text1);
    if_settext($right, $text2);
    if_sethide($single, true);
    if_sethide($left, false);
    if_sethide($right, false);
    return;
}
if ($count < 1) {
    if_settext($single, "<col=ffffff>Absolutely nothing!");
} else {
    if_settext($single, $text1);
}
if_sethide($single, false);
if_sethide($left, true);
if_sethide($right, true);

[proc,.trade_confirm_list](component $single, component $left, component $right, int $count, string $text1, string $text2)
if ($count > 14) {
    .if_settext($left, $text1);
    .if_settext($right, $text2);
    .if_sethide($single, true);
    .if_sethide($left, false);
    .if_sethide($right, false);
    return;
}
if ($count < 1) {
    .if_settext($single, "<col=ffffff>Absolutely nothing!");
} else {
    .if_settext($single, $text1);
}
.if_sethide($single, false);
.if_sethide($left, true);
.if_sethide($right, true);

[proc,trade_offer_text](int $from, int $to)(string)
def_string $text = "";
def_int $slot = $from;
while ($slot < $to) {
    def_obj $obj = inv_getobj(tradeoffer, $slot);
    if ($obj ! null) {
        $text = "<$text><~trade_item_text($obj, inv_getnum(tradeoffer, $slot))>";
    }
    $slot = add($slot, 1);
}
return($text);

[proc,.trade_offer_text](int $from, int $to)(string)
def_string $text = "";
def_int $slot = $from;
while ($slot < $to) {
    def_obj $obj = .inv_getobj(tradeoffer, $slot);
    if ($obj ! null) {
        $text = "<$text><~trade_item_text($obj, .inv_getnum(tradeoffer, $slot))>";
    }
    $slot = add($slot, 1);
}
return($text);

[proc,trade_item_text](obj $obj, int $number)(string)
if ($number > 1) {
    return("<col=ff9040><oc_name($obj)><col=ffffff> x <col=ffff00><tostring($number)><br>");
}
return("<col=ff9040><oc_name($obj)><br>");
