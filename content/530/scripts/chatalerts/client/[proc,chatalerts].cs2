// 192
[proc,chatalerts]
def_int $int0 = chat_gethistorylength;
def_int $chattype1 = ^chattype_gamemessage;
if ($int0 > %chat_lastcount) {
    if (%chat_view = 0) {
        %chat_lastcount = $int0;
        return;
    }
    $int0 = calc($int0 - %chat_lastcount - 1);
    if ($int0 >= 100) {
        $int0 = 99;
    }
    while ($int0 >= 0) {
        $chattype1 = chat_gethistorytype($int0);
        if (~filtertest($int0, 0) = true & ~partnercheck($int0) = false) {
            switch_int ($chattype1) {
                case ^chattype_gamemessage :
                    ~chat_alert_enable(1);
                case ^chattype_modchat, ^chattype_publicchat, ^chattype_quickchat_public :
                    ~chat_alert_enable(2);
                case ^chattype_privatechat, ^chattype_loginlogoutnotification, ^chattype_privatechatout, ^chattype_modprivatechat, ^chattype_quickchat_private_incoming, ^chattype_quickchat_private_outgoing :
                    ~chat_alert_enable(3);
                case ^chattype_engine, 8, 12, 14, 15, 21 :
                    ~chat_alert_enable(5);
                case ^chattype_friendschat, ^chattype_friendschatnotification, 16, ^chattype_quickchat_friend_chat :
                    ~chat_alert_enable(4);
                case 10, 13 :
                    ~chat_alert_enable(6);
            }
        }
        $int0 = calc($int0 - 1);
    }
    %chat_lastcount = chat_gethistorylength;
}
