#testscript

// void-634 paints a combat hit with its style's hitmark (melee, ranged, magic:
// 0-2), a critical one (over 1 hitpoint and over 90% of the attacker's
// max hit) with its crit (+10), and a ring of recoil's with the reflect mark
// (4) -- CombatHitsplats and Weapon.mark; cache 786's hitmarks 0-2 and 4 each
// carry an icon, and 10-12 the same icons in another font. A queued hit
// carries its hitmark with the damage (skill_combat/scripts/hitmark.rs2).

[label,test_a_combat_hit_carries_its_style]
assert_eq(~hit_mark(~combat_hit(50, ^hitmark_melee, 100)), 0)
assert_eq(~hit_mark(~combat_hit(50, ^hitmark_ranged, 100)), 1)
assert_eq(~hit_mark(~combat_hit(50, ^hitmark_magic, 100)), 2)
assert_eq(~hit_damage(~combat_hit(50, ^hitmark_magic, 100)), 50)
assert_eq(~hit_mark(~combat_hit(12, ^hitmark_reflect, 0)), 4)

// Over 90% of the max hit is a crit, but not a hit of 1.
[label,test_a_hit_near_the_max_is_critical]
assert_eq(~hit_mark(~combat_hit(10, ^hitmark_melee, 10)), 10)
assert_eq(~hit_mark(~combat_hit(9, ^hitmark_melee, 10)), 0)
assert_eq(~hit_mark(~combat_hit(1, ^hitmark_ranged, 1)), 1)
assert_eq(~hit_mark(~combat_hit(14, ^hitmark_magic, 15)), 12)

// A bare damage, as 289's other callers queue it, is a plain hit, and no
// damage is a miss.
[label,test_a_bare_damage_is_a_plain_hit]
assert_eq(~hit_mark(37), 3)
assert_eq(~hit_damage(37), 37)
assert_eq(~hit_mark(0), 8)
assert_eq(~hit_mark(~combat_hit(0, ^hitmark_melee, 100)), 8)

// An npc's melee hit paints the melee mark on the player: 4 of 10 hitpoints
// leaves the bar at 60% (153 of 255).
[label,test_an_npc_melee_hit_paints_the_melee_mark]
setup_player("test_player")
~test_skip_design
queue(combat_damage_player, 0, ~combat_hit(4, ^hitmark_melee, 10))
test_tick(2)
assert_eq(stat(hitpoints), 6)
assert_called_with("damage", "0,4,0,153")

// A player's ranged hit paints the ranged mark on the npc.
[label,test_a_ranged_hit_paints_the_ranged_mark_on_an_npc]
setup_player("test_player")
~test_skip_design
npc_add(movecoord(coord, 0, 0, 2), horror_dagganoth_jr, 50)
npc_queue(2, ~combat_hit(4, ^hitmark_ranged, 10), 0)
test_tick(2)
assert_eq(npc_stat(hitpoints), 116)
assert_called_with("npc_damage", "1,4")

// A critical magic hit paints the magic crit.
[label,test_a_critical_magic_hit_paints_the_magic_crit]
setup_player("test_player")
~test_skip_design
npc_add(movecoord(coord, 0, 0, 2), horror_dagganoth_jr, 50)
npc_queue(2, ~combat_hit(10, ^hitmark_magic, 10), 0)
test_tick(2)
assert_called_with("npc_damage", "12,10")
