// Specials tests (stew / curry). Both leave an empty bowl (next_obj_stage=bowl)
// and heal via the db path (2011 wiki, in hitpoints: stew 11, curry 19). The kebab
// (random outcomes) is compile-gated by this run but not asserted here — its
// inline inv_delslot needs the last_slot trigger context the harness doesn't
// provide, so the random table is verified in-client. Reuses ~food_heal from
// consume_test.rs2 (compiled globally).

#testscript

[label,test_special_stew]
setup_player("test_player")
~test_skip_design
assert_eq(oc_param(stew, next_obj_stage), bowl_empty)
assert_eq(~food_heal(stew), 11)

[label,test_special_curry]
setup_player("test_player")
~test_skip_design
assert_eq(oc_param(curry, next_obj_stage), bowl_empty)
assert_eq(~food_heal(curry), 19)

// Integration: the stew/curry heal (99 hitpoints, 10 left).
[label,test_eat_stew_heals_11]
setup_player("test_player")
~test_skip_design
stat_advance(hitpoints, 130344310)
stat_sub(hitpoints, 89, 0)
~consume_effect_apply(stew)
assert_eq(stat(hitpoints), 21)

[label,test_eat_curry_heals_19]
setup_player("test_player")
~test_skip_design
stat_advance(hitpoints, 130344310)
stat_sub(hitpoints, 89, 0)
~consume_effect_apply(curry)
assert_eq(stat(hitpoints), 29)
