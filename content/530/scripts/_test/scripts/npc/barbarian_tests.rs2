#testscript

// Barbarian Village's 2011 barbarians hit as the 2011 wiki says (Barbarian,
// 2011-05-18): "20 is the max hit for the level 9/10s, and 30 is the max hit
// for the level 15/17s", in life points, a tenth of that in hitpoints
// (configs/_unpack/all.npc).

// Alberich (3246, level 17): 3.
[label,test_a_level_17_barbarian_hits_up_to_3]
setup_player("test_player");
~test_skip_design;
p_telejump(0_50_50_44_30);
npc_add(movecoord(coord, 2, 0, 0), fai_barbarian_1, 100);
assert_eq(~npc_melee_maxhit, 3);

// Fafner (3247, level 10) and Sieglinde (3263, level 9): 2.
[label,test_a_level_10_barbarian_hits_up_to_2]
setup_player("test_player");
~test_skip_design;
p_telejump(0_50_50_44_36);
npc_add(movecoord(coord, 2, 0, 0), fai_barbarian_2, 100);
assert_eq(~npc_melee_maxhit, 2);
npc_add(movecoord(coord, 2, 0, 2), fai_barbarian_female_4, 100);
assert_eq(~npc_melee_maxhit, 2);

// Aitan (3259, level 15), the archer: 3 with bronze arrows' ranged strength.
[label,test_aitan_shoots_up_to_3]
setup_player("test_player");
~test_skip_design;
p_telejump(0_50_50_44_42);
npc_add(movecoord(coord, 2, 0, 0), fai_barbarian_14, 100);
assert_eq(~npc_ranged_maxhit, 3);
