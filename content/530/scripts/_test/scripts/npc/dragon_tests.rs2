#testscript

// 289's chromatic dragons (npc/scripts/dragon.rs2). Each case breathes fire at
// a 99-hitpoint player twenty times, back to full hitpoints before each breath.
// A breath holds the dragon's next attack for four ticks, so the two ticks
// after it take only the fire. A tick ends the test's
// access to the player, and the level-up screen keeps it busy, so each breath
// closes the screen and takes the player back (p_finduid).

// Behind an anti-dragon shield the fire is at most 5.
[label,test_dragonfire_behind_an_anti_dragon_shield_takes_at_most_5]
def_player_uid $uid = setup_player("test_player");
~test_skip_design;
p_telejump(0_50_50_40_30);
stat_advance(hitpoints, 130344310);
inv_setslot(worn, ^wearpos_lhand, antidragonbreathshield, 1);
npc_add(movecoord(coord, 3, 0, 0), green_dragon, 100);
def_int $i = 0;
while ($i < 20) {
    stat_heal(hitpoints, 0, 100);
    ~dragon_fire;
    test_tick(2);
    if_close;
    assert_true(p_finduid($uid));
    assert_gte(stat(hitpoints), 94);
    $i = add($i, 1);
}
// 2011's message (2011 wiki, Protect from Magic, 8 May 2011).
assert_called_with("mes", "Your shield absorbs most of the dragon's fiery breath!");
// 289's fire: spotanim 1 on the dragon, at height 92, with its breath (seq 84).
assert_called_with("spotanim_npc", "1,92,0");
assert_called_with("npc_anim", "84,0");

// Under Protect from Magic it is at most 10.
[label,test_dragonfire_under_protect_from_magic_takes_at_most_10]
def_player_uid $uid = setup_player("test_player");
~test_skip_design;
p_telejump(0_50_50_40_36);
stat_advance(hitpoints, 130344310);
npc_add(movecoord(coord, 3, 0, 0), green_dragon, 100);
def_int $i = 0;
while ($i < 20) {
    stat_heal(hitpoints, 0, 100);
    %prayer12 = ^true;
    ~dragon_fire;
    test_tick(2);
    if_close;
    assert_true(p_finduid($uid));
    assert_gte(stat(hitpoints), 89);
    $i = add($i, 1);
}
assert_called_with("mes", "Your prayers help resist some of the dragonfire!");

// Unprotected it reaches up to 50, and in twenty breaths past 5 (each breath
// is 5 or less about one time in six).
[label,test_unprotected_dragonfire_takes_up_to_50]
def_player_uid $uid = setup_player("test_player");
~test_skip_design;
p_telejump(0_50_50_40_42);
stat_advance(hitpoints, 130344310);
npc_add(movecoord(coord, 3, 0, 0), green_dragon, 100);
def_int $worst = 0;
def_int $i = 0;
while ($i < 20) {
    stat_heal(hitpoints, 0, 100);
    ~dragon_fire;
    test_tick(2);
    if_close;
    assert_true(p_finduid($uid));
    $worst = max($worst, sub(99, stat(hitpoints)));
    $i = add($i, 1);
}
assert_gt($worst, 5);
assert_lte($worst, 50);

// Under antifire (289's anti_fire.rs2 sets %dragonresist) an unprotected
// breath is 15 less: at most 35, and in twenty breaths past 5.
[label,test_dragonfire_under_antifire_takes_at_most_35]
def_player_uid $uid = setup_player("test_player");
~test_skip_design;
p_telejump(0_50_50_40_48);
stat_advance(hitpoints, 130344310);
npc_add(movecoord(coord, 3, 0, 0), green_dragon, 100);
def_int $worst = 0;
def_int $i = 0;
while ($i < 20) {
    stat_heal(hitpoints, 0, 100);
    %dragonresist = add(map_clock, 600);
    ~dragon_fire;
    test_tick(2);
    if_close;
    assert_true(p_finduid($uid));
    $worst = max($worst, sub(99, stat(hitpoints)));
    $i = add($i, 1);
}
assert_gt($worst, 5);
assert_lte($worst, 35);
// The PR's 289 tells the player the potion helped; 2011's words are the 2011
// wiki's (Protect from Magic, 8 May 2011).
assert_called_with("mes", "Your potion slightly protects you from the heat of the dragon's breath.");
