// 1220
[proc,clientscript_1220]
if (detailget_stereo = 1) {
    if_setgraphic(loginscreen:stereo_button, graphic_1258);
    if_setgraphic(loginscreen:mono_button, graphic_1257);
} else {
    if_setgraphic(loginscreen:mono_button, graphic_1258);
    if_setgraphic(loginscreen:stereo_button, graphic_1257);
}
