// 715
[proc,clientscript_715](int $int0)
if ($int0 = 0) {
    if_settextfont(tradeconfirm:out_loan, p12_full);
    if_settextfont(tradeconfirm:in_loan, p12_full);
    if_settextalign(tradeconfirm:out_loan, ^settextalign_centre, ^settextalign_centre, 17);
    if_settextalign(tradeconfirm:in_loan, ^settextalign_centre, ^settextalign_centre, 17);
} else {
    if_settextfont(tradeconfirm:out_loan, p11_full);
    if_settextfont(tradeconfirm:in_loan, p11_full);
    if_settextalign(tradeconfirm:out_loan, ^settextalign_centre, ^settextalign_centre, 0);
    if_settextalign(tradeconfirm:in_loan, ^settextalign_centre, ^settextalign_centre, 0);
}
