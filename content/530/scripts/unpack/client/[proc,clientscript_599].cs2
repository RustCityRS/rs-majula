// 599
[proc,clientscript_599]
if (%varplayer_1113 = 0) {
    if (%stock_offercount_visible <= 2147483637) {
        %stock_offercount_visible = calc(%stock_offercount_visible + 10);
    }
} else {
    %stock_offercount_visible = 10;
}
if_settext(stockmarket:offercount, ~tostring_spacer(%stock_offercount_visible, ","));
~sm_offercount_settimer;
