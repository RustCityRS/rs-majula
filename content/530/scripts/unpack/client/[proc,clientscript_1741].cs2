// 1741
[proc,clientscript_1741](component $component0)
if (~bool_to_int(%varclient_214) = 1) {
    if (getwindowmode >= 2) {
        if_setgraphic($component0, graphic_1461);
    } else {
        if_setgraphic($component0, graphic_1457);
    }
    if_setop($component0, 1, "Turn run mode off");
} else {
    if (getwindowmode >= 2) {
        if_setgraphic($component0, graphic_1459);
    } else {
        if_setgraphic($component0, graphic_423);
    }
    if_setop($component0, 1, "Turn run mode on");
}
