// 507
[proc,clientscript_507](component $component0, component $component1, component $component2, component $component3, component $component4, component $component5, component $component6)
if_setoninvtransmit($component0, "clientscript_712($component0, $component1, $component2, $component3, $component4, $component5, $component6){trade_loan_offer}");
if_setonvartransmit($component0, "clientscript_712($component0, $component1, $component2, $component3, $component4, $component5, $component6){attack}");
~clientscript_1086($component0, 0, 0, 0);
~clientscript_1086($component4, 0, 0, 0);
~clientscript_713($component0, $component1, $component2, $component3, $component4, $component5, $component6);
