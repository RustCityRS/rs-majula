// 930
[proc,clientscript_930]
if (%varplayerbit_4538 >= 60) {
    mes("The game has ended.");
    if_close;
    return;
}
if (%if_side_modal2_stone = %varplayerbit_4538) {
    return;
}
if (%if_side_modal2_stone = 0) {
    while (%if_side_modal2_stone < %varplayerbit_4538) {
        %if_side_modal2_stone = calc(%if_side_modal2_stone + 1);
        ~clientscript_931(%if_side_modal2_stone, 1);
    }
    ~clientscript_928(%varplayerbit_4538, "Sliceoflemon", "Milknosugar", interface_724:text_1);
    return;
}
%if_side_modal2_stone = %varplayerbit_4538;
~clientscript_931(%varplayerbit_4538, 0);
def_int $int0 = 224;
def_int $int1 = 0;
def_int $int2 = 0;
if (%varplayerbit_4538 = calc(60 - 1)) {
    while ($int0 <= 287) {
        if (cc_find(interface_724:board, $int0) = true) {
            if (cc_getinvobject = deathrune) {
                $int1 = calc($int1 + 1);
            } else if (cc_getinvobject = bloodrune) {
                $int2 = calc($int2 + 1);
            }
        }
        $int0 = calc($int0 + 1);
    }
    if ($int1 > $int2) {
        sound_jingle(jingle_110, 6656);
        if_settext(interface_724:text_1, "<\"Sliceoflemon\"><\" wins!\">");
    } else if ($int2 > $int1) {
        sound_jingle(jingle_110, 6656);
        if_settext(interface_724:text_1, "<\"Milknosugar\"><\" wins!\">");
    } else {
        sound_jingle(jingle_108, 6449);
        if_settext(interface_724:text_1, "It's a draw.");
    }
    if_settext(interface_724:text_2, "The board is full.");
    return;
}
~clientscript_928(%varplayerbit_4538, "Sliceoflemon", "Milknosugar", interface_724:text_1);
