                return(37, sum2_willow_logs_cursed, "Members: Cursed willow tree roots<br> (after starting Summer's End)", "Members now have the Woodcutting level required to chop <col=000080>cursed willow tree roots</col> (after starting Summer's End).");
            case 9 :
                return(45, maple_logs, "Members: Maple tree", "Members can now chop down <col=000080>maple trees</col>.");
            case 10 :
                return(45, hollow_bark, "Members: Hollow tree", "Members can now chop down <col=000080>hollow trees</col>.");
            case 11 :
                return(50, mahogany_logs, "Members: Mahogany tree<br> (after Jungle Potion)", "Members now have the Woodcutting level required to chop down <col=000080>mahogany trees</col> (after Jungle Potion).");
            case 12 :
                return(54, arctic_pine_log, "Members: Arctic pine tree", "Members can now chop down <col=000080>arctic pine trees</col>.");
            case 13 :
                return(58, eucalyptus_logs, "Members: Eucalyptus tree", "Members can now chop down <col=000080>eucalyptus trees</col>.");
            case 14 :
                return(60, yew_logs, "Yew tree", "You can now chop down <col=000080>yew trees</col>.");
            case 15 :
                return(75, magic_logs, "Members: Magic tree", "Members can now chop down <col=000080>magic trees</col>.");
            case 16 :
                return(82, sum1_magic_logs_cursed, "Members: Cursed magic tree<br> (after Spirit of Summer)", "Members now have the Woodcutting level required to chop down <col=000080>cursed magic trees</col> (after Spirit of Summer).");
        }
    case 1 :
        switch_int ($int1) {
            case 0 :
                return(1, bronze_axe, "Bronze axe", "You can now use <col=000080>bronze axes</col>.");
            case 1 :
                return(1, iron_axe, "Iron axe", "You can now use <col=000080>iron axes</col>.");
            case 2 :
                return(6, steel_axe, "Steel axe", "You can now use <col=000080>steel axes</col>.");
            case 3 :
                return(6, black_axe, "Black axe", "You can now use <col=000080>black axes</col>.");
            case 4 :
                return(21, mithril_axe, "Mithril axe", "You can now use <col=000080>mithril axes</col>.");
            case 5 :
                return(31, adamant_axe, "Adamant axe", "You can now use <col=000080>adamant axes</col>.");
            case 6 :
                return(40, sc_reward_axe, "Members: Sacred clay hatchet", "Members can now use <col=000080>Sacred clay hatchets</col>");
            case 7 :
                return(40, sc_reward_volatile_axe, "Members: Volatile hatchet", "Members can now use <col=000080>Volatile hatchets</col>");
            case 8 :
                return(41, rune_axe, "Rune axe", "You can now use <col=000080>rune axes</col>.");
            case 9 :
                return(61, dragon_axe, "Members: Dragon axe", "Members can now use <col=000080>dragon axes</col>.");
            case 10 :
                return(61, firedup_adze, "Members: Inferno Adze<br> (after All Fired Up, with 92 Firemaking)", "Members can now use the <col=000080>Inferno Adze</col> to chop down trees with (after All Fired Up and with level 92 Firemaking).");
        }
    case 2 :
        switch_int ($int1) {
            case 0 :
                return(12, canoeing_paddle, "Log canoe", "Members can now make <col=000080>log canoes</col>.");
            case 1 :
                return(27, canoeing_paddle, "Dugout canoe", "Members can now make <col=000080>dugout canoes</col>.");
            case 2 :
                return(42, canoeing_paddle, "Stable dugout canoe", "Members can now make <col=000080>stable dugout canoes</col>.");
            case 3 :
                return(57, canoeing_paddle, "Waka canoe", "Members can now make <col=000080>waka canoes</col>.");
        }
    case 3 :
        if ($int1 = 0) {
            return(44, ramble_lumberjack_top, "Lumberjack clothing", "Members can now wear the <col=000080>undead lumberjack</col> clothing.");
        }
        if ($int1 = 1) {
            return(56, fremmenik_round_shield, "Fremennik round shield", "Members can now make <col=000080>Fremennik round shields</col>.");
        }
        if ($int1 = 2) {
            return(56, arctic_pine_split, "Split arctic pine logs", "Members can now split <col=000080>arctic pine logs</col>.");
        }
    case 4 :
        switch_int ($int1) {
            case 0 :
                return(1, sc_hatchet_1, "Stealing Creation - class 1 hatchet", "Members can now use <col=000080>class 1 hatchets</col> in the Stealing Creation minigame.");
            case 1 :
                return(20, sc_clay_2, "Stealing Creation - woodcut class 2 sacred clay", "Members can now woodcut <col=000080>class 2 sacred clay</col> in the Stealing Creation minigame.");
            case 2 :
                return(20, sc_hatchet_2, "Stealing Creation - class 2 hatchet", "Members can now use <col=000080>class 2 hatchets</col> in the Stealing Creation minigame.");
            case 3 :
                return(40, sc_clay_3, "Stealing Creation - woodcut class 3 sacred clay", "Members can now woodcut <col=000080>class 3 sacred clay</col> in the Stealing Creation minigame.");
            case 4 :
                return(40, sc_hatchet_3, "Stealing Creation - class 3 hatchet", "Members can now use <col=000080>class 3 hatchets</col> in the Stealing Creation minigame.");
            case 5 :
                return(60, sc_clay_4, "Stealing Creation - woodcut class 4 sacred clay", "Members can now woodcut <col=000080>class 4 sacred clay</col> in the Stealing Creation minigame.");
            case 6 :
