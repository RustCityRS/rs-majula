// 998
[proc,clientscript_998](int $int0, int $int1)(int, obj, string, string)
switch_int ($int0) {
    case 0 :
        switch_int ($int1) {
            case 0 :
                return(1, net, "Small net", "You can now fish with a <col=000080>small net</col>.");
            case 1 :
                return(1, crayfish_cage, "Crayfish cage", "You can now fish with a <col=000080>crayfish cage</col>.");
            case 2 :
                return(5, fishing_rod, "Bait fishing", "You can now fish with <col=000080>fishing rods</col> and bait</col>.");
            case 3 :
                return(16, big_net, "Members: Big net fishing", "Members can now fish with <col=000080>big nets</col>.");
            case 4 :
                return(20, fly_fishing_rod, "Fly fishing rod", "You can now fish with <col=000080>fly-fishing rods</col> and <col=000080>feathers</col>.");
            case 5 :
                return(35, harpoon, "Harpoon", "You can now fish with <col=000080>harpoons</col>.");
            case 6 :
                return(40, lobster_pot, "Lobster pot", "You can now fish with <col=000080>lobster pots</col>.");
            case 7 :
                return(40, sc_reward_harpoon, "Members: Sacred clay harpoon", "Members can now use <col=000080>Sacred clay harpoons</col>");
            case 8 :
                return(40, sc_reward_volatile_harpoon, "Members: Volatile harpoon", "Members can now use <col=000080>Volatile harpoons</col>");
            case 9 :
                return(48, brut_fishing_rod, "Members: Heavy rod<br> (with 15 Agility and 15 Strength)", "Members who are versed in the art of barbarian fishing now have the Fishing level required to fish with <col=000080>heavy rods</col>. (They also need level 15 Agility and level 15 Strength.)");
            case 10 :
                return(65, tbwt_karambwan_vessel, "Members: Vessel fishing<br> (after starting Tai Bwo Wannai Trio)", "Members now have the Fishing level required to use <col=000080>karambwan vessels</col> to fish for <col=000080>karambwan</col> (after starting Tai Bwo Wannai Trio).");
            case 11 :
                return(65, hvh_swordfish_gloves, "Swordfish gloves", "You can now wear <col=000080>swordfish gloves</col>.");
            case 12 :
                return(90, hvh_shark_gloves, "Members: Shark gloves", "Members can now wear <col=000080>shark gloves</col>.");
        }
    case 1 :
        switch_int ($int1) {
            case 0 :
                return(1, raw_shrimp, "Shrimp - Net fishing", "You can now catch <col=000080>shrimp</col> with a net.");
            case 1 :
                return(1, raw_crayfish, "Crayfish - Crayfish cage", "You can now catch <col=000080>crayfish</col> with a crayfish cage.");
            case 2 :
                return(5, raw_sardine, "Sardine - Sea bait fishing", "You can now catch <col=000080>sardines</col> with a fishing rod.");
            case 3 :
                return(5, tbwt_raw_karambwanji, "Members: Karambwanji - Net fishing", "Members can now catch <col=000080>karabwanji</col> with a net.");
            case 4 :
                return(10, raw_herring, "Herring - Sea bait fishing", "You can now catch <col=000080>herring</col> with a fishing rod.");
            case 5 :
                return(15, raw_anchovies, "Anchovies - Net fishing", "You can now catch <col=000080>anchovies</col> with a net.");
            case 6 :
                return(16, raw_mackerel, "Members: Mackerel - Big net fishing", "Members can now catch <col=000080>mackerel</col> with a big net.");
            case 7 :
                return(16, oystershell, "Members: Oyster - Big net fishing", "Members can now catch <col=000080>oysters</col> with a big net.");
            case 8 :
                return(16, casket, "Members: Caskets - Big net fishing", "Members can now catch <col=000080>caskets</col> with a big net.");
            case 9 :
                return(16, seaweed, "Members: Seaweed - Big net fishing", "Members can now catch <col=000080>seaweed</col> with a big net.");
            case 10 :
                return(20, raw_trout, "Trout - Fly-fishing", "You can now catch <col=000080>trout</col> with a fly-fishing rod.");
            case 11 :
                return(23, raw_cod, "Members: Cod - Big net fishing", "Members can now catch <col=000080>cod</col> with a big net.");
            case 12 :
                return(25, raw_pike, "Pike - River bait fishing", "You can now catch <col=000080>pike</col> with a fishing rod.");
            case 13 :
                return(28, mort_slimey_eel, "Members: Slimy eel - River bait fishing", "Members can now catch <col=000080>slimy eel</col> with a fishing rod.");
            case 14 :
                return(30, raw_salmon, "Salmon - Fly-fishing", "You can now catch <col=000080>salmon</col> with a fly-fishing rod.");
            case 15 :
                return(33, giant_frogspawn, "Members: Giant frogspawn - Net fishing", "Members can now catch <col=000080>giant frogspawn</col> with a net.");
            case 16 :
                return(35, raw_tuna, "Tuna - Harpoon fishing", "You can now catch <col=000080>tuna</col> with a harpoon.");
            case 17 :
                return(38, hunting_raw_fish_special, "Members: Rainbow fish - Stripy fly-fishing", "Members can now catch <col=000080>rainbow fish</col> with a fly-fishing rod.");
            case 18 :
                return(38, raw_cave_eel, "Members: Cave eel - River bait fishing", "Members can now catch <col=000080>cave eels</col> with a fishing rod.");
            case 19 :
                return(40, raw_lobster, "Lobster - Lobster pot fishing", "You can now catch <col=000080>lobsters</col> with a lobster pot.");
            case 20 :
                return(46, raw_bass, "Members: Bass - Big net fishing", "Members can now catch <col=000080>bass</col> with a big net.");
            case 21 :
                return(50, raw_swordfish, "Swordfish - Harpoon fishing", "You can now catch <col=000080>swordfish</col> with a harpoon.");
            case 22 :
                return(53, raw_lava_eel, "Members: Lava eel - Bait fishing (oily fishing rod)", "Members can now catch <col=000080>lava eels</col> with an oily fishing rod.");
            case 23 :
                return(62, raw_monkfish, "Members: Monkfish - Net fishing", "Members can now catch <col=000080>monkfish</col> with a net.");
            case 24 :
                return(65, tbwt_raw_karambwan, "Members: Karambwan - Vessel fishing", "Members can now catch <col=000080>karambwan</col> with a karambwan vessel in Karamja.");
            case 25 :
                return(76, raw_shark, "Members: Shark - Harpoon fishing", "Members can now catch <col=000080>shark</col> with a harpoon.");
            case 26 :
                return(79, raw_seaturtle, "Members: Sea turtle - Fishing Trawler minigame", "Members can now catch <col=000080>sea turtles</col> in the Fishing Trawler minigame.");
            case 27 :
                return(81, raw_mantaray, "Members: Manta ray - Fishing Trawler minigame", "Members can now catch <col=000080>manta rays</col> in the Fishing Trawler minigame.");
        }
    case 2 :
        switch_int ($int1) {
            case 0 :
                return(-1, invis_rod, "To start fishing like a barbarian, talk to Otto Godblessed when you have at least level 48 Fishing, level 15 Agility and level 15 Strength.", "");
            case 1 :
                return(48, brut_spawning_trout, "Leaping trout<br> (with 15 Strength and 15 Agility)", "Members who are versed in the art of barbarian fishing now have the Fishing level required to catch <col=000080>leaping trout</col> with a heavy rod. (They also need level 15 Agility and level 15 Strength.)");
            case 2 :
                return(55, tuna, "Tuna<br> (with 35 Strength)", "Members who are versed in the art of barbarian fishing now have the Fishing level required to catch <col=000080>tuna</col> without a harpoon. (They also need level 35 Strength.)");
            case 3 :
                return(58, brut_spawning_salmon, "Leaping salmon<br> (with 30 Strength and 30 Agility)", "Members who are versed in the art of barbarian fishing now have the Fishing level required to catch <col=000080>leaping salmon</col> with a heavy rod. (They also need level 30 Agility and level 30 Strength.)");
            case 4 :
                return(70, swordfish, "Swordfish<br>(with 50 Strength)", "Members who are versed in the art of barbarian fishing now have the Fishing level required to catch <col=000080>swordfish</col> without a harpoon. (They also need level 50 Strength.)");
            case 5 :
                return(70, brut_sturgeon, "Leaping sturgeon<br> (with 45 Strength and 45 Agility)", "Members who are versed in the art of barbarian fishing now have the Fishing level required to catch <col=000080>leaping sturgeon</col> with a heavy rod. (They also need level 45 Agility and level 45 Strength.)");
            case 6 :
                return(96, shark, "Shark<br> (with 76 Strength)", "Members who are versed in the art of barbarian fishing now have the Fishing level required to catch <col=000080>shark</col> without a harpoon. (They also need level 76 Strength.)");
        }
    case 3 :
        switch_int ($int1) {
            case 0 :
                return(1, sc_harpoon_1, "Stealing Creation - class 1 harpoon", "Members can now use <col=000080>class 1 harpoons</col> in the Stealing Creation minigame.");
            case 1 :
                return(20, sc_clay_2, "Stealing Creation - catch class 2 sacred clay", "Members can now catch <col=000080>class 2 sacred clay</col> in the Stealing Creation minigame.");
            case 2 :
                return(20, sc_harpoon_2, "Stealing Creation - class 2 harpoon", "Members can now use <col=000080>class 2 harpoons</col> in the Stealing Creation minigame.");
            case 3 :
                return(40, sc_clay_3, "Stealing Creation - catch class 3 sacred clay", "Members can now catch <col=000080>class 3 sacred clay</col> in the Stealing Creation minigame.");
            case 4 :
                return(40, sc_harpoon_3, "Stealing Creation - class 3 harpoon", "Members can now use <col=000080>class 3 harpoons</col> in the Stealing Creation minigame.");
            case 5 :
                return(60, sc_clay_4, "Stealing Creation - catch class 4 sacred clay", "Members can now catch <col=000080>class 4 sacred clay</col> in the Stealing Creation minigame.");
            case 6 :
                return(60, sc_harpoon_4, "Stealing Creation - class 4 harpoon", "Members can now use <col=000080>class 4 harpoons</col> in the Stealing Creation minigame.");
            case 7 :
                return(80, sc_clay_5, "Stealing Creation - catch class 5 sacred clay", "Members can now catch <col=000080>class 5 sacred clay</col> in the Stealing Creation minigame.");
            case 8 :
                return(80, sc_harpoon_5, "Stealing Creation - class 5 harpoon", "Members can now use <col=000080>class 5 harpoons</col> in the Stealing Creation minigame.");
        }
    case 4 :
        switch_int ($int1) {
            case 0 :
                return(29, guide_icon_dummy, "Fishing Tutor - new info available", "There is new information available from the <col=000080>Fishing Tutor</col> south of <col=000080>Lumbridge</col>.");
            case 1 :
                return(39, guide_icon_dummy, "Fishing Tutor - new info available", "There is new information available from the <col=000080>Fishing Tutor</col> south of <col=000080>Lumbridge</col>.");
            case 2 :
                return(68, shark, "Members: Fishing Guild", "Members can now enter the <col=000080>Fishing Guild</col>.");
            case 3 :
                return(99, skillcape_fishing, "Skill mastery", "<col=000080>Congratulations! You are now a master of <col=800000>Fishing<col=000080>. Why not visit the <col=800000>Master Fisherman<col=000080> at the <col=800000>Fishing Guild<col=000080>? He has something special that is only available to true masters of the <col=800000>Fishing<col=000080> skill!");
        }
}
