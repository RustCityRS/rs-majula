// 202
[proc,clientscript_202](component $component0, component $component1)
cc_deleteall($component0);
if (friend_count = -2) {
    cc_create($component0, 4, 0);
    cc_settextfont(496);
    cc_settext("Loading Friend List - please wait...");
    cc_setposition(0, 0, 0, 0);
    cc_setsize(138, 100, 0, 0);
    cc_setcolour(0xffff64);
    cc_settextshadow(true);
    return;
}
if (friend_count = -1) {
    cc_create($component0, 4, 0);
    cc_settextfont(496);
    cc_settext("Connecting to friend server - please wait...");
    cc_setposition(0, 0, 0, 0);
    cc_setsize(138, 100, 0, 0);
    cc_setcolour(0xffff64);
    cc_settextshadow(true);
    return;
}
def_int $int2 = 0;
while ($int2 < friend_count) {
    cc_create($component0, 4, calc($int2 + $int2));
    cc_settextfont(496);
    cc_settext(friend_getname($int2));
    cc_setposition(0, calc($int2 * 15), 0, 0);
    cc_setsize(138, 15, 0, 0);
    cc_setcolour(0xffff64);
    cc_settextshadow(true);
    cc_create($component0, 4, calc($int2 + $int2 + 1));
    cc_settextfont(496);
    cc_settext(~clientscript_203(friend_getrank($int2)));
    cc_setposition(137, calc($int2 * 15), 0, 0);
    cc_setsize(131, 15, 0, 0);
    cc_setcolour(^white);
    cc_settextshadow(true);
    cc_setop(1, "Not in clan");
    cc_setop(2, "Recruit");
    cc_setop(3, "Corporal");
    cc_setop(4, "Sergeant");
    cc_setop(5, "Lieutenant");
    cc_setop(6, "Captain");
    cc_setop(7, "General");
    cc_setonop("clientscript_204($int2, event_op)");
    $int2 = calc($int2 + 1);
}
if_setscrollsize($component0, 0, calc(15 * friend_count + 2));
~clientscript_31($component1, $component0, 792, 789, 790, 791, 773, 788);
~clientscript_72($component1, $component0, if_getscrolly($component0));
