// 598
[proc,clientscript_598]
if (%varplayer_1113 = 0) {
    if (%stock_offercount_visible <= 2147483646) {
        %stock_offercount_visible = calc(%stock_offercount_visible + 1);
    }
} else {
    %stock_offercount_visible = 1;
}
if_settext(stockmarket:offercount, ~tostring_spacer(%stock_offercount_visible, ","));
~sm_offercount_settimer;
