[proc,clientscript_1370](int $int0)
if ($int0 > 0) {
    switch_int (%worldmap_zoom) {
        case default :
            %worldmap_zoom = 37;
        case 75 :
            %worldmap_zoom = 50;
        case 100 :
            %worldmap_zoom = 75;
        case 200 :
            %worldmap_zoom = 100;
    }
} else {
    switch_int (%worldmap_zoom) {
        case 37 :
            %worldmap_zoom = 50;
        case 50 :
            %worldmap_zoom = 75;
        case 75 :
            %worldmap_zoom = 100;
        case default :
            %worldmap_zoom = 200;
    }
}
~clientscript_1372;
