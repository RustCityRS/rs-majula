// 711
[proc,clientscript_711](component $component0)
def_string $string0 = "";
if (login_reply = -3) {
    if_settext($component0, "Performing login...");
    if_sethide(loginscreen:login_button, true);
    if_sethide(loginscreen:com_348, true);
    return;
}
if (login_reply = 21) {
    if (%loginscreen_hopblocked_time = 0) {
        %loginscreen_hopblocked_time = login_hoptime;
    }
    %loginscreen_hopblocked_time = calc(%loginscreen_hopblocked_time - 1);
    if (%loginscreen_hopblocked_time <= 0) {
        ~clientscript_1183;
        return;
    }
    if_settext($component0, "You have only just left another world. Your profile will be transferred in <tostring(calc(%loginscreen_hopblocked_time / 50))> seconds.");
    if_sethide(loginscreen:login_button, true);
    if_sethide(loginscreen:com_348, true);
    return;
}
if (login_reply = 1) {
    if (%loginscreen_videoad = 0) {
        if (video_advert_play = false) {
            %loginscreen_videoad_available = 0;
        } else {
            %loginscreen_videoad_available = 1;
        }
    }
    if_sethide(loginscreen:login_button, true);
    if_sethide(loginscreen:com_348, true);
    if (%loginscreen_videoad_available = 0) {
        if_settext($component0, "Could not display video advertisement. Login will continue in <tostring(calc((500 - %loginscreen_videoad) / 50))> seconds.");
    } else if (%loginscreen_videoad < 500) {
        if_settext($component0, "Displaying video advertisement. Login will continue after <tostring(calc((500 - %loginscreen_videoad) / 50))> seconds.");
    } else {
        if_settext($component0, "Displaying video advertisement. Login will continue after 0 seconds.");
    }
    %loginscreen_videoad = calc(%loginscreen_videoad + 1);
    if (%loginscreen_videoad_available = 1 & video_advert_has_finished = false | %loginscreen_videoad < 500) {
        return;
    }
    login_continue;
    return;
}
if_sethide(loginscreen:login_button, false);
if_sethide(loginscreen:com_348, false);
switch_int (login_reply) {
    case -2 :
        if_settext($component0, "Enter your username and password.");
    case -5 :
        if_settext($component0, "Connection timed out. Please try using a different world.");
    case -4 :
        if_settext($component0, "Error connecting to server.");
    case -1 :
        if_settext($component0, "No response from server. Please try using a different world.");
    case 3 :
        if_settext($component0, "Invalid username or password. If you have forgotten your password, <shad=-1><u=0000ff><col=0000ff>click here</col></u><shad>.");
        $string0 = "loginapplet/loginapplet.ws?mod=accountappeal&dest=passwordchoice.ws";
        if_setonclick($component0, "openurl_nologin($string0, false)");
    case 4 :
        if_settext($component0, "Your account has been disabled. Please <shad=-1><u=0000ff><col=0000ff>click here</col></u><shad> to check your Message Centre for details.");
        $string0 = "loginapplet/login.ws?mod=ticketing&ssl=1&expired=0&dest=inbox.ws";
        if_setonclick($component0, "openurl_nologin($string0, false)");
    case 5 :
        if_settext($component0, "Your account has not logged out from its last session. Try again in a few minutes.");
    case 6 :
        if_settext($component0, "RuneScape has been updated! Please reload this page.");
    case 7 :
        if_settext($component0, "This world is full. Please use a different world.");
    case 8 :
        if_settext($component0, "Unable to connect: login server offline.");
    case 9 :
        if_settext($component0, "Login limit exceeded: too many connections from your address.");
    case 10 :
        if_settext($component0, "Unable to connect: bad session ID.");
    case 11 :
        if_settext($component0, "Your password is an extremely common choice, and is very weak. You must change it before you can login. <shad=-1><u=0000ff><col=0000ff>Click here</col></u><shad>");
        $string0 = "loginapplet/loginapplet.ws?mod=password_history&ssl=1&expired=0&dest=password.ws";
        if_setonclick($component0, "openurl_nologin($string0, false)");
    case 12 :
        if_settext($component0, "You need a members' account to log in to this world. Please subscribe or use a different world. ");
    case 13 :
        if_settext($component0, "Could not complete login. Please try using a different world.");
    case 14 :
        if_settext($component0, "The server is being updated. Please wait a few minutes and try again.");
    case 16 :
        if_settext($component0, "Too many incorrect logins from your address. Please wait 5 minutes before trying again.");
    case 17 :
        if_settext($component0, "You are standing in a members-only area. To play on this world, move to a free area first.");
    case 18 :
        if_settext($component0, "Your account has been locked as we suspect it has been stolen. <shad=-1><u=0000ff><col=0000ff>Click here</col></u><shad> to recover your account.");
        $string0 = "loginapplet/loginapplet.ws?mod=accountappeal&dest=lockchoice.ws";
        if_setonclick($component0, "openurl_nologin($string0, false)");
    case 19 :
        if_settext($component0, "Fullscreen is currently a members-only feature. To log in, either return to the main menu and exit fullscreen or use a members' account.");
    case 20 :
        if_settext($component0, "Invalid loginserver requested. Please try using a different world.");
    case 22 :
        if_settext($component0, "Malformed login packet. Please try again.");
    case 23 :
        if_settext($component0, "No reply from login server. Please wait a minute and try again.");
    case 24 :
        if_settext($component0, "Error loading your profile. Please contact Customer Support.");
    case 25 :
        if_settext($component0, "Unexpected loginserver response. Please try using a different world.");
    case 26 :
        if_settext($component0, "This computer's address has been blocked as it was used to break our rules.");
    case 27 :
        if_settext($component0, "Service unavailable.");
    case 29 :
        ~clientscript_1894($component0);
    case 30 :
        if_settext($component0, "This is not a member's account; please choose the 'Free Users' option from the <shad=-1><u=0000ff><col=0000ff>website</col></u><shad> to play on this account.");
        $string0 = "index.ws";
        if_setonclick($component0, "openurl_nologin($string0, false)");
    case default :
        if_settext($component0, "Unexpected server response. Please try using a different world.");
}
