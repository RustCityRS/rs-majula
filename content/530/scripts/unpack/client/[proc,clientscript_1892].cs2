// 1892
[proc,clientscript_1892]
%loginscreen_res_counter = calc(%loginscreen_res_counter - 1);
if (%loginscreen_res_counter <= 0) {
    ~clientscript_1893(1);
    return;
}
def_int $int0 = calc(%loginscreen_res_counter / 50 + 1);
if ($int0 = 1) {
    if_settext(loginscreen:windowmode_confirm_countdown_text, "Reverting in 1 second...");
} else {
    if_settext(loginscreen:windowmode_confirm_countdown_text, "Reverting in <tostring($int0)> seconds...");
}
