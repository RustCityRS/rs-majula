// 835
[proc,clientscript_835]
if (%music_v3_protect = 1 | %cutscene_status = 1) {
    if_setgraphic(music_v3:com_11, "music_icons,1");
    return;
}
if (%musicloop = 0) {
    if_setgraphic(music_v3:com_11, "music_icons,1");
} else if (%musicloop = 1) {
    if_setgraphic(music_v3:com_11, "music_icons,0");
}
