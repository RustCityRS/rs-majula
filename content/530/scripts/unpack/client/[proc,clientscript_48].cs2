// 48
[proc,clientscript_48]
if (%loot_waiting_on = 1 | %loot_waiting_off = 1) {
    if_setgraphic(interface_589:loot_button, "loot_icon,2");
} else if (%loot_share_on = 1) {
    if (%loot_coinshare = 1) {
        if_setgraphic(interface_589:loot_button, "loot_icon,3");
    } else {
        if_setgraphic(interface_589:loot_button, "loot_icon,0");
    }
} else {
    if_setgraphic(interface_589:loot_button, "loot_icon,1");
}
