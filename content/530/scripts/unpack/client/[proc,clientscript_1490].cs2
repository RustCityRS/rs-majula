// 1490
[proc,clientscript_1490]
def_string $string0 = "";
if (%bankinsert = 0) {
    if_setgraphic(bank_v2_main:bank_sort_button, 1431);
    if_setgraphic(bank_v2_main:bank_sort_icon, 1425);
    $string0 = "Switch to insert items mode";
} else {
    if_setgraphic(bank_v2_main:bank_sort_button, 1433);
    if_setgraphic(bank_v2_main:bank_sort_icon, 1426);
    $string0 = "Switch to swap items mode";
}
if_setop(bank_v2_main:bank_sort_button, 1, $string0);
if_setonmouserepeat(bank_v2_main:bank_sort_button, "addtooltip(event_com, bank_v2_main:tooltip, $string0, 25, 150)");
