// 197
[proc,clientscript_197](component $component0)
cc_deleteall($component0);
def_int $int1 = clan_getchatcount;
def_int $int2 = 0;
def_int $int3 = clan_getchatminkick;
def_int $int4 = clan_getchatrank;
def_int $int5 = 0;
def_int $int6 = 0;
while ($int2 < $int1) {
    $int5 = calc($int2 + $int2 + $int2);
    cc_create($component0, ^iftype_text, $int5);
    cc_settextfont(friendslist_font);
    cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
    cc_settext(clan_getchatusername($int2));
    cc_setposition(11, calc($int2 * 15), ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(85, 15, ^setsize_abs, ^setsize_abs);
    cc_setcolour(^white);
    cc_settextshadow(false);
    cc_setonop("clientscript_199(clan_getchatusername($int2), event_op)");
    if (clan_isself($int2) = false) {
        if (friend_test(clan_getchatusername($int2)) = true) {
            cc_setop(9, "Remove friend <clan_getchatusername($int2)>");
        } else if (ignore_test(clan_getchatusername($int2)) = true) {
            cc_setop(10, "Remove ignore <clan_getchatusername($int2)>");
        } else {
            cc_setop(7, "Add friend <clan_getchatusername($int2)>");
            cc_setop(8, "Add ignore <clan_getchatusername($int2)>");
        }
    }
    if ($int4 >= $int3 & $int4 > clan_getchatuserrank($int2)) {
        cc_setop(6, "Kick user <clan_getchatusername($int2)>");
    }
    $int6 = clan_getchatuserworld($int2);
    cc_create($component0, ^iftype_text, calc($int5 + 1));
    cc_settextfont(friendslist_font);
    cc_settextalign(^settextalign_right, ^settextalign_centre, 0);
    cc_settext(clan_getchatuserworldname($int2));
    cc_setposition(108, calc($int2 * 15), ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(50, 15, ^setsize_abs, ^setsize_abs);
    if ($int6 = map_world) {
        cc_setcolour(^green);
    } else {
        cc_setcolour(0xffff64);
    }
    cc_settextshadow(false);
    cc_setonop("clientscript_199(clan_getchatusername($int2), event_op)");
    if (clan_isself($int2) = false) {
        if (friend_test(clan_getchatusername($int2)) = true) {
            cc_setop(9, "Remove friend <clan_getchatusername($int2)>");
        } else if (ignore_test(clan_getchatusername($int2)) = true) {
            cc_setop(10, "Remove ignore <clan_getchatusername($int2)>");
        } else {
            cc_setop(7, "Add friend <clan_getchatusername($int2)>");
            cc_setop(8, "Add ignore <clan_getchatusername($int2)>");
        }
    }
    if ($int4 >= $int3 & $int4 > clan_getchatuserrank($int2)) {
        cc_setop(6, "Kick user <clan_getchatusername($int2)>");
    }
    cc_create($component0, ^iftype_graphic, calc($int5 + 2));
    cc_setposition(1, calc($int2 * 15 + 2), ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(9, 9, ^setsize_abs, ^setsize_abs);
    cc_setgraphic(~clientscript_198(clan_getchatuserrank($int2)));
    cc_setonop("clientscript_199(clan_getchatusername($int2), event_op)");
    if (clan_isself($int2) = false) {
        if (friend_test(clan_getchatusername($int2)) = true) {
            cc_setop(9, "Remove friend <clan_getchatusername($int2)>");
        } else if (ignore_test(clan_getchatusername($int2)) = true) {
            cc_setop(10, "Remove ignore <clan_getchatusername($int2)>");
        } else {
            cc_setop(7, "Add friend <clan_getchatusername($int2)>");
            cc_setop(8, "Add ignore <clan_getchatusername($int2)>");
        }
    }
    if ($int4 >= $int3 & $int4 > clan_getchatuserrank($int2)) {
        cc_setop(6, "Kick user <clan_getchatusername($int2)>");
    }
    $int2 = calc($int2 + 1);
}
if ($int1 > 0) {
    if_settext(interface_589:com_0, "<col=ff9b00>Talking in: <col=ffff64><clan_getchatdisplayname>");
    if_settext(interface_589:com_1, "<col=ff9b00>Owner: <col=ffffff><clan_getchatownername>");
    if_settext(interface_589:com_8, "Leave Chat");
    if_setop(interface_589:com_8, 1, "Leave Chat");
} else {
    if_settext(interface_589:com_0, "<col=ff9b00>Talking in: Not in chat");
    if_settext(interface_589:com_1, "<col=ff9b00>Owner: None");
    if_settext(interface_589:com_8, "Join Chat");
    if_setop(interface_589:com_8, 1, "Join Chat");
}
def_int $int7 = calc(15 * $int1);
def_int $int8 = if_getheight(interface_589:clanlist);
if ($int7 < 15) {
    $int7 = 15;
}
def_int $int9 = calc($int7 - $int8);
if ($int9 < 0) {
    $int9 = 0;
}
def_int $int10 = if_getscrolly(interface_589:clanlist);
if ($int10 > $int9) {
    $int10 = $int9;
}
if ($int1 > 0) {
    if_setscrollsize(interface_589:clanlist, 0, $int7);
} else {
    if_setscrollsize(interface_589:clanlist, 0, 15);
}
~clientscript_72(interface_589:clanlistscrollbar, interface_589:clanlist, $int10);
