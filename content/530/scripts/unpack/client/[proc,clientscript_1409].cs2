// 1409
[proc,clientscript_1409]
if_setgraphic(boardgames_options:firerune1, 180);
if_setgraphic(boardgames_options:waterrune1, 180);
if_setgraphic(boardgames_options:earthrune1, 180);
if_setgraphic(boardgames_options:airrune1, 180);
if_setgraphic(boardgames_options:mindrune1, 180);
if_setgraphic(boardgames_options:bodyrune1, 180);
if_setgraphic(boardgames_options:naturerune1, 180);
if_setgraphic(boardgames_options:chaosrune1, 180);
if_setgraphic(boardgames_options:lawrune1, 180);
if_setgraphic(boardgames_options:cosmicrune1, 180);
if_setgraphic(boardgames_options:bloodrune1, 180);
if_setgraphic(boardgames_options:soulrune1, 180);
if (%boardgames_piece = 1) {
    if_setgraphic(boardgames_options:firerune1, 181);
} else if (%boardgames_piece = 2) {
    if_setgraphic(boardgames_options:waterrune1, 181);
} else if (%boardgames_piece = 3) {
    if_setgraphic(boardgames_options:earthrune1, 181);
} else if (%boardgames_piece = 4) {
    if_setgraphic(boardgames_options:airrune1, 181);
} else if (%boardgames_piece = 5) {
    if_setgraphic(boardgames_options:mindrune1, 181);
} else if (%boardgames_piece = 6) {
    if_setgraphic(boardgames_options:bodyrune1, 181);
} else if (%boardgames_piece = 7) {
    if_setgraphic(boardgames_options:naturerune1, 181);
} else if (%boardgames_piece = 8) {
    if_setgraphic(boardgames_options:chaosrune1, 181);
} else if (%boardgames_piece = 9) {
    if_setgraphic(boardgames_options:lawrune1, 181);
} else if (%boardgames_piece = 10) {
    if_setgraphic(boardgames_options:cosmicrune1, 181);
} else if (%boardgames_piece = 11) {
    if_setgraphic(boardgames_options:bloodrune1, 181);
} else if (%boardgames_piece = 12) {
    if_setgraphic(boardgames_options:soulrune1, 181);
}
