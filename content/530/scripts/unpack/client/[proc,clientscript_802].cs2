// 802
[proc,clientscript_802](component $component0, int $int1)
def_int $int2 = 0;
def_int $int3 = 0;
if (cc_find($component0, $int1) = true | $int1 = -1 & if_find($component0) = true) {
    $int2, $int3 = ~cc_getx_absolute, ~cc_gety_absolute;
    if ($int2 < scale(1, 3, if_getwidth(toplevel_fullscreen:maingame))) {
        if ($int3 < scale(1, 3, if_getheight(toplevel_fullscreen:maingame))) {
            if_setmodelangle(toplevel_fullscreen:arrow, 0, 0, 512, 768, 0, 1000);
            if_setposition(toplevel_fullscreen:arrow, calc($int2 + cc_getwidth), calc($int3 + cc_getheight), 0, 0);
        } else {
            if_setmodelangle(toplevel_fullscreen:arrow, 0, 0, 512, 256, 0, 1000);
            if_setposition(toplevel_fullscreen:arrow, calc($int2 + cc_getwidth), calc($int3 - if_getheight(toplevel_fullscreen:arrow)), 0, 0);
        }
    } else if ($int3 < scale(1, 3, if_getheight(toplevel_fullscreen:maingame))) {
        if_setmodelangle(toplevel_fullscreen:arrow, 0, 0, 512, 1280, 0, 1000);
        if_setposition(toplevel_fullscreen:arrow, calc($int2 - if_getwidth(toplevel_fullscreen:arrow)), calc($int3 + cc_getheight), 0, 0);
    } else {
        if_setmodelangle(toplevel_fullscreen:arrow, 0, 0, 512, 1792, 0, 1000);
        if_setposition(toplevel_fullscreen:arrow, calc($int2 - if_getwidth(toplevel_fullscreen:arrow)), calc($int3 - if_getheight(toplevel_fullscreen:arrow)), 0, 0);
    }
}
