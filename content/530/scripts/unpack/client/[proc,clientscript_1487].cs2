// 1487
[proc,clientscript_1487]
def_string $string0 = "";
if (%bankcert = 0) {
    if_setgraphic(bank_v2_main:bank_cert_button, 1431);
    if_setgraphic(bank_v2_main:bank_cert_icon, 1427);
    $string0 = "Switch to note withdrawal mode";
} else {
    if_setgraphic(bank_v2_main:bank_cert_button, 1433);
    if_setgraphic(bank_v2_main:bank_cert_icon, 1428);
    $string0 = "Switch to item withdrawal mode";
}
if_setop(bank_v2_main:bank_cert_button, 1, $string0);
if_setonmouserepeat(bank_v2_main:bank_cert_button, "addtooltip(event_com, bank_v2_main:tooltip, $string0, 25, 150)");
