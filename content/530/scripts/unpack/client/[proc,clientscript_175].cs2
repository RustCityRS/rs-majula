// 175
[proc,clientscript_175](int $int0, int $int1)
if (%tutorial < 1000 & %tutorial_version = 2 & %varplayerbit_4925 < 3) {
    if (%varplayerbit_4925 = 0) {
        mes("You will be taught about the chat filter buttons later in the tutorial.");
        return;
    } else if (%varplayerbit_4925 = 1) {
        if ($int1 ! 3 | $int0 ! 3) {
            mes("Set your Private chat filter to Friends.");
            return;
        } else {
            ~chat_set_filter($int1, 1);
            ~clientscript_178;
            ~clientscript_84;
            ~rebuildpmbox;
        }
    } else if (%varplayerbit_4925 = 2) {
        if ($int1 ! 2 | $int0 ! 2) {
            mes("Set your Public chat filter to On.");
            return;
        } else {
            ~chat_set_filter($int1, 0);
            ~clientscript_178;
            ~clientscript_84;
            ~rebuildpmbox;
            if_setonvartransmit(filterbuttons:chat_private_graphic, "clientscript_1532{varplayer_1252}");
        }
    }
} else if ($int0 = 1) {
    if (%chat_view = $int1 & getwindowmode >= ^windowmode_resizable & %tutorial >= 1000) {
        %chat_view = -1;
        ~clientscript_1364;
    } else if (%chat_view = -1) {
        %chat_view = $int1;
        ~clientscript_1364;
    } else {
        %chat_view = $int1;
    }
    ~chat_alert_reset(%chat_view);
    ~clientscript_178;
    ~clientscript_84;
    ~rebuildpmbox;
} else if ($int0 = 2) {
    ~chat_set_filter($int1, 0);
    ~clientscript_178;
    ~clientscript_84;
    ~rebuildpmbox;
} else if ($int0 = 3) {
    ~chat_set_filter($int1, 1);
    ~clientscript_178;
    ~clientscript_84;
    ~rebuildpmbox;
} else if ($int0 = 4) {
    ~chat_set_filter($int1, 2);
    ~clientscript_178;
    ~clientscript_84;
    ~rebuildpmbox;
} else if ($int0 = 5) {
    ~chat_set_filter($int1, 3);
    ~clientscript_178;
    ~clientscript_84;
