// 129
[proc,clientscript_129]
def_int $int0 = 0;
cc_deleteall(interface_551:ignorebox);
if (ignore_count < 0) {
    if_settext(interface_551:loadingmes, "Loading Ignore List<br>Please wait...");
} else {
    if_settext(interface_551:loadingmes, "");
    while ($int0 < ignore_count) {
        cc_create(interface_551:ignorebox, 4, $int0);
        cc_settext(ignore_getname($int0));
        cc_setposition(3, calc($int0 * 15), 0, 0);
        cc_setsize(100, 14, 0, 0);
        cc_setcolour(^white);
        cc_settextfont(305);
        cc_settextshadow(true);
        cc_setopbase("<col=ffffff><ignore_getname($int0)>");
        cc_setop(1, "Delete");
        cc_setonop("ignore_op(event_opbase)");
        $int0 = calc($int0 + 1);
    }
    if ($int0 < 13) {
        $int0 = 13;
    }
    if (ignore_count >= 13) {
        if_setscrollsize(interface_551:ignorebox, 158, calc($int0 * 15 + 5));
        ~clientscript_72(interface_551:ignorescroll, interface_551:ignorebox, 0);
    } else {
        if_setscrollsize(interface_551:ignorebox, 158, calc($int0 * 15));
        ~clientscript_72(interface_551:ignorescroll, interface_551:ignorebox, 0);
    }
}
