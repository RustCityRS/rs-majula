// 787
[clientscript,booth_init]
cc_deleteall(equip_screen2:worn_items_layer);
def_int $int0 = 0;
while ($int0 < 14) {
    cc_create(equip_screen2:worn_items_layer, 5, $int0);
    if ($int0 ! 6 & $int0 ! 8 & $int0 ! 11) {
        if (inv_getobj(worn, $int0) ! null) {
            cc_setsize(36, 32, 0, 0);
            if ($int0 = 0) {
                cc_setposition(~clientscript_788(equip_screen2:headslot, 2, 2), 0, 0);
            } else if ($int0 = 1) {
                cc_setposition(~clientscript_788(equip_screen2:capeslot, 2, 2), 0, 0);
