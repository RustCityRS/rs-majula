                cc_setposition(~clientscript_788(equip_screen2:arrowslot, 2, 2), 0, 0);
            }
            cc_setobject(inv_getobj(worn, $int0), inv_getnum(worn, $int0));
            cc_setopbase(oc_name(inv_getobj(worn, $int0)));
            cc_setop(1, "Remove<col=ff9040>");
            cc_setop(2, "Operate<col=ff9040>");
            cc_setop(10, "Examine<col=ff9040>");
            cc_setgraphicshadow(0x111111);
            cc_setoutline(1);
        } else {
            cc_setsize(32, 32, 0, 0);
            if ($int0 = 0) {
                cc_setposition(~clientscript_788(equip_screen2:headslot, 2, 2), 0, 0);
                cc_setgraphic(156);
            } else if ($int0 = 1) {
                cc_setposition(~clientscript_788(equip_screen2:capeslot, 2, 2), 0, 0);
