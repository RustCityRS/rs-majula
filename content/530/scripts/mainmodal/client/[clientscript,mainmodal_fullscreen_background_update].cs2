// 726
[clientscript,mainmodal_fullscreen_background_update](component $component0, component $component1)
if (if_hassub($component1) = false | %mainmodal_fullscreen_colour = null) {
    cc_deleteall($component0);
    %mainmodal_fullscreen_colour = null;
    if_setonsubchange($component0, null);
    if_setonresize($component0, null);
    return;
}
if_setonsubchange($component0, "mainmodal_fullscreen_background_clear($component0, $component1)");
if_setonresize($component0, "mainmodal_fullscreen_background_update($component0, $component1)");
cc_create($component0, 3, 0);
cc_setposition(0, 0, 3, 3);
cc_setsize(if_getx($component1), 16384, 0, 2);
cc_setcolour(%mainmodal_fullscreen_colour);
cc_settrans(%mainmodal_fullscreen_trans);
cc_setfill(true);
cc_create($component0, 3, 1);
cc_setposition(0, 0, 5, 3);
cc_setsize(calc(if_getwidth($component0) - (if_getx($component1) + if_getwidth($component1))), 16384, 0, 2);
cc_setcolour(%mainmodal_fullscreen_colour);
cc_settrans(%mainmodal_fullscreen_trans);
cc_setfill(true);
cc_create($component0, 3, 2);
cc_setposition(if_getx($component1), 0, 0, 3);
cc_setsize(if_getwidth($component1), if_gety($component1), 0, 0);
cc_setcolour(%mainmodal_fullscreen_colour);
cc_settrans(%mainmodal_fullscreen_trans);
cc_setfill(true);
cc_create($component0, 3, 3);
cc_setposition(if_getx($component1), 0, 0, 5);
cc_setsize(if_getwidth($component1), calc(if_getheight($component0) - (if_gety($component1) + if_getheight($component1))), 0, 0);
cc_setcolour(%mainmodal_fullscreen_colour);
cc_settrans(%mainmodal_fullscreen_trans);
cc_setfill(true);
