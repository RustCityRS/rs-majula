if_openmain(interface_49);

[label,book_flip_page](int $page_direction, int $min_page, int $max_page, proc $proc)
%book_page = add(%book_page, $page_direction);
if (%book_page > $max_page) {
    %book_page = $max_page;
} else if (%book_page < $min_page) {
    %book_page = $min_page;
}

if (%book_page = $min_page) {
    if_sethide(interface_49:com_51, true);
} else {
    if_sethide(interface_49:com_51, false);
}

if (%book_page = $max_page) {
    if_sethide(interface_49:com_53, true);
} else {
    if_sethide(interface_49:com_53, false);
}

gosub($proc);
// 530's arrows are pause buttons (Back com51 and Next com53, which the client
// answers with RESUME_PAUSEBUTTON), where 289's were if_buttons (com_84 and com_86, above)
// that found the book again from %open_book. So the book waits on its page
// for one, and turns from here with the same proc and pages.
p_pausebutton;
switch_component (last_com) {
    case interface_49:com_51 : @book_flip_page(^book_direction_backward, $min_page, $max_page, $proc);
    case interface_49:com_53 : @book_flip_page(^book_direction_forward, $min_page, $max_page, $proc);
}
