if_sethide(interface_49:com_28, true);
if_settext(interface_49:com_66, split_get($page, 11));
if_sethide(interface_49:com_30, true);
if_settext(interface_49:bookmacro1m, split_get($page, 12));
if_sethide(interface_49:com_32, true);
if_settext(interface_49:com_68, split_get($page, 13));
if_sethide(interface_49:com_34, true);
