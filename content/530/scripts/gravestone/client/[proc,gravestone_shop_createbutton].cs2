// 682
[proc,gravestone_shop_createbutton](component $component0, int $int1, int $int2, component $component3, component $component4, component $component5, component $component6)
def_int $int7 = calc((if_getwidth($component0) - 164) / 2);
def_int $int8 = calc($int7 + (146 + $int7) * $int2);
cc_create($component0, 3, calc($int2 * 6));
cc_setsize(164, 146, 0, 0);
cc_setposition($int7, $int8, 0, 0);
if (%gravestone_type = $int1) {
    cc_setcolour(0x7f0000);
} else {
    cc_setcolour(^black);
}
cc_settrans(200);
cc_setfill(true);
cc_setop(1, "Choose");
cc_setopbase("<col=ff9040><enum(int, string, enum_1099, $int1)></col>");
cc_setonop("gravestone_shop_select($int1, $component0, event_comsubid, $component3, $component4, $component5, $component6)");
cc_create($component0, 6, calc($int2 * 6 + 1));
cc_setsize(164, 146, 0, 0);
cc_setposition($int7, $int8, 0, 0);
~gravestone_shop_model($int1);
cc_create($component0, 5, calc($int2 * 6 + 2));
cc_setsize(163, 32, 0, 0);
cc_settiling(true);
cc_setgraphic(1074);
cc_setposition($int7, calc($int8 - 17), 0, 0);
cc_create($component0, 5, calc($int2 * 6 + 3));
cc_setsize(163, 32, 0, 0);
cc_settiling(true);
cc_setgraphic(1074);
cc_setposition($int7, calc($int8 + 129), 0, 0);
cc_create($component0, 5, calc($int2 * 6 + 4));
cc_setsize(32, 145, 0, 0);
cc_settiling(true);
cc_setgraphic(1075);
cc_setposition(calc($int7 - 14), $int8, 0, 0);
cc_create($component0, 5, calc($int2 * 6 + 5));
cc_setsize(32, 145, 0, 0);
cc_settiling(true);
cc_setgraphic(1075);
cc_setposition(calc($int7 + 149), $int8, 0, 0);
