// 1419
[clientscript,meslayer_mode5]
if (%snapshot_open = 1) {
    if_close;
}
if (%tutorial < 1000 & %tutorial_version = 2) {
    mes("You need to complete 'Learning the Ropes' before deleting players from your Ignore List.");
    return;
}
if (getwindowmode >= 2) {
    if_sethide(toplevel_fullscreen:chattop, false);
}
if_sethide(chattop:mes_layer, false);
if_sethide(chattop:mes_layer_large, true);
if_sethide(chattop:mes_layer_hide, true);
if_settext(chattop:mes_text, "Enter name of player to delete from list");
if_settext(chattop:mes_text2, "*");
%meslayermode = 5;
%varclient_654 = "";
if_setonclick(chattop:mes_layer, null);
~clientscript_2026;
if_setonkey(chattop:mes_text2, "clientscript_112(event_keycode, event_keychar)");
~clientscript_1188;
