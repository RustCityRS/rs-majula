// A new character: varp 281 (%tutorial) below 1000. There is no tutorial: the character starts in
// Lumbridge on the 2009 island's design screen (interface 771) and, once that is confirmed or
// shut, gets the kit the end of Tutorial Island gives (tutorial.rs2's tutorial_complete).
[proc,new_player_start]
p_telejump(0_50_50_22_18);
~design_open;

[proc,new_player_finish]
if (%tutorial >= 1000) {
    return;
}
%tutorial = 1000;
%varplayerbit_5008 = 0;
%varplayerbit_5009 = 0;
inv_add(inv, bronze_axe, 1);
inv_add(inv, tinderbox, 1);
inv_add(inv, net, 1);
inv_add(inv, shrimp, 1);
inv_add(inv, bucket_empty, 1);
inv_add(inv, pot_empty, 1);
inv_add(inv, bread, 1);
inv_add(inv, bronze_pickaxe, 1);
inv_add(inv, bronze_dagger, 1);
inv_add(inv, bronze_sword, 1);
inv_add(inv, wooden_shield, 1);
inv_add(inv, shortbow, 1);
inv_add(inv, bronze_arrow, 25);
inv_add(inv, airrune, 25);
inv_add(inv, mindrune, 15);
inv_add(inv, waterrune, 6);
inv_add(inv, earthrune, 4);
inv_add(inv, bodyrune, 2);
inv_add(bank, coins, 25);
buildappearance(worn);
session_log(^log_adventure, "Designed a new character");
// Lumbridge's track, held back while the character was designed (music.rs2).
queue(new_player_music, 0, 0);

[queue,new_player_music]
@music_playbyregion(coord);

// The screen's state is the client's: varcs playerdesign2_client_* hold each part's index in its
// enum and each colour, which the screen's clientscripts reset as it opens (clientscript 1551) and
// change as it is clicked. Every button transmits its op too, so the server makes the same change
// to its copy of those varcs, and applies them on confirm.
[proc,design_open]
%playerdesign2_client_gender = 0;
%playerdesign2_client_head = 0;
%playerdesign2_client_jaw = 0;
%playerdesign2_client_torso = 0;
%playerdesign2_client_arms = 0;
%playerdesign2_client_hands = 0;
%playerdesign2_client_legs = 0;
%playerdesign2_client_feet = 0;
%playerdesign2_client_haircol = 0;
%varclient_95 = 0;
%varclient_96 = 0;
%playerdesign2_client_feetcol = 0;
%playerdesign2_client_skincol = 0;
// The gender buttons do nothing while these are 0 (clientscripts 1575 and 1576).
%varplayerbit_5008 = 1;
%varplayerbit_5009 = 1;
if_openmain(interface_771);

[if_button,interface_771:confirm_yes]
~design_apply;
~new_player_finish;
if_close;

// Shut without confirming: the design is dropped. The close trigger runs without protected access,
// which the varps need, so the rest waits for the queue.
[if_close,interface_771] queue(new_player_close, 0, 0);

[queue,new_player_close]
~new_player_finish;

[proc,design_apply]
def_int $gender = %playerdesign2_client_gender;
setgender($gender);
if ($gender = 1) {
    setidkit(enum(int, idkit, enum_689, %playerdesign2_client_head), %playerdesign2_client_haircol);
    setidkit(enum(int, idkit, enum_1129, %playerdesign2_client_torso), %varclient_95);
    setidkit(enum(int, idkit, enum_1131, %playerdesign2_client_arms), %varclient_95);
    setidkit(enum(int, idkit, enum_1133, %playerdesign2_client_hands), 0);
    setidkit(enum(int, idkit, enum_1135, %playerdesign2_client_legs), %varclient_96);
    setidkit(enum(int, idkit, enum_1137, %playerdesign2_client_feet), %playerdesign2_client_feetcol);
} else {
    setidkit(enum(int, idkit, enum_701, %playerdesign2_client_head), %playerdesign2_client_haircol);
    setidkit(enum(int, idkit, enum_703, %playerdesign2_client_jaw), %playerdesign2_client_haircol);
    setidkit(enum(int, idkit, enum_1128, %playerdesign2_client_torso), %varclient_95);
    setidkit(enum(int, idkit, enum_1130, %playerdesign2_client_arms), %varclient_95);
    setidkit(enum(int, idkit, enum_1132, %playerdesign2_client_hands), 0);
    setidkit(enum(int, idkit, enum_1134, %playerdesign2_client_legs), %varclient_96);
    setidkit(enum(int, idkit, enum_1136, %playerdesign2_client_feet), %playerdesign2_client_feetcol);
}
setidkcolour(4, %playerdesign2_client_skincol);

// Each part steps as its clientscript does (1583-1586, 1596-1605): the same bounds and the same
// wrap, so the two copies stay equal.
[proc,design_next](int $value, int $low, int $high)(int)
if ($value = $high) {
    return($low);
}
return(add($value, 1));

[proc,design_prev](int $value, int $low, int $high)(int)
if ($value = $low) {
    return($high);
}
return(sub($value, 1));

[proc,design_female]()(boolean)
if (%playerdesign2_client_gender = 1) {
    return(true);
}
return(false);

// The client reloads every part and colour from varbits 4208-4219 (clientscript 1710), which the
// server leaves at 0; a female character keeps the jaw it cannot show.
[proc,design_gender](int $gender)
%playerdesign2_client_gender = $gender;
%playerdesign2_client_head = 0;
if ($gender = 0) {
    %playerdesign2_client_jaw = 0;
}
%playerdesign2_client_torso = 0;
%playerdesign2_client_arms = 0;
%playerdesign2_client_hands = 0;
%playerdesign2_client_legs = 0;
%playerdesign2_client_feet = 0;
%playerdesign2_client_haircol = 0;
%varclient_95 = 0;
%varclient_96 = 0;
%playerdesign2_client_feetcol = 0;
%playerdesign2_client_skincol = 0;

[if_button,interface_771:com_49] ~design_gender(0);
[if_button,interface_771:com_52] ~design_gender(1);

[if_button,interface_771:com_37] %option_mouse = 0;
[if_button,interface_771:com_40] %option_mouse = 1;

[if_button,interface_771:com_92]
if (~design_female = true) {
    %playerdesign2_client_head = ~design_prev(%playerdesign2_client_head, 1, 34);
} else {
    %playerdesign2_client_head = ~design_prev(%playerdesign2_client_head, 1, 24);
}

[if_button,interface_771:com_93]
if (~design_female = true) {
    %playerdesign2_client_head = ~design_next(%playerdesign2_client_head, 1, 34);
} else {
    %playerdesign2_client_head = ~design_next(%playerdesign2_client_head, 1, 24);
}

[if_button,interface_771:com_97]
if (~design_female = false) {
    %playerdesign2_client_jaw = ~design_prev(%playerdesign2_client_jaw, 1, 19);
}

[if_button,interface_771:com_98]
if (~design_female = false) {
    %playerdesign2_client_jaw = ~design_next(%playerdesign2_client_jaw, 1, 19);
}

[if_button,interface_771:com_341]
if (~design_female = true) {
    %playerdesign2_client_torso = ~design_prev(%playerdesign2_client_torso, 0, 10);
} else {
    %playerdesign2_client_torso = ~design_prev(%playerdesign2_client_torso, 0, 13);
}

[if_button,interface_771:com_342]
if (~design_female = true) {
    %playerdesign2_client_torso = ~design_next(%playerdesign2_client_torso, 0, 10);
} else {
    %playerdesign2_client_torso = ~design_next(%playerdesign2_client_torso, 0, 13);
}

[if_button,interface_771:com_345]
if (~design_female = true) {
    %playerdesign2_client_arms = ~design_prev(%playerdesign2_client_arms, 0, 10);
} else {
    %playerdesign2_client_arms = ~design_prev(%playerdesign2_client_arms, 0, 11);
}

[if_button,interface_771:com_346]
if (~design_female = true) {
    %playerdesign2_client_arms = ~design_next(%playerdesign2_client_arms, 0, 10);
} else {
    %playerdesign2_client_arms = ~design_next(%playerdesign2_client_arms, 0, 11);
}

// Clientscript 1601 wraps below 0 to 11, one short of the 12 that 1600 wraps at.
[if_button,interface_771:com_349] %playerdesign2_client_hands = ~design_prev(%playerdesign2_client_hands, 0, 11);
[if_button,interface_771:com_350] %playerdesign2_client_hands = ~design_next(%playerdesign2_client_hands, 0, 12);

[if_button,interface_771:com_353]
if (~design_female = true) {
    %playerdesign2_client_legs = ~design_prev(%playerdesign2_client_legs, 0, 14);
} else {
    %playerdesign2_client_legs = ~design_prev(%playerdesign2_client_legs, 0, 10);
}

[if_button,interface_771:com_354]
if (~design_female = true) {
    %playerdesign2_client_legs = ~design_next(%playerdesign2_client_legs, 0, 14);
} else {
    %playerdesign2_client_legs = ~design_next(%playerdesign2_client_legs, 0, 10);
}

[if_button,interface_771:com_357] %playerdesign2_client_feet = ~design_prev(%playerdesign2_client_feet, 0, 1);
[if_button,interface_771:com_358] %playerdesign2_client_feet = ~design_next(%playerdesign2_client_feet, 0, 1);

// The colour swatches: slot 0 hair, 1 torso, 2 legs, 3 feet, 4 skin, and the colour each one's
// clientscript passes to basecolour.
[proc,design_colour](int $slot, int $colour)
switch_int ($slot) {
    case 0 : %playerdesign2_client_haircol = $colour;
    case 1 : %varclient_95 = $colour;
    case 2 : %varclient_96 = $colour;
    case 3 : %playerdesign2_client_feetcol = $colour;
    case 4 : %playerdesign2_client_skincol = $colour;
}

[if_button,interface_771:button_1] ~design_colour(0, 20);
[if_button,interface_771:button_2] ~design_colour(0, 19);
[if_button,interface_771:button_3] ~design_colour(0, 10);
