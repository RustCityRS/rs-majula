// 99
[clientscript,duel_stake_init]
def_int $int0 = 5;
def_int $int1 = 5;
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
$int3 = if_getscrolly(interface_631:your_stake);
$int4 = if_getscrolly(interface_631:opponent_stake);
while ($int0 < 450) {
    while ($int1 < 120) {
        cc_create(interface_631:your_stake, 5, $int2);
        cc_setsize(36, 32, 0, 0);
        cc_setposition($int1, $int0, 0, 0);
        if (inv_getobj(dueloffer, $int2) ! null) {
            cc_setobject(inv_getobj(dueloffer, $int2), inv_getnum(dueloffer, $int2));
            cc_setopbase("<col=ff981f><oc_name(inv_getobj(dueloffer, $int2))>");
            cc_setop(1, "Remove 1");
            cc_setop(2, "Remove 5");
            cc_setop(3, "Remove 10");
            cc_setop(4, "Remove All");
            cc_setop(5, "Remove X");
            cc_setop(10, "Examine");
            cc_setgraphicshadow(0x333333);
            cc_setoutline(1);
        }
        cc_create(interface_631:opponent_stake, 5, $int2);
        cc_setsize(36, 32, 0, 0);
        cc_setposition($int1, $int0, 0, 0);
        if (invother_getobj(dueloffer, $int2) ! null) {
            cc_setobject(invother_getobj(dueloffer, $int2), invother_getnum(dueloffer, $int2));
            cc_setopbase("<col=ff981f><oc_name(invother_getobj(dueloffer, $int2))>");
            cc_setop(1, "Examine");
            cc_setgraphicshadow(0x333333);
            cc_setoutline(1);
        }
        $int1 = calc($int1 + 40);
        $int2 = calc($int2 + 1);
    }
    $int0 = calc($int0 + 45);
    $int1 = 5;
}
if_setscrollsize(interface_631:your_stake, 0, calc($int0 + 15));
~clientscript_72(interface_631:com_98, interface_631:your_stake, $int3);
~scrollbar_ondrag_doscroll(interface_631:com_98, interface_631:your_stake, $int3, 1);
if_setscrollsize(interface_631:opponent_stake, 0, calc($int0 + 15));
~clientscript_72(interface_631:com_99, interface_631:opponent_stake, $int4);
~scrollbar_ondrag_doscroll(interface_631:com_99, interface_631:opponent_stake, $int4, 1);
