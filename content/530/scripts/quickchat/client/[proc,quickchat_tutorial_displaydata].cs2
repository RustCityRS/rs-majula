// 1033
[proc,quickchat_tutorial_displaydata](string $string0)
def_string $string1 = "";
def_int $int0 = 0;
$int0 = string_indexof_string($string0, "|", 0);
if ($int0 ! -1) {
    $string1 = substring($string0, calc($int0 + 1), string_length($string0));
} else {
    $string1 = $string0;
}
if_settext(quickchat_tutorial:title, substring($string0, 0, $int0));
def_int $int1 = 0;
def_int $int2 = 0;
$int1 = calc(paraheight($string1, 400, 495) * 12);
$int2 = if_getheight(quickchat_tutorial:text);
$int2 = calc(if_getheight(quickchat_tutorial:text) / 2 - $int1 / 2);
~quickchat_tutorial_addtext(0, 35, $int2, 400, 100, $string1, ^white);
cc_create(quickchat_tutorial:text, 5, 1);
cc_setgraphic(1074);
cc_setposition(35, calc($int2 - 25), 0, 0);
cc_setsize(400, 32, 0, 0);
cc_create(quickchat_tutorial:text, 5, 2);
cc_setgraphic(1074);
cc_setposition(35, calc($int2 + $int1), 0, 0);
cc_setsize(400, 32, 0, 0);
