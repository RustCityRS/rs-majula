// 1043
[clientscript,quickchat_objdialog_highlight](int $int0, component $component1)
if (cc_find($component1, $int0) = true) {
    %quickchat_menu_select = calc($int0 - 1);
    if (.cc_find($component1, 0) = true) {
        .cc_setposition(cc_getx, cc_gety, 0, 0);
        .cc_setsize(cc_getwidth, cc_getheight, 0, 0);
        .cc_setcolour(0x577e45);
        .cc_setfill(true);
    }
}
