// in osrs attack styles are strongqueued
// for us its normal queued. Its likely queued because if you're delayed
// and setting attack style, it wont go through at all. Queueing allows
// for it to go through after delay is over

// 530's weapon tabs are 289's if1 tabs (interface_75-93): each style button's
// cs1 lights it at the %com_mode it compares against.
[if_button,interface_75:com_2] ~set_attackstyle(0);
[if_button,interface_75:com_5] ~set_attackstyle(1);
[if_button,interface_75:com_4] ~set_attackstyle(2);
[if_button,interface_75:com_3] ~set_attackstyle(3);

