[label,toggle_auto_retaliate]
if_close; // closes interfaces in osrs
if (p_finduid(uid) = true) {
    p_stopaction; // https://oldschool.runescape.wiki/w/Update:Slayer_Cave_%26_High_Risk_Worlds
    if (%option_nodef = ^player_auto_retaliate_on) {
        %option_nodef = ^player_auto_retaliate_off;
    } else {
        %option_nodef = ^player_auto_retaliate_on;
    }
    return;
}
%option_nodef = %option_nodef; // resync varp

[proc,set_attackstyle](int $style)
if_close;
if (p_finduid(uid) = true) {
    p_clearpendingaction;
    if (~player_autocast_enabled = true) {
        ~player_autocast_reset;
    }
    %com_mode = $style;
    ~player_combat_stat;
    return;
}
%com_mode = %com_mode; // resync varp

// updates the attack style tab depending on the
// weapon currently equipped or not by the player
[proc,update_weapon_category](obj $previous)
// dont remove attack style if the equipted item is not a weapon
if ($previous ! null & oc_wearpos($previous) ! ^wearpos_rhand) {
    return;
}
def_obj $obj = inv_getobj(worn, ^wearpos_rhand);
if ($previous = null | $obj = null | oc_category($previous) ! oc_category($obj)) {
    // todo somehow confirm this
    // osrs keeps track of selected per category
    ~player_autocast_reset;
}
~combat_tab_open;

[proc,combat_tab_open]
def_obj $obj = inv_getobj(worn, ^wearpos_rhand);
if (~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
    return;
}
if ($obj = null | (map_members = ^false & oc_members($obj) = true)) {
    if (~player_autocast_enabled = true) {
        ~player_autocast_reset;
    }
    ~combat_tab_unarmed($obj);
    return;
}
switch_category (oc_category($obj)) {
    // melee
    case weapon_2h_sword : ~combat_tab(interface_82, interface_82:com_0, interface_82:com_12, $obj);
    case weapon_axe : ~combat_tab(interface_75, interface_75:com_0, interface_75:com_12, $obj);
    case weapon_blunt, flowers : ~combat_tab(interface_76, interface_76:com_0, interface_76:com_10, $obj);
    case weapon_pickaxe : ~combat_tab(interface_83, interface_83:com_0, interface_83:com_12, $obj);
    case weapon_scythe : ~combat_tab(interface_86, interface_86:com_0, null, $obj);
    case weapon_slash : ~combat_tab(interface_81, interface_81:com_0, interface_81:com_12, $obj);
    case weapon_spear : ~combat_tab(interface_87, interface_87:com_0, interface_87:com_12, $obj);
    case weapon_spiked : ~combat_tab(interface_88, interface_88:com_0, interface_88:com_12, $obj);
    case weapon_stab : ~combat_tab(interface_89, interface_89:com_0, interface_89:com_12, $obj);
    case weapon_claws : ~combat_tab(interface_78, interface_78:com_0, interface_78:com_12, $obj);
    case weapon_polearm : ~combat_tab(interface_84, interface_84:com_0, interface_84:com_10, $obj);
    // ranged
    case weapon_bow : ~combat_tab(interface_77, interface_77:com_0, interface_77:com_13, $obj);
    case weapon_crossbow : ~combat_tab(interface_79, interface_79:com_0, interface_79:com_10, $obj);
    case weapon_thrown, weapon_javelin : ~combat_tab(interface_91, interface_91:com_0, interface_91:com_10, $obj);
    // magic
    case weapon_staff :
        ~combat_tab(interface_90, interface_90:com_0, interface_90:com_87, $obj);
        ~combat_staff_spell_icons;
    // unarmed everything else
    case default : ~combat_tab_unarmed($obj);
}

[proc,combat_tab_side](interface $interface)
if (getwindowmode < 2) {
    if_opensub($interface, toplevel:side0);
} else {
    if_opensub($interface, toplevel_fullscreen:side0);
}

// open first, then set: the client keeps a reopened tab's text and hides, so
// both are sent on every open
[proc,combat_tab](interface $interface, component $name, component $specbar, obj $obj)
~combat_tab_side($interface);
if_settext($name, "<oc_name($obj)>");
if ($specbar ! null) {
    if (oc_param($obj, specwep) = ^true) {
        if_sethide($specbar, false);
    } else {
        if_sethide($specbar, true);
    }
}

[proc,combat_tab_unarmed](obj $obj)
if ($obj = null | (map_members = ^false & oc_members($obj) = true)) {
    ~combat_tab_side(interface_92);
    if_settext(interface_92:com_0, "Unarmed");
    if_sethide(interface_92:com_10, true);
    return;
}
~combat_tab(interface_92, interface_92:com_0, interface_92:com_10, $obj);

[proc,.update_weapon_category](obj $previous)
// dont remove attack style if the equipted item is not a weapon
if ($previous ! null & oc_wearpos($previous) ! ^wearpos_rhand) {
    return;
}
def_obj $obj = .inv_getobj(worn, ^wearpos_rhand);
if ($previous = null | $obj = null | oc_category($previous) ! oc_category($obj)) {
    // todo somehow confirm this
    // osrs keeps track of selected per category
    ~.player_autocast_reset;
}
