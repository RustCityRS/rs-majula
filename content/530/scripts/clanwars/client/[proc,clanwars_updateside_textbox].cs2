// 1785
[proc,clanwars_updateside_textbox](string $string0, int $int0, int $int1, int $int2, int $int3)(int, int)
cc_create(clanwars_setup_side:contents, 4, $int1);
cc_setposition(0, $int0, 0, 0);
cc_settextfont(495);
cc_settextshadow(true);
cc_setsize($int2, calc(paraheight($string0, $int2, 495) * 12 + 5), 0, 0);
cc_settext($string0);
if ($int3 = 1) {
    cc_settextalign(1, 0, 0);
    cc_setcolour(0xff981f);
    return(calc($int0 + cc_getheight + 12), calc($int1 + 1));
}
cc_settextalign(0, 0, 0);
cc_setcolour(0xc8aa64);
return(calc($int0 + cc_getheight + 5), calc($int1 + 1));
