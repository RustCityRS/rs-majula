// 2052
[proc,worldmap_setuptext](string $string0, int $int0, int $int1, int $int2, int $int3, int $rgb4, string $string1, string $string2, coord $coord5)
cc_sethide(false);
cc_setsize($int0, $int1, 0, 0);
cc_setposition($int2, $int3, 1, 1);
cc_setcolour($rgb4);
cc_settextfont(591);
cc_settextalign(1, 1, 13);
cc_settext($string0);
if ($coord5 ! null) {
    cc_setopbase("<col=ff9040><$string1></col>");
    cc_setop(1, $string2);
    cc_setonop("worldmap_op(event_op, event_com, $coord5)");
} else {
    cc_setop(1, "");
    cc_setonop(null);
}
