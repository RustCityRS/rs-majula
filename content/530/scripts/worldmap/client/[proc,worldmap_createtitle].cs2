// 1841
[proc,worldmap_createtitle](component $component0, int $int1, int $int2)(int)
cc_create($component0, 4, if_getnextsubid($component0));
cc_settext(enum(int, string, enum_1806, $int1));
cc_setposition(0, $int2, 0, 0);
cc_setsize(0, 30, 1, 0);
cc_setcolour(0xff9900);
cc_settextfont(496);
cc_settextshadow(true);
cc_settextalign(1, 1, 0);
return(calc($int2 + cc_getheight));
