// 289's tutorial_text (title, line1-line4) is cache 786's interface 372,
// tutorial_text: com0 the title, com1-com6 six lines, Line1 to Line6 until set.
// 289 writes four lines, as here, and the last two are emptied.
//
// 289 opens it with TUT_OPEN, which 530's client does not have (the engine's
// tut_open sends nothing at 530). It goes on the chatbox's overlay slot,
// chattop:chatoverlay (752:9, 479x96 at 20,24), the old chat area 372's if1
// lines are laid out for: while it has a sub the client shows it on the
// chatbox's parchment in place of the chat, and a dialogue
// (chattop:chatmodallarge) shows over it until it shuts (clientscript 1364).
// It opens before its text is set, the title too (289 sets the title before
// the pages): a reopened interface starts from the cache's text.
[proc,tutorialstep_page](string $title, int $page)
def_int $lines = split_linecount($page);

def_interface $interface = null;
if ($lines = 0) {
    // sanity check
    return;
}
$interface = tutorial_text;
tut_open($interface);
if_opensub($interface, chattop:chatoverlay);
if_settext(tutorial_text:tut2_title, $title);
if ($lines = 1) {
    if_settext(tutorial_text:tut2_a, split_get($page, 0));
    if_settext(tutorial_text:tut2_b, "");
    if_settext(tutorial_text:tut2_c, "");
    if_settext(tutorial_text:tut2_d, "");
} else if ($lines = 2) {
    if_settext(tutorial_text:tut2_a, split_get($page, 0));
    if_settext(tutorial_text:tut2_b, split_get($page, 1));
    if_settext(tutorial_text:tut2_c, "");
    if_settext(tutorial_text:tut2_d, "");
} else if ($lines = 3) {
    if_settext(tutorial_text:tut2_a, split_get($page, 0));
    if_settext(tutorial_text:tut2_b, split_get($page, 1));
    if_settext(tutorial_text:tut2_c, split_get($page, 2));
    if_settext(tutorial_text:tut2_d, "");
} else if ($lines = 4) {
    if_settext(tutorial_text:tut2_a, split_get($page, 0));
    if_settext(tutorial_text:tut2_b, split_get($page, 1));
    if_settext(tutorial_text:tut2_c, split_get($page, 2));
    if_settext(tutorial_text:tut2_d, split_get($page, 3));
}

// Updated the split init to match what's shown in this 2006 vid
// https://youtu.be/Quwc_TfPW8Q?t=33
// A step longer than 372's four lines goes on 421, tutorial_text2, as 2009's Game Options step
// does (https://www.youtube.com/watch?v=LgA4VsETE-g): the title on its first line and the text
// below, in a layer that scrolls.
[proc,tutorialstep](string $title, string $string)
split_init($string, 450, 4, q8_full);
if (split_pagecount > 1) {
    ~tutorialstep_scroll($title, $string);
    return;
}
~tutorialstep_page($title, 0);

[proc,tutorialstep_scroll](string $title, string $string)
split_init($string, 447, 11, q8_full);
tut_open(tutorial_text2);
if_opensub(tutorial_text2, chattop:chatoverlay);
if_settext(tutorial_text2:tut3_a, $title);
def_int $lines = split_linecount(0);
def_int $line = 0;
while ($line < 11) {
    if ($line < $lines) {
        if_settext(~tutorialstep_scroll_line($line), split_get(0, $line));
    } else {
        if_settext(~tutorialstep_scroll_line($line), "");
    }
    $line = calc($line + 1);
}

[proc,tutorialstep_scroll_line](int $line)(component)
switch_int ($line) {
    case 0 : return(tutorial_text2:tut3_b);
    case 1 : return(tutorial_text2:tut3_c);
    case 2 : return(tutorial_text2:tut3_d);
    case 3 : return(tutorial_text2:tut3_e);
    case 4 : return(tutorial_text2:tut3_f);
    case 5 : return(tutorial_text2:tut3_g);
    case 6 : return(tutorial_text2:tut3_h);
    case 7 : return(tutorial_text2:tut3_i);
    case 8 : return(tutorial_text2:tut3_j);
    case 9 : return(tutorial_text2:tut3_k);
}
return(tutorial_text2:tut3_l);
