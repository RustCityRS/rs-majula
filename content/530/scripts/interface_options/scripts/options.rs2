[if_button,options:com_16]
if (p_finduid(uid) = true) {
    if_close;
    if_openmain(graphics_options);
} else {
    @please_finish;
}

[if_button,options:com_18]
if (p_finduid(uid) = true) {
    if_close;
    if_openmain(sound_options);
} else {
    @please_finish;
}

[label, please_finish]
mes("Please finish what you're doing first!");

// ── 289's options buttons (interface_options/scripts/game_options.rs2) ─────
// 289's options tab sets each option with a pair of buttons. 530's (options,
// 261) has a toggle each for run (com3), chat effects (optchat), split private
// chat (optpm) and the mouse buttons (optmouse), whose look the client redraws
// from the varp (their onvartransmit). As 289's, each closes what is open first
// ("volume setting if_closes here (interupts the cooking weakqueue)",
// https://youtu.be/neAoU0yiGFY?t=98).
//
// 289's brightness (com_0-7), music (com_25-29) and sound (com_36-40)
// buttons have no 530 counterpart: 530's graphics and audio settings
// (graphics_options 742, sound_options 743, opened above) are the client's
// own. Their only ops are Close, and Mono and Stereo on 743; no clientscript
// reads varps 166, 168 or 169, and the client acts on varp clientcode 5 and
// 6 only (Class323.method2062).
// [if_button,options:all]
// [if_button,options:title]
// [if_button,options:com_2]
// [if_button,options:com_3]
// [if_button,options:optchat]
// [if_button,options:optpm]
// [if_button,options:optmouse]
// [if_button,options:optaid]
// [if_button,options:com_25]
// [if_button,options:com_26]
// [if_button,options:com_27]
// [if_button,options:com_28]
// [if_button,options:com_29]
// [if_button,options:com_36]
// [if_button,options:com_37]
// [if_button,options:com_38]
// [if_button,options:com_39]
// [if_button,options:com_40]

// 289's mouse buttons, com_8 (%option_mouse 0) and com_9 (1): 530's toggle.
// [if_button,options:houseoptions]
// [if_button,options:optpm_gfx]
[if_button,options:optmouse]
if_close;
if (%option_mouse = 0) {
    %option_mouse = 1;
} else {
    %option_mouse = 0;
}

// 289's chat effects, com_10 (%option_chat 0) and com_11 (1): 530's toggle.
// [if_button,options:optchat_gfx]
// [if_button,options:optmouse_gfx]
[if_button,options:optchat]
if_close;
if (%option_chat = 0) {
    %option_chat = 1;
} else {
    %option_chat = 0;
}

// 289's split private chat, com_47 (%option_pm 1) and com_48 (0): 530's toggle.
// [if_button,options:com_47]
// [if_button,options:com_48]
[if_button,options:optpm]
if_close;
if (%option_pm = 0) {
    %option_pm = 1;
} else {
    %option_pm = 0;
}

// 289's run buttons are its controls tab's (interface_controls); 530 has one
// on the options tab too, as on the run orb (player/scripts/run.rs2).
[if_button,options:com_3]
if_close;
if (p_finduid(uid) = true) {
    if (%option_run = ^player_run_on | runenergy < 100) {
        p_run(^player_run_off);
        return;
    }
    p_run(^player_run_on);
    return;
}
%option_run = %option_run; // resync varp

