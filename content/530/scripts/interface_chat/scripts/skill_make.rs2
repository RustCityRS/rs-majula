// Make-X (530)
// 289 asks "What would you like to make?" with skill_multi2-5: an item model
// per choice, and Make 1/5/10/X under each. 530 keeps them as if1 dialogues
// laid out as 289's: two swords, the models, then Make X, 10, 5 and 1 for each
// item in turn, then the prompt (skill_multi2-5 are 303-306; six items are
// 558, whose sixth item's buttons follow its prompt). One item asks "How many
// would you like to make?" (309: Make All, X, 5, 1). Each Make is a pause
// button. The procs keep 289's signatures, and 289's model positions stand as
// the cache's (530's models are placed by the dialogue). Make X asks for the
// number (p_countdialog). 289's %weakqueue_map_clock is not in 530's cache.
//
// skill_make and skill_make10 take the verb and the most the player can make
// (All on 309) as 2011's did, and ask with the dialogue for their count of
// items. Past six items 530 has each skill's own dialogue (smelting 311,
// leather 154): skill_make10 asks for the first six.

[proc,skill_make](string $text, int $verb, int $maximum, namedobj $obj1, namedobj $obj2, namedobj $obj3, namedobj $obj4, namedobj $obj5)(namedobj, int)
def_namedobj $product;
def_int $count;
$product, $count = ~skill_make10($text, $verb, $maximum, $obj1, $obj2, $obj3, $obj4, $obj5, null, null, null, null, null);
return($product, $count);

[proc,skill_make10](string $text, int $verb, int $maximum, namedobj $obj1, namedobj $obj2, namedobj $obj3, namedobj $obj4, namedobj $obj5, namedobj $obj6, namedobj $obj7, namedobj $obj8, namedobj $obj9, namedobj $obj10)(namedobj, int)
def_namedobj $product;
def_int $count;
if ($obj2 = null) {
    $product, $count = ~skill_make1($text, $maximum, $obj1);
} else if ($obj3 = null) {
    $product, $count = ~skill_multi2_header($text, $obj1, 0, 0, ^skill_make_zoom, ~skill_make_name($obj1), $obj2, 0, 0, ^skill_make_zoom, ~skill_make_name($obj2));
} else if ($obj4 = null) {
    $product, $count = ~skill_multi3_header($text, $obj1, 0, 0, ^skill_make_zoom, ~skill_make_name($obj1), $obj2, 0, 0, ^skill_make_zoom, ~skill_make_name($obj2), $obj3, 0, 0, ^skill_make_zoom, ~skill_make_name($obj3));
} else if ($obj5 = null) {
    $product, $count = ~skill_multi4_header($text, $obj1, 0, 0, ^skill_make_zoom, ~skill_make_name($obj1), $obj2, 0, 0, ^skill_make_zoom, ~skill_make_name($obj2), $obj3, 0, 0, ^skill_make_zoom, ~skill_make_name($obj3), $obj4, 0, 0, ^skill_make_zoom, ~skill_make_name($obj4));
} else if ($obj6 = null) {
    $product, $count = ~skill_multi5_header($text, $obj1, 0, 0, ^skill_make_zoom, ~skill_make_name($obj1), $obj2, 0, 0, ^skill_make_zoom, ~skill_make_name($obj2), $obj3, 0, 0, ^skill_make_zoom, ~skill_make_name($obj3), $obj4, 0, 0, ^skill_make_zoom, ~skill_make_name($obj4), $obj5, 0, 0, ^skill_make_zoom, ~skill_make_name($obj5));
} else {
    $product, $count = ~skill_multi6($text, $obj1, $obj2, $obj3, $obj4, $obj5, $obj6);
}
if ($count > $maximum) {
    $count = $maximum;
}
return($product, $count);

// An item's name under its model, as 289's callers write it.
[proc,skill_make_name](namedobj $obj)(string)
return("<br><br><br><br><oc_name($obj)>");

[proc,skill_make1](string $text, int $maximum, namedobj $obj)(namedobj, int)
if_openchat(interface_309);
if_setobject(interface_309:com_2, $obj, ^skill_make_zoom);
if_settext(interface_309:com_7, $text);
if_addresumebutton(interface_309:com_3);
if_addresumebutton(interface_309:com_4);
if_addresumebutton(interface_309:com_5);
if_addresumebutton(interface_309:com_6);
p_pausebutton;
def_component $last_com = last_com;
if_close;
switch_component ($last_com) {
    case interface_309:com_3 : return($obj, $maximum);
    case interface_309:com_4 :
        p_countdialog;
        return($obj, last_int);
    case interface_309:com_5 : return($obj, 5);
    case interface_309:com_6 : return($obj, 1);
    case default : return(null, 0);
}


