if_settext(interface_140:graphical_multi_2title, $title);
if_setobject(interface_140:graphical_multi_pic2a, $obj1, $scale1);
if_settext(interface_140:mine_completed_01, $string1);
if_setobject(interface_140:graphical_multi_pic2b, $obj2, $scale2);
if_settext(interface_140:mine_completed_02, $string2);
if_addresumebutton(interface_140:mine_completed_01);
if_addresumebutton(interface_140:mine_completed_02);
p_pausebutton;
def_component $last_com = last_com;
if_close;
switch_component ($last_com) {
    case interface_140:mine_completed_01 : return($obj1);
    case interface_140:mine_completed_02 : return($obj2);
    case default : return(null);
}

