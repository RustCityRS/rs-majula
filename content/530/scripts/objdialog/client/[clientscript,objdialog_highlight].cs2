// 579
[clientscript,objdialog_highlight](int $int0, obj $obj1)
if (cc_find(objdialog:resultlist, 0) = true) {
    cc_setposition(0, calc(15 * ($int0 - 1)), 0, 0);
    cc_setsize(if_getwidth(objdialog:resultlist), 15, 0, 0);
    cc_setcolour(^black);
    cc_settrans(220);
    cc_setfill(true);
}
if_setobject(objdialog:objgraphic, $obj1, -1);
