// 577
[proc,objdialog_dosearch](string $string0)
def_int $int0 = oc_find($string0, true);
def_int $int1 = if_getwidth(objdialog:resultlist);
def_int $int2 = calc($int1 - 8);
if ($int0 = -1) {
    cc_create(objdialog:resultlist, 4, 0);
    cc_setposition(0, 48, 0, 0);
    cc_setsize($int1, 16, 0, 0);
    cc_settextfont(494);
    cc_settext("Too many results. Please refine your search.");
    cc_settextalign(1, 1, 0);
    cc_setcolour(0xa05a00);
    cc_settextshadow(false);
    if_setscrollsize(objdialog:resultlist, 0, 15);
    ~objdialog_doscrollbar;
    return;
}
if ($int0 = 0) {
    cc_create(objdialog:resultlist, 4, 0);
    cc_setposition(0, 48, 0, 0);
    cc_setsize($int1, 16, 0, 0);
    cc_settextfont(494);
    cc_settext("No matching items found.");
    cc_settextalign(1, 1, 0);
    cc_setcolour(0xa05a00);
    cc_settextshadow(false);
    if_setscrollsize(objdialog:resultlist, 0, 15);
    ~objdialog_doscrollbar;
    return;
}
def_int $int3 = 1;
def_obj $obj4 = oc_findnext;
cc_create(objdialog:resultlist, 3, 0);
while ($obj4 ! null) {
    cc_create(objdialog:resultlist, 4, $int3);
    cc_setposition(4, calc(15 * ($int3 - 1)), 0, 0);
    cc_setsize($int2, 15, 0, 0);
    cc_setcolour(0xa05a00);
    cc_settext(oc_name($obj4));
    cc_settextfont(495);
    cc_settextshadow(false);
    cc_setonmouseover("objdialog_highlight($int3, $obj4)");
    cc_setonclick("objdialog_select($obj4)");
    $obj4 = oc_findnext;
    $int3 = calc($int3 + 1);
}
if_setscrollsize(objdialog:resultlist, 0, calc(15 * ($int3 - 1)));
~objdialog_doscrollbar;
