val=set_skeletal,This item set is made up of helm, top, bottoms, boots and gloves.
val=set_dwarf_cannon,This item set is made up of cannon base, stand, barrels and furnace.
val=set_dagon_hai,This item set is made up of hat, top and bottoms.
val=set_elite_black,This item set is made up of Elite black full helm, platebody and legs.
val=set_full_dragon_l,This item set is made up of dragon full helm, platebody, legs.
val=set_full_dragon_s,This item set is made up of dragon full helm, platebody, skirt.
default=shop_dummy

