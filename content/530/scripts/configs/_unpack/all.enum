val=barley,Barley: 3 buckets of compost.
val=jute_fibre,Jute plants: 6 handfuls of barley malt.
val=oak_logs,Oak trees: 1 basket of tomatoes.
val=willow_logs,Willow trees: 1 basket of apples.
val=maple_logs,Maple trees: 1 basket of oranges.
val=yew_logs,Yew logs: 10 cactus spines.
val=magic_logs,Magic logs: 25 coconuts.
