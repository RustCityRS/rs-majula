[if_button,prayer:com_39]
if_close;
if (p_finduid(uid) = true) {
    @activate_prayer_protectfrommissiles;
}
%varplayer_96 = %varplayer_96;

[label,activate_prayer_protectfrommissiles]
p_clearpendingaction;
def_dbrow $data = ~get_prayer_data(^prayer_protectfrommissiles);
if ($data = null) {
    return;
}
if (%varplayer_96 = ^true) {
    %varplayer_96 = ^false;
    ~prayer_deactivate(^prayer_protectfrommissiles);
    return;
}
if (~prayer_checks($data) = false) {
    %varplayer_96 = ^false;
    return;
}
def_int $levelreq = db_getfield($data, prayers:level, 0);
if (stat_base(prayer) < $levelreq){
    %varplayer_96 = ^false;
    // 530's client plays prayer_off itself (clientscript 50).
    ~mesbox("You need a Prayer level of at least <tostring($levelreq)> to use <db_getfield($data, prayers:name, 0)>.");
    return;
}
%varplayer_96 = ^true;
~prayer_activate($data);
